<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof landingData !== 'undefined' && landingData && landingData.event && landingData.event.title) ? `${landingData.event.title} - Landing Page` : 'Umroh Syawal 9D - Pendampingian Tenang untuk Ibu' %></title>
    <meta name="description" content="Program Umroh Syawal 9 Hari oleh Rahmah Travel. Kepastian jadwal, hotel dekat, dan transparan biaya. Cocok untuk anak perempuan mendampingi ibu.">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Classic: Playfair Display + Plus Jakarta Sans (unchanged) -->
    <!-- Modern: DM Serif Display + DM Sans -->
    <!-- Elegant: Cormorant Garamond + Jost -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">

    <link rel="stylesheet" href="/css/app.css">

    

    <style>
        /* =========================================
           BASE / GLOBAL
        ========================================= */
        body {
            overflow-x: hidden;
            background-color: #FAFAF5;
            color: #3E3328;
            -webkit-font-smoothing: antialiased;
        }

        .btn-primary {
            background-color: #8B5E3C !important;
            color: #FFFFFF !important;
            text-decoration: none !important;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }
        .btn-primary:active { transform: scale(0.98); }

        html { scroll-behavior: smooth; }
        img { display: block; width: 100%; height: auto; }

        .sticky-cta-wrapper {
            position: fixed; bottom: 0; left: 0; width: 100%; z-index: 50;
            background: white; box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
            padding: 12px 16px; border-top: 1px solid #E6E6D6;
        }

        section {
            margin-bottom: 2.5rem;
        }

        section[data-aos]::after {
            content: "";
            position: absolute; inset: 1rem 2.5rem;
            border-radius: 26px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            pointer-events: none;
            transition: opacity 0.3s ease;
            opacity: 0.15;
            z-index: -1;
        }

        section[data-aos]:hover::after {
            opacity: 0.35;
        }

        .benefit-pill {
            border-radius: 999px;
            font-size: 11px;
            letter-spacing: 0.08em;
            background: rgba(139, 94, 60, 0.08);
            color: #8b5e3c;
            padding: 4px 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .activity-docs-carousel {
            display: flex; gap: 12px; overflow-x: auto;
            scroll-snap-type: x mandatory; padding-bottom: 8px;
        }
        .activity-docs-carousel .activity-doc-slide-item {
            flex: 0 0 calc(50% - 6px); scroll-snap-align: start;
        }
        .activity-docs-carousel::-webkit-scrollbar { height: 6px; }
        .activity-docs-carousel::-webkit-scrollbar-thumb { background: #c9b79f; border-radius: 999px; }
        @keyframes activityDocGridReveal {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        @media (max-width: 640px) {
            .activity-docs-carousel .activity-doc-slide-item { flex-basis: 100%; }
        }
        @media (max-width: 767px) {
            #lpActivityDocsList.grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
            #lpActivityDocsList.grid > .col-span-2 {
                grid-column: span 1 / span 1;
            }
            #lpActivityDocsList.grid > div {
                opacity: 0;
                animation: activityDocGridReveal 0.55s ease-out forwards;
            }
            #lpActivityDocsList.grid > div:nth-child(2n) {
                animation-delay: 0.1s;
            }
            #lpActivityDocsList.grid > div:nth-child(4n + 3),
            #lpActivityDocsList.grid > div:nth-child(4n + 4) {
                animation-delay: 0.18s;
            }
        }
        .activity-doc-dot {
            width: 8px; height: 8px; border-radius: 999px;
            background: #d8cbb7; transition: all 0.2s ease;
        }
        .activity-doc-dot.active { width: 20px; background: #8B5E3C; }

        .testimonial-carousel {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            padding-bottom: 8px;
        }
        .testimonial-carousel .testimonial-slide {
            flex: 0 0 calc(50% - 6px);
            scroll-snap-align: start;
            aspect-ratio: 3 / 4;
            border-radius: 20px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
            overflow: hidden;
        }
        .testimonial-carousel::-webkit-scrollbar {
            height: 6px;
        }
        .testimonial-carousel::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.6);
            border-radius: 999px;
        }
        @media (max-width: 768px) {
            .testimonial-carousel .testimonial-slide {
                flex: 0 0 90%;
            }
        }
        .testimonial-dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.4);
            transition: all 0.2s ease;
        }
        .testimonial-dot.active {
            width: 20px;
            background: rgba(255, 255, 255, 0.9);
        }

        /* =========================================
           MODERN STYLE — Teal-Emerald
        ========================================= */
        .lp-style-modern {
            --m-teal: #0d9488;
            --m-teal-dark: #0f766e;
            --m-teal-light: #14b8a6;
            --m-emerald: #059669;
            --m-ink: #0f2027;
            --m-ink-mid: #1e3a34;
            --m-ink-soft: #2d5147;
            --m-surface: #f0fdfb;
            --m-surface-alt: #e6faf7;
            --m-border: #b2e4de;
            --m-white: #ffffff;

            background: #f0fdfb;
            color: var(--m-ink);
            font-family: 'DM Sans', sans-serif;
        }

        /* Background geometric pattern */
        .lp-style-modern::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 10% -10%, rgba(20,184,166,0.12) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 90% 110%, rgba(5,150,105,0.10) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
        }

        .lp-style-modern * { position: relative; z-index: 1; }

        /* Typography overrides */
        .lp-style-modern .font-serif,
        .lp-style-modern h1, .lp-style-modern h2, .lp-style-modern h3 {
            font-family: 'DM Serif Display', serif !important;
        }
        .lp-style-modern .font-sans,
        .lp-style-modern p, .lp-style-modern span, .lp-style-modern li, .lp-style-modern a {
            font-family: 'DM Sans', sans-serif !important;
        }

        /* Color overrides */
        .lp-style-modern .text-earth-900 { color: var(--m-ink) !important; }
        .lp-style-modern .text-earth-800 { color: var(--m-ink-soft) !important; }
        .lp-style-modern .text-earth-600 { color: #5b8c85 !important; }
        .lp-style-modern .text-earth-500 { color: #7aa8a3 !important; }
        .lp-style-modern .text-brand-brown { color: var(--m-teal-dark) !important; }
        .lp-style-modern .text-brand-gold { color: var(--m-emerald) !important; }

        /* Backgrounds */
        .lp-style-modern .bg-brand-light { background-color: var(--m-surface) !important; }
        .lp-style-modern .bg-earth-50 { background-color: var(--m-surface-alt) !important; }
        .lp-style-modern .bg-white { background-color: #ffffff !important; }
        .lp-style-modern .bg-brand-brown { background-color: var(--m-teal-dark) !important; }
        .lp-style-modern .border-brand-brown { border-color: var(--m-teal) !important; }
        .lp-style-modern .border-earth-200 { border-color: var(--m-border) !important; }
        .lp-style-modern .border-earth-100 { border-color: #ccf0eb !important; }
        .lp-style-modern .bg-earth-100 { background-color: #d4f5f0 !important; }

        /* Hero */
        .lp-style-modern header {
            background: linear-gradient(135deg, #0f2027 0%, #1a3a33 40%, #0d4a3e 100%) !important;
        }
        .lp-style-modern #lpHeroCard {
            background: rgba(255,255,255,0.97) !important;
            border-top: 4px solid var(--m-teal) !important;
            border-radius: 20px 20px 0 0 !important;
            box-shadow: 0 -8px 40px rgba(13,148,136,0.15), 0 0 0 1px rgba(13,148,136,0.08) !important;
        }

        /* Tags pill modern */
        .lp-style-modern #lpHeroTags span {
            background: linear-gradient(135deg, rgba(13,148,136,0.08), rgba(5,150,105,0.06));
            border: 1px solid rgba(13,148,136,0.2);
            padding: 4px 12px;
            border-radius: 999px;
            font-weight: 600;
            font-size: 12px;
        }

        /* Authority section */
        .lp-style-modern .bg-earth-50.p-5.rounded-lg.border {
            background: linear-gradient(135deg, #e6faf7, #f0fdfb) !important;
            border: 1px solid var(--m-border) !important;
        }

        /* Problem section */
        .lp-style-modern .bg-white.p-5.rounded-xl.border-l-4 {
            border-left: 4px solid var(--m-teal) !important;
            background: linear-gradient(135deg, #f0fdfb, #e6faf7) !important;
        }

        /* Solution cards */
        .lp-style-modern .bg-earth-50.p-5.rounded-lg {
            background: linear-gradient(135deg, #e6faf7, #f0fdfb) !important;
            border: 1px solid var(--m-border);
            border-radius: 16px !important;
        }
        .lp-style-modern .bg-white.rounded-full.shadow-sm {
            background: linear-gradient(135deg, var(--m-teal), var(--m-emerald)) !important;
            color: white !important;
            box-shadow: 0 4px 15px rgba(13,148,136,0.3) !important;
        }
        .lp-style-modern .bg-white.rounded-full.shadow-sm svg {
            stroke: white !important;
        }

        /* Pricing highlight card */
        .lp-style-modern .border-2.border-brand-brown {
            border: 2px solid var(--m-teal) !important;
            background: linear-gradient(160deg, #f0fdfb, #e6faf7) !important;
            box-shadow: 0 12px 40px rgba(13,148,136,0.15) !important;
            border-radius: 20px !important;
        }
        .lp-style-modern .border-earth-200.rounded-xl {
            border-radius: 16px !important;
        }
        .lp-style-modern .border.border-earth-200.rounded-xl.p-5 {
            border-radius: 16px !important;
        }

        /* BEST SELLER badge */
        .lp-style-modern .absolute.top-0.right-0.bg-brand-brown {
            background: linear-gradient(135deg, var(--m-teal), var(--m-emerald)) !important;
            border-radius: 0 16px 0 12px !important;
            font-size: 10px;
            letter-spacing: 1px;
        }

        /* Scarcity bar */
        .lp-style-modern .bg-red-50 {
            background: linear-gradient(135deg, #ecfdf5, #d1fae5) !important;
            border: 1px solid #6ee7b7 !important;
        }
        .lp-style-modern .text-red-700 { color: #065f46 !important; }

        /* Special offer block */
        .lp-style-modern .bg-brand-brown.text-white.p-6.rounded-xl {
            background: linear-gradient(135deg, #0f766e, #0d9488, #059669) !important;
            border-radius: 20px !important;
            box-shadow: 0 16px 40px rgba(13,148,136,0.3) !important;
            position: relative;
            overflow: hidden;
        }
        .lp-style-modern .bg-brand-brown.text-white.p-6.rounded-xl::after {
            content: '';
            position: absolute;
            top: -30px; right: -30px;
            width: 120px; height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
            pointer-events: none;
        }

        /* Pricing note box */
        .lp-style-modern .bg-earth-50.p-5.rounded-lg.text-center {
            background: linear-gradient(135deg, #e6faf7, #f0fdfb) !important;
            border: 1px solid var(--m-border);
            border-radius: 16px !important;
        }

        /* Trust section */
        .lp-style-modern .grid.grid-cols-2 .bg-white.p-4.rounded-lg.shadow-sm {
            background: linear-gradient(160deg, #ffffff, #f0fdfb) !important;
            border: 1px solid var(--m-border) !important;
            border-radius: 16px !important;
            box-shadow: 0 4px 20px rgba(13,148,136,0.08) !important;
        }
        .lp-style-modern .bg-brand-brown\/10 { background: rgba(13,148,136,0.1) !important; }
        .lp-style-modern .bg-brand-brown\/10.rounded-full { background: rgba(13,148,136,0.12) !important; }

        /* FAQ */
        .lp-style-modern details.group {
            border: 1px solid var(--m-border) !important;
            border-radius: 14px !important;
            overflow: hidden;
        }
        .lp-style-modern details summary {
            background: linear-gradient(135deg, #e6faf7, #f0fdfb) !important;
        }

        /* Final CTA section */
        .lp-style-modern #booking {
            background: linear-gradient(135deg, #0f2027, #1a3a33, #0d4a3e) !important;
            position: relative;
            overflow: hidden;
        }
        .lp-style-modern #booking::before {
            content: '';
            position: absolute;
            top: -60px; left: -60px;
            width: 240px; height: 240px;
            border-radius: 50%;
            background: rgba(13,148,136,0.12);
            pointer-events: none;
        }
        .lp-style-modern #booking::after {
            content: '';
            position: absolute;
            bottom: -40px; right: -40px;
            width: 180px; height: 180px;
            border-radius: 50%;
            background: rgba(5,150,105,0.10);
            pointer-events: none;
        }
        .lp-style-modern #booking * { position: relative; z-index: 2; }

        /* CTA buttons */
        .lp-style-modern .btn-primary {
            background: linear-gradient(135deg, var(--m-teal-dark), var(--m-teal), var(--m-emerald)) !important;
            box-shadow: 0 8px 24px rgba(13,148,136,0.35) !important;
            border-radius: 14px !important;
            letter-spacing: 0.3px;
            transition: all 0.3s ease !important;
        }
        .lp-style-modern .btn-primary:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 12px 32px rgba(13,148,136,0.45) !important;
        }

        /* Inline badge */
        .lp-style-modern #lpSolutionBadge {
            background: rgba(13,148,136,0.1) !important;
            color: var(--m-teal-dark) !important;
            border: 1px solid rgba(13,148,136,0.2) !important;
            letter-spacing: 1.5px !important;
        }

        /* Authority quote */
        .lp-style-modern .italic.text-brand-brown {
            color: var(--m-teal-dark) !important;
            font-style: italic;
        }

        /* Final white CTA on dark bg */
        .lp-style-modern #booking a.block {
            background: white !important;
            color: var(--m-teal-dark) !important;
            border-radius: 14px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2) !important;
            transition: all 0.3s ease !important;
        }
        .lp-style-modern #booking a.block:hover {
            transform: translateY(-2px) !important;
        }

        /* Green checkmarks */
        .lp-style-modern #lpBenefitsList svg,
        .lp-style-modern .text-brand-brown svg { color: var(--m-teal) !important; }
        .lp-style-modern .text-green-700 { color: var(--m-emerald) !important; }

        /* Pain points */
        .lp-style-modern .bg-red-100 { background: rgba(13,148,136,0.1) !important; }
        .lp-style-modern .text-red-600 { color: var(--m-teal-dark) !important; }
        .lp-style-modern .bg-red-50 { background: linear-gradient(135deg, #ecfdf5, #d1fae5) !important; }

        /* Footer */
        .lp-style-modern footer { background: #f0fdfb !important; border-top: 1px solid var(--m-border) !important; }

        /* Hotel/detail boxes inside pricing */
        .lp-style-modern .bg-earth-50.rounded.p-2 {
            background: #e6faf7 !important;
            border: 1px solid var(--m-border) !important;
            border-radius: 10px !important;
        }
        .lp-style-modern .bg-white.rounded.p-2 {
            background: #f7fffe !important;
            border: 1px solid var(--m-border) !important;
            border-radius: 10px !important;
        }

        /* Modern animated border for hero card */
        @keyframes modernGlow {
            0%, 100% { box-shadow: 0 -8px 40px rgba(13,148,136,0.15), 0 0 0 1px rgba(13,148,136,0.08); }
            50% { box-shadow: 0 -8px 50px rgba(13,148,136,0.22), 0 0 0 1px rgba(13,148,136,0.15); }
        }
        .lp-style-modern #lpHeroCard { animation: modernGlow 4s ease-in-out infinite; }


        /* =========================================
           ELEGANT STYLE — Gold & Cream
        ========================================= */
        .lp-style-elegant {
            --e-gold: #b8943a;
            --e-gold-light: #d4aa58;
            --e-gold-pale: #f0dfa0;
            --e-gold-dark: #8a6b1e;
            --e-cream: #fdf9f0;
            --e-cream-dark: #f5eddb;
            --e-cream-mid: #ece0c8;
            --e-ivory: #fefcf5;
            --e-ink: #1a1208;
            --e-ink-mid: #3d2e10;
            --e-ink-soft: #6b5630;
            --e-border: #d9c896;
            --e-border-light: #e8dbb4;

            background: var(--e-cream);
            color: var(--e-ink);
            font-family: 'Jost', sans-serif;
        }

        /* Noise texture overlay */
        .lp-style-elegant::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.025'/%3E%3C/svg%3E");
            background-repeat: repeat;
            background-size: 128px;
            pointer-events: none;
            z-index: 0;
            opacity: 0.6;
        }

        .lp-style-elegant * { position: relative; z-index: 1; }

        /* Typography */
        .lp-style-elegant .font-serif,
        .lp-style-elegant h1, .lp-style-elegant h2, .lp-style-elegant h3 {
            font-family: 'Cormorant Garamond', serif !important;
            font-weight: 600 !important;
            letter-spacing: 0.02em;
        }
        .lp-style-elegant .font-sans,
        .lp-style-elegant p, .lp-style-elegant span, .lp-style-elegant li, .lp-style-elegant a {
            font-family: 'Jost', sans-serif !important;
            letter-spacing: 0.02em;
        }
        .lp-style-elegant h1, .lp-style-elegant h2 {
            font-style: italic;
        }

        /* Color overrides */
        .lp-style-elegant .text-earth-900 { color: var(--e-ink) !important; }
        .lp-style-elegant .text-earth-800 { color: var(--e-ink-mid) !important; }
        .lp-style-elegant .text-earth-600 { color: var(--e-ink-soft) !important; }
        .lp-style-elegant .text-earth-500 { color: #9e8450 !important; }
        .lp-style-elegant .text-earth-400 { color: #b09a68 !important; }
        .lp-style-elegant .text-brand-brown { color: var(--e-gold-dark) !important; }

        /* Backgrounds */
        .lp-style-elegant .bg-brand-light { background-color: var(--e-ivory) !important; }
        .lp-style-elegant .bg-earth-50 { background-color: var(--e-cream-dark) !important; }
        .lp-style-elegant .bg-white { background-color: var(--e-ivory) !important; }
        .lp-style-elegant .bg-brand-brown { background-color: var(--e-gold-dark) !important; }
        .lp-style-elegant .border-brand-brown { border-color: var(--e-gold) !important; }
        .lp-style-elegant .border-earth-200 { border-color: var(--e-border-light) !important; }
        .lp-style-elegant .border-earth-100 { border-color: var(--e-border-light) !important; }
        .lp-style-elegant .bg-earth-100 { background: var(--e-cream-mid) !important; }

        /* Hero — dramatic dark gold */
        .lp-style-elegant header {
            background: linear-gradient(160deg, #1a1208 0%, #2e1f06 50%, #1a1208 100%) !important;
        }
        .lp-style-elegant #lpHeroCard {
            background: var(--e-ivory) !important;
            border-top: 3px solid var(--e-gold) !important;
            border-radius: 0 !important;
            box-shadow: 0 -4px 60px rgba(184,148,58,0.20), inset 0 1px 0 rgba(212,170,88,0.3) !important;
        }

        /* Decorative gold line under hero headlines */
        .lp-style-elegant #lpHeroHeadline {
            font-size: 2.4rem !important;
            line-height: 1.15 !important;
        }
        .lp-style-elegant #lpHeroHeadline::after {
            content: '';
            display: block;
            width: 60px;
            height: 2px;
            background: linear-gradient(90deg, var(--e-gold), transparent);
            margin: 12px auto 0;
        }

        /* Hero tags — refined */
        .lp-style-elegant #lpHeroTags span {
            background: transparent;
            border: 1px solid var(--e-border);
            padding: 4px 14px;
            border-radius: 2px;
            font-weight: 500;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Authority section */
        .lp-style-elegant .bg-earth-50.p-5.rounded-lg.border {
            background: linear-gradient(135deg, var(--e-cream-dark), var(--e-ivory)) !important;
            border: 1px solid var(--e-border) !important;
            border-radius: 2px !important;
        }

        /* Problem callout box */
        .lp-style-elegant .bg-white.p-5.rounded-xl.border-l-4 {
            border-left: 3px solid var(--e-gold) !important;
            background: linear-gradient(135deg, var(--e-cream-dark), var(--e-ivory)) !important;
            border-radius: 2px !important;
        }

        /* Solution cards — layered gold */
        .lp-style-elegant .bg-earth-50.p-5.rounded-lg {
            background: linear-gradient(160deg, var(--e-ivory), var(--e-cream-dark)) !important;
            border: 1px solid var(--e-border) !important;
            border-radius: 4px !important;
