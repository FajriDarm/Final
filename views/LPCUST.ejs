    <script>
        const serverLandingData = <%- JSON.stringify((typeof landingData !== 'undefined' && landingData) ? landingData : {}) %>;

        function esc(v) {
            return String(v || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function formatIDR(v) {
            const n = Number(v) || 0;
            return "Rp " + new Intl.NumberFormat("id-ID").format(Math.round(n));
        }

        function formatDateID(v) {
            if (!v) return "";
            const d = new Date(v);
            if (Number.isNaN(d.getTime())) return "";
            return d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
        }

        function parseDateSafe(v) {
            if (!v) return null;
            const d = new Date(v);
            return Number.isNaN(d.getTime()) ? null : d;
        }

        function isVariantWithinMainPeriod(variant, mainStartRaw, mainEndRaw) {
            const mainStart = parseDateSafe(mainStartRaw);
            const mainEnd = parseDateSafe(mainEndRaw);
            if (!mainStart || !mainEnd) return true;

            const variantStart = parseDateSafe(variant?.start_date) || mainStart;
            const variantEnd = parseDateSafe(variant?.end_date) || mainEnd;
            if (!variantStart || !variantEnd) return true;

            // Keep variants with date overlap against main period.
            return variantStart <= mainEnd && variantEnd >= mainStart;
        }

        function applyLandingData() {
            const data = serverLandingData || {};
            const eventData = data.event || {};
            const hero = data.hero || {};
            const benefits = Array.isArray(data.benefits) ? data.benefits.filter(Boolean) : [];
            const faqs = Array.isArray(data.faqs) ? data.faqs.filter((f) => f && f.question && f.answer) : [];
            const variantsRaw = Array.isArray(data.variants) ? data.variants.filter((v) => v && v.title) : [];
            const variants = variantsRaw.filter((v) => isVariantWithinMainPeriod(v, eventData.start_date, eventData.end_date));
            const problem = data.problem || {};
            const pains = Array.isArray(problem.pains) ? problem.pains : [];
            const solution = data.solution || {};
            const solutionItems = Array.isArray(solution.items) ? solution.items : [];

            const heroHeadline = document.getElementById("lpHeroHeadline");
            const heroSubheadline = document.getElementById("lpHeroSubheadline");
            if (heroHeadline && (hero.headline || eventData.title)) {
                heroHeadline.textContent = hero.headline || eventData.title;
            }
            if (heroSubheadline && (hero.subheadline || eventData.description)) {
                heroSubheadline.textContent = hero.subheadline || eventData.description;
            }

            const heroTags = document.getElementById("lpHeroTags");
            if (heroTags && benefits.length) {
                heroTags.innerHTML = benefits.slice(0, 3).map((b) => `
                    <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        ${esc(b)}
                    </span>
                `).join("");
            }

            const heroWrap = document.getElementById("lpHeroMediaWrap");
            const heroImage = document.getElementById("lpHeroImage");
            const heroContentWrap = document.getElementById("lpHeroContentWrap");
            const heroCard = document.getElementById("lpHeroCard");
            const heroInlineMediaWrap = document.getElementById("lpHeroInlineMediaWrap");
            let heroInlineImage = document.getElementById("lpHeroInlineImage");
            const mediaType = String(hero.hero_media_type || "").toLowerCase();
            const mediaUrl = String(hero.hero_media_url || "").trim();
            const asBg = (hero.hero_as_background === 1 || String(hero.hero_as_background) === "1" || hero.hero_as_background === true) && mediaType === "image" && mediaUrl;
            if (heroWrap) {
                heroWrap.style.backgroundImage = "";
                heroWrap.classList.remove("hidden");
            }
            if (heroContentWrap) {
                heroContentWrap.classList.add("-mt-12");
                heroContentWrap.classList.remove("mt-0");
            }
            if (heroCard) {
                heroCard.classList.add("rounded-t-2xl");
                heroCard.classList.remove("rounded-2xl");
            }
            if (heroInlineMediaWrap) {
                heroInlineMediaWrap.classList.add("hidden");
                heroInlineMediaWrap.innerHTML = '<img id="lpHeroInlineImage" src="" alt="Media hero event" class="w-full h-auto max-h-[220px] md:max-h-[260px] object-contain rounded-xl mx-auto hidden">';
                heroInlineImage = heroInlineMediaWrap.querySelector("#lpHeroInlineImage");
            }

            if (heroWrap && mediaUrl) {
                if (asBg) {
                    heroWrap.style.backgroundImage = `url('${mediaUrl}')`;
                    heroWrap.style.backgroundSize = "cover";
                    heroWrap.style.backgroundPosition = "center";
                    if (heroImage) heroImage.classList.add("hidden");
                } else if (mediaType === "video") {
                    if (heroWrap) heroWrap.classList.add("hidden");
                    if (heroContentWrap) {
                        heroContentWrap.classList.remove("-mt-12");
                        heroContentWrap.classList.add("mt-0");
                    }
                    if (heroCard) {
                        heroCard.classList.remove("rounded-t-2xl");
                        heroCard.classList.add("rounded-2xl");
                    }
                    if (heroInlineMediaWrap) {
                        heroInlineMediaWrap.classList.remove("hidden");
                        heroInlineMediaWrap.innerHTML = `<video src="${esc(mediaUrl)}" controls class="w-full h-auto max-h-[220px] md:max-h-[260px] object-contain rounded-xl mx-auto"></video>`;
                    }
                } else if (heroImage) {
                    if (heroWrap) heroWrap.classList.add("hidden");
                    if (heroContentWrap) {
                        heroContentWrap.classList.remove("-mt-12");
                        heroContentWrap.classList.add("mt-0");
                    }
                    if (heroCard) {
                        heroCard.classList.remove("rounded-t-2xl");
                        heroCard.classList.add("rounded-2xl");
                    }
                    if (heroInlineMediaWrap && heroInlineImage) {
                        heroInlineMediaWrap.classList.remove("hidden");
                        heroInlineImage.src = mediaUrl;
                        heroInlineImage.classList.remove("hidden");
                    } else if (heroInlineMediaWrap) {
                        heroInlineMediaWrap.classList.remove("hidden");
                        heroInlineMediaWrap.innerHTML = `<img src="${esc(mediaUrl)}" alt="Media hero event" class="w-full h-auto max-h-[220px] md:max-h-[260px] object-contain rounded-xl mx-auto">`;
                    }
                    if (heroImage) heroImage.classList.add("hidden");
                }
            }

            const problemTitle = document.getElementById("lpProblemTitle");
            const problemSubtitle = document.getElementById("lpProblemSubtitle");
            const painsList = document.getElementById("lpPainsList");
            if (problemTitle && problem.title) problemTitle.textContent = problem.title;
            if (problemSubtitle && problem.subtitle) problemSubtitle.textContent = problem.subtitle;
            if (painsList && pains.length) {
                painsList.innerHTML = pains.map((p) => `
                    <div class="flex items-start gap-3">
                        <div class="mt-1 min-w-[20px] h-20px bg-red-100 text-red-600 rounded-full flex items-center justify-center text-xs font-bold">!</div>
                        <div class="text-earth-800">
                            <p class="font-semibold text-earth-900">${esc(p.title || p.pain_title || p.description || p.pain_description || "")}</p>
                            ${(p.description || p.pain_description) && (p.title || p.pain_title) ? `<p class="text-sm">${esc(p.description || p.pain_description)}</p>` : ""}
                        </div>
                    </div>
                `).join("");
            }

            const solutionTitle = document.getElementById("lpSolutionTitle");
            const solutionSubtitle = document.getElementById("lpSolutionSubtitle");
            const solutionList = document.getElementById("lpSolutionsList");
            if (solutionTitle && solution.title) solutionTitle.textContent = solution.title;
            if (solutionSubtitle && solution.subtitle) solutionSubtitle.textContent = solution.subtitle;
            if (solutionList && solutionItems.length) {
                solutionList.innerHTML = solutionItems.map((s) => `
                    <div class="bg-earth-50 p-5 rounded-lg">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="p-2 bg-white rounded-full shadow-sm text-brand-brown">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h3 class="font-serif font-bold text-lg text-earth-900">${esc(s.title || s.solution_title || "")}</h3>
                        </div>
                        <p class="text-earth-800 text-sm ml-11">${esc(s.description || s.solution_description || "")}</p>
                    </div>
                `).join("");
            }

                        const testimonialsList = document.getElementById("lpTestimonialsList");
            const testimonials = Array.isArray(data.testimonials) ? data.testimonials.filter((t) => t && t.media_url) : [];
            if (testimonialsList && testimonials.length) {
                testimonialsList.innerHTML = testimonials.map((t, idx) => {
                    const type = String(t.media_type || "").toLowerCase();
                    const url = esc(t.media_url);
                    if (type === "video") {
                        return `
                            <div class="relative overflow-hidden rounded-lg bg-black p-2 min-h-[260px] flex items-center justify-center">
                                <video src="${url}" class="max-w-full max-h-[360px] object-contain rounded" controls preload="metadata"></video>
                            </div>
                        `;
                    }
                    return `
                        <div class="relative overflow-hidden rounded-lg bg-earth-50 p-2 min-h-[260px] flex items-center justify-center pointer-events-none">
                            <img src="${url}" alt="Testimoni ${idx + 1}" class="max-w-full max-h-[360px] object-contain rounded">
                        </div>
                    `;
                }).join("");
            }

            const pricingCards = document.getElementById("lpPricingCards");
            if (pricingCards) {
                const items = variants.length ? variants : [{
                    title: eventData.title || "Paket Event",
                    description: eventData.description || "",
                    event_type: eventData.event_type || "berbayar",
                    price_original: eventData.price_original || 0,
                    price_promo: eventData.price_promo || 0
                }];
                pricingCards.innerHTML = items.map((v, i) => {
                    const po = Number(v.price_original) || 0;
                    const pp = Number(v.price_promo) || 0;
                    const free = v.event_type === "gratis" || (po === 0 && pp === 0);
                    const shown = (!free && pp > 0 && pp < po) ? pp : po;
                    const variantStart = v.start_date || eventData.start_date || null;
                    const variantEnd = v.end_date || eventData.end_date || null;
                    return `
                        <div class="${i === 0 ? "border-2 border-brand-brown bg-brand-light shadow-md" : "border border-earth-200"} rounded-xl p-5">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <span class="${i === 0 ? "bg-brand-brown/10 text-brand-brown" : "bg-earth-100 text-earth-800"} text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wide">
                                        ${free ? "Paket Gratis" : "Paket Berbayar"}
                                    </span>
                                    <h3 class="font-serif font-bold text-lg text-earth-900 mt-2">${esc(v.title || "Paket Event")}</h3>
                                    <p class="text-xs text-earth-600">${esc(v.description || "")}</p>
                                </div>
                                <div class="text-right">
                                    ${(!free && pp > 0 && pp < po) ? `<p class="text-xs text-earth-500 line-through">${formatIDR(po)}</p>` : ""}
                                    <p class="text-xl font-bold text-brand-brown">${free ? "GRATIS" : formatIDR(shown)}</p>
                                </div>
                            </div>
                            <p class="text-xs text-earth-700">Periode: ${esc(formatDateID(variantStart) || "-")} - ${esc(formatDateID(variantEnd) || "-")}</p>
                        </div>
                    `;
                }).join("");
            }

            const benefitList = document.getElementById("lpBenefitsList");
            if (benefitList && benefits.length) {
                benefitList.innerHTML = benefits.map((b) => `
                    <li class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-brand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        ${esc(b)}
                    </li>
                `).join("");
            }

            const faqContainer = document.getElementById("lpFaqContainer");
            if (faqContainer && faqs.length) {
                faqContainer.innerHTML = faqs.map((f) => `
                    <details class="group border border-earth-200 rounded-lg">
                        <summary class="flex justify-between items-center cursor-pointer p-4 font-medium text-earth-900 bg-earth-50 list-none">
                            <span>${esc(f.question)}</span>
                            <span class="transition group-open:rotate-180">
                                <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24">
                                    <path d="M6 9l6 6 6-6"></path>
                                </svg>
                            </span>
                        </summary>
                        <div class="text-earth-800 text-sm p-4 leading-relaxed border-t border-earth-100 bg-white">${esc(f.answer)}</div>
                    </details>
                `).join("");
            }

            const params = new URLSearchParams(window.location.search || "");
            const ref = params.get("ref");
            const checkoutParams = new URLSearchParams();
            if (eventData.slug) checkoutParams.set("event", eventData.slug);
            else if (eventData.id) checkoutParams.set("event_id", String(eventData.id));
            if (ref) checkoutParams.set("ref", ref);
            const checkoutUrl = `/checkout${checkoutParams.toString() ? `?${checkoutParams.toString()}` : ""}`;

            document.querySelectorAll(".wa-cta").forEach((el) => {
                el.setAttribute("href", checkoutUrl);
                el.removeAttribute("target");
                el.removeAttribute("rel");
            });
        }

        document.addEventListener("DOMContentLoaded", applyLandingData);
    </script>
</body>

</html>
