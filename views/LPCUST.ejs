    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <!-- Custom JS -->
    <script>
        // Initialize AOS with modern settings
        AOS.init({
            duration: 800,
            once: true,
            offset: 50,
            easing: 'ease-out-cubic',
            disable: 'mobile'
        });

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Close mobile menu when clicking a link
        document.querySelectorAll('#mobileMenu a').forEach(link => {
            link.addEventListener('click', () => {
                document.getElementById('mobileMenu').classList.add('hidden');
            });
        });

        // Modern Navbar scroll effect
        let lastScroll = 0;
        const navbar = document.getElementById('navbar');
        
        window.addEventListener('scroll', () => {
            const currentScroll = window.pageYOffset;
            
            if (currentScroll > 100) {
                navbar.classList.add('py-2');
                navbar.classList.remove('py-3');
            } else {
                navbar.classList.remove('py-2');
                navbar.classList.add('py-3');
            }
            
            if (currentScroll > lastScroll && currentScroll > 200) {
                navbar.style.transform = 'translateY(-100%)';
            } else {
                navbar.style.transform = 'translateY(0)';
            }
            lastScroll = currentScroll;
        });

        // Modern Carousel
        (function () {
            const slider = document.getElementById('jamaahSlider');
            if (!slider) return;

            const slides = Array.from(slider.querySelectorAll('.jamaah-slide'));
            const dots = Array.from(slider.querySelectorAll('[data-index]'));
            const prevBtn = document.getElementById('jamaahPrev');
            const nextBtn = document.getElementById('jamaahNext');

            let current = 0;
            const INTERVAL = 3000;
            let timer = null;

            function goTo(index) {
                index = (index + slides.length) % slides.length;

                slides.forEach((s, i) => {
                    if (i === index) {
                        s.classList.remove('opacity-0');
                        s.classList.add('opacity-100');
                    } else {
                        s.classList.remove('opacity-100');
                        s.classList.add('opacity-0');
                    }
                });

                dots.forEach((d, i) => {
                    if (i === index) {
                        d.classList.add('bg-white');
                        d.classList.remove('bg-white/50');
                    } else {
                        d.classList.remove('bg-white');
                        d.classList.add('bg-white/50');
                    }
                });

                current = index;
            }

            function next() { goTo(current + 1); }
            function prev() { goTo(current - 1); }

            function start() {
                if (timer) return;
                timer = setInterval(next, INTERVAL);
            }

            function stop() {
                if (!timer) return;
                clearInterval(timer);
                timer = null;
            }

            goTo(0);
            start();

            slider.addEventListener('mouseenter', stop);
            slider.addEventListener('mouseleave', start);
            slider.addEventListener('touchstart', stop);
            slider.addEventListener('touchend', start);

            if (prevBtn) prevBtn.addEventListener('click', () => { stop(); prev(); start(); });
            if (nextBtn) nextBtn.addEventListener('click', () => { stop(); next(); start(); });

            dots.forEach(btn => {
                btn.addEventListener('click', () => {
                    stop();
                    goTo(Number(btn.dataset.index));
                    start();
                });
            });

            // Touch swipe support
            let touchStartX = 0;
            slider.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].clientX; stop(); });
            slider.addEventListener('touchend', (e) => {
                const dx = e.changedTouches[0].clientX - touchStartX;
                if (Math.abs(dx) > 50) {
                    if (dx < 0) next(); else prev();
                }
                start();
            });
        })();

        // --- Promo events: load & render (copied/adapted from LandingPage) ---
        document.addEventListener('DOMContentLoaded', function () {
            loadActiveEvents();
        });

        async function loadActiveEvents() {
            const eventsLoading = document.getElementById('eventsLoading');
            const eventsContainer = document.getElementById('eventsContainer');
            const noEvents = document.getElementById('noEvents');
            if (!eventsLoading || !eventsContainer || !noEvents) return;

            // show loader
            eventsLoading.classList.remove('hidden');
            eventsContainer.classList.add('hidden');
            noEvents.classList.add('hidden');

            try {
                const resp = await fetch('/api/admin/events/active');
                const data = await resp.json();
                console.debug('Loaded active events:', data);

                eventsLoading.classList.add('hidden');

                if (data && data.success && Array.isArray(data.data) && data.data.length > 0) {
                    eventsContainer.classList.remove('hidden');
                    displayEvents(data.data);
                } else {
                    noEvents.classList.remove('hidden');
                }
            } catch (err) {
                console.error('Error loading events:', err);
                eventsLoading.classList.add('hidden');
                noEvents.classList.remove('hidden');
            }
        }

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatIDR(amount) {
            const n = Number(amount) || 0;
            return 'Rp ' + new Intl.NumberFormat('id-ID').format(Math.round(n));
        }

        function displayEvents(events) {
            const container = document.getElementById('eventsContainer');
            container.innerHTML = '';
            const frag = document.createDocumentFragment();

            events.forEach((event, idx) => {
                const priceOriginal = Number(event.price_original) || 0;
                const priceDiscount = Number(event.price_discount) || 0;
                const isGratis = priceOriginal === 0;
                const isDiscounted = priceOriginal > 0 && priceDiscount > 0 && priceDiscount < priceOriginal;
                const discountPercent = isDiscounted ? Math.round(((priceOriginal - priceDiscount) / priceOriginal) * 100) : 0;
                const delay = 150 + idx * 80;

                const card = document.createElement('div');
                card.className = 'glass-card rounded-2xl p-6 shadow-lg border relative transition-all duration-300 hover:-translate-y-2';
                card.setAttribute('data-aos', 'fade-up');
                card.setAttribute('data-aos-duration', '800');
                card.setAttribute('data-aos-delay', String(delay));

                const title = escapeHtml(event.name || '—');
                const desc = escapeHtml(event.description || '');
                const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '—';
                const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '—';

                let priceHtml = '';
                if (isGratis) {
                    priceHtml = `<div class="text-2xl font-bold text-emerald-600">Gratis</div>`;
                } else {
                    const displayPrice = isDiscounted ? priceDiscount : priceOriginal;
                    priceHtml = `${priceOriginal > displayPrice ? `<div class="text-sm text-gray-400 line-through">${formatIDR(priceOriginal)}</div>` : ''}` +
                        `<div class="text-2xl font-bold text-emerald-600">${formatIDR(displayPrice)}</div>` +
                        `${priceOriginal > displayPrice ? `<div class="text-sm text-red-500 font-semibold mt-1">Hemat ${formatIDR(priceOriginal - displayPrice)}</div>` : ''}`;
                }

                const badgeHtml = discountPercent > 0 ? `<div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-amber-500 text-white px-4 py-1 rounded-full text-sm font-semibold">${discountPercent}% OFF</div>` : '';

                card.innerHTML = `
                    ${badgeHtml}
                    <h3 class="text-xl font-bold text-gray-800 mb-2">${title}</h3>
                    ${desc ? `<p class="text-gray-500 text-sm mb-4">${desc}</p>` : ''}
                    <div class="mb-4">${priceHtml}</div>
                    <div class="mb-4 pb-4 border-b border-gray-100 text-sm text-gray-500">
                        <div class="flex items-center gap-2 mb-2"><i class="fas fa-calendar-alt"></i><span>${startDate}</span></div>
                        <div class="flex items-center gap-2"><i class="fas fa-clock"></i><span>Sampai ${endDate}</span></div>
                    </div>
                    <button type="button" data-action="get-deal" data-event-id="${escapeHtml(event.id)}" data-ref="${escapeHtml(event.affiliate_link ? event.affiliate_link.code : '')}" class="w-full gradient-primary text-white py-3 rounded-xl font-semibold text-center">Dapatkan Promo</button>
                `;

                frag.appendChild(card);
            });

            container.appendChild(frag);
        }

        // Delegated click handler for promo buttons (redirect to checkout)
        document.getElementById('eventsContainer')?.addEventListener('click', function (e) {
            const btn = e.target.closest('button[data-action="get-deal"], a[data-action="get-deal"]');
            if (!btn) return;
            e.preventDefault();
            const eventId = btn.dataset.eventId || btn.getAttribute('data-event-id') || '';
            const ref = btn.dataset.ref || btn.getAttribute('data-ref') || '';
            const params = new URLSearchParams();
            if (eventId) params.set('event_id', eventId);
            if (ref) params.set('ref', ref);
            window.location.href = '/checkout' + (params.toString() ? '?' + params.toString() : '');
        });

        // Refresh promos when the user returns to the tab
        window.addEventListener('focus', loadActiveEvents);

        // --- Gallery function ---
        // You can implement a lightbox here if needed
        function openGallery(index) {
            // Placeholder for future lightbox
            console.log('Open gallery image:', index);
        }
    </script>
</body>
</html>