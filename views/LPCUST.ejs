    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        const serverLandingData = <%- JSON.stringify((typeof landingData !== 'undefined' && landingData) ? landingData : {}) %>;

        function esc(v) {
            return String(v || "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
        }
        function formatIDR(v) {
            const n = Number(v) || 0;
            return "Rp " + new Intl.NumberFormat("id-ID").format(Math.round(n));
        }
        function formatDateID(v) {
            if (!v) return "";
            const d = new Date(v);
            if (Number.isNaN(d.getTime())) return "";
            return d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
        }
        function parseDateSafe(v) {
            if (!v) return null;
            const d = new Date(v);
            return Number.isNaN(d.getTime()) ? null : d;
        }
        function isVariantWithinMainPeriod(variant, mainStartRaw, mainEndRaw) {
            const mainStart = parseDateSafe(mainStartRaw);
            const mainEnd = parseDateSafe(mainEndRaw);
            if (!mainStart || !mainEnd) return true;
            const variantStart = parseDateSafe(variant?.start_date) || mainStart;
            const variantEnd = parseDateSafe(variant?.end_date) || mainEnd;
            if (!variantStart || !variantEnd) return true;
            return variantStart <= mainEnd && variantEnd >= mainStart;
        }

        const ALLOWED_LP_STYLES = new Set(["classic", "modern", "elegant"]);
        let activityDocsAutoSlideTimer = null;
        let activityDocsScrollHandler = null;
        let activityDocsAutoSlideContainer = null;
        let testimonialAutoSlideTimer = null;
        let testimonialScrollHandler = null;
        let testimonialAutoSlideContainer = null;

        function stopActivityDocsAutoSlide() {
            if (activityDocsAutoSlideTimer) { clearInterval(activityDocsAutoSlideTimer); activityDocsAutoSlideTimer = null; }
            if (activityDocsAutoSlideContainer && activityDocsScrollHandler) { activityDocsAutoSlideContainer.removeEventListener("scroll", activityDocsScrollHandler); }
            activityDocsAutoSlideContainer = null; activityDocsScrollHandler = null;
        }
        function updateActivityDocDots(activeIndex) {
            const dotsWrap = document.getElementById("lpActivityDocsDots");
            if (!dotsWrap) return;
            dotsWrap.querySelectorAll(".activity-doc-dot").forEach((dot, idx) => {
                idx === activeIndex ? dot.classList.add("active") : dot.classList.remove("active");
            });
        }
        function renderActivityDocDots(length) {
            const dotsWrap = document.getElementById("lpActivityDocsDots");
            if (!dotsWrap) return;
            if (!length || length <= 1) { dotsWrap.classList.add("hidden"); dotsWrap.classList.remove("flex"); dotsWrap.innerHTML = ""; return; }
            dotsWrap.classList.remove("hidden"); dotsWrap.classList.add("flex");
            dotsWrap.innerHTML = Array.from({ length }).map((_, idx) => `<span class="activity-doc-dot ${idx === 0 ? "active" : ""}"></span>`).join("");
        }
        function startActivityDocsAutoSlide(container) {
            stopActivityDocsAutoSlide();
            if (!container || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            const cards = Array.from(container.querySelectorAll(".activity-doc-slide-item"));
            if (cards.length <= 1) return;
            let activeIndex = 0;
            activityDocsScrollHandler = () => {
                const left = container.scrollLeft;
                const nearest = cards.reduce((bestIdx, el, idx) => {
                    return Math.abs(el.offsetLeft - left) < Math.abs(cards[bestIdx].offsetLeft - left) ? idx : bestIdx;
                }, 0);
                activeIndex = nearest; updateActivityDocDots(activeIndex);
            };
            container.addEventListener("scroll", activityDocsScrollHandler, { passive: true });
            activityDocsAutoSlideContainer = container;
            const cardWidth = cards[0]?.getBoundingClientRect()?.width || container.clientWidth;
            const step = Math.min(cardWidth + 16, container.scrollWidth);
            activityDocsAutoSlideTimer = setInterval(() => {
                activeIndex = (activeIndex + 1) % cards.length;
                const maxScrollLeft = container.scrollWidth - container.clientWidth;
                let nextLeft = container.scrollLeft + step;
                if (nextLeft > maxScrollLeft) nextLeft = 0;
                container.scrollTo({ left: Math.max(0, nextLeft), behavior: "smooth" });
                updateActivityDocDots(activeIndex);
            }, 3500);
        }

        function stopTestimonialAutoSlide() {
            if (testimonialAutoSlideTimer) { clearInterval(testimonialAutoSlideTimer); testimonialAutoSlideTimer = null; }
            if (testimonialAutoSlideContainer && testimonialScrollHandler) { testimonialAutoSlideContainer.removeEventListener("scroll", testimonialScrollHandler); }
            testimonialAutoSlideContainer = null; testimonialScrollHandler = null;
        }
        function updateTestimonialDots(activeIndex) {
            const dotsWrap = document.getElementById("lpTestimonialsDots");
            if (!dotsWrap) return;
            dotsWrap.querySelectorAll(".testimonial-dot").forEach((dot, idx) => {
                idx === activeIndex ? dot.classList.add("active") : dot.classList.remove("active");
            });
        }
        function renderTestimonialDots(length) {
            const dotsWrap = document.getElementById("lpTestimonialsDots");
            if (!dotsWrap) return;
            if (!length || length <= 1) { dotsWrap.classList.add("hidden"); dotsWrap.classList.remove("flex"); dotsWrap.innerHTML = ""; return; }
            dotsWrap.classList.remove("hidden"); dotsWrap.classList.add("flex");
            dotsWrap.innerHTML = Array.from({ length }).map((_, idx) => `<span class="testimonial-dot ${idx === 0 ? "active" : ""}"></span>`).join("");
        }
        function startTestimonialAutoSlide(container) {
            stopTestimonialAutoSlide();
            if (!container || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            const cards = Array.from(container.querySelectorAll(".testimonial-slide"));
            if (cards.length <= 1) return;
            let activeIndex = 0;
            testimonialScrollHandler = () => {
                const left = container.scrollLeft;
                const nearest = cards.reduce((bestIdx, el, idx) => {
                    return Math.abs(el.offsetLeft - left) < Math.abs(cards[bestIdx].offsetLeft - left) ? idx : bestIdx;
                }, 0);
                activeIndex = nearest; updateTestimonialDots(activeIndex);
            };
            container.addEventListener("scroll", testimonialScrollHandler, { passive: true });
            testimonialAutoSlideContainer = container;
            const cardWidth = cards[0]?.getBoundingClientRect()?.width || container.clientWidth;
            const step = Math.max(Math.min(cardWidth + 18, container.scrollWidth), Math.round(container.clientWidth * 0.7));
            testimonialAutoSlideTimer = setInterval(() => {
                activeIndex = (activeIndex + 1) % cards.length;
                const maxScrollLeft = container.scrollWidth - container.clientWidth;
                let nextLeft = container.scrollLeft + step;
                if (nextLeft > maxScrollLeft) nextLeft = 0;
                container.scrollTo({ left: Math.max(0, nextLeft), behavior: "smooth" });
                updateTestimonialDots(activeIndex);
            }, 3500);
        }

        function resolveLandingStyle(data) {
            const params = new URLSearchParams(window.location.search || "");
            const fromQuery = String(params.get("lp_style") || "").toLowerCase();
            const pickerEnabled = params.get("lp_picker") === "1";
            const stored = String(data?.style_variant || data?.template_variant || data?.lp_style || data?.event?.lp_style || "").toLowerCase();
            if (pickerEnabled && ALLOWED_LP_STYLES.has(fromQuery)) return fromQuery;
            if (ALLOWED_LP_STYLES.has(stored)) return stored;
            return "classic";
        }

        function applyLandingStyle(style) {
            document.body.classList.remove("lp-style-classic", "lp-style-modern", "lp-style-elegant");
            document.body.classList.add(`lp-style-${style}`);
        }

        function initConceptPicker(activeStyle) {
            const params = new URLSearchParams(window.location.search || "");
            const isPickerEnabled = params.get("lp_picker") === "1";
            const picker = document.getElementById("lpConceptPicker");
            const select = document.getElementById("lpConceptSelect");
            if (!picker || !select) return;
            if (!isPickerEnabled) { picker.classList.add("hidden"); return; }
            picker.classList.remove("hidden");
            select.value = activeStyle;
            select.addEventListener("change", () => {
                const url = new URL(window.location.href);
                url.searchParams.set("lp_picker", "1");
                url.searchParams.set("lp_style", select.value);
                window.location.href = url.toString();
            });
        }

        function detectHeroMediaTypeFromUrl(url) {
            if (!url) return "image";
            const ext = url.split("?")[0].split(".").pop().toLowerCase();
            return ["mp4","webm","ogg","mov"].includes(ext) ? "video" : "image";
        }

        function applyLandingData() {
            const data = serverLandingData || {};
            const landingStyle = resolveLandingStyle(data);
            applyLandingStyle(landingStyle);
            initConceptPicker(landingStyle);
            const eventData = data.event || {};
            const hero = data.hero || {};
            const benefits = Array.isArray(data.benefits) ? data.benefits.filter(Boolean) : [];
            const faqs = Array.isArray(data.faqs) ? data.faqs.filter((f) => f && f.question && f.answer) : [];
            const variantsRaw = Array.isArray(data.variants) ? data.variants.filter((v) => v && v.title) : [];
            const variants = variantsRaw.filter((v) => isVariantWithinMainPeriod(v, eventData.start_date, eventData.end_date));
            const problem = data.problem || {};
            const pains = Array.isArray(problem.pains) ? problem.pains : [];
            const solution = data.solution || {};
            const solutionItems = Array.isArray(solution.items) ? solution.items : [];

            const heroHeadline = document.getElementById("lpHeroHeadline");
            const heroSubheadline = document.getElementById("lpHeroSubheadline");
            if (heroHeadline && (hero.headline || eventData.title)) heroHeadline.textContent = hero.headline || eventData.title;
            if (heroSubheadline && (hero.subheadline || eventData.description)) heroSubheadline.textContent = hero.subheadline || eventData.description;

            const heroTags = document.getElementById("lpHeroTags");
            if (heroTags && benefits.length) {
                heroTags.innerHTML = benefits.slice(0, 3).map((b) => `<span class="flex items-center gap-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>${esc(b)}</span>`).join("");
            }

            const heroWrap = document.getElementById("lpHeroMediaWrap");
            const heroImage = document.getElementById("lpHeroImage");
            const heroContentWrap = document.getElementById("lpHeroContentWrap");
            const heroCard = document.getElementById("lpHeroCard");
            const heroInlineMediaWrap = document.getElementById("lpHeroInlineMediaWrap");
            let heroInlineImage = document.getElementById("lpHeroInlineImage");
            const mediaType = String(hero.hero_media_type || "").toLowerCase();
            const mediaUrl = String(hero.hero_media_url || "").trim();
            const asBg = (hero.hero_as_background === 1 || String(hero.hero_as_background) === "1" || hero.hero_as_background === true) && mediaType === "image" && mediaUrl;
            if (heroWrap) { heroWrap.style.backgroundImage = ""; heroWrap.classList.remove("hidden"); }
            if (heroContentWrap) { heroContentWrap.classList.add("-mt-12"); heroContentWrap.classList.remove("mt-0"); }
            if (heroCard) { heroCard.classList.add("rounded-t-2xl"); heroCard.classList.remove("rounded-2xl"); }
            if (heroInlineMediaWrap) {
                heroInlineMediaWrap.classList.add("hidden");
                heroInlineMediaWrap.innerHTML = '<img id="lpHeroInlineImage" src="" alt="Media hero event" class="w-full h-auto max-h-[220px] md:max-h-[260px] object-contain rounded-xl mx-auto hidden">';
                heroInlineImage = heroInlineMediaWrap.querySelector("#lpHeroInlineImage");
            }
            if (heroWrap && mediaUrl) {
                if (asBg) {
                    heroWrap.style.backgroundImage = `url('${mediaUrl}')`;
                    heroWrap.style.backgroundSize = "cover"; heroWrap.style.backgroundPosition = "center";
                    if (heroImage) heroImage.classList.add("hidden");
                } else if (mediaType === "video") {
                    if (heroWrap) heroWrap.classList.add("hidden");
                    if (heroContentWrap) { heroContentWrap.classList.remove("-mt-12"); heroContentWrap.classList.add("mt-0"); }
                    if (heroCard) { heroCard.classList.remove("rounded-t-2xl"); heroCard.classList.add("rounded-2xl"); }
                    if (heroInlineMediaWrap) { heroInlineMediaWrap.classList.remove("hidden"); heroInlineMediaWrap.innerHTML = `<video src="${esc(mediaUrl)}" controls class="w-full h-auto max-h-[220px] md:max-h-[260px] object-contain rounded-xl mx-auto"></video>`; }
                } else if (heroImage) {
                    if (heroWrap) heroWrap.classList.add("hidden");
                    if (heroContentWrap) { heroContentWrap.classList.remove("-mt-12"); heroContentWrap.classList.add("mt-0"); }
                    if (heroCard) { heroCard.classList.remove("rounded-t-2xl"); heroCard.classList.add("rounded-2xl"); }
                    if (heroInlineMediaWrap && heroInlineImage) { heroInlineMediaWrap.classList.remove("hidden"); heroInlineImage.src = mediaUrl; heroInlineImage.classList.remove("hidden"); }
                    else if (heroInlineMediaWrap) { heroInlineMediaWrap.classList.remove("hidden"); heroInlineMediaWrap.innerHTML = `<img src="${esc(mediaUrl)}" alt="Media hero event" class="w-full h-auto max-h-[220px] md:max-h-[260px] object-contain rounded-xl mx-auto">`; }
                    if (heroImage) heroImage.classList.add("hidden");
                }
            }

            const problemTitle = document.getElementById("lpProblemTitle");
            const problemSubtitle = document.getElementById("lpProblemSubtitle");
            const painsList = document.getElementById("lpPainsList");
            if (problemTitle && problem.title) problemTitle.textContent = problem.title;
            if (problemSubtitle && problem.subtitle) problemSubtitle.textContent = problem.subtitle;
            if (painsList && pains.length) {
                painsList.innerHTML = pains.map((p, idx) => `<div class="flex items-start gap-3" data-aos="fade-up" data-aos-delay="${Math.min(idx * 70, 350)}"><div class="mt-1 min-w-[20px] h-20px bg-red-100 text-red-600 rounded-full flex items-center justify-center text-xs font-bold">!</div><div class="text-earth-800"><p class="font-semibold text-earth-900">${esc(p.title || p.pain_title || p.description || p.pain_description || "")}</p>${(p.description || p.pain_description) && (p.title || p.pain_title) ? `<p class="text-sm">${esc(p.description || p.pain_description)}</p>` : ""}</div></div>`).join("");
            }

            const solutionTitle = document.getElementById("lpSolutionTitle");
            const solutionSubtitle = document.getElementById("lpSolutionSubtitle");
            const solutionList = document.getElementById("lpSolutionsList");
            if (solutionTitle && solution.title) solutionTitle.textContent = solution.title;
            if (solutionSubtitle && solution.subtitle) solutionSubtitle.textContent = solution.subtitle;
            if (solutionList && solutionItems.length) {
                solutionList.innerHTML = solutionItems.map((s, idx) => `<div class="bg-earth-50 p-5 rounded-lg" data-aos="fade-up" data-aos-delay="${Math.min(idx * 80, 320)}"><div class="flex items-center gap-3 mb-2"><div class="p-2 bg-white rounded-full shadow-sm text-brand-brown"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div><h3 class="font-serif font-bold text-lg text-earth-900">${esc(s.title || s.solution_title || "")}</h3></div><p class="text-earth-800 text-sm ml-11">${esc(s.description || s.solution_description || "")}</p></div>`).join("");
            }

            const testimonialsList = document.getElementById("lpTestimonialsList");
            const testimonials = Array.isArray(data.testimonials) ? data.testimonials.filter((t) => t && t.media_url) : [];
            if (testimonialsList && testimonials.length) {
                const isAutoTestimonial = String(testimonials[0]?.layout_style || "").toLowerCase() === "auto_slide";
                testimonialsList.className = isAutoTestimonial ? "testimonial-carousel" : "grid grid-cols-1 sm:grid-cols-2 gap-3";
                testimonialsList.innerHTML = testimonials.map((t, idx) => {
                    const type = String(t.media_type || "").toLowerCase();
                    const url = esc(t.media_url);
                    const itemClass = isAutoTestimonial ? `testimonial-slide relative overflow-hidden rounded-2xl bg-black/90 border border-white/40 shadow-xl snap-start` : `relative overflow-hidden rounded-lg bg-earth-50 p-2 min-h-[260px] flex items-center justify-center pointer-events-none`;
                    const delay = Math.min(idx * 80, 320);
                    if (type === "video") return `<div class="${itemClass}" data-aos="zoom-in-up" data-aos-delay="${delay}"><video src="${url}" class="w-full h-full object-cover rounded" controls preload="metadata"></video></div>`;
                    return `<div class="${itemClass}" data-aos="zoom-in-up" data-aos-delay="${delay}"><img src="${url}" alt="Testimoni ${idx + 1}" class="w-full h-full object-cover rounded"></div>`;
                }).join("");
                if (isAutoTestimonial) { renderTestimonialDots(testimonials.length); startTestimonialAutoSlide(testimonialsList); }
                else { renderTestimonialDots(0); stopTestimonialAutoSlide(); }
            } else { renderTestimonialDots(0); stopTestimonialAutoSlide(); }

            const activityDocsList = document.getElementById("lpActivityDocsList");
            const activityDocs = Array.isArray(data.activity_docs) ? data.activity_docs.filter((d) => d && d.media_url) : [];
            if (activityDocsList && activityDocs.length) {
                const isAutoSlide = String(activityDocs[0]?.layout_style || "").toLowerCase() === "auto_slide";
                activityDocsList.className = isAutoSlide ? "activity-docs-carousel" : "grid grid-cols-2 gap-2";
                activityDocsList.innerHTML = activityDocs.map((d, idx) => {
                    const type = String(d.media_type || "").toLowerCase();
                    const url = esc(d.media_url); const info = esc(d.info_text || "");
                    const orientation = d.layout_orientation === "landscape" ? "landscape" : "portrait";
                    const aspectClass = orientation === "landscape" ? "aspect-[4/3]" : "aspect-[3/4]";
                    const itemClass = isAutoSlide ? `activity-doc-slide-item relative group overflow-hidden rounded-lg ${aspectClass}` : `relative group overflow-hidden rounded-lg ${aspectClass} ${orientation === "landscape" ? "col-span-2 sm:col-span-1" : ""}`;
                    if (type === "video") return `<div class="${itemClass} bg-black p-1" data-aos="zoom-in" data-aos-delay="${Math.min(idx * 70, 280)}"><video src="${url}" class="w-full h-full object-cover rounded" controls preload="metadata"></video>${info ? `<div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-[10px] p-2 text-center font-medium">${info}</div>` : ""}</div>`;
                    return `<div class="${itemClass} pointer-events-none" data-aos="zoom-in" data-aos-delay="${Math.min(idx * 70, 280)}"><img src="${url}" alt="Dokumentasi Jamaah ${idx + 1}" class="w-full h-full object-cover">${info ? `<div class="absolute bottom-0 left-0 right-0 bg-black/50 text-white text-[10px] p-2 text-center font-medium">${info}</div>` : ""}</div>`;
                }).join("");
                if (isAutoSlide) { renderActivityDocDots(activityDocs.length); startActivityDocsAutoSlide(activityDocsList); }
                else { renderActivityDocDots(0); stopActivityDocsAutoSlide(); }
            } else { renderActivityDocDots(0); stopActivityDocsAutoSlide(); }

            const pricingCards = document.getElementById("lpPricingCards");
            if (pricingCards) {
                const items = variants.length ? variants : [{ title: eventData.title || "Paket Event", description: eventData.description || "", event_type: eventData.event_type || "berbayar", price_original: eventData.price_original || 0, price_promo: eventData.price_promo || 0 }];
                pricingCards.innerHTML = items.map((v, i) => {
                    const po = Number(v.price_original) || 0; const pp = Number(v.price_promo) || 0;
                    const free = v.event_type === "gratis" || (po === 0 && pp === 0);
                    const shown = (!free && pp > 0 && pp < po) ? pp : po;
                    const variantStart = v.start_date || eventData.start_date || null;
                    const variantEnd = v.end_date || eventData.end_date || null;
                    const logoUrl = String(v.logo_media_url || "").trim();
                    const logoType = String(v.logo_media_type || detectHeroMediaTypeFromUrl(logoUrl) || "image").toLowerCase();
                    const logoBlock = logoUrl ? (logoType === "video" ? `<div class="mb-3 overflow-hidden rounded-lg border border-earth-200 bg-black"><video src="${esc(logoUrl)}" class="w-full h-auto" controls preload="metadata"></video></div>` : `<div class="mb-3 overflow-hidden rounded-lg border border-earth-200 bg-white"><img src="${esc(logoUrl)}" alt="Logo ${esc(v.title || "varian")}" class="w-full h-auto"></div>`) : "";
                    return `<div class="${i === 0 ? "border-2 border-brand-brown bg-brand-light shadow-md" : "border border-earth-200"} rounded-xl p-5" data-aos="fade-up" data-aos-delay="${Math.min(i * 100, 400)}">${logoBlock}<div class="flex justify-between items-start mb-2"><div><span class="${i === 0 ? "bg-brand-brown/10 text-brand-brown" : "bg-earth-100 text-earth-800"} text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wide">${free ? "Paket Gratis" : "Paket Berbayar"}</span><h3 class="font-serif font-bold text-lg text-earth-900 mt-2">${esc(v.title || "Paket Event")}</h3><p class="text-xs text-earth-600">${esc(v.description || "")}</p></div><div class="text-right">${(!free && pp > 0 && pp < po) ? `<p class="text-xs text-earth-500 line-through">${formatIDR(po)}</p>` : ""}<p class="text-xl font-bold text-brand-brown">${free ? "GRATIS" : formatIDR(shown)}</p></div></div><p class="text-xs text-earth-700">Periode: ${esc(formatDateID(variantStart) || "-")} - ${esc(formatDateID(variantEnd) || "-")}</p></div>`;
                }).join("");
            }

            const benefitList = document.getElementById("lpBenefitsList");
            if (benefitList && benefits.length) {
                benefitList.innerHTML = benefits.map((b) => `<li class="flex items-center gap-2"><svg class="w-4 h-4 text-brand-brown" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>${esc(b)}</li>`).join("");
            }

            const faqContainer = document.getElementById("lpFaqContainer");
            if (faqContainer && faqs.length) {
                faqContainer.innerHTML = faqs.map((f, idx) => `<details class="group border border-earth-200 rounded-lg" data-aos="fade-up" data-aos-delay="${Math.min(idx * 60, 300)}"><summary class="flex justify-between items-center cursor-pointer p-4 font-medium text-earth-900 bg-earth-50 list-none"><span>${esc(f.question)}</span><span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span></summary><div class="text-earth-800 text-sm p-4 leading-relaxed border-t border-earth-100 bg-white">${esc(f.answer)}</div></details>`).join("");
            }

            const params = new URLSearchParams(window.location.search || "");
            const ref = params.get("ref");
            const checkoutParams = new URLSearchParams();
            if (eventData.slug) checkoutParams.set("event", eventData.slug);
            else if (eventData.id) checkoutParams.set("event_id", String(eventData.id));
            if (ref) checkoutParams.set("ref", ref);
            const checkoutUrl = `/checkout${checkoutParams.toString() ? `?${checkoutParams.toString()}` : ""}`;

            document.querySelectorAll(".wa-cta").forEach((el) => {
                el.setAttribute("href", checkoutUrl);
                el.removeAttribute("target");
                el.removeAttribute("rel");
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (window.AOS) { window.AOS.init({ once: true, duration: 700, easing: "ease-out-cubic", offset: 60 }); }
            applyLandingData();
            if (window.AOS) { window.AOS.refreshHard(); }
        });
    </script>
</body>
</html>
