        content="Program Umroh Syawal 9 Hari oleh Rahmah Travel. Kepastian jadwal, hotel dekat, dan transparan biaya. Cocok untuk anak perempuan mendampingi ibu.">

    <!-- Fonts: Playfair Display (Trust/Authority) & Plus Jakarta Sans (Modern/Clean) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Tailwind CSS (via CDN for standalone usage) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Configuration for Custom Earthy Tones -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        earth: {
                            50: '#FAFAF5',  /* Ultra light background */
                            100: '#F5F5EB',
                            200: '#E6E6D6',
                            800: '#5D4E37',  /* Primary Text/Headings */
                            900: '#3E3328',  /* Darker Text */
                        },
                        brand: {
                            brown: '#8B5E3C', /* Primary Button/Action */
                            gold: '#C5A059',  /* Accent/Star */
                            light: '#FDFBF7',
                        }
                    },
                    fontFamily: {
                        serif: ['"Playfair Display"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* GLOBAL STYLES & OVERRIDES */
        body {
            overflow-x: hidden;
            /* Rule 2: Prevent horizontal scroll */
            background-color: #FAFAF5;
            /* Rule 4: Light Mode */
            color: #3E3328;
            -webkit-font-smoothing: antialiased;
        }

        /* Rule 7: Button Consistency */
        .btn-primary {
            background-color: #8B5E3C !important;
            color: #FFFFFF !important;
            text-decoration: none !important;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        /* Smooth Scrolling */
        html {
            scroll-behavior: smooth;
        }

        /* Image styling */
        img {
            display: block;
            width: 100%;
            height: auto;
        }

        /* Sticky CTA Mobile */
        .sticky-cta-wrapper {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            z-index: 50;
            background: white;
            box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
            padding: 12px 16px;
            border-top: 1px solid #E6E6D6;
        }
    </style>
</head>

