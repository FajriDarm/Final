<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Checkout - Affillink</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
      min-height: 100vh;
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-secondary {
      background: linear-gradient(165deg, #047857 0%, #059669 50%, #10b981 100%);
    }

    .gradient-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .gradient-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Animations */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white),
        linear-gradient(135deg, #059669, #10b981, #34d399);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Hover Lift */
    .hover-lift {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .hover-lift:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px -10px rgba(16, 185, 129, 0.2);
    }

    /* Input Focus Effects */
    .input-container:focus-within .input-icon {
      color: #10b981;
      transform: translateY(-1px);
    }

    .input-container:focus-within input,
    .input-container:focus-within select {
      border-color: #10b981;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
      transform: translateY(-1px);
    }

    /* Checkmark Animation */
    @keyframes circleFill {
      to {
        stroke-dashoffset: 0;
      }
    }

    .checkmark-path {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: checkmark 0.5s ease-in-out 0.3s forwards;
    }

    @keyframes checkmark {
      0% {
        stroke-dashoffset: 100;
        opacity: 0;
      }

      100% {
        stroke-dashoffset: 0;
        opacity: 1;
      }
    }

    /* Modal Overlay */
    .modal-overlay {
      backdrop-filter: blur(8px);
      background: rgba(0, 0, 0, 0.2);
    }

    /* Modal Content */
    .modal-content {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 1.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    /* Navigation */
    .nav-glass {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    }
  </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
  <!-- Ultra Modern Decorative Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
    <div
      class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
    </div>
    <div
      class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
    </div>

    <!-- Animated Grid Lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

    <!-- Floating Particles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
    <div
      class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
    </div>
  </div>

  <!-- Navbar Premium -->
  <nav class="nav-glass sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <a href="/" class="flex items-center">
          <img src="/images/logoAffilllink2.png" alt="Affillink" class="h-10 w-auto object-contain" />
        </a>
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-emerald-700 bg-white/60 px-3 py-1.5 rounded-lg border border-white/60">
            <i class="fas fa-shield-alt mr-1"></i>
            Secure Checkout
          </span>
        </div>
      </div>
    </div>
  </nav>

  <main class="relative z-10 py-8 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto">
    <div class="animate-slide-in">
      <!-- Premium Page Header - Diperbesar ukuran fontnya -->
      <div class="flex items-center gap-4 mb-8">
        <div class="relative">
          <div class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
            <i class="fas fa-shopping-cart text-white text-2xl"></i>
          </div>
          <div
            class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
            <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
          </div>
        </div>
        <div>
          <h1
            class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
            Checkout
          </h1>
          <p class="text-base text-emerald-700 font-medium">Lengkapi data untuk melanjutkan</p>
        </div>
      </div>

      <% if (!event) { %>
        <!-- Event Not Found Premium - Diperbesar ukuran fontnya -->
        <div class="glass-futuristic rounded-2xl p-8 text-center border border-amber-200/50 bg-amber-50/30 fade-in">
          <div class="flex flex-col items-center">
            <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mb-4">
              <i class="fas fa-exclamation-triangle text-amber-600 text-2xl"></i>
            </div>
            <h3 class="text-lg font-extrabold text-amber-800 mb-2">Event tidak ditemukan</h3>
            <p class="text-base text-amber-700 mb-6">Silakan kembali ke halaman utama dan pilih event lagi.</p>
            <a href="/" class="btn-primary px-6 py-3 inline-flex items-center gap-2 text-base font-extrabold">
              <i class="fas fa-arrow-left"></i>
              Kembali ke Landing Page
            </a>
          </div>
        </div>
        <% } else { %>

          <!-- Checkout Card Premium - Diperbesar ukuran fontnya -->
          <div class="glass-futuristic rounded-2xl overflow-hidden border border-white/50 hover-lift">
            <!-- Card Header -->
            <div class="gradient-primary px-5 py-4 border-b border-white/30">
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                  <i class="fas fa-ticket-alt text-white text-base"></i>
                </div>
                <div>
                  <h2 class="text-lg font-extrabold text-white">
                    <%= event.name %>
                  </h2>
                  <p class="text-emerald-100 text-sm font-medium mt-0.5">Detail event dan pembayaran</p>
                </div>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-5 bg-white/30 backdrop-blur">
              <!-- Form -->
              <form id="checkoutForm" class="space-y-5">
                <input type="hidden" name="event_id" value="<%= event.id %>" />
                <input type="hidden" name="affiliate_ref" value="<%= ref || '' %>" />

                <!-- Nama -->
                <div>
                  <label class="block text-sm font-extrabold text-emerald-800 mb-1.5 flex items-center">
                    <i class="fas fa-user text-emerald-600 text-base mr-1"></i>
                    Nama Lengkap
                    <span class="text-red-500 ml-1">*</span>
                  </label>
                  <div class="input-container relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-user text-emerald-400 input-icon transition-all duration-200 text-base"></i>
                    </div>
                    <input type="text" name="customer_name" required
                      class="block w-full pl-9 pr-4 py-3 bg-white/60 backdrop-blur border border-white/50 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-base font-medium"
                      placeholder="Masukkan nama lengkap" />
                  </div>
                </div>

                <!-- No HP -->
                <div>
                  <label class="block text-sm font-extrabold text-emerald-800 mb-1.5 flex items-center">
                    <i class="fas fa-phone text-emerald-600 text-base mr-1"></i>
                    Nomor HP
                    <span class="text-red-500 ml-1">*</span>
                  </label>
                  <div class="input-container relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <i class="fas fa-phone text-emerald-400 input-icon transition-all duration-200 text-base"></i>
                    </div>
                    <input type="tel" name="customer_phone" required
                      class="block w-full pl-9 pr-4 py-3 bg-white/60 backdrop-blur border border-white/50 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-base font-medium"
                      placeholder="08123456789" inputmode="numeric" pattern="[0-9]*" id="customer_phone" />
                    <p id="phoneWarning" class="text-sm text-red-500 mt-1 hidden">Nomor HP hanya boleh angka.</p>
                  </div>
                </div>

                <!-- Buttons -->
                <div class="flex justify-end gap-3 pt-4">
                  <a href="/"
                    class="px-5 py-3 bg-white/60 hover:bg-white/80 text-gray-700 rounded-xl transition-all duration-300 text-base font-extrabold flex items-center gap-2 border border-white/60">
                    <i class="fas fa-times"></i>
                    Batal
                  </a>
                  <button id="checkoutSubmitBtn" type="submit"
                    class="px-5 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-base font-extrabold flex items-center gap-2 shadow-lg">
                    <i class="fas fa-paper-plane"></i>
                    Kirim
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- Info Card Premium - Diperbesar ukuran fontnya -->
          <div class="glass-futuristic rounded-2xl p-5 mt-6 border border-blue-200/50 bg-blue-50/30 hover-lift">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div
                  class="w-12 h-12 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-xl flex items-center justify-center border border-white/60">
                  <i class="fas fa-info-circle text-blue-600 text-xl"></i>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-base font-extrabold text-blue-900 mb-3">Informasi Penting</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div class="flex items-start gap-2 bg-white/30 backdrop-blur p-2 rounded-lg">
                    <div class="w-5 h-5 bg-green-100 rounded-md flex items-center justify-center flex-shrink-0">
                      <i class="fas fa-check text-green-600 text-xs"></i>
                    </div>
                    <span class="text-sm text-blue-800">Data Anda tersimpan setelah dikirim</span>
                  </div>
                  <div class="flex items-start gap-2 bg-white/30 backdrop-blur p-2 rounded-lg">
                    <div class="w-5 h-5 bg-green-100 rounded-md flex items-center justify-center flex-shrink-0">
                      <i class="fas fa-check text-green-600 text-xs"></i>
                    </div>
                    <span class="text-sm text-blue-800">Anda akan langsung diarahkan ke WhatsApp</span>
                  </div>
                  <div class="flex items-start gap-2 bg-white/30 backdrop-blur p-2 rounded-lg">
                    <div class="w-5 h-5 bg-green-100 rounded-md flex items-center justify-center flex-shrink-0">
                      <i class="fas fa-check text-green-600 text-xs"></i>
                    </div>
                    <span class="text-sm text-blue-800">Nomor WhatsApp mengikuti pengaturan event</span>
                  </div>
                  <div class="flex items-start gap-2 bg-white/30 backdrop-blur p-2 rounded-lg">
                    <div class="w-5 h-5 bg-green-100 rounded-md flex items-center justify-center flex-shrink-0">
                      <i class="fas fa-check text-green-600 text-xs"></i>
                    </div>
                    <span class="text-sm text-blue-800">Jika gagal, silakan ulangi pengiriman</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <% } %>
    </div>
  </main>

  <!-- Confirmation Modal Premium - Diperbesar ukuran fontnya -->
  <div id="confirmationModal" class="hidden fixed inset-0 modal-overlay flex items-center justify-center z-50 p-4">
    <div class="modal-content max-w-md w-full p-6 fade-in">
      <div class="flex flex-col items-center text-center">
        <div
          class="w-20 h-20 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full flex items-center justify-center mb-4 shadow-lg">
          <i class="fas fa-question-circle text-white text-3xl"></i>
        </div>
        <h3 class="text-xl font-extrabold text-gray-900 mb-2">Konfirmasi Pesanan</h3>
        <p class="text-base text-gray-600 mb-6">Apakah Anda yakin dengan data yang telah diisi?</p>

        <!-- Order Summary -->
        <div class="w-full glass-futuristic rounded-xl p-4 mb-6 border border-white/50 text-left">
          <div class="space-y-2">
            <div class="flex justify-between items-center">
              <span class="text-sm font-bold text-emerald-700">Nama</span>
              <span class="font-extrabold text-gray-900 text-base" id="confirmName">-</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm font-bold text-emerald-700">No HP</span>
              <span class="font-extrabold text-gray-900 text-base" id="confirmPhone">-</span>
            </div>
          </div>
        </div>

        <div class="flex gap-3 w-full">
          <button id="cancelConfirmBtn"
            class="flex-1 px-4 py-3 bg-white/60 hover:bg-white/80 text-gray-700 rounded-xl transition-all duration-300 text-base font-extrabold border border-white/60">
            <i class="fas fa-times mr-2"></i>
            Batal
          </button>
          <button id="proceedConfirmBtn"
            class="flex-1 px-4 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-base font-extrabold shadow-lg">
            <i class="fas fa-check mr-2"></i>
            Ya, Kirim
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Only allow numbers in phone input, show warning, disable submit
    document.addEventListener('DOMContentLoaded', function () {
      var phoneInput = document.getElementById('customer_phone');
      var phoneWarning = document.getElementById('phoneWarning');
      var submitBtn = document.getElementById('checkoutSubmitBtn');
      if (phoneInput) {
        phoneInput.addEventListener('input', function (e) {
          var oldValue = this.value;
          var newValue = oldValue.replace(/[^0-9]/g, '');
          if (oldValue !== newValue) {
            this.value = newValue;
            phoneWarning.classList.remove('hidden');
            if (submitBtn) submitBtn.disabled = true;
          } else {
            phoneWarning.classList.add('hidden');
            // Enable submit only if not empty
            if (submitBtn) submitBtn.disabled = !newValue;
          }
        });
        // Initial state
        if (submitBtn) submitBtn.disabled = !phoneInput.value;
      }
    });
    // Only allow numbers in phone input
    document.addEventListener('DOMContentLoaded', function () {
      var phoneInput = document.getElementById('customer_phone');
      if (phoneInput) {
        phoneInput.addEventListener('input', function (e) {
          this.value = this.value.replace(/[^0-9]/g, '');
        });
      }
    });
    const submitBtn = document.getElementById('checkoutSubmitBtn');
    const form = document.getElementById('checkoutForm');
    const confirmationModal = document.getElementById('confirmationModal');
    const eventAdminWhatsapp = "<%= (event && event.admin_whatsapp) ? event.admin_whatsapp : '' %>";
    let formDataCache = {};

    // Helper functions untuk modal
    function showConfirmationModal() {
      confirmationModal.classList.remove('hidden');
    }

    function hideConfirmationModal() {
      confirmationModal.classList.add('hidden');
    }

    // Close modals with Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideConfirmationModal();
      }
    });

    // Click outside to close
    confirmationModal.addEventListener('click', (e) => {
      if (e.target === confirmationModal) hideConfirmationModal();
    });

    // Cancel button in confirmation modal
    document.getElementById('cancelConfirmBtn').addEventListener('click', hideConfirmationModal);

    // Form submission - show confirmation first
    form?.addEventListener('submit', async function (e) {
      e.preventDefault();

      // Get form data
      const formData = {
        customer_name: form.customer_name.value,
        customer_phone: form.customer_phone.value,
        event_id: form.event_id.value,
        affiliate_ref: form.affiliate_ref?.value || null,
      };

      // Update confirmation modal with form data
      document.getElementById('confirmName').textContent = formData.customer_name;
      document.getElementById('confirmPhone').textContent = formData.customer_phone;

      // Store form data for later use
      formDataCache = formData;

      // Show confirmation modal
      showConfirmationModal();
    });

    // Proceed with actual submission
    function resolveAdminContactTarget(raw) {
      if (!raw) return '';
      const value = String(raw).trim();
      if (!value) return '';
      if (/^https?:\/\//i.test(value)) return value;

      const digits = value.replace(/[^\d]/g, '');
      if (!digits) return '';
      if (digits.startsWith('0')) return `https://wa.me/62${digits.slice(1)}`;
      if (digits.startsWith('62')) return `https://wa.me/${digits}`;
      return `https://wa.me/${digits}`;
    }

    document.getElementById('proceedConfirmBtn').addEventListener('click', async function () {
      hideConfirmationModal();

      try {
        const response = await fetch('/transactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formDataCache),
        });

        if (!response.ok) {
          throw new Error('Gagal menyimpan data');
        }
      } catch (err) {
        alert('Gagal mengirim data. Silakan coba lagi.');
        return;
      }

      const contactTarget = resolveAdminContactTarget(eventAdminWhatsapp);
      if (!contactTarget) {
        alert('Kontak admin belum diatur untuk event ini.');
        return;
      }

      window.location.href = contactTarget;
    });
  </script>
</body>

</html>