<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checkout - Affillink</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="bg-light text-dark font-sans">
    <nav class="bg-white shadow p-4">
      <div class="container mx-auto px-4">
        <a href="/" class="font-bold text-lg text-primary">Affillink</a>
      </div>
    </nav>

    <main class="container mx-auto p-6 max-w-3xl">
      <h1 class="text-2xl font-bold mb-4">Checkout</h1>

      <% if (!event) { %>
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded mb-6">
        <p class="font-medium">Event tidak ditemukan.</p>
        <p class="text-sm text-gray">Silakan kembali ke halaman utama dan pilih event lagi.</p>
      </div>
      <a href="/" class="inline-block px-4 py-2 bg-primary text-white rounded">Kembali ke Landing Page</a>
      <% } else { %>

      <div class="bg-white rounded-2xl shadow p-6 mb-6">
        <div class="mb-4">
          <h2 class="text-xl font-semibold"><%= event.name %></h2>
          <div class="text-sm text-gray mt-1">
            <% if (event.price_original && Number(event.price_original) > 0) { %>
              <% if (event.price_promo && Number(event.price_promo) < Number(event.price_original)) { %>
                <div class="line-through text-gray-400">Rp <%= parseInt(event.price_original).toLocaleString('id-ID') %></div>
                <div class="text-2xl font-bold">Rp <%= parseInt(event.price_promo).toLocaleString('id-ID') %></div>
              <% } else { %>
                <div class="text-2xl font-bold">Rp <%= parseInt(event.price_original).toLocaleString('id-ID') %></div>
              <% } %>
            <% } else { %>
              <div class="text-2xl font-bold">Gratis</div>
            <% } %>
          </div>
        </div>

        <form id="checkoutForm" class="space-y-4">
          <input type="hidden" name="event_id" value="<%= event.id %>" />
          <input type="hidden" name="affiliate_ref" value="<%= ref || '' %>" />

          <div>
            <label class="block text-sm font-medium text-gray-700">Nama</label>
            <input name="customer_name" required class="mt-1 block w-full border border-gray-200 rounded-lg p-2" placeholder="Nama lengkap" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <input name="customer_email" type="email" class="mt-1 block w-full border border-gray-200 rounded-lg p-2" placeholder="email@contoh.com" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">No HP</label>
            <input name="customer_phone" required class="mt-1 block w-full border border-gray-200 rounded-lg p-2" placeholder="0812xxxx" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">Pilih Metode Pembayaran</label>
            <select name="payment_method" required class="mt-1 block w-full border border-gray-200 rounded-lg p-2">
              <option value="transfer">Transfer</option>
              <option value="cash">Cash</option>
            </select>
          </div>

          <div class="flex justify-end gap-3 pt-2">
            <a href="/" class="px-4 py-2 border rounded-lg bg-white">Batal</a>
            <button id="checkoutSubmitBtn" type="submit" aria-label="Kirim Pesanan" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg">Kirim</button>
          </div>
        </form>

        <!-- Payment confirmation modal (replaces inline bank instructions) -->
        <div id="paymentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div id="paymentModalPanel" class="bg-white rounded-lg p-6 max-w-md w-full transform transition ease-out duration-300 opacity-0 scale-95">
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-semibold text-lg">Pembayaran Terkirim</h3>
              <button id="closePaymentModal" class="text-gray-500 hover:text-gray-700 text-2xl leading-none">&times;</button>
            </div>
            <p class="text-sm text-gray-700 mb-3">Terima kasih. Data Anda sudah kami terima. Silakan lakukan pembayaran sesuai instruksi berikut:</p>
            <div class="text-sm text-gray mb-2"><strong id="modal_bank_name">-</strong></div>
            <div class="text-sm text-gray mb-2"><strong>Atas nama: </strong><span id="modal_bank_account_name">-</span></div>
            <div class="text-sm text-gray mb-2"><strong>No Rekening: </strong><span id="modal_bank_account_number">-</span></div>
            <div class="mt-4 flex justify-end gap-2">
              <button id="modalCloseBtn" class="px-4 py-2 bg-gray-100 rounded">Tutup</button>
            </div>
          </div>
        </div>

      </div>

      <% } %>
    </main>

    <script>
      const submitBtn = document.getElementById('checkoutSubmitBtn') || document.querySelector('#checkoutForm button[type="submit"]');
      document.getElementById('checkoutForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();
        const form = e.target;
        const data = {
          customer_name: form.customer_name.value,
          customer_email: form.customer_email?.value || null,
          customer_phone: form.customer_phone.value,
          payment_method: form.payment_method.value,
          event_id: form.event_id.value,
          affiliate_ref: form.affiliate_ref?.value || null,
        };

        // prevent duplicate clicks and show loading state
        const originalBtnText = submitBtn ? submitBtn.textContent : 'Kirim';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Mengirim...';
          submitBtn.setAttribute('aria-disabled', 'true');
        }

        try {
          const res = await fetch('/transactions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const json = await res.json();
          if (!json || !json.success) {
            alert('Terjadi kesalahan saat menyimpan transaksi. Silakan coba lagi.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalBtnText;
              submitBtn.removeAttribute('aria-disabled');
            }
            return;
          }

          // Show modal with bank info and prevent duplicate submissions
          const bank = json.bankInfo || {};
          document.getElementById('modal_bank_name').textContent = bank.bank_name || '-';
          document.getElementById('modal_bank_account_name').textContent = bank.bank_account_name || '-';
          document.getElementById('modal_bank_account_number').textContent = bank.bank_account_number || '-';

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Terkirim';
            submitBtn.setAttribute('aria-disabled', 'true');
          }

          // show modal with animation and auto-close
          const modal = document.getElementById('paymentModal');
          const panel = document.getElementById('paymentModalPanel');
          if (modal && panel) {
            modal.classList.remove('hidden');
            // force reflow so transition runs
            void panel.offsetWidth;
            panel.classList.remove('opacity-0', 'scale-95');
            panel.classList.add('opacity-100', 'scale-100');

            // clear previous timer if any
            if (window._paymentModalAutoCloseTimer) clearTimeout(window._paymentModalAutoCloseTimer);
            // auto-close after 5 seconds
            window._paymentModalAutoCloseTimer = setTimeout(() => {
              closePaymentModal();
            }, 5000);
          }

        } catch (err) {
          console.error('submit checkout error', err);
          alert('Terjadi kesalahan, coba lagi.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalBtnText;
            submitBtn.removeAttribute('aria-disabled');
          }
        }
      });

      // Modal close helpers and handlers with animation + overlay/ESC support
      function closePaymentModal() {
        const modal = document.getElementById('paymentModal');
        const panel = document.getElementById('paymentModalPanel');
        if (!modal || !panel) return;
        // animate out
        panel.classList.remove('opacity-100', 'scale-100');
        panel.classList.add('opacity-0', 'scale-95');
        // hide overlay after animation duration
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 300);
        if (window._paymentModalAutoCloseTimer) {
          clearTimeout(window._paymentModalAutoCloseTimer);
          window._paymentModalAutoCloseTimer = null;
        }
      }

      document.getElementById('closePaymentModal')?.addEventListener('click', closePaymentModal);
      document.getElementById('modalCloseBtn')?.addEventListener('click', closePaymentModal);
      // click overlay outside panel to close
      document.getElementById('paymentModal')?.addEventListener('click', (e) => {
        if (e.target === document.getElementById('paymentModal')) closePaymentModal();
      });
      // close with Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closePaymentModal();
      });
    </script>
  </body>
</html>