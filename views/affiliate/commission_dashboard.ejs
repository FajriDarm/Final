<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Komisi - Affillink Affiliate</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-warning {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .gradient-info {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    }

    .gradient-yellow {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .gradient-blue {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
    }

    .gradient-primary:hover {
      box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.2);
    }

    .gradient-secondary:hover {
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .gradient-warning:hover {
      box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.2);
    }

    .gradient-info:hover {
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }

    .gradient-yellow:hover {
      box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.2);
    }

    .gradient-blue:hover {
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: typeof name !=='undefined' ? name : '' }) %>

    <!-- Main Content -->
    <main class="ml-64 pt-16 min-h-screen">
      <div class="p-6">
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
          <div class="mb-4 md:mb-0">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                <i class="fas fa-coins text-white text-xl"></i>
              </div>
              <div>
                <h1 class="text-3xl font-bold text-gray-900">Dashboard Komisi</h1>
                <p class="text-gray-600 mt-1">Kelola dan tarik komisi Anda</p>
              </div>
            </div>
          </div>
          <button onclick="openWithdrawalModal()"
            class="px-6 py-3 gradient-primary text-white rounded-lg font-medium hover:shadow-lg transition inline-flex items-center gap-2">
            <i class="fas fa-money-bill-wave"></i>
            Ajukan Penarikan
          </button>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <!-- Pending Card -->
          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Komisi Pending</p>
                <p class="text-2xl font-bold text-gray-900 mt-2 summary-value" id="pendingAmount">Rp 0,00</p>
                <div class="flex items-center gap-2 mt-2">
                  <span class="text-xs text-gray-500" id="pendingCount">0 transaksi</span>
                  <span
                    class="px-2 py-0.5 rounded-full text-xs font-medium border border-yellow-200 bg-yellow-100 text-yellow-800">
                    <i class="fas fa-hourglass-half mr-1"></i>
                    Belum verified
                  </span>
                </div>
              </div>
              <div class="w-12 h-12 gradient-warning rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-clock text-white text-xl"></i>
              </div>
            </div>
          </div>

          <!-- Total Commission (matches "Komisi Anda" on Affiliate Dashboard) -->
          <div class="glass-card rounded-2xl shadow-lg p-6 border border-gray-100 card-hover">
            <div>
              <p class="text-gray-500 text-sm font-medium">Total Komisi</p>
              <p class="text-3xl font-bold text-gray-900 mt-2 summary-value" id="totalCommissionDisplay">Rp 0,00</p>
              <p class="text-xs text-gray-500 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Total semua status (pending + ready + paid)
              </p>
            </div>
          </div>

          <!-- Ready for Withdraw Card -->
          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-200 card-hover ring-1 ring-green-100">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Siap Ditarik</p>
                <p class="text-2xl font-bold text-green-700 mt-2 summary-value" id="readyAmount">Rp 0,00</p>
                <div class="flex items-center gap-2 mt-2">
                  <span class="text-xs text-gray-500" id="readyCount">0 transaksi</span>
                  <span
                    class="px-2 py-0.5 rounded-full text-xs font-medium border border-green-200 bg-green-100 text-green-800">
                    <i class="fas fa-check mr-1"></i>
                    Verified ✓
                  </span>
                </div>
              </div>
              <div class="w-12 h-12 gradient-secondary rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-check-circle text-white text-xl"></i>
              </div>
            </div>
            <button onclick="openWithdrawalModal()"
              class="mt-4 w-full px-4 py-2 gradient-secondary text-white rounded-lg font-medium hover:shadow-lg transition text-sm">
              Ajukan Penarikan
            </button>
          </div>

          <!-- Paid Card -->
          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Komisi Diterima</p>
                <p class="text-2xl font-bold text-blue-700 mt-2 summary-value" id="paidAmount">Rp 0,00</p>
                <div class="flex items-center gap-2 mt-2">
                  <span class="text-xs text-gray-500" id="paidCount">0 transaksi</span>
                  <span
                    class="px-2 py-0.5 rounded-full text-xs font-medium border border-blue-200 bg-blue-100 text-blue-800">
                    <i class="fas fa-check-double mr-1"></i>
                    Sudah ditransfer
                  </span>
                </div>
              </div>
              <div class="w-12 h-12 gradient-blue rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-coins text-white text-xl"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Main Content Container -->
        <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
          <!-- Tabs Header -->
          <div class="px-6 py-4 gradient-primary">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-lg font-semibold text-white">Kelola Komisi</h2>
                <p class="text-green-100 text-sm mt-1">Review dan tarik komisi yang sudah tersedia</p>
              </div>
            </div>
          </div>

          <!-- Tabs Navigation -->
          <div class="px-6 py-3 bg-green-50 border-b border-green-100">
            <div class="flex space-x-2">
              <button onclick="switchTab('ready')"
                class="tab-button active flex-none px-4 py-2 rounded-lg font-medium bg-emerald-600 text-white shadow-sm transition transform hover:scale-105">
                <i class="fas fa-check-circle mr-2"></i>
                Siap Ditarik
              </button>
              <button onclick="switchTab('history')"
                class="tab-button flex-none px-4 py-2 rounded-lg font-medium bg-transparent text-gray-700 hover:bg-green-100 transition">
                <i class="fas fa-history mr-2"></i>
                Riwayat Penarikan
              </button>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <!-- Ready Tab -->
            <div id="tab-ready" class="tab-content">
              <div class="space-y-4">
                <!-- Info Banner -->
                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-4 mb-6">
                  <p class="text-sm text-blue-900">
                    <strong><i class="fas fa-info-circle mr-2"></i>Catatan:</strong> Hanya menampilkan komisi yang sudah
                    diverifikasi Stage 3 dan siap diambil.
                    Lihat <a href="/affiliate/dashboard" class="font-semibold underline text-blue-700">Dashboard
                      Affiliate</a> untuk melihat TOTAL semua komisi (pending + ready + paid).
                  </p>
                </div>

                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-semibold text-gray-900">Komisi Siap Ditarik</h3>
                  <div class="text-sm text-gray-700">
                    Total: <span class="font-semibold text-green-700" id="readyTotal">0</span> transaksi
                  </div>
                </div>

                <div id="readyCommissionsContainer" class="space-y-3">
                  <div class="text-center py-12 text-gray-500">
                    <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
                    <p>Memuat komisi...</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- History Tab -->
            <div id="tab-history" class="tab-content hidden">
              <div class="space-y-4">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg font-semibold text-gray-900">Riwayat Penarikan</h3>
                  <div class="text-sm text-gray-700">
                    Total: <span class="font-semibold text-green-700" id="historyTotal">0</span> permintaan
                  </div>
                </div>

                <div id="withdrawalHistoryContainer" class="space-y-3">
                  <div class="text-center py-12 text-gray-500">
                    <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
                    <p>Memuat riwayat...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Footer Stats -->
          <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
              <div class="text-green-700 font-medium">
                Total komisi tersedia: <span class="font-semibold text-green-700" id="totalReady">0</span> transaksi
              </div>
              <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Sidebar -->
    <%- include('../sidebar/affiliate.ejs') %>

      <!-- Modals -->
      <!-- Proof Modal -->
      <div id="proofModal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
          <div class="sticky top-0 bg-white border-b px-6 py-4 flex justify-between items-center">
            <h3 class="text-xl font-bold text-gray-900">Bukti Transfer</h3>
            <button onclick="closeProofModal()" class="text-gray-500 hover:text-gray-700">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
          <div class="p-6">
            <div id="proof-content" class="text-center py-8">
              <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
              <p class="text-gray-500">Memuat bukti...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Withdrawal Detail Modal -->
      <div id="withdrawalDetailModal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
          <div class="sticky top-0 bg-white border-b px-6 py-4 flex justify-between items-center">
            <h3 id="detailModalTitle" class="text-xl font-bold text-gray-900">Detail Penarikan</h3>
            <button onclick="closeWithdrawalDetailModal()" class="text-gray-500 hover:text-gray-700">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
          <div id="withdrawalDetailContent" class="p-6">
            <div class="text-center py-8 text-gray-500">
              <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
              <p>Memuat detail...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Withdrawal Modal -->
      <div id="withdrawalModal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full">
          <div class="bg-gradient-primary text-white rounded-t-2xl px-6 py-4">
            <h3 class="text-lg font-bold">
              <i class="fas fa-money-bill-wave mr-2"></i>
              Ajukan Penarikan
            </h3>
          </div>
          <div class="p-6 space-y-4">
            <!-- Info Box -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-4">
              <p class="text-sm text-blue-900">
                <strong>Total Siap Ditarik:</strong> <br>
                <span class="text-2xl font-bold text-blue-600" id="modalReadyAmount">Rp 0</span>
              </p>
            </div>

            <!-- Selection Mode -->
            <div class="space-y-2">
              <label class="block text-sm font-medium text-gray-700 mb-2">Pilih Komisi</label>
              <div class="space-y-2">
                <label
                  class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-green-50 transition">
                  <input type="radio" name="selectionMode" value="all" checked onchange="updateSelectionMode()"
                    class="w-4 h-4 text-emerald-600">
                  <span class="text-sm">Tarik Semua (<span id="allCount">0</span> komisi)</span>
                </label>
                <label
                  class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-green-50 transition">
                  <input type="radio" name="selectionMode" value="select" onchange="updateSelectionMode()"
                    class="w-4 h-4 text-emerald-600">
                  <span class="text-sm">Pilih Komisi Tertentu</span>
                </label>
              </div>
            </div>

            <!-- Selected Commissions -->
            <div id="selectCommissionsContainer" class="hidden space-y-2">
              <label class="block text-sm font-medium text-gray-700 mb-2">Pilih Komisi yang Ingin Ditarik</label>
              <div id="selectCheckboxes"
                class="space-y-2 max-h-40 overflow-y-auto border border-gray-200 rounded-lg p-3">
                <div class="text-center py-4 text-gray-500">
                  <i class="fas fa-spinner fa-spin mb-2 text-emerald-600"></i>
                  <p>Memuat komisi...</p>
                </div>
              </div>
            </div>

            <!-- Submit Buttons -->
            <div class="flex gap-3 pt-4">
              <button onclick="closeWithdrawalModal()"
                class="flex-1 px-4 py-3 border border-gray-300 rounded-lg font-medium text-gray-700 hover:bg-gray-50 transition">
                Batal
              </button>
              <button onclick="submitWithdrawal()"
                class="flex-1 px-4 py-3 gradient-primary text-white rounded-lg font-medium hover:shadow-lg transition">
                <i class="fas fa-check-circle mr-2"></i>
                Ajukan
              </button>
            </div>
          </div>
        </div>
      </div>

      <script>
        let userId = '<%= typeof user_id !== "undefined" ? user_id : "" %>';
        let selectedCommissionIds = [];
        let token = '';

        // Get token from localStorage (set by login/session)
        function getToken() {
          const stored = localStorage.getItem('authToken');
          if (stored) {
            token = stored;
            return token;
          }
          // Fallback: try to get from cookie
          const cookies = document.cookie.split(';');
          for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'token' || name === 'authToken') {
              token = value;
              return token;
            }
          }
          return '';
        }

        // Get initial token
        getToken();

        // Load commission summary on page load
        document.addEventListener('DOMContentLoaded', async function () {
          await loadCommissionSummary();
          await loadReadyCommissions();
          await loadWithdrawalHistory();

          // Initialize SSE for real-time updates
          initCommissionSSE();
        });

        // Load commission summary
        async function loadCommissionSummary() {
          try {
            const response = await fetch(`/affiliate/api/commissions/summary?user_id=${userId}`);
            const data = await response.json();

            if (data.success) {
              const summary = data.data;

              // Update UI
              document.getElementById('pendingAmount').textContent = 'Rp ' + Number(summary.pending.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              document.getElementById('pendingCount').textContent = (summary.pending.count || 0) + ' transaksi';

              // Prefer "ready-by-lead" totals (lead_status = 'SEDANG BERANGKAT') for the UI "Siap Ditarik" display.
              try {
                const respLead = await fetch(`/affiliate/api/commissions/ready-by-lead?user_id=${userId}`);
                const leadData = await respLead.json();
                if (leadData && leadData.success && leadData.data) {
                  const readyTotalVal = Number(leadData.data.total || 0);
                  document.getElementById('readyAmount').textContent = 'Rp ' + readyTotalVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('readyCount').textContent = (leadData.data.count || 0) + ' transaksi';
                  document.getElementById('modalReadyAmount').textContent = 'Rp ' + readyTotalVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('allCount').textContent = leadData.data.count || 0;
                  document.getElementById('totalReady').textContent = leadData.data.count || 0;
                } else {
                  // fallback to original summary.ready
                  const fallbackVal = Number(summary.ready.total || 0);
                  document.getElementById('readyAmount').textContent = 'Rp ' + fallbackVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('readyCount').textContent = (summary.ready.count || 0) + ' transaksi';
                  document.getElementById('modalReadyAmount').textContent = 'Rp ' + fallbackVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('allCount').textContent = summary.ready.count || 0;
                  document.getElementById('totalReady').textContent = summary.ready.count || 0;
                }
              } catch (e) {
                console.debug('ready-by-lead fetch failed, fallback to summary.ready', e);
                document.getElementById('readyAmount').textContent = 'Rp ' + Number(summary.ready.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('readyCount').textContent = (summary.ready.count || 0) + ' transaksi';
                document.getElementById('modalReadyAmount').textContent = 'Rp ' + Number(summary.ready.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('allCount').textContent = summary.ready.count || 0;
                document.getElementById('totalReady').textContent = summary.ready.count || 0;
              }

              document.getElementById('paidAmount').textContent = 'Rp ' + Number(summary.paid.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              document.getElementById('paidCount').textContent = (summary.paid.count || 0) + ' transaksi';

              // Also fetch overall totalCommission (same source as Dashboard Affiliate)
              try {
                const respStatus = await fetch('/affiliate/api/status');
                const st = await respStatus.json();
                if (st && st.success && st.data && typeof st.data.totalCommission !== 'undefined') {
                  const commissionValue = parseFloat(st.data.totalCommission) || 0;
                  const el = document.getElementById('totalCommissionDisplay');
                  if (el) el.textContent = 'Rp ' + commissionValue.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  // Responsive: add .break-all to summary values for large numbers
                  document.querySelectorAll('.summary-value').forEach(el => el.classList.add('break-all'));
                }
              } catch (e) {
                console.debug('Could not fetch totalCommission from /affiliate/api/status', e);
              }
            }
          } catch (error) {
            console.error('Error loading summary:', error);
            alert('Gagal memuat ringkasan komisi');
          }
        }

        // Load ready commissions
        async function loadReadyCommissions() {
          try {
            const response = await fetch(`/affiliate/api/commissions/ready?user_id=${userId}`);
            const data = await response.json();

            if (data.success && data.data) {
              const container = document.getElementById('readyCommissionsContainer');
              document.getElementById('readyTotal').textContent = data.data.length;

              if (data.data.length === 0) {
                container.innerHTML = `
              <div class="text-center py-16">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <i class="fas fa-inbox text-green-600 text-xl"></i>
                </div>
                <p class="text-gray-600 font-medium">Tidak ada komisi yang siap ditarik</p>
                <p class="text-sm text-gray-500 mt-2">Semua komisi sudah diproses atau belum tersedia</p>
              </div>
            `;
                return;
              }

              let html = '';
              data.data.forEach(comm => {
                html += `
              <div class="bg-white border border-green-100 rounded-xl p-5 card-hover">
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-calendar-check text-green-600"></i>
                      </div>
                      <div>
                        <div class="font-semibold text-gray-900">${comm.event_title || 'Event'}</div>
                        <div class="text-xs text-gray-500">Transaksi #${comm.transaction_id}</div>
                      </div>
                    </div>
                    <div class="text-sm text-gray-600">
                      <div class="flex items-center gap-4 flex-wrap">
                        <span class="flex items-center gap-1">
                          <i class="fas fa-coins"></i>
                          Rp ${Number(comm.amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                        </span>
                        <span class="flex items-center gap-1">
                          <i class="fas fa-calendar"></i>
                          ${new Date(comm.created_at).toLocaleDateString('id-ID')}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="md:text-right">
                    <span class="inline-block px-3 py-1.5 rounded-full text-xs font-medium border border-green-200 bg-green-100 text-green-800 status-badge">
                      <i class="fas fa-check-circle mr-1.5"></i>
                      Siap Ditarik
                    </span>
                  </div>
                </div>
              </div>
            `;
              });

              container.innerHTML = html;

              // Load checkboxes for selection mode
              loadSelectCheckboxes(data.data);
            }
          } catch (error) {
            console.error('Error loading ready commissions:', error);
            container.innerHTML = `
          <div class="text-center py-16">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
            </div>
            <p class="text-gray-600 font-medium">Gagal memuat komisi</p>
            <p class="text-sm text-gray-500 mt-2">${error.message}</p>
          </div>
        `;
          }
        }

        // Load checkboxes for selection
        function loadSelectCheckboxes(commissions) {
          const container = document.getElementById('selectCheckboxes');

          let html = '';
          commissions.forEach(comm => {
            html += `
          <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-green-50 transition">
            <input type="checkbox" value="${comm.id}" onchange="updateSelectedCommissions()" class="w-4 h-4 text-emerald-600 commission-checkbox">
            <span class="text-sm text-gray-700">
              <span class="font-medium">${comm.event_title || 'Event'}</span>
              <span class="text-green-700 font-semibold"> - Rp ${Number(comm.amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
            </span>
          </label>
        `;
          });

          container.innerHTML = html;
        }

        // Load withdrawal history
        async function loadWithdrawalHistory() {
          try {
            const headers = {};
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const response = await fetch(`/affiliate/api/withdrawal/requests?user_id=${userId}`, {
              method: 'GET',
              headers: headers
            });
            const data = await response.json();

            if (data.success && data.data) {
              const container = document.getElementById('withdrawalHistoryContainer');
              document.getElementById('historyTotal').textContent = data.data.length;

              if (data.data.length === 0) {
                container.innerHTML = `
              <div class="text-center py-16">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <i class="fas fa-history text-green-600 text-xl"></i>
                </div>
                <p class="text-gray-600 font-medium">Belum ada riwayat penarikan</p>
                <p class="text-sm text-gray-500 mt-2">Mulai ajukan penarikan komisi Anda</p>
              </div>
            `;
                return;
              }

              let html = '';
              data.data.forEach(withdraw => {
                let statusColor = 'text-yellow-700 bg-yellow-100 border-yellow-200';
                let statusIcon = 'fa-clock';
                let statusLabel = 'Pending';

                if (withdraw.status === 'approved') {
                  statusColor = 'text-blue-700 bg-blue-100 border-blue-200';
                  statusIcon = 'fa-check-circle';
                  statusLabel = 'Approved';
                } else if (withdraw.status === 'paid') {
                  statusColor = 'text-green-700 bg-green-100 border-green-200';
                  statusIcon = 'fa-check-double';
                  statusLabel = 'Paid';
                } else if (withdraw.status === 'rejected') {
                  statusColor = 'text-red-700 bg-red-100 border-red-200';
                  statusIcon = 'fa-times-circle';
                  statusLabel = 'Rejected';
                }

                const hasProof = withdraw.proof_file ? true : false;

                html += `
              <div class="bg-white border border-green-100 rounded-xl p-5 card-hover">
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-file-invoice-dollar text-green-600"></i>
                      </div>
                      <div>
                        <div class="font-bold text-lg text-green-700">Rp ${(withdraw.total_amount || 0).toLocaleString('id-ID')}</div>
                        <div class="text-xs text-gray-500">ID: #${withdraw.id} • ${new Date(withdraw.created_at).toLocaleDateString('id-ID')}</div>
                      </div>
                    </div>
                    <div class="text-sm text-gray-600">
                      <div class="flex items-center gap-4 flex-wrap">
                        <span class="flex items-center gap-1">
                          <i class="fas fa-coins"></i>
                          ${withdraw.commission_count} komisi
                        </span>
                        ${hasProof ? `
                          <span class="flex items-center gap-1 text-blue-600">
                            <i class="fas fa-file-image"></i>
                            Bukti tersedia
                          </span>
                        ` : ''}
                      </div>
                    </div>
                  </div>
                  <div class="md:text-right flex flex-col items-end gap-2">
                    <span class="inline-block px-3 py-1.5 rounded-full text-xs font-medium border status-badge ${statusColor}">
                      <i class="fas ${statusIcon} mr-1.5"></i>
                      ${statusLabel}
                    </span>
                    <div class="flex gap-2">
                      <button onclick="event.stopPropagation(); viewWithdrawalDetail(${withdraw.id})" class="px-3 py-1.5 border border-green-200 text-green-700 rounded-lg font-medium hover:bg-green-50 transition text-sm">
                        <i class="fas fa-eye mr-1"></i>
                        Detail
                      </button>
                      ${hasProof ? `
                        <button onclick="event.stopPropagation(); viewProof(${withdraw.id})" class="px-3 py-1.5 bg-gradient-info text-white rounded-lg font-medium hover:shadow-lg transition text-sm">
                          <i class="fas fa-file-image mr-1"></i>
                          Bukti
                        </button>
                      ` : ''}
                    </div>
                  </div>
                </div>
              </div>
            `;
              });

              container.innerHTML = html;
            }
          } catch (error) {
            console.error('Error loading history:', error);
            container.innerHTML = `
          <div class="text-center py-16">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-exclamation-circle text-red-600 text-xl"></i>
            </div>
            <p class="text-gray-600 font-medium">Gagal memuat riwayat</p>
            <p class="text-sm text-gray-500 mt-2">${error.message}</p>
          </div>
        `;
          }
        }

        // Initialize SSE (Server Sent Events) to update totals in real-time
        function initCommissionSSE() {
          if (!('EventSource' in window)) return;
          const es = new EventSource('/affiliate/commission-events');
          es.onopen = () => console.debug('Commission SSE connected');
          es.onerror = (e) => console.error('Commission SSE error', e);

          // commission_awarded broadcast includes commission info (affiliate_id, amount, transaction_id)
          es.addEventListener('commission_awarded', async (e) => {
            try {
              const data = JSON.parse(e.data);
              if (!data) return;
              // if event is for current affiliate, refresh summaries
              if (Number(data.affiliate_id) === Number(userId)) {
                await loadCommissionSummary();
                await loadReadyCommissions();
                showCommissionToast(data.amount, data.transaction_id);
              }
            } catch (err) {
              console.error('commission_awarded handler error', err);
            }
          });

          // status_update broadcast from Sales (when lead_status changes)
          es.addEventListener('status_update', async (e) => {
            try {
              const d = JSON.parse(e.data);
              const s = (d.status || '').toString().toUpperCase();
              if (s === 'SEDANG BERANGKAT') {
                // A transaction moved to SEDANG BERANGKAT — refresh totals
                await loadCommissionSummary();
                await loadReadyCommissions();
                // optional small notification
                const msg = `Lead #${d.id} ditandai SEDANG BERANGKAT`;
                const el = document.createElement('div');
                el.className = 'fixed bottom-6 left-6 bg-blue-600 text-white px-4 py-2 rounded shadow-lg z-50';
                el.textContent = msg;
                document.body.appendChild(el);
                setTimeout(()=> el.remove(), 4000);
              }
            } catch (err) {
              console.error('status_update handler error', err);
            }
          });
        }

        // Small toast for commission awarded
        function showCommissionToast(amount, transactionId) {
          try {
            const msg = `Komisi Rp ${Number(amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} telah ditambahkan (Tx #${transactionId})`;
            const el = document.createElement('div');
            el.className = 'fixed bottom-6 right-6 bg-green-600 text-white px-4 py-2 rounded shadow-lg z-50';
            el.textContent = msg;
            document.body.appendChild(el);
            setTimeout(() => el.classList.add('opacity-0'), 3500);
            setTimeout(() => el.remove(), 4000);
          } catch (e) { console.error(e); }
        }

        // Tab switching
        function switchTab(tab) {
          document.querySelectorAll('.tab-button').forEach(btn => {
            btn.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm');
            btn.classList.add('bg-transparent', 'text-gray-700');
          });

          document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.add('hidden');
          });

          const activeBtn = document.querySelector(`[data-tab="${tab}"]`);
          if (activeBtn) {
            activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow-sm');
            activeBtn.classList.remove('bg-transparent', 'text-gray-700');
          }

          document.getElementById(`tab-${tab}`).classList.remove('hidden');
        }

        // Add data-tab attributes to buttons
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('.tab-button').forEach((btn, index) => {
            const tab = index === 0 ? 'ready' : 'history';
            btn.setAttribute('data-tab', tab);
          });
        });

        // Modal functions
        function openWithdrawalModal() {
          // Ensure the latest ready commissions (and checkboxes) are loaded so "Pilih Komisi Tertentu" doesn't hang on spinner
          loadReadyCommissions().catch(() => {});
          document.getElementById('withdrawalModal').classList.remove('hidden');
        }

        function closeWithdrawalModal() {
          document.getElementById('withdrawalModal').classList.add('hidden');
          // Reset selection
          document.querySelector('input[name="selectionMode"][value="all"]').checked = true;
          document.getElementById('selectCommissionsContainer').classList.add('hidden');
          selectedCommissionIds = [];
        }

        function closeProofModal() {
          document.getElementById('proofModal').classList.add('hidden');
        }

        function closeWithdrawalDetailModal() {
          document.getElementById('withdrawalDetailModal').classList.add('hidden');
        }

        // View proof transfer
        async function viewProof(payoutId) {
          try {
            const headers = {};
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const response = await fetch(`/affiliate/api/withdrawal/requests/${payoutId}?user_id=${userId}`, {
              method: 'GET',
              headers: headers
            });
            const data = await response.json();

            if (data.success && data.data.proof_file) {
              const proofFile = data.data.proof_file;
              const proofContent = document.getElementById('proof-content');

              if (proofFile.toLowerCase().endsWith('.pdf')) {
                proofContent.innerHTML = `
              <div class="space-y-4">
                <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
                  <i class="fas fa-file-pdf text-red-600 text-4xl mb-3"></i>
                  <p class="text-gray-700 font-semibold">File PDF</p>
                </div>
                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-4">
                  <p class="text-sm text-blue-900 mb-3"><strong>Nama File:</strong> ${proofFile.split('/').pop()}</p>
                  <a href="${proofFile}" target="_blank" class="w-full px-4 py-2 gradient-info text-white rounded-lg font-medium hover:shadow-lg transition text-center inline-block">
                    <i class="fas fa-external-link-alt mr-2"></i>
                    Buka File PDF
                  </a>
                </div>
              </div>
            `;
              } else {
                proofContent.innerHTML = `
              <div class="space-y-4">
                <img src="${proofFile}" alt="Bukti Transfer" class="w-full rounded-xl border border-gray-300 shadow-sm">
                <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-4">
                  <p class="text-sm text-blue-900">
                    <strong>Format:</strong> Gambar<br>
                    <strong>File:</strong> ${proofFile.split('/').pop()}
                  </p>
                </div>
              </div>
            `;
              }

              document.getElementById('proofModal').classList.remove('hidden');
            } else {
              alert('Bukti transfer tidak ditemukan');
            }
          } catch (error) {
            console.error('Error loading proof:', error);
            alert('Gagal memuat bukti transfer');
          }
        }

        function updateSelectionMode() {
          const mode = document.querySelector('input[name="selectionMode"]:checked').value;
          const container = document.getElementById('selectCommissionsContainer');

          if (mode === 'select') {
            // show container
            container.classList.remove('hidden');
            // If the checkboxes area is still showing the loading spinner or empty, reload the ready commissions
            const checkboxesEl = document.getElementById('selectCheckboxes');
            if (!checkboxesEl || !checkboxesEl.children || checkboxesEl.children.length === 0 || checkboxesEl.querySelector('.fa-spinner')) {
              loadReadyCommissions().catch(() => {});
            }
          } else {
            container.classList.add('hidden');
            selectedCommissionIds = [];
          }
        }

        function updateSelectedCommissions() {
          const checkboxes = document.querySelectorAll('.commission-checkbox:checked');
          selectedCommissionIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
        }

        // Submit withdrawal
        async function submitWithdrawal() {
          const mode = document.querySelector('input[name="selectionMode"]:checked').value;
          const commissionIds = mode === 'select' ? selectedCommissionIds : null;

          if (mode === 'select' && commissionIds.length === 0) {
            alert('Pilih minimal satu komisi');
            return;
          }

          try {
            // Prepare headers and include Authorization if token is available
            const headers = { 'Content-Type': 'application/json' };
            if (token) headers['Authorization'] = `Bearer ${token}`;

            const response = await fetch(`/affiliate/api/withdrawal/request?user_id=${userId}`, {
              method: 'POST',
              headers: headers,
              body: JSON.stringify({ commission_ids: commissionIds })
            });

            // Try to parse JSON, but be resilient to non-JSON responses (e.g., HTML redirect)
            let data = null;
            try {
              data = await response.json();
            } catch (parseErr) {
              const text = await response.text();
              console.error('Non-JSON response from withdrawal request:', text);
              alert('Gagal mengajukan penarikan: server merespon dengan teks tidak terduga');
              return;
            }

            if (data && data.success) {
              alert(`✅ Permintaan penarikan berhasil!\nID: ${data.data.payout_id}\nJumlah: Rp ${data.data.total_amount.toLocaleString('id-ID')}\n${data.data.commission_count} komisi`);
              closeWithdrawalModal();


              setTimeout(async () => {
                await loadCommissionSummary();
                await loadReadyCommissions();
                await loadWithdrawalHistory();
              }, 500);
            } else {
              alert(`❌ Error: ${data.message}`);
            }
          } catch (error) {
            console.error('Error submitting withdrawal:', error);
            alert('Gagal mengajukan penarikan');
          }
        }

        // View withdrawal detail
        async function viewWithdrawalDetail(payoutId) {
          try {
            const headers = {};
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const response = await fetch(`/affiliate/api/withdrawal/requests/${payoutId}?user_id=${userId}`, {
              method: 'GET',
              headers: headers
            });
            const data = await response.json();

            if (data.success) {
              const payout = data.data;
              const commissions = payout.commissions || [];

              let commissionsHtml = '';
              const commissionRows = commissions.length > 0 ? commissions.map(comm => `
            <div class="flex justify-between items-center py-2 border-t border-gray-200">
              <div class="flex-1">
                <div class="font-medium text-gray-900">${comm.event_title || 'Event'}</div>
                <div class="text-xs text-gray-500">${new Date(comm.created_at).toLocaleDateString('id-ID')}</div>
              </div>
              <div class="font-semibold text-green-700">Rp ${parseFloat(comm.amount || 0).toLocaleString('id-ID')}</div>
            </div>
          `).join('') : '<p class="text-gray-500 text-sm text-center py-4">Tidak ada data komisi</p>';

              let proofHtml = '';
              if (payout.proof_file) {
                const pf = payout.proof_file;
                if (pf.toLowerCase().endsWith('.pdf')) {
                  proofHtml = `
                <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
                  <i class="fas fa-file-pdf text-red-600 text-4xl mb-3"></i>
                  <p class="text-gray-700 font-semibold mb-2">File PDF</p>
                  <a href="${pf}" target="_blank" class="w-full px-4 py-2 gradient-info text-white rounded-lg font-medium hover:shadow-lg transition text-center inline-block">Buka File PDF</a>
                </div>
              `;
                } else {
                  proofHtml = `
                <div class="text-center">
                  <img src="${pf}" alt="Bukti Transfer" class="w-full rounded-xl border border-gray-300 mb-3">
                  <button onclick="event.stopPropagation(); viewProof(${payout.id})" class="w-full px-4 py-2 gradient-info text-white rounded-lg font-medium hover:shadow-lg transition text-center">Lihat Bukti (Besar)</button>
                </div>
              `;
                }
              } else {
                proofHtml = '<p class="text-sm text-gray-500 text-center">Tidak ada bukti transfer</p>';
              }

              const financeNoteHtml = payout.finance_note ? `
            <div class="border-b pb-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-4">
              <h4 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
                <i class="fas fa-sticky-note"></i>
                Catatan Finance
              </h4>
              <p class="text-sm text-blue-800">${payout.finance_note}</p>
            </div>
          ` : '';

              const adminNoteHtml = payout.admin_note ? `
            <div class="border-b pb-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-4">
              <h4 class="font-semibold text-green-900 mb-2 flex items-center gap-2">
                <i class="fas fa-check-circle"></i>
                Catatan Admin Approval
              </h4>
              <p class="text-sm text-green-800">${payout.admin_note}</p>
            </div>
          ` : '';

              const detailHtml = `
            <div class="space-y-6">
              <!-- Affiliate Info -->
              <div class="border-b pb-4">
                <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                  <i class="fas fa-user-tie text-green-600"></i>
                  Informasi Affiliate
                </h4>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="text-sm text-gray-600">Nama</p>
                    <p class="font-medium text-gray-900">${payout.affiliate_name}</p>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Email</p>
                    <p class="font-medium text-gray-900">${payout.affiliate_email}</p>
                  </div>
                </div>
              </div>

              <!-- Bank Info -->
              <div class="border-b pb-4">
                <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                  <i class="fas fa-university text-green-600"></i>
                  Informasi Bank
                </h4>
                <div class="grid grid-cols-1 gap-4">
                  <div>
                    <p class="text-sm text-gray-600">Nama Bank</p>
                    <p class="font-medium text-gray-900">${payout.bank_name || '-'}</p>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Nomor Rekening</p>
                    <p class="font-medium text-gray-900">${payout.bank_account_number || '-'}</p>
                  </div>
                  <div>
                    <p class="text-sm text-gray-600">Atas Nama</p>
                    <p class="font-medium text-gray-900">${payout.bank_account_name || '-'}</p>
                  </div>
                </div>
              </div>

              ${financeNoteHtml}
              ${adminNoteHtml}

              <!-- Commissions -->
              <div>
                <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                  <i class="fas fa-coins text-green-600"></i>
                  Komisi yang Ditarik
                </h4>
                <div class="bg-gray-50 rounded-xl p-4 max-h-48 overflow-y-auto">
                  ${commissionRows}
                </div>
              </div>

              <!-- Proof -->
              <div>
                <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                  <i class="fas fa-file-image text-green-600"></i>
                  Bukti Transfer
                </h4>
                ${proofHtml}
              </div>

              <!-- Status Info -->
              <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-4">
                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div>
                    <p class="text-gray-600">Status</p>
                    <p class="font-semibold text-gray-900 capitalize">${payout.status}</p>
                  </div>
                  <div>
                    <p class="text-gray-600">Total</p>
                    <p class="font-bold text-lg text-green-700">Rp ${parseFloat(payout.total_amount || 0).toLocaleString('id-ID')}</p>
                  </div>
                  <div>
                    <p class="text-gray-600">Dibuat</p>
                    <p class="font-medium text-gray-900">${new Date(payout.created_at).toLocaleString('id-ID')}</p>
                  </div>
                  ${payout.paid_at ? `
                    <div>
                      <p class="text-gray-600">Dibayar</p>
                      <p class="font-medium text-gray-900">${new Date(payout.paid_at).toLocaleString('id-ID')}</p>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>
          `;

              document.getElementById('detailModalTitle').textContent = `Detail Penarikan #${payout.id}`;
              document.getElementById('withdrawalDetailContent').innerHTML = detailHtml;
              document.getElementById('withdrawalDetailModal').classList.remove('hidden');
            }
          } catch (error) {
            console.error('Error loading detail:', error);
            alert('Gagal memuat detail');
          }
        }
      </script>
</body>

</html>