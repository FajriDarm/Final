                  <span class="text-sm font-medium text-gray-700">Pilih Komisi Tertentu</span>
                </label>
              </div>
            </div>

            <!-- Selected Commissions -->
            <div id="selectCommissionsContainer" class="hidden space-y-2">
              <label class="block text-sm font-extrabold text-emerald-800 mb-2">Pilih Komisi yang Ingin Ditarik</label>
              <div id="selectCheckboxes"
                class="space-y-2 max-h-40 overflow-y-auto modern-scrollbar glass-futuristic rounded-xl p-3 border border-white/50">
                <div class="text-center py-4 text-gray-500">
                  <i class="fas fa-spinner fa-spin mb-2 text-emerald-600"></i>
                  <p class="text-sm">Memuat komisi...</p>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer">
            <button onclick="closeWithdrawalModal()"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 rounded-lg transition-all duration-300 text-sm font-extrabold flex items-center justify-center gap-1 border border-white/60">
              <i class="fas fa-times"></i>
              Batal
            </button>
            <button onclick="submitWithdrawal()"
              class="flex-1 gradient-primary text-white py-3 rounded-lg hover:opacity-90 transition-all duration-300 text-sm font-extrabold shadow-lg flex items-center justify-center gap-1">
              <i class="fas fa-check-circle"></i>
              Ajukan
            </button>
          </div>
        </div>
      </div>

      <!-- Withdrawal Detail Modal Premium -->
      <div id="withdrawalDetailModal" class="modal-overlay">
        <div class="modal-content">
          <div class="modal-header gradient-primary flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                <i class="fas fa-info-circle text-white text-sm"></i>
              </div>
              <div>
                <h3 id="detailModalTitle" class="text-lg font-extrabold text-white">Detail Penarikan</h3>
                <p class="text-emerald-100 text-sm mt-0.5">Informasi lengkap penarikan</p>
              </div>
            </div>
            <button onclick="closeWithdrawalDetailModal()"
              class="w-9 h-9 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-all duration-300 border border-white/30">
              <i class="fas fa-times text-white text-sm"></i>
            </button>
          </div>
          <div id="withdrawalDetailContent" class="modal-body modern-scrollbar">
            <div class="text-center py-8 text-gray-500">
              <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
              <p class="text-sm">Memuat detail...</p>
            </div>
          </div>
          <div class="modal-footer">
            <button onclick="closeWithdrawalDetailModal()"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 rounded-lg transition-all duration-300 text-sm font-extrabold flex items-center justify-center gap-1 border border-white/60">
              <i class="fas fa-times"></i>
              Tutup
            </button>
          </div>
        </div>
      </div>

      <!-- Proof Modal Premium -->
      <div id="proofModal" class="modal-overlay">
        <div class="modal-content">
          <div class="modal-header gradient-info flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                <i class="fas fa-file-image text-white text-sm"></i>
              </div>
              <div>
                <h3 class="text-lg font-extrabold text-white">Bukti Transfer</h3>
                <p class="text-emerald-100 text-sm mt-0.5">Bukti pembayaran penarikan</p>
              </div>
            </div>
            <button onclick="closeProofModal()"
              class="w-9 h-9 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-all duration-300 border border-white/30">
              <i class="fas fa-times text-white text-sm"></i>
            </button>
          </div>
          <div id="proof-content" class="modal-body text-center py-8">
            <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
            <p class="text-sm text-gray-500">Memuat bukti...</p>
          </div>
          <div class="modal-footer">
            <button onclick="closeProofModal()"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 rounded-lg transition-all duration-300 text-sm font-extrabold flex items-center justify-center gap-1 border border-white/60">
              <i class="fas fa-times"></i>
              Tutup
            </button>
          </div>
        </div>
      </div>

      <script>
        let userId = '<%= typeof user_id !== "undefined" ? user_id : "" %>';
        let selectedCommissionIds = [];
        let token = '';

        // ============================================================
        // FUNGSI NOTIFICATION MODAL
        // ============================================================

        const NotificationModal = {
          element: document.getElementById('notificationModal'),
          icon: document.getElementById('notificationIcon'),
          iconIcon: document.getElementById('notificationIconIcon'),
          title: document.getElementById('notificationTitle'),
          message: document.getElementById('notificationMessage'),
          confirmBtn: document.getElementById('notificationConfirmBtn'),
          cancelBtn: document.getElementById('notificationCancelBtn'),
          progress: document.getElementById('notificationProgress'),

          show: function (options) {
            const {
              type = 'info',
              title,
              message,
              onConfirm,
              onCancel,
              confirmText = 'OK',
              cancelText = 'Batal',
              autoClose = true,
              closeTime = 3000
            } = options;

            // Reset classes
            this.icon.className = 'notification-icon';
            this.icon.classList.add(type);

            // Set icon based on type
            const icons = {
              success: 'fa-check',
              warning: 'fa-exclamation-triangle',
              error: 'fa-times-circle',
              info: 'fa-info-circle'
            };
            this.iconIcon.className = `fas ${icons[type] || 'fa-info-circle'}`;

            // Set content
            this.title.textContent = title || 'Notifikasi';
            this.message.textContent = message || '';

            // Show modal
            this.element.classList.add('show');

            // Handle confirm button
            if (onConfirm) {
              this.confirmBtn.style.display = 'block';
              this.confirmBtn.textContent = confirmText;
              this.confirmBtn.onclick = () => {
                this.hide();
                if (onConfirm) onConfirm();
              };
            } else {
              this.confirmBtn.style.display = 'block';
              this.confirmBtn.textContent = 'OK';
              this.confirmBtn.onclick = () => this.hide();
            }

            // Handle cancel button
            if (onCancel) {
              this.cancelBtn.style.display = 'block';
              this.cancelBtn.textContent = cancelText;
              this.cancelBtn.onclick = () => {
                this.hide();
                if (onCancel) onCancel();
              };
            } else {
              this.cancelBtn.style.display = 'none';
            }

            // Auto close
            if (autoClose) {
              this.progress.style.display = 'block';
              const progressBar = this.progress.querySelector('.notification-progress-bar');
              progressBar.style.animation = 'none';
              progressBar.offsetHeight; // Trigger reflow
              progressBar.style.animation = `notificationProgress ${closeTime / 1000}s linear forwards`;

              setTimeout(() => {
                this.hide();
              }, closeTime);
            } else {
              this.progress.style.display = 'none';
            }
          },

          hide: function () {
            this.element.classList.remove('show');
          }
        };

        // Override alert
        window.alert = function (message) {
          NotificationModal.show({
            type: 'warning',
            title: 'Peringatan',
            message: message
          });
        };

        // Override confirm
        window.confirm = async function (message) {
          return new Promise((resolve) => {
            NotificationModal.show({
              type: 'question',
              title: 'Konfirmasi',
              message: message,
              confirmText: 'Ya',
              cancelText: 'Tidak',
              onConfirm: () => resolve(true),
              onCancel: () => resolve(false),
              autoClose: false
            });
          });
        };

        // Get token from localStorage (set by login/session)
        function getToken() {
          const stored = localStorage.getItem('authToken');
          if (stored) {
            token = stored;
            return token;
          }
          // Fallback: try to get from cookie
          const cookies = document.cookie.split(';');
          for (let cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'token' || name === 'authToken') {
              token = value;
              return token;
            }
          }
          return '';
        }

        // Get initial token
        getToken();

        // Load commission summary on page load
        document.addEventListener('DOMContentLoaded', async function () {
          await loadCommissionSummary();
          await loadReadyCommissions();
          await loadWithdrawalHistory();

          // Initialize SSE for real-time updates
          initCommissionSSE();
        });

        // Load commission summary
        async function loadCommissionSummary() {
          try {
            const response = await fetch(`/affiliate/api/commissions/summary?user_id=${userId}`);
            const data = await response.json();

            if (data.success) {
              const summary = data.data;

              // Update UI
              document.getElementById('pendingAmount').textContent = 'Rp ' + Number(summary.pending.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              document.getElementById('pendingCount').textContent = (summary.pending.count || 0) + ' transaksi';

              // Prefer "ready-by-lead" totals (lead_status = 'SEDANG BERANGKAT') for the UI "Siap Ditarik" display.
              try {
                const respLead = await fetch(`/affiliate/api/commissions/ready-by-lead?user_id=${userId}`);
                const leadData = await respLead.json();
                if (leadData && leadData.success && leadData.data) {
                  const readyTotalVal = Number(leadData.data.total || 0);
                  document.getElementById('readyAmount').textContent = 'Rp ' + readyTotalVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('readyCount').textContent = (leadData.data.count || 0) + ' transaksi';
                  document.getElementById('modalReadyAmount').textContent = 'Rp ' + readyTotalVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('allCount').textContent = leadData.data.count || 0;
                  document.getElementById('totalReady').textContent = leadData.data.count || 0;
                } else {
                  // fallback to original summary.ready
                  const fallbackVal = Number(summary.ready.total || 0);
                  document.getElementById('readyAmount').textContent = 'Rp ' + fallbackVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('readyCount').textContent = (summary.ready.count || 0) + ' transaksi';
                  document.getElementById('modalReadyAmount').textContent = 'Rp ' + fallbackVal.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  document.getElementById('allCount').textContent = summary.ready.count || 0;
                  document.getElementById('totalReady').textContent = summary.ready.count || 0;
                }
              } catch (e) {
                console.debug('ready-by-lead fetch failed, fallback to summary.ready', e);
                document.getElementById('readyAmount').textContent = 'Rp ' + Number(summary.ready.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('readyCount').textContent = (summary.ready.count || 0) + ' transaksi';
                document.getElementById('modalReadyAmount').textContent = 'Rp ' + Number(summary.ready.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('allCount').textContent = summary.ready.count || 0;
                document.getElementById('totalReady').textContent = summary.ready.count || 0;
              }

              document.getElementById('paidAmount').textContent = 'Rp ' + Number(summary.paid.total || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              document.getElementById('paidCount').textContent = (summary.paid.count || 0) + ' transaksi';

              // Also fetch overall totalCommission (same source as Dashboard Affiliate)
              try {
                const respStatus = await fetch('/affiliate/api/status');
                const st = await respStatus.json();
                if (st && st.success && st.data && typeof st.data.totalCommission !== 'undefined') {
                  const commissionValue = parseFloat(st.data.totalCommission) || 0;
                  const el = document.getElementById('totalCommissionDisplay');
                  if (el) el.textContent = 'Rp ' + commissionValue.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  // Responsive: add .break-all to summary values for large numbers
                  document.querySelectorAll('.summary-value').forEach(el => el.classList.add('break-all'));
                }
              } catch (e) {
                console.debug('Could not fetch totalCommission from /affiliate/api/status', e);
              }
            }
          } catch (error) {
            console.error('Error loading summary:', error);
            NotificationModal.show({
              type: 'error',
              title: 'Error',
              message: 'Gagal memuat ringkasan komisi'
            });
          }
        }

        // Load ready commissions
        async function loadReadyCommissions() {
          try {
            const response = await fetch(`/affiliate/api/commissions/ready?user_id=${userId}`);
            const data = await response.json();

            if (data.success && data.data) {
              const container = document.getElementById('readyCommissionsContainer');
              document.getElementById('readyTotal').textContent = data.data.length;

              if (data.data.length === 0) {
                container.innerHTML = `
                  <div class="text-center py-12">
                    <div class="flex flex-col items-center">
                      <div class="relative">
                        <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                          <i class="fas fa-inbox text-3xl text-emerald-300"></i>
                        </div>
                        <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                          <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                        </div>
                      </div>
                      <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak ada komisi yang siap ditarik</h3>
                      <p class="text-sm text-emerald-700 font-medium">Semua komisi sudah diproses atau belum tersedia</p>
                    </div>
                  </div>
                `;
                return;
              }

              let html = '';
              data.data.forEach((comm, index) => {
                html += `
                  <div class="glass-futuristic rounded-xl p-5 card-futuristic border border-white/50 fade-in" style="animation-delay: ${index * 0.05}s">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-3">
                          <div class="w-10 h-10 bg-gradient-to-br from-emerald-100 to-green-100 rounded-xl flex items-center justify-center border border-white/60">
                            <i class="fas fa-calendar-check text-emerald-600"></i>
                          </div>
                          <div>
                            <div class="font-extrabold text-base text-gray-900">${comm.event_title || 'Event'}</div>
                            <div class="text-xs font-medium text-emerald-700">Transaksi #${comm.transaction_id}</div>
                          </div>
                        </div>
                        <div class="flex items-center gap-4 flex-wrap text-sm text-gray-600">
                          <span class="flex items-center gap-1">
                            <i class="fas fa-coins text-emerald-400"></i>
                            Rp ${Number(comm.amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                          </span>
                          <span class="flex items-center gap-1">
                            <i class="fas fa-calendar text-emerald-400"></i>
                            ${new Date(comm.created_at).toLocaleDateString('id-ID')}
                          </span>
                        </div>
                      </div>
                      <div class="md:text-right">
                        <span class="inline-block px-3 py-1.5 rounded-lg text-xs font-extrabold status-ready text-white border border-white/30">
                          <i class="fas fa-check-circle mr-1"></i>
                          Siap Ditarik
                        </span>
                      </div>
                    </div>
                  </div>
                `;
              });

              container.innerHTML = html;

              // Load checkboxes for selection mode
              loadSelectCheckboxes(data.data);
            }
          } catch (error) {
            console.error('Error loading ready commissions:', error);
            const container = document.getElementById('readyCommissionsContainer');
            container.innerHTML = `
              <div class="text-center py-12">
                <div class="flex flex-col items-center">
                  <div class="relative">
                    <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                      <i class="fas fa-exclamation-circle text-3xl text-red-300"></i>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                      <span class="w-2 h-2 bg-red-500 rounded-full pulse-premium"></span>
                    </div>
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-900 mb-2">Gagal memuat komisi</h3>
                  <p class="text-sm text-emerald-700 font-medium">${error.message}</p>
                </div>
              </div>
            `;
          }
        }

        // Load checkboxes for selection
        function loadSelectCheckboxes(commissions) {
          const container = document.getElementById('selectCheckboxes');

          let html = '';
          commissions.forEach(comm => {
            html += `
              <label class="flex items-center gap-3 p-3 glass-futuristic rounded-xl border border-white/50 cursor-pointer hover:bg-white/40 transition">
                <input type="checkbox" value="${comm.id}" onchange="updateSelectedCommissions()" class="commission-checkbox w-4 h-4 accent-emerald-600">
                <span class="text-sm text-gray-700">
                  <span class="font-extrabold">${comm.event_title || 'Event'}</span>
                  <span class="text-emerald-700 font-extrabold"> - Rp ${Number(comm.amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
                </span>
              </label>
            `;
          });

          container.innerHTML = html;
        }

        // Load withdrawal history
        async function loadWithdrawalHistory() {
          try {
            const headers = {};
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const response = await fetch(`/affiliate/api/withdrawal/requests?user_id=${userId}`, {
              method: 'GET',
              headers: headers
            });
            const data = await response.json();

            if (data.success && data.data) {
              const container = document.getElementById('withdrawalHistoryContainer');
              document.getElementById('historyTotal').textContent = data.data.length;
              if (data.data.length === 0) {
                container.innerHTML = `
                  <div class="text-center py-12">
                    <div class="flex flex-col items-center">
                      <div class="relative">
                        <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                          <i class="fas fa-history text-3xl text-emerald-300"></i>
                        </div>
                        <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                          <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                        </div>
                      </div>
                      <h3 class="text-lg font-extrabold text-gray-900 mb-2">Belum ada riwayat penarikan</h3>
                      <p class="text-sm text-emerald-700 font-medium">Mulai ajukan penarikan komisi Anda</p>
                    </div>
                  </div>
                `;
                return;
              }

              let html = '';
              data.data.forEach((withdraw, index) => {
                let statusClass = '';
                let statusIcon = 'fa-clock';
                let statusLabel = 'Pending';

                if (withdraw.status === 'approved') {
                  statusClass = 'status-approved';
                  statusIcon = 'fa-check-circle';
                  statusLabel = 'Approved';
                } else if (withdraw.status === 'paid') {
                  statusClass = 'status-paid';
                  statusIcon = 'fa-check-double';
                  statusLabel = 'Paid';
                } else if (withdraw.status === 'rejected') {
                  statusClass = 'status-rejected';
                  statusIcon = 'fa-times-circle';
                  statusLabel = 'Rejected';
                } else {
                  statusClass = 'status-pending';
                }

                const hasProof = withdraw.proof_file ? true : false;

                html += `
                  <div class="glass-futuristic rounded-xl p-5 card-futuristic border border-white/50 fade-in" style="animation-delay: ${index * 0.05}s">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                      <div class="flex-1">
                        <div class="flex items-center gap-3 mb-3">
                          <div class="w-10 h-10 bg-gradient-to-br from-emerald-100 to-green-100 rounded-xl flex items-center justify-center border border-white/60">
                            <i class="fas fa-file-invoice-dollar text-emerald-600"></i>
                          </div>
                          <div>
                            <div class="font-extrabold text-lg text-emerald-700">Rp ${(withdraw.total_amount || 0).toLocaleString('id-ID')}</div>
                            <div class="text-xs font-medium text-emerald-700">ID: #${withdraw.id} • ${new Date(withdraw.created_at).toLocaleDateString('id-ID')}</div>
                          </div>
                        </div>
                        <div class="flex items-center gap-4 flex-wrap text-sm text-gray-600">
                          <span class="flex items-center gap-1">
                            <i class="fas fa-coins text-emerald-400"></i>
                            ${withdraw.commission_count} komisi
                          </span>
                          ${hasProof ? `
                            <span class="flex items-center gap-1 text-blue-600">
                              <i class="fas fa-file-image text-blue-400"></i>
                              Bukti tersedia
                            </span>
                          ` : ''}
                        </div>
                      </div>
                      <div class="md:text-right flex flex-col items-end gap-2">
                        <span class="inline-block px-3 py-1.5 rounded-lg text-xs font-extrabold ${statusClass} text-white border border-white/30">
                          <i class="fas ${statusIcon} mr-1"></i>
                          ${statusLabel}
                        </span>
                        <div class="flex gap-2">
                          <button onclick="event.stopPropagation(); viewWithdrawalDetail(${withdraw.id})" class="btn-secondary text-xs px-3 py-1.5">
                            <i class="fas fa-eye mr-1"></i>
                            Detail
                          </button>
                          ${hasProof ? `
                            <button onclick="event.stopPropagation(); viewProof(${withdraw.id})" class="btn-info text-xs px-3 py-1.5">
                              <i class="fas fa-file-image mr-1"></i>
                              Bukti
                            </button>
                          ` : ''}
                        </div>
                      </div>
                    </div>
                  </div>
                `;
              });

              container.innerHTML = html;
            }
          } catch (error) {
            console.error('Error loading history:', error);
            const container = document.getElementById('withdrawalHistoryContainer');
            container.innerHTML = `
              <div class="text-center py-12">
                <div class="flex flex-col items-center">
                  <div class="relative">
                    <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                      <i class="fas fa-exclamation-circle text-3xl text-red-300"></i>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                      <span class="w-2 h-2 bg-red-500 rounded-full pulse-premium"></span>
                    </div>
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-900 mb-2">Gagal memuat riwayat</h3>
                  <p class="text-sm text-emerald-700 font-medium">${error.message}</p>
                </div>
              </div>
            `;
          }
        }

        // Initialize SSE (Server Sent Events) to update totals in real-time
        function initCommissionSSE() {
          if (!('EventSource' in window)) return;
          const es = new EventSource('/affiliate/commission-events');
          es.onopen = () => console.debug('Commission SSE connected');
          es.onerror = (e) => console.error('Commission SSE error', e);

          // commission_awarded broadcast includes commission info (affiliate_id, amount, transaction_id)
          es.addEventListener('commission_awarded', async (e) => {
            try {
              const data = JSON.parse(e.data);
              if (!data) return;
              // if event is for current affiliate, refresh summaries
              if (Number(data.affiliate_id) === Number(userId)) {
                await loadCommissionSummary();
                await loadReadyCommissions();
                showCommissionToast(data.amount, data.transaction_id);
              }
            } catch (err) {
              console.error('commission_awarded handler error', err);
            }
          });

          // status_update broadcast from Sales (when lead_status changes)
          es.addEventListener('status_update', async (e) => {
            try {
              const d = JSON.parse(e.data);
              const s = (d.status || '').toString().toUpperCase();
              if (s === 'SEDANG BERANGKAT') {
                // A transaction moved to SEDANG BERANGKAT — refresh totals
                await loadCommissionSummary();
                await loadReadyCommissions();
                // optional small notification
                showStatusUpdateToast(`Lead #${d.id} ditandai SEDANG BERANGKAT`);
              }
            } catch (err) {
              console.error('status_update handler error', err);
            }
          });
        }

        // Show toast notification
        function showCommissionToast(amount, transactionId) {
          try {
            const msg = `Komisi Rp ${Number(amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} telah ditambahkan (Tx #${transactionId})`;
            const toast = document.createElement('div');
            toast.className = 'notification-toast glass-futuristic rounded-xl p-4 shadow-2xl border-l-4 border-green-500 max-w-sm';
            toast.innerHTML = `
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 gradient-success rounded-lg flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-coins text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-gray-900 text-base">Komisi Baru!</p>
                  <p class="text-sm text-gray-600 mt-1">${msg}</p>
                </div>
                <button onclick="this.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
                  <i class="fas fa-times text-sm"></i>
                </button>
              </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 5000);
          } catch (e) { console.error(e); }
        }

        function showStatusUpdateToast(msg) {
          try {
            const toast = document.createElement('div');
            toast.className = 'notification-toast glass-futuristic rounded-xl p-4 shadow-2xl border-l-4 border-blue-500 max-w-sm';
            toast.innerHTML = `
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 gradient-info rounded-lg flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-info-circle text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-gray-900 text-base">Update Status</p>
                  <p class="text-sm text-gray-600 mt-1">${msg}</p>
                </div>
                <button onclick="this.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
                  <i class="fas fa-times text-sm"></i>
                </button>
              </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
          } catch (e) { console.error(e); }
        }

        // Tab switching
        function switchTab(tab) {
          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('tab-active');
            btn.classList.add('tab-inactive');
          });

          document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.add('hidden');
          });

          const activeBtn = tab === 'ready'
            ? document.querySelector('.tab-btn:first-child')
            : document.querySelector('.tab-btn:last-child');

          if (activeBtn) {
            activeBtn.classList.add('tab-active');
            activeBtn.classList.remove('tab-inactive');
          }

          document.getElementById(`tab-${tab}`).classList.remove('hidden');
        }

        // Modal functions
        function openWithdrawalModal() {
          // Ensure the latest ready commissions (and checkboxes) are loaded so "Pilih Komisi Tertentu" doesn't hang on spinner
          loadReadyCommissions().catch(() => { });
          document.getElementById('withdrawalModal').classList.add('show');
        }

        function closeWithdrawalModal() {
          document.getElementById('withdrawalModal').classList.remove('show');
          // Reset selection
          document.querySelector('input[name="selectionMode"][value="all"]').checked = true;
          document.getElementById('selectCommissionsContainer').classList.add('hidden');
          selectedCommissionIds = [];
        }

        function closeProofModal() {
          document.getElementById('proofModal').classList.remove('show');
        }

        function closeWithdrawalDetailModal() {
          document.getElementById('withdrawalDetailModal').classList.remove('show');
        }

        // View proof transfer
        async function viewProof(payoutId) {
          try {
            const headers = {};
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const response = await fetch(`/affiliate/api/withdrawal/requests/${payoutId}?user_id=${userId}`, {
              method: 'GET',
              headers: headers
            });
            const data = await response.json();

            if (data.success && data.data.proof_file) {
              const proofFile = data.data.proof_file;
              const proofContent = document.getElementById('proof-content');

              if (proofFile.toLowerCase().endsWith('.pdf')) {
                proofContent.innerHTML = `
                  <div class="space-y-4">
                    <div class="glass-futuristic rounded-xl p-6 text-center border border-red-200/50">
                      <i class="fas fa-file-pdf text-red-600 text-4xl mb-3"></i>
                      <p class="text-sm font-extrabold text-gray-900">File PDF</p>
                    </div>
                    <div class="glass-futuristic rounded-xl p-4 border border-blue-200/50">
                      <p class="text-xs text-blue-800 mb-3"><span class="font-extrabold">Nama File:</span> ${proofFile.split('/').pop()}</p>
                      <a href="${proofFile}" target="_blank" class="w-full btn-info text-sm py-3 flex items-center justify-center gap-1">
                        <i class="fas fa-external-link-alt"></i>
                        Buka File PDF
                      </a>
                    </div>
                  </div>
                `;
              } else {
                proofContent.innerHTML = `
                  <div class="space-y-4">
                    <img src="${proofFile}" alt="Bukti Transfer" class="w-full rounded-xl border border-white/50 shadow-lg">
                    <div class="glass-futuristic rounded-xl p-4 border border-blue-200/50">
                      <p class="text-xs text-blue-800">
                        <span class="font-extrabold">Format:</span> Gambar<br>
                        <span class="font-extrabold">File:</span> ${proofFile.split('/').pop()}
                      </p>
                    </div>
                  </div>
                `;
              }

              document.getElementById('proofModal').classList.add('show');
            } else {
              NotificationModal.show({
                type: 'warning',
                title: 'Tidak Ditemukan',
                message: 'Bukti transfer tidak ditemukan'
              });
            }
          } catch (error) {
            console.error('Error loading proof:', error);
            NotificationModal.show({
              type: 'error',
              title: 'Error',
              message: 'Gagal memuat bukti transfer'
            });
          }
        }

        function updateSelectionMode() {
          const mode = document.querySelector('input[name="selectionMode"]:checked').value;
          const container = document.getElementById('selectCommissionsContainer');

          if (mode === 'select') {
            // show container
            container.classList.remove('hidden');
            // If the checkboxes area is still showing the loading spinner or empty, reload the ready commissions
            const checkboxesEl = document.getElementById('selectCheckboxes');
            if (!checkboxesEl || !checkboxesEl.children || checkboxesEl.children.length === 0 || checkboxesEl.querySelector('.fa-spinner')) {
              loadReadyCommissions().catch(() => { });
            }
          } else {
            container.classList.add('hidden');
            selectedCommissionIds = [];
          }
        }

        function updateSelectedCommissions() {
          const checkboxes = document.querySelectorAll('.commission-checkbox:checked');
          selectedCommissionIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
        }

        // Submit withdrawal
        async function submitWithdrawal() {
          const mode = document.querySelector('input[name="selectionMode"]:checked').value;
          const commissionIds = mode === 'select' ? selectedCommissionIds : null;

          if (mode === 'select' && commissionIds.length === 0) {
            NotificationModal.show({
              type: 'warning',
              title: 'Peringatan',
              message: 'Pilih minimal satu komisi'
            });
            return;
          }

          try {
            // Prepare headers and include Authorization if token is available
            const headers = { 'Content-Type': 'application/json' };
            if (token) headers['Authorization'] = `Bearer ${token}`;

            const response = await fetch(`/affiliate/api/withdrawal/request?user_id=${userId}`, {
              method: 'POST',
              headers: headers,
              body: JSON.stringify({ commission_ids: commissionIds })
            });

            // Try to parse JSON, but be resilient to non-JSON responses (e.g., HTML redirect)
            let data = null;
            try {
              data = await response.json();
            } catch (parseErr) {
              const text = await response.text();
              console.error('Non-JSON response from withdrawal request:', text);
              NotificationModal.show({
                type: 'error',
                title: 'Error',
                message: 'Gagal mengajukan penarikan: server merespon dengan teks tidak terduga'
              });
              return;
            }

            if (data && data.success) {
              NotificationModal.show({
                type: 'success',
                title: 'Berhasil',
                message: `✅ Permintaan penarikan berhasil!\nID: ${data.data.payout_id}\nJumlah: Rp ${data.data.total_amount.toLocaleString('id-ID')}\n${data.data.commission_count} komisi`,
                autoClose: false
              });
              closeWithdrawalModal();

              setTimeout(async () => {
                await loadCommissionSummary();
                await loadReadyCommissions();
                await loadWithdrawalHistory();
              }, 500);
            } else {
              NotificationModal.show({
                type: 'error',
                title: 'Error',
                message: `❌ Error: ${data.message}`
              });
            }
          } catch (error) {
            console.error('Error submitting withdrawal:', error);
            NotificationModal.show({
              type: 'error',
              title: 'Error',
              message: 'Gagal mengajukan penarikan'
            });
          }
        }

        // View withdrawal detail
        async function viewWithdrawalDetail(payoutId) {
          try {
            const headers = {};
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const response = await fetch(`/affiliate/api/withdrawal/requests/${payoutId}?user_id=${userId}`, {
              method: 'GET',
              headers: headers
            });
            const data = await response.json();

            if (data.success) {
              const payout = data.data;
              const commissions = payout.commissions || [];

              let commissionsHtml = '';
              const commissionRows = commissions.length > 0 ? commissions.map(comm => `
                <div class="flex justify-between items-center py-2 border-t border-white/30">
                  <div class="flex-1">
                    <div class="font-extrabold text-sm text-gray-900">${comm.event_title || 'Event'}</div>
                    <div class="text-xs font-medium text-gray-500">${new Date(comm.created_at).toLocaleDateString('id-ID')}</div>
                  </div>
                  <div class="font-extrabold text-sm text-emerald-700">Rp ${parseFloat(comm.amount || 0).toLocaleString('id-ID')}</div>
                </div>
              `).join('') : '<p class="text-gray-500 text-sm text-center py-4">Tidak ada data komisi</p>';

              let proofHtml = '';
              if (payout.proof_file) {
                const pf = payout.proof_file;
                if (pf.toLowerCase().endsWith('.pdf')) {
                  proofHtml = `
                    <div class="glass-futuristic rounded-xl p-4 text-center border border-red-200/50">
                      <i class="fas fa-file-pdf text-red-600 text-3xl mb-3"></i>
                      <p class="text-sm font-extrabold text-gray-900 mb-2">File PDF</p>
                      <a href="${pf}" target="_blank" class="w-full btn-info text-sm py-2 flex items-center justify-center gap-1">
                        <i class="fas fa-external-link-alt"></i>
                        Buka File PDF
                      </a>
                    </div>
                  `;
                } else {
                  proofHtml = `
                    <div class="text-center">
                      <img src="${pf}" alt="Bukti Transfer" class="w-full rounded-xl border border-white/50 mb-3">
                      <button onclick="event.stopPropagation(); viewProof(${payout.id})" class="w-full btn-info text-sm py-2 flex items-center justify-center gap-1">
                        <i class="fas fa-search"></i>
                        Lihat Bukti (Besar)
                      </button>
                    </div>
                  `;
                }
              } else {
                proofHtml = '<p class="text-sm text-gray-500 text-center">Tidak ada bukti transfer</p>';
              }

              const financeNoteHtml = payout.finance_note ? `
                <div class="glass-futuristic rounded-xl p-4 border border-amber-200/50 bg-amber-50/30">
                  <h4 class="text-sm font-extrabold text-amber-800 mb-2 flex items-center gap-1.5">
                    <i class="fas fa-sticky-note text-amber-600"></i>
                    Catatan Finance
                  </h4>
                  <p class="text-sm text-amber-800">${payout.finance_note}</p>
                </div>
              ` : '';

              const adminNoteHtml = payout.admin_note ? `
                <div class="glass-futuristic rounded-xl p-4 border border-green-200/50 bg-green-50/30">
                  <h4 class="text-sm font-extrabold text-green-800 mb-2 flex items-center gap-1.5">
                    <i class="fas fa-check-circle text-green-600"></i>
                    Catatan Admin Approval
                  </h4>
                  <p class="text-sm text-green-800">${payout.admin_note}</p>
                </div>
              ` : '';

              const detailHtml = `
                <div class="space-y-4">
                  <!-- Affiliate Info -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                    <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                      <i class="fas fa-user-tie text-emerald-600"></i>
                      Informasi Affiliate
                    </h4>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                      <div>
                        <p class="text-xs font-bold text-emerald-700">Nama</p>
                        <p class="font-extrabold text-base text-gray-900">${payout.affiliate_name}</p>
                      </div>
                      <div>
                        <p class="text-xs font-bold text-emerald-700">Email</p>
                        <p class="font-extrabold text-base text-gray-900">${payout.affiliate_email}</p>
                      </div>
                    </div>
                  </div>

                  <!-- Bank Info -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                    <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                      <i class="fas fa-university text-emerald-600"></i>
                      Informasi Bank
                    </h4>
                    <div class="space-y-2 text-sm">
                      <div class="flex items-center justify-between">
                        <p class="text-xs font-bold text-emerald-700">Nama Bank</p>
                        <p class="font-extrabold text-base text-gray-900">${payout.bank_name || '-'}</p>
                      </div>
                      <div class="flex items-center justify-between">
                        <p class="text-xs font-bold text-emerald-700">Nomor Rekening</p>
                        <p class="font-extrabold text-base text-gray-900">${payout.bank_account_number || '-'}</p>
                      </div>
                      <div class="flex items-center justify-between">
                        <p class="text-xs font-bold text-emerald-700">Atas Nama</p>
                        <p class="font-extrabold text-base text-gray-900">${payout.bank_account_name || '-'}</p>
                      </div>
                    </div>
                  </div>

                  ${financeNoteHtml}
                  ${adminNoteHtml}

                  <!-- Commissions -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                    <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                      <i class="fas fa-coins text-emerald-600"></i>
                      Komisi yang Ditarik
                    </h4>
                    <div class="bg-white/30 backdrop-blur rounded-lg p-3 max-h-48 overflow-y-auto modern-scrollbar border border-white/30">
                      ${commissionRows}
                    </div>
                  </div>

                  <!-- Proof -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                    <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                      <i class="fas fa-file-image text-emerald-600"></i>
                      Bukti Transfer
                    </h4>
                    ${proofHtml}
                  </div>

                  <!-- Status Info -->
                  <div class="glass-futuristic rounded-xl p-4 border border-blue-200/50 bg-blue-50/30">
                    <div class="grid grid-cols-2 gap-3 text-sm">
                      <div>
                        <p class="text-xs font-bold text-emerald-700">Status</p>
                        <p class="font-extrabold text-gray-900 capitalize">${payout.status}</p>
                      </div>
                      <div>
                        <p class="text-xs font-bold text-emerald-700">Total</p>
                        <p class="font-extrabold text-lg text-emerald-700">Rp ${parseFloat(payout.total_amount || 0).toLocaleString('id-ID')}</p>
                      </div>
                      <div>
                        <p class="text-xs font-bold text-emerald-700">Dibuat</p>
                        <p class="font-extrabold text-sm text-gray-900">${new Date(payout.created_at).toLocaleString('id-ID')}</p>
                      </div>
                      ${payout.paid_at ? `
                        <div>
                          <p class="text-xs font-bold text-emerald-700">Dibayar</p>
                          <p class="font-extrabold text-sm text-gray-900">${new Date(payout.paid_at).toLocaleString('id-ID')}</p>
                        </div>
                      ` : ''}
                    </div>
                  </div>
                </div>
              `;

              document.getElementById('detailModalTitle').textContent = `Detail Penarikan #${payout.id}`;
              document.getElementById('withdrawalDetailContent').innerHTML = detailHtml;
              document.getElementById('withdrawalDetailModal').classList.add('show');
            }
          } catch (error) {
            console.error('Error loading detail:', error);
            NotificationModal.show({
              type: 'error',
              title: 'Error',
              message: 'Gagal memuat detail'
            });
          }
        }

        // Close modals when clicking overlay
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
          overlay.addEventListener('click', (e) => {
            if (e.target === overlay) {
              overlay.classList.remove('show');
            }
          });
        });
      </script>
</body>

</html>