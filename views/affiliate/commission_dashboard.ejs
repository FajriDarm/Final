<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Komisi - Affillink Affiliate</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-success {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.4);
    }

    .gradient-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
      box-shadow: 0 10px 20px -8px rgba(59, 130, 246, 0.4);
    }

    .gradient-danger {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
      box-shadow: 0 10px 20px -8px rgba(239, 68, 68, 0.4);
    }

    .gradient-purple {
      background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
      box-shadow: 0 10px 20px -8px rgba(139, 92, 246, 0.4);
    }

    .gradient-teal {
      background: linear-gradient(165deg, #0d9488 0%, #14b8a6 50%, #2dd4bf 100%);
      box-shadow: 0 10px 20px -8px rgba(20, 184, 166, 0.4);
    }

    .gradient-blue {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
      box-shadow: 0 10px 20px -8px rgba(59, 130, 246, 0.4);
    }

    .gradient-amber {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.4);
    }

    .gradient-yellow {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.4);
    }

    /* Status Gradients */
    .status-pending {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .status-approved {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .status-paid {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
    }

    .status-rejected {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
    }

    .status-ready {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Badge 3D Effect */
    .badge-3d {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 rgba(0, 0, 0, 0.05);
    }

    .badge-3d:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 6px 0 rgba(0, 0, 0, 0.05);
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Custom Scrollbar */
    .modern-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .modern-scrollbar::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: linear-gradient(145deg, #10b981, #059669);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(145deg, #059669, #047857);
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    /* Glow Text */
    .glow-text {
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.3),
        0 0 20px rgba(16, 185, 129, 0.2);
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Data Cell */
    .data-cell-modern {
      position: relative;
      transition: all 0.4s ease;
    }

    .data-cell-modern::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 3px;
      background: linear-gradient(90deg, #10b981, #059669);
      transition: all 0.4s ease;
      transform: translateX(-50%);
    }

    .data-cell-modern:hover::before {
      width: 100%;
    }

    /* Animations */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white), linear-gradient(135deg, white, white, white);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Table Row Styles */
    .table-row {
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(5px);
    }

    .table-row:hover {
      background: rgba(255, 255, 255, 0.6);
      transform: scale(1.01);
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.15);
    }

    /* Tab Styles */
    .tab-active {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .tab-inactive {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(10px);
      color: #4b5563;
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .tab-inactive:hover {
      background: rgba(255, 255, 255, 0.8);
    }

    /* Button Styles - Diperbesar */
    .btn-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .btn-primary:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-success {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .btn-success:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(10px);
      color: #374151;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.8);
    }

    .btn-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }

    .btn-info:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.2);
    }

    .btn-warning:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-danger {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.2);
    }

    .btn-danger:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    /* Modal Styles */
    .modal-overlay {
      backdrop-filter: blur(8px);
      background: rgba(0, 0, 0, 0.2);
      display: none;
      position: fixed;
      inset: 0;
      z-index: 50;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal-content {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 1.5rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      max-width: 32rem;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      padding: 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    }

    .modal-body {
      padding: 1.5rem;
    }

    .modal-footer {
      padding: 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(10px);
      display: flex;
      gap: 0.75rem;
    }

    /* Checkbox Styles */
    .commission-checkbox {
      width: 1.2rem;
      height: 1.2rem;
      accent-color: #10b981;
      border-radius: 0.25rem;
    }

    /* Toast Notification */
    .notification-toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      animation: slideInRight 0.3s ease-out;
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    /* Info Card Styles - Diperbesar */
    .info-card-commission {
      background: rgba(16, 185, 129, 0.05);
      border: 1px solid rgba(16, 185, 129, 0.2);
      border-radius: 1rem;
      padding: 1.5rem;
    }

    .info-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
    }

    .info-row:not(:last-child) {
      border-bottom: 1px solid rgba(16, 185, 129, 0.1);
    }

    .info-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(165deg, #059669, #10b981);
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .info-icon i {
      color: white;
      font-size: 1.25rem;
    }

    .info-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #047857;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
    }

    .info-value {
      font-size: 1rem;
      font-weight: 800;
      color: #1f2937;
    }

    .info-value-large {
      font-size: 1.5rem;
      font-weight: 800;
      color: #059669;
    }

    /* Selection Card Styles */
    .selection-card {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 1rem;
      padding: 1rem;
      transition: all 0.3s ease;
    }

    .selection-card:hover {
      background: rgba(255, 255, 255, 0.8);
      transform: translateY(-2px);
    }

    .selection-card.selected {
      background: rgba(16, 185, 129, 0.1);
      border-color: #10b981;
    }

    /* Notification Modal */
    .notification-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 99999;
    }

    .notification-modal.show {
      display: flex;
    }

    .notification-content {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 1.5rem;
      padding: 2rem;
      max-width: 400px;
      width: 90%;
      text-align: center;
      box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.3);
      transform: scale(0.9) translateY(20px);
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .notification-modal.show .notification-content {
      transform: scale(1) translateY(0);
      opacity: 1;
    }

    .notification-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      animation: notificationIconPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes notificationIconPop {
      0% {
        transform: scale(0) rotate(-180deg);
      }

      100% {
        transform: scale(1) rotate(0);
      }
    }

    .notification-icon.success {
      background: linear-gradient(165deg, #059669, #10b981);
      box-shadow: 0 15px 30px -10px rgba(16, 185, 129, 0.5);
    }

    .notification-icon.error {
      background: linear-gradient(165deg, #b91c1c, #dc2626);
      box-shadow: 0 15px 30px -10px rgba(239, 68, 68, 0.5);
    }

    .notification-icon.warning {
      background: linear-gradient(165deg, #d97706, #f59e0b);
      box-shadow: 0 15px 30px -10px rgba(245, 158, 11, 0.5);
    }

    .notification-icon.info {
      background: linear-gradient(165deg, #2563eb, #3b82f6);
      box-shadow: 0 15px 30px -10px rgba(59, 130, 246, 0.5);
    }

    .notification-title {
      font-size: 1.75rem;
      font-weight: 800;
      color: #1f2937;
      margin-bottom: 0.75rem;
      animation: notificationFadeIn 0.5s ease 0.1s both;
    }

    .notification-message {
      font-size: 1rem;
      color: #4b5563;
      margin-bottom: 2rem;
      line-height: 1.6;
      animation: notificationFadeIn 0.5s ease 0.2s both;
    }

    @keyframes notificationFadeIn {
      from {
        opacity: 0;
        transform: translateY(15px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .notification-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      animation: notificationFadeIn 0.5s ease 0.3s both;
    }

    .notification-btn {
      padding: 0.875rem 2rem;
      border-radius: 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.3s ease;
      border: none;
      min-width: 120px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .notification-btn-primary {
      background: linear-gradient(165deg, #059669, #10b981);
      color: white;
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
    }

    .notification-btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px -5px rgba(16, 185, 129, 0.5);
    }

    .notification-btn-secondary {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
      color: #374151;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
    }

    .notification-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: translateY(-3px);
    }

    .notification-progress {
      height: 4px;
      background: rgba(16, 185, 129, 0.1);
      border-radius: 2px;
      margin-top: 2rem;
      overflow: hidden;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
    }

    .notification-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, #10b981, #34d399);
      width: 100%;
      animation: notificationProgress 3s linear forwards;
    }

    @keyframes notificationProgress {
      0% {
        width: 100%;
      }

      100% {
        width: 0%;
      }
    }
  </style>
</head>

