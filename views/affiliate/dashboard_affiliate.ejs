      <script>
        // ============================================================
        // FUNGSI MODAL NOTIFICATION
        // ============================================================

        const Modal = {
          element: document.getElementById('notificationModal'),
          icon: document.getElementById('modalIcon'),
          iconIcon: document.getElementById('modalIconIcon'),
          title: document.getElementById('modalTitle'),
          message: document.getElementById('modalMessage'),
          confirmBtn: document.getElementById('modalConfirmBtn'),
          cancelBtn: document.getElementById('modalCancelBtn'),
          progress: document.getElementById('modalProgress'),

          show: function (options) {
            const {
              type = 'info',
              title,
              message,
              onConfirm,
              onCancel,
              confirmText = 'OK',
              cancelText = 'Batal',
              autoClose = true,
              closeTime = 3000
            } = options;

            // Reset classes
            this.icon.className = 'modal-icon';
            this.icon.classList.add(type);

            // Set icon based on type
            const icons = {
              success: 'fa-check',
              warning: 'fa-exclamation-triangle',
              error: 'fa-times-circle',
              info: 'fa-info-circle'
            };
            this.iconIcon.className = `fas ${icons[type] || 'fa-info-circle'}`;

            // Set content
            this.title.textContent = title || 'Notifikasi';
            this.message.textContent = message || '';

            // Show modal
            this.element.classList.add('show');

            // Handle confirm button
            if (onConfirm) {
              this.confirmBtn.style.display = 'block';
              this.confirmBtn.textContent = confirmText;
              this.confirmBtn.onclick = () => {
                this.hide();
                if (onConfirm) onConfirm();
              };
            } else {
              this.confirmBtn.style.display = 'block';
              this.confirmBtn.textContent = 'OK';
              this.confirmBtn.onclick = () => this.hide();
            }

            // Handle cancel button
            if (onCancel) {
              this.cancelBtn.style.display = 'block';
              this.cancelBtn.textContent = cancelText;
              this.cancelBtn.onclick = () => {
                this.hide();
                if (onCancel) onCancel();
              };
            } else {
              this.cancelBtn.style.display = 'none';
            }

            // Auto close
            if (autoClose) {
              this.progress.style.display = 'block';
              const progressBar = this.progress.querySelector('.modal-progress-bar');
              progressBar.style.animation = 'none';
              progressBar.offsetHeight; // Trigger reflow
              progressBar.style.animation = `progress ${closeTime / 1000}s linear forwards`;

              setTimeout(() => {
                this.hide();
              }, closeTime);
            } else {
              this.progress.style.display = 'none';
            }
          },

          hide: function () {
            this.element.classList.remove('show');
          }
        };

        // Override alert
        window.alert = function (message) {
          Modal.show({
            type: 'warning',
            title: 'Peringatan',
            message: message
          });
        };

        // Affiliate user status from server - fallback, will be updated from API
        let userStatus = '<%= typeof userStatus !== "undefined" ? userStatus : "inactive" %>';
        let profileCompletionPercent = 0;
        console.debug('User status from server (initial):', userStatus);

        // Calculate profile completion percentage (match profile page rules)
        function calculateProfileCompletion() {
          // First, try to get updated profile from localStorage (from profile page update)
          let updatedProfileFromStorage = null;
          try {
            const stored = localStorage.getItem('affiliateProfileUpdate');
            if (stored) {
              updatedProfileFromStorage = JSON.parse(stored);
              console.debug('Using profile data from localStorage:', updatedProfileFromStorage);
            }
          } catch (e) {
            console.debug('No profile data in localStorage or invalid JSON');
          }

          // Get affiliate profile data from template
          const baseProfile = {
            full_name: '<%= typeof affiliateProfile !== "undefined" && affiliateProfile ? affiliateProfile.full_name : "" %>',
            email: '<%= typeof affiliateProfile !== "undefined" && affiliateProfile ? affiliateProfile.email : "" %>',
            phone: '<%= typeof affiliateProfile !== "undefined" && affiliateProfile ? affiliateProfile.phone : "" %>',
            bank_name: '<%= typeof affiliateProfile !== "undefined" && affiliateProfile ? affiliateProfile.bank_name : "" %>',
            bank_account_number: '<%= typeof affiliateProfile !== "undefined" && affiliateProfile ? affiliateProfile.bank_account_number : "" %>',
            bank_account_name: '<%= typeof affiliateProfile !== "undefined" && affiliateProfile ? affiliateProfile.bank_account_name : "" %>'
          };

          // If we have updated data from storage, merge it
          const mergedProfile = updatedProfileFromStorage
            ? {
              full_name: updatedProfileFromStorage.full_name || baseProfile.full_name,
              email: updatedProfileFromStorage.email || baseProfile.email,
              phone: updatedProfileFromStorage.phone || baseProfile.phone,
              bank_name: updatedProfileFromStorage.bank_name || baseProfile.bank_name,
              bank_account_number: updatedProfileFromStorage.bank_account_number || baseProfile.bank_account_number,
              bank_account_name: updatedProfileFromStorage.bank_account_name || baseProfile.bank_account_name
            }
            : baseProfile;

          // Normalize to match profile.ejs fields
          const normalized = {
            name: mergedProfile.full_name,
            email: mergedProfile.email,
            phone: mergedProfile.phone,
            bank_name: mergedProfile.bank_name,
            bank_account: mergedProfile.bank_account_number,
            bank_account_name: mergedProfile.bank_account_name
          };

          const requiredFields = ['name', 'email', 'phone', 'bank_name', 'bank_account', 'bank_account_name'];
          let filledCount = 0;

          requiredFields.forEach(field => {
            if (normalized[field] && String(normalized[field]).trim() !== '') {
              filledCount++;
            }
          });

          profileCompletionPercent = Math.round((filledCount / requiredFields.length) * 100);

          // Update UI
          updateProfileCompletionUI();

          console.debug('Profile completion:', profileCompletionPercent + '%', 'Filled:', filledCount, 'Total:', requiredFields.length);
          return profileCompletionPercent;
        }

        function updateProfileCompletionUI() {
          const percentElement = document.getElementById('profileCompletionPercent');
          const barElement = document.getElementById('profileCompletionBar');

          if (percentElement) {
            percentElement.textContent = profileCompletionPercent + '%';
          }

          if (barElement) {
            barElement.style.width = profileCompletionPercent + '%';
            // Change color based on percentage
            if (profileCompletionPercent === 100) {
              barElement.className = 'profile-bar-fill green';
            } else if (profileCompletionPercent >= 70) {
              barElement.className = 'profile-bar-fill yellow';
            } else {
              barElement.className = 'profile-bar-fill red';
            }

            // Toggle server-side warning visibility if present
            const warnEl = document.getElementById('profileIncompleteWarning');
            if (warnEl) {
              warnEl.style.display = (profileCompletionPercent < 100) ? 'block' : 'none';
            }
          }
        }

        // Listen for profile updates from other pages (via localStorage)
        window.addEventListener('storage', function (event) {
          if (event.key === 'affiliateProfileUpdate_ts' || event.key === 'affiliateProfileUpdate') {
            console.debug('Profile update detected from another page, recalculating...');
            refreshProfileCompletion();
          }
        });

        let lastProfileUpdateTime = parseInt(localStorage.getItem('affiliateProfileUpdate_ts') || '0');
        setInterval(() => {
          const currentUpdateTime = parseInt(localStorage.getItem('affiliateProfileUpdate_ts') || '0');
          if (currentUpdateTime > lastProfileUpdateTime) {
            console.debug('Profile update detected via polling, recalculating...');
            lastProfileUpdateTime = currentUpdateTime;
            refreshProfileCompletion();
          }
        }, 1000);

        async function refreshProfileCompletion() {
          try {
            const updatedProfile = localStorage.getItem('affiliateProfileUpdate');
            if (updatedProfile) {
              const profileData = JSON.parse(updatedProfile);
              console.debug('Using updated profile from storage:', profileData);

              const newPercent = calculateProfileCompletionFromData(profileData);

              if (newPercent !== profileCompletionPercent) {
                profileCompletionPercent = newPercent;
                updateProfileCompletionUI();

                const eventsContainer = document.getElementById('eventsContainer');
                if (eventsContainer && !eventsContainer.classList.contains('hidden')) {
                  console.debug('Reloading events due to profile completion change');
                  await loadEventsAndLinks();
                }
              }
            }
          } catch (error) {
            console.error('Error refreshing profile completion:', error);
          }
        }

        function calculateProfileCompletionFromData(profileData) {
          const normalized = {
            name: profileData.full_name || profileData.name || '',
            email: profileData.email || '',
            phone: profileData.phone || '',
            bank_name: profileData.bank_name || '',
            bank_account: profileData.bank_account_number || profileData.bank_account || '',
            bank_account_name: profileData.bank_account_name || ''
          };

          const requiredFields = ['name', 'email', 'phone', 'bank_name', 'bank_account', 'bank_account_name'];
          let filledCount = 0;

          requiredFields.forEach(field => {
            const value = normalized[field];
            if (value && String(value).trim() !== '') {
              filledCount++;
            }
          });

          const percent = Math.round((filledCount / requiredFields.length) * 100);
          console.debug('Profile completion recalculated:', percent + '%', 'Filled:', filledCount, 'Data:', profileData);
          return percent;
        }

        // Load events on page load
        document.addEventListener('DOMContentLoaded', async function () {
          console.debug('DOM loaded, loading events...');

          // Calculate profile completion
          calculateProfileCompletion();

          // First, fetch user status from API
          await fetchUserStatus();

          // Then load events and links
          await loadEventsAndLinks();

          // Initialize SSE to receive commission_awarded events in real-time
          initCommissionSSE();

          // Setup periodic polling for commission updates (fallback)
          setInterval(async () => {
            await fetchUserStatus();
          }, 10000);
        });

        // Fetch current user status from API
        async function fetchUserStatus() {
          try {
            console.debug('Fetching user status from /affiliate/api/status...');
            const response = await fetch('/affiliate/api/status');
            const data = await response.json();

            console.debug('User status API response:', data);

            if (data.success && data.data) {
              userStatus = data.data.affiliate_status || data.data.status || 'inactive';
              console.debug('Updated userStatus:', userStatus);

              // Update total commission if available
              if (data.data.totalCommission !== undefined) {
                const totalCommissionDisplay = document.getElementById('totalCommissionDisplay');
                if (totalCommissionDisplay) {
                  const commissionValue = parseFloat(data.data.totalCommission) || 0;
                  totalCommissionDisplay.textContent = 'Rp ' + commissionValue.toLocaleString('id-ID', { maximumFractionDigits: 0 });
                }
              }

              // Update status badge if exists
              const affiliateStatusBadge = document.getElementById('affiliateStatusBadge');
              if (affiliateStatusBadge) {
                const statusConfig = {
                  'approved': { bg: 'status-approved', icon: 'fa-check-circle', label: 'Approved' },
                  'pending': { bg: 'status-pending', icon: 'fa-clock', label: 'Pending' },
                  'rejected': { bg: 'status-rejected', icon: 'fa-times-circle', label: 'Rejected' },
                  'inactive': { bg: 'bg-gray-500', icon: 'fa-circle', label: 'Inactive' }
                }[userStatus] || { bg: 'bg-gray-500', icon: 'fa-circle', label: 'Unknown' };

                affiliateStatusBadge.innerHTML = `
              <span class="px-3 py-1.5 rounded-lg text-sm font-extrabold ${statusConfig.bg} text-white flex items-center gap-1 border border-white/30">
                <i class="fas ${statusConfig.icon}"></i>
                ${statusConfig.label}
              </span>
            `;
                affiliateStatusBadge.classList.remove('hidden');
              }
            }
          } catch (error) {
            console.error('Error fetching user status:', error);
          }
        }

        function getToken() {
          try {
            const stored = localStorage.getItem('authToken');
            if (stored) return stored;
            const m = document.cookie.match(/(?:^|; )token=([^;]+)/);
            if (m) return decodeURIComponent(m[1]);
          } catch (e) {
            console.debug('getToken error', e);
          }
          return '';
        }

        function initCommissionSSE() {
          if (!('EventSource' in window)) return;
          const localToken = getToken();
          const esUrl = '/affiliate/commission-events' + (localToken ? '?token=' + encodeURIComponent(localToken) : '');
          const es = new EventSource(esUrl);
          es.onopen = () => console.debug('Commission SSE connected');
          es.onerror = (e) => {
            console.error('Commission SSE error', e);
            setTimeout(() => {
              try {
                const newEs = new EventSource(esUrl);
                newEs.onmessage = es.onmessage;
                newEs.onerror = es.onerror;
                newEs.onopen = es.onopen;
              } catch (err) {
                console.error('Failed to reconnect SSE', err);
              }
            }, 3000);
          };
          es.addEventListener('commission_awarded', async (e) => {
            try {
              const data = JSON.parse(e.data);
              const currentAffiliateId = <%= typeof userId !== 'undefined' ? userId : 'null' %>;
              if (!data || Number(data.affiliate_id) !== Number(currentAffiliateId)) return;
              await fetchUserStatus();
              showCommissionToast(data.amount, data.transaction_id);
            } catch (err) {
              console.error('commission_awarded handler error', err);
            }
          });
        }

        function showCommissionToast(amount, transactionId) {
          try {
            const msg = `Komisi Rp ${Number(amount || 0).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} telah ditambahkan`;
            const toast = document.createElement('div');
            toast.className = 'notification-toast glass-futuristic rounded-xl p-4 shadow-2xl border-l-4 border-green-500 max-w-sm';
            toast.innerHTML = `
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 gradient-success rounded-lg flex items-center justify-center flex-shrink-0">
              <i class="fas fa-coins text-white text-lg"></i>
            </div>
            <div class="flex-1">
              <p class="font-extrabold text-gray-900 text-base">Komisi Baru!</p>
              <p class="text-sm text-gray-600 mt-1">${msg}</p>
            </div>
            <button onclick="this.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
              <i class="fas fa-times text-sm"></i>
            </button>
          </div>
        `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 5000);
          } catch (e) { console.error(e); }
        }

        async function loadEventsAndLinks() {
          const eventsLoading = document.getElementById('eventsLoading');
          const eventsContainer = document.getElementById('eventsContainer');
          const noEvents = document.getElementById('noEvents');
          const notApprovedMessage = document.getElementById('notApprovedMessage');
          const affiliateStatusBadge = document.getElementById('affiliateStatusBadge');

          console.debug('Fetching events from /affiliate/api/events...');

          try {
            const response = await fetch('/affiliate/api/events');
            const data = await response.json();

            console.debug('API Response:', data);

            eventsLoading.classList.add('hidden');

            if (!data.success) {
              console.error('API Error:', data.message);
              if (data.message && data.message.includes('belum di-approve')) {
                notApprovedMessage.classList.remove('hidden');
                return;
              }
              throw new Error(data.message || 'Failed to load events');
            }

            console.debug('Events loaded:', data.data.length, 'events');

            const activeCountEl = document.getElementById('activeProgramsCount');
            if (activeCountEl) activeCountEl.textContent = data.data.length;

            if (data.data.length === 0) {
              noEvents.classList.remove('hidden');
              return;
            }

            eventsContainer.classList.remove('hidden');
            displayEvents(data.data);

            if (affiliateStatusBadge) {
              const statusConfig = {
                'approved': { bg: 'status-approved', icon: 'fa-check-circle', label: 'Approved' },
                'pending': { bg: 'status-pending', icon: 'fa-clock', label: 'Pending' },
                'rejected': { bg: 'status-rejected', icon: 'fa-times-circle', label: 'Rejected' },
                'inactive': { bg: 'bg-gray-500', icon: 'fa-circle', label: 'Inactive' }
              }[userStatus] || { bg: 'bg-gray-500', icon: 'fa-circle', label: 'Unknown' };

              affiliateStatusBadge.innerHTML = `
            <span class="px-3 py-1.5 rounded-lg text-sm font-extrabold ${statusConfig.bg} text-white flex items-center gap-1 border border-white/30">
              <i class="fas ${statusConfig.icon}"></i>
              ${statusConfig.label}
            </span>
          `;
              affiliateStatusBadge.classList.remove('hidden');
            }

          } catch (error) {
            console.error('Error loading events:', error);
            const activeCountEl = document.getElementById('activeProgramsCount');
            if (activeCountEl) activeCountEl.textContent = '0';

            eventsLoading.classList.add('hidden');
            eventsContainer.innerHTML = `
          <div class="text-center py-8">
            <div class="flex flex-col items-center">
              <div class="relative">
                <div class="w-16 h-16 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                  <i class="fas fa-exclamation-circle text-3xl text-red-300"></i>
                </div>
                <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                  <span class="w-2 h-2 bg-red-500 rounded-full pulse-premium"></span>
                </div>
              </div>
              <p class="text-lg font-extrabold text-gray-900 mb-2">Gagal memuat event</p>
              <p class="text-sm text-emerald-700 font-medium">${error.message}</p>
            </div>
          </div>
        `;
            eventsContainer.classList.remove('hidden');
          }
        }

        function displayEvents(events) {
          const container = document.getElementById('eventsContainer');
          container.innerHTML = '';

          console.debug('Displaying events:', events);
          console.debug('User status:', userStatus);
          console.debug('Profile completion:', profileCompletionPercent + '%');

          events.forEach((event, index) => {
            console.debug(`Event ${index}:`, event);

            const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

            const eventCard = document.createElement('div');
            eventCard.className = 'glass-futuristic rounded-xl p-4 hover:bg-white/40 transition-all duration-300 border border-white/50 fade-in';
            eventCard.style.animationDelay = (index * 0.1) + 's';

            const isApproved = userStatus === 'approved';
            const hasLink = event.has_link;
            const isProfileComplete = profileCompletionPercent === 100;

            console.debug(`Event: ${event.title}, hasLink: ${hasLink}, isApproved: ${isApproved}, profileComplete: ${isProfileComplete}`);

            let buttonHTML = '';
            if (hasLink) {
              buttonHTML = `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <div class="text-sm font-bold text-emerald-700 mb-1">Form (Checkout)</div>
                <div class="flex items-center gap-2">
                  <input type="text"
                    class="flex-1 px-3 py-2 text-sm bg-white/60 backdrop-blur border border-white/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900"
                    readonly
                    value="${event.affiliate_link?.url_checkout || event.affiliate_link?.url || ''}"
                    id="link-checkout-${event.id}"
                  />
                  <button onclick="copyLink('link-checkout-${event.id}', this)"
                    class="px-3 py-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white text-sm rounded-lg hover:opacity-90 transition-all duration-300 flex items-center gap-1">
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              </div>

              <div>
                <div class="text-sm font-bold text-emerald-700 mb-1">Landing Page (LP)</div>
                <div class="flex items-center gap-2">
                  <input type="text"
                    class="flex-1 px-3 py-2 text-sm bg-white/60 backdrop-blur border border-white/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900"
                    readonly
                    value="${event.affiliate_link?.url_lp || event.affiliate_link?.url || ''}"
                    id="link-lp-${event.id}"
                  />
                  <button onclick="copyLink('link-lp-${event.id}', this)"
                    class="px-3 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm rounded-lg hover:opacity-90 transition-all duration-300 flex items-center gap-1">
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              </div>
            </div>
          `;
            } else if (!isApproved) {
              buttonHTML = `
            <button disabled
              class="px-4 py-2 bg-gray-300 text-gray-500 text-sm rounded-lg cursor-not-allowed flex items-center gap-2"
              title="Akun Anda belum di-approve">
              <i class="fas fa-lock"></i>
              Generate Link
            </button>
          `;
            } else if (!isProfileComplete) {
              buttonHTML = `
            <button disabled
              class="px-4 py-2 btn-warning text-sm rounded-lg cursor-not-allowed flex items-center gap-2 opacity-70"
              title="Lengkapi profil terlebih dahulu (${profileCompletionPercent}%)">
              <i class="fas fa-exclamation-circle"></i>
              Lengkapi Profil
            </button>
          `;
            } else {
              buttonHTML = `
            <button onclick="generateLink(${event.id}, '${event.title.replace(/'/g, "\\'")}')"
              class="btn-purple text-sm flex items-center gap-2">
              <i class="fas fa-plus"></i>
              Generate Link
            </button>
          `;
            }

            eventCard.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h5 class="font-extrabold text-base text-gray-900">${event.title}</h5>
                <span class="px-2 py-0.5 rounded-lg text-sm font-extrabold ${event.event_type === 'gratis' ? 'gradient-info' : 'gradient-purple'} text-white border border-white/30">
                  ${event.event_type === 'gratis' ? '🎁 Gratis' : '💎 Berbayar'}
                </span>
              </div>
              <div class="text-sm text-gray-600 space-y-1">
                ${event.description ? `<p class="line-clamp-1">${event.description}</p>` : ''}
                <div class="flex items-center gap-4 text-sm text-gray-500">
                  <span><i class="fas fa-calendar-alt text-emerald-400 mr-1"></i>${startDate} - ${endDate}</span>
                  ${event.event_type === 'berbayar' ? `
                    <span class="text-emerald-600 font-extrabold">
                      Rp ${parseInt(event.price_promo || 0).toLocaleString('id-ID')}
                    </span>
                  ` : ''}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              ${buttonHTML}
            </div>
          </div>
        `;

            container.appendChild(eventCard);
          });
        }

        async function generateLink(eventId, eventTitle) {
          console.debug('generateLink called with eventId:', eventId, 'userStatus:', userStatus, 'profileCompletion:', profileCompletionPercent);

          if (userStatus !== 'approved') {
            Modal.show({
              type: 'warning',
              title: 'Belum Di-approve',
              message: 'Anda belum di-approve sebagai affiliate. Silakan tunggu approval dari admin.'
            });
            return;
          }

          if (profileCompletionPercent < 100) {
            Modal.show({
              type: 'warning',
              title: 'Profil Belum Lengkap',
              message: `Profil Anda belum lengkap (${profileCompletionPercent}%). Silakan lengkapi semua data terlebih dahulu sebelum generate link.\n\nKlik "Lengkapi/Edit Profil" di bagian Profil & Data Bank.`
            });
            return;
          }

          const btn = event.target;
          const originalContent = btn.innerHTML;

          try {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Generating...';

            console.debug('Sending request to /affiliate/api/generate-link...');

            const response = await fetch('/affiliate/api/generate-link', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ eventId })
            });

            const data = await response.json();

            console.debug('Generate link response:', data);

            if (!data.success) {
              throw new Error(data.message || 'Failed to generate link');
            }

            console.debug('Link generated successfully:', data.data.url);

            await loadEventsAndLinks();

            const checkoutUrlMsg = data.data.url_checkout || data.data.url || '';
            const lpUrlMsg = data.data.url_lp || '';

            Modal.show({
              type: 'success',
              title: 'Link Berhasil Dibuat',
              message: `Link berhasil dibuat untuk event: ${eventTitle}\n\nForm (Checkout): ${checkoutUrlMsg}\nLanding Page: ${lpUrlMsg}`,
              autoClose: false
            });

          } catch (error) {
            console.error('Error generating link:', error);
            Modal.show({
              type: 'error',
              title: 'Gagal Generate Link',
              message: `Gagal generate link: ${error.message}`
            });
            btn.disabled = false;
            btn.innerHTML = originalContent;
          }
        }

        function copyLink(inputId, btn) {
          const input = document.getElementById(inputId);
          input.select();
          input.setSelectionRange(0, 99999);

          try {
            navigator.clipboard.writeText(input.value);

            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i>';
            btn.classList.add('copy-btn-copied');

            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('copy-btn-copied');
            }, 1500);

            Modal.show({
              type: 'success',
              title: 'Berhasil',
              message: 'Link berhasil disalin!',
              autoClose: true,
              closeTime: 1500
            });
          } catch (err) {
            document.execCommand('copy');
            Modal.show({
              type: 'success',
              title: 'Berhasil',
              message: 'Link berhasil disalin!',
              autoClose: true,
              closeTime: 1500
            });
          }
        }
      </script>
      <script>
        (function syncProfilePercent() {
          const profileData = <% - JSON.stringify(affiliateProfile || {}) %>;
          const fields = ['full_name', 'email', 'phone', 'bank_name', 'bank_account_number', 'bank_account_name'];
          let filled = 0;
          fields.forEach((key) => {
            const value = profileData[key];
            if (value && String(value).trim() !== '') filled++;
          });
          const percent = Math.round((filled / fields.length) * 100);

          const percentEl = document.getElementById('profileCompletionPercent');
          const barEl = document.getElementById('profileCompletionBar');
          if (percentEl) {
            percentEl.textContent = percent + '%';
          }
          if (barEl) {
            barEl.style.width = percent + '%';
            if (percent >= 70) barEl.className = 'profile-bar-fill green';
            else if (percent >= 30) barEl.className = 'profile-bar-fill yellow';
            else barEl.className = 'profile-bar-fill red';
          }
        })();
      </script>
</body>

</html>
