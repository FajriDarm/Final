<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Affillink Affiliate</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-success {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.4);
    }

    .gradient-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
      box-shadow: 0 10px 20px -8px rgba(59, 130, 246, 0.4);
    }

    .gradient-danger {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
      box-shadow: 0 10px 20px -8px rgba(239, 68, 68, 0.4);
    }

    .gradient-purple {
      background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
      box-shadow: 0 10px 20px -8px rgba(139, 92, 246, 0.4);
    }

    .gradient-teal {
      background: linear-gradient(165deg, #0d9488 0%, #14b8a6 50%, #2dd4bf 100%);
      box-shadow: 0 10px 20px -8px rgba(20, 184, 166, 0.4);
    }

    .gradient-blue {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
      box-shadow: 0 10px 20px -8px rgba(59, 130, 246, 0.4);
    }

    .gradient-amber {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.4);
    }

    /* Status Gradients */
    .status-lead-baru {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .status-diprospek {
      background: linear-gradient(165deg, #f59e0b 0%, #fbbf24 50%, #fcd34d 100%);
    }

    .status-hot {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
    }

    .status-dp {
      background: linear-gradient(165deg, #8b5cf6 0%, #a78bfa 50%, #c4b5fd 100%);
    }

    .status-lunas {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
    }

    .status-berangkat {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .status-rejected {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
    }

    .status-pending {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .status-approved {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Badge 3D Effect */
    .badge-3d {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 rgba(0, 0, 0, 0.05);
    }

    .badge-3d:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 6px 0 rgba(0, 0, 0, 0.05);
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Custom Scrollbar */
    .modern-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .modern-scrollbar::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: linear-gradient(145deg, #10b981, #059669);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(145deg, #059669, #047857);
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    /* Glow Text */
    .glow-text {
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.3),
        0 0 20px rgba(16, 185, 129, 0.2);
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Data Cell */
    .data-cell-modern {
      position: relative;
      transition: all 0.4s ease;
    }

    .data-cell-modern::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 3px;
      background: linear-gradient(90deg, #10b981, #059669);
      transition: all 0.4s ease;
      transform: translateX(-50%);
    }

    .data-cell-modern:hover::before {
      width: 100%;
    }

    /* Animations */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white), linear-gradient(135deg, white, white, white);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Table Row Styles */
    .table-row {
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(5px);
    }

    .table-row:hover {
      background: rgba(255, 255, 255, 0.6);
      transform: scale(1.01);
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.15);
    }

    /* Tab Styles */
    .tab-active {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .tab-inactive {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(10px);
      color: #4b5563;
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .tab-inactive:hover {
      background: rgba(255, 255, 255, 0.8);
    }

    /* Button Styles */
    .btn-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .btn-primary:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-success {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .btn-success:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(10px);
      color: #374151;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.8);
    }

    .btn-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }

    .btn-info:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.2);
    }

    .btn-warning:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    .btn-purple {
      background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
      color: white;
      border-radius: 0.75rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 10px 15px -3px rgba(124, 58, 237, 0.2);
    }

    .btn-purple:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    /* Profile Completion Bar */
    .profile-bar {
      height: 0.625rem;
      border-radius: 9999px;
      overflow: hidden;
      background: rgba(229, 231, 235, 0.5);
    }

    .profile-bar-fill {
      height: 100%;
      border-radius: 9999px;
      transition: width 0.5s ease;
    }

    .profile-bar-fill.green {
      background: linear-gradient(90deg, #10b981, #059669);
    }

    .profile-bar-fill.yellow {
      background: linear-gradient(90deg, #f59e0b, #d97706);
    }

    .profile-bar-fill.red {
      background: linear-gradient(90deg, #ef4444, #dc2626);
    }

    /* Copy Button Animation */
    .copy-btn-copied {
      background: #10b981 !important;
      transition: all 0.2s ease;
    }

    /* Toast Notification */
    .notification-toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      animation: slideInRight 0.3s ease-out;
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    /* Modal Notification Styles */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(8px);
      z-index: 99999;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.show {
      display: flex;
      opacity: 1;
    }

    .modal-content {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 1.5rem;
      padding: 2rem;
      max-width: 400px;
      width: 90%;
      transform: scale(0.9) translateY(20px);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: 0 50px 100px -20px rgba(16, 185, 129, 0.3);
      position: relative;
      overflow: hidden;
    }

    .modal-overlay.show .modal-content {
      transform: scale(1) translateY(0);
    }

    .modal-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      animation: modalIconPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes modalIconPop {
      0% {
        transform: scale(0) rotate(-180deg);
      }

      100% {
        transform: scale(1) rotate(0);
      }
    }

    .modal-icon.success {
      background: linear-gradient(165deg, #059669, #10b981);
      box-shadow: 0 15px 30px -10px rgba(16, 185, 129, 0.5);
    }

    .modal-icon.warning {
      background: linear-gradient(165deg, #d97706, #f59e0b);
      box-shadow: 0 15px 30px -10px rgba(245, 158, 11, 0.5);
    }

    .modal-icon.error {
      background: linear-gradient(165deg, #b91c1c, #dc2626);
      box-shadow: 0 15px 30px -10px rgba(239, 68, 68, 0.5);
    }

    .modal-icon.info {
      background: linear-gradient(165deg, #2563eb, #3b82f6);
      box-shadow: 0 15px 30px -10px rgba(59, 130, 246, 0.5);
    }

    .modal-icon i {
      color: white;
      font-size: 2.5rem;
      filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
    }

    .modal-title {
      font-size: 1.75rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 0.75rem;
      color: #1f2937;
      animation: modalFadeIn 0.5s ease 0.1s both;
    }

    .modal-message {
      font-size: 1rem;
      color: #4b5563;
      text-align: center;
      margin-bottom: 2rem;
      line-height: 1.6;
      animation: modalFadeIn 0.5s ease 0.2s both;
    }

    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: translateY(15px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modal-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      animation: modalFadeIn 0.5s ease 0.3s both;
    }

    .modal-btn {
      padding: 0.875rem 2rem;
      border-radius: 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.3s ease;
      border: none;
      min-width: 120px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .modal-btn-primary {
      background: linear-gradient(165deg, #059669, #10b981);
      color: white;
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
    }

    .modal-btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px -5px rgba(16, 185, 129, 0.5);
    }

    .modal-btn-secondary {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
      color: #374151;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
    }

    .modal-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: translateY(-3px);
    }

    .modal-progress {
      height: 4px;
      background: rgba(16, 185, 129, 0.1);
      border-radius: 2px;
      margin-top: 2rem;
      overflow: hidden;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
    }

    .modal-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, #10b981, #34d399);
      width: 100%;
      animation: progress 3s linear forwards;
    }

    @keyframes progress {
      0% {
        width: 100%;
      }

      100% {
        width: 0%;
      }
    }

    /* Line Clamp */
    .line-clamp-1 {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
  <!-- Ultra Modern Decorative Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
    <div
      class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
    </div>
    <div
      class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
    </div>

    <!-- Animated Grid Lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

    <!-- Floating Particles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
    <div
      class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
    </div>
  </div>

  <!-- Premium Modal System -->
  <div id="notificationModal" class="modal-overlay">
    <div class="modal-content">
      <div id="modalIcon" class="modal-icon success">
        <i id="modalIconIcon" class="fas fa-check"></i>
      </div>
      <h3 id="modalTitle" class="modal-title">Notifikasi</h3>
      <p id="modalMessage" class="modal-message">Pesan notifikasi akan muncul di sini</p>
      <div class="modal-buttons">
        <button id="modalConfirmBtn" class="modal-btn modal-btn-primary">OK</button>
        <button id="modalCancelBtn" class="modal-btn modal-btn-secondary" style="display: none;">Batal</button>
      </div>
      <div id="modalProgress" class="modal-progress">
        <div class="modal-progress-bar"></div>
      </div>
    </div>
  </div>

  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: typeof name !=='undefined' ? name : '' }) %>

    <!-- Sidebar -->
    <%- include('../sidebar/affiliate.ejs') %>

      <!-- Main Content -->
      <main class="md:ml-64 ml-0 pt-16 min-h-screen relative z-10">
        <div class="p-6">
          <!-- Premium Page Header - Diperbesar ukuran fontnya -->
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 animate-slide-in">
            <div class="mb-4 lg:mb-0">
              <div class="flex items-center gap-4">
                <div class="relative">
                  <div
                    class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
                    <i class="fas fa-chart-line text-white text-2xl"></i>
                  </div>
                  <div
                    class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                    <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h1
                      class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
                      Dashboard Affiliate
                    </h1>
                    <span
                      class="px-3 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 rounded-lg text-white text-sm font-bold tracking-wider shadow-lg">
                      AFFILIATE
                    </span>
                  </div>
                  <p class="text-base text-emerald-700 font-medium">Halo, <span class="font-extrabold">
                      <%= typeof name !=='undefined' ? name : 'Affiliate' %>
                    </span></p>
                </div>
              </div>
            </div>

            <!-- Premium Date & Live Status - Diperbesar ukuran fontnya -->
            <div class="flex items-center gap-3">
              <div class="neomorph rounded-xl px-4 py-2.5 flex items-center gap-3">
                <div class="w-8 h-8 gradient-primary rounded-lg flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar-alt text-white text-sm"></i>
                </div>
                <div>
                  <p class="text-xs text-emerald-700 font-bold uppercase tracking-wider">Tanggal</p>
                  <p class="text-sm font-bold text-emerald-700 whitespace-nowrap">
                    <%= new Date().toLocaleDateString('id-ID', { day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                  </p>
                </div>
              </div>

              <div class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-xl relative shimmer">
                <div class="relative">
                  <i class="fas fa-bell text-white text-sm"></i>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full"></span>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></span>
                </div>
                <div>
                  <p class="text-xs text-white/90 font-bold uppercase tracking-wider">Live Status</p>
                  <p class="text-sm font-bold text-white">Updates Real-time</p>
                </div>
              </div>

              <div id="affiliateStatusBadge" class="hidden">
                <!-- Status badge will be shown here -->
              </div>
            </div>
          </div>

          <!-- Premium Stats Cards - Diperbesar ukuran fontnya -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-7 animate-scale-in">
            <!-- Program Affiliate Aktif -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-emerald-400/20 to-green-400/20 rounded-full -mr-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-teal-400/20 to-emerald-400/20 rounded-full -ml-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                      </span>
                      <p class="text-emerald-700 text-xs font-bold uppercase tracking-wider">Program Affiliate Aktif
                      </p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900" id="activeProgramsCount">
                        <%= typeof activeProgramsCount !=='undefined' ? activeProgramsCount : 0 %>
                      </p>
                      <span class="text-sm font-bold text-emerald-600">program</span>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:rotate-3 transition-all duration-500">
                    <i class="fas fa-handshake text-white text-xl"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- Komisi Anda -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 left-0 w-32 h-32 bg-gradient-to-br from-emerald-400/20 to-green-400/20 rounded-full -ml-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-tr from-teal-400/20 to-emerald-400/20 rounded-full -mr-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                      </span>
                      <p class="text-emerald-700 text-xs font-bold uppercase tracking-wider">Komisi Anda</p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-3xl font-black text-gray-900 break-all" id="totalCommissionDisplay">Rp <%= (typeof
                          totalCommission !=='undefined' && !isNaN(Number(totalCommission))) ?
                          Number(totalCommission).toLocaleString('id-ID', { maximumFractionDigits: 0 }) : '0' %>
                      </p>
                    </div>

                    <!-- Info badge removed -->
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
                    <i class="fas fa-coins text-white text-xl"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- Total Leads -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-400/20 to-indigo-400/20 rounded-full -mr-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-indigo-400/20 to-purple-400/20 rounded-full -ml-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
                      </span>
                      <p class="text-emerald-700 text-xs font-bold uppercase tracking-wider">Total Leads</p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900">
                        <%= typeof totalLeads !=='undefined' ? totalLeads : 0 %>
                      </p>
                      <span class="text-sm font-bold text-emerald-600">leads</span>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:rotate-6 transition-all duration-500">
                    <i class="fas fa-users text-white text-xl"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- Leads 30 hari terakhir -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 left-0 w-32 h-32 bg-gradient-to-br from-amber-400/20 to-orange-400/20 rounded-full -ml-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-tr from-orange-400/20 to-amber-400/20 rounded-full -mr-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                      </span>
                      <p class="text-emerald-700 text-xs font-bold uppercase tracking-wider">Leads 30 hari terakhir
                      </p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900">
                        <%= typeof leadsLast30 !=='undefined' ? leadsLast30 : 0 %>
                      </p>
                      <span class="text-sm font-bold text-emerald-600">leads</span>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500">
                    <i class="fas fa-calendar-alt text-white text-xl"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Row: Leads table + Profile -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7">
            <!-- Leads table (left, spans 2 cols) -->
            <div class="lg:col-span-2 glass-futuristic rounded-2xl border border-white/50 overflow-hidden">
              <div class="gradient-primary px-5 py-4 flex items-center justify-between border-b border-white/30">
                <div class="flex items-center gap-3">
                  <div
                    class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                    <i class="fas fa-users text-white text-base"></i>
                  </div>
                  <div>
                    <h2 class="text-lg font-extrabold text-white">Lead Terbaru</h2>
                    <p class="text-emerald-100 text-sm font-medium mt-0.5">Menampilkan <%= typeof perPage !=='undefined'
                        ? perPage : 5 %> lead per halaman</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <span
                    class="text-sm font-medium text-white bg-white/20 backdrop-blur px-3 py-1.5 rounded-lg border border-white/30">
                    <i class="fas fa-chart-line mr-1"></i>
                    Total: <span class="font-extrabold">
                      <%= typeof totalLeads !=='undefined' ? totalLeads : 0 %>
                    </span>
                  </span>
                </div>
              </div>

              <div class="p-5 bg-white/30 backdrop-blur">
                <div class="flex items-center justify-between mb-4">
                  <form method="GET" action="/affiliate/dashboard" class="flex items-center gap-2">
                    <label class="text-sm font-medium text-emerald-700">Status:</label>
                    <div class="relative">
                      <select name="status" onchange="this.form.submit()"
                        class="appearance-none pl-3 pr-8 py-2 bg-white/60 backdrop-blur border border-white/50 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-sm font-medium">
                        <option value="all" <%=(typeof statusFilter==='undefined' || statusFilter==='all' ) ? 'selected'
                          : '' %>>Semua</option>
                        <option value="pending" <%=statusFilter==='pending' ? 'selected' : '' %>>pending</option>
                        <option value="paid" <%=statusFilter==='paid' ? 'selected' : '' %>>paid</option>
                        <option value="rejected" <%=statusFilter==='rejected' ? 'selected' : '' %>>rejected</option>
                      </select>
                      <i
                        class="fas fa-chevron-down absolute right-3 top-1/2 transform -translate-y-1/2 text-emerald-400 pointer-events-none text-sm"></i>
                    </div>
                    <input type="hidden" name="page" value="1">
                  </form>
                </div>

                <div class="overflow-x-auto modern-scrollbar">
                  <table class="w-full text-left">
                    <thead class="bg-white/10 backdrop-blur border-b border-white/30">
                      <tr>
                        <th class="py-3 px-4 text-sm font-extrabold text-emerald-900 uppercase tracking-wider">Nama
                        </th>
                        <th class="py-3 px-4 text-sm font-extrabold text-emerald-900 uppercase tracking-wider">
                          WhatsApp</th>
                        <th class="py-3 px-4 text-sm font-extrabold text-emerald-900 uppercase tracking-wider">Event
                        </th>
                        <th class="py-3 px-4 text-sm font-extrabold text-emerald-900 uppercase tracking-wider">
                          Status</th>
                        <th class="py-3 px-4 text-sm font-extrabold text-emerald-900 uppercase tracking-wider">
                          Tanggal</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/30 bg-white/20 backdrop-blur">
                      <% if (Array.isArray(leads) && leads.length> 0) {
                        leads.forEach(function(l, index){
                        let statusClass = '';
                        let statusLabel = '';
                        const leadStatus = l.lead_status;

                        if (leadStatus) {
                        if (leadStatus === 'LEAD BARU') {
                        statusLabel = 'Lead Baru';
                        statusClass = 'status-lead-baru';
                        } else if (leadStatus === 'SEDANG DI PROSPEK') {
                        statusLabel = 'Sedang di Prospek';
                        statusClass = 'status-diprospek';
                        } else if (leadStatus === 'HOT') {
                        statusLabel = 'HOT';
                        statusClass = 'status-hot';
                        } else if (leadStatus === 'DP') {
                        statusLabel = 'DP';
                        statusClass = 'status-dp';
                        } else if (leadStatus === 'LUNAS') {
                        statusLabel = 'LUNAS';
                        statusClass = 'status-lunas';
                        } else if (leadStatus === 'SEDANG BERANGKAT') {
                        statusLabel = 'Sedang Berangkat';
                        statusClass = 'status-berangkat';
                        } else {
                        statusLabel = leadStatus;
                        statusClass = 'bg-gray-500 text-white';
                        }
                        } else {
                        if (l.status === 'rejected') {
                        statusLabel = 'Rejected';
                        statusClass = 'status-rejected';
                        } else if (l.status === 'completed') {
                        statusLabel = 'Complete';
                        statusClass = 'status-lunas';
                        } else if (l.status === 'stage_2_approved') {
                        statusLabel = 'Verifikasi 3';
                        statusClass = 'status-berangkat';
                        } else if (l.status === 'stage_1_approved') {
                        statusLabel = 'Verifikasi 2';
                        statusClass = 'status-info';
                        } else {
                        statusLabel = 'Verifikasi 1';
                        statusClass = 'status-pending';
                        }
                        }
                        %>
                        <tr
                          class="table-row hover:bg-white/40 transition-all duration-300 border-b border-white/30 last:border-b-0 fade-in"
                          style="animation-delay: <%= index * 0.03 %>s">
                          <td class="py-3 px-4">
                            <div class="flex items-center gap-2">
                              <div
                                class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                                <i class="fas fa-user text-emerald-600 text-sm"></i>
                              </div>
                              <span class="text-sm font-medium text-gray-900">
                                <%= l.name || '-' %>
                              </span>
                            </div>
                          </td>
                          <td class="py-3 px-4 text-sm text-gray-700">
                            <%= l.phone || '-' %>
                          </td>
                          <td class="py-3 px-4 text-sm text-gray-700">
                            <%= l.event_title || '-' %>
                          </td>
                          <td class="py-3 px-4">
                            <span
                              class="px-2 py-1 rounded-lg text-xs font-extrabold <%= statusClass %> text-white border border-white/30">
                              <%= statusLabel %>
                            </span>
                          </td>
                          <td class="py-3 px-4">
                            <span class="text-sm text-gray-600">
                              <%= l.created_at ? new Date(l.created_at).toLocaleString() : '-' %>
                            </span>
                          </td>
                        </tr>
                        <% }) } else { %>
                          <tr>
                            <td colspan="5" class="py-12 px-4 text-center">
                              <div class="flex flex-col items-center justify-center">
                                <div class="relative">
                                  <div
                                    class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                                    <i class="fas fa-inbox text-3xl text-emerald-300"></i>
                                  </div>
                                  <div
                                    class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                                    <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                                  </div>
                                </div>
                                <p class="text-lg font-extrabold text-gray-900 mb-2">Belum ada lead</p>
                                <p class="text-base text-emerald-700 font-medium">Lead akan muncul di sini</p>
                              </div>
                            </td>
                          </tr>
                          <% } %>
                    </tbody>
                  </table>
                </div>

                <!-- Pagination -->
                <div class="mt-4 flex items-center justify-between">
                  <div
                    class="text-sm font-medium text-emerald-700 bg-white/60 px-3 py-2 rounded-lg border border-white/60">
                    Halaman <%= currentPage %> dari <%= totalPages %>
                  </div>
                  <div class="flex items-center gap-2">
                    <% const baseUrl='/affiliate/dashboard' ; %>
                      <% const sf=typeof statusFilter !=='undefined' ? statusFilter : 'all' ; %>
                        <% if (currentPage> 1) { %>
                          <a href="<%= baseUrl %>?page=<%= currentPage - 1 %>&status=<%= sf %>"
                            class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all">
                            <i class="fas fa-chevron-left text-sm"></i>
                          </a>
                          <% } %>
                            <% for (let p=1; p <=totalPages; p++) { %>
                              <% if (p===currentPage) { %>
                                <span
                                  class="w-8 h-8 rounded-lg gradient-primary text-white flex items-center justify-center text-sm font-bold shadow-lg">
                                  <%= p %>
                                </span>
                                <% } else { %>
                                  <a href="<%= baseUrl %>?page=<%= p %>&status=<%= sf %>"
                                    class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all text-sm font-bold">
                                    <%= p %>
                                  </a>
                                  <% } %>
                                    <% } %>
                                      <% if (currentPage < totalPages) { %>
                                        <a href="<%= baseUrl %>?page=<%= currentPage + 1 %>&status=<%= sf %>"
                                          class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all">
                                          <i class="fas fa-chevron-right text-sm"></i>
                                        </a>
                                        <% } %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Profile & Bank (right column) - Diperbesar ukuran fontnya -->
            <div class="glass-futuristic rounded-2xl border border-white/50 overflow-hidden">
              <div class="gradient-primary px-5 py-4 border-b border-white/30">
                <div class="flex items-center gap-3">
                  <div
                    class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                    <i class="fas fa-user-circle text-white text-base"></i>
                  </div>
                  <div>
                    <h3 class="text-lg font-extrabold text-white">Profil & Data Bank</h3>
                    <p class="text-emerald-100 text-sm font-medium mt-0.5">Kelengkapan data affiliate</p>
                  </div>
                </div>
              </div>

              <div class="p-5 bg-white/30 backdrop-blur">
                <!-- Profile Completion Indicator -->
                <div class="mb-6 glass-futuristic rounded-xl p-4 border border-blue-200/50 bg-blue-50/30">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-base font-extrabold text-emerald-800">Kelengkapan Profil</span>
                    <span class="text-lg font-extrabold text-emerald-700" id="profileCompletionPercent">0%</span>
                  </div>
                  <div class="profile-bar">
                    <div id="profileCompletionBar" class="profile-bar-fill green" style="width: 0%"></div>
                  </div>
                  <p class="text-sm text-emerald-700 mt-2 flex items-center gap-1">
                    <i class="fas fa-info-circle text-emerald-400"></i>
                    Lengkapi semua data untuk aktifkan fitur generate link
                  </p>
                </div>

                <% const
