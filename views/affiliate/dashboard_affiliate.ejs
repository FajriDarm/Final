<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Affillink Affiliate</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: typeof name !== 'undefined' ? name : '' }) %>

  <!-- Sidebar -->
  <%- include('../sidebar/affiliate.ejs') %>

  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <div class="space-y-6">

        <!-- Page Header -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">Dashboard Affiliate</h1>
            <p class="text-gray-600 mt-1">Halo, <span class="font-semibold"><%= typeof name !== 'undefined' ? name : 'Affiliate' %></span></p>
          </div>
          <div class="text-sm text-gray-500">
            <i class="fas fa-calendar-alt mr-2"></i>
            <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
          </div>
        </div>

        <!-- Top Cards (summary) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <p class="text-gray-500 text-sm font-medium">Program Affiliate Aktif</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= typeof activeProgramsCount !== 'undefined' ? activeProgramsCount : 0 %></p>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <p class="text-gray-500 text-sm font-medium">Komisi Anda</p>
            <p class="text-3xl font-bold text-gray-900 mt-2">Rp <%= typeof totalCommission !== 'undefined' ? totalCommission : '0.00' %></p>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <p class="text-gray-500 text-sm font-medium">Total Leads</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= typeof totalLeads !== 'undefined' ? totalLeads : 0 %></p>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <p class="text-gray-500 text-sm font-medium">Leads 30 hari terakhir</p>
            <p class="text-3xl font-bold text-gray-900 mt-2"><%= typeof leadsLast30 !== 'undefined' ? leadsLast30 : 0 %></p>
          </div>
        </div>

        <!-- Main Row: Leads table + Profile -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Leads table (left, spans 2 cols) -->
          <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="text-lg font-semibold text-gray-900">Lead Terbaru</h2>
                <p class="text-sm text-gray-500">10 lead terakhir yang terkait dengan referral Anda</p>
              </div>
              <div class="text-sm text-gray-500">Total: <span class="font-medium"><%= typeof totalLeads !== 'undefined' ? totalLeads : 0 %></span></div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm divide-y divide-gray-100">
                <thead>
                  <tr class="text-gray-500">
                    <th class="py-2 font-medium">Nama</th>
                    <th class="py-2 font-medium">Email</th>
                    <th class="py-2 font-medium">WhatsApp</th>
                    <th class="py-2 font-medium">Event</th>
                    <th class="py-2 font-medium">Status</th>
                    <th class="py-2 font-medium">Tanggal</th>
                  </tr>
                </thead>
                <tbody class="bg-white">
                  <% if (Array.isArray(leads) && leads.length > 0) { leads.forEach(function(l){ %>
                    <tr class="hover:bg-gray-50">
                      <td class="py-3"><%= l.name || '-' %></td>
                      <td class="py-3"><%= l.email || '-' %></td>
                      <td class="py-3"><%= l.phone || '-' %></td>
                      <td class="py-3"><%= l.event_title || '-' %></td>
                      <td class="py-3">
                        <% if (l.payment_status === 'pending') { %>
                          <span class="inline-block px-2 py-0.5 rounded text-yellow-700 bg-yellow-100">pending</span>
                        <% } else if (l.payment_status === 'paid') { %>
                          <span class="inline-block px-2 py-0.5 rounded text-green-700 bg-green-100">paid</span>
                        <% } else { %>
                          <span class="inline-block px-2 py-0.5 rounded text-red-700 bg-red-100"><%= l.payment_status %></span>
                        <% } %>
                      </td>
                      <td class="py-3"><%= l.created_at ? new Date(l.created_at).toLocaleString() : '-' %></td>
                    </tr>
                  <% }) } else { %>
                    <tr>
                      <td class="py-8 text-center text-gray-400" colspan="6">Belum ada lead.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Profile & Bank (right column) -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Profil & Data Bank</h3>
            <% if (typeof affiliateProfile !== 'undefined' && affiliateProfile) { %>
              <div class="space-y-2 text-sm text-gray-700">
                <div><strong>Nama:</strong> <span class="font-medium"><%= affiliateProfile.full_name || '-' %></span></div>
                <div><strong>Email:</strong> <span class="font-medium"><%= affiliateProfile.email || '-' %></span></div>
                <div><strong>WhatsApp:</strong> <span class="font-medium"><%= affiliateProfile.phone || '-' %></span></div>
                <div><strong>Kota:</strong> <span class="font-medium"><%= affiliateProfile.city || '-' %></span></div>
                <div><strong>Bank:</strong> <span class="font-medium"><%= affiliateProfile.bank_name || '-' %></span></div>
                <div><strong>No. Rek:</strong> <span class="font-medium"><%= affiliateProfile.bank_account_number || '-' %></span></div>
                <div><strong>Atas Nama:</strong> <span class="font-medium"><%= affiliateProfile.bank_account_name || '-' %></span></div>
              </div>
            <% } else { %>
              <div class="text-sm text-gray-500">Belum ada data profil. Silakan lengkapi data bank untuk proses payout.</div>
            <% } %>

            <div class="mt-4 text-xs text-gray-500">Catatan: Komisi dihitung otomatis berdasarkan transaksi dan verifikasi. Finance memproses payout manual.</div>
          </div>
        </div>

        <!-- Events & Links Section -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
          <div class="flex items-center justify-between mb-4">
            <h4 class="text-lg font-semibold text-gray-900">
              <i class="fas fa-link mr-2 text-purple-600"></i>Event & Affiliate Links
            </h4>
            <div id="affiliateStatusBadge" class="hidden">
              <!-- Status badge will be shown here -->
            </div>
          </div>

          <!-- Loading state -->
          <div id="eventsLoading" class="text-center py-8">
            <i class="fas fa-spinner fa-spin text-2xl text-purple-600 mb-2"></i>
            <p class="text-gray-500">Memuat event...</p>
          </div>

          <!-- Events container -->
          <div id="eventsContainer" class="hidden space-y-4">
            <!-- Events will be loaded here dynamically -->
          </div>

          <!-- No events state -->
          <div id="noEvents" class="hidden text-center py-8 text-gray-400">
            <i class="fas fa-calendar-times text-4xl mb-2"></i>
            <p>Belum ada event aktif saat ini</p>
          </div>

          <!-- Not approved message -->
          <div id="notApprovedMessage" class="hidden bg-yellow-50 border border-yellow-200 rounded-xl p-6 text-center">
            <i class="fas fa-exclamation-triangle text-yellow-600 text-3xl mb-3"></i>
            <h5 class="font-semibold text-yellow-800 mb-2">Akun Affiliate Belum Di-Approve</h5>
            <p class="text-sm text-yellow-700">Anda belum bisa generate link affiliate. Silakan tunggu approval dari admin.</p>
          </div>
        </div>

        <!-- Legacy Referral Link card (hidden by default, shown as fallback) -->
        <div id="legacyReferralCard" class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hidden">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Link Referral Global</h4>
          <div class="flex gap-3 items-center">
            <input id="refLinkInput" class="flex-1 px-3 py-2 border rounded-md bg-gray-50" readonly value="<%= typeof referralLink !== 'undefined' && referralLink ? referralLink : (typeof siteUrl !== 'undefined' && typeof sampleRefCode !== 'undefined' ? siteUrl + '/?ref=' + sampleRefCode : '') %>" aria-label="Referral link" />
            <button id="copyRefBtn" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">Copy</button>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script>
    // Affiliate user status from server - fallback, will be updated from API
    let userStatus = '<%= typeof userStatus !== "undefined" ? userStatus : "inactive" %>';
    console.debug('User status from server (initial):', userStatus);

    // Load events on page load
    document.addEventListener('DOMContentLoaded', async function() {
      console.debug('DOM loaded, loading events...');

      // First, fetch user status from API
      await fetchUserStatus();

      // Then load events and links
      await loadEventsAndLinks();
    });

    // Fetch current user status from API
    async function fetchUserStatus() {
      try {
        console.debug('Fetching user status from /affiliate/api/status...');
        const response = await fetch('/affiliate/api/status');
        const data = await response.json();

        console.debug('User status API response:', data);

        if (data.success && data.data) {
          userStatus = data.data.affiliate_status || data.data.status || 'inactive';
          console.debug('Updated userStatus:', userStatus);

          // Update status badge if exists
          const affiliateStatusBadge = document.getElementById('affiliateStatusBadge');
          if (affiliateStatusBadge) {
            const statusConfig = {
              'approved': { bg: 'bg-green-100', text: 'text-green-700', icon: '✓ Approved' },
              'pending': { bg: 'bg-yellow-100', text: 'text-yellow-700', icon: '⏳ Pending' },
              'rejected': { bg: 'bg-red-100', text: 'text-red-700', icon: '✗ Rejected' },
              'inactive': { bg: 'bg-gray-100', text: 'text-gray-700', icon: '○ Inactive' }
            }[userStatus] || { bg: 'bg-gray-100', text: 'text-gray-700', icon: '? Unknown' };

            affiliateStatusBadge.innerHTML = `
              <span class="px-3 py-1 rounded-full text-xs font-semibold ${statusConfig.bg} ${statusConfig.text}">
                ${statusConfig.icon}
              </span>
            `;
            affiliateStatusBadge.classList.remove('hidden');
          }
        }
      } catch (error) {
        console.error('Error fetching user status:', error);
        // Keep using the server-rendered status as fallback
      }
    }

    async function loadEventsAndLinks() {
      const eventsLoading = document.getElementById('eventsLoading');
      const eventsContainer = document.getElementById('eventsContainer');
      const noEvents = document.getElementById('noEvents');
      const notApprovedMessage = document.getElementById('notApprovedMessage');
      const affiliateStatusBadge = document.getElementById('affiliateStatusBadge');

      console.debug('Fetching events from /affiliate/api/events...');

      try {
        const response = await fetch('/affiliate/api/events');
        const data = await response.json();

        console.debug('API Response:', data);

        eventsLoading.classList.add('hidden');

        if (!data.success) {
          console.error('API Error:', data.message);
          // Check if error is due to not approved
          if (data.message && data.message.includes('belum di-approve')) {
            notApprovedMessage.classList.remove('hidden');
            return;
          }
          throw new Error(data.message || 'Failed to load events');
        }

        console.debug('Events loaded:', data.data.length, 'events');

        if (data.data.length === 0) {
          noEvents.classList.remove('hidden');
          return;
        }

        eventsContainer.classList.remove('hidden');
        displayEvents(data.data);

        // Show status badge
        if (affiliateStatusBadge) {
          const statusConfig = {
            'approved': { bg: 'bg-green-100', text: 'text-green-700', icon: '✓ Approved', label: 'Approved' },
            'pending': { bg: 'bg-yellow-100', text: 'text-yellow-700', icon: '⏳ Pending', label: 'Pending' },
            'rejected': { bg: 'bg-red-100', text: 'text-red-700', icon: '✗ Rejected', label: 'Rejected' },
            'inactive': { bg: 'bg-gray-100', text: 'text-gray-700', icon: '○ Inactive', label: 'Inactive' }
          }[userStatus] || { bg: 'bg-gray-100', text: 'text-gray-700', icon: '? Unknown', label: 'Unknown' };

          affiliateStatusBadge.innerHTML = `
            <span class="px-3 py-1 rounded-full text-xs font-semibold ${statusConfig.bg} ${statusConfig.text}">
              ${statusConfig.icon}
            </span>
          `;
          affiliateStatusBadge.classList.remove('hidden');
        }

      } catch (error) {
        console.error('Error loading events:', error);
        eventsLoading.classList.add('hidden');
        eventsContainer.innerHTML = `
          <div class="text-center py-8 text-red-500">
            <i class="fas fa-exclamation-circle text-2xl mb-2"></i>
            <p>Gagal memuat event: ${error.message}</p>
          </div>
        `;
        eventsContainer.classList.remove('hidden');
      }
    }

    function displayEvents(events) {
      const container = document.getElementById('eventsContainer');
      container.innerHTML = '';

      console.debug('Displaying events:', events);
      console.debug('User status:', userStatus);

      events.forEach((event, index) => {
        console.debug(`Event ${index}:`, event);

        const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
        const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

        const eventCard = document.createElement('div');
        eventCard.className = 'border border-gray-200 rounded-xl p-4 hover:border-purple-300 transition-all';

        const isApproved = userStatus === 'approved';
        const hasLink = event.has_link;

        console.debug(`Event: ${event.title}, hasLink: ${hasLink}, isApproved: ${isApproved}`);

        eventCard.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <h5 class="font-semibold text-gray-900">${event.title}</h5>
                <span class="px-2 py-0.5 rounded text-xs font-medium ${event.event_type === 'gratis' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">
                  ${event.event_type === 'gratis' ? '🎁 Gratis' : '💎 Berbayar'}
                </span>
              </div>
              <div class="text-sm text-gray-600 space-y-1">
                ${event.description ? `<p class="line-clamp-1">${event.description}</p>` : ''}
                <div class="flex items-center gap-4 text-xs text-gray-500">
                  <span><i class="fas fa-calendar-alt mr-1"></i>${startDate} - ${endDate}</span>
                  ${event.event_type === 'berbayar' ? `
                    <span class="text-green-600 font-semibold">
                      Rp ${parseInt(event.price_promo || 0).toLocaleString('id-ID')}
                    </span>
                  ` : ''}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              ${hasLink ? `
                <div class="flex items-center gap-2">
                  <input type="text"
                    class="w-48 px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50"
                    readonly
                    value="${event.affiliate_link?.url || ''}"
                    id="link-${event.id}"
                  />
                  <button onclick="copyLink('link-${event.id}', this)"
                    class="px-3 py-2 bg-green-600 text-white text-sm rounded-lg hover:bg-green-700 transition-colors">
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              ` : `
                <button onclick="generateLink(${event.id}, '${event.title.replace(/'/g, "\\'")}')"
                  class="px-4 py-2 ${isApproved ? 'bg-purple-600 hover:bg-purple-700' : 'bg-gray-300 cursor-not-allowed'} text-white text-sm rounded-lg transition-colors"
                  ${!isApproved ? 'disabled' : ''}>
                  <i class="fas fa-plus mr-1"></i>
                  Generate Link
                </button>
              `}
            </div>
          </div>
        `;

        container.appendChild(eventCard);
      });
    }

    async function generateLink(eventId, eventTitle) {
      console.debug('generateLink called with eventId:', eventId, 'userStatus:', userStatus);

      if (userStatus !== 'approved') {
        alert('Anda belum di-approve sebagai affiliate. Silakan tunggu approval admin.');
        return;
      }

      const btn = event.target;
      const originalContent = btn.innerHTML;

      try {
        // Show loading state
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Generating...';

        console.debug('Sending request to /affiliate/api/generate-link...');

        const response = await fetch('/affiliate/api/generate-link', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ eventId })
        });

        const data = await response.json();

        console.debug('Generate link response:', data);

        if (!data.success) {
          throw new Error(data.message || 'Failed to generate link');
        }

        console.debug('Link generated successfully:', data.data.url);

        // Reload events to show the new link
        await loadEventsAndLinks();

        // Show success message
        alert(`Link berhasil dibuat untuk event: ${eventTitle}\n\nURL: ${data.data.url}`);

      } catch (error) {
        console.error('Error generating link:', error);
        alert(`Gagal generate link: ${error.message}`);
        btn.disabled = false;
        btn.innerHTML = originalContent;
      }
    }

    function copyLink(inputId, btn) {
      const input = document.getElementById(inputId);
      input.select();
      input.setSelectionRange(0, 99999);

      try {
        navigator.clipboard.writeText(input.value);

        // Show feedback
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i>';
        btn.classList.remove('bg-green-600');
        btn.classList.add('bg-green-500');

        setTimeout(() => {
          btn.innerHTML = originalHTML;
          btn.classList.remove('bg-green-500');
          btn.classList.add('bg-green-600');
        }, 1500);
      } catch (err) {
        // Fallback for older browsers
        document.execCommand('copy');
        alert('Link berhasil disalin!');
      }
    }

    // Legacy copy button handler (if shown)
    const copyBtn = document.getElementById('copyRefBtn');
    const refInput = document.getElementById('refLinkInput');
    if (copyBtn && refInput) {
      copyBtn.addEventListener('click', function(){
        refInput.select();
        refInput.setSelectionRange(0, 99999);
        try {
          navigator.clipboard.writeText(refInput.value);
          copyBtn.textContent = 'Copied';
          setTimeout(()=> copyBtn.textContent = 'Copy', 1500);
        } catch(e) {
          document.execCommand('copy');
        }
      });
    }
  </script>
</body>
</html>
