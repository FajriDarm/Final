      <script>
        // ============================================================
        // FUNGSI MODAL
        // ============================================================

        const Modal = {
          element: document.getElementById('premiumModal'),
          icon: document.getElementById('modalIcon'),
          iconIcon: document.getElementById('modalIconIcon'),
          title: document.getElementById('modalTitle'),
          message: document.getElementById('modalMessage'),
          confirmBtn: document.getElementById('modalConfirmBtn'),
          cancelBtn: document.getElementById('modalCancelBtn'),
          dangerBtn: document.getElementById('modalDangerBtn'),
          progress: document.getElementById('modalProgress'),

          show: function (options) {
            const {
              type = 'info',
              title,
              message,
              onConfirm,
              onCancel,
              onDanger,
              confirmText = 'OK',
              cancelText = 'Batal',
              dangerText = 'Hapus',
              autoClose = true,
              closeTime = 3000,
              showDanger = false
            } = options;

            // Reset classes
            this.icon.className = 'modal-icon';
            this.icon.classList.add(type);

            // Set icon berdasarkan type
            const icons = {
              success: 'fa-check',
              warning: 'fa-exclamation-triangle',
              error: 'fa-times-circle',
              info: 'fa-info-circle',
              question: 'fa-question-circle'
            };
            this.iconIcon.className = `fas ${icons[type] || 'fa-info-circle'} text-white text-2xl`;

            // Set content
            this.title.textContent = title || 'Notifikasi';
            this.message.textContent = message || '';

            // Show modal
            this.element.classList.add('show');

            // Handle buttons
            // Confirm button
            if (onConfirm) {
              this.confirmBtn.style.display = 'block';
              this.confirmBtn.textContent = confirmText;
              this.confirmBtn.onclick = () => {
                this.hide();
                onConfirm();
              };
            } else {
              this.confirmBtn.style.display = 'block';
              this.confirmBtn.textContent = 'OK';
              this.confirmBtn.onclick = () => this.hide();
            }

            // Cancel button
            if (onCancel) {
              this.cancelBtn.style.display = 'block';
              this.cancelBtn.textContent = cancelText;
              this.cancelBtn.onclick = () => {
                this.hide();
                onCancel();
              };
            } else {
              this.cancelBtn.style.display = 'none';
            }

            // Danger button
            if (showDanger && onDanger) {
              this.dangerBtn.style.display = 'block';
              this.dangerBtn.textContent = dangerText;
              this.dangerBtn.onclick = () => {
                this.hide();
                onDanger();
              };
            } else {
              this.dangerBtn.style.display = 'none';
            }

            // Auto close
            if (autoClose) {
              this.progress.style.display = 'block';
              const progressBar = this.progress.querySelector('.modal-progress-bar');
              progressBar.style.animation = 'none';
              progressBar.offsetHeight;
              progressBar.style.animation = `progress ${closeTime / 1000}s linear forwards`;

              setTimeout(() => {
                this.hide();
              }, closeTime);
            } else {
              this.progress.style.display = 'none';
            }
          },

          hide: function () {
            this.element.classList.remove('show');
          }
        };

        // Fungsi untuk menampilkan modal
        function showModal(options) {
          Modal.show(options);
        }

        // Fungsi untuk konfirmasi (Promise-based)
        function showConfirm(options) {
          return new Promise((resolve) => {
            Modal.show({
              type: options.type || 'question',
              title: options.title || 'Konfirmasi',
              message: options.message,
              confirmText: options.confirmText || 'Ya',
              cancelText: options.cancelText || 'Tidak',
              onConfirm: () => resolve(true),
              onCancel: () => resolve(false),
              autoClose: false
            });
          });
        }

        // Fungsi untuk konfirmasi dengan opsi hapus
        function showConfirmWithDanger(options) {
          return new Promise((resolve) => {
            Modal.show({
              type: options.type || 'warning',
              title: options.title || 'Konfirmasi',
              message: options.message,
              confirmText: options.confirmText || 'Ya',
              cancelText: options.cancelText || 'Tidak',
              dangerText: options.dangerText || 'Hapus',
              onConfirm: () => resolve('confirm'),
              onCancel: () => resolve('cancel'),
              onDanger: () => resolve('danger'),
              showDanger: true,
              autoClose: false
            });
          });
        }

        // Override alert bawaan
        window.alert = function (message) {
          showModal({
            type: 'warning',
            title: 'Peringatan',
            message: message
          });
        };

        // Override confirm bawaan
        window.confirm = async function (message) {
          return await showConfirm({
            title: 'Konfirmasi',
            message: message
          });
        };

        // ============================================================
        // FUNGSI UTAMA
        // ============================================================

        document.addEventListener('DOMContentLoaded', function () {
          // Search functionality
          const searchInput = document.getElementById('searchInput');
          const sortSelect = document.getElementById('sortSelect');
          const sortDirectionBtn = document.getElementById('sortDirectionBtn');
          let sortAscending = true;

          if (searchInput) {
            searchInput.addEventListener('keyup', filterTable);
          }

          if (sortSelect) {
            sortSelect.addEventListener('change', sortTable);
          }

          if (sortDirectionBtn) {
            sortDirectionBtn.addEventListener('click', function () {
              sortAscending = !sortAscending;
              const icon = this.querySelector('i');
              if (sortAscending) {
                icon.className = 'fas fa-sort-amount-down';
              } else {
                icon.className = 'fas fa-sort-amount-up';
              }
              sortTable();
            });
          }

          function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const rows = document.querySelectorAll('#affiliatesTableBody tr.table-row');

            rows.forEach(row => {
              const name = row.getAttribute('data-name') || '';
              const email = row.getAttribute('data-email') || '';

              if (name.includes(searchTerm) || email.includes(searchTerm)) {
                row.style.display = '';
              } else {
                row.style.display = 'none';
              }
            });

            updateVisibleCount();
          }

          // apply animation-delay values from data-delay attributes
          document.querySelectorAll('[data-delay]').forEach(el => {
            const v = el.getAttribute('data-delay');
            const n = parseFloat(v);
            if (!isNaN(n)) el.style.animationDelay = n + 's';
          });

          // apply width values from data-width
          document.querySelectorAll('[data-width]').forEach(el => {
            const v = el.getAttribute('data-width');
            const n = parseFloat(v);
            el.style.width = (!isNaN(n) ? (Math.min(n, 100) + '%') : '0%');
          });

          function sortTable() {
            const tbody = document.getElementById('affiliatesTableBody');
            const rows = Array.from(document.querySelectorAll('#affiliatesTableBody tr.table-row'));
            const sortBy = sortSelect.value;

            rows.sort((a, b) => {
              let aVal, bVal;

              switch (sortBy) {
                case 'name':
                  aVal = a.getAttribute('data-name') || '';
                  bVal = b.getAttribute('data-name') || '';
                  return sortAscending ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
                case 'total':
                  aVal = parseFloat(a.getAttribute('data-total')) || 0;
                  bVal = parseFloat(b.getAttribute('data-total')) || 0;
                  return sortAscending ? aVal - bVal : bVal - aVal;
                case 'completed':
                  aVal = parseFloat(a.getAttribute('data-completed')) || 0;
                  bVal = parseFloat(b.getAttribute('data-completed')) || 0;
                  return sortAscending ? aVal - bVal : bVal - aVal;
                case 'sales':
                  aVal = parseFloat(a.getAttribute('data-sales')) || 0;
                  bVal = parseFloat(b.getAttribute('data-sales')) || 0;
                  return sortAscending ? aVal - bVal : bVal - aVal;
                case 'rate':
                  aVal = parseFloat(a.getAttribute('data-rate')) || 0;
                  bVal = parseFloat(b.getAttribute('data-rate')) || 0;
                  return sortAscending ? aVal - bVal : bVal - aVal;
                default:
                  return 0;
              }
            });

            // Reorder rows
            rows.forEach(row => tbody.appendChild(row));
          }

          function updateVisibleCount() {
            const visibleRows = document.querySelectorAll('#affiliatesTableBody tr.table-row[style=""]').length;
            const totalRows = document.querySelectorAll('#affiliatesTableBody tr.table-row').length;

            // Update pagination info if needed
            const infoSpan = document.querySelector('.flex.items-center.gap-2 span');
            if (infoSpan) {
              infoSpan.textContent = `Menampilkan ${visibleRows} dari ${totalRows} affiliate`;
            }
          }

          // Add hover effects to table headers
          const tableHeaders = document.querySelectorAll('thead th');
          tableHeaders.forEach(header => {
            header.addEventListener('click', function () {
              const column = this.textContent.trim().toLowerCase();
              let sortValue = '';

              if (column.includes('nama')) sortValue = 'name';
              else if (column.includes('email')) sortValue = 'name';
              else if (column.includes('total transaksi')) sortValue = 'total';
              else if (column.includes('transaksi selesai')) sortValue = 'completed';
              else if (column.includes('total penjualan')) sortValue = 'sales';
              else if (column.includes('success rate')) sortValue = 'rate';

              if (sortValue && sortSelect) {
                sortSelect.value = sortValue;
                sortTable();
              }
            });
          });
        });

        // Export function dengan modal
        async function exportAffiliateData() {
          const confirmed = await showConfirm({
            type: 'question',
            title: 'Konfirmasi Export',
            message: 'Apakah Anda ingin mengekspor data affiliate ke CSV?',
            confirmText: 'Ya, Export',
            cancelText: 'Batal'
          });

          if (!confirmed) return;

          // Get all visible rows
          const rows = document.querySelectorAll('#affiliatesTableBody tr.table-row');

          if (rows.length === 0) {
            await showModal({
              type: 'warning',
              title: 'Tidak Ada Data',
              message: 'Tidak ada data untuk diekspor'
            });
            return;
          }

          // Create CSV content
          let csv = 'Nama,Email,Total Transaksi,Transaksi Selesai,Total Penjualan,Success Rate,Avg Transaction\n';

          rows.forEach(row => {
            const cells = row.querySelectorAll('td');
            const name = cells[0]?.textContent.trim().replace(/,/g, '') || '';
            const email = cells[1]?.textContent.trim().replace(/,/g, '') || '';
            const total = cells[2]?.textContent.trim() || '0';
            const completed = cells[3]?.textContent.trim() || '0';
            const sales = cells[4]?.textContent.trim().replace(/[^0-9,]/g, '') || '0';
            const rate = cells[5]?.textContent.trim() || '0%';
            const avg = cells[6]?.textContent.trim().replace(/[^0-9,]/g, '') || '0';

            csv += `${name},${email},${total},${completed},${sales},${rate},${avg}\n`;
          });

          // Create download link
          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
          const link = document.createElement('a');
          const url = URL.createObjectURL(blob);
          link.setAttribute('href', url);
          link.setAttribute('download', `affiliate_data_${new Date().toISOString().split('T')[0]}.csv`);
          link.style.visibility = 'hidden';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);

          await showModal({
            type: 'success',
            title: 'Berhasil',
            message: 'Data berhasil diekspor!',
            autoClose: true,
            closeTime: 2000
          });
        }

        // Contoh fungsi lain yang menggunakan modal
        async function showAffiliateDetails(affiliateName) {
          await showModal({
            type: 'info',
            title: 'Detail Affiliate',
            message: `Menampilkan detail untuk affiliate: ${affiliateName}`,
            autoClose: true,
            closeTime: 3000
          });
        }

        async function confirmDeleteAffiliate(affiliateName) {
          const result = await showConfirmWithDanger({
            type: 'warning',
            title: 'Hapus Affiliate',
            message: `Apakah Anda yakin ingin menghapus affiliate "${affiliateName}"?\n\nTindakan ini tidak dapat dibatalkan!`,
            confirmText: 'Ya, Hapus',
            cancelText: 'Batal',
            dangerText: 'Hapus Permanen'
          });

          if (result === 'confirm' || result === 'danger') {
            await showModal({
              type: 'success',
              title: 'Berhasil',
              message: `Affiliate "${affiliateName}" telah dihapus`,
              autoClose: true
            });
          }
        }
      </script>
</body>

