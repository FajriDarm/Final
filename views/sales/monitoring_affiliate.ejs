<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitoring Affiliate - Sales Affillink</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-secondary {
      background: linear-gradient(165deg, #047857 0%, #059669 50%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(165deg, #065f46 0%, #047857 50%, #059669 100%);
    }

    .gradient-purple {
      background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
    }

    .gradient-blue {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .gradient-amber {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .gradient-teal {
      background: linear-gradient(165deg, #0d9488 0%, #14b8a6 50%, #2dd4bf 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Badge 3D Effect */
    .badge-3d {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 rgba(0, 0, 0, 0.05);
    }

    .badge-3d:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 6px 0 rgba(0, 0, 0, 0.05);
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Custom Scrollbar */
    .modern-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .modern-scrollbar::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: linear-gradient(145deg, #10b981, #059669);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(145deg, #059669, #047857);
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    /* Glow Text */
    .glow-text {
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.3),
        0 0 20px rgba(16, 185, 129, 0.2);
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Data Cell */
    .data-cell-modern {
      position: relative;
      transition: all 0.4s ease;
    }

    .data-cell-modern::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 3px;
      background: linear-gradient(90deg, #10b981, #059669);
      transition: all 0.4s ease;
      transform: translateX(-50%);
    }

    .data-cell-modern:hover::before {
      width: 100%;
    }

    /* Animations */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white), linear-gradient(135deg, white, white, white);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Table Row Styles */
    .table-row {
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(5px);
    }

    .table-row:hover {
      background: rgba(255, 255, 255, 0.6);
      transform: scale(1.01);
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.15);
    }

    /* Progress Bar Styles */
    .progress-bar {
      height: 0.375rem;
      border-radius: 9999px;
      overflow: hidden;
      background: rgba(229, 231, 235, 0.5);
    }

    .progress-bar-fill {
      height: 100%;
      border-radius: 9999px;
      transition: width 0.3s ease;
    }

    .progress-bar-fill.high {
      background: linear-gradient(90deg, #10b981, #059669);
    }

    .progress-bar-fill.medium {
      background: linear-gradient(90deg, #f59e0b, #d97706);
    }

    .progress-bar-fill.low {
      background: linear-gradient(90deg, #ef4444, #dc2626);
    }

    /* Glitch Effect */
    .glitch-text {
      position: relative;
      animation: glitch 3s infinite;
    }

    @keyframes glitch {

      0%,
      100% {
        transform: translate(0);
      }

      33% {
        transform: translate(-2px, 1px);
      }

      66% {
        transform: translate(2px, -1px);
      }
    }

    /* Modal Styles */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(8px);
      z-index: 99999;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .modal-overlay.show {
      display: flex;
      opacity: 1;
    }

    .modal-content {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 1.5rem;
      padding: 2rem;
      max-width: 400px;
      width: 90%;
      transform: scale(0.9) translateY(20px);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: 0 50px 100px -20px rgba(16, 185, 129, 0.3);
      position: relative;
      overflow: hidden;
    }

    .modal-overlay.show .modal-content {
      transform: scale(1) translateY(0);
    }

    .modal-icon {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      position: relative;
      animation: modalIconPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes modalIconPop {
      0% {
        transform: scale(0);
      }

      100% {
        transform: scale(1);
      }
    }

    .modal-icon.success {
      background: linear-gradient(165deg, #059669, #10b981);
    }

    .modal-icon.warning {
      background: linear-gradient(165deg, #d97706, #f59e0b);
    }

    .modal-icon.error {
      background: linear-gradient(165deg, #b91c1c, #dc2626);
    }

    .modal-icon.info {
      background: linear-gradient(165deg, #2563eb, #3b82f6);
    }

    .modal-icon.question {
      background: linear-gradient(165deg, #7c3aed, #8b5cf6);
    }

    .modal-icon i {
      color: white;
      font-size: 2rem;
      filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
    }

    .modal-title {
      font-size: 1.5rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 0.75rem;
      color: #1f2937;
      animation: modalFadeIn 0.5s ease 0.1s both;
    }

    .modal-message {
      font-size: 1rem;
      color: #4b5563;
      text-align: center;
      margin-bottom: 2rem;
      line-height: 1.5;
      animation: modalFadeIn 0.5s ease 0.2s both;
    }

    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .modal-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      animation: modalFadeIn 0.5s ease 0.3s both;
    }

    .modal-btn {
      padding: 0.875rem 2rem;
      border-radius: 1rem;
      font-size: 0.875rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.3s ease;
      border: none;
      min-width: 120px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .modal-btn-primary {
      background: linear-gradient(165deg, #059669, #10b981);
      color: white;
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
    }

    .modal-btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px -5px rgba(16, 185, 129, 0.5);
    }

    .modal-btn-secondary {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(10px);
      color: #374151;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
    }

    .modal-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: translateY(-3px);
    }

    .modal-btn-danger {
      background: linear-gradient(165deg, #b91c1c, #dc2626);
      color: white;
      box-shadow: 0 10px 20px -5px rgba(239, 68, 68, 0.4);
    }

    .modal-btn-danger:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px -5px rgba(239, 68, 68, 0.5);
    }

    /* Progress Bar for Auto-close */
    .modal-progress {
      height: 4px;
      background: rgba(16, 185, 129, 0.1);
      border-radius: 2px;
      margin-top: 2rem;
      overflow: hidden;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
    }

    .modal-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, #10b981, #34d399);
      width: 100%;
      animation: progress 3s linear forwards;
    }

    @keyframes progress {
      0% {
        width: 100%;
      }

      100% {
        width: 0%;
      }
    }
  </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
  <!-- Ultra Modern Decorative Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
    <div
      class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
    </div>
    <div
      class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
    </div>

    <!-- Animated Grid Lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

    <!-- Floating Particles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
    <div
      class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
    </div>
  </div>

  <!-- Premium Modal System -->
  <div id="premiumModal" class="modal-overlay">
    <div class="modal-content" id="modalContent">
      <div class="modal-icon success" id="modalIcon">
        <i class="fas fa-check" id="modalIconIcon"></i>
      </div>
      <h3 class="modal-title" id="modalTitle">Notifikasi</h3>
      <p class="modal-message" id="modalMessage">Pesan notifikasi akan muncul di sini</p>
      <div class="modal-buttons">
        <button class="modal-btn modal-btn-primary" id="modalConfirmBtn">OK</button>
        <button class="modal-btn modal-btn-secondary" id="modalCancelBtn" style="display: none;">Batal</button>
        <button class="modal-btn modal-btn-danger" id="modalDangerBtn" style="display: none;">Hapus</button>
      </div>
      <div class="modal-progress" id="modalProgress">
        <div class="modal-progress-bar"></div>
      </div>
    </div>
  </div>

  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Sales' }) %>

    <!-- Sidebar -->
    <%- include('../sidebar/sales.ejs') %>

      <!-- Main Content -->
      <main class="ml-64 pt-16 min-h-screen relative z-10">
        <div class="p-6">
          <!-- Premium Page Header - Sesuai dengan dashboard -->
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 animate-slide-in">
            <div class="mb-4 lg:mb-0">
              <div class="flex items-center gap-4">
                <div class="relative">
                  <div
                    class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
                    <i class="fas fa-user-check text-white text-2xl"></i>
                  </div>
                  <div
                    class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                    <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h1
                      class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
                      Monitoring Affiliate
                    </h1>
                    <span
                      class="px-3 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 rounded-lg text-white text-xs font-bold tracking-wider shadow-lg">
                      SALES
                    </span>
                  </div>
                  <p class="text-sm text-emerald-700 font-medium">Analisis dan monitoring performa affiliate sales</p>
                </div>
              </div>
            </div>

            <!-- Premium Date & Live Status -->
            <div class="flex items-center gap-3">
              <div class="neomorph rounded-xl px-4 py-2.5 flex items-center gap-3">
                <div class="w-8 h-8 gradient-secondary rounded-lg flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar-alt text-white text-sm"></i>
                </div>
                <div>
                  <p class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider">Tanggal</p>
                  <p class="text-xs font-bold text-gray-800 whitespace-nowrap">
                    <%= new Date().toLocaleDateString('id-ID', { day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                  </p>
                </div>
              </div>

              <div class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-xl relative shimmer">
                <div class="relative">
                  <i class="fas fa-bell text-white text-sm"></i>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full"></span>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></span>
                </div>
                <div>
                  <p class="text-[10px] text-white/90 font-bold uppercase tracking-wider">Live Status</p>
                  <p class="text-xs font-bold text-white">Updates Real-time</p>
                </div>
              </div>

              <div
                class="px-4 py-2.5 gradient-amber rounded-xl text-white shadow-lg flex items-center gap-2 border border-white/30">
                <i class="fas fa-user-tie"></i>
                <span class="text-xs font-extrabold">Total: <%= affiliates.length || 0 %> Affiliate</span>
              </div>
            </div>
          </div>

          <!-- Premium Stats Cards - Ultra Modern -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-5 mb-7 animate-scale-in">
            <!-- Total Affiliates -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-emerald-400/20 to-green-400/20 rounded-full -mr-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-teal-400/20 to-emerald-400/20 rounded-full -ml-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
