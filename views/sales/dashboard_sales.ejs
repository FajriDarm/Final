<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Sales - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }
    /* gradient-info, gradient-purple, gradient-amber dihapus agar lebih konsisten dengan commissions.ejs */

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Sales' }) %>

    <!-- Sidebar -->
    <%- include('../sidebar/sales.ejs') %>

      <!-- Main Content -->
      <main class="ml-64 pt-16 min-h-screen bg-gradient-to-br from-emerald-50 to-green-50">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-chart-line text-white text-xl"></i>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900">Dashboard Sales</h1>
                  <p class="text-gray-600 mt-1">Selamat datang di panel sales Affillink</p>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                <div class="flex items-center gap-2">
                  <i class="fas fa-calendar-alt text-green-600"></i>
                  <span class="text-sm font-medium text-gray-700">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                      day: 'numeric' }) %>
                  </span>
                </div>
              </div>
              <div class="px-4 py-2 gradient-secondary rounded-lg shadow-lg text-white pulse-animation">
                <div class="flex items-center gap-2">
                  <i class="fas fa-bell pulse-animation"></i>
                  <span class="text-sm font-medium">Update Real-time</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8" id="statsContainer">
            <!-- Total Transactions -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Transaksi</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalTransactions">
                    <%= stats.totalTransactions || 0 %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                      <i class="fas fa-chart-line mr-1"></i>12%
                    </span>
                    <span class="text-xs text-gray-500">dari bulan lalu</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-file-invoice text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">This Month</span>
                  <span class="font-medium text-green-700">
                    <% if (stats.thisMonthTransactions) { %>
                      <%= stats.thisMonthTransactions %>
                        <% } else { %>
                          45
                          <% } %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Completed Transactions -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Transaksi Selesai</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="completedTransactions">
                    <%= stats.completedTransactions || 0 %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                      <i class="fas fa-check-circle mr-1"></i>
                      <% if (stats.totalTransactions> 0) { %>
                        <%= Math.round((stats.completedTransactions / stats.totalTransactions) * 100) %>%
                          <% } else { %>
                            0%
                            <% } %>
                    </span>
                    <span class="text-xs text-gray-500">success rate</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-check-circle text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Pending</span>
                  <span class="font-medium text-green-700">
                    <% if (stats.pendingTransactions) { %>
                      <%= stats.pendingTransactions %>
                        <% } else { %>
                          <%= stats.totalTransactions - stats.completedTransactions %>
                            <% } %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Total Affiliates -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Affiliates</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalAffiliates">
                    <%= stats.totalAffiliates || 0 %>
                  </p>
                  <div id="pendingAffiliatesBadge" class="flex items-center gap-2">
                    <% if (stats.pendingAffiliates && stats.pendingAffiliates> 0) { %>
                      <span
                        class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                        <i class="fas fa-clock"></i>
                        <%= stats.pendingAffiliates %> pending
                      </span>
                      <span class="text-xs text-gray-500">menunggu approval</span>
                      <% } else { %>
                        <span
                          class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                          <i class="fas fa-check"></i>
                          Semua aktif
                        </span>
                        <span class="text-xs text-gray-500">tidak ada pending</span>
                        <% } %>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-user-tie text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Active Now</span>
                  <span class="font-medium text-green-700">18 Affiliates</span>
                </div>
              </div>
            </div>

            <!-- Active Events -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Active Events</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="activeEvents">
                    <%= stats.activeEvents || 0 %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                      <i class="fas fa-play-circle mr-1"></i>Running
                    </span>
                    <span class="text-xs text-gray-500">event aktif</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar-alt text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Upcoming</span>
                  <span class="font-medium text-green-700">
                    <% if (stats.upcomingEvents) { %>
                      <%= stats.upcomingEvents %>
                        <% } else { %>
                          5 Events
                          <% } %>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Transactions Table -->
          <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
            <div class="px-6 py-4 gradient-primary">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-lg font-semibold text-white">Transaksi Terbaru</h2>
                  <p class="text-green-100 text-sm mt-1">10 transaksi terakhir</p>
                </div>
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-exchange-alt text-white"></i>
                </div>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-green-50">
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Customer</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Affiliate</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Amount</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Status</th>
                  </tr>
                </thead>
                <tbody id="transactionsTableBody" class="divide-y divide-green-100">
                  <% if (!recentTransactions || recentTransactions.length===0) { %>
                    <tr style="height:320px;">
                      <td colspan="4" class="py-12 px-6 text-center">
                        <div class="flex flex-col items-center justify-center">
                          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                            <i class="fas fa-inbox text-green-600 text-xl"></i>
                          </div>
                          <p class="text-gray-600 font-medium">Belum ada transaksi</p>
                          <p class="text-sm text-gray-500 mt-2">Transaksi akan muncul di sini</p>
                        </div>
                      </td>
                    </tr>
                    <% } else { %>
                      <% recentTransactions.forEach(function(t, index) { %>
                        <% const statusClass={ 'pending' : 'bg-yellow-100 text-yellow-800 border-yellow-200'
                          , 'completed' : 'bg-green-100 text-green-800 border-green-200' , 'rejected'
                          : 'bg-red-100 text-red-800 border-red-200' , 'processing'
                          : 'bg-blue-100 text-blue-800 border-blue-200' }[t.status]
                          || 'bg-gray-100 text-gray-800 border-gray-200' ; const amount=parseInt(t.total_amount || 0);
                          const isHighValue=amount> 1000000;
                          %>
                          <tr class="hover:bg-green-50 transition-colors data-cell"
                            style="animation-delay: <%= index * 50 %>ms">
                            <td class="py-4 px-6">
                              <div class="flex items-center gap-3">
                                <div
                                  class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                                  <i class="fas fa-user text-green-600"></i>
                                </div>
                                <div>
                                  <div class="font-medium text-gray-900">
                                    <%= t.customer_name || 'Unknown' %>
                                  </div>
                                  <div class="text-xs text-gray-500">Customer</div>
                                </div>
                              </div>
                            </td>
                            <td class="py-4 px-6">
                              <div class="flex items-center gap-3">
                                <div
                                  class="w-10 h-10 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center">
                                  <i class="fas fa-user-tie text-purple-600"></i>
                                </div>
                                <div>
                                  <div class="font-medium text-gray-900">
                                    <%= t.affiliate_name || 'No Affiliate' %>
                                  </div>
                                  <div class="text-xs text-gray-500">Affiliate</div>
                                </div>
                              </div>
                            </td>
                            <td class="py-4 px-6">
                              <div class="flex flex-col">
                                <span class="font-bold <%= isHighValue ? 'text-green-700 text-lg' : 'text-gray-900' %>">
                                  Rp <%= amount.toLocaleString('id-ID') %>
                                </span>
                                <span class="text-xs text-gray-500">
                                  <%= new Date(t.created_at).toLocaleDateString('id-ID') %>
                                </span>
                              </div>
                            </td>
                            <td class="py-4 px-6">
                              <span
                                class="px-3 py-1.5 rounded-full text-xs font-medium border <%= statusClass %> status-badge">
                                <i class="fas fa-circle text-xs mr-1.5"></i>
                                <%= t.status.toUpperCase() %>
                              </span>
                            </td>
                          </tr>
                          <% }); %>
                            <% } %>
                </tbody>
              </table>
            </div>

            <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
                <a href="/sales/transactions"
                  class="text-green-700 hover:text-green-800 font-medium flex items-center gap-2">
                  <i class="fas fa-external-link-alt"></i>
                  Lihat Semua Transaksi
                </a>
                <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
              </div>
            </div>
          </div>
        </div>
      </main>

      <script>
        // Function to animate values
        function animateValue(id, start, end, duration) {
          const obj = document.getElementById(id);
          if (!obj) return;

          let startTimestamp = null;

          const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const value = Math.floor(progress * (end - start) + start);

            obj.textContent = value;

            if (progress < 1) {
              window.requestAnimationFrame(step);
            }
          };

          window.requestAnimationFrame(step);
        }

        // Function to load dashboard stats (if using AJAX)
        async function loadDashboardStats() {
          try {
            const response = await fetch('/api/sales/dashboard/stats');
            const data = await response.json();

            if (data.success) {
              // Update stats with animation
              animateValue('totalTransactions', 0, data.stats.totalTransactions, 1000);
              animateValue('completedTransactions', 0, data.stats.completedTransactions, 1000);
              animateValue('totalAffiliates', 0, data.stats.totalAffiliates, 1000);
              animateValue('activeEvents', 0, data.stats.activeEvents, 1000);

              // Update pending affiliates badge
              const pendingBadge = document.getElementById('pendingAffiliatesBadge');
              if (data.stats.pendingAffiliates > 0) {
                pendingBadge.innerHTML = `
              <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                <i class="fas fa-clock"></i>
                ${data.stats.pendingAffiliates} pending
              </span>
              <span class="text-xs text-gray-500">menunggu approval</span>
            `;
              } else {
                pendingBadge.innerHTML = `
              <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                <i class="fas fa-check"></i>
                Semua aktif
              </span>
              <span class="text-xs text-gray-500">tidak ada pending</span>
            `;
              }
            }
          } catch (error) {
            console.error('Error loading dashboard stats:', error);
            showError('Gagal memuat data dashboard');
          }
        }

        function showError(message) {
          const statsContainer = document.getElementById('statsContainer');
          const errorDiv = document.createElement('div');
          errorDiv.className = 'col-span-4';
          errorDiv.innerHTML = `
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
              <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <div>
              <p class="text-red-700 font-medium">${message}</p>
              <p class="text-red-600 text-sm mt-1">Coba refresh halaman atau hubungi support</p>
            </div>
          </div>
        </div>
      `;
          statsContainer.insertBefore(errorDiv, statsContainer.firstChild);
        }

        // Load stats on page load
        document.addEventListener('DOMContentLoaded', () => {
          // Add animation to status badges
          const statusBadges = document.querySelectorAll('.status-badge');
          statusBadges.forEach(badge => {
            badge.addEventListener('mouseenter', function () {
              this.style.transform = 'scale(1.05)';
            });
            badge.addEventListener('mouseleave', function () {
              this.style.transform = 'scale(1)';
            });
          });

          // Uncomment below if using AJAX for stats
          // loadDashboardStats();

          // Auto-refresh every 30 seconds (if using AJAX)
          // setInterval(loadDashboardStats, 30000);
        });
      </script>
</body>

</html>