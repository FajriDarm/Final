<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verifikasi Tahap 1 - Sales Affillink</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
        /* Animasi bounce untuk icon modal */
        @keyframes bounce {
          0%, 100% { transform: translateY(0); }
          20% { transform: translateY(-12px); }
          40% { transform: translateY(-24px); }
          60% { transform: translateY(-12px); }
          80% { transform: translateY(-6px); }
        }
        .animate-bounce {
          animation: bounce 1s cubic-bezier(.28,.84,.42,1) both;
        }
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }
    .gradient-secondary {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }
    .gradient-accent {
      background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }

    .gradient-info {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    }

    .gradient-purple {
      background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    }

    .gradient-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-danger {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Sales' }) %>

    <!-- Sidebar -->
    <%- include('../sidebar/sales.ejs') %>

      <!-- Main Content -->
      <main class="ml-64 pt-16 min-h-screen">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-clipboard-check text-white text-xl"></i>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900">Verifikasi Tahap 1</h1>
                  <p class="text-gray-600 mt-1">Sales Intent Verification - Review dan verifikasi transaksi</p>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                <div class="flex items-center gap-2">
                  <i class="fas fa-calendar-alt text-green-600"></i>
                  <span class="text-sm font-medium text-gray-700">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                      day: 'numeric' }) %>
                  </span>
                </div>
              </div>
              <div class="px-4 py-2 gradient-secondary rounded-lg shadow-lg text-white pulse-animation">
                <div class="flex items-center gap-2">
                  <i class="fas fa-exclamation-circle"></i>
                  <span class="text-sm font-medium">Pending: <%= transactions.length || 0 %> Transaksi</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <!-- Total Pending -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Pending</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2">
                    <%= transactions.length || 0 %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500">menunggu verifikasi</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-clipboard-check text-white text-2xl"></i>
                </div>
              </div>
            </div>

            <!-- Total Amount -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Amount</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2">
                    Rp <% let totalAmount=0; if (transactions && transactions.length> 0) {
                      transactions.forEach(trx => {
                      totalAmount += parseFloat(trx.total_amount) || 0;
                      });
                      }
                      %>
                      <%= totalAmount.toLocaleString('id-ID') %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500">nilai transaksi pending</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-money-bill-wave text-white text-2xl"></i>
                </div>
              </div>
            </div>

            <!-- Total Commission -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Commission</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2">
                    Rp <% let totalCommission=0; if (transactions && transactions.length> 0) {
                      transactions.forEach(trx => {
                      if (trx.projected_commission) {
                      totalCommission += parseFloat(trx.projected_commission);
                      }
                      });
                      }
                      %>
                      <%= totalCommission.toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2
                        }) %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500">total komisi projected</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-percentage text-white text-2xl"></i>
                </div>
              </div>
            </div>

            <!-- Avg. Pending Time -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Avg. Pending Time</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2">
                    <% let totalHours=0; if (transactions && transactions.length> 0) {
                      const now = new Date();
                      transactions.forEach(trx => {
                      const created = new Date(trx.created_at);
                      const diffHours = (now - created) / (1000 * 60 * 60);
                      totalHours += diffHours;
                      });
                      const avgHours = totalHours / transactions.length;
                      %>
                      <%= avgHours.toFixed(1) %> jam
                        <% } else { %>
                          0 jam
                          <% } %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500">rata-rata pending</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-hourglass-half text-white text-2xl"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Verification Table -->
          <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
            <div class="px-6 py-4 gradient-primary">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-lg font-semibold text-white">Verifikasi Tahap 1 - Sales Intent</h2>
                  <p class="text-green-100 text-sm mt-1">Review dan approve/reject transaksi tahap pertama</p>
                </div>
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                  <i class="fas fa-user-check text-white"></i>
                </div>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-green-50">
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">ID</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Customer</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Affiliate</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Amount</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Komisi</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Status</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Aksi</th>
                  </tr>
                </thead>
                <tbody id="verificationTableBody" class="divide-y divide-green-100">
                  <% if (!transactions || transactions.length===0) { %>
                    <tr style="height:320px;">
                      <td colspan="7" class="py-12 px-6 text-center">
                        <div class="flex flex-col items-center justify-center">
                          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                            <i class="fas fa-check-circle text-green-600 text-xl"></i>
                          </div>
                          <p class="text-gray-600 font-medium">Tidak ada transaksi pending</p>
                          <p class="text-sm text-gray-500 mt-2">Semua transaksi telah diverifikasi</p>
                        </div>
                      </td>
                    </tr>
                    <% } else { %>
                      <% transactions.forEach(function(trx, index) { %>
                        <tr class="hover:bg-green-50 transition-colors data-cell"
                          style="animation-delay: <%= index * 50 %>ms">
                          <td class="py-4 px-6">
                            <div class="flex flex-col">
                              <span class="font-medium text-gray-900">#<%= trx.id %></span>
                              <span class="text-xs text-gray-500">Transaction</span>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-3">
                              <div
                                class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-user text-green-600"></i>
                              </div>
                              <div>
                                <div class="font-medium text-gray-900">
                                  <%= trx.customer_name || '-' %>
                                </div>
                                <div class="text-xs text-gray-500">Customer</div>
                              </div>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-3">
                              <% if (trx.affiliate_name && trx.affiliate_name !=='-' ) { %>
                                <div
                                  class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                                  <i class="fas fa-user-tie text-green-600"></i>
                                </div>
                                <div>
                                  <div class="font-medium text-gray-900">
                                    <%= trx.affiliate_name %>
                                  </div>
                                  <div class="text-xs text-gray-500">Affiliate</div>
                                </div>
                                <% } else { %>
                                  <div
                                    class="w-10 h-10 bg-gradient-to-br from-gray-100 to-gray-200 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-times text-gray-500"></i>
                                  </div>
                                  <div>
                                    <div class="font-medium text-gray-400">No Affiliate</div>
                                    <div class="text-xs text-gray-500">Direct Sale</div>
                                  </div>
                                  <% } %>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex flex-col">
                              <% const amount=parseInt(trx.total_amount || 0); const isHighValue=amount> 1000000;
                                %>
                                <span class="font-bold <%= isHighValue ? 'text-green-700 text-lg' : 'text-gray-900' %>">
                                  Rp <%= amount.toLocaleString('id-ID') %>
                                </span>
                                <span class="text-xs text-gray-500">Total Amount</span>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex flex-col">
                              <% if (typeof trx.projected_commission !=='undefined' && trx.projected_commission !==null)
                                { %>
                                <span class="font-medium text-green-700">
                                  Rp <%= parseFloat(trx.projected_commission).toLocaleString('id-ID', {
                                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </span>
                                <span class="text-xs text-gray-500">Projected Commission</span>
                                <% } else { %>
                                  <div class="flex items-center justify-center">
                                    <span class="text-gray-400 italic">-</span>
                                  </div>
                                  <% } %>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <% const statusClass={ 'pending' : 'bg-yellow-100 text-yellow-800 border-yellow-200'
                              , 'approved' : 'bg-green-100 text-green-800 border-green-200' , 'rejected'
                              : 'bg-red-100 text-red-800 border-red-200' }[trx.status]
                              || 'bg-gray-100 text-gray-800 border-gray-200' ; const statusIcon={ 'pending' : 'fa-clock'
                              , 'approved' : 'fa-check-circle' , 'rejected' : 'fa-times-circle' }[trx.status]
                              || 'fa-question-circle' ; %>
                              <span
                                class="px-3 py-1.5 rounded-full text-xs font-medium border <%= statusClass %> status-badge">
                                <i class="fas <%= statusIcon %> text-xs mr-1.5"></i>
                                <%= trx.status.toUpperCase() %>
                              </span>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-2">
                              <form class="flex-1 approve-form" data-id="<%= trx.id %>">
                                <button type="submit" name="action" value="approve"
                                  class="w-full px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium transition-all flex items-center justify-center gap-2 approve-btn">
                                  <i class="fas fa-check-circle"></i>
                                  Approve
                                </button>
                              </form>
                              <form class="flex-1 reject-form" data-id="<%= trx.id %>">
                                <button type="submit" name="action" value="reject"
                                  class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-all flex items-center justify-center gap-2 reject-btn">
                                  <i class="fas fa-times-circle"></i>
                                  Reject
                                </button>
                              </form>
                            </div>
                          </td>
                        </tr>
                        <% }); %>
                          <% } %>
                </tbody>
              </table>
            </div>

            <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
              <div class="flex items-center gap-4 justify-between text-sm">
                <span class="text-gray-600">
                  Menampilkan <span class="font-medium">
                    <%= transactions.length || 0 %>
                  </span> transaksi pending
                </span>
                <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- Modal Konfirmasi Approve/Reject -->
      <div id="confirmModal" style="display:none;" class="fixed inset-0 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 flex flex-col items-center text-center max-w-md w-full animate-fadeIn">
          <div class="mb-4">
            <i class="fas fa-question-circle text-green-500 text-5xl animate-bounce"></i>
          </div>
          <h2 id="confirmModalTitle" class="text-xl font-bold text-gray-900 mb-2">Konfirmasi</h2>
          <p id="confirmModalMsg" class="text-gray-600 mb-4">Apakah Anda yakin?</p>
          <p id="confirmModalNote" class="text-xs text-gray-400 mb-6" style="display:none;">Pastikan Anda telah melakukan verifikasi yang teliti.</p>
          <div class="flex gap-4 w-full">
            <button id="confirmModalYes" class="flex-1 bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-green-700 hover:to-emerald-700 transition-all duration-200">OK</button>
            <button id="confirmModalNo" class="flex-1 bg-gray-200 text-gray-700 py-3.5 px-6 rounded-xl font-medium hover:bg-gray-300 transition-all duration-200">Cancel</button>
          </div>
        </div>
        <style>
          @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
          }
          .animate-fadeIn { animation: fadeIn 0.2s ease; }
        </style>
      </div>

      <!-- Modal Sukses Approve -->
      <div id="successApproveModal" style="display:none;" class="fixed inset-0 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 flex flex-col items-center text-center max-w-md w-full animate-fadeIn">
          <div class="mb-4">
            <span class="success-checkmark-bg">
              <svg class="success-checkmark-svg" width="48" height="48" viewBox="0 0 48 48">
                <circle cx="24" cy="24" r="22" fill="none" stroke="#10b981" stroke-width="4" opacity="0.15" />
                <path class="success-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">Sukses</h2>
          <p class="text-gray-600 mb-6" id="successApproveMsg">Transaksi berhasil di-approve!</p>
          <button class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-green-700 hover:to-emerald-700 transition-all duration-200" onclick="document.getElementById('successApproveModal').style.display='none'">Tutup</button>
        </div>
        <style>
          @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
          }
          .animate-fadeIn { animation: fadeIn 0.2s ease; }
          .success-checkmark-bg {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border-radius: 50%;
            box-shadow: 0 4px 24px 0 rgba(16,185,129,0.15);
            position: relative;
            overflow: hidden;
          }
          .success-checkmark-svg {
            display: block;
          }
          .success-checkmark-path {
            stroke-dasharray: 40;
            stroke-dashoffset: 40;
            animation: checkmark-draw 1.1s cubic-bezier(.28,.84,.42,1) 0.15s forwards;
          }
          @keyframes checkmark-draw {
            to {
              stroke-dashoffset: 0;
            }
          }
        </style>
      </div>

      <script>
        // Show modal sukses approve
        function showSuccessModal(message) {
          document.getElementById('successApproveMsg').textContent = message || 'Transaksi berhasil di-approve!';
          document.getElementById('successApproveModal').style.display = 'flex';
        }
                // Notifikasi error jika backend gagal
                if (window.location.search.includes('error=1')) {
                  setTimeout(function() {
                    const modal = document.createElement('div');
                    modal.className = 'fixed inset-0 flex items-center justify-center z-50 p-4';
                    modal.innerHTML = `
                      <div class="bg-white rounded-2xl shadow-2xl p-8 flex flex-col items-center text-center max-w-md w-full animate-fadeIn">
                        <div class="mb-4">
                          <i class="fas fa-times-circle text-red-500 text-5xl animate-bounce"></i>
                        </div>
                        <h2 class="text-xl font-bold text-gray-900 mb-2">Gagal</h2>
                        <p class="text-gray-600 mb-6">Gagal memproses verifikasi. Silakan coba lagi.</p>
                        <button class="w-full bg-gradient-to-r from-red-600 to-rose-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-red-700 hover:to-rose-700 transition-all duration-200" onclick="this.closest('.fixed').remove()">Tutup</button>
                      </div>
                    `;
                    document.body.appendChild(modal);
                  }, 300);
                }
        document.addEventListener('DOMContentLoaded', function () {
          // Add animation to status badges
          const statusBadges = document.querySelectorAll('.status-badge');
          statusBadges.forEach(badge => {
            badge.addEventListener('mouseenter', function () {
              this.style.transform = 'scale(1.05)';
            });
            badge.addEventListener('mouseleave', function () {
              this.style.transform = 'scale(1)';
            });
          });

          // Add loading animation to buttons
          const forms = document.querySelectorAll('form');
          // Hanya form yang bukan approve/reject yang langsung animasi processing
          forms.forEach(form => {
            if (!form.classList.contains('approve-form') && !form.classList.contains('reject-form')) {
              form.addEventListener('submit', function (e) {
                const button = this.querySelector('button[type="submit"]');
                if (button) {
                  button.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
                  button.disabled = true;
                  button.classList.add('opacity-50');
                }
              });
            }
          });

          // Custom modal confirmation for approve/reject
          document.querySelectorAll('.approve-form').forEach(form => {
            form.addEventListener('submit', function(e) {
              e.preventDefault();
              showConfirmModal('approve', () => {
                const button = form.querySelector('button[type="submit"]');
                if (button) {
                  button.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
                  button.disabled = true;
                  button.classList.add('opacity-50');
                }
                const id = form.getAttribute('data-id');
                fetch('/sales/verify-stage1', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body: `id=${encodeURIComponent(id)}&action=approve`
                })
                .then(res => {
                  if (res.ok) {
                    // Hapus baris dari tabel
                    const row = form.closest('tr');
                    if (row) row.remove();
                    showSuccessModal('Transaksi berhasil di-approve!');
                  } else {
                    showSuccessModal('Gagal approve transaksi!');
                  }
                })
                .catch(() => showSuccessModal('Gagal approve transaksi!'));
              });
            });
          });
          document.querySelectorAll('.reject-form').forEach(form => {
            form.addEventListener('submit', function(e) {
              e.preventDefault();
              showConfirmModal('reject', () => {
                const button = form.querySelector('button[type="submit"]');
                if (button) {
                  button.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
                  button.disabled = true;
                  button.classList.add('opacity-50');
                }
                const id = form.getAttribute('data-id');
                fetch('/sales/verify-stage1', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body: `id=${encodeURIComponent(id)}&action=reject`
                })
                .then(res => {
                  if (res.ok) {
                    // Hapus baris dari tabel
                    const row = form.closest('tr');
                    if (row) row.remove();
                    showSuccessModal('Transaksi berhasil di-reject!');
                  } else {
                    showSuccessModal('Gagal reject transaksi!');
                  }
                })
                .catch(() => showSuccessModal('Gagal reject transaksi!'));
              });
            });
          });
        });

        // Modal konfirmasi dinamis
        function showConfirmModal(action, onConfirm) {
          const modal = document.getElementById('confirmModal');
          const title = document.getElementById('confirmModalTitle');
          const msg = document.getElementById('confirmModalMsg');
          const note = document.getElementById('confirmModalNote');
          const yesBtn = document.getElementById('confirmModalYes');
          const noBtn = document.getElementById('confirmModalNo');
          if (action === 'approve') {
            title.textContent = 'Konfirmasi';
            msg.textContent = 'Apakah Anda yakin ingin APPROVE transaksi ini?';
            note.style.display = 'none';
          } else if (action === 'reject') {
            title.textContent = 'Konfirmasi';
            msg.textContent = 'Apakah Anda yakin ingin REJECT transaksi ini?';
            note.style.display = 'block';
          } else {
            title.textContent = 'Konfirmasi';
            msg.textContent = 'Apakah Anda yakin ingin melakukan aksi ini?';
            note.style.display = 'none';
          }
          modal.style.display = 'flex';
          // Remove previous listeners
          yesBtn.onclick = null;
          noBtn.onclick = null;
          yesBtn.onclick = function() {
            modal.style.display = 'none';
            if (typeof onConfirm === 'function') onConfirm();
          };
          noBtn.onclick = function() {
            modal.style.display = 'none';
          };
        }
      </script>
</body>

</html>