<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verifikasi Tahap 1 - Sales</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Sales' }) %>
  <!-- Sidebar -->
  <%- include('../sidebar/sales.ejs') %>
  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <h2 class="text-2xl font-bold mb-4">Verifikasi Tahap 1 (Sales - Intent)</h2>
      <div class="overflow-x-auto">
        <table class="table-auto w-full border">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-2">ID</th>
              <th class="px-4 py-2">Customer</th>
              <th class="px-4 py-2">Affiliate</th>
              <th class="px-4 py-2">Amount</th>
              <th class="px-4 py-2">Status</th>
              <th class="px-4 py-2">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(function(trx) { %>
              <tr class="border-b">
                <td class="px-4 py-2"><%= trx.id %></td>
                <td class="px-4 py-2"><%= trx.customer_name || '-' %></td>
                <td class="px-4 py-2"><%= trx.affiliate_name || '-' %></td>
                <td class="px-4 py-2">Rp <%= parseInt(trx.total_amount || 0).toLocaleString('id-ID') %></td>
                <td class="px-4 py-2"><%= trx.status %></td>
                <td class="px-4 py-2">
                  <form method="POST" action="/sales/verify-stage1" class="inline">
                    <input type="hidden" name="id" value="<%= trx.id %>">
                    <button type="submit" name="action" value="approve" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded mr-1"><i class="fas fa-check"></i> Approve</button>
                    <button type="submit" name="action" value="reject" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded"><i class="fas fa-times"></i> Reject</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
