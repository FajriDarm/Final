                          Jumlah</th>
                        <th class="py-3 px-4 text-xs font-extrabold text-emerald-900 uppercase tracking-wider">
                          Status</th>
                        <th class="py-3 px-4 text-xs font-extrabold text-emerald-900 uppercase tracking-wider">
                          Tanggal</th>
                        <th class="py-3 px-4 text-xs font-extrabold text-emerald-900 uppercase tracking-wider">Aksi
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/30 bg-white/20 backdrop-blur">
                      <% if (!recentDepartures || recentDepartures.length===0) { %>
                        <tr class="placeholder-row">
                          <td colspan="8" class="py-12 px-4 text-center">
                            <div class="flex flex-col items-center justify-center">
                              <div class="relative">
                                <div
                                  class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                                  <i class="fas fa-history text-3xl text-emerald-300"></i>
                                </div>
                                <div
                                  class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                                  <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                                </div>
                              </div>
                              <p class="text-lg font-extrabold text-gray-900 mb-2">Tidak ada riwayat</p>
                              <p class="text-sm text-emerald-700 font-medium">Riwayat akan muncul di sini</p>
                            </div>
                          </td>
                        </tr>
                        <% } else { %>
                          <% recentDepartures.forEach(function(r){ %>
                            <tr class="table-row history-row" data-id="<%= r.id %>">
                              <td class="p-3"><span class="font-extrabold text-sm text-gray-900">#<%= r.id %></span>
                              </td>
                              <td class="p-3">
                                <div class="flex items-center gap-2">
                                  <div
                                    class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                                    <i class="fas fa-user text-emerald-600 text-sm"></i>
                                  </div>
                                  <span class="font-medium text-sm text-gray-900">
                                    <%= r.customer_name || '-' %>
                                  </span>
                                </div>
                              </td>
                              <td class="p-3">
                                <div class="flex items-center gap-2">
                                  <div
                                    class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                                    <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                                  </div>
                                  <span class="font-medium text-sm text-gray-900">
                                    <%= r.affiliate_name || '-' %>
                                  </span>
                                </div>
                              </td>
                              <td class="p-3"><span class="text-sm text-gray-900">
                                  <%= r.event_name || '-' %>
                                </span></td>
                              <td class="p-3">
                                <span class="font-extrabold text-sm text-gray-900">
                                  Rp <%= (parseFloat(r.total_amount)||0).toLocaleString('id-ID') %>
                                </span>
                              </td>
                              <td class="p-3"><span class="text-sm text-gray-600">
                                  <%= r.status || '-' %>
                                </span></td>
                              <td class="p-3"><span class="text-sm text-gray-600">
                                  <%= new Date(r.updated_at).toLocaleString() %>
                                </span></td>
                              <td class="p-3">
                                <select class="history-status-select mb-2">
                                  <option value="">-- pilih status --</option>
                                  <option value="LEAD BARU">LEAD BARU</option>
                                  <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                                  <option value="HOT">HOT</option>
                                  <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                                </select>
                                <button class="history-restore-btn btn-primary text-sm w-full">
                                  <i class="fas fa-undo-alt mr-1"></i>
                                  Restore
                                </button>
                              </td>
                            </tr>
                            <% }) %>
                              <% } %>
                    </tbody>
                  </table>
                </div>

                <div class="flex items-center justify-between mt-4">
                  <div id="historyPagination" class="flex items-center gap-2"></div>
                  <div
                    class="text-xs font-medium text-gray-500 bg-white/60 px-3 py-2 rounded-lg border border-white/60">
                    Total: <span id="historyTotal" class="font-extrabold text-emerald-700">0</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>

        <!-- Undo Toast Premium (Hidden - using modal instead) -->
        <div id="undoToast" style="display: none !important;"></div>

        <script>
          // ============================================================
          // FUNGSI MODAL
          // ============================================================

          const Modal = {
            element: document.getElementById('premiumModal'),
            icon: document.getElementById('modalIcon'),
            iconIcon: document.getElementById('modalIconIcon'),
            title: document.getElementById('modalTitle'),
            message: document.getElementById('modalMessage'),
            confirmBtn: document.getElementById('modalConfirmBtn'),
            cancelBtn: document.getElementById('modalCancelBtn'),
            progress: document.getElementById('modalProgress'),

            show: function (options) {
              const {
                type = 'info',
                title,
                message,
                onConfirm,
                onCancel,
                confirmText = 'OK',
                cancelText = 'Batal',
                autoClose = true,
                closeTime = 3000
              } = options;

              // Reset classes
              this.icon.className = 'modal-icon';
              this.icon.classList.add(type);

              // Set icon berdasarkan type
              const icons = {
                success: 'fa-check',
                warning: 'fa-exclamation-triangle',
                error: 'fa-times-circle',
                info: 'fa-info-circle',
                question: 'fa-question-circle'
              };
              this.iconIcon.className = `fas ${icons[type] || 'fa-info-circle'} text-white text-2xl`;

              // Set content
              this.title.textContent = title || 'Notifikasi';
              this.message.textContent = message || '';

              // Show modal
              this.element.classList.add('show');

              // Handle buttons
              if (onConfirm) {
                this.confirmBtn.style.display = 'block';
                this.confirmBtn.textContent = confirmText;
                this.confirmBtn.onclick = () => {
                  this.hide();
                  onConfirm();
                };
              } else {
                this.confirmBtn.style.display = 'block';
                this.confirmBtn.textContent = 'OK';
                this.confirmBtn.onclick = () => this.hide();
              }

              if (onCancel) {
                this.cancelBtn.style.display = 'block';
                this.cancelBtn.textContent = cancelText;
                this.cancelBtn.onclick = () => {
                  this.hide();
                  onCancel();
                };
              } else {
                this.cancelBtn.style.display = 'none';
              }

              // Auto close
              if (autoClose) {
                this.progress.style.display = 'block';
                const progressBar = this.progress.querySelector('.modal-progress-bar');
                progressBar.style.animation = 'none';
                progressBar.offsetHeight;
                progressBar.style.animation = `progress ${closeTime / 1000}s linear forwards`;

                setTimeout(() => {
                  this.hide();
                }, closeTime);
              } else {
                this.progress.style.display = 'none';
              }
            },

            hide: function () {
              this.element.classList.remove('show');
            }
          };

          // Fungsi untuk menampilkan modal
          function showModal(options) {
            Modal.show(options);
          }

          // Fungsi untuk konfirmasi (Promise-based)
          function showConfirm(options) {
            return new Promise((resolve) => {
              Modal.show({
                type: options.type || 'question',
                title: options.title || 'Konfirmasi',
                message: options.message,
                confirmText: options.confirmText || 'Ya',
                cancelText: options.cancelText || 'Tidak',
                onConfirm: () => resolve(true),
                onCancel: () => resolve(false),
                autoClose: false
              });
            });
          }

          // Override alert bawaan
          window.alert = function (message) {
            showModal({
              type: 'warning',
              title: 'Peringatan',
              message: message
            });
          };

          // ============================================================
          // FUNGSI UTAMA
          // ============================================================

          // Tab handling
          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function () {
              document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('tab-active');
                b.classList.add('tab-inactive');
              });
              this.classList.add('tab-active');
              this.classList.remove('tab-inactive');
              const tab = this.dataset.tab;
              document.getElementById('tab-leads').classList.toggle('hidden', tab !== 'leads');
              document.getElementById('tab-history').classList.toggle('hidden', tab !== 'history');
            });
          });

          // Setup lead-status selects with conditional Save/Reject UI and regression guard
          const getStageLevel = (s) => {
            if (!s) return 0;
            s = s.toString().toUpperCase();
            if (s === 'SEDANG BERANGKAT') return 3;
            if (['LUNAS', 'DP', 'HOT'].includes(s)) return 2;
            if (['LEAD BARU', 'SEDANG DI PROSPEK'].includes(s)) return 1;
            return 0;
          };

          function hideActions(rowId) {
            const area = document.querySelector('.action-area[data-id="' + rowId + '"]');
            if (!area) return;
            area.querySelectorAll('.save-btn, .reject-btn').forEach(b => b.classList.add('hidden'));
          }

          function showActions(rowId) {
            const area = document.querySelector('.action-area[data-id="' + rowId + '"]');
            if (!area) return;
            area.querySelectorAll('.save-btn, .reject-btn').forEach(b => b.classList.remove('hidden'));
          }

          // Delegated change handler for dynamically inserted selects
          document.addEventListener('change', async function (e) {
            const sel = e.target;
            if (!sel || !sel.matches('.lead-status-select')) return;
            const id = sel.dataset.id;
            const val = sel.value;
            if (!val) return;

            // store prev if missing
            if (!sel.dataset.prev) sel.dataset.prev = '';
            const statusEl = sel.closest('td').querySelector('.text-gray-500');
            const currentDbStatus = statusEl ? statusEl.textContent.replace('Status DB:', '').trim() : (sel.dataset.prev || '');
            const curLevel = getStageLevel(currentDbStatus);
            const targetLevel = getStageLevel(val);

            // Lead Baru can only progress up to HOT
            if (currentDbStatus === 'LEAD BARU' && ['DP', 'LUNAS', 'SEDANG BERANGKAT'].includes(val)) {
              await showModal({
                type: 'warning',
                title: 'Tidak Diizinkan',
                message: 'Lead baru hanya boleh diubah sampai status HOT.'
              });
              sel.value = sel.dataset.prev || 'LEAD BARU';
              return;
            }

            // LUNAS from Finance can only move to SEDANG BERANGKAT
            if (currentDbStatus === 'LUNAS' && val !== 'SEDANG BERANGKAT') {
              await showModal({
                type: 'warning',
                title: 'Tidak Diizinkan',
                message: 'Status LUNAS hanya dapat diubah menjadi SEDANG BERANGKAT.'
              });
              sel.value = sel.dataset.prev || 'LUNAS';
              return;
            }

            // Prevent downgrading to an earlier/lower stage
            if (curLevel > targetLevel) {
              await showModal({
                type: 'warning',
                title: 'Tidak Diizinkan',
                message: 'Tidak diperbolehkan menurunkan status ke tahap sebelumnya.'
              });
              sel.value = sel.dataset.prev || '';
              return;
            }

            // If user selected SEDANG BERANGKAT, show Save/Reject buttons instead of auto-saving
            if (val === 'SEDANG BERANGKAT') {
              showActions(id);
              return;
            }

            // Otherwise auto-save like before and update DB time
            try {
              const resp = await fetch('/sales/update-lead-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(val)}`
              });
              const json = await resp.json();

              if (json && json.success) {
                const prev = sel.closest('td').querySelector('.text-gray-500');
                if (prev) prev.textContent = 'Status DB: ' + val;
                const timeCell = sel.closest('tr').querySelector('td:nth-child(8)');
                if (timeCell) {
                  timeCell.textContent = json.updated_at ? new Date(json.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
                }
                sel.dataset.prev = val;
                updateStats();

                await showModal({
                  type: 'success',
                  title: 'Berhasil',
                  message: 'Status lead berhasil diperbarui',
                  autoClose: true
                });
              } else {
                await showModal({
                  type: 'error',
                  title: 'Gagal',
                  message: 'Gagal menyimpan status'
                });
                sel.value = sel.dataset.prev || '';
              }
            } catch (err) {
              console.error(err);
              await showModal({
                type: 'error',
                title: 'Error',
                message: 'Gagal menyimpan status'
              });
              sel.value = sel.dataset.prev || '';
            }
          });

          // Delegate clicks for save/reject buttons
          document.addEventListener('click', async function (e) {
            if (e.target.matches('.save-btn')) {
              const area = e.target.closest('.action-area');
              const id = area.dataset.id;
              const select = document.querySelector('.lead-status-select[data-id="' + id + '"]');
              const val = select.value;

              if (!val) return;

              // KONFIRMASI KHUSUS UNTUK STATUS SEDANG BERANGKAT
              if (val === 'SEDANG BERANGKAT') {
                const confirmed = await showConfirm({
                  type: 'warning',
                  title: 'Konfirmasi Status Berangkat',
                  message: 'Apakah Anda yakin ingin menandai lead ini sebagai SEDANG BERANGKAT?\n\nLead akan dipindahkan ke tab Riwayat dan tidak dapat diubah kembali ke status sebelumnya tanpa melalui proses Restore.',
                  confirmText: 'Ya, Berangkat',
                  cancelText: 'Batal'
                });

                if (!confirmed) {
                  // Batal, kembalikan ke status sebelumnya
                  select.value = select.dataset.prev || '';
                  area.querySelectorAll('.save-btn, .reject-btn').forEach(b => b.classList.add('hidden'));
                  return;
                }
              }

              try {
                const resp = await fetch('/sales/update-lead-status', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(val)}`
                });
                const j = await resp.json();

                if (j && j.success) {
                  const prev = select.closest('td').querySelector('.text-gray-500');
                  if (prev) prev.textContent = 'Status DB: ' + (j.status || val);
                  const prevStatus = select.dataset.prev || '';
                  select.dataset.prev = j.status || val;

                  const timeCell = select.closest('tr').querySelector('td:nth-child(8)');
                  if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');

                  area.querySelectorAll('.save-btn, .reject-btn').forEach(b => b.classList.add('hidden'));

                  if (prevStatus === 'LEAD BARU' && (j.status || val) !== 'LEAD BARU') {
                    const row = select.closest('tr');
                    row.classList.remove('new-lead-row');
                    const badge = row.querySelector('.pulse-badge');
                    if (badge) badge.remove();
                    updateNewLeadsCount(-1);
                  } else if (prevStatus !== 'LEAD BARU' && (j.status || val) === 'LEAD BARU') {
                    const row = select.closest('tr');
                    row.classList.add('new-lead-row');
                    updateNewLeadsCount(1);
                  }

                  // If status becomes SEDANG BERANGKAT, move the row into History tab
                  if ((j.status || val) === 'SEDANG BERANGKAT') {
                    try {
                      const row = select.closest('tr');
                      const leadsTbody = document.querySelector('#leadsTable tbody');
                      if (row && leadsTbody) row.remove();

                      const histTbody = document.querySelector('#historyTable tbody');
                      if (histTbody) {
                        const existing = histTbody.querySelector('tr.history-row[data-id="' + id + '"]');
                        if (existing) {
                          try {
                            const amt = existing.querySelector('td:nth-child(5) .font-extrabold');
                            if (amt && (j.total_amount !== undefined && j.total_amount !== null)) amt.textContent = 'Rp ' + ((Number(j.total_amount) || 0).toLocaleString('id-ID'));
                            const statusCell = existing.querySelector('td:nth-child(6) span');
                            if (statusCell) statusCell.textContent = 'SEDANG BERANGKAT';
                            const timeCell = existing.querySelector('td:nth-child(7) span');
                            if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
                            const sel = existing.querySelector('.history-status-select');
                            if (sel) sel.value = 'SEDANG BERANGKAT';
                          } catch (err) { console.error('update existing history on move error', err); }
                        } else {
                          const tr = document.createElement('tr');
                          tr.className = 'table-row history-row';
                          tr.setAttribute('data-id', id);
                          tr.innerHTML = `
                            <td class="p-3"><span class="font-extrabold text-sm text-gray-900">#${id}</span></td>
                            <td class="p-3">
                              <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                                  <i class="fas fa-user text-emerald-600 text-sm"></i>
                                </div>
                                <span class="font-medium text-sm text-gray-900">${j.customer_name || '-'}</span>
                              </div>
                            </td>
                            <td class="p-3">
                              <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                                  <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                                </div>
                                <span class="font-medium text-sm text-gray-900">${j.affiliate_name || '-'}</span>
                              </div>
                            </td>
                            <td class="p-3"><span class="text-sm text-gray-900">${j.event_name || ('#' + (j.event_id || ''))}</span></td>
                            <td class="p-3"><span class="font-extrabold text-sm text-gray-900">Rp ${(Number(j.total_amount) || 0).toLocaleString('id-ID')}</span></td>
                            <td class="p-3"><span class="text-sm text-gray-600">SEDANG BERANGKAT</span></td>
                            <td class="p-3"><span class="text-sm text-gray-600">${j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID')}</span></td>
                            <td class="p-3">
                              <select class="history-status-select mb-2">
                                <option value="">-- pilih status --</option>
                                <option value="LEAD BARU">LEAD BARU</option>
                                <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                                <option value="HOT">HOT</option>
                                <option value="SEDANG BERANGKAT" selected>SEDANG BERANGKAT</option>
                              </select>
                              <button class="history-restore-btn btn-primary text-sm w-full"><i class="fas fa-undo-alt mr-1"></i> Restore</button>
                            </td>
                          `;
                          histTbody.insertBefore(tr, histTbody.firstChild);
                        }
                      }

                      applyFiltersAndPaginate({ tableSelector: '#leadsTable', searchInputId: 'leadsSearch', statusInputId: 'leadsStatusFilter', rowsPerPageId: 'leadsRowsPerPage', paginationId: 'leadsPagination', totalId: 'leadsTotal' });
                      applyFiltersAndPaginate({ tableSelector: '#historyTable', searchInputId: 'historySearch', rowsPerPageId: 'historyRowsPerPage', paginationId: 'historyPagination', totalId: 'historyTotal' });
                    } catch (e) { console.error('move to history error', e); }
                  }

                  updateStats();

                  await showModal({
                    type: 'success',
                    title: 'Berhasil',
                    message: val === 'SEDANG BERANGKAT'
                      ? 'Status lead berhasil diperbarui menjadi SEDANG BERANGKAT. Lead telah dipindahkan ke tab Riwayat.'
                      : 'Status lead berhasil diperbarui. Komisi akan ditambahkan ke dashboard affiliate.'
                  });
                } else {
                  await showModal({
                    type: 'error',
                    title: 'Gagal',
                    message: 'Gagal menyimpan status'
                  });
                }
              } catch (err) {
                console.error(err);
                await showModal({
                  type: 'error',
                  title: 'Error',
                  message: 'Gagal menyimpan status'
                });
              }
            }

            if (e.target.matches('.reject-btn')) {
              const area = e.target.closest('.action-area');
              const id = area.dataset.id;
              const select = document.querySelector('.lead-status-select[data-id="' + id + '"]');
              select.value = select.dataset.prev || '';
              area.querySelectorAll('.save-btn, .reject-btn').forEach(b => b.classList.add('hidden'));
            }

            if (e.target.matches('.reject-row-btn')) {
              const id = e.target.dataset.id;

              const confirmed = await showConfirm({
                type: 'warning',
                title: 'Konfirmasi Reject',
                message: 'Apakah Anda yakin ingin menandai lead ini sebagai REJECTED?\n\nLead akan dipindahkan ke tab Riwayat.',
                confirmText: 'Ya, Reject',
                cancelText: 'Batal'
              });

              if (!confirmed) return;

              try {
                const resp = await fetch('/sales/update-lead-status', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body: `id=${encodeURIComponent(id)}&lead_status=REJECTED`
                });
                const j = await resp.json();

                if (j && j.success) {
                  const select = document.querySelector('.lead-status-select[data-id="' + id + '"]');
                  const prevStatus = select ? (select.dataset.prev || '') : '';
                  if (select) { select.value = 'REJECTED'; select.dataset.prev = 'REJECTED'; }

                  const row = document.querySelector('tr td .action-area[data-id="' + id + '"]')?.closest('tr');
                  if (row) {
                    const statusEl = row.querySelector('.text-gray-500');
                    if (statusEl) statusEl.textContent = 'Status DB: ' + (j.status || 'REJECTED');
                    const timeCell = row.querySelector('td:nth-child(8)');
                    if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');

                    if (prevStatus === 'LEAD BARU') {
                      row.classList.remove('new-lead-row');
                      const badge = row.querySelector('.pulse-badge');
                      if (badge) badge.remove();
                      updateNewLeadsCount(-1);
                    }

                    // move rejected row into History tab
                    try {
                      const leadsTbody = document.querySelector('#leadsTable tbody');
                      if (row && leadsTbody) row.remove();

                      const histTbody = document.querySelector('#historyTable tbody');
                      if (histTbody) {
                        const existing = histTbody.querySelector('tr.history-row[data-id="' + id + '"]');
                        if (existing) {
                          try {
                            const statusCell = existing.querySelector('td:nth-child(6) span');
                            if (statusCell) statusCell.textContent = 'REJECTED';
                            const timeCell = existing.querySelector('td:nth-child(7) span');
                            if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
                          } catch (err) { console.error('update existing history rejected error', err); }
                        } else {
                          const tr = document.createElement('tr');
                          tr.className = 'table-row history-row';
                          tr.setAttribute('data-id', id);
                          tr.innerHTML = `
                            <td class="p-3"><span class="font-extrabold text-sm text-gray-900">#${id}</span></td>
                            <td class="p-3">
                              <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                                  <i class="fas fa-user text-emerald-600 text-sm"></i>
                                </div>
                                <span class="font-medium text-sm text-gray-900">${j.customer_name || '-'}</span>
                              </div>
                            </td>
                            <td class="p-3">
                              <div class="flex items-center gap-2">
                                <div class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                                  <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                                </div>
                                <span class="font-medium text-sm text-gray-900">${j.affiliate_name || '-'}</span>
                              </div>
                            </td>
                            <td class="p-3"><span class="text-sm text-gray-900">${j.event_name || ('#' + (j.event_id || ''))}</span></td>
                            <td class="p-3"><span class="font-extrabold text-sm text-gray-900">Rp ${(Number(j.total_amount) || 0).toLocaleString('id-ID')}</span></td>
                            <td class="p-3"><span class="text-sm text-gray-600">REJECTED</span></td>
                            <td class="p-3"><span class="text-sm text-gray-600">${j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID')}</span></td>
                            <td class="p-3">
                              <select class="history-status-select mb-2">
                                <option value="">-- pilih status --</option>
                                <option value="LEAD BARU">LEAD BARU</option>
                                <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                                <option value="HOT">HOT</option>
                                <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                              </select>
                              <button class="history-restore-btn btn-primary text-sm w-full"><i class="fas fa-undo-alt mr-1"></i> Restore</button>
                            </td>
                          `;
                          histTbody.insertBefore(tr, histTbody.firstChild);
                        }
                      }
                    } catch (e) { console.error('move rejected to history error', e); }
                  }

                  updateStats();

                  // Show undo option in modal
                  const undoConfirmed = await showConfirm({
                    type: 'warning',
                    title: 'Lead Ditolak',
                    message: `Lead #${id} telah ditandai REJECTED. Batalkan?`,
                    confirmText: 'Ya, Batalkan',
                    cancelText: 'Tidak'
                  });

                  if (undoConfirmed) {
                    try {
                      const undoResp = await fetch('/sales/update-lead-status', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(prevStatus || 'LEAD BARU')}`
                      });
                      const undoJ = await undoResp.json();
                      if (undoJ && undoJ.success) {
                        await showModal({
                          type: 'success',
                          title: 'Berhasil',
                          message: 'Perubahan berhasil dibatalkan'
                        });
                        location.reload();
                      }
                    } catch (err) {
                      console.error(err);
                    }
                  }
                } else {
                  await showModal({
                    type: 'error',
                    title: 'Gagal',
                    message: 'Gagal menolak lead'
                  });
                }
              } catch (err) {
                console.error(err);
                await showModal({
                  type: 'error',
                  title: 'Error',
                  message: 'Gagal menolak lead'
                });
              }
            }

            if (e.target.matches('.history-restore-btn')) {
              const row = e.target.closest('tr');
              const idText = row.querySelector('td')?.textContent || '';
              const match = idText.match(/#(\d+)/);
              const id = match ? match[1] : null;
              const sel = row.querySelector('.history-status-select');
              const newStatus = sel ? sel.value : '';

              if (!id || !newStatus) {
                await showModal({
                  type: 'warning',
                  title: 'Pilih Status',
                  message: 'Pilih status baru terlebih dahulu'
                });
                return;
              }

              // KONFIRMASI KHUSUS UNTUK RESTORE
              const confirmed = await showConfirm({
                type: 'question',
                title: 'Konfirmasi Restore',
                message: `Apakah Anda yakin ingin mengembalikan lead #${id} dengan status ${newStatus}?\n\nLead akan dipindahkan kembali ke tab Leads.`,
                confirmText: 'Ya, Restore',
                cancelText: 'Batal'
              });

              if (!confirmed) return;

              try {
                const resp = await fetch('/sales/update-lead-status', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                  body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(newStatus)}`
                });
                const j = await resp.json();

                if (j && j.success) {
                  if (newStatus === 'SEDANG BERANGKAT' || newStatus === 'REJECTED') {
                    // Update existing history row
                    try {
                      const statusCell = row.querySelector('td:nth-child(6) span');
                      if (statusCell) statusCell.textContent = newStatus;
                      const timeCell = row.querySelector('td:nth-child(7) span');
                      if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
                      const sel = row.querySelector('.history-status-select');
                      if (sel) sel.value = newStatus;
                      applyFiltersAndPaginate({ tableSelector: '#historyTable', searchInputId: 'historySearch', rowsPerPageId: 'historyRowsPerPage', paginationId: 'historyPagination', totalId: 'historyTotal' });
                      updateStats();

                      await showModal({
                        type: 'success',
                        title: 'Berhasil',
                        message: 'Status berhasil diperbarui'
                      });
                    } catch (err) {
                      console.error('update history row error', err);
                    }
                  } else {
                    // Remove from history and add to leads
                    row.remove();
                    try {
                      const leadsTbody = document.querySelector('#leadsTable tbody');
                      if (leadsTbody && !leadsTbody.querySelector('.action-area[data-id="' + id + '"]')) {
                        const tr = document.createElement('tr');
                        tr.className = 'border-t hover:bg-white/40 transition-all duration-300 border-b border-white/30 bg-white/20 backdrop-blur';
                        tr.innerHTML = `
                          <td class="p-3">
                            <span class="font-extrabold text-sm text-gray-900">#${id}</span>
                            ${newStatus === 'LEAD BARU' ? '<span class="ml-2 pulse-badge">NEW</span>' : ''}
                          </td>
                          <td class="p-3">
                            <div class="flex items-center gap-2">
                              <div class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                                <i class="fas fa-user text-emerald-600 text-sm"></i>
                              </div>
                              <span class="font-medium text-sm text-gray-900">${j.customer_name || '-'}</span>
                            </div>
                          </td>
                          <td class="p-3">
                            <div class="flex items-center gap-2">
                              <div class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                                <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                              </div>
                              <span class="font-medium text-sm text-gray-900">${j.affiliate_name || '-'}</span>
                            </div>
                          </td>
                          <td class="p-3">
                            <span class="text-sm text-gray-900">${j.event_name || ('#' + (j.event_id || ''))}</span>
                          </td>
                          <td class="p-3">
                            <span class="font-extrabold text-sm text-gray-900">Rp ${(Number(j.total_amount) || 0).toLocaleString('id-ID')}</span>
                          </td>
                          <td class="p-3">
                            <span class="text-sm text-gray-400">-</span>
                          </td>
                          <td class="p-3">
                            <select class="lead-status-select" data-id="${id}" data-prev="${newStatus}">
                              <option value="">-- pilih status --</option>
                              ${newStatus === 'LUNAS' ? `
                                <option value="SEDANG BERANGKAT" ${newStatus === 'SEDANG BERANGKAT' ? 'selected' : ''}>SEDANG BERANGKAT</option>
                              ` : `
                                <option value="LEAD BARU" ${newStatus === 'LEAD BARU' ? 'selected' : ''}>LEAD BARU</option>
                                <option value="SEDANG DI PROSPEK" ${newStatus === 'SEDANG DI PROSPEK' ? 'selected' : ''}>SEDANG DI PROSPEK</option>
                                <option value="HOT" ${newStatus === 'HOT' ? 'selected' : ''}>HOT</option>
                                ${newStatus === 'LEAD BARU' ? '' : `
                                  <option value="DP" ${newStatus === 'DP' ? 'selected' : ''}>DP</option>
                                  <option value="LUNAS" ${newStatus === 'LUNAS' ? 'selected' : ''}>LUNAS</option>
                                  <option value="SEDANG BERANGKAT" ${newStatus === 'SEDANG BERANGKAT' ? 'selected' : ''}>SEDANG BERANGKAT</option>
                                `}
                              `}
                            </select>
                            <div class="text-xs text-gray-500 mt-1">Status DB: ${newStatus}</div>
                            <div class="mt-2 action-area flex gap-1" data-id="${id}">
                              <button class="save-btn hidden px-3 py-1 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg text-xs font-extrabold">Simpan</button>
                              <button class="reject-btn hidden px-3 py-1 bg-gradient-to-r from-red-600 to-rose-600 text-white rounded-lg text-xs font-extrabold">Reject</button>
                            </div>
                          </td>
                          <td class="p-3">
                            <span class="text-sm text-gray-600">${j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID')}</span>
                          </td>
                          <td class="p-3">
                            <button class="reject-row-btn px-3 py-1.5 btn-danger text-sm" data-id="${id}">
                              <i class="fas fa-times mr-1"></i> Reject
                            </button>
                          </td>
                        `;
                        leadsTbody.insertBefore(tr, leadsTbody.firstChild);
                      }
                      updateNewLeadsCount(newStatus === 'LEAD BARU' ? 1 : 0);
                      applyFiltersAndPaginate({ tableSelector: '#leadsTable', searchInputId: 'leadsSearch', statusInputId: 'leadsStatusFilter', rowsPerPageId: 'leadsRowsPerPage', paginationId: 'leadsPagination', totalId: 'leadsTotal' });
                    } catch (e) { console.error('add restored row error', e); }
                    updateStats();
                    applyFiltersAndPaginate({ tableSelector: '#historyTable', searchInputId: 'historySearch', rowsPerPageId: 'historyRowsPerPage', paginationId: 'historyPagination', totalId: 'historyTotal' });

                    await showModal({
                      type: 'success',
                      title: 'Berhasil',
                      message: 'Status berhasil diperbarui dan lead dipindahkan ke tab Leads'
                    });
                  }
                } else {
                  await showModal({
                    type: 'error',
                    title: 'Gagal',
                    message: 'Gagal memperbarui status'
                  });
                }
              } catch (err) {
                console.error(err);
                await showModal({
                  type: 'error',
                  title: 'Error',
                  message: 'Gagal memperbarui status'
                });
              }
            }
          });

          // --- Helper functions for NEW badge ---
          function updateNewLeadsCount(delta) {
            try {
              const badge = document.getElementById('newLeadsBadge');
              const countEl = document.getElementById('newLeadsCount');
              const countStatEl = document.getElementById('newLeadsCountStat');
              let count = parseInt(countEl.textContent || '0', 10) || 0;
              count = count + (delta || 0);
              if (count < 0) count = 0;
              countEl.textContent = count;
              if (countStatEl) countStatEl.textContent = count;
              if (count > 0) badge.classList.remove('hidden'); else badge.classList.add('hidden');
            } catch (e) { console.error(e); }
          }

          function updateStats() {
            const rows = document.querySelectorAll('#leadsTable tbody tr:not(.placeholder-row)');
            let newLeads = 0;
            let hotLeads = 0;
            let readyLeads = 0;

            rows.forEach(row => {
              const statusSelect = row.querySelector('.lead-status-select');
              const status = statusSelect ? statusSelect.value : '';
              if (status === 'LEAD BARU') newLeads++;
              if (status === 'HOT') hotLeads++;
              if (status === 'SEDANG BERANGKAT') readyLeads++;
            });

            document.getElementById('newLeadsCountStat').textContent = newLeads;
            document.getElementById('hotLeadsCount').textContent = hotLeads;
            document.getElementById('readyLeadsCount').textContent = readyLeads;
          }

          function initNewLeadsBadge() {
            const initial = document.querySelectorAll('.new-lead-row').length;
            const countEl = document.getElementById('newLeadsCount');
            const badge = document.getElementById('newLeadsBadge');
            countEl.textContent = initial;
            if (initial > 0) badge.classList.remove('hidden'); else badge.classList.add('hidden');
            updateStats();
          }

          // --- Filtering & Pagination utilities ---
          function textMatch(row, query) {
            return row.textContent.toLowerCase().indexOf(query) !== -1;
          }

          function applyFiltersAndPaginate(opts) {
            const table = document.querySelector(opts.tableSelector);
            if (!table) return;
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            const searchVal = (document.getElementById(opts.searchInputId)?.value || '').toLowerCase().trim();
            const statusVal = opts.statusInputId ? (document.getElementById(opts.statusInputId)?.value || '') : '';

            let filtered = rows.filter(r => !r.classList.contains('placeholder-row'));

            if (opts.tableSelector === '#leadsTable') {
              filtered = filtered.filter(r => {
                const idCell = r.querySelector('td:nth-child(1)')?.textContent || '';
                const customer = r.querySelector('td:nth-child(2)')?.textContent || '';
                const affiliate = r.querySelector('td:nth-child(3)')?.textContent || '';
                const eventC = r.querySelector('td:nth-child(4)')?.textContent || '';
                const statusEl = r.querySelector('.text-gray-500');
                const statusText = statusEl ? statusEl.textContent.replace('Status DB:', '').trim().toLowerCase() : (r.querySelector('.lead-status-select')?.value || '').toLowerCase();

                if (searchVal) {
                  const hay = (idCell + ' ' + customer + ' ' + affiliate + ' ' + eventC).toLowerCase();
                  if (hay.indexOf(searchVal) === -1) return false;
                }
                if (['sedang berangkat', 'rejected'].includes(statusText)) return false;
                if (statusVal) {
                  if (statusText.indexOf(statusVal.toLowerCase()) === -1) return false;
                }
                return true;
              });
            } else {
              filtered = filtered.filter(r => {
                if (searchVal) {
                  if (!textMatch(r, searchVal)) return false;
                }
                return true;
              });
            }

            const rowsPerPage = parseInt(document.getElementById(opts.rowsPerPageId)?.value || '10', 10) || 10;
            const total = filtered.length;
            const totalPages = Math.max(1, Math.ceil(total / rowsPerPage));
            let currentPage = parseInt(table.dataset.page || '1', 10) || 1;
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;
            table.dataset.page = String(currentPage);

            rows.forEach(r => r.style.display = 'none');
            const start = (currentPage - 1) * rowsPerPage;
            const pageRows = filtered.slice(start, start + rowsPerPage);
            pageRows.forEach(r => r.style.display = 'table-row');

            if (filtered.length === 0) {
              let ph = tbody.querySelector('.placeholder-row');
              if (!ph) {
                ph = document.createElement('tr');
                ph.className = 'border-t placeholder-row';
                const thCount = table.querySelectorAll('thead th').length || 7;
                for (let i = 0; i < thCount; i++) {
                  const td = document.createElement('td');
                  td.className = 'p-2';
                  td.textContent = '-';
                  ph.appendChild(td);
                }
                tbody.appendChild(ph);
              }
              ph.style.display = 'table-row';
            } else {
              const ph = tbody.querySelector('.placeholder-row');
              if (ph) ph.style.display = 'none';
            }

            const pag = document.getElementById(opts.paginationId);
            if (pag) {
              pag.innerHTML = '';
              const prev = document.createElement('button');
              prev.innerHTML = '<i class="fas fa-chevron-left text-sm"></i>';
              prev.disabled = currentPage === 1;
              prev.className = 'pagination-btn px-3 py-1 mr-2';
              prev.addEventListener('click', () => {
                table.dataset.page = String(Math.max(1, currentPage - 1));
                applyFiltersAndPaginate(opts);
              });
              pag.appendChild(prev);

              const span = document.createElement('span');
              span.className = 'text-sm font-medium text-gray-700 px-2';
              span.textContent = `Halaman ${currentPage} / ${totalPages}`;
              pag.appendChild(span);

              const next = document.createElement('button');
              next.innerHTML = '<i class="fas fa-chevron-right text-sm"></i>';
              next.disabled = currentPage === totalPages;
              next.className = 'pagination-btn px-3 py-1 ml-2';
              next.addEventListener('click', () => {
                table.dataset.page = String(Math.min(totalPages, currentPage + 1));
                applyFiltersAndPaginate(opts);
              });
              pag.appendChild(next);
            }

            const totalEl = document.getElementById(opts.totalId);
            if (totalEl) totalEl.textContent = String(total);
          }

          // Initialize table controls
          function initTableControls() {
            ['leadsSearch', 'leadsStatusFilter', 'leadsRowsPerPage'].forEach(id => {
              document.getElementById(id)?.addEventListener('input', () => applyFiltersAndPaginate({
                tableSelector: '#leadsTable',
                searchInputId: 'leadsSearch',
                statusInputId: 'leadsStatusFilter',
                rowsPerPageId: 'leadsRowsPerPage',
                paginationId: 'leadsPagination',
                totalId: 'leadsTotal'
              }));
            });

            document.getElementById('leadsSearch')?.addEventListener('keyup', () => applyFiltersAndPaginate({
              tableSelector: '#leadsTable',
              searchInputId: 'leadsSearch',
              statusInputId: 'leadsStatusFilter',
              rowsPerPageId: 'leadsRowsPerPage',
              paginationId: 'leadsPagination',
              totalId: 'leadsTotal'
            }));

            document.getElementById('leadsRowsPerPage')?.addEventListener('change', () => applyFiltersAndPaginate({
              tableSelector: '#leadsTable',
              searchInputId: 'leadsSearch',
              statusInputId: 'leadsStatusFilter',
              rowsPerPageId: 'leadsRowsPerPage',
              paginationId: 'leadsPagination',
              totalId: 'leadsTotal'
            }));

            document.getElementById('historySearch')?.addEventListener('input', () => applyFiltersAndPaginate({
              tableSelector: '#historyTable',
              searchInputId: 'historySearch',
              rowsPerPageId: 'historyRowsPerPage',
              paginationId: 'historyPagination',
              totalId: 'historyTotal'
            }));

            document.getElementById('historyRowsPerPage')?.addEventListener('change', () => applyFiltersAndPaginate({
              tableSelector: '#historyTable',
              searchInputId: 'historySearch',
              rowsPerPageId: 'historyRowsPerPage',
              paginationId: 'historyPagination',
              totalId: 'historyTotal'
            }));

            applyFiltersAndPaginate({
              tableSelector: '#leadsTable',
              searchInputId: 'leadsSearch',
              statusInputId: 'leadsStatusFilter',
              rowsPerPageId: 'leadsRowsPerPage',
              paginationId: 'leadsPagination',
              totalId: 'leadsTotal'
            });

            applyFiltersAndPaginate({
              tableSelector: '#historyTable',
              searchInputId: 'historySearch',
              rowsPerPageId: 'historyRowsPerPage',
              paginationId: 'historyPagination',
              totalId: 'historyTotal'
            });
          }

          // Initialize everything on DOM ready
          document.addEventListener('DOMContentLoaded', function () {
            initNewLeadsBadge();
            initTableControls();
          });

          // --- Server-Sent Events (real-time updates) ---
          if (window.EventSource) {
            const es = new EventSource('/sales/lead-events');

            es.onopen = () => console.debug('SSE connected');
            es.onerror = (e) => console.error('SSE error', e);

            es.addEventListener('new_lead', function (e) {
              try {
                const d = JSON.parse(e.data);
                const tbody = document.querySelector('#tab-leads table tbody');
                if (tbody) {
                  const tr = document.createElement('tr');
                  tr.className = 'table-row new-lead-row';
                  tr.innerHTML = `
                    <td class="p-3">
                      <span class="font-extrabold text-sm text-gray-900">#${d.id}</span>
                      <span class="ml-2 pulse-badge">NEW</span>
                    </td>
                    <td class="p-3">
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                          <i class="fas fa-user text-emerald-600 text-sm"></i>
                        </div>
                        <span class="font-medium text-sm text-gray-900">${d.customer_name || '-'}</span>
                      </div>
                    </td>
                    <td class="p-3">
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                          <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                        </div>
                        <span class="font-medium text-sm text-gray-900">${d.affiliate_name || '-'}</span>
                      </div>
                    </td>
                    <td class="p-3">
                      <span class="text-sm text-gray-900">${d.event_name || ('#' + (d.event_id || ''))}</span>
                    </td>
                    <td class="p-3">
                      <span class="font-extrabold text-sm text-gray-900">Rp ${(Number(d.total_amount || 0)).toLocaleString('id-ID')}</span>
                    </td>
                    <td class="p-3">
                      <span class="text-sm text-gray-400">-</span>
                    </td>
                    <td class="p-3">
                      <select class="lead-status-select" data-id="${d.id}" data-prev="LEAD BARU">
                        <option value="">-- pilih status --</option>
                        <option value="LEAD BARU" selected>LEAD BARU</option>
                        <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                        <option value="HOT">HOT</option>
                      </select>
                      <div class="text-xs text-gray-500 mt-1">Status DB: LEAD BARU</div>
                      <div class="mt-2 action-area flex gap-1" data-id="${d.id}">
                        <button class="save-btn hidden px-3 py-1 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg text-xs font-extrabold">Simpan</button>
                        <button class="reject-btn hidden px-3 py-1 bg-gradient-to-r from-red-600 to-rose-600 text-white rounded-lg text-xs font-extrabold">Reject</button>
                      </div>
                    </td>
                    <td class="p-3">
                      <span class="text-sm text-gray-600">${d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : new Date().toLocaleString('id-ID')}</span>
                    </td>
                    <td class="p-3">
                      <button class="reject-row-btn px-3 py-1.5 btn-danger text-sm" data-id="${d.id}">
                        <i class="fas fa-times mr-1"></i> Reject
                      </button>
                    </td>
                  `;
                  tbody.insertBefore(tr, tbody.firstChild);
                  updateNewLeadsCount(1);
                  updateStats();
                  applyFiltersAndPaginate({
                    tableSelector: '#leadsTable',
                    searchInputId: 'leadsSearch',
                    statusInputId: 'leadsStatusFilter',
                    rowsPerPageId: 'leadsRowsPerPage',
                    paginationId: 'leadsPagination',
                    totalId: 'leadsTotal'
                  });
                }
              } catch (err) { console.error('new_lead parse error', err); }
            });

            es.addEventListener('history', function (e) {
              try {
                const d = JSON.parse(e.data);
                const leadsTbody = document.querySelector('#tab-leads table tbody');
                let fallbackCustomer = '-', fallbackAffiliate = '-', fallbackEvent = '-', fallbackAmountText = 'Rp 0';
                if (leadsTbody) {
                  const row = leadsTbody.querySelector('.action-area[data-id="' + d.id + '"]')?.closest('tr');
                  if (row) {
                    fallbackCustomer = row.querySelector('td:nth-child(2) .font-medium')?.textContent.trim() || row.querySelector('td:nth-child(2)')?.textContent.trim() || '-';
                    fallbackAffiliate = row.querySelector('td:nth-child(3) .font-medium')?.textContent.trim() || row.querySelector('td:nth-child(3)')?.textContent.trim() || '-';
                    fallbackEvent = row.querySelector('td:nth-child(4) .text-sm')?.textContent.trim() || row.querySelector('td:nth-child(4)')?.textContent.trim() || '-';
                    fallbackAmountText = row.querySelector('td:nth-child(5) .font-extrabold')?.textContent.trim() || row.querySelector('td:nth-child(5)')?.textContent.trim() || 'Rp 0';
                    row.remove();
                  }
                }

                const histTbody = document.querySelector('#tab-history table tbody');
                if (histTbody) {
                  const existing = histTbody.querySelector('tr.history-row[data-id="' + d.id + '"]');
                  if (existing) {
                    try {
                      const cust = existing.querySelector('td:nth-child(2) .font-medium'); if (cust) cust.textContent = d.customer_name || '-';
                      const aff = existing.querySelector('td:nth-child(3) .font-medium'); if (aff) aff.textContent = d.affiliate_name || '-';
                      const amt = existing.querySelector('td:nth-child(5) .font-extrabold'); if (amt) amt.textContent = 'Rp ' + ((Number(d.total_amount) || 0).toLocaleString('id-ID'));
                      const statusCell = existing.querySelector('td:nth-child(6) span'); if (statusCell) statusCell.textContent = d.status || '-';
                      const timeCell = existing.querySelector('td:nth-child(7) span'); if (timeCell) timeCell.textContent = d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : new Date().toLocaleString('id-ID');
                    } catch (err) { console.error('update existing history row error', err); }
                  } else {
                    const tr = document.createElement('tr');
                    tr.className = 'table-row history-row';
                    tr.setAttribute('data-id', d.id);
                    tr.innerHTML = `
                      <td class="p-3"><span class="font-extrabold text-sm text-gray-900">#${d.id}</span></td>
                      <td class="p-3">
                        <div class="flex items-center gap-2">
                          <div class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                            <i class="fas fa-user text-emerald-600 text-sm"></i>
                          </div>
                          <span class="font-medium text-sm text-gray-900">${(d.customer_name || fallbackCustomer || '-')}</span>
                        </div>
                      </td>
                      <td class="p-3">
                        <div class="flex items-center gap-2">
                          <div class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                            <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                          </div>
                          <span class="font-medium text-sm text-gray-900">${(d.affiliate_name || fallbackAffiliate || '-')}</span>
                        </div>
                      </td>
                      <td class="p-3"><span class="text-sm text-gray-900">${(d.event_name || fallbackEvent || ('#' + (d.event_id || '')))}</span></td>
                      <td class="p-3"><span class="font-extrabold text-sm text-gray-900">${(d.total_amount !== undefined && d.total_amount !== null) ? ('Rp ' + (Number(d.total_amount) || 0).toLocaleString('id-ID')) : fallbackAmountText}</span></td>
                      <td class="p-3"><span class="text-sm text-gray-600">${d.status || '-'}</span></td>
                      <td class="p-3"><span class="text-sm text-gray-600">${d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : new Date().toLocaleString('id-ID')}</span></td>
                      <td class="p-3">
                        <select class="history-status-select mb-2">
                          <option value="">-- pilih status --</option>
                          <option value="LEAD BARU">LEAD BARU</option>
                          <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                          <option value="HOT">HOT</option>
                          <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                        </select>
                        <button class="history-restore-btn btn-primary text-sm w-full"><i class="fas fa-undo-alt mr-1"></i> Restore</button>
                      </td>
                    `;
                    histTbody.insertBefore(tr, histTbody.firstChild);
                  }
                  applyFiltersAndPaginate({ tableSelector: '#historyTable', searchInputId: 'historySearch', rowsPerPageId: 'historyRowsPerPage', paginationId: 'historyPagination', totalId: 'historyTotal' });
                }
              } catch (err) { console.error('history parse error', err); }
            });

            es.addEventListener('status_update', function (e) {
              try {
                const d = JSON.parse(e.data);
                const leadsTbody = document.querySelector('#tab-leads table tbody');

                if (leadsTbody) {
                  const row = leadsTbody.querySelector('.action-area[data-id="' + d.id + '"]')?.closest('tr');
                  if (row) {
                    const statusEl = row.querySelector('.text-gray-500'); if (statusEl) statusEl.textContent = 'Status DB: ' + (d.status || '-');
                    const timeCell = row.querySelector('td:nth-child(8)'); if (timeCell) timeCell.textContent = d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
                  }
                }

                if (d.status === 'SEDANG BERANGKAT' || d.status === 'REJECTED') {
                  try {
                    let fallbackCustomer2 = '-', fallbackAffiliate2 = '-', fallbackEvent2 = '-', fallbackAmountText2 = 'Rp 0';
                    if (leadsTbody) {
                      const existingRow = leadsTbody.querySelector('.action-area[data-id="' + d.id + '"]')?.closest('tr');
                      if (existingRow) {
                        fallbackCustomer2 = existingRow.querySelector('td:nth-child(2) .font-medium')?.textContent.trim() || existingRow.querySelector('td:nth-child(2)')?.textContent.trim() || '-';
                        fallbackAffiliate2 = existingRow.querySelector('td:nth-child(3) .font-medium')?.textContent.trim() || existingRow.querySelector('td:nth-child(3)')?.textContent.trim() || '-';
                        fallbackEvent2 = existingRow.querySelector('td:nth-child(4) .text-sm')?.textContent.trim() || existingRow.querySelector('td:nth-child(4)')?.textContent.trim() || '-';
                        fallbackAmountText2 = existingRow.querySelector('td:nth-child(5) .font-extrabold')?.textContent.trim() || existingRow.querySelector('td:nth-child(5)')?.textContent.trim() || 'Rp 0';
                        existingRow.remove();
                      }
                    }

                    const histTbody = document.querySelector('#historyTable tbody');
                    if (histTbody && !histTbody.querySelector('tr.history-row[data-id="' + d.id + '"]')) {
                      const tr = document.createElement('tr');
                      tr.className = 'table-row history-row';
                      tr.setAttribute('data-id', d.id);
                      tr.innerHTML = `
                        <td class="p-3"><span class="font-extrabold text-sm text-gray-900">#${d.id}</span></td>
                        <td class="p-3">
                          <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-gradient-to-br from-emerald-100 to-green-100 rounded-lg flex items-center justify-center border border-white/60">
                              <i class="fas fa-user text-emerald-600 text-sm"></i>
                            </div>
                            <span class="font-medium text-sm text-gray-900">${(d.customer_name || fallbackCustomer2 || '-')}</span>
                          </div>
                        </td>
                        <td class="p-3">
                          <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-gradient-to-br from-purple-100 to-indigo-100 rounded-lg flex items-center justify-center border border-white/60">
                              <i class="fas fa-user-tie text-purple-600 text-sm"></i>
                            </div>
                            <span class="font-medium text-sm text-gray-900">${(d.affiliate_name || fallbackAffiliate2 || '-')}</span>
                          </div>
                        </td>
                        <td class="p-3"><span class="text-sm text-gray-900">${(d.event_name || fallbackEvent2 || ('#' + (d.event_id || '')))}</span></td>
                        <td class="p-3"><span class="font-extrabold text-sm text-gray-900">${(d.total_amount !== undefined && d.total_amount !== null) ? ('Rp ' + (Number(d.total_amount) || 0).toLocaleString('id-ID')) : fallbackAmountText2}</span></td>
                        <td class="p-3"><span class="text-sm text-gray-600">${d.status || ''}</span></td>
                        <td class="p-3"><span class="text-sm text-gray-600">${d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID')}</span></td>
                        <td class="p-3">
                          <select class="history-status-select mb-2">
                            <option value="">-- pilih status --</option>
                            <option value="LEAD BARU">LEAD BARU</option>
                            <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                            <option value="HOT">HOT</option>
                            <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                          </select>
                          <button class="history-restore-btn btn-primary text-sm w-full"><i class="fas fa-undo-alt mr-1"></i> Restore</button>
                        </td>
                      `;
                      histTbody.insertBefore(tr, histTbody.firstChild);
                      applyFiltersAndPaginate({ tableSelector: '#historyTable', searchInputId: 'historySearch', rowsPerPageId: 'historyRowsPerPage', paginationId: 'historyPagination', totalId: 'historyTotal' });
                    }
                  } catch (err) { console.error('status_update move-to-history error', err); }
                }

                updateStats();
              } catch (err) { console.error('status_update parse error', err); }
            });
          }

          // Auto-refresh stats every 30 seconds
          setInterval(updateStats, 30000);
        </script>
</body>

</html>

