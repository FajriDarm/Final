<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verifikasi Leads - Sales</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; }

    /* New lead badge/pulse */
    .pulse-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      background: rgba(16, 185, 129, 0.12);
      color: #059669;
      font-weight: 600;
      font-size: 11px;
      box-shadow: 0 0 0 0 rgba(16,185,129,0.3);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16,185,129,0.4); }
      70% { box-shadow: 0 0 0 8px rgba(16,185,129,0); }
      100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
    }

    /* Undo toast */
    #undoToast {
      display: none;
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 60;
      background: white;
      border: 1px solid rgba(0,0,0,0.06);
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    #undoToast.show { display: flex; align-items: center; gap: 0.75rem; }
    #undoToast button { cursor: pointer; }
  </style>
</head>
<body class="bg-gray-50">
  <%- include('../navbar/navbar.ejs', { name: 'Sales' }) %>
  <%- include('../sidebar/sales.ejs') %>
  <% const isSales = (typeof user !== 'undefined' && user.role === 'sales'); %>

  <main class="ml-64 pt-16 min-h-screen p-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
            <i class="fas fa-user-check text-white text-lg"></i>
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h1 class="text-2xl font-bold">Verifikasi & Manajemen Leads</h1>
              <span id="newLeadsBadge" class="hidden px-2 py-0.5 rounded-full text-sm font-semibold bg-emerald-100 text-emerald-700">NEW <span id="newLeadsCount" class="ml-2">0</span></span>
            </div>
            <p class="text-sm text-gray-500">Kelola lead dan atur status perjalanan</p>
          </div>
        </div>
        <div class="text-sm text-gray-500">Menampilkan <%= transactions.length || 0 %> transaksi</div>
      </div>

      <div class="glass-card rounded-2xl shadow-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-green-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <button class="tab-btn px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm" data-tab="leads">Leads</button>
            <button class="tab-btn px-4 py-2 rounded-lg bg-transparent text-sm" data-tab="history">Riwayat SEDANG BERANGKAT (7 hari)</button>
          </div>
          <div class="text-xs text-gray-600">Update real-time via SSE</div>
        </div>

        <div id="tab-leads" class="p-4">
          <div class="flex items-center justify-between mb-3 gap-3">
            <div class="flex items-center gap-2">
              <input id="leadsSearch" class="border px-3 py-2 rounded" placeholder="Cari ID, customer, affiliate, event..." />
              <select id="leadsStatusFilter" class="border px-3 py-2 rounded">
                <option value="">Semua status</option>
                <option>LEAD BARU</option>
                <option>SEDANG DI PROSPEK</option>
                <option>HOT</option>
                <% if (!isSales) { %>
                  <option>DP</option>
                  <option>LUNAS</option>
                <% } %>
                <option>SEDANG BERANGKAT</option>
                <option>REJECTED</option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <label class="text-sm text-gray-600">Per halaman</label>
              <select id="leadsRowsPerPage" class="border px-2 py-1 rounded">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
              </select>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table id="leadsTable" class="w-full text-left text-sm divide-y divide-green-100">
              <thead class="bg-green-50">
                <tr>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">ID</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Customer</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Affiliate</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Event</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Amount</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Komisi</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Lead Status</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Waktu</th>
                  <th class="py-3 px-4 text-sm font-semibold text-green-900">Aksi</th>
                </tr>
              </thead>
              <tbody class="bg-white">

            <% if (!transactions || transactions.length === 0) { %>
              <tr class="border-t placeholder-row"><td colspan="9" class="p-10 text-center text-gray-400">Tidak ada transaksi</td></tr>
            <% } else { %>
              <% transactions.forEach(function(trx){ %>
                <tr class="border-t hover:bg-gray-50 <%= trx.lead_status === 'LEAD BARU' ? 'new-lead-row' : '' %>">
                  <td class="p-3">#<%= trx.id %> <% if (trx.lead_status === 'LEAD BARU') { %><span class="ml-2 pulse-badge">NEW</span><% } %></td>
                  <td class="p-3"><%= trx.customer_name || '-' %></td>
                  <td class="p-3"><%= trx.affiliate_name || '-' %></td>
                  <td class="p-3"><%= trx.event_name || ('#' + trx.event_id) || '-' %></td>
                  <td class="p-3">Rp <%= (parseFloat(trx.total_amount) || 0).toLocaleString('id-ID') %></td>
                  <td class="p-3">
                    <% if (typeof trx.commission_amount !== 'undefined' && trx.commission_amount !== null && trx.commission_amount > 0) { %>
                      Rp <%= Number(trx.commission_amount).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    <% } else if (trx.projected_commission) { %>
                      Rp <%= parseFloat(trx.projected_commission).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="p-3">
                    <% if (trx.status === 'stage_2_approved') { %>
                      <!-- For transactions that reached stage_2 (LUNAS), sales may only set SEDANG BERANGKAT -->
                      <select class="lead-status-select border px-2 py-1 rounded" data-id="<%= trx.id %>" data-prev="<%= trx.lead_status || '' %>">
                        <option value="">-- pilih status --</option>
                        <option value="SEDANG BERANGKAT" <%= trx.lead_status === 'SEDANG BERANGKAT' ? 'selected' : '' %>>SEDANG BERANGKAT</option>
                      </select>
                    <% } else { %>
                      <% if (trx.lead_status === 'LEAD BARU') { %>
                        <select class="lead-status-select border px-2 py-1 rounded" data-id="<%= trx.id %>" data-prev="<%= trx.lead_status || '' %>">
                          <option value="">-- pilih status --</option>
                          <option value="LEAD BARU" <%= trx.lead_status === 'LEAD BARU' ? 'selected' : '' %>>LEAD BARU</option>
                          <option value="SEDANG DI PROSPEK" <%= trx.lead_status === 'SEDANG DI PROSPEK' ? 'selected' : '' %>>SEDANG DI PROSPEK</option>
                          <option value="HOT" <%= trx.lead_status === 'HOT' ? 'selected' : '' %>>HOT</option>
                        </select>
                      <% } else { %>
                        <select class="lead-status-select border px-2 py-1 rounded" data-id="<%= trx.id %>" data-prev="<%= trx.lead_status || '' %>">
                          <option value="">-- pilih status --</option>
                          <option value="LEAD BARU" <%= trx.lead_status === 'LEAD BARU' ? 'selected' : '' %>>LEAD BARU</option>
                          <option value="SEDANG DI PROSPEK" <%= trx.lead_status === 'SEDANG DI PROSPEK' ? 'selected' : '' %>>SEDANG DI PROSPEK</option>
                          <option value="HOT" <%= trx.lead_status === 'HOT' ? 'selected' : '' %>>HOT</option>
                          <option value="DP" <%= trx.lead_status === 'DP' ? 'selected' : '' %>>DP</option>
                          <option value="LUNAS" <%= trx.lead_status === 'LUNAS' ? 'selected' : '' %>>LUNAS</option>
                          <option value="SEDANG BERANGKAT" <%= trx.lead_status === 'SEDANG BERANGKAT' ? 'selected' : '' %>>SEDANG BERANGKAT</option>
                        </select>
                      <% } %>
                    <% } %>
                    <div class="text-xs text-gray-400 mt-1">Status DB: <%= trx.lead_status || '—' %></div>
                    <div class="mt-2 action-area" data-id="<%= trx.id %>">
                      <button class="save-btn hidden px-3 py-1 bg-green-600 text-white rounded text-xs">Simpan</button>
                      <button class="reject-btn hidden px-3 py-1 bg-red-500 text-white rounded text-xs ml-2">Reject</button>
                    </div>
                  </td>
                  <td class="p-3"><%= trx.lead_updated_at ? new Date(trx.lead_updated_at).toLocaleString('id-ID') : '-' %></td>
                  <td class="p-3"><button class="reject-row-btn px-3 py-1 bg-red-500 text-white rounded text-xs" data-id="<%= trx.id %>">Reject</button></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
        </div>

        <div class="flex items-center justify-between mt-3">
          <div id="leadsPagination" class="text-sm"></div>
          <div class="text-xs text-gray-500">Total: <span id="leadsTotal">0</span></div>
        </div>

        <!-- Undo toast -->
        <div id="undoToast" aria-live="polite">
          <div id="undoMessage">Lead ditolak</div>
          <div class="ml-4">
            <button id="undoBtn" class="px-3 py-1 bg-emerald-600 text-white rounded text-sm">Undo</button>
            <button id="dismissUndo" class="ml-2 px-2 py-1 bg-gray-100 rounded text-sm">Tutup</button>
          </div>
        </div>

        <div id="tab-history" class="hidden p-4">
          <h3 class="text-sm font-semibold mb-3">Riwayat SEDANG BERANGKAT (7 hari)</h3>
          <div class="flex items-center justify-between mb-3 gap-3">
            <div class="flex items-center gap-2">
              <input id="historySearch" class="border px-3 py-2 rounded" placeholder="Cari ID, customer, affiliate, event..." />
            </div>
            <div class="flex items-center gap-2">
              <label class="text-sm text-gray-600">Per halaman</label>
              <select id="historyRowsPerPage" class="border px-2 py-1 rounded">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
              </select>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table id="historyTable" class="w-full text-left text-sm">
              <thead class="bg-gray-100">
                <tr>
                  <th class="p-2">ID</th>
                  <th class="p-2">Customer</th>
                  <th class="p-2">Affiliate</th>
                  <th class="p-2">Event</th>
                  <th class="p-2">Jumlah</th>
                  <th class="p-2">Status</th>
                  <th class="p-2">Tanggal</th>
                      <th class="p-2">Aksi</th>
                </tr>
              </thead>
              <tbody>
                    <% if (!recentDepartures || recentDepartures.length === 0) { %>
                      <tr class="border-t placeholder-row">
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                        <td class="p-2">-</td>
                      </tr>
                    <% } else { %>
                      <% recentDepartures.forEach(function(r){ %>
                        <tr class="border-t history-row" data-id="<%= r.id %>">
                          <td class="p-2">#<%= r.id %></td>
                          <td class="p-2"><%= r.customer_name || '-' %></td>
                          <td class="p-2"><%= r.affiliate_name || '-' %></td>
                          <td class="p-2"><%= r.event_name || '-' %></td>
                          <td class="p-2">Rp <%= (parseFloat(r.total_amount)||0).toLocaleString('id-ID') %></td>
                          <td class="p-2"><%= r.status || '-' %></td>
                          <td class="p-2"><%= new Date(r.updated_at).toLocaleString() %></td>
                          <td class="p-2">
                            <select class="history-status-select border px-2 py-1 rounded text-sm">
                              <option value="">-- pilih status --</option>
                              <option value="LEAD BARU">LEAD BARU</option>
                              <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                              <option value="HOT">HOT</option>
                              <option value="DP">DP</option>
                              <option value="LUNAS">LUNAS</option>
                              <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                            </select>
                            <button class="history-restore-btn ml-2 px-2 py-1 bg-emerald-600 text-white rounded text-sm">Restore</button>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
              </tbody>
            </table>
          </div>

          <div class="flex items-center justify-between mt-3">
            <div id="historyPagination" class="text-sm"></div>
            <div class="text-xs text-gray-500">Total: <span id="historyTotal">0</span></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Tab handling (use emerald active style)
    document.querySelectorAll('.tab-btn').forEach(btn => btn.addEventListener('click', function(){
      document.querySelectorAll('.tab-btn').forEach(b=>{
        b.classList.remove('bg-emerald-600','text-white');
        b.classList.add('bg-transparent','text-gray-600');
      });
      this.classList.add('bg-emerald-600','text-white');
      this.classList.remove('bg-transparent','text-gray-600');
      const tab = this.dataset.tab;
      document.getElementById('tab-leads').classList.toggle('hidden', tab !== 'leads');
      document.getElementById('tab-history').classList.toggle('hidden', tab !== 'history');
    }));

    // Setup lead-status selects with conditional Save/Reject UI and regression guard
    const getStageLevel = (s) => {
      if (!s) return 0;
      s = s.toString().toUpperCase();
      if (s === 'SEDANG BERANGKAT') return 3;
      if (['LUNAS','DP','HOT'].includes(s)) return 2;
      if (['LEAD BARU','SEDANG DI PROSPEK'].includes(s)) return 1;
      return 0;
    };

    function hideActions(rowId) {
      const area = document.querySelector('.action-area[data-id="'+rowId+'"]');
      if (!area) return;
      area.querySelectorAll('.save-btn, .reject-btn').forEach(b=>b.classList.add('hidden'));
    }

    function showActions(rowId) {
      const area = document.querySelector('.action-area[data-id="'+rowId+'"]');
      if (!area) return;
      area.querySelectorAll('.save-btn, .reject-btn').forEach(b=>b.classList.remove('hidden'));
    }

    // Delegated change handler for dynamically inserted selects
    document.addEventListener('change', function(e) {
      const sel = e.target;
      if (!sel || !sel.matches('.lead-status-select')) return;
      const id = sel.dataset.id;
      const val = sel.value;
      if (!val) return;

      // store prev if missing
      if (!sel.dataset.prev) sel.dataset.prev = '';
      const statusEl = sel.closest('td').querySelector('.text-xs');
      const currentDbStatus = statusEl ? statusEl.textContent.replace('Status DB: ','').trim() : (sel.dataset.prev || '');
      const curLevel = getStageLevel(currentDbStatus);
      const targetLevel = getStageLevel(val);
      // Prevent downgrading to an earlier/lower stage
      if (curLevel > targetLevel) {
        alert('Tidak diperbolehkan menurunkan status ke tahap sebelumnya.');
        sel.value = sel.dataset.prev || '';
        return;
      }

      // If user selected SEDANG BERANGKAT, show Save/Reject buttons instead of auto-saving
      if (val === 'SEDANG BERANGKAT') {
        showActions(id);
        return;
      }

      // Otherwise auto-save like before and update DB time
      fetch('/sales/update-lead-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(val)}`
      }).then(res => res.json()).then(json => {
        if (json && json.success) {
          const prev = sel.closest('td').querySelector('.text-xs');
          if (prev) prev.textContent = 'Status DB: ' + val;
          // update time cell if backend returned updated_at
          const timeCell = sel.closest('tr').querySelector('td:nth-child(8)');
          if (timeCell) {
            timeCell.textContent = json.updated_at ? new Date(json.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
          }
          sel.dataset.prev = val;
        } else {
          alert('Gagal menyimpan status');
          sel.value = sel.dataset.prev || '';
        }
      }).catch(()=>{ alert('Gagal menyimpan status'); sel.value = sel.dataset.prev || ''; });
    });

    // Delegate clicks for save/reject buttons
    document.addEventListener('click', async function(e){
      if (e.target.matches('.save-btn')) {
        const area = e.target.closest('.action-area');
        const id = area.dataset.id;
        const select = document.querySelector('.lead-status-select[data-id="'+id+'"]');
        const val = select.value;
        if (!val) return;
        try {
          const resp = await fetch('/sales/update-lead-status', { method: 'POST', headers: { 'Content-Type':'application/x-www-form-urlencoded' }, body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(val)}` });
          const j = await resp.json();
          if (j && j.success) {
            // update UI
            const prev = select.closest('td').querySelector('.text-xs'); if (prev) prev.textContent = 'Status DB: ' + (j.status || val);
            const prevStatus = select.dataset.prev || '';
            select.dataset.prev = j.status || val;
            // update time cell
            const timeCell = select.closest('tr').querySelector('td:nth-child(8)');
            if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
            area.querySelectorAll('.save-btn, .reject-btn').forEach(b=>b.classList.add('hidden'));
            // adjust NEW badge/count
            if (prevStatus === 'LEAD BARU' && (j.status || val) !== 'LEAD BARU') {
              const row = select.closest('tr'); row.classList.remove('new-lead-row'); const badge = row.querySelector('.pulse-badge'); if(badge) badge.remove(); updateNewLeadsCount(-1);
            } else if (prevStatus !== 'LEAD BARU' && (j.status || val) === 'LEAD BARU') {
              const row = select.closest('tr'); row.classList.add('new-lead-row'); updateNewLeadsCount(1);
            }
            alert('Status disimpan. Jika ada komisi untuk stage ini, akan ditambahkan ke dashboard affiliate.');
          } else {
            alert('Gagal menyimpan status');
          }
        } catch (err) { console.error(err); alert('Gagal menyimpan status'); }
      }

      if (e.target.matches('.reject-btn')) {
        const area = e.target.closest('.action-area');
        const id = area.dataset.id;
        const select = document.querySelector('.lead-status-select[data-id="'+id+'"]');
        // revert to previous
        select.value = select.dataset.prev || '';
        area.querySelectorAll('.save-btn, .reject-btn').forEach(b=>b.classList.add('hidden'));
      }

      if (e.target.matches('.reject-row-btn')) {
        const id = e.target.dataset.id;
        if (!confirm('Tandai lead ini sebagai REJECTED?')) return;
        try {
          const resp = await fetch('/sales/update-lead-status', { method: 'POST', headers: { 'Content-Type':'application/x-www-form-urlencoded' }, body: `id=${encodeURIComponent(id)}&lead_status=REJECTED` });
          const j = await resp.json();
          if (j && j.success) {
            const select = document.querySelector('.lead-status-select[data-id="'+id+'"]');
            const prevStatus = select ? (select.dataset.prev || '') : '';
            if (select) { select.value = 'REJECTED'; select.dataset.prev = 'REJECTED'; }
            const row = document.querySelector('tr td .action-area[data-id="'+id+'"]')?.closest('tr');
            if (row) {
              const statusEl = row.querySelector('.text-xs'); if (statusEl) statusEl.textContent = 'Status DB: ' + (j.status || 'REJECTED');
              const timeCell = row.querySelector('td:nth-child(8)'); if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
              // remove NEW indicator if it was new
              if (prevStatus === 'LEAD BARU') { row.classList.remove('new-lead-row'); const badge = row.querySelector('.pulse-badge'); if(badge) badge.remove(); updateNewLeadsCount(-1); }
            }
            // show undo option
            showUndoToast(id, prevStatus);
            alert('Lead ditandai REJECTED');
          } else { alert('Gagal menolak lead'); }
        } catch (err) { console.error(err); alert('Gagal menolak lead'); }
      }
    });

    // --- Helper functions for NEW badge and Undo toast (appended) ---
    function updateNewLeadsCount(delta) {
      try {
        const badge = document.getElementById('newLeadsBadge');
        const countEl = document.getElementById('newLeadsCount');
        let count = parseInt(countEl.textContent || '0', 10) || 0;
        count = count + (delta || 0);
        if (count < 0) count = 0;
        countEl.textContent = count;
        if (count > 0) badge.classList.remove('hidden'); else badge.classList.add('hidden');
      } catch (e) { console.error(e); }
    }

    function initNewLeadsBadge() {
      const initial = document.querySelectorAll('.new-lead-row').length;
      const countEl = document.getElementById('newLeadsCount');
      const badge = document.getElementById('newLeadsBadge');
      countEl.textContent = initial;
      if (initial > 0) badge.classList.remove('hidden'); else badge.classList.add('hidden');
    }

    // Undo toast handling
    let _undoTimer = null;
    let _lastRejected = null; // { id, prevStatus }
    function showUndoToast(id, prevStatus) {
      _lastRejected = { id, prevStatus };
      const toast = document.getElementById('undoToast');
      const msg = document.getElementById('undoMessage');
      msg.textContent = `Lead #${id} ditolak. Undo?`;
      toast.classList.add('show');
      if (_undoTimer) clearTimeout(_undoTimer);
      _undoTimer = setTimeout(() => { hideUndoToast(); _lastRejected = null; }, 8000);
    }
    function hideUndoToast() { const toast = document.getElementById('undoToast'); toast.classList.remove('show'); if (_undoTimer) { clearTimeout(_undoTimer); _undoTimer = null; }}

    document.getElementById('undoBtn')?.addEventListener('click', async function(){
      if (!_lastRejected) return;
      const id = _lastRejected.id; const prev = _lastRejected.prevStatus || 'LEAD BARU';
      try {
        const resp = await fetch('/sales/update-lead-status', { method: 'POST', headers: { 'Content-Type':'application/x-www-form-urlencoded' }, body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(prev)}` });
        const j = await resp.json();
        if (j && j.success) {
          // update UI
          const select = document.querySelector('.lead-status-select[data-id="'+id+'"]');
          if (select) { select.value = prev; select.dataset.prev = prev; }
          const row = select ? select.closest('tr') : document.querySelector('tr .action-area[data-id="'+id+'"]')?.closest('tr');
          if (row) {
            const statusEl = row.querySelector('.text-xs'); if (statusEl) statusEl.textContent = 'Status DB: ' + prev;
            const timeCell = row.querySelector('td:nth-child(8)'); if (timeCell) timeCell.textContent = j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
            // if returned to LEAD BARU, restore badge
            if (prev === 'LEAD BARU') { if (!row.classList.contains('new-lead-row')) { row.classList.add('new-lead-row'); const td = row.querySelector('td'); if (td && !td.querySelector('.pulse-badge')) { const sp = document.createElement('span'); sp.className = 'ml-2 pulse-badge'; sp.textContent = 'NEW'; td.appendChild(sp); } updateNewLeadsCount(1); } }
          }
          hideUndoToast(); _lastRejected = null;
          alert('Perubahan dibatalkan (undo).');
        } else { alert('Gagal mengembalikan status'); }
      } catch (err) { console.error(err); alert('Gagal mengembalikan status'); }
    });

    document.getElementById('dismissUndo')?.addEventListener('click', function(){ hideUndoToast(); _lastRejected = null; });

    // Initialize badge on page load
    initNewLeadsBadge();

    // --- Server-Sent Events (real-time updates) ---
    if (window.EventSource) {
      const es = new EventSource('/sales/lead-events');
      es.onopen = () => console.debug('SSE connected');
      es.onerror = (e) => console.error('SSE error', e);

      es.addEventListener('new_lead', function(e) {
        try {
          const d = JSON.parse(e.data);
          // prepend to leads table
          const tbody = document.querySelector('#tab-leads table tbody');
          if (tbody) {
            const tr = document.createElement('tr');
            tr.className = 'border-t hover:bg-gray-50 new-lead-row';
            tr.innerHTML = `
              <td class="p-3">#${d.id} <span class="ml-2 pulse-badge">NEW</span></td>
              <td class="p-3">${d.customer_name || '-'}</td>
              <td class="p-3">${d.affiliate_name || '-'}</td>
              <td class="p-3">${d.event_name || ('#' + (d.event_id || ''))}</td>
              <td class="p-3">Rp ${Number(d.total_amount || 0).toLocaleString('id-ID')}</td>
              <td class="p-3">-</td>
              <td class="p-3">
                <select class="lead-status-select border px-2 py-1 rounded" data-id="${d.id}" data-prev="LEAD BARU">
                  <option value="">-- pilih status --</option>
                  <option value="LEAD BARU" selected>LEAD BARU</option>
                  <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                  <option value="HOT">HOT</option>
                </select>
                <div class="text-xs text-gray-400 mt-1">Status DB: LEAD BARU</div>
                <div class="mt-2 action-area" data-id="${d.id}">
                  <button class="save-btn hidden px-3 py-1 bg-green-600 text-white rounded text-xs">Simpan</button>
                  <button class="reject-btn hidden px-3 py-1 bg-red-500 text-white rounded text-xs ml-2">Reject</button>
                </div>
              </td>
              <td class="p-3">${d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : new Date().toLocaleString('id-ID')}</td>
              <td class="p-3"><button class="reject-row-btn px-3 py-1 bg-red-500 text-white rounded text-xs" data-id="${d.id}">Reject</button></td>
            `;
            tbody.insertBefore(tr, tbody.firstChild);
            updateNewLeadsCount(1);
            // refresh filters/pagination
            applyFiltersAndPaginate({tableSelector:'#leadsTable', searchInputId:'leadsSearch', statusInputId:'leadsStatusFilter', rowsPerPageId:'leadsRowsPerPage', paginationId:'leadsPagination', totalId:'leadsTotal'});
          }
        } catch (err) { console.error('new_lead parse error', err); }
      });

      es.addEventListener('history', function(e) {
        try {
          const d = JSON.parse(e.data);
          // remove from leads table if present
          const leadsTbody = document.querySelector('#tab-leads table tbody');
          if (leadsTbody) {
            const row = leadsTbody.querySelector('.action-area[data-id="'+d.id+'"]')?.closest('tr');
            if (row) row.remove();
          }
          // prepend to history table
          const histTbody = document.querySelector('#tab-history table tbody');
          if (histTbody) {
            const tr = document.createElement('tr');
            tr.className = 'border-t';
            tr.setAttribute('data-id', d.id);
            tr.innerHTML = `
              <td class="p-2">#${d.id}</td>
              <td class="p-2">${d.customer_name || '-'}</td>
              <td class="p-2">${d.affiliate_name || '-'}</td>
              <td class="p-2">${d.event_name || '-'}</td>
              <td class="p-2">Rp ${Number(d.total_amount || 0).toLocaleString('id-ID')}</td>
              <td class="p-2">${d.status || '-'}</td>
              <td class="p-2">${d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : new Date().toLocaleString('id-ID')}</td>
              <td class="p-2">
                <select class="history-status-select border px-2 py-1 rounded text-sm">
                  <option value="">-- pilih status --</option>
                  <option value="LEAD BARU">LEAD BARU</option>
                  <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                  <option value="HOT">HOT</option>
                  <option value="DP">DP</option>
                  <option value="LUNAS">LUNAS</option>
                  <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                </select>
                <button class="history-restore-btn ml-2 px-2 py-1 bg-emerald-600 text-white rounded text-sm">Restore</button>
              </td>
            `;
            histTbody.insertBefore(tr, histTbody.firstChild);
            // refresh history pagination/filters
            applyFiltersAndPaginate({tableSelector:'#historyTable', searchInputId:'historySearch', rowsPerPageId:'historyRowsPerPage', paginationId:'historyPagination', totalId:'historyTotal'});
          }
        } catch (err) { console.error('history parse error', err); }
      });

      es.addEventListener('status_update', function(e) {
        try {
          const d = JSON.parse(e.data);
          // update status/time cells in leads table if present
          const leadsTbody = document.querySelector('#tab-leads table tbody');
          if (leadsTbody) {
            const row = leadsTbody.querySelector('.action-area[data-id="'+d.id+'"]')?.closest('tr');
            if (row) {
              const statusEl = row.querySelector('.text-xs'); if (statusEl) statusEl.textContent = 'Status DB: ' + (d.status || '-');
              const timeCell = row.querySelector('td:nth-child(8)'); if (timeCell) timeCell.textContent = d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID');
            }
          }
          // when status updates, rebuild history in case a lead aged into history or restored
          try { rebuildHistoryFromLeads(); } catch(e) {}
        } catch (err) { console.error('status_update parse error', err); }
      });
    }

    // --- Filtering & Pagination utilities for Leads & History ---
    function textMatch(row, query) {
      return row.textContent.toLowerCase().indexOf(query) !== -1;
    }

    function applyFiltersAndPaginate(opts) {
      // opts: {tableSelector, searchInputId, statusInputId (optional), rowsPerPageId, paginationId, totalId, rowClass}
      const table = document.querySelector(opts.tableSelector);
      if (!table) return;
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const searchVal = (document.getElementById(opts.searchInputId)?.value || '').toLowerCase().trim();
      const statusVal = opts.statusInputId ? (document.getElementById(opts.statusInputId)?.value || '') : '';

      // filter - special-case leads table to check specific columns/status reliably
      let filtered = rows.filter(r => !r.classList.contains('placeholder-row'));
      if (opts.tableSelector === '#leadsTable') {
        filtered = filtered.filter(r => {
          // search across ID, customer, affiliate, event columns
          const idCell = r.querySelector('td:nth-child(1)')?.textContent || '';
          const customer = r.querySelector('td:nth-child(2)')?.textContent || '';
          const affiliate = r.querySelector('td:nth-child(3)')?.textContent || '';
          const eventC = r.querySelector('td:nth-child(4)')?.textContent || '';
          const statusEl = r.querySelector('.text-xs');
          const statusText = statusEl ? statusEl.textContent.replace('Status DB:','').trim().toLowerCase() : (r.querySelector('.lead-status-select')?.value || '').toLowerCase();

          if (searchVal) {
            const hay = (idCell + ' ' + customer + ' ' + affiliate + ' ' + eventC).toLowerCase();
            if (hay.indexOf(searchVal) === -1) return false;
          }
          if (statusVal) {
            if (statusText.indexOf(statusVal.toLowerCase()) === -1) return false;
          }
          return true;
        });
      } else {
        // generic table filter
        filtered = filtered.filter(r => {
          if (searchVal) {
            if (!textMatch(r, searchVal)) return false;
          }
          return true;
        });
        // history doesn't use status filter
      }

      const rowsPerPage = parseInt(document.getElementById(opts.rowsPerPageId)?.value || '10', 10) || 10;
      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / rowsPerPage));
      let currentPage = parseInt(table.dataset.page || '1', 10) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      table.dataset.page = String(currentPage);

      // hide all rows, then show only filtered page
      rows.forEach(r => r.style.display = 'none');
      const start = (currentPage - 1) * rowsPerPage;
      const pageRows = filtered.slice(start, start + rowsPerPage);
      pageRows.forEach(r => r.style.display = 'table-row');

      // if no filtered rows, show placeholder row (create if missing)
      if (filtered.length === 0) {
        let ph = tbody.querySelector('.placeholder-row');
        if (!ph) {
          ph = document.createElement('tr'); ph.className = 'border-t placeholder-row';
          // create correct number of cells based on header
          const thCount = table.querySelectorAll('thead th').length || 7;
          for (let i=0;i<thCount;i++){ const td = document.createElement('td'); td.className='p-2'; td.textContent = '-'; ph.appendChild(td);} 
          tbody.appendChild(ph);
        }
        ph.style.display = 'table-row';
      } else {
        const ph = tbody.querySelector('.placeholder-row'); if (ph) ph.style.display = 'none';
      }

      // render pagination controls
      const pag = document.getElementById(opts.paginationId);
      if (pag) {
        pag.innerHTML = '';
        const prev = document.createElement('button'); prev.textContent = '‹ Prev'; prev.disabled = currentPage===1; prev.className='px-2 py-1 border rounded mr-2 text-sm';
        prev.addEventListener('click', ()=>{ table.dataset.page = String(Math.max(1, currentPage-1)); applyFiltersAndPaginate(opts); });
        pag.appendChild(prev);
        const span = document.createElement('span'); span.className='text-sm px-2'; span.textContent = `Halaman ${currentPage} / ${totalPages}`;
        pag.appendChild(span);
        const next = document.createElement('button'); next.textContent = 'Next ›'; next.disabled = currentPage===totalPages; next.className='px-2 py-1 border rounded ml-2 text-sm';
        next.addEventListener('click', ()=>{ table.dataset.page = String(Math.min(totalPages, currentPage+1)); applyFiltersAndPaginate(opts); });
        pag.appendChild(next);
      }

      const totalEl = document.getElementById(opts.totalId); if (totalEl) totalEl.textContent = String(total);
    }

    // Initialize table controls and wire events
    function initTableControls() {
      // leads
      ['leadsSearch','leadsStatusFilter','leadsRowsPerPage'].forEach(id => document.getElementById(id)?.addEventListener('input', ()=> applyFiltersAndPaginate({tableSelector:'#leadsTable', searchInputId:'leadsSearch', statusInputId:'leadsStatusFilter', rowsPerPageId:'leadsRowsPerPage', paginationId:'leadsPagination', totalId:'leadsTotal'})));
      // also support keyup on search for extra responsiveness
      document.getElementById('leadsSearch')?.addEventListener('keyup', ()=> applyFiltersAndPaginate({tableSelector:'#leadsTable', searchInputId:'leadsSearch', statusInputId:'leadsStatusFilter', rowsPerPageId:'leadsRowsPerPage', paginationId:'leadsPagination', totalId:'leadsTotal'}));
      document.getElementById('leadsRowsPerPage')?.addEventListener('change', ()=> applyFiltersAndPaginate({tableSelector:'#leadsTable', searchInputId:'leadsSearch', statusInputId:'leadsStatusFilter', rowsPerPageId:'leadsRowsPerPage', paginationId:'leadsPagination', totalId:'leadsTotal'}));
      // history
      document.getElementById('historySearch')?.addEventListener('input', ()=> applyFiltersAndPaginate({tableSelector:'#historyTable', searchInputId:'historySearch', rowsPerPageId:'historyRowsPerPage', paginationId:'historyPagination', totalId:'historyTotal'}));
      document.getElementById('historyRowsPerPage')?.addEventListener('change', ()=> applyFiltersAndPaginate({tableSelector:'#historyTable', searchInputId:'historySearch', rowsPerPageId:'historyRowsPerPage', paginationId:'historyPagination', totalId:'historyTotal'}));

      // initial run
      applyFiltersAndPaginate({tableSelector:'#leadsTable', searchInputId:'leadsSearch', statusInputId:'leadsStatusFilter', rowsPerPageId:'leadsRowsPerPage', paginationId:'leadsPagination', totalId:'leadsTotal'});
      applyFiltersAndPaginate({tableSelector:'#historyTable', searchInputId:'historySearch', rowsPerPageId:'historyRowsPerPage', paginationId:'historyPagination', totalId:'historyTotal'});
      // build initial history from leads (7-day rule)
      rebuildHistoryFromLeads();
    }

    // call after DOM ready
    document.addEventListener('DOMContentLoaded', function(){ initTableControls(); });

    // refresh pagination/filters when SSE adds rows
    const origNewLeadHandler = null; // placeholder

    // Rebuild history tab from leads: show leads whose `lead_updated_at` is older than 7 days
    function rebuildHistoryFromLeads() {
      try {
        const leadsTbody = document.querySelector('#leadsTable tbody');
        const historyTbody = document.querySelector('#historyTable tbody');
        if (!leadsTbody || !historyTbody) return;
        const rows = Array.from(leadsTbody.querySelectorAll('tr'));
        const now = Date.now();
        const sevenDays = 7 * 24 * 60 * 60 * 1000;
        rows.forEach(r => {
          const idCell = r.querySelector('td:nth-child(1)')?.textContent || '';
          const match = idCell.match(/#(\d+)/);
          const id = match ? match[1] : null;
          if (!id) return;
          const timeCell = r.querySelector('td:nth-child(8)')?.textContent || '';
          let updatedAt = null;
          try { updatedAt = new Date(timeCell); } catch (e) { updatedAt = null; }
          if (!updatedAt || isNaN(updatedAt.getTime())) return;
          const age = now - updatedAt.getTime();
          if (age >= sevenDays) {
            // ensure not already in history
            if (!historyTbody.querySelector('tr[data-id="'+id+'"]')) {
              // create history row
              const tr = document.createElement('tr'); tr.className = 'border-t history-row'; tr.setAttribute('data-id', id);
              const customer = r.querySelector('td:nth-child(2)')?.textContent || '-';
              const affiliate = r.querySelector('td:nth-child(3)')?.textContent || '-';
              const eventC = r.querySelector('td:nth-child(4)')?.textContent || '-';
              const amount = r.querySelector('td:nth-child(5)')?.textContent || '-';
              const statusText = r.querySelector('.text-xs') ? r.querySelector('.text-xs').textContent.replace('Status DB:','').trim() : (r.querySelector('.lead-status-select')?.value || '-');
              tr.innerHTML = `
                <td class="p-2">#${id}</td>
                <td class="p-2">${customer}</td>
                <td class="p-2">${affiliate}</td>
                <td class="p-2">${eventC}</td>
                <td class="p-2">${amount}</td>
                <td class="p-2">${statusText || '-'}</td>
                <td class="p-2">${new Date(updatedAt).toLocaleString()}</td>
                <td class="p-2">
                  <select class="history-status-select border px-2 py-1 rounded text-sm">
                    <option value="">-- pilih status --</option>
                    <option value="LEAD BARU">LEAD BARU</option>
                    <option value="SEDANG DI PROSPEK">SEDANG DI PROSPEK</option>
                    <option value="HOT">HOT</option>
                    <option value="DP">DP</option>
                    <option value="LUNAS">LUNAS</option>
                    <option value="SEDANG BERANGKAT">SEDANG BERANGKAT</option>
                  </select>
                  <button class="history-restore-btn ml-2 px-2 py-1 bg-emerald-600 text-white rounded text-sm">Restore</button>
                </td>
              `;
              historyTbody.insertBefore(tr, historyTbody.firstChild);
            }
          }
        });
        applyFiltersAndPaginate({tableSelector:'#historyTable', searchInputId:'historySearch', rowsPerPageId:'historyRowsPerPage', paginationId:'historyPagination', totalId:'historyTotal'});
      } catch (e) { console.error('rebuildHistoryFromLeads error', e); }
    }

    // handle restore action from history
    document.addEventListener('click', async function(e){
      if (e.target.matches('.history-restore-btn')) {
        const row = e.target.closest('tr');
        const idText = row.querySelector('td')?.textContent || '';
        const match = idText.match(/#(\d+)/);
        const id = match ? match[1] : null;
        const sel = row.querySelector('.history-status-select');
        const newStatus = sel ? sel.value : '';
        if (!id || !newStatus) { alert('Pilih status baru terlebih dahulu'); return; }
        if (!confirm('Ubah status lead #' + id + ' menjadi ' + newStatus + ' ?')) return;
        try {
          const resp = await fetch('/sales/update-lead-status', { method: 'POST', headers: { 'Content-Type':'application/x-www-form-urlencoded' }, body: `id=${encodeURIComponent(id)}&lead_status=${encodeURIComponent(newStatus)}` });
          const j = await resp.json();
          if (j && j.success) {
            // remove from history
            row.remove();
            // try to add a simple row to leads table top
            try {
              const leadsTbody = document.querySelector('#leadsTable tbody');
              if (leadsTbody) {
                const tr = document.createElement('tr'); tr.className = 'border-t hover:bg-gray-50';
                tr.innerHTML = `
                  <td class="p-3">#${id}</td>
                  <td class="p-3">${j.customer_name || '-'}</td>
                  <td class="p-3">${j.affiliate_name || '-'}</td>
                  <td class="p-3">${j.event_name || ('#' + (j.event_id||''))}</td>
                  <td class="p-3">Rp ${(Number(j.total_amount)||0).toLocaleString('id-ID')}</td>
                  <td class="p-3">-</td>
                  <td class="p-3">
                    <select class="lead-status-select border px-2 py-1 rounded" data-id="${id}" data-prev="${newStatus}">
                      <option value="">-- pilih status --</option>
                      <option value="LEAD BARU" ${newStatus==='LEAD BARU'?'selected':''}>LEAD BARU</option>
                      <option value="SEDANG DI PROSPEK" ${newStatus==='SEDANG DI PROSPEK'?'selected':''}>SEDANG DI PROSPEK</option>
                      <option value="HOT" ${newStatus==='HOT'?'selected':''}>HOT</option>
                      <option value="DP" ${newStatus==='DP'?'selected':''}>DP</option>
                      <option value="LUNAS" ${newStatus==='LUNAS'?'selected':''}>LUNAS</option>
                      <option value="SEDANG BERANGKAT" ${newStatus==='SEDANG BERANGKAT'?'selected':''}>SEDANG BERANGKAT</option>
                    </select>
                    <div class="text-xs text-gray-400 mt-1">Status DB: ${newStatus}</div>
                    <div class="mt-2 action-area" data-id="${id}">
                      <button class="save-btn hidden px-3 py-1 bg-green-600 text-white rounded text-xs">Simpan</button>
                      <button class="reject-btn hidden px-3 py-1 bg-red-500 text-white rounded text-xs ml-2">Reject</button>
                    </div>
                  </td>
                  <td class="p-3">${j.updated_at ? new Date(j.updated_at).toLocaleString('id-ID') : (new Date()).toLocaleString('id-ID')}</td>
                  <td class="p-3"><button class="reject-row-btn px-3 py-1 bg-red-500 text-white rounded text-xs" data-id="${id}">Reject</button></td>
                `;
                leadsTbody.insertBefore(tr, leadsTbody.firstChild);
                updateNewLeadsCount(newStatus==='LEAD BARU'?1:0);
                applyFiltersAndPaginate({tableSelector:'#leadsTable', searchInputId:'leadsSearch', statusInputId:'leadsStatusFilter', rowsPerPageId:'leadsRowsPerPage', paginationId:'leadsPagination', totalId:'leadsTotal'});
              }
            } catch (e) { console.error('add restored row error', e); }
            applyFiltersAndPaginate({tableSelector:'#historyTable', searchInputId:'historySearch', rowsPerPageId:'historyRowsPerPage', paginationId:'historyPagination', totalId:'historyTotal'});
            alert('Status diperbarui dan lead dipindahkan ke tab Leads');
          } else { alert('Gagal memperbarui status'); }
        } catch (err) { console.error(err); alert('Gagal memperbarui status'); }
      }
    });
  </script>
</body>
</html>
