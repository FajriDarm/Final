<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Verification - Affillink Finance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }

    .gradient-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-danger {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.1), 0 10px 10px -5px rgba(59, 130, 246, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
    }

    .gradient-primary:hover {
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }

    .gradient-success:hover {
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .gradient-danger:hover {
      box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.2);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>
    <!-- Sidebar -->
    <%- include('../sidebar/finance.ejs') %>

      <!-- Main Content -->
      <main class="ml-64 pt-16 min-h-screen">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-check-circle text-white text-xl"></i>
                </div>
                <div>
                  <!-- Table Footer -->
                  <p class="text-gray-600 mt-1">Verifikasi dan setujui pembayaran pelanggan</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Table Container -->
          <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
            <!-- Table Header -->
            <div class="px-6 py-4 gradient-primary">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-lg font-semibold text-white">Pembayaran Menunggu Verifikasi</h2>
                  <p class="text-green-100 text-sm mt-1">Review dan verifikasi pembayaran pelanggan</p>
                </div>
              </div>
            </div>

            <!-- Table Content -->
            <div class="overflow-x-auto">
              <!-- Tabs -->
              <div class="px-6 py-4 bg-green-50 border-b border-green-100 flex items-center gap-4">
                <button class="status-tab px-3 py-2 rounded-md font-medium bg-white shadow-sm" data-status="HOT">HOT <span class="ml-2 text-xs text-gray-500 badge-count" data-for="HOT">0</span></button>
                <button class="status-tab px-3 py-2 rounded-md font-medium bg-transparent text-green-800" data-status="DP">DP <span class="ml-2 text-xs text-gray-500 badge-count" data-for="DP">0</span></button>
                <div class="ml-auto text-sm text-gray-600">Pilih tab untuk melihat lead sesuai status</div>
              </div>

              <table class="w-full">
                <thead>
                  <tr class="bg-green-50">
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">ID</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Customer</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Affiliate</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Event</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Jumlah</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Metode Pembayaran</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Komisi</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Lead Status</th>
                    <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Aksi</th>
                  </tr>
                </thead>
                <tbody id="paymentsTableBody" class="divide-y divide-green-100">
                  <% if (pendingPayments && pendingPayments.length===0) { %>
                    <tr>
                      <td colspan="9" class="px-6 text-center">
                        <div class="flex flex-col items-center justify-center min-h-[300px] h-full w-full py-10">
                          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                            <i class="fas fa-inbox text-green-600 text-xl"></i>
                          </div>
                          <p class="text-gray-600 font-medium">Tidak ada pembayaran pending</p>
                          <p class="text-sm text-gray-500 mt-2">Semua pembayaran sudah diverifikasi</p>
                        </div>
                      </td>
                    </tr>
                    <% } else if (pendingPayments) { %>
                      <% pendingPayments.forEach(function(payment, index) { %>
                        <tr class="hover:bg-green-50 transition-colors data-cell" data-delay="<%= index * 50 %>" data-lead-status="<%= (payment.lead_status || '').toUpperCase() %>">
                          <td class="py-4 px-6">
                            <span class="text-sm font-medium text-gray-900">#<%= payment.id %></span>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-3">
                              <div
                                class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                                <i class="fas fa-user text-green-600"></i>
                              </div>
                              <div>
                                <div class="font-medium text-gray-900">
                                  <%= payment.customer_name %>
                                </div>
                                <div class="text-xs text-gray-500">Customer</div>
                              </div>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <div class="font-medium text-gray-900"><%= payment.affiliate_name || '-' %></div>
                            <div class="text-xs text-gray-500">Affiliate</div>
                          </td>
                          <td class="py-4 px-6">
                            <div class="font-medium text-gray-900"><%= payment.event_name || ('#'+payment.event_id) || '-' %></div>
                            <div class="text-xs text-gray-500">Event</div>
                          </td>
                          <td class="py-4 px-6">
                            <span class="font-bold text-green-700">Rp <%= parseInt(payment.total_amount ||
                                0).toLocaleString('id-ID') %></span>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-2">
                              <% if (payment.payment_method==='transfer' ) { %>
                                <i class="fas fa-bank text-green-600"></i>
                                <% } else { %>
                                  <i class="fas fa-money-bill-wave text-green-600"></i>
                                  <% } %>
                                    <span class="text-sm font-medium text-gray-700">
                                      <%= payment.payment_method ? payment.payment_method.toUpperCase() : 'N/A' %>
                                    </span>
                            </div>
                          </td>
                          <td class="py-4 px-6">
                            <% if (typeof payment.commission_amount !== 'undefined' && payment.commission_amount > 0) { %>
                              <span class="font-semibold text-green-700">Rp <%= Number(payment.commission_amount).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            <% } else if (payment.projected_commission) { %>
                              <span class="font-semibold text-green-700">Rp <%= parseFloat(payment.projected_commission).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                              <% if (payment.projected_stage && payment.projected_stage !== 2) { %>
                                <div class="text-xs text-gray-400 mt-1">(aktif pada stage <%= payment.projected_stage %>)</div>
                              <% } %>
                            <% } else { %>
                              <span class="text-gray-400">-</span>
                            <% } %>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-2">
                              <div class="text-sm text-gray-600"><%= payment.lead_status || '—' %></div>
                              <% if ((payment.lead_status || '').toUpperCase() === 'DP') { %>
                                <div class="px-2 py-0.5 rounded-full text-xs font-semibold text-amber-800 bg-amber-100">DP</div>
                              <% } else if ((payment.lead_status || '').toUpperCase() === 'HOT') { %>
                                <div class="px-2 py-0.5 rounded-full text-xs font-semibold text-green-800 bg-green-100">HOT</div>
                              <% } %>
                            </div>
                          </td>

                          <td class="py-4 px-6">
                            <span
                              class="px-3 py-1.5 rounded-full text-xs font-medium border border-yellow-200 bg-yellow-100 text-yellow-800 status-badge">
                              <i class="fas fa-hourglass-half mr-1.5"></i>
                              <%= payment.payment_status ? payment.payment_status.toUpperCase() : 'PENDING' %>
                            </span>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex flex-col gap-2">
                              <div class="text-sm text-gray-600">Lead Status: <span class="font-medium text-gray-800"><%= payment.lead_status || '—' %></span></div>
                              <div class="flex items-center gap-2">
                                <form data-action="set-lead-status" action="/finance/payment-verification/<%= payment.id %>/set-lead-status" method="POST" class="inline-flex items-center gap-2 finance-action-form">
                                  <select name="lead_status" class="px-2 py-1 border rounded text-sm">
                                    <option value="">-- pilih aksi --</option>
                                    <% if ((payment.lead_status || '').toUpperCase() === 'DP') { %>
                                      <option value="DP" disabled>DP (sudah DP)</option>
                                    <% } else { %>
                                      <option value="DP">DP</option>
                                    <% } %>
                                    <option value="LUNAS">LUNAS</option>
                                  </select>
                                  <button type="submit" class="px-3 py-2 gradient-success text-white rounded-lg text-xs font-medium hover:shadow-lg transition inline-flex items-center gap-1" data-confirm="Simpan perubahan status?">
                                    <i class="fas fa-check-circle"></i>
                                    Simpan
                                  </button>
                                </form>
                                <form data-action="reject" action="/finance/payment-verification/<%= payment.id %>/reject" method="POST" class="inline finance-action-form">
                                  <button type="submit" class="px-3 py-2 gradient-danger text-white rounded-lg text-xs font-medium hover:shadow-lg transition inline-flex items-center gap-1" data-confirm="Tolak pembayaran ini?">
                                    <i class="fas fa-times-circle"></i>
                                    Reject
                                  </button>
                                </form>
                              </div>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                          <% } %>
                </tbody>
              </table>
            </div>

            <!-- Table Footer -->
            <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
                <div class="text-green-700 font-medium">
                  Total menunggu verifikasi: <span class="font-semibold text-green-700">
                    <%= pendingPayments ? pendingPayments.length : 0 %>
                  </span> pembayaran
                </div>
                <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
              </div>
            </div>
          </div>
        </div>
      </main>
  <script>
    // Apply animation delay values from data-delay attributes (avoids EJS in inline style)
    document.querySelectorAll('[data-delay]').forEach(function(el){
      try { el.style.animationDelay = (el.dataset.delay || '0') + 'ms'; } catch(e){}
    });

    // Intercept finance forms and submit via fetch (keeps same-origin cookies and avoids page redirect issues)
    document.addEventListener('submit', function(e){
      const form = e.target;
      if (!form.classList.contains('finance-action-form')) return; // ignore other forms
      e.preventDefault();

      const confirmMsg = form.querySelector('[data-confirm]')?.getAttribute('data-confirm');
      if (confirmMsg && !confirm(confirmMsg)) return;

      const action = form.getAttribute('action');
      const method = (form.getAttribute('method') || 'POST').toUpperCase();
      const formData = new URLSearchParams(new FormData(form));

      // disable controls while request is in-flight
      const controls = form.querySelectorAll('select, button');
      controls.forEach(c => c.disabled = true);
      fetch(action, {
        method,
        body: formData,
        credentials: 'same-origin',
        headers: {
          'Accept': 'text/html, application/json'
        }
      }).then(async res => {
        controls.forEach(c => c.disabled = false);
        if (res.ok || res.status === 302) {
          // reload to reflect new changes
          window.location.reload();
        } else {
          let msg = res.statusText;
          try {
            const json = await res.json();
            msg = json && json.message ? json.message : JSON.stringify(json);
          } catch (e) {
            // not json
            try { msg = await res.text(); } catch (e2) {}
          }
          alert('Gagal menyimpan: ' + (msg || res.statusText));
          console.error('Save error', res.status, msg);
        }
      }).catch(err => {
        controls.forEach(c => c.disabled = false);
        console.error(err);
        alert('Gagal menyimpan: ' + err.message);
      });
    });

    // Debug: fetch current user info to assist troubleshooting and disable actions for non-finance
    fetch('/api/whoami', { credentials: 'same-origin' }).then(r => r.json()).then(j => {
      console.log('whoami:', j);
      const role = j && j.user && j.user.role;
      // Disable non-finance actions
      if (role !== 'finance') {
        document.querySelectorAll('.finance-action-form').forEach(f => {
          f.querySelectorAll('select, button').forEach(el => el.disabled = true);
        });
        const notice = document.createElement('div');
        notice.className = 'text-sm text-red-600 mt-2';
        notice.textContent = 'Anda tidak memiliki izin mengubah status pada halaman ini. Silakan login sebagai Finance.';
        const container = document.querySelector('.glass-card .px-6.py-4') || document.querySelector('.glass-card');
        if (container) container.insertBefore(notice, container.firstChild);
      }

      // Set up tabs: show HOT by default
      function updateTabs(active){
        document.querySelectorAll('.status-tab').forEach(btn => {
          const s = btn.dataset.status;
          btn.classList.toggle('bg-white', s===active);
          btn.classList.toggle('text-green-800', s!==active);
          btn.classList.toggle('bg-transparent', s!==active);
        });
        // Show/hide rows
        document.querySelectorAll('#paymentsTableBody tr[data-lead-status]').forEach(tr => {
          const s = tr.dataset.leadStatus || '';
          tr.style.display = (s === active) ? '' : 'none';
        });
      }

      document.querySelectorAll('.status-tab').forEach(btn => {
        btn.addEventListener('click', function(){ updateTabs(this.dataset.status); });
      });

      // initialize counts and default tab
      const counts = { HOT:0, DP:0 };
      document.querySelectorAll('#paymentsTableBody tr[data-lead-status]').forEach(tr => {
        const s = (tr.dataset.leadStatus || '').toUpperCase();
        if (counts[s] !== undefined) counts[s]++;
      });
      Object.keys(counts).forEach(k => {
        const el = document.querySelector('.badge-count[data-for="'+k+'"]'); if (el) el.textContent = counts[k];
      });
      updateTabs('HOT');

      // Polling: when HOT tab active, poll every 10s and reload if result changed
      let lastIds = Array.from(document.querySelectorAll('#paymentsTableBody tr[data-lead-status]')).map(r => r.dataset.leadStatus + ':' + r.querySelector('.text-sm.font-medium')?.textContent.trim()).join(',');
      setInterval(async ()=>{
        const activeTab = document.querySelector('.status-tab.bg-white')?.dataset.status || 'HOT';
        if (activeTab !== 'HOT') return; // only poll when HOT active
        try {
          const res = await fetch('/finance/payment-verification/api', { credentials: 'same-origin' });
          if (!res.ok) return;
          const j = await res.json();
          const ids = (j && j.pendingPayments || []).filter(p=> (p.lead_status||'').toUpperCase()==='HOT').map(p=> 'HOT:'+p.id).join(',');
          if (ids !== lastIds) {
            // reload page to reflect new items
            console.log('pending HOT changed, reloading...');
            window.location.reload();
          }
        } catch (e) { console.error('poll error', e); }
      }, 10000);

    }).catch(()=>{});
  </script>
  </script>
</body>

</html>