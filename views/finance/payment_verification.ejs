"<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Verification</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>
  <!-- Sidebar -->
  <%- include('../sidebar/finance.ejs') %>
  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <h1 class="text-2xl font-bold mb-4 text-gray-900">Payment Verification</h1>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-white rounded-xl shadow-sm border border-gray-100">
          <thead>
            <tr class="bg-yellow-100 text-yellow-800">
              <th class="py-3 px-4 text-left">ID</th>
              <th class="py-3 px-4 text-left">Customer</th>
              <th class="py-3 px-4 text-left">Amount</th>
              <th class="py-3 px-4 text-left">Payment Method</th>
              <th class="py-3 px-4 text-left">Created At</th>
              <th class="py-3 px-4 text-left">Komisi</th>
              <th class="py-3 px-4 text-left">Status</th>
              <th class="py-3 px-4 text-left">Aksi</th>"
            </tr>
          </thead>
          <tbody>
              <% if (pendingPayments.length === 0) { %>
              <tr>
                <td colspan="7" class="py-4 px-4 text-center text-gray-400">Tidak ada pembayaran pending.</td>
              </tr>
            <% } else { %>
              <% pendingPayments.forEach(payment => { %>
                <tr class="border-b hover:bg-yellow-50">
                  <td class="py-2 px-4"><%= payment.id %></td>
                  <td class="py-2 px-4"><%= payment.customer_name %></td>
                  <td class="py-2 px-4">Rp <%= parseInt(payment.total_amount).toLocaleString('id-ID') %></td>
                  <td class="py-2 px-4"><%= payment.payment_method %></td>
                  <td class="py-2 px-4"><%= new Date(payment.created_at).toLocaleString('id-ID') %></td>
                  <td class="py-2 px-4">
                    <% if (typeof payment.projected_commission !== 'undefined' && payment.projected_commission !== null) { %>
                      Rp <%= parseFloat(payment.projected_commission).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="py-2 px-4">
                    <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-yellow-200 text-yellow-800">
                      <%= payment.payment_status %>
                    </span>
                  </td>
                  <td class="py-2 px-4">
                    <div class="flex items-center gap-2">
                      <form action="/finance/payment-verification/<%= payment.id %>/approve" method="POST" onsubmit="return confirm('Approve pembayaran ini?');">
                        <button type="submit" class="px-3 py-1 bg-green-500 text-white rounded text-sm">Approve</button>
                      </form>
                      <form action="/finance/payment-verification/<%= payment.id %>/reject" method="POST" onsubmit="return confirm('Reject pembayaran ini?');">
                        <button type="submit" class="px-3 py-1 bg-red-500 text-white rounded text-sm">Reject</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
