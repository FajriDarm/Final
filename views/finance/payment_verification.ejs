"<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Verification - Affillink Finance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }

    .gradient-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-danger {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.1), 0 10px 10px -5px rgba(59, 130, 246, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
    }
  </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>
  <!-- Sidebar -->
  <%- include('../sidebar/finance.ejs') %>
  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
        <div class="mb-4 md:mb-0">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
              <i class="fas fa-check-circle text-white text-xl"></i>
            </div>
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Payment Verification</h1>
              <p class="text-gray-600 mt-1">Verifikasi dan setujui pembayaran pelanggan</p>
            </div>
          </div>
        </div>
      </div>

      <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
        <div class="px-6 py-4 gradient-primary">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold text-white">Pembayaran Menunggu Verifikasi</h2>
              <p class="text-green-100 text-sm mt-1">Review dan verifikasi pembayaran pelanggan</p>
            </div>
          </div>
        </div>
        
        <div class="p-0">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="bg-green-50">
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">ID</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Customer</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Jumlah</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Metode Pembayaran</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Tanggal</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Komisi</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Status</th>
                  <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Aksi</th>
                </tr>
              </thead>
              <tbody id="paymentsTableBody" class="divide-y divide-green-100">
                <% if (pendingPayments && pendingPayments.length === 0) { %>
                  <tr style="height:300px;">
                    <td colspan="8" class="px-6 text-center h-full align-middle">
                      <div class="flex flex-col items-center justify-center min-h-[300px] h-full w-full">
                        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                          <i class="fas fa-inbox text-green-600 text-xl"></i>
                        </div>
                        <p class="text-gray-600 font-medium">Tidak ada pembayaran pending</p>
                        <p class="text-sm text-gray-500 mt-2">Semua pembayaran sudah diverifikasi</p>
                      </div>
                    </td>
                  </tr>
                <% } else if (pendingPayments) { %>
                  <% pendingPayments.forEach(function(payment, index) { %>
                    <tr class="hover:bg-green-50 transition-colors data-cell" style="animation-delay: <%= index * 50 %>ms">
                      <td class="py-4 px-6">
                        <span class="text-sm font-medium text-gray-900">#<%= payment.id %></span>
                      </td>
                      <td class="py-4 px-6">
                        <div class="flex items-center gap-3">
                          <div class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-user text-green-600"></i>
                          </div>
                          <div>
                            <div class="font-medium text-gray-900"><%= payment.customer_name %></div>
                            <div class="text-xs text-gray-500">Customer</div>
                          </div>
                        </div>
                      </td>
                      <td class="py-4 px-6">
                        <span class="font-bold text-green-700">Rp <%= parseInt(payment.total_amount || 0).toLocaleString('id-ID') %></span>
                      </td>
                      <td class="py-4 px-6">
                        <div class="flex items-center gap-2">
                          <% if (payment.payment_method === 'transfer') { %>
                            <i class="fas fa-bank text-green-600"></i>
                          <% } else { %>
                            <i class="fas fa-money-bill-wave text-green-600"></i>
                          <% } %>
                          <span class="text-sm font-medium text-gray-700"><%= payment.payment_method ? payment.payment_method.toUpperCase() : 'N/A' %></span>
                        </div>
                      </td>
                      <td class="py-4 px-6">
                        <span class="text-sm text-gray-600"><%= new Date(payment.created_at).toLocaleDateString('id-ID') %></span>
                      </td>
                      <td class="py-4 px-6">
                        <% if (typeof payment.projected_commission !== 'undefined' && payment.projected_commission !== null) { %>
                          <span class="font-semibold text-green-700">Rp <%= parseFloat(payment.projected_commission).toLocaleString('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                        <% } else { %>
                          <span class="text-gray-400">-</span>
                        <% } %>
                      </td>
                      <td class="py-4 px-6">
                        <span class="px-3 py-1.5 rounded-full text-xs font-medium border border-yellow-200 bg-yellow-100 text-yellow-800 status-badge">
                          <i class="fas fa-hourglass-half mr-1.5"></i>
                          <%= payment.payment_status ? payment.payment_status.toUpperCase() : 'PENDING' %>
                        </span>
                      </td>
                      <td class="py-4 px-6">
                        <div class="flex items-center gap-2">
                          <form action="/finance/payment-verification/<%= payment.id %>/approve" method="POST" onsubmit="return confirm('Setujui pembayaran ini?');" class="inline">
                            <button type="submit" class="px-3 py-2 bg-gradient-success text-white rounded-lg text-xs font-medium hover:shadow-lg transition inline-flex items-center gap-1">
                              <i class="fas fa-check-circle"></i>
                              Approve
                            </button>
                          </form>
                          <form action="/finance/payment-verification/<%= payment.id %>/reject" method="POST" onsubmit="return confirm('Tolak pembayaran ini?');" class="inline">
                            <button type="submit" class="px-3 py-2 bg-gradient-danger text-white rounded-lg text-xs font-medium hover:shadow-lg transition inline-flex items-center gap-1">
                              <i class="fas fa-times-circle"></i>
                              Reject
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <div class="mt-6 px-6 py-4 bg-green-50 border border-green-100 rounded-2xl">
        <div class="flex items-center justify-between text-sm">
          <p class="text-gray-600">Total menunggu verifikasi: <span class="font-semibold text-green-700"><%= pendingPayments ? pendingPayments.length : 0 %> pembayaran</span></p>
          <span class="text-gray-500">Terakhir diperbarui: Sekarang</span>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const style = document.createElement('style');
      style.textContent = `
        .bg-gradient-success {
          background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        .bg-gradient-success:hover {
          box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
        }
        .bg-gradient-danger {
          background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }
        .bg-gradient-danger:hover {
          box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.2);
        }
      `;
      document.head.appendChild(style);
    });
  </script>
</body>
</html>
