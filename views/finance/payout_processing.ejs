<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payout Processing</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>
  <!-- Sidebar -->
  <%- include('../sidebar/finance.ejs') %>
  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <h1 class="text-2xl font-bold mb-4 text-gray-900">Payout Processing</h1>
      <div class="overflow-x-auto">
        <table class="min-w-full bg-white rounded-xl shadow-sm border border-gray-100">
          <thead>
            <tr class="bg-yellow-100 text-yellow-800">
              <th class="py-3 px-4 text-left">ID</th>
              <th class="py-3 px-4 text-left">Affiliate</th>
              <th class="py-3 px-4 text-left">Total Amount</th>
              <th class="py-3 px-4 text-left">Approved By</th>
              <th class="py-3 px-4 text-left">Processed At</th>
              <th class="py-3 px-4 text-left">Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (payouts.length === 0) { %>
              <tr>
                <td colspan="6" class="py-4 px-4 text-center text-gray-400">Tidak ada payout yang perlu diproses.</td>
              </tr>
            <% } else { %>
              <% payouts.forEach(payout => { %>
                <tr class="border-b hover:bg-yellow-50">
                  <td class="py-2 px-4"><%= payout.id %></td>
                  <td class="py-2 px-4"><%= payout.affiliate_name %></td>
                  <td class="py-2 px-4">Rp <%= parseInt(payout.total_amount).toLocaleString('id-ID') %></td>
                  <td class="py-2 px-4"><%= payout.approved_by ? payout.approved_by : '-' %></td>
                  <td class="py-2 px-4"><%= payout.processed_at ? new Date(payout.processed_at).toLocaleString('id-ID') : '-' %></td>
                  <td class="py-2 px-4">
                    <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-yellow-200 text-yellow-800">
                      <%= payout.status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
