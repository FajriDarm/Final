<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payout Processing - Affillink Finance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(59, 130, 246, 0.1), 0 10px 10px -5px rgba(59, 130, 246, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
    }
  </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>
  <!-- Sidebar -->
  <%- include('../sidebar/finance.ejs') %>
  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
        <div class="mb-4 md:mb-0">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
              <i class="fas fa-credit-card text-white text-xl"></i>
            </div>
            <div>
              <h1 class="text-3xl font-bold text-gray-900">Payout Processing</h1>
              <p class="text-gray-600 mt-1">Kelola dan proses pembayaran payout affiliate</p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/finance/withdrawals" class="px-4 py-2 gradient-primary text-white rounded-lg hover:shadow-lg transition text-sm inline-flex items-center gap-2">
            <i class="fas fa-clipboard-list"></i>
            Manage Withdrawals
          </a>
        </div>
      </div>

      <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
        <div class="px-6 py-4 gradient-primary">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold text-white">Daftar Payout Diproses</h2>
              <p class="text-green-100 text-sm mt-1">Payout yang sedang dalam proses pembayaran</p>
            </div>
          </div>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
            <tr class="bg-green-50">
              <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">ID</th>
              <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Affiliate</th>
              <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Jumlah Total</th>
              <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Disetujui Oleh</th>
              <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Tanggal Pembayaran</th>
              <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Status</th>
              </tr>
            </thead>
            <tbody id="payoutsTableBody" class="divide-y divide-green-100">
              <% if (payouts && payouts.length === 0) { %>
                <tr style="height:300px;">
                  <td colspan="6" class="px-6 text-center h-full align-middle">
                    <div class="flex flex-col items-center justify-center min-h-[300px] h-full w-full">
                      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                        <i class="fas fa-inbox text-green-600 text-xl"></i>
                      </div>
                      <p class="text-gray-600 font-medium">Tidak ada payout dalam proses</p>
                      <p class="text-sm text-gray-500 mt-2">Semua payout sudah diproses atau belum ada</p>
                    </div>
                  </td>
                </tr>
              <% } else if (payouts) { %>
                <% payouts.forEach(function(payout, index) { %>
                  <tr class="hover:bg-green-50 transition-colors data-cell" style="animation-delay: <%= index * 50 %>ms">
                    <td class="py-4 px-6">
                      <span class="text-sm font-medium text-gray-900">#<%= payout.id %></span>
                    </td>
                    <td class="py-4 px-6">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                          <i class="fas fa-user-tie text-green-600"></i>
                        </div>
                        <div>
                          <div class="font-medium text-gray-900"><%= payout.affiliate_name %></div>
                          <div class="text-xs text-gray-500">Affiliate</div>
                        </div>
                      </div>
                    </td>
                    <td class="py-4 px-6">
                      <span class="font-bold text-lg text-green-700">Rp <%= parseInt(payout.total_amount || 0).toLocaleString('id-ID') %></span>
                    </td>
                    <td class="py-4 px-6">
                      <div class="flex items-center gap-2">
                        <i class="fas fa-shield-alt text-purple-600"></i>
                        <span class="text-sm font-medium text-gray-700"><%= payout.admin_approved_name ? payout.admin_approved_name : '-' %></span>
                      </div>
                    </td>
                    <td class="py-4 px-6">
                      <span class="text-sm text-gray-600"><%= payout.paid_at ? new Date(payout.paid_at).toLocaleDateString('id-ID') : '-' %></span>
                    </td>
                    <td class="py-4 px-6">
                      <span class="px-3 py-1.5 rounded-full text-xs font-medium border border-green-200 bg-green-100 text-green-800 status-badge">
                        <i class="fas fa-circle mr-1.5 text-green-600"></i>
                        <%= payout.status ? payout.status.toUpperCase() : 'PROCESSING' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
            <div class="text-green-700 font-medium">
              Total dalam proses: <span class="font-semibold text-green-700"><%= payouts ? payouts.length : 0 %></span> payout
            </div>
            <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .gradient-primary:hover {
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }
  </style>
</body>
</html>
