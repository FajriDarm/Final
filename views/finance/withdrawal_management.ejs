<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manajemen Penarikan - Affillink Finance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }

    .gradient-warning {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .gradient-info {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    }

    .gradient-danger {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
    }

    .gradient-primary:hover {
      box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.2);
    }

    .gradient-secondary:hover {
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .gradient-warning:hover {
      box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.2);
    }

    .gradient-info:hover {
      box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
    }

    .gradient-danger:hover {
      box-shadow: 0 10px 15px -3px rgba(239, 68, 68, 0.2);
    }

    .gradient-accent:hover {
      box-shadow: 0 10px 15px -3px rgba(52, 211, 153, 0.2);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs') %>

    <!-- Main Content -->
    <main class="ml-64 pt-16 min-h-screen">
      <div class="p-6">
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
          <div class="mb-4 md:mb-0">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                <i class="fas fa-file-invoice-dollar text-white text-xl"></i>
              </div>
              <div>
                <h1 class="text-3xl font-bold text-gray-900">Manajemen Penarikan Komisi</h1>
                <p class="text-gray-600 mt-1">Review penarikan dari affiliate dan submit ke Admin untuk persetujuan</p>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
              <div class="flex items-center gap-2">
                <i class="fas fa-calendar-alt text-green-600"></i>
                <span class="text-sm font-medium text-gray-700">
                  <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                    day: 'numeric' }) %>
                </span>
              </div>
            </div>
            <div class="px-4 py-2 gradient-primary rounded-lg shadow-lg text-white">
              <div class="flex items-center gap-2">
                <i class="fas fa-bell pulse-animation"></i>
                <span class="text-sm font-medium">Update Real-time</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Total Pembayaran Masuk</p>
                <p class="text-2xl font-bold text-gray-900 mt-2">Rp <%= parseInt((stats && stats.totalPaid) ||
                    0).toLocaleString('id-ID') %>
                </p>
              </div>
              <div class="w-12 h-12 gradient-primary rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-money-bill-wave text-white text-xl"></i>
              </div>
            </div>
          </div>

          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Total Pembayaran Pending</p>
                <p class="text-2xl font-bold text-gray-900 mt-2">Rp <%= parseInt((stats && stats.totalPending) ||
                    0).toLocaleString('id-ID') %>
                </p>
              </div>
              <div class="w-12 h-12 gradient-warning rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-clock text-white text-xl"></i>
              </div>
            </div>
          </div>

          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Transaksi Paid</p>
                <p class="text-2xl font-bold text-gray-900 mt-2">
                  <%= (stats && stats.countPaid) || 0 %>
                </p>
              </div>
              <div class="w-12 h-12 gradient-info rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-check-circle text-white text-xl"></i>
              </div>
            </div>
          </div>

          <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm font-medium">Transaksi Pending</p>
                <p class="text-2xl font-bold text-gray-900 mt-2">
                  <%= (stats && stats.countPending) || 0 %>
                </p>
              </div>
              <div class="w-12 h-12 gradient-accent rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-hourglass-half text-white text-xl"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Workflow Diagram -->
        <div class="glass-card rounded-2xl shadow-lg p-6 mb-8 border border-green-100">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Alur Persetujuan Penarikan</h3>
          <div class="flex items-center justify-center gap-4 flex-wrap">
            <div class="text-center">
              <div
                class="w-16 h-16 mx-auto bg-white ring-2 ring-emerald-100 rounded-full flex items-center justify-center mb-2 shadow-sm">
                <i class="fas fa-user text-emerald-600 text-xl"></i>
              </div>
              <p class="text-sm font-semibold text-gray-900">Affiliate</p>
              <p class="text-xs text-gray-600">Request Withdrawal</p>
            </div>
            <div class="text-gray-400 text-2xl">→</div>
            <div class="text-center">
              <div
                class="w-16 h-16 mx-auto bg-white ring-2 ring-green-100 rounded-full flex items-center justify-center mb-2 shadow-sm">
                <i class="fas fa-building text-green-600 text-xl"></i>
              </div>
              <p class="text-sm font-semibold text-gray-900">Finance</p>
              <p class="text-xs text-gray-600">Review & Submit</p>
            </div>
            <div class="text-gray-400 text-2xl">→</div>
            <div class="text-center">
              <div
                class="w-16 h-16 mx-auto bg-white ring-2 ring-purple-100 rounded-full flex items-center justify-center mb-2 shadow-sm">
                <i class="fas fa-shield-alt text-purple-600 text-xl"></i>
              </div>
              <p class="text-sm font-semibold text-gray-900">Admin</p>
              <p class="text-xs text-gray-600">Approve/Reject</p>
            </div>
            <div class="text-gray-400 text-2xl">→</div>
            <div class="text-center">
              <div
                class="w-16 h-16 mx-auto bg-white ring-2 ring-yellow-100 rounded-full flex items-center justify-center mb-2 shadow-sm">
                <i class="fas fa-money-bill-wave text-yellow-600 text-xl"></i>
              </div>
              <p class="text-sm font-semibold text-gray-900">Finance</p>
              <p class="text-xs text-gray-600">Transfer & Mark Paid</p>
            </div>
          </div>
        </div>

        <!-- Main Content Container -->
        <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden">
          <!-- Tabs Header -->
          <div class="px-6 py-4 gradient-primary">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-lg font-semibold text-white">Daftar Penarikan Komisi</h2>
                <p class="text-green-100 text-sm mt-1">Review dan kelola permintaan penarikan affiliate</p>
              </div>
            </div>
          </div>

          <!-- Tabs Navigation -->
          <div class="px-6 py-3 bg-green-50 border-b border-green-100">
            <div class="flex space-x-2">
              <button onclick="switchTab('pending')"
                class="tab-btn active flex-none px-4 py-2 rounded-lg font-medium bg-emerald-600 text-white shadow-sm transition transform hover:scale-105">
                <i class="fas fa-hourglass-half mr-2"></i>
                Pending
                <span id="pending-count" class="ml-2 bg-white/30 px-2 py-0.5 rounded-full text-xs">0</span>
              </button>
              <button onclick="switchTab('approved')"
                class="tab-btn flex-none px-4 py-2 rounded-lg font-medium bg-transparent text-gray-700 hover:bg-green-100 transition">
                <i class="fas fa-check-circle mr-2"></i>
                Approved
                <span id="approved-count"
                  class="ml-2 bg-green-100 text-green-800 px-2 py-0.5 rounded-full text-xs">0</span>
              </button>
              <button onclick="switchTab('paid')"
                class="tab-btn flex-none px-4 py-2 rounded-lg font-medium bg-transparent text-gray-700 hover:bg-green-100 transition">
                <i class="fas fa-check-double mr-2"></i>
                Paid
                <span id="paid-count"
                  class="ml-2 bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full text-xs">0</span>
              </button>
              <button onclick="switchTab('rejected')"
                class="tab-btn flex-none px-4 py-2 rounded-lg font-medium bg-transparent text-gray-700 hover:bg-red-50 transition">
                <i class="fas fa-times-circle mr-2"></i>
                Rejected
                <span id="rejected-count" class="ml-2 bg-red-100 text-red-800 px-2 py-0.5 rounded-full text-xs">0</span>
              </button>
            </div>
          </div>

          <!-- Tabs Content -->
          <div class="p-6">
            <!-- Pending Tab -->
            <div id="pending-tab" class="tab-content">
              <div id="pending-list" class="space-y-4">
                <div class="text-center py-12 text-gray-500">
                  <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
                  <p>Memuat data penarikan pending...</p>
                </div>
              </div>
            </div>

            <!-- Approved Tab -->
            <div id="approved-tab" class="tab-content hidden">
              <div id="approved-list" class="space-y-4">
                <div class="text-center py-12 text-gray-500">
                  <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
                  <p>Memuat data penarikan yang disetujui...</p>
                </div>
              </div>
            </div>

            <!-- Paid Tab -->
            <div id="paid-tab" class="tab-content hidden">
              <div id="paid-list" class="space-y-4">
                <div class="text-center py-12 text-gray-500">
                  <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
                  <p>Memuat data penarikan yang sudah dibayar...</p>
                </div>
              </div>
            </div>

            <!-- Rejected Tab -->
            <div id="rejected-tab" class="tab-content hidden">
              <div id="rejected-list" class="space-y-4">
                <div class="text-center py-12 text-gray-500">
                  <i class="fas fa-spinner fa-spin text-2xl mb-4 text-emerald-600"></i>
                  <p>Memuat data penarikan yang ditolak...</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Footer Stats -->
          <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
              <div class="text-green-700 font-medium">
                Total dalam sistem: <span class="font-semibold text-green-700" id="total-count">0</span> penarikan
              </div>
              <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Sidebar -->
    <%- include('../sidebar/finance.ejs') %>

      <!-- Detail Modal -->
      <div id="detail-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="glass-card rounded-2xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
          <div class="sticky top-0 bg-white border-b px-6 py-4 flex justify-between items-center">
            <h3 class="text-xl font-bold text-gray-900" id="detail-title">Detail Penarikan</h3>
            <button onclick="closeDetailModal()" class="text-gray-500 hover:text-gray-700">
              <i class="fas fa-times text-xl"></i>
            </button>
          </div>
          <div id="detail-content" class="p-6">
            <!-- Content loaded dynamically -->
          </div>
        </div>
      </div>

      <!-- Submit Modal -->
      <div id="submit-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full">
          <div class="bg-gradient-primary text-white rounded-t-2xl px-6 py-4">
            <h3 class="text-lg font-bold">
              <i class="fas fa-paper-plane mr-2"></i>
              Submit ke Admin
            </h3>
          </div>
          <div class="p-6">
            <div id="submit-info" class="mb-6 p-4 bg-emerald-50 rounded-lg">
              <p class="text-gray-700"><strong>Affiliate:</strong> <span id="submit-affiliate"></span></p>
              <p class="text-gray-700 mt-2"><strong>Jumlah:</strong> <span id="submit-amount"></span></p>
            </div>
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-2">Catatan untuk Admin (opsional)</label>
              <textarea id="submit-note"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                rows="3" placeholder="Tambahkan catatan untuk Admin..."></textarea>
            </div>
          </div>
          <div class="bg-gray-50 border-t px-6 py-4 flex gap-3">
            <button onclick="closeSubmitModal()"
              class="flex-1 px-4 py-3 border border-gray-300 rounded-lg font-medium text-gray-700 hover:bg-gray-50 transition">
              Batal
            </button>
            <button onclick="submitToAdmin()"
              class="flex-1 px-4 py-3 bg-emerald-600 text-white rounded-lg font-medium hover:bg-emerald-700 transition">
              <i class="fas fa-paper-plane mr-2"></i>
              Submit
            </button>
          </div>
        </div>
      </div>

      <!-- Mark Paid Modal -->
      <div id="paid-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full">
          <div class="bg-gradient-primary text-white rounded-t-2xl px-6 py-4">
            <h3 class="text-lg font-bold">
              <i class="fas fa-check-double mr-2"></i>
              Tandai Sudah Dibayar
            </h3>
          </div>
          <div class="p-6">
            <div id="paid-info" class="mb-6 p-4 bg-emerald-50 rounded-lg">
              <p class="text-gray-700"><strong>Affiliate:</strong> <span id="paid-affiliate"></span></p>
              <p class="text-gray-700 mt-2"><strong>Jumlah:</strong> <span id="paid-amount"></span></p>
              <p class="text-gray-700 mt-2"><strong>Rekening:</strong> <span id="paid-account"></span></p>
            </div>
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-2">Upload Bukti Transfer (Image/PDF) *</label>
              <div
                class="border-2 border-dashed border-emerald-200 rounded-lg p-6 text-center hover:bg-emerald-50 transition cursor-pointer"
                onclick="document.getElementById('proof-file-input').click()">
                <i class="fas fa-cloud-upload-alt text-3xl text-emerald-500 mb-2"></i>
                <p class="text-sm text-gray-600">Klik untuk upload atau drag & drop</p>
                <p class="text-xs text-gray-500 mt-1">Format: JPG, PNG, PDF (Max 5MB)</p>
                <input type="file" id="proof-file-input" accept=".jpg,.jpeg,.png,.pdf" style="display: none;"
                  onchange="handleFileSelect(event)">
              </div>
              <div id="proof-file-info" class="mt-3 hidden">
                <p class="text-sm text-gray-600">File terpilih: <span id="proof-file-name"
                    class="font-semibold text-gray-900"></span></p>
                <p class="text-xs text-gray-500 mt-1">Ukuran: <span id="proof-file-size"></span></p>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 border-t px-6 py-4 flex gap-3">
            <button onclick="closePaidModal()"
              class="flex-1 px-4 py-3 border border-gray-300 rounded-lg font-medium text-gray-700 hover:bg-gray-50 transition">
              Batal
            </button>
            <button onclick="confirmPaid()"
              class="flex-1 px-4 py-3 bg-emerald-600 text-white rounded-lg font-medium hover:bg-emerald-700 transition">
              <i class="fas fa-check-double mr-2"></i>
              Tandai Dibayar
            </button>
          </div>
        </div>
      </div>

      <script>
        let currentPayoutId = null;
        const token = localStorage.getItem('token');
        let selectedProofFile = null;

        // Helpers to avoid undefined and sanitize strings
        function safeCurrency(val) {
          const n = parseFloat(val);
          return Number.isFinite(n) ? n.toLocaleString('id-ID') : '-';
        }

        function safeCount(val, fallback = 0) {
          if (typeof val === 'number') return val;
          if (typeof val === 'string' && val.trim() !== '') return parseInt(val, 10) || fallback;
          return fallback;
        }

        function escapeJsString(s) {
          if (s === null || s === undefined) return '';
          return String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\"/g, '\\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r');
        }

        // Handle file selection
        function handleFileSelect(event) {
          const file = event.target.files[0];
          if (!file) return;

          // Validate file type
          const allowedTypes = ['image/jpeg', 'image/png', 'application/pdf'];
          if (!allowedTypes.includes(file.type)) {
            alert('Format file tidak didukung. Gunakan JPG, PNG, atau PDF.');
            return;
          }

          // Validate file size (5MB)
          if (file.size > 5 * 1024 * 1024) {
            alert('Ukuran file terlalu besar. Maksimal 5MB.');
            return;
          }

          selectedProofFile = file;
          document.getElementById('proof-file-name').textContent = file.name;
          document.getElementById('proof-file-size').textContent = (file.size / 1024).toFixed(2) + ' KB';
          document.getElementById('proof-file-info').classList.remove('hidden');
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
          loadWithdrawals('pending');
          updateCounts();
          // Poll counts every 10 seconds
          setInterval(updateCounts, 10000);
        });

        // Fetch and update counts for all tabs
        async function updateCounts() {
          try {
            const response = await fetch('/finance/api/withdrawals/counts', {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await response.json();
            if (!result.success) throw new Error(result.message || 'Failed to fetch counts');

            const counts = result.data || {};
            document.getElementById('pending-count').textContent = counts.pending || 0;
            document.getElementById('approved-count').textContent = counts.approved || 0;
            document.getElementById('paid-count').textContent = counts.paid || 0;
            document.getElementById('rejected-count').textContent = counts.rejected || 0;

            // Update total count
            const total = (counts.pending || 0) + (counts.approved || 0) + (counts.paid || 0) + (counts.rejected || 0);
            document.getElementById('total-count').textContent = total;
          } catch (error) {
            console.error('Error updating counts:', error);
          }
        }

        function switchTab(tab) {
          event?.preventDefault();
          document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
          document.querySelectorAll('.tab-btn').forEach(el => {
            el.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm');
            el.classList.add('bg-transparent', 'text-gray-700');
          });

          document.getElementById(tab + '-tab').classList.remove('hidden');
          const activeBtn = event?.target.closest('.tab-btn');
          if (activeBtn) {
            activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow-sm');
            activeBtn.classList.remove('bg-transparent', 'text-gray-700');
          }

          loadWithdrawals(tab);
        }

        // Load withdrawals
        async function loadWithdrawals(status) {
          try {
            const response = await fetch(`/finance/api/withdrawals?status=${status}`, {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const listId = status + '-list';

            if (result.data.length === 0) {
              document.getElementById(listId).innerHTML = `
            <div class="text-center py-16 text-gray-500">
              <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-inbox text-green-600 text-xl"></i>
              </div>
              <p class="font-medium">Tidak ada penarikan dengan status ini</p>
              <p class="text-sm text-gray-500 mt-2">Semua penarikan sudah diproses atau belum ada</p>
            </div>
          `;
              return;
            }

            document.getElementById(listId).innerHTML = result.data.map(payout => `
          <div class="bg-white border border-green-100 rounded-xl p-5 card-hover">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-user-tie text-green-600"></i>
                  </div>
                  <div>
                    <div class="font-semibold text-gray-900">${payout.affiliate_name}</div>
                    <div class="text-xs text-gray-500">${payout.affiliate_email}</div>
                  </div>
                </div>
                <div class="text-sm text-gray-600">
                  <div class="flex items-center gap-4 flex-wrap">
                    <span class="flex items-center gap-1">
                      <i class="fas fa-university"></i>
                      ${payout.bank_name || '-'}
                    </span>
                    <span class="flex items-center gap-1">
                      <i class="fas fa-credit-card"></i>
                      ${payout.bank_account_number || '-'}
                    </span>
                    <span class="flex items-center gap-1">
                      <i class="fas fa-coins"></i>
                      ${safeCount(payout.commission_count, 0)} komisi
                    </span>
                  </div>
                </div>
              </div>
              <div class="md:text-right">
                <div class="font-bold text-lg text-green-700 mb-2">Rp ${safeCurrency(payout.total_amount)}</div>
                <div class="text-xs text-gray-500">ID: #${payout.id}</div>
                <div class="text-xs text-gray-500">${new Date(payout.created_at).toLocaleDateString('id-ID')}</div>                ${payout.admin_note ? `<div class="text-xs mt-1 text-green-700">Catatan Admin: ${payout.admin_note.length > 120 ? payout.admin_note.substring(0,120) + '...' : payout.admin_note}${payout.admin_approved_name ? ' • oleh ' + payout.admin_approved_name : (payout.admin_approved_by ? ' • oleh ID:' + payout.admin_approved_by : '')}</div>` : ''}              </div>
            </div>
            <div class="flex gap-2 mt-4 pt-4 border-t border-green-100">
              <button onclick="viewDetail(${payout.id})" class="flex-1 px-4 py-2 border border-green-200 text-green-700 rounded-lg font-medium hover:bg-green-50 transition text-sm">
                <i class="fas fa-eye mr-2"></i>Detail
              </button>
              ${status === 'pending' ? `
                <button onclick="openSubmitModal(${payout.id}, '${escapeJsString(payout.affiliate_name)}', ${payout.total_amount || 0})" class="flex-1 px-4 py-2 gradient-primary text-white rounded-lg font-medium hover:shadow-lg transition text-sm">
                  <i class="fas fa-paper-plane mr-2"></i>Submit ke Admin
                </button>
              ` : ''}
              ${status === 'approved' ? `
                <button onclick="openPaidModal(${payout.id}, '${escapeJsString(payout.affiliate_name)}', ${payout.total_amount || 0}, '${escapeJsString(payout.bank_account_number)}')" class="flex-1 px-4 py-2 gradient-secondary text-white rounded-lg font-medium hover:shadow-lg transition text-sm">
                  <i class="fas fa-money-bill-wave mr-2"></i>Tandai Dibayar
                </button>
              ` : ''}
            </div>
          </div>
        `).join('');

          } catch (error) {
            console.error('Error:', error);
            alert('Error loading withdrawals: ' + error.message);
          }
        }

        // View detail
        async function viewDetail(payoutId) {
          try {
            const response = await fetch(`/finance/api/withdrawals/${payoutId}`, {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const payout = result.data;
            let detailHTML = `
          <div class="space-y-6">
            <!-- Affiliate Info -->
            <div class="border-b pb-4">
              <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                <i class="fas fa-user-tie text-green-600"></i>
                Informasi Affiliate
              </h4>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-sm text-gray-600">Nama</p>
                  <p class="font-medium text-gray-900">${payout.affiliate_name}</p>
                </div>
                <div>
                  <p class="text-sm text-gray-600">Email</p>
                  <p class="font-medium text-gray-900">${payout.affiliate_email}</p>
                </div>
              </div>
            </div>

            <!-- Withdrawal Info -->
            <div class="border-b pb-4">
              <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                <i class="fas fa-file-invoice-dollar text-green-600"></i>
                Detail Penarikan
              </h4>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-sm text-gray-600">Total Jumlah</p>
                  <p class="font-bold text-lg text-green-700">Rp ${safeCurrency(payout.total_amount)}</p>
                </div>
                <div>
                  <p class="text-sm text-gray-600">Jumlah Komisi</p>
                  <p class="font-bold text-lg text-green-700">${safeCount(payout.commission_count, (payout.commissions && payout.commissions.length) || 0)}</p>
                </div>
              </div>
            </div>

            <!-- Bank Info -->
            <div class="border-b pb-4">
              <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                <i class="fas fa-university text-green-600"></i>
                Informasi Bank
              </h4>
              <div class="grid grid-cols-1 gap-4">
                <div>
                  <p class="text-sm text-gray-600">Nama Bank</p>
                  <p class="font-medium text-gray-900">${payout.bank_name || '-'}</p>
                </div>
                <div>
                  <p class="text-sm text-gray-600">Nomor Rekening</p>
                  <p class="font-medium text-gray-900">${payout.bank_account_number || '-'}</p>
                </div>
                <div>
                  <p class="text-sm text-gray-600">Atas Nama</p>
                  <p class="font-medium text-gray-900">${payout.bank_account_name || '-'}</p>
                </div>
              </div>
            </div>

            <!-- Finance Note (if exists) -->
            ${payout.finance_note ? `
              <div class="border-b pb-4 bg-emerald-50 rounded-lg p-4">
                <h4 class="font-semibold text-emerald-900 mb-2 flex items-center gap-2">
                  <i class="fas fa-sticky-note"></i>
                  Catatan Finance
                </h4>
                <p class="text-sm text-emerald-800">${payout.finance_note}</p>
                ${payout.submitted_by_name ? `<p class="text-xs text-gray-600 mt-1">Dikirim oleh: ${payout.submitted_by_name} • ${new Date(payout.submitted_at).toLocaleString('id-ID')}</p>` : (payout.submitted_by ? `<p class="text-xs text-gray-600 mt-1">Dikirim oleh ID: ${payout.submitted_by} • ${new Date(payout.submitted_at).toLocaleString('id-ID')}</p>` : '')}
              </div>
            ` : ''}

            <!-- Admin Note (if exists) -->
            ${payout.admin_note ? `
              <div class="border-b pb-4 bg-yellow-50 rounded-lg p-4">
                <h4 class="font-semibold text-yellow-900 mb-2 flex items-center gap-2">
                  <i class="fas fa-sticky-note"></i>
                  Catatan Admin
                </h4>
                <p class="text-sm text-yellow-800">${payout.admin_note}</p>
                ${payout.admin_approved_by ? `<p class="text-xs text-gray-600 mt-1">Dikirim oleh admin ID: ${payout.admin_approved_by} • ${new Date(payout.admin_approved_at).toLocaleString('id-ID')}</p>` : ''}
              </div>
            ` : ''}

            <!-- Commissions -->
            <div>
              <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                <i class="fas fa-coins text-green-600"></i>
                Komisi yang Ditarik
              </h4>
              <div class="bg-gray-50 rounded-lg p-4 max-h-48 overflow-y-auto">
                ${payout.commissions && payout.commissions.length > 0 ? payout.commissions.map((comm, idx) => `
                  <div class="flex justify-between items-center py-2 ${idx > 0 ? 'border-t border-gray-200' : ''}">
                    <div class="flex-1">
                      <div class="font-medium text-gray-900">${comm.event_title || 'Event'}</div>
                      <div class="text-xs text-gray-500">${new Date(comm.created_at).toLocaleDateString('id-ID')}</div>
                    </div>
                    <div class="font-semibold text-green-700">Rp ${comm.amount ? safeCurrency(comm.amount) : '-'}</div>
                  </div>
                `).join('') : '<p class="text-gray-500 text-sm text-center py-4">Tidak ada data komisi</p>'}
              </div>
            </div>
          </div>
        `;

            document.getElementById('detail-title').textContent = `Detail Penarikan - ${payout.affiliate_name}`;
            document.getElementById('detail-content').innerHTML = detailHTML;
            document.getElementById('detail-modal').classList.remove('hidden');

          } catch (error) {
            console.error('Error:', error);
            alert('Error loading detail: ' + error.message);
          }
        }

        // Open submit modal
        function openSubmitModal(payoutId, affiliateName, amount) {
          currentPayoutId = payoutId;
          document.getElementById('submit-affiliate').textContent = affiliateName;
          document.getElementById('submit-amount').textContent = 'Rp ' + safeCurrency(amount);
          document.getElementById('submit-note').value = '';
          document.getElementById('submit-modal').classList.remove('hidden');
        }

        // Submit to Admin
        async function submitToAdmin() {
          if (!currentPayoutId) return;

          try {
            const response = await fetch(`/finance/api/withdrawals/${currentPayoutId}/submit-to-admin`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({
                note: document.getElementById('submit-note').value
              })
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            alert('✅ Penarikan berhasil di-submit ke Admin!');
            closeSubmitModal();
            closeDetailModal();
            loadWithdrawals('pending');

          } catch (error) {
            console.error('Error:', error);
            alert('Error: ' + error.message);
          }
        }

        // Open mark paid modal
        function openPaidModal(payoutId, affiliateName, amount, accountNumber) {
          currentPayoutId = payoutId;
          selectedProofFile = null;
          document.getElementById('paid-affiliate').textContent = affiliateName;
          document.getElementById('paid-amount').textContent = 'Rp ' + safeCurrency(amount);
          document.getElementById('paid-account').textContent = accountNumber;
          document.getElementById('proof-file-info').classList.add('hidden');
          document.getElementById('proof-file-input').value = '';
          document.getElementById('paid-modal').classList.remove('hidden');
        }

        // Confirm mark as paid
        async function confirmPaid() {
          if (!currentPayoutId) return;

          if (!selectedProofFile) {
            alert('Pilih file bukti transfer terlebih dahulu!');
            return;
          }

          try {
            // Create FormData to upload file
            const formData = new FormData();
            formData.append('proof_file', selectedProofFile);
            formData.append('payout_id', currentPayoutId);

            const response = await fetch(`/finance/api/withdrawals/${currentPayoutId}/mark-paid`, {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${token}`
              },
              body: formData
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            alert('✅ Penarikan berhasil ditandai sebagai dibayar dengan bukti transfer!');
            closePaidModal();
            closeDetailModal();
            loadWithdrawals('approved');

          } catch (error) {
            console.error('Error:', error);
            alert('Error: ' + error.message);
          }
        }

        // Close modals
        function closeDetailModal() {
          document.getElementById('detail-modal').classList.add('hidden');
        }

        function closeSubmitModal() {
          document.getElementById('submit-modal').classList.add('hidden');
        }

        function closePaidModal() {
          document.getElementById('paid-modal').classList.add('hidden');
        }
      </script>
</body>

</html>