      <script>
        let currentPayoutId = null;
        const token = localStorage.getItem('token');
        let selectedProofFile = null;

        // ============================================================
        // FUNGSI NOTIFICATION MODAL
        // ============================================================
        
        function showNotification(options) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const iconIcon = document.getElementById('notificationIconIcon');
          const title = document.getElementById('notificationTitle');
          const message = document.getElementById('notificationMessage');
          const button = document.getElementById('notificationButton');
          
          // Set type
          icon.className = 'notification-icon ' + (options.type || 'success');
          
          // Set icon
          const icons = {
            success: 'fa-check',
            error: 'fa-times-circle',
            warning: 'fa-exclamation-triangle',
            info: 'fa-info-circle'
          };
          iconIcon.className = `fas ${icons[options.type || 'success']} text-white text-2xl`;
          
          // Set content
          title.textContent = options.title || 'Notifikasi';
          message.textContent = options.message || '';
          
          // Set button
          button.onclick = () => {
            modal.classList.remove('show');
            if (options.onClose) options.onClose();
          };
          
          // Show modal
          modal.classList.add('show');
          
          // Tambahkan animasi shake jika warning dan pesan tertentu
          const notifContent = modal.querySelector('.notification-content');
          if (options.type === 'warning' && options.message && options.message.includes('Pilih file bukti transfer terlebih dahulu')) {
            notifContent.classList.remove('shake');
            // Trigger reflow to restart animation
            void notifContent.offsetWidth;
            notifContent.classList.add('shake');
          } else {
            notifContent.classList.remove('shake');
          }

          // Auto close if set
          if (options.autoClose) {
            setTimeout(() => {
              modal.classList.remove('show');
            }, options.timeout || 3000);
          }
        }

        // Override alert
        window.alert = function(message) {
          showNotification({
            type: 'warning',
            title: 'Peringatan',
            message: message
          });
        };

        // Helpers to avoid undefined and sanitize strings
        function safeCurrency(val) {
          const n = parseFloat(val);
          return Number.isFinite(n) ? n.toLocaleString('id-ID') : '-';
        }

        function safeCount(val, fallback = 0) {
          if (typeof val === 'number') return val;
          if (typeof val === 'string' && val.trim() !== '') return parseInt(val, 10) || fallback;
          return fallback;
        }

        function escapeJsString(s) {
          if (s === null || s === undefined) return '';
          return String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\"/g, '\\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r');
        }

        // Handle file selection
        function handleFileSelect(event) {
          const file = event.target.files[0];
          if (!file) return;

          // Validate file type
          const allowedTypes = ['image/jpeg', 'image/png', 'application/pdf'];
          if (!allowedTypes.includes(file.type)) {
            showNotification({
              type: 'error',
              title: 'Format Tidak Didukung',
              message: 'Format file tidak didukung. Gunakan JPG, PNG, atau PDF.'
            });
            return;
          }

          // Validate file size (5MB)
          if (file.size > 5 * 1024 * 1024) {
            showNotification({
              type: 'error',
              title: 'File Terlalu Besar',
              message: 'Ukuran file terlalu besar. Maksimal 5MB.'
            });
            return;
          }

          selectedProofFile = file;
          document.getElementById('proof-file-name').textContent = file.name;
          document.getElementById('proof-file-size').textContent = (file.size / 1024).toFixed(2) + ' KB';
          document.getElementById('proof-file-info').classList.remove('hidden');
        }

        function clearSelectedFile() {
          selectedProofFile = null;
          document.getElementById('proof-file-input').value = '';
          document.getElementById('proof-file-info').classList.add('hidden');
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
          loadWithdrawals('pending');
          updateCounts();
          // Poll counts every 10 seconds
          setInterval(updateCounts, 10000);
        });

        // Fetch and update counts for all tabs
        async function updateCounts() {
          try {
            const response = await fetch('/finance/api/withdrawals/counts', {
              headers: { 'Authorization': `Bearer ${token}` }
            });
            const result = await response.json();
            if (!result.success) throw new Error(result.message || 'Failed to fetch counts');

            const counts = result.data || {};
            document.getElementById('pending-count').textContent = counts.pending || 0;
            document.getElementById('approved-count').textContent = counts.approved || 0;
            document.getElementById('paid-count').textContent = counts.paid || 0;
            document.getElementById('rejected-count').textContent = counts.rejected || 0;

            // Update total count
            const total = (counts.pending || 0) + (counts.approved || 0) + (counts.paid || 0) + (counts.rejected || 0);
            document.getElementById('total-count').textContent = total;
          } catch (error) {
            console.error('Error updating counts:', error);
          }
        }

        function switchTab(tab) {
          event?.preventDefault();
          document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
          document.querySelectorAll('.tab-btn').forEach(el => {
            el.classList.remove('tab-active');
            el.classList.add('tab-inactive');
          });

          document.getElementById(tab + '-tab').classList.remove('hidden');
          const activeBtn = event?.target.closest('.tab-btn');
          if (activeBtn) {
            activeBtn.classList.add('tab-active');
            activeBtn.classList.remove('tab-inactive');
          }

          loadWithdrawals(tab);
        }

        // Load withdrawals
        async function loadWithdrawals(status) {
          try {
            const response = await fetch(`/finance/api/withdrawals?status=${status}`, {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const listId = status + '-list';

            if (result.data.length === 0) {
              document.getElementById(listId).innerHTML = `
                <div class="text-center py-16">
                  <div class="flex flex-col items-center">
                    <div class="relative">
                      <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                        <i class="fas fa-inbox text-3xl text-emerald-300"></i>
                      </div>
                      <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                        <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                      </div>
                    </div>
                    <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak ada penarikan dengan status ini</h3>
                    <p class="text-sm text-emerald-700 font-medium">Semua penarikan sudah diproses atau belum ada</p>
                  </div>
                </div>
              `;
              return;
            }

            document.getElementById(listId).innerHTML = result.data.map(payout => {
              const statusConfig = {
                'pending': { bg: 'status-pending', icon: 'fa-clock', label: 'Pending' },
                'approved': { bg: 'status-approved', icon: 'fa-check-circle', label: 'Approved' },
                'paid': { bg: 'status-paid', icon: 'fa-check-double', label: 'Paid' },
                'rejected': { bg: 'status-rejected', icon: 'fa-times-circle', label: 'Rejected' }
              }[status] || { bg: 'bg-gray-500', icon: 'fa-circle', label: status };

              return `
                <div class="glass-futuristic rounded-xl p-5 card-futuristic border border-white/50 fade-in">
                  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                    <div class="flex-1">
                      <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-emerald-100 to-green-100 rounded-xl flex items-center justify-center border border-white/60">
                          <i class="fas fa-user-tie text-emerald-600"></i>
                        </div>
                        <div>
                          <div class="font-extrabold text-base text-gray-900">${payout.affiliate_name}</div>
                          <div class="text-xs font-medium text-emerald-700">${payout.affiliate_email}</div>
                        </div>
                      </div>
                      <div class="flex items-center gap-4 flex-wrap text-sm text-gray-600">
                        <span class="flex items-center gap-1">
                          <i class="fas fa-university text-emerald-400"></i>
                          ${payout.bank_name || '-'}
                        </span>
                        <span class="flex items-center gap-1">
                          <i class="fas fa-credit-card text-emerald-400"></i>
                          ${payout.bank_account_number || '-'}
                        </span>
                        <span class="flex items-center gap-1">
                          <i class="fas fa-coins text-emerald-400"></i>
                          ${safeCount(payout.commission_count, 0)} komisi
                        </span>
                      </div>
                    </div>
                    <div class="md:text-right">
                      <div class="font-extrabold text-xl text-emerald-700 mb-2">Rp ${safeCurrency(payout.total_amount)}</div>
                      <div class="text-xs font-medium text-gray-500">ID: #${payout.id}</div>
                      <div class="text-xs font-medium text-gray-500">${new Date(payout.created_at).toLocaleDateString('id-ID')}</div>
                      ${payout.admin_note ? `<div class="text-xs mt-1 text-emerald-700 bg-emerald-50/80 backdrop-blur px-2 py-1 rounded-lg border border-emerald-200/50">Catatan Admin: ${payout.admin_note.length > 120 ? payout.admin_note.substring(0, 120) + '...' : payout.admin_note}${payout.admin_approved_name ? ' • oleh ' + payout.admin_approved_name : (payout.admin_approved_by ? ' • oleh ID:' + payout.admin_approved_by : '')}</div>` : ''}
                    </div>
                  </div>
                  <div class="flex gap-2 mt-4 pt-4 border-t border-white/30">
                    <button onclick="viewDetail(${payout.id})" class="flex-1 btn-secondary text-sm py-2 flex items-center justify-center gap-1">
                      <i class="fas fa-eye"></i>
                      Detail
                    </button>
                    ${status === 'pending' ? `
                      <button onclick="openSubmitModal(${payout.id}, '${escapeJsString(payout.affiliate_name)}', ${payout.total_amount || 0})" class="flex-1 btn-primary text-sm py-2 flex items-center justify-center gap-1">
                        <i class="fas fa-paper-plane"></i>
                        Submit ke Admin
                      </button>
                    ` : ''}
                    ${status === 'approved' ? `
                      <button onclick="openPaidModal(${payout.id}, '${escapeJsString(payout.affiliate_name)}', ${payout.total_amount || 0}, '${escapeJsString(payout.bank_account_number)}')" class="flex-1 btn-success text-sm py-2 flex items-center justify-center gap-1">
                        <i class="fas fa-money-bill-wave"></i>
                        Tandai Dibayar
                      </button>
                    ` : ''}
                  </div>
                </div>
              `;
            }).join('');

          } catch (error) {
            console.error('Error:', error);
            showNotification({
              type: 'error',
              title: 'Error',
              message: 'Error loading withdrawals: ' + error.message
            });
          }
        }

        // View detail
        async function viewDetail(payoutId) {
          try {
            const response = await fetch(`/finance/api/withdrawals/${payoutId}`, {
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const payout = result.data;
            let detailHTML = `
              <div class="space-y-4">
                <!-- Affiliate Info -->
                <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                  <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                    <i class="fas fa-user-tie text-emerald-600"></i>
                    Informasi Affiliate
                  </h4>
                  <div class="grid grid-cols-2 gap-3 text-sm">
                    <div>
                      <p class="text-xs font-bold text-emerald-700">Nama</p>
                      <p class="font-extrabold text-base text-gray-900">${payout.affiliate_name}</p>
                    </div>
                    <div>
                      <p class="text-xs font-bold text-emerald-700">Email</p>
                      <p class="font-extrabold text-base text-gray-900">${payout.affiliate_email}</p>
                    </div>
                  </div>
                </div>

                <!-- Withdrawal Info -->
                <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                  <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                    <i class="fas fa-file-invoice-dollar text-emerald-600"></i>
                    Detail Penarikan
                  </h4>
                  <div class="grid grid-cols-2 gap-3 text-sm">
                    <div>
                      <p class="text-xs font-bold text-emerald-700">Total Jumlah</p>
                      <p class="font-extrabold text-xl text-emerald-700">Rp ${safeCurrency(payout.total_amount)}</p>
                    </div>
                    <div>
                      <p class="text-xs font-bold text-emerald-700">Jumlah Komisi</p>
                      <p class="font-extrabold text-xl text-emerald-700">${safeCount(payout.commission_count, (payout.commissions && payout.commissions.length) || 0)}</p>
                    </div>
                  </div>
                </div>

                <!-- Bank Info -->
                <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                  <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                    <i class="fas fa-university text-emerald-600"></i>
                    Informasi Bank
                  </h4>
                  <div class="space-y-2 text-sm">
                    <div class="flex items-center justify-between">
                      <p class="text-xs font-bold text-emerald-700">Nama Bank</p>
                      <p class="font-extrabold text-base text-gray-900">${payout.bank_name || '-'}</p>
                    </div>
                    <div class="flex items-center justify-between">
                      <p class="text-xs font-bold text-emerald-700">Nomor Rekening</p>
                      <p class="font-extrabold text-base text-gray-900">${payout.bank_account_number || '-'}</p>
                    </div>
                    <div class="flex items-center justify-between">
                      <p class="text-xs font-bold text-emerald-700">Atas Nama</p>
                      <p class="font-extrabold text-base text-gray-900">${payout.bank_account_name || '-'}</p>
                    </div>
                  </div>
                </div>

                <!-- Finance Note (if exists) -->
                ${payout.finance_note ? `
                  <div class="glass-futuristic rounded-xl p-4 border border-amber-200/50 bg-amber-50/30">
                    <h4 class="text-sm font-extrabold text-amber-800 mb-2 flex items-center gap-1.5">
                      <i class="fas fa-sticky-note text-amber-600"></i>
                      Catatan Finance
                    </h4>
                    <p class="text-sm text-amber-800">${payout.finance_note}</p>
                    ${payout.submitted_by_name ? `<p class="text-xs text-gray-600 mt-1">Dikirim oleh: ${payout.submitted_by_name} • ${new Date(payout.submitted_at).toLocaleString('id-ID')}</p>` : (payout.submitted_by ? `<p class="text-xs text-gray-600 mt-1">Dikirim oleh ID: ${payout.submitted_by} • ${new Date(payout.submitted_at).toLocaleString('id-ID')}</p>` : '')}
                  </div>
                ` : ''}

                <!-- Admin Note (if exists) -->
                ${payout.admin_note ? `
                  <div class="glass-futuristic rounded-xl p-4 border border-blue-200/50 bg-blue-50/30">
                    <h4 class="text-sm font-extrabold text-blue-800 mb-2 flex items-center gap-1.5">
                      <i class="fas fa-sticky-note text-blue-600"></i>
                      Catatan Admin
                    </h4>
                    <p class="text-sm text-blue-800">${payout.admin_note}</p>
                    ${payout.admin_approved_by ? `<p class="text-xs text-gray-600 mt-1">Dikirim oleh admin ID: ${payout.admin_approved_by} • ${new Date(payout.admin_approved_at).toLocaleString('id-ID')}</p>` : ''}
                  </div>
                ` : ''}

                <!-- Commissions -->
                <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                  <h4 class="text-sm font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
