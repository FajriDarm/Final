                    ${payout.commissions && payout.commissions.length > 0 ? payout.commissions.map((comm, idx) => `
                      <div class="flex justify-between items-center py-2 ${idx > 0 ? 'border-t border-white/30' : ''}">
                        <div class="flex-1">
                          <div class="font-extrabold text-sm text-gray-900">${comm.event_title || 'Event'}</div>
                          <div class="text-xs font-medium text-gray-500">${new Date(comm.created_at).toLocaleDateString('id-ID')}</div>
                        </div>
                        <div class="font-extrabold text-sm text-emerald-700">Rp ${comm.amount ? safeCurrency(comm.amount) : '-'}</div>
                      </div>
                    `).join('') : '<p class="text-gray-500 text-sm text-center py-4">Tidak ada data komisi</p>'}
                  </div>
                </div>
              </div>
            `;

            document.getElementById('detail-title').textContent = `Detail Penarikan - ${payout.affiliate_name}`;
            document.getElementById('detail-content').innerHTML = detailHTML;
            document.getElementById('detail-modal').classList.add('show');

          } catch (error) {
            console.error('Error:', error);
            showNotification({
              type: 'error',
              title: 'Error',
              message: 'Error loading detail: ' + error.message
            });
          }
        }

        // Close modals
        function closeDetailModal() {
          document.getElementById('detail-modal').classList.remove('show');
        }

        function closeSubmitModal() {
          document.getElementById('submit-modal').classList.remove('show');
        }

        function closePaidModal() {
          document.getElementById('paid-modal').classList.remove('show');
          clearSelectedFile();
        }

        // Open submit modal
        function openSubmitModal(payoutId, affiliateName, amount) {
          currentPayoutId = payoutId;
          document.getElementById('submit-affiliate').textContent = affiliateName;
          document.getElementById('submit-amount').textContent = 'Rp ' + safeCurrency(amount);
          document.getElementById('submit-note').value = '';
          document.getElementById('submit-modal').classList.add('show');
        }

        // Submit to Admin
        async function submitToAdmin() {
          if (!currentPayoutId) return;

          try {
            const response = await fetch(`/finance/api/withdrawals/${currentPayoutId}/submit-to-admin`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({
                note: document.getElementById('submit-note').value
              })
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            showNotification({
              type: 'success',
              title: 'Berhasil',
              message: '✅ Penarikan berhasil di-submit ke Admin!'
            });
            closeSubmitModal();
            closeDetailModal();
            loadWithdrawals('pending');
            updateCounts();

          } catch (error) {
            console.error('Error:', error);
            showNotification({
              type: 'error',
              title: 'Error',
              message: 'Error: ' + error.message
            });
          }
        }

        // Open mark paid modal
        function openPaidModal(payoutId, affiliateName, amount, accountNumber) {
          currentPayoutId = payoutId;
          selectedProofFile = null;
          document.getElementById('paid-affiliate').textContent = affiliateName || 'kok';
          document.getElementById('paid-amount').textContent = 'Rp ' + safeCurrency(amount);
          document.getElementById('paid-account').textContent = accountNumber || '2027502410';
          document.getElementById('proof-file-info').classList.add('hidden');
          document.getElementById('proof-file-input').value = '';
          document.getElementById('paid-modal').classList.add('show');
        }

        // Confirm mark as paid
        async function confirmPaid() {
          if (!currentPayoutId) return;

          if (!selectedProofFile) {
            showNotification({
              type: 'warning',
              title: 'Peringatan',
              message: 'Pilih file bukti transfer terlebih dahulu!'
            });
            return;
          }

          try {
            // Create FormData to upload file
            const formData = new FormData();
            formData.append('proof_file', selectedProofFile);
            formData.append('payout_id', currentPayoutId);

            const response = await fetch(`/finance/api/withdrawals/${currentPayoutId}/mark-paid`, {
              method: 'POST',
              headers: {
                'Authorization': `Bearer ${token}`
              },
              body: formData
            });
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            showNotification({
              type: 'success',
              title: 'Berhasil',
              message: '✅ Penarikan berhasil ditandai sebagai dibayar dengan bukti transfer!'
            });
            closePaidModal();
            closeDetailModal();
            loadWithdrawals('approved');
            updateCounts();

          } catch (error) {
            console.error('Error:', error);
            showNotification({
              type: 'error',
              title: 'Error',
              message: 'Error: ' + error.message
            });
          }
        }

        // Close modals when clicking overlay
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
          overlay.addEventListener('click', (e) => {
            if (e.target === overlay) {
              overlay.classList.remove('show');
            }
          });
        });
      </script>
</body>

</html>