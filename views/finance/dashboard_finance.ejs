<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Finance - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }

    .gradient-warning {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .gradient-info {
      background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    }

    .gradient-danger {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .status-badge {
      transition: all 0.2s ease;
    }

    .status-badge:hover {
      transform: scale(1.05);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>

    <!-- Sidebar -->
    <%- include('../sidebar/finance.ejs') %>

      <!-- Main Content -->
      <main class="ml-64 pt-16 min-h-screen">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-chart-bar text-white text-xl"></i>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900">Dashboard Finance</h1>
                  <p class="text-gray-600 mt-1">Selamat datang di panel keuangan Affillink</p>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                <div class="flex items-center gap-2">
                  <i class="fas fa-calendar-alt text-green-600"></i>
                  <span class="text-sm font-medium text-gray-700">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                      day: 'numeric' }) %>
                  </span>
                </div>
              </div>
              <div class="px-4 py-2 gradient-primary rounded-lg shadow-lg text-white pulse-animation">
                <div class="flex items-center gap-2">
                  <i class="fas fa-bell pulse-animation"></i>
                  <span class="text-sm font-medium">Update Real-time</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8" id="statsContainer">
            <!-- Total Pembayaran Masuk -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Pembayaran Masuk</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalPaid">
                    Rp <%= parseInt(stats.totalPaid || 0).toLocaleString('id-ID') %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                      <i class="fas fa-arrow-up mr-1"></i>15%
                    </span>
                    <span class="text-xs text-gray-500">dari bulan lalu</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-money-bill-wave text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">This Month</span>
                  <span class="font-medium text-green-700">
                    Rp <%= parseInt(stats.thisMonthPaid || 0).toLocaleString('id-ID') %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Total Pembayaran Pending -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Pembayaran Pending</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalPending">
                    Rp <%= parseInt(stats.totalPending || 0).toLocaleString('id-ID') %>
                  </p>
                  <div id="pendingPaymentsBadge" class="flex items-center gap-2">
                    <% if (stats.countPending> 0) { %>
                      <span
                        class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                        <i class="fas fa-exclamation-circle"></i>
                        <%= stats.countPending %> menunggu
                      </span>
                      <span class="text-xs text-gray-500">perlu approval</span>
                      <% } else { %>
                        <span
                          class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                          <i class="fas fa-check-circle"></i>
                          Semua selesai
                        </span>
                        <span class="text-xs text-gray-500">tidak ada pending</span>
                        <% } %>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-warning rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-clock text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Avg. Process Time</span>
                  <span class="font-medium text-yellow-700">2.5 hari</span>
                </div>
              </div>
            </div>

            <!-- Transaksi Paid -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Transaksi Paid</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="countPaid">
                    <%= stats.countPaid || 0 %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">
                      <i class="fas fa-chart-line mr-1"></i>8%
                    </span>
                    <span class="text-xs text-gray-500">naik dari kemarin</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-info rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-check-circle text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Success Rate</span>
                  <span class="font-medium text-blue-700">92%</span>
                </div>
              </div>
            </div>

            <!-- Transaksi Pending -->
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Transaksi Pending</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="countPending">
                    <%= stats.countPending || 0 %>
                  </p>
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-1 bg-amber-100 text-amber-700 rounded-full text-xs font-medium">
                      <i class="fas fa-hourglass-half mr-1"></i>Pending
                    </span>
                    <span class="text-xs text-gray-500">perlu tindakan</span>
                  </div>
                </div>
                <div class="w-14 h-14 gradient-accent rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-hourglass-half text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Response Time</span>
                  <span class="font-medium text-amber-700">
                    <% if (stats.avgResponseTime) { %>
                      <%= stats.avgResponseTime %> jam
                        <% } else { %>
                          6 jam
                          <% } %>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Payments Table -->
          <div class="w-full">
            <div
              class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden flex flex-col min-h-[400px] h-full">
              <div class="px-6 py-4 gradient-primary">
                <div class="flex items-center justify-between">
                  <div>
                    <h2 class="text-lg font-semibold text-white">Pembayaran Terbaru</h2>
                    <p class="text-green-100 text-sm mt-1">10 pembayaran terakhir</p>
                  </div>
                  <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                    <i class="fas fa-exchange-alt text-white"></i>
                  </div>
                </div>
              </div>
              <div class="p-0 flex-1 flex flex-col">
                <div class="overflow-x-auto">
                  <table class="w-full">
                    <thead>
                      <tr class="bg-green-50">
                        <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Customer</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Amount</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Status</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Metode</th>
                        <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Tanggal</th>
                      </tr>
                    </thead>
                    <tbody id="paymentsTableBody" class="divide-y divide-green-100">
                      <% if (!recentPayments || recentPayments.length===0) { %>
                        <tr style="height:320px;">
                          <td colspan="5" class="py-12 px-6 text-center">
                            <div class="flex flex-col items-center justify-center">
                              <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                                <i class="fas fa-inbox text-green-600 text-xl"></i>
                              </div>
                              <p class="text-gray-600 font-medium">Belum ada pembayaran</p>
                              <p class="text-sm text-gray-500 mt-2">Transaksi akan muncul di sini</p>
                            </div>
                          </td>
                        </tr>
                        <% } else { %>
                          <% recentPayments.forEach(function(t, index) { %>
                            <% const statusClass={ 'pending' : 'bg-yellow-100 text-yellow-800 border-yellow-200'
                              , 'paid' : 'bg-green-100 text-green-800 border-green-200' , 'rejected'
                              : 'bg-red-100 text-red-800 border-red-200' }[t.payment_status]
                              || 'bg-gray-100 text-gray-800 border-gray-200' ; const amount=parseInt(t.total_amount ||
                              0); const isHighValue=amount> 1000000;
                              const methodIcon = {
                              'bank_transfer': 'fas fa-university',
                              'credit_card': 'fas fa-credit-card',
                              'e-wallet': 'fas fa-wallet',
                              'cash': 'fas fa-money-bill'
                              }[t.payment_method] || 'fas fa-money-bill-wave';
                              %>
                              <tr class="hover:bg-green-50 transition-colors data-cell"
                                data-animation-delay="<%= index * 50 %>">
                                <td class="py-4 px-6">
                                  <div class="flex items-center gap-3">
                                    <div
                                      class="w-10 h-10 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                                      <i class="fas fa-user text-green-600"></i>
                                    </div>
                                    <div>
                                      <div class="font-medium text-gray-900">
                                        <%= t.customer_name || 'Unknown' %>
                                      </div>
                                      <div class="text-sm text-gray-500">ID: <%= t.transaction_id || 'N/A' %>
                                      </div>
                                    </div>
                                  </div>
                                </td>
                                <td class="py-4 px-6">
                                  <div class="flex flex-col">
                                    <span
                                      class="font-bold <%= isHighValue ? 'text-green-700 text-lg' : 'text-gray-900' %>">
                                      Rp <%= amount.toLocaleString('id-ID') %>
                                    </span>
                                    <% if (t.commission_amount) { %>
                                      <span class="text-xs text-gray-500">Komisi: Rp <%=
                                          parseInt(t.commission_amount).toLocaleString('id-ID') %></span>
                                      <% } %>
                                  </div>
                                </td>
                                <td class="py-4 px-6">
                                  <span
                                    class="px-3 py-1.5 rounded-full text-xs font-medium border <%= statusClass %> status-badge">
                                    <i class="fas fa-circle text-xs mr-1.5"></i>
                                    <%= t.payment_status.toUpperCase() %>
                                  </span>
                                </td>
                                <td class="py-4 px-6">
                                  <div class="flex items-center gap-2">
                                    <i class="<%= methodIcon %> text-gray-500"></i>
                                    <span class="text-sm text-gray-700">
                                      <%= t.payment_method %>
                                    </span>
                                  </div>
                                </td>
                                <td class="py-4 px-6">
                                  <div class="text-sm text-gray-600">
                                    <%= new Date(t.created_at).toLocaleDateString('id-ID', { day: 'numeric' ,
                                      month: 'short' , year: 'numeric' }) %>
                                  </div>
                                  <div class="text-xs text-gray-500">
                                    <%= new Date(t.created_at).toLocaleTimeString('id-ID', { hour: '2-digit' ,
                                      minute: '2-digit' }) %>
                                  </div>
                                </td>
                              </tr>
                              <% }); %>
                                <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="px-6 py-4 bg-green-50 border-t border-green-100 rounded-b-2xl">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
                  <div class="text-green-700 font-medium">
                    Total pembayaran terbaru: <span class="font-semibold text-green-700"><%= recentPayments ? recentPayments.length : 0 %></span>
                  </div>
                  <span class="text-gray-600">Terakhir diperbarui: Sekarang</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main> 

      <script>
        // Function to animate values (similar to admin dashboard)
        function animateValue(id, start, end, duration, isCurrency = false) {
          const obj = document.getElementById(id);
          if (!obj) return;

          let startTimestamp = null;

          const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const value = Math.floor(progress * (end - start) + start);

            if (isCurrency) {
              obj.textContent = 'Rp ' + value.toLocaleString('id-ID');
            } else {
              obj.textContent = value;
            }

            if (progress < 1) {
              window.requestAnimationFrame(step);
            }
          };

          window.requestAnimationFrame(step);
        }

        // Function to load dashboard stats (if using AJAX)
        async function loadDashboardStats() {
          try {
            const response = await fetch('/api/finance/dashboard/stats');
            const data = await response.json();

            if (data.success) {
              // Update stats with animation
              animateValue('totalPaid', 0, data.stats.totalPaid, 1000, true);
              animateValue('totalPending', 0, data.stats.totalPending, 1000, true);
              animateValue('countPaid', 0, data.stats.countPaid, 1000);
              animateValue('countPending', 0, data.stats.countPending, 1000);

              // Update pending payments badge
              const pendingBadge = document.getElementById('pendingPaymentsBadge');
              if (data.stats.countPending > 0) {
                pendingBadge.innerHTML = `
              <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                <i class="fas fa-exclamation-circle"></i>
                ${data.stats.countPending} menunggu
              </span>
              <span class="text-xs text-gray-500">perlu approval</span>
            `;
              } else {
                pendingBadge.innerHTML = `
              <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium flex items-center gap-1 status-badge">
                <i class="fas fa-check-circle"></i>
                Semua selesai
              </span>
              <span class="text-xs text-gray-500">tidak ada pending</span>
            `;
              }
            }
          } catch (error) {
            console.error('Error loading dashboard stats:', error);
            showError('Gagal memuat data dashboard');
          }
        }

        function showError(message) {
          const statsContainer = document.getElementById('statsContainer');
          const errorDiv = document.createElement('div');
          errorDiv.className = 'col-span-4';
          errorDiv.innerHTML = `
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
              <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <div>
              <p class="text-red-700 font-medium">${message}</p>
              <p class="text-red-600 text-sm mt-1">Coba refresh halaman atau hubungi support</p>
            </div>
          </div>
        </div>
      `;
          statsContainer.insertBefore(errorDiv, statsContainer.firstChild);
        }

        // Load stats on page load (if using AJAX)
        document.addEventListener('DOMContentLoaded', () => {
          // Uncomment below if using AJAX for stats
          // loadDashboardStats();

          // Auto-refresh every 30 seconds (if using AJAX)
          // setInterval(loadDashboardStats, 30000);

          // Apply animation delays set via data-animation-delay to avoid inline EJS in style attributes
          document.querySelectorAll('tr[data-animation-delay]').forEach(function(tr) {
            const d = tr.getAttribute('data-animation-delay');
            if (d !== null) tr.style.animationDelay = d + 'ms';
          });
        });
      </script>
</body>

</html>