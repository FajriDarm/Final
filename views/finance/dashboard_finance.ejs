<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Finance - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-secondary {
      background: linear-gradient(165deg, #047857 0%, #059669 50%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(165deg, #065f46 0%, #047857 50%, #059669 100%);
    }

    .gradient-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .gradient-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .gradient-danger {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
    }

    .gradient-purple {
      background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
    }

    .gradient-teal {
      background: linear-gradient(165deg, #0d9488 0%, #14b8a6 50%, #2dd4bf 100%);
    }

    /* Status Gradients */
    .status-pending {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .status-paid {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
    }

    .status-rejected {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Badge 3D Effect */
    .badge-3d {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 rgba(0, 0, 0, 0.05);
    }

    .badge-3d:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 6px 0 rgba(0, 0, 0, 0.05);
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Custom Scrollbar */
    .modern-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .modern-scrollbar::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: linear-gradient(145deg, #10b981, #059669);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(145deg, #059669, #047857);
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    /* Glow Text */
    .glow-text {
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.3),
        0 0 20px rgba(16, 185, 129, 0.2);
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Data Cell */
    .data-cell-modern {
      position: relative;
      transition: all 0.4s ease;
    }

    .data-cell-modern::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 3px;
      background: linear-gradient(90deg, #10b981, #059669);
      transition: all 0.4s ease;
      transform: translateX(-50%);
    }

    .data-cell-modern:hover::before {
      width: 100%;
    }

    /* Animations */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white), linear-gradient(135deg, white, white, white);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Table Row Styles */
    .table-row {
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(5px);
    }

    .table-row:hover {
      background: rgba(255, 255, 255, 0.6);
      transform: scale(1.01);
      box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.15);
    }

    /* Glitch Effect */
    .glitch-text {
      position: relative;
      animation: glitch 3s infinite;
    }

    @keyframes glitch {

      0%,
      100% {
        transform: translate(0);
      }

      33% {
        transform: translate(-2px, 1px);
      }

      66% {
        transform: translate(2px, -1px);
      }
    }
  </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
  <!-- Ultra Modern Decorative Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
    <div
      class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
    </div>
    <div
      class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
    </div>

    <!-- Animated Grid Lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

    <!-- Floating Particles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
    <div
      class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
    </div>
  </div>

  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Finance' }) %>

    <!-- Sidebar -->
    <%- include('../sidebar/finance.ejs') %>

      <!-- Main Content -->
      <main class="ml-64 pt-16 min-h-screen relative z-10">
        <div class="p-6">
          <!-- Premium Page Header - Sesuai dengan dashboard -->
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 animate-slide-in">
            <div class="mb-4 lg:mb-0">
              <div class="flex items-center gap-4">
                <div class="relative">
                  <div
                    class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
                    <i class="fas fa-chart-bar text-white text-2xl"></i>
                  </div>
                  <div
                    class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                    <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h1
                      class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
                      Dashboard Finance
                    </h1>
                    <span
                      class="px-3 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 rounded-lg text-white text-xs font-bold tracking-wider shadow-lg">
                      FINANCE
                    </span>
                  </div>
                  <p class="text-sm text-emerald-700 font-medium">Selamat datang di panel keuangan Affillink</p>
                </div>
              </div>
            </div>

            <!-- Premium Date & Live Status -->
            <div class="flex items-center gap-3">
              <div class="neomorph rounded-xl px-4 py-2.5 flex items-center gap-3">
                <div class="w-8 h-8 gradient-secondary rounded-lg flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar-alt text-white text-sm"></i>
                </div>
                <div>
                  <p class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider">Tanggal</p>
                  <p class="text-xs font-bold text-gray-800 whitespace-nowrap">
                    <%= new Date().toLocaleDateString('id-ID', { day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                  </p>
                </div>
              </div>

              <div class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-xl relative shimmer">
                <div class="relative">
                  <i class="fas fa-bell text-white text-sm"></i>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full"></span>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></span>
                </div>
                <div>
                  <p class="text-[10px] text-white/90 font-bold uppercase tracking-wider">Live Status</p>
                  <p class="text-xs font-bold text-white">Updates Real-time</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Premium Stats Cards - Ultra Modern -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-7 animate-scale-in" id="statsContainer">
            <!-- Total Pembayaran Masuk -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <!-- Decorative Elements -->
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-emerald-400/20 to-green-400/20 rounded-full -mr-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-teal-400/20 to-emerald-400/20 rounded-full -ml-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                      </span>
                      <p class="text-emerald-700 text-[10px] font-bold uppercase tracking-wider">Total Pembayaran Masuk
                      </p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900" id="totalPaid">
                        Rp <%= parseInt(stats.totalPaid || 0).toLocaleString('id-ID') %>
                      </p>
                      <span class="text-xs font-bold text-emerald-600">IDR</span>
                    </div>

                    <div class="flex items-center gap-1.5 mt-2">
                      <div class="px-2 py-1 bg-green-100 rounded-lg flex items-center gap-1">
                        <i class="fas fa-arrow-up text-[8px] text-green-600"></i>
                        <span class="text-[8px] font-extrabold text-green-700">+15%</span>
                      </div>
                      <span class="text-[7px] text-gray-500">dari bulan lalu</span>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:rotate-3 transition-all duration-500">
                    <i class="fas fa-money-bill-wave text-white text-xl"></i>
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-emerald-100/50">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <div class="relative">
                        <div class="w-6 h-6 bg-white rounded-lg flex items-center justify-center shadow-sm">
                          <i class="fas fa-calendar-alt text-emerald-600 text-[10px]"></i>
                        </div>
                        <span
                          class="absolute -top-1 -right-1 w-2 h-2 bg-green-500 rounded-full border border-white"></span>
                      </div>
                      <div>
                        <span class="text-[8px] font-medium text-gray-500">Bulan Ini</span>
                        <p class="text-xs font-extrabold text-emerald-700">
                          Rp <%= parseInt(stats.thisMonthPaid || 0).toLocaleString('id-ID') %>
                        </p>
                      </div>
                    </div>

                    <div class="flex -space-x-2">
                      <div
                        class="w-6 h-6 bg-gradient-to-br from-purple-400 to-pink-500 rounded-full border-2 border-white flex items-center justify-center text-white text-[8px] font-bold">
                        JD</div>
                      <div
                        class="w-6 h-6 bg-gradient-to-br from-blue-400 to-cyan-500 rounded-full border-2 border-white flex items-center justify-center text-white text-[8px] font-bold">
                        MK</div>
                      <div
                        class="w-6 h-6 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full border-2 border-white flex items-center justify-center text-white text-[8px] font-bold">
                        +5</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Total Pembayaran Pending -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 left-0 w-32 h-32 bg-gradient-to-br from-amber-400/20 to-yellow-400/20 rounded-full -ml-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-tr from-yellow-400/20 to-amber-400/20 rounded-full -mr-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                      </span>
                      <p class="text-emerald-700 text-[10px] font-bold uppercase tracking-wider">Total Pembayaran
                        Pending</p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900" id="totalPending">
                        Rp <%= parseInt(stats.totalPending || 0).toLocaleString('id-ID') %>
                      </p>
                      <span class="text-xs font-bold text-emerald-600">IDR</span>
                    </div>

                    <div id="pendingPaymentsBadge" class="flex items-center gap-1.5 mt-2">
                      <% if (stats.countPending> 0) { %>
                        <span class="px-2 py-1 bg-amber-100 rounded-lg flex items-center gap-1">
                          <i class="fas fa-exclamation-circle text-[8px] text-amber-600"></i>
                          <span class="text-[8px] font-extrabold text-amber-700">
                            <%= stats.countPending %> menunggu
                          </span>
                        </span>
                        <% } else { %>
                          <span class="px-2 py-1 bg-green-100 rounded-lg flex items-center gap-1">
                            <i class="fas fa-check-circle text-[8px] text-green-600"></i>
                            <span class="text-[8px] font-extrabold text-green-700">Semua selesai</span>
                          </span>
                          <% } %>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:-rotate-3 transition-all duration-500">
                    <i class="fas fa-clock text-white text-xl"></i>
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-emerald-100/50">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <div class="w-6 h-6 bg-white rounded-lg flex items-center justify-center shadow-sm">
                        <i class="fas fa-hourglass-half text-amber-500 text-[10px]"></i>
                      </div>
                      <div>
                        <span class="text-[8px] font-medium text-gray-500">Avg. Process Time</span>
                        <p class="text-xs font-extrabold text-amber-600">2.5 hari</p>
                      </div>
                    </div>

                    <div class="w-12 h-12">
                      <svg viewBox="0 0 36 36" class="w-12 h-12">
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                          fill="none" stroke="#e2e8f0" stroke-width="3" stroke-dasharray="85, 100" />
                        <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                          fill="none" stroke="#f59e0b" stroke-width="3" stroke-dasharray="85, 100" />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Transaksi Paid -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-400/20 to-indigo-400/20 rounded-full -mr-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-indigo-400/20 to-blue-400/20 rounded-full -ml-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                      </span>
                      <p class="text-emerald-700 text-[10px] font-bold uppercase tracking-wider">Transaksi Paid</p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900" id="countPaid">
                        <%= stats.countPaid || 0 %>
                      </p>
                      <span class="text-xs font-bold text-emerald-600">transaksi</span>
                    </div>

                    <div class="flex items-center gap-1.5 mt-2">
                      <div class="px-2 py-1 bg-blue-100 rounded-lg flex items-center gap-1">
                        <i class="fas fa-chart-line text-[8px] text-blue-600"></i>
                        <span class="text-[8px] font-extrabold text-blue-700">+8%</span>
                      </div>
                      <span class="text-[7px] text-gray-500">dari kemarin</span>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:rotate-6 transition-all duration-500">
                    <i class="fas fa-check-circle text-white text-xl"></i>
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-emerald-100/50">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <div class="w-6 h-6 bg-white rounded-lg flex items-center justify-center shadow-sm">
                        <i class="fas fa-chart-line text-emerald-600 text-[10px]"></i>
                      </div>
                      <div>
                        <span class="text-[8px] font-medium text-gray-500">Success Rate</span>
                        <p class="text-xs font-extrabold text-blue-700">92%</p>
                      </div>
                    </div>

                    <div class="flex items-center gap-1">
                      <div class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></div>
                      <span class="text-[7px] font-bold text-blue-700">Live</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Transaksi Pending -->
            <div
              class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
              <div
                class="absolute top-0 left-0 w-32 h-32 bg-gradient-to-br from-purple-400/20 to-violet-400/20 rounded-full -ml-10 -mt-10 animate-rotate-slow">
              </div>
              <div
                class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-tr from-violet-400/20 to-purple-400/20 rounded-full -mr-8 -mb-8 animate-rotate-slow animation-delay-2000">
              </div>

              <div class="relative z-10">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="flex items-center gap-1.5 mb-2">
                      <span class="relative flex h-2 w-2">
                        <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
                      </span>
                      <p class="text-emerald-700 text-[10px] font-bold uppercase tracking-wider">Transaksi Pending</p>
                    </div>

                    <div class="flex items-baseline gap-1">
                      <p class="text-4xl font-black text-gray-900" id="countPending">
                        <%= stats.countPending || 0 %>
                      </p>
                      <span class="text-xs font-bold text-emerald-600">transaksi</span>
                    </div>

                    <div class="flex items-center gap-1.5 mt-2">
                      <div class="px-2 py-1 bg-purple-100 rounded-lg flex items-center gap-1">
                        <i class="fas fa-hourglass-half text-[8px] text-purple-600"></i>
                        <span class="text-[8px] font-extrabold text-purple-700">Pending</span>
                      </div>
                    </div>
                  </div>

                  <div
                    class="w-14 h-14 bg-gradient-to-br from-purple-500 to-violet-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500">
                    <i class="fas fa-hourglass-half text-white text-xl"></i>
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-emerald-100/50">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <div class="w-6 h-6 bg-white rounded-lg flex items-center justify-center shadow-sm">
                        <i class="fas fa-clock text-purple-500 text-[10px]"></i>
                      </div>
                      <div>
                        <span class="text-[8px] font-medium text-gray-500">Response Time</span>
                        <p class="text-xs font-extrabold text-purple-700">
                          <% if (stats.avgResponseTime) { %>
                            <%= stats.avgResponseTime %> jam
                              <% } else { %>
                                6 jam
                                <% } %>
                        </p>
                      </div>
                    </div>

                    <div class="flex items-center gap-1">
                      <i class="fas fa-trend-up text-emerald-600 text-xs"></i>
                      <span class="text-[7px] font-bold text-emerald-700">+23%</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Payments Table Premium -->
          <div class="glass-futuristic rounded-2xl border border-white/50 overflow-hidden">
            <div class="gradient-primary px-5 py-4 flex items-center justify-between border-b border-white/30">
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                  <i class="fas fa-exchange-alt text-white"></i>
                </div>
                <div>
                  <h2 class="text-base font-extrabold text-white">Pembayaran Terbaru</h2>
                  <p class="text-emerald-100 text-[10px] font-medium mt-0.5">10 pembayaran terakhir</p>
                </div>
              </div>
              <span
                class="px-3 py-1.5 bg-white/20 backdrop-blur rounded-lg text-white text-[9px] font-extrabold border border-white/30">
                <i class="fas fa-bolt mr-1"></i>
                Live
              </span>
            </div>

            <div class="overflow-x-auto modern-scrollbar bg-white/30 backdrop-blur">
              <table class="w-full">
                <thead class="bg-white/10 backdrop-blur border-b border-white/30">
                  <tr>
                    <th
                      class="py-4 px-6 text-left text-[10px] font-extrabold text-emerald-900 uppercase tracking-wider">
                      Customer</th>
                    <th
                      class="py-4 px-6 text-left text-[10px] font-extrabold text-emerald-900 uppercase tracking-wider">
                      Amount</th>
                    <th
                      class="py-4 px-6 text-left text-[10px] font-extrabold text-emerald-900 uppercase tracking-wider">
                      Status</th>
                    <th
                      class="py-4 px-6 text-left text-[10px] font-extrabold text-emerald-900 uppercase tracking-wider">
                      Metode</th>
                    <th
                      class="py-4 px-6 text-left text-[10px] font-extrabold text-emerald-900 uppercase tracking-wider">
                      Tanggal</th>
                  </tr>
                </thead>
                <tbody id="paymentsTableBody" class="divide-y divide-white/30">
                  <% if (!recentPayments || recentPayments.length===0) { %>
                    <tr class="placeholder-row">
                      <td colspan="5" class="py-12 px-6 text-center">
                        <div class="flex flex-col items-center justify-center">
                          <div class="relative">
                            <div
                              class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-4 border-white/50 float-slow">
                              <i class="fas fa-inbox text-3xl text-emerald-300"></i>
                            </div>
                            <div
                              class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                              <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                            </div>
                          </div>
                          <h3 class="text-lg font-extrabold text-gray-900 mb-2">Belum ada pembayaran</h3>
                          <p class="text-sm text-emerald-700 font-medium">Transaksi akan muncul di sini</p>
                        </div>
                      </td>
                    </tr>
                    <% } else { %>
                      <% recentPayments.forEach(function(t, index) { %>
                        <% let statusClass='' ; let statusGradient='' ; if (t.payment_status==='pending' ) {
                          statusClass='status-pending text-white' ; statusGradient='status-pending' ; } else if
                          (t.payment_status==='paid' ) { statusClass='status-paid text-white' ;
                          statusGradient='status-paid' ; } else if (t.payment_status==='rejected' ) {
                          statusClass='status-rejected text-white' ; statusGradient='status-rejected' ; } else {
                          statusClass='bg-gray-500 text-white' ; statusGradient='bg-gray-500' ; } const
                          amount=parseInt(t.total_amount || 0); const isHighValue=amount> 1000000;

                          const methodIcon = {
                          'bank_transfer': 'fas fa-university',
                          'credit_card': 'fas fa-credit-card',
                          'e-wallet': 'fas fa-wallet',
                          'cash': 'fas fa-money-bill'
                          }[t.payment_method] || 'fas fa-money-bill-wave';

                          const date = new Date(t.created_at);
                          const formattedDate = date.toLocaleDateString('id-ID', {
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric'
                          });
                          const formattedTime = date.toLocaleTimeString('id-ID', {
                          hour: '2-digit',
                          minute: '2-digit'
                          });
                          %>
                          <tr
                            class="table-row hover:bg-white/40 transition-all duration-300 border-b border-white/30 last:border-b-0 bg-white/20 backdrop-blur fade-in"
                            style="animation-delay: <%= index * 0.05 %>s">
                            <td class="py-4 px-6">
                              <div class="flex items-center gap-3">
                                <div
                                  class="w-10 h-10 bg-gradient-to-br from-emerald-100 to-green-100 rounded-xl flex items-center justify-center border border-white/60">
                                  <i class="fas fa-user text-emerald-600"></i>
                                </div>
                                <div>
                                  <div class="font-extrabold text-sm text-gray-900">
                                    <%= t.customer_name || 'Unknown' %>
                                  </div>
                                  <div class="text-[8px] font-medium text-emerald-700">ID: <%= t.transaction_id || 'N/A'
                                      %>
                                  </div>
                                </div>
                              </div>
                            </td>
                            <td class="py-4 px-6">
                              <div class="flex flex-col">
                                <span
                                  class="font-extrabold text-lg <%= isHighValue ? 'text-emerald-700' : 'text-gray-900' %>">
                                  Rp <%= amount.toLocaleString('id-ID') %>
                                </span>
                                <% if (t.commission_amount) { %>
                                  <span class="text-[8px] font-medium text-gray-500 flex items-center gap-1 mt-0.5">
                                    <i class="fas fa-coins text-emerald-400"></i>
                                    Komisi: Rp <%= parseInt(t.commission_amount).toLocaleString('id-ID') %>
                                  </span>
                                  <% } %>
                              </div>
                            </td>
                            <td class="py-4 px-6">
                              <span
                                class="px-3 py-1.5 rounded-lg text-[8px] font-extrabold <%= statusClass %> flex items-center gap-1 border border-white/30 w-fit">
                                <i class="fas fa-circle text-[5px] mr-1"></i>
                                <%= t.payment_status.toUpperCase() %>
                              </span>
                            </td>
                            <td class="py-4 px-6">
                              <div class="flex items-center gap-2">
                                <i class="<%= methodIcon %> text-emerald-500 text-xs"></i>
                                <span class="text-xs font-medium text-gray-700">
                                  <%= t.payment_method %>
                                </span>
                              </div>
                            </td>
                            <td class="py-4 px-6">
                              <div class="flex flex-col">
                                <span class="font-extrabold text-xs text-gray-900">
                                  <%= formattedDate %>
                                </span>
                                <span class="text-[8px] font-medium text-gray-500 flex items-center gap-1 mt-0.5">
                                  <i class="fas fa-clock text-emerald-400"></i>
                                  <%= formattedTime %>
                                </span>
                              </div>
                            </td>
                          </tr>
                          <% }); %>
                            <% } %>
                </tbody>
              </table>
            </div>

            <div class="px-6 py-4 bg-white/30 backdrop-blur border-t border-white/30 rounded-b-2xl">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span
                    class="text-[10px] font-medium text-emerald-700 bg-white/60 px-3 py-2 rounded-lg border border-white/60">
                    Total pembayaran terbaru: <span class="font-extrabold">
                      <%= recentPayments ? recentPayments.length : 0 %>
                    </span>
                  </span>
                </div>
                <span
                  class="text-[9px] font-medium text-gray-500 bg-white/60 px-3 py-2 rounded-lg border border-white/60">
                  <i class="fas fa-clock mr-1"></i>
                  Terakhir diperbarui: Sekarang
                </span>
              </div>
            </div>
          </div>

          <!-- Pagination Premium -->
          <div class="mt-8 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span
                class="text-[10px] font-medium text-emerald-700 bg-white/60 px-3 py-2 rounded-lg border border-white/60">
                Menampilkan 1 - <%= recentPayments ? recentPayments.length : 0 %> dari <%= recentPayments ?
                    recentPayments.length : 0 %> pembayaran
              </span>
            </div>
            <div class="flex items-center gap-2">
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all disabled:opacity-50"
                disabled>
                <i class="fas fa-chevron-left text-xs"></i>
              </button>
              <button
                class="w-8 h-8 rounded-lg gradient-primary text-white flex items-center justify-center text-xs font-bold shadow-lg">1</button>
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all text-xs font-bold">2</button>
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all text-xs font-bold">3</button>
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all">
                <i class="fas fa-chevron-right text-xs"></i>
              </button>
            </div>
          </div>
        </div>
      </main>

      <script>
        // Function to animate values (similar to admin dashboard)
        function animateValue(id, start, end, duration, isCurrency = false) {
          const obj = document.getElementById(id);
          if (!obj) return;

          let startTimestamp = null;

          const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const value = Math.floor(progress * (end - start) + start);

            if (isCurrency) {
              obj.textContent = 'Rp ' + value.toLocaleString('id-ID');
            } else {
              obj.textContent = value;
            }

            if (progress < 1) {
              window.requestAnimationFrame(step);
            }
          };

          window.requestAnimationFrame(step);
        }

        // Function to load dashboard stats (if using AJAX)
        async function loadDashboardStats() {
          try {
            const response = await fetch('/api/finance/dashboard/stats');
            const data = await response.json();

            if (data.success) {
              // Update stats with animation
              animateValue('totalPaid', 0, data.stats.totalPaid, 1000, true);
              animateValue('totalPending', 0, data.stats.totalPending, 1000, true);
              animateValue('countPaid', 0, data.stats.countPaid, 1000);
              animateValue('countPending', 0, data.stats.countPending, 1000);

              // Update pending payments badge
              const pendingBadge = document.getElementById('pendingPaymentsBadge');
              if (data.stats.countPending > 0) {
                pendingBadge.innerHTML = `
                  <span class="px-2 py-1 bg-amber-100 rounded-lg flex items-center gap-1">
                    <i class="fas fa-exclamation-circle text-[8px] text-amber-600"></i>
                    <span class="text-[8px] font-extrabold text-amber-700">${data.stats.countPending} menunggu</span>
                  </span>
                `;
              } else {
                pendingBadge.innerHTML = `
                  <span class="px-2 py-1 bg-green-100 rounded-lg flex items-center gap-1">
                    <i class="fas fa-check-circle text-[8px] text-green-600"></i>
                    <span class="text-[8px] font-extrabold text-green-700">Semua selesai</span>
                  </span>
                `;
              }
            }
          } catch (error) {
            console.error('Error loading dashboard stats:', error);
            showError('Gagal memuat data dashboard');
          }
        }

        function showError(message) {
          const statsContainer = document.getElementById('statsContainer');
          const errorDiv = document.createElement('div');
          errorDiv.className = 'col-span-4';
          errorDiv.innerHTML = `
            <div class="glass-futuristic rounded-xl p-4 border-l-4 border-red-500">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gradient-to-r from-red-600 to-rose-600 rounded-lg flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-exclamation-triangle text-white"></i>
                </div>
                <div>
                  <p class="font-extrabold text-gray-900 text-sm">${message}</p>
                  <p class="text-[9px] text-gray-600 mt-1">Coba refresh halaman atau hubungi support</p>
                </div>
              </div>
            </div>
          `;
          statsContainer.insertBefore(errorDiv, statsContainer.firstChild);
        }

        // Load stats on page load (if using AJAX)
        document.addEventListener('DOMContentLoaded', () => {
          // Uncomment below if using AJAX for stats
          // loadDashboardStats();

          // Auto-refresh every 30 seconds (if using AJAX)
          // setInterval(loadDashboardStats, 30000);
        });
      </script>
</body>

</html>