    <!-- Success Modal (will be created dynamically) -->
    <!-- Success modal template will be injected by JavaScript -->

    <script>
      // Real-time profile completeness calculation
      function computeProfileRealtime() {
        try {
          const fields = ['name', 'email', 'phone', 'bank_name', 'bank_account', 'bank_account_name'];
          let filled = 0;
          fields.forEach(id => {
            const el = document.getElementById(id);
            const v = el ? (el.value || '').toString().trim() : '';
            if (v) filled++;
          });
          const percent = Math.round((filled / fields.length) * 100);

          // Update elements
          const percentEl = document.getElementById('profileRealtimePercent');
          const barEl = document.getElementById('profileRealtimeBar');
          const textEl = document.getElementById('profileRealtimeText');

          if (percentEl) {
            const span = percentEl.querySelector('span') || percentEl;
            span.textContent = percent;

            // Update gradient based on percentage
            if (percent < 30) {
              percentEl.className = 'w-20 h-20 bg-gradient-to-br from-red-500 to-red-600 rounded-full flex items-center justify-center shadow-2xl';
            } else if (percent < 70) {
              percentEl.className = 'w-20 h-20 bg-gradient-to-br from-amber-500 to-amber-600 rounded-full flex items-center justify-center shadow-2xl';
            } else {
              percentEl.className = 'w-20 h-20 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center shadow-2xl';
            }
          }

          if (barEl) {
            barEl.style.width = percent + '%';
            if (percent === 100) {
              barEl.className = 'progress-bar-fill green';
            } else if (percent >= 70) {
              barEl.className = 'progress-bar-fill yellow';
            } else {
              barEl.className = 'progress-bar-fill red';
            }
          }
          if (textEl) textEl.textContent = percent + '%';
        } catch (e) {
          console.error('computeProfileRealtime error', e);
        }
      }

      // Attach listeners to inputs for live update
      (function attachRealtimeListeners() {
        const ids = ['name', 'email', 'phone', 'bank_name', 'bank_account', 'bank_account_name'];
        ids.forEach(id => {
          const el = document.getElementById(id);
          if (!el) return;
          const ev = (el.tagName === 'SELECT') ? 'change' : 'input';
          el.addEventListener(ev, computeProfileRealtime);
        });

        // Initial compute
        setTimeout(() => {
          computeProfileRealtime();
        }, 300);
      })();

      // Form submission handler
      document.getElementById('updateProfileForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('submitBtn');
        const loadingOverlay = document.getElementById('loadingOverlay');

        // Show loading with animation
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Menyimpan...</span>';
        loadingOverlay.classList.remove('hidden');

        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);

        try {
          const startTime = Date.now();
          const response = await fetch('/api/auth/profile', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          // Ensure minimum loading time for better UX
          const elapsed = Date.now() - startTime;
          if (elapsed < 1300) {
            await new Promise(resolve => setTimeout(resolve, 1300 - elapsed));
          }

          if (result.success) {
            // Create success modal
            let modal = document.getElementById('successModal');
            if (!modal) {
              modal = document.createElement('div');
              modal.id = 'successModal';
              modal.className = 'fixed inset-0 flex items-center justify-center z-50 p-4';
              modal.innerHTML = `
              <div class="glass-futuristic rounded-2xl p-10 flex flex-col items-center text-center max-w-md w-full fade-in border border-white/50">
                <div class="mb-6 relative">
                  <svg class="w-24 h-24" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(16,185,129,0.2)" stroke-width="8"/>
                    <circle cx="50" cy="50" r="45" fill="none" stroke="#10b981" stroke-width="8" 
                            stroke-dasharray="283" stroke-dashoffset="283" 
                            style="animation: circleFill 0.6s ease-in-out forwards;"/>
                    <path class="checkmark-path" d="M30,50 L45,65 L70,35" fill="none" stroke="#10b981" 
                          stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <h2 class="text-2xl font-extrabold text-gray-900 mb-3">Berhasil Disimpan!</h2>
                <p class="text-sm text-gray-600 mb-6">Profil Anda telah berhasil diperbarui.</p>
                <div class="w-full bg-white/30 rounded-full h-2 overflow-hidden">
                  <div class="h-2 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full" 
                       style="animation: progressFill 2s linear forwards;"></div>
                </div>
              </div>
            `;
              document.body.appendChild(modal);
            } else {
              modal.style.display = 'flex';
            }

            // Update localStorage for cross-tab synchronization
            try {
              const updatedProfileForSync = {
                full_name: data.name || '',
                email: data.email || '',
                phone: data.phone || '',
                bank_name: data.bank_name || '',
                bank_account_number: data.bank_account || '',
                bank_account_name: data.bank_account_name || ''
              };
              localStorage.setItem('affiliateProfileUpdate', JSON.stringify(updatedProfileForSync));
              localStorage.setItem('affiliateProfileUpdate_ts', Date.now().toString());

              // Trigger storage event for other tabs
              window.dispatchEvent(new Event('storage'));
            } catch (e) {
              console.warn('Could not update localStorage', e);
            }

            // Hide modal and reload after 2 seconds
            setTimeout(() => {
              modal.style.display = 'none';
              window.location.reload();
            }, 2000);

          } else {
            // Error modal
            const errorModal = document.createElement('div');
            errorModal.className = 'fixed inset-0 flex items-center justify-center z-50 p-4';
            errorModal.innerHTML = `
            <div class="glass-futuristic rounded-2xl p-8 flex flex-col items-center text-center max-w-md w-full fade-in border border-white/50">
              <div class="w-20 h-20 bg-gradient-to-r from-red-500 to-rose-500 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-times-circle text-white text-3xl"></i>
              </div>
              <h3 class="text-xl font-extrabold text-gray-900 mb-3">Gagal Menyimpan</h3>
              <p class="text-sm text-gray-600 mb-6">${result.message || 'Terjadi kesalahan. Silakan coba lagi.'}</p>
              <button onclick="this.parentElement.parentElement.remove()" 
                class="w-full gradient-primary text-white py-3.5 px-6 rounded-xl font-extrabold hover:opacity-90 transition-all duration-200">
                Tutup
              </button>
            </div>
          `;
            document.body.appendChild(errorModal);
          }
        } catch (error) {
          console.error('Error:', error);
          // Network error modal
          const networkErrorModal = document.createElement('div');
          networkErrorModal.className = 'fixed inset-0 flex items-center justify-center z-50 p-4';
          networkErrorModal.innerHTML = `
          <div class="glass-futuristic rounded-2xl p-8 flex flex-col items-center text-center max-w-md w-full fade-in border border-white/50">
            <div class="w-20 h-20 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full flex items-center justify-center mb-6">
              <i class="fas fa-wifi text-white text-3xl"></i>
            </div>
            <h3 class="text-xl font-extrabold text-gray-900 mb-3">Koneksi Terputus</h3>
            <p class="text-sm text-gray-600 mb-6">Periksa koneksi internet Anda dan coba lagi.</p>
            <button onclick="this.parentElement.parentElement.remove()" 
              class="w-full gradient-primary text-white py-3.5 px-6 rounded-xl font-extrabold hover:opacity-90 transition-all duration-200">
              Tutup
            </button>
          </div>
        `;
          document.body.appendChild(networkErrorModal);
        } finally {
          // Hide loading
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fas fa-save"></i><span>Simpan Perubahan</span><i class="fas fa-arrow-right ml-1"></i>';
          loadingOverlay.classList.add('hidden');
        }
      });

      // Mobile optimizations
      document.addEventListener('DOMContentLoaded', function () {
        // Add touch feedback for mobile
        const interactiveElements = document.querySelectorAll('button, a, input, select');
        interactiveElements.forEach(el => {
          el.addEventListener('touchstart', function () {
            this.classList.add('active:scale-95');
          });
          el.addEventListener('touchend', function () {
            this.classList.remove('active:scale-95');
          });
        });

        // Auto-focus first input on mobile
        if (window.innerWidth < 768) {
          const firstInput = document.querySelector('#name');
          if (firstInput) {
            setTimeout(() => {
              firstInput.focus({ preventScroll: true });
              // Smooth scroll to input
              window.scrollTo({
                top: firstInput.getBoundingClientRect().top + window.pageYOffset - 100,
                behavior: 'smooth'
              });
            }, 500);
          }
        }

        // Add hover effect to cards on desktop
        if (window.innerWidth >= 768) {
          const cards = document.querySelectorAll('.hover-lift');
          cards.forEach(card => {
            card.style.transition = 'all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
          });
        }
      });

      // Listen for storage events to update profile in real-time
      window.addEventListener('storage', function (e) {
        if (e.key === 'affiliateProfileUpdate') {
          try {
            const updatedData = JSON.parse(e.newValue);
            if (updatedData.full_name) {
              const nameEl = document.querySelector('.text-xl.font-extrabold.text-gray-900');
              if (nameEl) nameEl.textContent = updatedData.full_name;
            }
            // Recompute profile completeness
            computeProfileRealtime();
          } catch (err) {
            console.warn('Failed to process storage event', err);
          }
        }
      });
    </script>
</body>

</html>