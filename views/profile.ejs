<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile Saya - Affillink</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fadeIn {
      animation: fadeIn 0.3s ease-out;
    }

    .alert-success {
      animation: fadeIn 0.3s ease-out;
    }

    .input-group:focus-within i {
      color: #22c55e;
    }

    .input-group:focus-within input,
    .input-group:focus-within select {
      border-color: #22c55e;
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
    }

    .profile-avatar {
      background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
    }
  </style>
</head>

<body class="bg-gray-50 min-h-screen">
  <!-- Navbar -->
  <%- include('./navbar/navbar.ejs', { name: user.name }) %>

    <!-- Main Content -->
    <div class="pt-20 pb-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <% if (typeof error !=='undefined' && error) { %>
        <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg alert-success">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-500 text-xl"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm text-red-700 font-medium">
                <%= error %>
              </p>
            </div>
          </div>
        </div>
        <% } %>

          <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Profile Saya</h1>
            <p class="mt-2 text-gray-600">Kelola informasi profil dan rekening Anda</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Sidebar -->
            <div class="lg:col-span-1">
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="p-6 border-b border-gray-100">
                  <div class="flex flex-col items-center text-center">
                    <!-- Avatar -->
                    <div class="w-24 h-24 profile-avatar rounded-full flex items-center justify-center mb-4 shadow-lg">
                      <span class="text-white text-3xl font-bold">
                        <%= user.name.charAt(0).toUpperCase() %>
                      </span>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900">
                      <%= user.name %>
                    </h3>
                    <p class="text-sm text-gray-500 mt-1">
                      <%= user.email %>
                    </p>
                    <span
                      class="mt-3 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <i class="fas fa-circle text-green-500 text-xs mr-1.5"></i>
                      <%= user.role ? user.role.replace('_', ' ' ).toUpperCase() : 'USER' %>
                    </span>
                    <span
                      class="mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium <%= user.affiliate_status === 'approved' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                      <i
                        class="fas fa-circle <%= user.affiliate_status === 'approved' ? 'text-green-500' : 'text-yellow-500' %> text-xs mr-1.5"></i>
                      <%= user.affiliate_status ? user.affiliate_status.toUpperCase() : 'INACTIVE' %>
                    </span>
                  </div>
                </div>
                <nav class="p-4 space-y-2">
                  <a href="/dashboard"
                    class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors <%= (activePage === 'dashboard') ? 'bg-green-50 text-green-700 font-medium' : '' %>">
                    <div class="w-8 h-8 bg-gray-200 rounded-lg flex items-center justify-center">
                      <i class="fas fa-home text-gray-600 text-sm"></i>
                    </div>
                    <span>Dashboard</span>
                  </a>
                  <a href="/settings"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= (activePage === 'settings') ? 'bg-green-50 text-green-700 font-medium' : 'text-gray-700 hover:bg-gray-50' %>">
                    <div
                      class="w-8 h-8 <%= (activePage === 'settings') ? 'bg-green-500' : 'bg-gray-200' %> rounded-lg flex items-center justify-center">
                      <i
                        class="fas fa-cog <%= (activePage === 'settings') ? 'text-white' : 'text-gray-600' %> text-sm"></i>
                    </div>
                    <span>Settings</span>
                  </a>
                  <a href="/profile"
                    class="flex items-center gap-3 px-4 py-3 rounded-lg transition-colors <%= (activePage === 'profile') ? 'bg-green-50 text-green-700 font-medium' : 'text-gray-700 hover:bg-gray-50' %>">
                    <div
                      class="w-8 h-8 <%= (activePage === 'profile') ? 'bg-green-500' : 'bg-gray-200' %> rounded-lg flex items-center justify-center">
                      <i
                        class="fas fa-user <%= (activePage === 'profile') ? 'text-white' : 'text-gray-600' %> text-sm"></i>
                    </div>
                    <span>Profile</span>
                  </a>
                </nav>
              </div>

              <!-- Stats Box -->
              <div class="mt-6 bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6 border border-green-100">
                <h3 class="font-semibold text-green-900 mb-4">Statistik Akun</h3>
                <div class="space-y-3">
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-green-700">Total Komisi</span>
                    <span class="font-semibold text-green-900">Rp <%= (user.total_commission ||
                        0).toLocaleString('id-ID') %></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-green-700">Total Penarikan</span>
                    <span class="font-semibold text-green-900">Rp <%= (user.total_withdrawn ||
                        0).toLocaleString('id-ID') %></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-sm text-green-700">Rate Komisi</span>
                    <span class="font-semibold text-green-900">
                      <%= user.commission_rate || 0 %>%
                    </span>
                  </div>
                </div>
              </div>

              <!-- Account Info -->
              <div class="mt-6 bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
                <h3 class="font-semibold text-gray-900 mb-4">Informasi Akun</h3>
                <div class="space-y-3 text-sm">
                  <div>
                    <span class="text-gray-500">Status</span>
                    <p class="font-medium text-gray-900 flex items-center gap-2">
                      <i class="fas fa-circle text-green-500 text-xs"></i>
                      <%= user.status==='active' ? 'Aktif' : user.status || 'Aktif' %>
                    </p>
                  </div>
                  <div>
                    <span class="text-gray-500">Terdaftar Sejak</span>
                    <p class="font-medium text-gray-900">
                      <%= user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID', { day: 'numeric' ,
                        month: 'long' , year: 'numeric' }) : new Date().toLocaleDateString('id-ID', { day: 'numeric' ,
                        month: 'long' , year: 'numeric' }) %>
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Main Content -->
            <div class="lg:col-span-2">
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="p-6 border-b border-gray-100">
                  <div class="flex items-center gap-3">
                    <div
                      class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-lg flex items-center justify-center">
                      <i class="fas fa-user-edit text-white"></i>
                    </div>
                    <div>
                      <h2 class="text-xl font-semibold text-gray-900">Edit Profil</h2>
                      <p class="text-sm text-gray-500 mt-1">Update informasi pribadi dan rekening</p>
                    </div>
                  </div>
                </div>

                <div class="p-6">
                  <form id="updateProfileForm" class="space-y-6">
                    <!-- Personal Information -->
                    <div>
                      <h3 class="text-lg font-medium text-gray-900 mb-4">Informasi Pribadi</h3>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Name -->
                        <div>
                          <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                            Nama Lengkap <span class="text-red-500">*</span>
                          </label>
                          <div class="input-group relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                              <i class="fas fa-user text-gray-400 transition-colors"></i>
                            </div>
                            <input type="text" id="name" name="name" value="<%= user.name %>" required
                              class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none transition-all duration-200"
                              placeholder="Nama lengkap" />
                          </div>
                        </div>

                        <!-- Email -->
                        <div>
                          <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                            Email <span class="text-red-500">*</span>
                          </label>
                          <div class="input-group relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                              <i class="fas fa-envelope text-gray-400 transition-colors"></i>
                            </div>
                            <input type="email" id="email" name="email" value="<%= user.email %>" required
                              class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none transition-all duration-200"
                              placeholder="email@contoh.com" />
                          </div>
                        </div>

                        <!-- Phone -->
                        <div class="md:col-span-2">
                          <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                            Nomor Telepon
                          </label>
                          <div class="input-group relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                              <i class="fas fa-phone text-gray-400 transition-colors"></i>
                            </div>
                            <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>"
                              class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none transition-all duration-200"
                              placeholder="08xxxxxxxxxx" />
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Bank Information -->
                    <div class="border-t border-gray-100 pt-6">
                      <h3 class="text-lg font-medium text-gray-900 mb-4">
                        Informasi Rekening Bank
                        <span class="text-sm font-normal text-gray-500">(Untuk penarikan komisi)</span>
                      </h3>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Bank Name -->
                        <div>
                          <label for="bank_name" class="block text-sm font-medium text-gray-700 mb-2">
                            Nama Bank
                          </label>
                          <div class="input-group relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                              <i class="fas fa-university text-gray-400 transition-colors"></i>
                            </div>
                            <select id="bank_name" name="bank_name"
                              class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none transition-all duration-200 bg-white">
                              <option value="">Pilih Bank</option>
                              <option value="BCA" <%=user.bank_name==='BCA' ? 'selected' : '' %>>BCA</option>
                              <option value="BNI" <%=user.bank_name==='BNI' ? 'selected' : '' %>>BNI</option>
                              <option value="BRI" <%=user.bank_name==='BRI' ? 'selected' : '' %>>BRI</option>
                              <option value="MANDIRI" <%=user.bank_name==='MANDIRI' ? 'selected' : '' %>>MANDIRI
                              </option>
                              <option value="CIMB" <%=user.bank_name==='CIMB' ? 'selected' : '' %>>CIMB Niaga
                              </option>
                              <option value="PERMATA" <%=user.bank_name==='PERMATA' ? 'selected' : '' %>>Permata
                              </option>
                              <option value="DANAMON" <%=user.bank_name==='DANAMON' ? 'selected' : '' %>>Danamon
                              </option>
                              <option value="BTN" <%=user.bank_name==='BTN' ? 'selected' : '' %>>BTN</option>
                              <option value="JENIUS" <%=user.bank_name==='JENIUS' ? 'selected' : '' %>>Jenius
                              </option>
                              <option value="BSI" <%=user.bank_name==='BSI' ? 'selected' : '' %>>BSI</option>
                              <option value="LAINNYA" <%=user.bank_name==='LAINNYA' ? 'selected' : '' %>>Lainnya
                              </option>
                            </select>
                          </div>
                        </div>

                        <!-- Bank Account -->
                        <div>
                          <label for="bank_account" class="block text-sm font-medium text-gray-700 mb-2">
                            Nomor Rekening
                          </label>
                          <div class="input-group relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                              <i class="fas fa-credit-card text-gray-400 transition-colors"></i>
                            </div>
                            <input type="text" id="bank_account" name="bank_account"
                              value="<%= user.bank_account || '' %>"
                              class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none transition-all duration-200"
                              placeholder="Nomor rekening" />
                          </div>
                        </div>

                        <!-- Bank Account Name -->
                        <div class="md:col-span-2">
                          <label for="bank_account_name" class="block text-sm font-medium text-gray-700 mb-2">
                            Nama Pemilik Rekening
                          </label>
                          <div class="input-group relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                              <i class="fas fa-user-tie text-gray-400 transition-colors"></i>
                            </div>
                            <input type="text" id="bank_account_name" name="bank_account_name"
                              value="<%= user.bank_account_name || '' %>"
                              class="block w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none transition-all duration-200"
                              placeholder="Nama sesuai rekening" />
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-4 border-t border-gray-100">
                      <button type="submit" id="submitBtn"
                        class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3 px-6 rounded-lg font-medium hover:from-green-700 hover:to-emerald-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                        <i class="fas fa-save"></i>
                        <span>Simpan Perubahan</span>
                      </button>
                    </div>
                  </form>
                </div>
              </div>

              <!-- Additional Info -->
              <div class="mt-6 bg-blue-50 rounded-xl p-6 border border-blue-100">
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0">
                    <i class="fas fa-info-circle text-blue-600 text-xl"></i>
                  </div>
                  <div>
                    <h3 class="font-semibold text-blue-900 mb-2">Informasi Penting</h3>
                    <ul class="text-sm text-blue-700 space-y-1">
                      <li>• Pastikan informasi rekening bank benar untuk penarikan komisi</li>
                      <li>• Nama pemilik rekening harus sesuai dengan nama di KTP</li>
                      <li>• Email digunakan untuk notifikasi dan reset password</li>
                      <li>• Perubahan profil akan langsung disimpan ke database</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-8 flex flex-col items-center gap-4">
        <div class="animate-spin rounded-full h-12 w-12 border-4 border-green-500 border-t-transparent"></div>
        <p class="text-gray-700 font-medium">Memproses...</p>
      </div>
    </div>

    <script>
      document.getElementById('updateProfileForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('submitBtn');
        const loadingOverlay = document.getElementById('loadingOverlay');

        // Show loading
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Menyimpan...</span>';
        loadingOverlay.classList.remove('hidden');

        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData);

        try {
          const response = await fetch('/api/auth/profile', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();


          if (result.success) {
            // Modal sukses di tengah layar
            let modal = document.getElementById('successModal');
            if (!modal) {
              modal = document.createElement('div');
              modal.id = 'successModal';
              modal.className = 'fixed inset-0 flex items-center justify-center z-50';
              modal.innerHTML = `
                <div class="bg-white rounded-2xl shadow-2xl px-16 py-14 flex flex-col items-center animate-fadeIn max-w-lg w-full">
                  <svg class="mb-6" width="96" height="96" viewBox="0 0 52 52">
                    <circle cx="26" cy="26" r="25" fill="none" stroke="#8fd19e" stroke-width="3" style="stroke-dasharray:166;stroke-dashoffset:166;animation:strokeCircle 0.6s cubic-bezier(0.65,0,0.45,1) forwards;"/>
                    <path fill="none" stroke="#8fd19e" stroke-width="3" stroke-linecap="round" d="M14 27l7 7 16-16" style="stroke-dasharray:48;stroke-dashoffset:48;animation:strokeCheck 0.4s 0.6s cubic-bezier(0.65,0,0.45,1) forwards;"/>
                  </svg>
                  <h2 class="text-3xl font-bold text-gray-800 mb-2">Berhasil!</h2>
                  <p class="text-lg text-gray-600">Profil berhasil diperbarui!</p>
                </div>
                <style>
                  @keyframes strokeCircle { to { stroke-dashoffset: 0; } }
                  @keyframes strokeCheck { to { stroke-dashoffset: 0; } }
                </style>
              `;
              document.body.appendChild(modal);
            } else {
              modal.style.display = 'flex';
            }
            // Sembunyikan modal setelah 2 detik lalu reload halaman
            setTimeout(() => {
              modal.style.display = 'none';
              window.location.reload();
            }, 2000);


            // Update user info in sidebar jika perlu
            if (result.user) {
              const nameElement = document.querySelector('.text-xl.font-bold.text-gray-900');
              if (nameElement) nameElement.textContent = result.user.name || user.name;
            }

          } else {
            alert('Gagal memperbarui profil: ' + (result.message || 'Unknown error'));
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Terjadi kesalahan saat memperbarui profil');
        } finally {
          // Hide loading
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="fas fa-save"></i><span>Simpan Perubahan</span>';
          loadingOverlay.classList.add('hidden');
        }
      });
    </script>
</body>

</html>