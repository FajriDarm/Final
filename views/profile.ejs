        </div>
        <!-- Progress Bar dengan Animasi Shimmer -->
        <div class="w-full bg-white/30 rounded-full h-2 overflow-hidden relative">
          <div class="absolute inset-0 h-2 rounded-full animate-shimmer" style="
          background: linear-gradient(90deg,
            rgba(16, 185, 129, 0.1) 0%,
            rgba(16, 185, 129, 0.3) 25%,
            rgba(16, 185, 129, 0.6) 50%,
            rgba(16, 185, 129, 0.3) 75%,
            rgba(16, 185, 129, 0.1) 100%);
          background-size: 200% 100%;
        "></div>
        </div>
