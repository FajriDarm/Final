<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Profile Saya - Affillink</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-secondary {
      background: linear-gradient(165deg, #047857 0%, #059669 50%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(165deg, #065f46 0%, #047857 50%, #059669 100%);
    }

    .gradient-warning {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    .gradient-info {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .gradient-danger {
      background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
    }

    .gradient-purple {
      background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
    }

    .gradient-teal {
      background: linear-gradient(165deg, #0d9488 0%, #14b8a6 50%, #2dd4bf 100%);
    }

    .gradient-blue {
      background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
    }

    .gradient-amber {
      background: linear-gradient(165deg, #d97706 0%, #f59e0b 50%, #fbbf24 100%);
    }

    /* Success Gradient */
    .gradient-success {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Badge 3D Effect */
    .badge-3d {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 rgba(0, 0, 0, 0.05);
    }

    .badge-3d:hover {
      transform: translateY(-2px) scale(1.05);
      box-shadow: 0 6px 0 rgba(0, 0, 0, 0.05);
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Custom Scrollbar */
    .modern-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .modern-scrollbar::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: linear-gradient(145deg, #10b981, #059669);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(145deg, #059669, #047857);
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    @keyframes shimmer-progress {
      0% {
        background-position: -200% center;
      }

      100% {
        background-position: 200% center;
      }
    }

    .animate-shimmer {
      animation: shimmer-progress 1.5s infinite linear;
    }

    /* Glow Text */
    .glow-text {
      text-shadow: 0 0 10px rgba(16, 185, 129, 0.3),
        0 0 20px rgba(16, 185, 129, 0.2);
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Animations */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .slide-up {
      animation: slideUp 0.5s ease-out;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white),
        linear-gradient(135deg, #059669, #10b981, #34d399);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Hover Lift */
    .hover-lift {
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .hover-lift:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px -10px rgba(16, 185, 129, 0.2);
    }

    /* Profile Avatar */
    .profile-avatar {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.3), 0 0 0 4px rgba(255, 255, 255, 0.9);
    }

    /* Input Focus Effects */
    .input-container:focus-within .input-icon {
      color: #10b981;
      transform: translateY(-1px);
    }

    .input-container:focus-within input,
    .input-container:focus-within select {
      border-color: #10b981;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
      transform: translateY(-1px);
    }

    /* Progress Bar */
    .progress-bar {
      height: 0.5rem;
      border-radius: 9999px;
      overflow: hidden;
      background: rgba(229, 231, 235, 0.5);
    }

    .progress-bar-fill {
      height: 100%;
      border-radius: 9999px;
      transition: width 0.5s ease;
    }

    .progress-bar-fill.green {
      background: linear-gradient(90deg, #10b981, #059669);
    }

    .progress-bar-fill.yellow {
      background: linear-gradient(90deg, #f59e0b, #d97706);
    }

    .progress-bar-fill.red {
      background: linear-gradient(90deg, #ef4444, #dc2626);
    }

    /* Checkmark Animation */
    @keyframes circleFill {
      to {
        stroke-dashoffset: 0;
      }
    }

    @keyframes progressFill {
      from {
        width: 0%;
      }

      to {
        width: 100%;
      }
    }

    .checkmark-path {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: checkmark 0.5s ease-in-out 0.3s forwards;
    }

    @keyframes checkmark {
      0% {
        stroke-dashoffset: 100;
        opacity: 0;
      }

      100% {
        stroke-dashoffset: 0;
        opacity: 1;
      }
    }

    /* Mobile Optimizations */
    @media (max-width: 640px) {
      .mobile-stack {
        display: flex;
        flex-direction: column;
      }
    }

    /* Navigation Link Styles */
    .nav-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.875rem 1rem;
      border-radius: 0.75rem;
      transition: all 0.3s ease;
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.4);
    }

    .nav-link.active {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
    }

    .nav-link.active .nav-icon {
      background: rgba(255, 255, 255, 0.2);
      color: white;
    }

    .nav-icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
  </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
  <!-- Ultra Modern Decorative Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
    <div
      class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
    </div>
    <div
      class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
    </div>

    <!-- Animated Grid Lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

    <!-- Floating Particles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
    <div
      class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
    </div>
  </div>

  <!-- Navbar -->
  <%- include('./navbar/navbar.ejs', { name: user.name }) %>

    <!-- Main Content -->
    <main class="ml-56 pt-16 min-h-screen relative z-10">
      <div class="p-6 max-w-7xl mx-auto" style="margin-left:0;">
        <!-- Premium Page Header - Sesuai dengan dashboard -->
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 animate-slide-in">
          <div class="mb-4 lg:mb-0">
            <div class="flex items-center gap-4">
              <div class="relative">
                <div
                  class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
                  <i class="fas fa-user-circle text-white text-2xl"></i>
                </div>
                <div
                  class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                  <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                </div>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h1
                    class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
                    Profile Saya
                  </h1>
                  <span
                    class="px-3 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 rounded-lg text-white text-xs font-bold tracking-wider shadow-lg">
                    <%= user.role ? user.role.replace('_', ' ' ).toUpperCase() : 'USER' %>
                  </span>
                </div>
                <p class="text-sm text-emerald-700 font-medium">Kelola informasi profil dan rekening Anda</p>
              </div>
            </div>
          </div>

          <!-- Premium Date & Status Badges -->
          <div class="flex items-center gap-3">
            <div class="neomorph rounded-xl px-4 py-2.5 flex items-center gap-3">
              <div class="w-8 h-8 gradient-secondary rounded-lg flex items-center justify-center shadow-lg">
                <i class="fas fa-calendar-alt text-white text-sm"></i>
              </div>
              <div>
                <p class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider">Tanggal</p>
                <p class="text-xs font-bold text-gray-800 whitespace-nowrap">
                  <%= new Date().toLocaleDateString('id-ID', { day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                </p>
              </div>
            </div>

            <div class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-xl relative shimmer">
              <div class="relative">
                <i class="fas fa-bell text-white text-sm"></i>
                <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full"></span>
                <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></span>
              </div>
              <div>
                <p class="text-[10px] text-white/90 font-bold uppercase tracking-wider">Live Status</p>
                <p class="text-xs font-bold text-white">Updates Real-time</p>
              </div>
            </div>

            <span
              class="px-3 py-1.5 rounded-lg text-[8px] font-extrabold <%= user.affiliate_status === 'approved' ? 'gradient-success' : 'gradient-warning' %> text-white border border-white/30 flex items-center gap-1">
              <i class="fas <%= user.affiliate_status === 'approved' ? 'fa-check-circle' : 'fa-clock' %>"></i>
              <%= user.affiliate_status ? user.affiliate_status.toUpperCase() : 'INACTIVE' %>
            </span>
          </div>
        </div>

        <!-- Error Alert Premium -->
        <% if (typeof error !=='undefined' && error) { %>
          <div class="glass-futuristic rounded-xl p-4 border-l-4 border-red-500 mb-6 fade-in">
            <div class="flex items-start gap-3">
              <div
                class="w-10 h-10 bg-gradient-to-r from-red-600 to-rose-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="fas fa-exclamation-circle text-white"></i>
              </div>
              <div class="flex-1">
                <p class="font-extrabold text-gray-900 text-sm">Perhatian</p>
                <p class="text-xs text-gray-600 mt-1">
                  <%= error %>
                </p>
              </div>
            </div>
          </div>
          <% } %>

            <!-- Profile Completion Indicator Premium -->
            <div id="profileRealtimeWrapper"
              class="glass-futuristic rounded-2xl p-5 mb-6 hover-lift border border-white/50 fade-in">
              <div class="flex flex-col sm:flex-row items-center gap-5">
                <div class="relative flex-shrink-0">
                  <div
                    class="w-20 h-20 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center shadow-2xl"
                    id="profileRealtimePercent">
                    <span class="text-white font-extrabold text-2xl">-</span>
                  </div>
                  <div
                    class="absolute -bottom-1 -right-1 w-7 h-7 bg-white rounded-full flex items-center justify-center shadow-lg border-2 border-white">
                    <i class="fas fa-chart-line text-emerald-600 text-xs"></i>
                  </div>
                </div>
                <div class="flex-1 w-full">
                  <div class="flex justify-between items-center mb-2">
                    <div>
                      <h3 class="text-sm font-extrabold text-gray-900">Kelengkapan Profil</h3>
                      <p class="text-[10px] text-gray-500 mt-1">Lengkapi profil untuk pengalaman terbaik</p>
                    </div>
                    <div class="text-xl font-extrabold text-emerald-700" id="profileRealtimeText">0%</div>
                  </div>
                  <div class="progress-bar">
                    <div id="profileRealtimeBar" class="progress-bar-fill" style="width:0%"></div>
                  </div>
                  <div class="flex justify-between mt-1">
                    <span class="text-[8px] text-gray-500">0%</span>
                    <span class="text-[8px] text-gray-500">100%</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
              <!-- Sidebar - Left Column -->
              <div class="lg:col-span-1 space-y-6">
                <!-- Profile Card Premium -->
                <div class="glass-futuristic rounded-2xl overflow-hidden border border-white/50 hover-lift">
                  <div class="gradient-secondary px-5 py-4 border-b border-white/30">
                    <div class="flex items-center gap-3">
                      <div
                        class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                        <i class="fas fa-user-circle text-white"></i>
                      </div>
                      <div>
                        <h3 class="text-base font-extrabold text-white">Informasi Akun</h3>
                        <p class="text-emerald-100 text-[10px] font-medium mt-0.5">Detail profil Anda</p>
                      </div>
                    </div>
                  </div>

                  <div class="p-5 bg-white/30 backdrop-blur">
                    <div class="flex flex-col items-center text-center mb-5">
                      <!-- Avatar -->
                      <div class="relative mb-4">
                        <div
                          class="w-28 h-28 profile-avatar rounded-full flex items-center justify-center shadow-2xl border-4 border-white/50">
                          <span class="text-white text-3xl font-extrabold">
                            <%= user.name.charAt(0).toUpperCase() %>
                          </span>
                        </div>
                        <div
                          class="absolute bottom-1 right-1 w-8 h-8 bg-white rounded-full flex items-center justify-center shadow-lg border-2 border-white">
                          <i class="fas fa-check-circle text-emerald-500"></i>
                        </div>
                      </div>

                      <h3 class="text-xl font-extrabold text-gray-900 mb-1">
                        <%= user.name %>
                      </h3>
                      <p class="text-xs text-gray-500 mb-4 flex items-center justify-center gap-1">
                        <i class="fas fa-envelope text-emerald-400"></i>
                        <%= user.email %>
                      </p>

                      <div class="w-full space-y-2">
                        <div
