  <script>
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      
      try {
        const response = await fetch('/api/auth/profile', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${localStorage.getItem('token')}`
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.success) {
          const updated = result.user || data;
          document.getElementById('info-name').innerText = updated.name || '';
          document.getElementById('info-email').innerText = updated.email || '';
          document.getElementById('info-role').innerText = updated.role || (user && user.role) || '';
          document.getElementById('info-bank-name').innerText = updated.bank_name || '-';
          document.getElementById('info-bank-account-name').innerText = updated.bank_account_name || '-';
          document.getElementById('info-bank-account-number').innerText = updated.bank_account_number || '-';

          // Update form fields in case server normalized values
          document.getElementById('name').value = updated.name || '';
          document.getElementById('email').value = updated.email || '';
          document.getElementById('bank_name').value = updated.bank_name || '';
          document.getElementById('bank_account_name').value = updated.bank_account_name || '';
          document.getElementById('bank_account_number').value = updated.bank_account_number || '';

          alert('Profil berhasil diperbarui!');
        } else {
