    <script>
      // Utility: parse ?ref= from URL
      function getAffiliateRefFromUrl() {
        try {
          const params = new URLSearchParams(window.location.search);
          return params.get("ref") || "";
        } catch (e) {
          return "";
        }
      }

      // Open modal and optionally prefill event/affiliate info
      function openDealModal(opts = {}) {
        const modal = document.getElementById("dealModal");
        document.getElementById("deal_event_id").value = opts.eventId || "";
        // prefer explicit opt, fallback to URL ref
        document.getElementById("deal_affiliate_ref").value =
          opts.ref || getAffiliateRefFromUrl();
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.getElementById("dealModalOverlay").focus();
      }

      function closeDealModal() {
        const modal = document.getElementById("dealModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      // Close handlers
      document
        .getElementById("dealModalClose")
        .addEventListener("click", closeDealModal);
      document
        .getElementById("dealCancel")
        .addEventListener("click", closeDealModal);
      document
        .getElementById("dealModalOverlay")
        .addEventListener("click", closeDealModal);

      // Delegate clicks for any "Get this deal" button/link
      document.addEventListener("click", function (e) {
        const btn = e.target.closest("a,button");
        if (!btn) return;

        const text = (btn.textContent || "").toLowerCase();
        // Trigger if button/link has explicit data-action or visible text contains 'get this deal'
        if (
          (btn.dataset && btn.dataset.action === "get-deal") ||
          text.includes("get this deal")
        ) {
          e.preventDefault();
          // pass event id/ref if provided via data attributes
          const eventId =
            btn.dataset.eventId || btn.getAttribute("data-event-id") || "";
          const ref = btn.dataset.ref || btn.getAttribute("data-ref") || "";
          openDealModal({ eventId, ref });
        }
      });

      // Optional: prefill affiliate ref on page load if present
      (function () {
        const ref = getAffiliateRefFromUrl();
        if (ref) {
          const el = document.getElementById("deal_affiliate_ref");
          if (el) el.value = ref;
        }
      })();

      // Track affiliate click to server (non-blocking)
      async function trackAffiliateClick(ref, eventSlug) {
        if (!ref) return;
        try {
          await fetch("/api/affiliate/track-click", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ref, event_slug: eventSlug || null }),
          });
        } catch (e) {
          console.debug("track click failed", e);
        }
      }

      // If page loaded with ?ref=... or cookie present, send a tracking ping
      document.addEventListener("DOMContentLoaded", function () {
        try {
          const params = new URLSearchParams(window.location.search);
          const ref =
            params.get("ref") ||
            document.cookie.match(/affiliate_ref=([^;]+)/)?.[1] ||
            "";
          const eventSlug =
            params.get("event") ||
            document.cookie.match(/event_slug=([^;]+)/)?.[1] ||
            "";
          if (ref) trackAffiliateClick(ref, eventSlug);
        } catch (e) {}
      });
    </script>

    <!-- Bank Info Modal -->
    <div
      id="bankModal"
      class="fixed inset-0 z-50 hidden items-center justify-center"
    >
      <div
        id="bankModalOverlay"
        class="absolute inset-0 bg-black bg-opacity-50"
      ></div>
      <div
        class="relative w-full max-w-lg mx-auto bg-white rounded-2xl shadow-lg p-6 z-50"
      >
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-semibold">Info Pembayaran</h3>
          <button id="bankModalClose" class="text-gray-500 hover:text-gray-700">
            &times;
          </button>
        </div>

        <div id="bankDetails" class="space-y-3">
          <div>
            <div class="text-sm text-gray-500">Bank</div>
            <div id="bank_name" class="font-semibold text-lg">-</div>
          </div>
          <div>
            <div class="text-sm text-gray-500">Atas Nama</div>
            <div id="bank_account_name" class="font-semibold">-</div>
          </div>
          <div>
            <div class="text-sm text-gray-500">Nomor Rekening</div>
            <div class="flex items-center justify-between gap-4">
              <div
                id="bank_account_number"
                class="font-mono text-lg font-semibold"
              >
                -
              </div>
              <button
                id="copyAccountBtn"
                class="px-3 py-1 bg-gray-100 rounded-md text-sm"
              >
                Salin
              </button>
            </div>
          </div>
          <div id="bankNote" class="text-sm text-gray-600">
            Silakan transfer sesuai nominal, lalu upload bukti pada halaman
            konfirmasi.
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-4">
          <button
            id="bankModalDone"
            class="px-4 py-2 bg-primary text-white rounded-lg"
          >
            Selesai
          </button>
        </div>
      </div>
    </div>

    <script>
      function openBankModal(bank) {
        if (!bank) bank = {};
        document.getElementById("bank_name").textContent =
          bank.bank_name || "-";
        document.getElementById("bank_account_name").textContent =
          bank.bank_account_name || "-";
        document.getElementById("bank_account_number").textContent =
          bank.bank_account_number || "-";
        // show/hide note depending on payment method
        if (
          bank.payment_methods &&
          bank.payment_methods.indexOf("transfer") === -1
        ) {
          document.getElementById("bankNote").textContent =
            "Metode pembayaran lain dipilih; silakan ikuti instruksi yang diberikan.";
        } else {
          document.getElementById("bankNote").textContent =
            "Silakan transfer sesuai nominal, lalu upload bukti pada halaman konfirmasi.";
        }

        const modal = document.getElementById("bankModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }

      function closeBankModal() {
        const modal = document.getElementById("bankModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      document
        .getElementById("bankModalClose")
        .addEventListener("click", closeBankModal);
      document
        .getElementById("bankModalDone")
        .addEventListener("click", closeBankModal);
      document
        .getElementById("bankModalOverlay")
        .addEventListener("click", closeBankModal);

      document
        .getElementById("copyAccountBtn")
        .addEventListener("click", function () {
          const txt =
            document.getElementById("bank_account_number").textContent || "";
          if (!txt) return;
          navigator.clipboard
            .writeText(txt)
            .then(() => {
              this.textContent = "Tersalin";
              setTimeout(() => (this.textContent = "Salin"), 1500);
            })
            .catch(() => {
              alert("Gagal menyalin nomor rekening");
            });
        });

      // Intercept deal form submit to use AJAX and show bank modal
      document
        .getElementById("dealForm")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const form = e.target;
          const data = {
            customer_name: form.customer_name.value,
            customer_email: form.customer_email.value,
            customer_phone: form.customer_phone.value,
            payment_method: form.payment_method.value,
            event_id: form.event_id
              ? form.event_id.value
              : document.getElementById("deal_event_id").value,
            affiliate_ref: form.affiliate_ref
              ? form.affiliate_ref.value
              : document.getElementById("deal_affiliate_ref").value,
          };

          try {
            const res = await fetch("/transactions", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data),
            });

            const json = await res.json();
            if (!json || !json.success) {
              alert(
                "Terjadi kesalahan saat menyimpan transaksi. Silakan coba lagi.",
              );
              return;
            }

            // Close deal modal
            closeDealModal();

            // Show bank info from response if available, otherwise use button data
            const bank = json.bankInfo || {
              bank_name:
                form.datasetBankName ||
                document
                  .querySelector('[data-event-id="' + data.event_id + '"]')
                  ?.getAttribute("data-bank-name") ||
                "",
              bank_account_name:
                form.datasetBankAccountName ||
                document
                  .querySelector('[data-event-id="' + data.event_id + '"]')
                  ?.getAttribute("data-bank-account-name") ||
                "",
              bank_account_number:
                form.datasetBankAccountNumber ||
                document
                  .querySelector('[data-event-id="' + data.event_id + '"]')
                  ?.getAttribute("data-bank-account-number") ||
                "",
              payment_methods:
                form.datasetPaymentMethods ||
                document
                  .querySelector('[data-event-id="' + data.event_id + '"]')
                  ?.getAttribute("data-payment-methods") ||
                "",
            };

            openBankModal(bank);
          } catch (err) {
            console.error("submit transaction error", err);
            alert("Terjadi kesalahan, coba lagi.");
          }
        });
    </script>
  </body>
</html>
