    <script>
      // Load active events on page load
      document.addEventListener("DOMContentLoaded", async function () {
        await loadActiveEvents();
      });

      async function loadActiveEvents() {
        const eventsLoading = document.getElementById("eventsLoading");
        const eventsContainer = document.getElementById("eventsContainer");
        const noEvents = document.getElementById("noEvents");

        try {
          const response = await fetch("/api/admin/events/active");
          const data = await response.json();
          console.debug("Loaded active events:", data);

          eventsLoading.classList.add("hidden");

          if (data.success && data.data.length > 0) {
            eventsContainer.classList.remove("hidden");
            displayEvents(data.data);
          } else {
            noEvents.classList.remove("hidden");
          }
        } catch (error) {
          console.error("Error loading events:", error);
          eventsLoading.classList.add("hidden");
          noEvents.classList.remove("hidden");
        }
      }

      function displayEvents(events) {
        const container = document.getElementById("eventsContainer");
        container.innerHTML = "";

        events.forEach((event, index) => {
          const priceOriginal = Number(event.price_original) || 0;
          const priceDiscount = Number(event.price_discount) || 0;
          const isGratis = priceOriginal === 0;
          const discount =
            priceOriginal > 0 &&
            priceDiscount > 0 &&
            priceDiscount < priceOriginal
              ? Math.round(
                  ((priceOriginal - priceDiscount) / priceOriginal) * 100,
                )
              : 0;
          const delay = 200 + index * 100;

          const priceHtml = isGratis
            ? `<div class="text-4xl font-bold text-dark">Gratis</div>`
            : `
                        ${priceOriginal > priceDiscount ? `<div class="text-sm text-gray-500 line-through">Rp ${parseInt(priceOriginal).toLocaleString("id-ID")}</div>` : ""}
                        <div class="text-4xl font-bold text-dark">Rp ${parseInt(priceDiscount > 0 ? priceDiscount : priceOriginal).toLocaleString("id-ID")}</div>
                        ${priceOriginal > priceDiscount ? `<div class="text-sm text-red-500 font-semibold mt-1">Save Rp ${Math.max(0, parseInt(priceOriginal) - parseInt(priceDiscount)).toLocaleString("id-ID")}</div>` : ""}
                    `;

          const eventCard = `
                    <div class="bg-white rounded-2xl shadow-card p-8 border-2 ${event.status === "active" ? "border-primary" : "border-gray-light"} relative transition-all duration-300 hover:-translate-y-2"
                         data-aos="fade-up" data-aos-duration="800" data-aos-delay="${delay}">
                        ${
                          discount > 0
                            ? `
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-red-500 text-white px-6 py-1 rounded-full text-sm font-semibold">
                            ${discount}% OFF
                        </div>
                        `
                            : ""
                        }

                        <h3 class="text-xl font-bold text-primary-dark mb-3">${event.name}</h3>
                        ${event.description ? `<p class="text-gray text-sm mb-4">${event.description}</p>` : ""}

                        <div class="mb-6">
                            ${priceHtml}
                        </div>

                        <div class="mb-6 pb-6 border-b border-gray-200">
                            <div class="flex items-center text-sm text-gray-500 mb-2">
                                <i class="fas fa-calendar-alt mr-2"></i>
                                <span>${event.start_date ? new Date(event.start_date).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }) : "—"}</span>
                            </div>
                            <div class="flex items-center text-sm text-gray-500">
                                <i class="fas fa-clock mr-2"></i>
                                <span>Until ${event.end_date ? new Date(event.end_date).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }) : "—"}</span>
                            </div>
                        </div>

                        <button type="button" data-action="get-deal" data-event-id="${event.id}" data-ref="${event.affiliate_link ? event.affiliate_link.code : ""}"
                           data-bank-name="${event.bank_name || ""}"
                           data-bank-account-name="${event.bank_account_name || ""}"
                           data-bank-account-number="${event.bank_account_number || ""}"
                           data-payment-methods="${event.payment_methods || ""}"
                           class="block w-full py-3 bg-gradient-to-br from-primary to-primary-light text-white font-semibold rounded-xl text-center shadow-primary hover:shadow-xl transition-all duration-300">
                          Get This Deal
                        </button>
                    </div>
                `;

          container.innerHTML += eventCard;
        });
      }

      // Refresh events when user returns to the tab (helps see new events created in admin)
      window.addEventListener("focus", function () {
        loadActiveEvents();
      });
    </script>

