<nav
  class="fixed top-0 left-0 w-full z-50 bg-white shadow-md h-16 px-4 sm:px-6 flex items-center justify-between"
>
  <div class="flex items-center gap-3">
    <button
      type="button"
      id="sidebarToggle"
      aria-label="Buka menu"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full text-gray-600 hover:text-green-700 hover:bg-green-50 transition-colors focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2"
    >
      <i class="fas fa-bars text-lg"></i>
    </button>

    <img
      src="/images/logoAffilllink3.png"
      alt="Logo Affillink"
      class="w-12 h-12 sm:w-14 sm:h-14 object-contain"
    />
    <span class="text-green-700 text-xl sm:text-2xl font-bold tracking-wide">Affillink</span>
  </div>

  <div class="relative flex items-center gap-2 sm:gap-3">
    <div class="hidden sm:flex flex-col items-end mr-1 sm:mr-2">
      <div class="text-gray-600 text-xs sm:text-sm leading-tight">
        Halo,
        <span class="font-semibold">
          <%= typeof name !=='undefined' ? name : 'User' %>
        </span>
      </div>
      <div class="text-gray-400 text-[10px] sm:text-xs">Semangat ya kerjanya. :)</div>
    </div>
    <button
      id="profileMenuBtn"
      class="relative bg-gradient-to-br from-green-500 to-emerald-600 rounded-full p-1 flex items-center justify-center focus:outline-none hover:shadow-lg transition-all duration-300 group"
      style="width: 40px; height: 40px"
      aria-label="Buka menu profil"
    >
      <!-- Avatar dengan efek gradient dan animasi -->
      <div class="relative w-full h-full rounded-full overflow-hidden">
        <div
          class="absolute inset-0 bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center"
        >
          <i class="fas fa-user text-white text-lg"></i>
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-br from-transparent via-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        ></div>
      </div>

      <!-- Indikator status online -->
      <div
        class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-white rounded-full"
      ></div>
    </button>

    <!-- Dropdown Menu -->
    <div
      class="opacity-0 scale-95 pointer-events-none absolute right-0 top-12 w-56 bg-white rounded-xl shadow-xl py-3 z-50 border border-green-100 transition-all duration-300 overflow-hidden"
      id="profileDropdown"
    >
      <!-- Header Profil -->
      <div class="px-4 py-3 border-b border-gray-100">
        <div class="flex items-center gap-3">
          <div
            class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center"
          >
            <i class="fas fa-user text-white"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800">
              <%= typeof name !=='undefined' ? name : 'User' %>
            </p>
            <p class="text-xs text-gray-500 flex items-center gap-1">
              <i class="fas fa-circle text-green-400 text-xs"></i>
              Online
            </p>
          </div>
        </div>
      </div>

      <!-- Menu Items -->
      <div class="py-2">
        <a
          href="/profile"
          class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-green-50 transition-colors group"
        >
          <div
            class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-50 to-purple-100 flex items-center justify-center group-hover:from-purple-100 group-hover:to-purple-200 transition-colors"
          >
            <i class="fas fa-user-circle text-purple-600 text-sm"></i>
          </div>
          <span class="text-sm">Profile Saya</span>
        </a>

        <a
          href="/settings"
          class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-green-50 transition-colors group"
        >
          <div
            class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-50 to-amber-100 flex items-center justify-center group-hover:from-amber-100 group-hover:to-amber-200 transition-colors"
          >
            <i class="fas fa-cog text-amber-600 text-sm"></i>
          </div>
          <span class="text-sm">Pengaturan</span>
        </a>
      </div>

      <!-- Logout Section -->
      <div class="border-t border-gray-100 pt-2 mt-2">
        <form action="/logout" method="POST">
          <button
            type="submit"
            class="flex items-center gap-3 w-full text-left px-4 py-3 text-red-600 hover:bg-red-50 transition-colors group"
          >
            <div
              class="w-8 h-8 rounded-lg bg-gradient-to-br from-red-50 to-red-100 flex items-center justify-center group-hover:from-red-100 group-hover:to-red-200 transition-colors"
            >
              <i class="fas fa-sign-out-alt text-red-600 text-sm"></i>
            </div>
            <span class="text-sm font-medium">Keluar</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</nav>

<script>
  // Tambahkan FontAwesome jika belum ada
  if (!document.querySelector('link[href*="font-awesome"]')) {
    const faLink = document.createElement("link");
    faLink.rel = "stylesheet";
    faLink.href =
      "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css";
    document.head.appendChild(faLink);
  }

  const btn = document.getElementById("profileMenuBtn");
  const dropdown = document.getElementById("profileDropdown");

  if (btn && dropdown) {
    // Toggle dropdown dengan animasi
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (dropdown.classList.contains("opacity-0")) {
        dropdown.classList.remove(
          "opacity-0",
          "scale-95",
          "pointer-events-none",
        );
        dropdown.classList.add("opacity-100", "scale-100");
        setTimeout(() => {
          dropdown.classList.remove("pointer-events-none");
        }, 10);
      } else {
        dropdown.classList.remove("opacity-100", "scale-100");
        dropdown.classList.add("opacity-0", "scale-95", "pointer-events-none");
      }
    });

    // Close dropdown ketika klik di luar
    document.addEventListener("click", function (e) {
      if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove("opacity-100", "scale-100");
        dropdown.classList.add("opacity-0", "scale-95", "pointer-events-none");
      }
    });

    // Close dropdown ketika tekan ESC
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        dropdown.classList.remove("opacity-100", "scale-100");
        dropdown.classList.add("opacity-0", "scale-95", "pointer-events-none");
      }
    });

    // Efek hover pada dropdown items
    const dropdownItems = dropdown.querySelectorAll("a, button");
    dropdownItems.forEach((item) => {
      item.addEventListener("mouseenter", function () {
        this.style.transform = "translateX(4px)";
      });
      item.addEventListener("mouseleave", function () {
        this.style.transform = "translateX(0)";
      });
    });
  }

  // Sidebar toggle (mobile)
  const getSidebarRefs = () => ({
    sidebar: document.querySelector('[data-sidebar]'),
    overlay: document.getElementById('sidebarOverlay'),
    closeButtons: document.querySelectorAll('[data-sidebar-close]'),
    toggleBtn: document.getElementById('sidebarToggle'),
  });

  const closeSidebar = () => {
    const { sidebar, overlay } = getSidebarRefs();
    if (!sidebar) return;
    sidebar.classList.add('-translate-x-full');
    sidebar.classList.remove('translate-x-0');
    if (overlay) {
      overlay.classList.add('hidden');
      overlay.classList.remove('block');
    }
    document.body.classList.remove('overflow-hidden');
  };

  const openSidebar = () => {
    const { sidebar, overlay } = getSidebarRefs();
    if (!sidebar) return;
    sidebar.classList.remove('-translate-x-full');
    sidebar.classList.add('translate-x-0');
    if (overlay) {
      overlay.classList.remove('hidden');
      overlay.classList.add('block');
    }
    document.body.classList.add('overflow-hidden');
  };

  const bindSidebarControls = () => {
    const { toggleBtn, overlay, closeButtons } = getSidebarRefs();
    toggleBtn?.addEventListener('click', () => {
      const { sidebar } = getSidebarRefs();
      if (!sidebar) return;
      const isHidden = sidebar.classList.contains('-translate-x-full');
      isHidden ? openSidebar() : closeSidebar();
    });

    overlay?.addEventListener('click', closeSidebar);
    closeButtons.forEach((btn) => btn.addEventListener('click', closeSidebar));
  };

  bindSidebarControls();

  window.addEventListener('resize', () => {
    const { sidebar, overlay } = getSidebarRefs();
    if (window.innerWidth >= 768) {
      sidebar?.classList.remove('-translate-x-full');
      sidebar?.classList.add('translate-x-0');
      overlay?.classList.add('hidden');
      overlay?.classList.remove('block');
      document.body.classList.remove('overflow-hidden');
    } else {
      sidebar?.classList.add('-translate-x-full');
      sidebar?.classList.remove('translate-x-0');
    }
  });

  // Animasi untuk dropdown
  const style = document.createElement("style");
  style.textContent = `
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .animate-fadeInUp {
      animation: fadeInUp 0.3s ease-out forwards;
    }
    
    #profileMenuBtn {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    #profileMenuBtn:hover {
      transform: scale(1.05);
      box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }
    
    #profileMenuBtn:active {
      transform: scale(0.95);
    }
    
    #profileDropdown {
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }
    
    #profileDropdown a, #profileDropdown button {
      transition: all 0.2s ease;
    }
  `;
  document.head.appendChild(style);
</script>
