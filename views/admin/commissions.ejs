<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Komisi - Affillink Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
                linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
        }

        /* Premium Glassmorphism */
        .glass-premium {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
                inset 0 1px 2px rgba(255, 255, 255, 0.8);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
                0 0 0 1px rgba(255, 255, 255, 0.5) inset,
                0 0 15px rgba(16, 185, 129, 0.05);
        }

        /* Premium Gradients */
        .gradient-primary {
            background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
            box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
        }

        .gradient-secondary {
            background: linear-gradient(165deg, #047857 0%, #059669 50%, #10b981 100%);
        }

        .gradient-accent {
            background: linear-gradient(165deg, #065f46 0%, #047857 50%, #059669 100%);
        }

        .gradient-info {
            background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
        }

        .gradient-warning {
            background: linear-gradient(165deg, #f59e0b 0%, #fbbf24 50%, #fcd34d 100%);
        }

        .gradient-danger {
            background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
        }

        /* Type Gradients */
        .gradient-flat {
            background: linear-gradient(165deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
        }

        .gradient-percentage {
            background: linear-gradient(165deg, #7c3aed 0%, #8b5cf6 50%, #a78bfa 100%);
        }

        .gradient-active {
            background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
        }

        .gradient-inactive {
            background: linear-gradient(165deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
        }

        .gradient-global {
            background: linear-gradient(165deg, #f59e0b 0%, #fbbf24 50%, #fcd34d 100%);
        }

        .gradient-event {
            background: linear-gradient(165deg, #8b5cf6 0%, #a78bfa 50%, #c4b5fd 100%);
        }

        /* Card Effects */
        .card-luxury {
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .card-luxury:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
                0 0 0 1px rgba(255, 255, 255, 0.8) inset;
        }

        /* Badge 3D Effect */
        .badge-3d {
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 4px 0 rgba(0, 0, 0, 0.05);
        }

        .badge-3d:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 0 rgba(0, 0, 0, 0.05);
        }

        /* Pulse Animation */
        .pulse-premium {
            animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulsePremium {

            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
                    0 0 0 0 rgba(16, 185, 129, 0.2);
            }

            50% {
                box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
                    0 0 0 30px rgba(16, 185, 129, 0);
            }
        }

        /* Custom Scrollbar */
        .modern-scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .modern-scrollbar::-webkit-scrollbar-track {
            background: rgba(16, 185, 129, 0.05);
            border-radius: 10px;
        }

        .modern-scrollbar::-webkit-scrollbar-thumb {
            background: linear-gradient(145deg, #10b981, #059669);
            border-radius: 10px;
        }

        .modern-scrollbar::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(145deg, #059669, #047857);
        }

        /* Floating Animation */
        .float-slow {
            animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        /* Shimmer Effect */
        .shimmer {
            position: relative;
            overflow: hidden;
        }

        .shimmer::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg,
                    transparent,
                    rgba(255, 255, 255, 0.3),
                    transparent);
            animation: shimmer 5s infinite;
        }

        @keyframes shimmer {
            100% {
                left: 200%;
            }
        }

        /* Glow Text */
        .glow-text {
            text-shadow: 0 0 10px rgba(16, 185, 129, 0.3),
                0 0 20px rgba(16, 185, 129, 0.2);
        }

        /* Grid Background */
        .bg-grid-premium {
            background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* Neomorphism */
        .neomorph {
            background: rgba(255, 255, 255, 0.8);
            box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
                -20px -20px 40px rgba(255, 255, 255, 0.8),
                inset 1px 1px 2px rgba(255, 255, 255, 0.8),
                inset -1px -1px 2px rgba(16, 185, 129, 0.05);
        }

        /* Slide In Animation */
        .animate-slide-in {
            animation: slideIn 0.6s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .animate-scale-in {
            animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Fade In Animation */
        .fade-in {
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Animation Delays */
        .animation-delay-2000 {
            animation-delay: 2s;
        }

        .animation-delay-4000 {
            animation-delay: 4s;
        }

        /* Ultra Modern Glassmorphism */
        .glass-futuristic {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
                0 0 0 1px rgba(255, 255, 255, 0.5) inset;
        }

        /* Gradient Orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            z-index: 0;
            opacity: 0.4;
            animation: float-orb 10s ease-in-out infinite;
        }

        @keyframes float-orb {

            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }

            25% {
                transform: translate(10px, -15px) scale(1.1);
            }

            50% {
                transform: translate(-5px, -20px) scale(0.9);
            }

            75% {
                transform: translate(-15px, 5px) scale(1.05);
            }
        }

        /* Card Futuristic */
        .card-futuristic {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

        .card-futuristic::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.7s ease;
            z-index: 1;
            pointer-events: none;
        }

        .card-futuristic:hover::before {
            left: 100%;
        }

        .card-futuristic:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
        }

        /* Border Gradient */
        .border-gradient {
            border: double 1px transparent;
            background-image: linear-gradient(white, white), linear-gradient(135deg, white, white, white);
            background-origin: border-box;
            background-clip: padding-box, border-box;
        }

        /* Pulse Glow */
        @keyframes pulse-glow {

            0%,
            100% {
                opacity: 0.6;
                filter: blur(60px);
            }

            50% {
                opacity: 0.8;
                filter: blur(70px);
            }
        }

        .animate-pulse-glow {
            animation: pulse-glow 4s ease-in-out infinite;
        }

        /* Rotate Slow */
        @keyframes rotate-slow {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .animate-rotate-slow {
            animation: rotate-slow 20s linear infinite;
        }

        /* Table Styles */
        .table-header {
            background: rgba(16, 185, 129, 0.1);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        }

        .table-row {
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(5px);
        }

        .table-row:hover {
            background: rgba(255, 255, 255, 0.6);
            transform: scale(1.01);
            box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.15);
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal-content {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 2rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }

        /* Modal Success */
        .modal-success {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(8px);
        }

        .modal-success .modal-box {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            max-width: 400px;
            width: 100%;
            padding: 2rem;
            text-align: center;
            animation: fadeIn 0.3s ease;
        }

        .modal-success .success-checkmark-bg {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            background: linear-gradient(165deg, #10b981, #059669);
            border-radius: 50%;
            box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
            margin-bottom: 1.5rem;
        }

        .modal-success .success-checkmark-svg {
            display: block;
        }

        .modal-success .success-checkmark-path {
            stroke-dasharray: 40;
            stroke-dashoffset: 40;
            animation: checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards;
        }

        @keyframes checkmark-draw {
            to {
                stroke-dashoffset: 0;
            }
        }

        /* Modal Notifikasi (mengikuti style events) */
        .modal-notification {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(8px);
        }

        .modal-notification .modal-box {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            max-width: 400px;
            width: 100%;
            padding: 2rem;
            text-align: center;
            animation: fadeIn 0.3s ease;
        }

        .modal-notification .notification-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin-bottom: 1.5rem;
        }

        .modal-notification .notification-icon.error {
            background: linear-gradient(165deg, #ef4444, #dc2626);
            box-shadow: 0 10px 20px -5px rgba(239, 68, 68, 0.4);
        }

        .modal-notification .notification-icon.success {
            background: linear-gradient(165deg, #10b981, #059669);
            box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
        }

        .modal-notification .notification-icon.warning {
            background: linear-gradient(165deg, #f59e0b, #d97706);
            box-shadow: 0 10px 20px -5px rgba(245, 158, 11, 0.4);
        }

        .modal-notification .notification-icon.info {
            background: linear-gradient(165deg, #3b82f6, #1d4ed8);
            box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.4);
        }

        .modal-notification .notification-icon i {
            font-size: 2rem;
            color: white;
        }

        /* Line Clamp */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Input Focus Styles */
        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
            border-color: transparent;
        }
    </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
    <!-- Ultra Modern Decorative Orbs -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
        <div
            class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
        </div>
        <div
            class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
        </div>

        <!-- Animated Grid Lines -->
        <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid)" />
        </svg>

        <!-- Floating Particles -->
        <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
        <div
            class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
        </div>
        <div
            class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
        </div>
    </div>

    <!-- Navbar -->
    <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>

        <!-- Sidebar -->
        <%- include('../sidebar/admin.ejs') %>

            <!-- Main Content -->
            <main class="md:ml-64 ml-0 pt-16 min-h-screen relative z-10">
                <div class="p-6">
                    <!-- Premium Page Header - Diperbesar ukuran fontnya -->
                    <div
                        class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 animate-slide-in">
                        <div class="mb-4 lg:mb-0">
                            <div class="flex items-center gap-4">
                                <div class="relative">
                                    <div
                                        class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
                                        <i class="fas fa-percentage text-white text-2xl"></i>
                                    </div>
                                    <div
                                        class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                                        <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <h1
                                            class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
                                            Manajemen Komisi
                                        </h1>
                                        <span
                                            class="px-3 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 rounded-lg text-white text-sm font-bold tracking-wider shadow-lg">
                                            SUPER ADMIN
                                        </span>
                                    </div>
                                    <p class="text-base text-emerald-700 font-medium">Kelola aturan dan tarif komisi
                                        afiliasi</p>
                                </div>
                            </div>
                        </div>

                        <!-- Premium Date & Live Status - Diperbesar ukuran fontnya -->
                        <div class="flex items-center gap-3">
                            <div class="neomorph rounded-xl px-4 py-2.5 flex items-center gap-3">
                                <div
                                    class="w-8 h-8 gradient-secondary rounded-lg flex items-center justify-center shadow-lg">
                                    <i class="fas fa-calendar-alt text-white text-sm"></i>
                                </div>
                                <div>
                                    <p class="text-xs text-emerald-700 font-bold uppercase tracking-wider">Tanggal
                                    </p>
                                    <p class="text-sm font-bold text-gray-800 whitespace-nowrap">
                                        <%= new Date().toLocaleDateString('id-ID', { day: 'numeric' , month: 'long' ,
                                            year: 'numeric' }) %>
                                    </p>
                                </div>
                            </div>

                            <div
                                class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-xl relative shimmer">
                                <div class="relative">
                                    <i class="fas fa-bell text-white text-sm"></i>
                                    <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full"></span>
                                    <span
                                        class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></span>
                                </div>
                                <div>
                                    <p class="text-xs text-white/90 font-bold uppercase tracking-wider">Live Status
                                    </p>
                                    <p class="text-sm font-bold text-white">Updates Real-time</p>
                                </div>
                            </div>

                            <button onclick="openAddModal()"
                                class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-2 shadow-xl hover:scale-105 transition-transform duration-300 border border-white/30">
                                <i class="fas fa-plus text-white text-sm"></i>
                                <span class="text-sm font-bold text-white">Tambah Aturan</span>
                            </button>
                        </div>
                    </div>

                    <!-- Premium Stats Cards - Diperbesar ukuran fontnya -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-7 animate-scale-in">
                        <!-- Total Aturan -->
                        <div
                            class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
                            <div
                                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-emerald-400/20 to-green-400/20 rounded-full -mr-10 -mt-10 animate-rotate-slow">
                            </div>
                            <div
                                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-teal-400/20 to-emerald-400/20 rounded-full -ml-8 -mb-8 animate-rotate-slow animation-delay-2000">
                            </div>

                            <div class="relative z-10">
                                <div class="flex items-start justify-between mb-3">
                                    <div>
                                        <div class="flex items-center gap-1.5 mb-2">
                                            <span class="relative flex h-2 w-2">
                                                <span
                                                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                                <span
                                                    class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                                            </span>
                                            <p class="text-emerald-700 text-xs font-bold uppercase tracking-wider">
                                                Total Aturan</p>
                                        </div>

                                        <div class="flex items-baseline gap-1">
                                            <p class="text-4xl font-black text-gray-900" id="totalRules">-</p>
                                            <span class="text-sm font-bold text-emerald-600">rules</span>
                                        </div>

                                    </div>

                                    <div
                                        class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:rotate-3 transition-all duration-500">
                                        <i class="fas fa-list-check text-white text-xl"></i>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Aturan Aktif -->
                        <div
                            class="glass-futuristic rounded-2xl p-5 card-futuristic group relative overflow-hidden border-gradient">
                            <div
                                class="absolute top-0 left-0 w-32 h-32 bg-gradient-to-br from-emerald-400/20 to-green-400/20 rounded-full -ml-10 -mt-10 animate-rotate-slow">
                            </div>
                            <div
                                class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-tr from-teal-400/20 to-emerald-400/20 rounded-full -mr-8 -mb-8 animate-rotate-slow animation-delay-2000">
