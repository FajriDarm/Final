                                    </div>
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-exclamation-triangle text-green-500 mt-1"></i>
                                        <div>
                                            <strong>Prioritas:</strong> Aturan spesifik event mengesampingkan aturan
                                            global untuk event yang sama
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>

            <!-- Modal Tambah/Edit -->
            <div id="commissionModal" class="modal-overlay">
                <div class="modal-content">
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 gradient-primary rounded-lg flex items-center justify-center">
                                    <i class="fas fa-percentage text-white"></i>
                                </div>
                                <div>
                                    <h2 class="text-xl font-bold text-gray-900" id="modalTitle">Tambah Aturan Komisi
                                    </h2>
                                    <p class="text-gray-500 text-sm">Konfigurasi pengaturan komisi</p>
                                </div>
                            </div>
                            <button onclick="closeModal()"
                                class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
                        </div>

                        <form id="commissionForm">
                            <div class="space-y-4">
                                <div class="form-group">
                                    <label for="eventSelect" class="block text-sm font-medium text-gray-700 mb-2">
                                        <i class="fas fa-calendar-alt mr-2 text-green-600"></i>
                                        Pilihan Event
                                        <span class="text-gray-500 text-xs">(Kosongkan untuk Komisi Global)</span>
                                    </label>
                                    <select id="eventSelect" name="event_id"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                        <option value="">🌍 Komisi Global (Semua Event)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="commissionType" class="block text-sm font-medium text-gray-700 mb-2">
                                        <i class="fas fa-tag mr-2 text-green-600"></i>
                                        Tipe Komisi *
                                    </label>
                                    <select id="commissionType" name="commission_type" required
                                        onchange="handleCommissionTypeChange()"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                        <option value="">Pilih Tipe</option>
                                        <option value="flat">Flat (IDR) - Jumlah tetap per transaksi</option>
                                        <option value="percentage">Persentase (%) - Persentase dari jumlah transaksi
                                        </option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="commissionValue" class="block text-sm font-medium text-gray-700 mb-2">
                                        <i class="fas fa-dollar-sign mr-2 text-green-600"></i>
                                        <span id="valueLabel">Nilai Komisi</span> *
                                    </label>
                                    <div class="relative">
                                        <span id="currencyPrefix"
                                            class="absolute left-4 top-3 text-gray-500 text-sm font-medium hidden">Rp</span>
                                        <input type="text" id="commissionValue" name="commission_value"
                                            placeholder="Masukkan nilai" required
                                            oninput="handleCommissionValueInput(event)"
                                            class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                    </div>
                                    <p id="valueHelp" class="text-xs text-gray-500 mt-1">Masukkan nilai numerik</p>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="form-group">
                                        <label for="minStage" class="block text-sm font-medium text-gray-700 mb-2">
                                            <i class="fas fa-sitemap mr-2 text-green-600"></i>
                                            Stage Minimum
                                        </label>
                                        <select id="minStage" name="min_stage"
                                            class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                            <option value="1">Stage 1 (Sales Chat)</option>
                                            <option value="2">Stage 2 (Payment Verification)</option>
                                            <option value="3" selected>Stage 3 (Delivery Confirmation)</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label for="isActive" class="block text-sm font-medium text-gray-700 mb-2">
                                            <i class="fas fa-toggle-on mr-2 text-green-600"></i>
                                            Status
                                        </label>
                                        <select id="isActive" name="is_active"
                                            class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                            <option value="1">Aktif</option>
                                            <option value="0">Tidak Aktif</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="flex gap-3 mt-8 pt-6 border-t border-gray-100">
                                <button type="submit"
                                    class="gradient-primary text-white rounded-xl px-6 py-3 font-semibold shadow-lg hover:shadow-xl transition-all duration-300 flex-1 flex items-center justify-center gap-2">
                                    <i class="fas fa-save"></i> Simpan Komisi
                                </button>
                                <button type="button" onclick="closeModal()"
                                    class="bg-gray-100 text-gray-700 rounded-xl px-6 py-3 font-semibold hover:bg-gray-200 transition-all duration-300 flex-1 flex items-center justify-center gap-2">
                                    <i class="fas fa-times"></i> Batal
                                </button>
                            </div>
                    </div>
                </div>
            </div>

            <script>
                let currentEditId = null;
                let commissionData = [];

                // ============================================================
                // FUNGSI FORMATTING & INPUT HANDLING
                // ============================================================

                /**
                 * Format number dengan separasi ribuan (Rupiah)
                 * @param {string|number} value - nilai yang akan diformat
                 * @returns {string} - nilai dengan format Rupiah tanpa "Rp"
                 */
                function formatNumberRupiah(value) {
                    if (!value) return '';
                    // Hapus semua karakter non-angka
                    const cleanValue = value.toString().replace(/\D/g, '');
                    if (cleanValue === '') return '';
                    // Format dengan separasi ribuan
                    return parseInt(cleanValue).toLocaleString('id-ID');
                }

                /**
                 * Hapus format Rupiah dan kembalikan ke angka bersih
                 * @param {string} value - nilai dengan format Rupiah
                 * @returns {string} - angka bersih tanpa pemisah
                 */
                function cleanRupiahValue(value) {
                    if (!value) return '0';
                    return value.toString().replace(/\D/g, '') || '0';
                }

                /**
                 * Handle perubahan tipe komisi
                 * Tampilkan/sembunyikan format Rupiah berdasarkan tipe yang dipilih
                 */
                function handleCommissionTypeChange() {
                    const type = document.getElementById('commissionType').value;
                    const valueInput = document.getElementById('commissionValue');
                    const valueLabel = document.getElementById('valueLabel');
                    const currencyPrefix = document.getElementById('currencyPrefix');
                    const valueHelp = document.getElementById('valueHelp');

                    if (type === 'flat') {
                        // Tipe FLAT: Aktifkan format Rupiah
                        valueLabel.textContent = 'Nilai Komisi (IDR)';
                        currencyPrefix.classList.remove('hidden');
                        valueInput.classList.add('pl-10');
                        valueHelp.textContent = 'Contoh: 1.000.000';
                        valueInput.placeholder = '0';

                        // Jika ada nilai sebelumnya, format sebagai Rupiah hanya jika belum ada separator ribuan
                        if (valueInput.value) {
                            let val = valueInput.value;
                            if (!/[.,]/.test(val)) {
                                valueInput.value = formatNumberRupiah(val);
                            }
                        }
                    } else if (type === 'percentage') {
                        // Tipe PERCENTAGE: Non-format
                        valueLabel.textContent = 'Nilai Komisi (%)';
                        currencyPrefix.classList.add('hidden');
                        valueInput.classList.remove('pl-10');
                        valueHelp.textContent = 'Contoh: 5 untuk 5%';
                        valueInput.placeholder = '0';

                        // Hapus format Rupiah jika ada
                        if (valueInput.value) {
                            valueInput.value = cleanRupiahValue(valueInput.value);
                        }
                    } else {
                        // Default: tidak ada format
                        valueLabel.textContent = 'Nilai Komisi';
                        currencyPrefix.classList.add('hidden');
                        valueInput.classList.remove('pl-10');
                        valueHelp.textContent = 'Masukkan nilai numerik';
                        valueInput.placeholder = 'Masukkan nilai';
                    }

                    // Clear input jika tipe belum dipilih
                    if (type === '') {
                        valueInput.value = '';
                    }
                }

                /**
                 * Handle input value dengan auto-format berdasarkan tipe komisi
                 */
                function handleCommissionValueInput(event) {
                    const type = document.getElementById('commissionType').value;
                    const input = event.target;
                    let value = input.value;

                    if (type === 'flat') {
                        // Format sebagai Rupiah dengan separator ribuan
                        const formatted = formatNumberRupiah(value);
                        input.value = formatted;
                    } else if (type === 'percentage') {
                        // Hanya izinkan angka dan satu titik desimal
                        const cleanValue = value.replace(/[^\d.]/g, '');
                        const parts = cleanValue.split('.');
                        if (parts.length > 2) {
                            // Jika lebih dari satu titik, ambil hanya bagian pertama
                            input.value = parts[0] + '.' + parts[1];
                        } else {
                            input.value = cleanValue;
                        }
                    }
                }

                /**
                 * Bersihkan nilai komisi sebelum submit
                 */
                function cleanCommissionValueBeforeSubmit() {
                    const type = document.getElementById('commissionType').value;
                    const valueInput = document.getElementById('commissionValue');
                    let cleanValue = valueInput.value;

                    if (type === 'flat') {
                        // Hapus separator untuk tipe FLAT, kembalikan sebagai integer
                        cleanValue = cleanRupiahValue(cleanValue);
                    } else if (type === 'percentage') {
                        // Ubah ke float untuk percentage
                        cleanValue = parseFloat(cleanValue) || 0;
                    }

                    return cleanValue;
                }

                // ============================================================
                // LOAD DATA ON PAGE LOAD
                // ============================================================

                // Load data on page load
                document.addEventListener('DOMContentLoaded', () => {
                    loadCommissions();
                    loadEvents();
                    loadStats();
                });

                // Load all commission rules
                async function loadCommissions() {
                    try {
                        const response = await fetch('/api/commissions');
                        const data = await response.json();

                        if (data.success) {
                            commissionData = data.commissions || [];
                            renderTable();
                        } else {
                            showError(data.message || 'Gagal memuat aturan komisi');
                        }
                    } catch (err) {
                        console.error('Error loading commissions:', err);
                        showError('Gagal memuat aturan komisi: ' + err.message);
                    }
                }

                // Load events for dropdown
                async function loadEvents() {
                    try {
                        const response = await fetch('/api/commissions/events/list');
                        const data = await response.json();

                        if (data.success) {
                            const select = document.getElementById('eventSelect');
                            data.data.forEach(event => {
                                const option = document.createElement('option');
                                option.value = event.id;
                                option.textContent = event.title;
                                select.appendChild(option);
                            });
                        }
                    } catch (err) {
                        console.error('Error loading events:', err);
                    }
                }

                // Fungsi untuk menghitung average values
                function calculateAverages() {
                    const percentageRules = commissionData.filter(c =>
                        c.commission_type === 'percentage' && c.is_active
                    );

                    const flatRules = commissionData.filter(c =>
                        c.commission_type === 'flat' && c.is_active
                    );

                    // Calculate average percentage
                    let avgPercentage = '-';
                    if (percentageRules.length > 0) {
                        const totalPercent = percentageRules.reduce((sum, c) =>
                            sum + parseFloat(c.commission_value), 0
                        );
                        avgPercentage = (totalPercent / percentageRules.length).toFixed(1) + '%';
                    }

                    // Calculate average flat amount
                    let avgFlat = '-';
                    if (flatRules.length > 0) {
                        const totalFlat = flatRules.reduce((sum, c) =>
                            sum + parseFloat(c.commission_value), 0
                        );
                        avgFlat = 'Rp ' + Math.round(totalFlat / flatRules.length).toLocaleString('id-ID');
                    }

                    return { avgPercentage, avgFlat };
                }

                // Load statistics
                async function loadStats() {
                    try {
                        const response = await fetch('/api/commissions/stats');
                        const data = await response.json();

                        if (data.success) {
                            const stats = data.data;

                            // Animate values
                            animateValue('totalRules', 0, stats.total_rules || 0, 1000);
                            animateValue('activeRules', 0, stats.active_rules || 0, 1000);
                            animateValue('flatRules', 0, stats.flat_rules || 0, 1000);
                            animateValue('percentageRules', 0, stats.percentage_rules || 0, 1000);

                            // Calculate and show additional stats
                            const inactiveRules = (stats.total_rules || 0) - (stats.active_rules || 0);
                            const globalRules = commissionData.filter(c => !c.event_id).length;
                            const averages = calculateAverages();

                            document.getElementById('inactiveRules').textContent = inactiveRules;
                            document.getElementById('globalRules').textContent = globalRules;
                            document.getElementById('avgPercentage').textContent = averages.avgPercentage;
                            document.getElementById('avgFlat').textContent = averages.avgFlat;
                        }
                    } catch (err) {
                        console.error('Error loading stats:', err);
                    }
                }

                function animateValue(id, start, end, duration) {
                    const obj = document.getElementById(id);
                    let startTimestamp = null;

                    const step = (timestamp) => {
                        if (!startTimestamp) startTimestamp = timestamp;
                        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                        const value = Math.floor(progress * (end - start) + start);

                        obj.textContent = value;

                        if (progress < 1) {
                            window.requestAnimationFrame(step);
                        }
                    };

                    window.requestAnimationFrame(step);
                }

                // Render commission table
                function renderTable() {
                    const tbody = document.getElementById('commissionTableBody');

                    if (commissionData.length === 0) {
                        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-12 px-6 text-center">
              <div class="flex flex-col items-center justify-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                  <i class="fas fa-inbox text-green-600 text-xl"></i>
                </div>
                <p class="text-gray-600 font-medium">Belum ada aturan komisi</p>
                <p class="text-sm text-gray-500 mt-2">Aturan komisi akan muncul di sini</p>
              </div>
            </td>
          </tr>
        `;
                        return;
                    }

                    tbody.innerHTML = commissionData.map((commission, index) => {
                        const isGlobal = !commission.event_id;
                        const typeClass = commission.commission_type === 'flat'
                            ? 'bg-blue-100 text-blue-800 border-blue-200'
                            : 'bg-purple-100 text-purple-800 border-purple-200';

                        const statusClass = commission.is_active
                            ? 'bg-green-100 text-green-800 border-green-200'
                            : 'bg-red-100 text-red-800 border-red-200';

                        const valueDisplay = commission.commission_type === 'flat'
                            ? 'Rp ' + parseInt(commission.commission_value).toLocaleString('id-ID')
                            : commission.commission_value + '%';

                        return `
          <tr class="hover:bg-green-50 transition-colors data-cell" style="animation-delay: ${index * 50}ms">
            <td class="py-4 px-6">
              <div class="font-mono text-sm font-bold text-gray-900">#${commission.id}</div>
            </td>
            <td class="py-4 px-6">
              ${isGlobal ?
                                `<div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-globe text-green-600"></i>
                  </div>
                  <span class="font-medium text-gray-900">Komisi Global</span>
                </div>` :
                                `<div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-calendar-alt text-blue-600"></i>
                  </div>
                  <div>
                    <div class="font-medium text-gray-900">${commission.event_title || 'Tidak Diketahui'}</div>
                    <div class="text-xs text-gray-500">Spesifik event</div>
                  </div>
                </div>`}
            </td>
            <td class="py-4 px-6">
              <span class="px-3 py-1.5 rounded-full text-xs font-medium border ${typeClass} status-badge">
                <i class="fas ${commission.commission_type === 'flat' ? 'fa-coins' : 'fa-percentage'} text-xs mr-1.5"></i>
                ${commission.commission_type === 'flat' ? 'FLAT' : 'PERSENTASE'}
              </span>
            </td>
            <td class="py-4 px-6">
              <div class="font-bold ${commission.commission_type === 'flat' ? 'text-blue-700' : 'text-purple-700'}">
                ${valueDisplay}
              </div>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                  <span class="font-bold text-gray-700">${commission.min_stage}</span>
                </div>
                <span class="text-sm text-gray-600">Stage ${commission.min_stage}</span>
              </div>
            </td>
            <td class="py-4 px-6">
              <span class="px-3 py-1.5 rounded-full text-xs font-medium border ${statusClass} status-badge">
                <i class="fas fa-circle text-xs mr-1.5"></i>
                ${commission.is_active ? 'AKTIF' : 'TIDAK AKTIF'}
              </span>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gradient-to-br from-amber-100 to-orange-100 rounded-lg flex items-center justify-center">
                  <i class="fas fa-user text-amber-600"></i>
                </div>
                <span class="text-sm font-medium text-gray-900">${commission.created_by_name || 'System'}</span>
              </div>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center gap-2">
                <button onclick="editCommission(${commission.id})" 
                  class="px-4 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-all duration-200 flex items-center gap-2">
                  <i class="fas fa-edit"></i>
                  Edit
                </button>
                                <button onclick="showDeleteModal(${commission.id})" 
                                    class="px-4 py-2 bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-all duration-200 flex items-center gap-2">
                                    <i class="fas fa-trash"></i>
                                    Hapus
                                </button>
              </div>
            </td>
          </tr>
        `;
                    }).join('');
                }

                // Open add modal
                function openAddModal() {
                    currentEditId = null;
                    document.getElementById('modalTitle').textContent = 'Tambah Aturan Komisi';
                    document.getElementById('commissionForm').reset();
                    // Reset UI ke state default
                    document.getElementById('commissionType').value = '';
                    document.getElementById('commissionValue').value = '';
                    document.getElementById('valueLabel').textContent = 'Nilai Komisi';
                    document.getElementById('currencyPrefix').classList.add('hidden');
                    document.getElementById('commissionValue').classList.remove('pl-10');
                    document.getElementById('valueHelp').textContent = 'Masukkan nilai numerik';
                    document.getElementById('commissionModal').classList.add('show');
                }

                // Open edit modal
                function editCommission(id) {
                    const commission = commissionData.find(c => c.id === id);
                    if (!commission) return;

                    currentEditId = id;
                    document.getElementById('modalTitle').textContent = 'Edit Aturan Komisi';
                    document.getElementById('eventSelect').value = commission.event_id || '';
                    document.getElementById('commissionType').value = commission.commission_type;

                    // Format nilai berdasarkan tipe komisi

                    if (commission.commission_type === 'flat') {
                        let val = commission.commission_value;
                        if (typeof val === 'number') val = val.toString();
                        // Jangan format ulang jika sudah ada separator ribuan
                        document.getElementById('commissionValue').value = val;
                    } else {
                        document.getElementById('commissionValue').value = commission.commission_value;
                    }

                    // Trigger change event untuk update UI label dan placeholder
                    document.getElementById('commissionType').dispatchEvent(new Event('change'));

                    document.getElementById('minStage').value = commission.min_stage;
                    document.getElementById('isActive').value = commission.is_active ? '1' : '0';

                    document.getElementById('commissionModal').classList.add('show');
                }

                // Close modal
                function closeModal() {
                    document.getElementById('commissionModal').classList.remove('show');
                    currentEditId = null;
                }

                // Submit form
                let isSubmitting = false;
                async function submitForm(event) {
                    event.preventDefault();
                    if (isSubmitting) return;
                    isSubmitting = true;
                    const formData = new FormData(document.getElementById('commissionForm'));
                    const rawCommissionValue = cleanCommissionValueBeforeSubmit();
                    const data = {
                        event_id: formData.get('event_id') || null,
                        commission_type: formData.get('commission_type'),
                        commission_value: formData.get('commission_type') === 'flat'
                            ? parseInt(rawCommissionValue)
                            : parseFloat(rawCommissionValue),
                        min_stage: parseInt(formData.get('min_stage')),
                        is_active: parseInt(formData.get('is_active'))
                    };
                    const url = currentEditId ? `/api/commissions/${currentEditId}` : '/api/commissions';
                    const method = currentEditId ? 'PUT' : 'POST';
                    try {
                        const response = await fetch(url, {
                            method: method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();
                        if (result.success) {
                            closeModal();
                            await loadCommissions();
                            await loadStats();
                            if (method === 'POST') {
                                showAddEditSuccessModal('Aturan komisi berhasil ditambahkan');
                            } else {
                                showAddEditSuccessModal('Aturan komisi berhasil diedit');
                            }
                        } else {
                            showError(result.message || 'Operasi gagal');
                        }
                    } catch (err) {
                        console.error('Error:', err);
                        showError('Terjadi kesalahan');
                    } finally {
                        isSubmitting = false;
                    }
                }
                // Pastikan hanya satu handler submit
                document.addEventListener('DOMContentLoaded', function () {
                    const form = document.getElementById('commissionForm');
                    if (form) {
                        form.addEventListener('submit', submitForm);
                    }
                });

                // Modal konfirmasi hapus
                                // Modal konfirmasi hapus mirip events.ejs
                                let currentItemToDelete = null;
                                let deleteCallback = null;

                                function showDeleteModal(id, message = 'Apakah Anda yakin ingin menghapus aturan komisi ini?', callback = null) {
                                    currentItemToDelete = id;
                                    deleteCallback = callback;
                                    // Set pesan konfirmasi
                                    const messageElement = document.getElementById('deleteConfirmMessage');
                                    if (messageElement) {
                                        messageElement.textContent = message;
                                    }
                                    // Tampilkan modal
                                    const modal = document.getElementById('deleteConfirmModal');
                                    modal.style.display = 'flex';
                                    setupDeleteModalButtons();
                                }

                                function setupDeleteModalButtons() {
                                    const yesBtn = document.getElementById('deleteModalYes');
                                    const noBtn = document.getElementById('deleteModalNo');
                                    // Clone tombol untuk menghapus event listener lama
                                    const newYesBtn = yesBtn.cloneNode(true);
                                    const newNoBtn = noBtn.cloneNode(true);
                                    // Ganti dengan yang baru
                                    yesBtn.parentNode.replaceChild(newYesBtn, yesBtn);
                                    noBtn.parentNode.replaceChild(newNoBtn, noBtn);
                                    // Tambahkan event listener baru
                                    newYesBtn.addEventListener('click', handleDeleteConfirm);
                                    newNoBtn.addEventListener('click', handleDeleteCancel);
                                }

                                function handleDeleteConfirm(e) {
                                    e.preventDefault();
                                    closeDeleteModal();
                                    if (deleteCallback) {
                                        deleteCallback(currentItemToDelete);
                                    } else {
                                        deleteCommission(currentItemToDelete);
                                    }
                                    // Reset
                                    currentItemToDelete = null;
                                    deleteCallback = null;
                                }

                                function handleDeleteCancel(e) {
                                    e.preventDefault();
                                    closeDeleteModal();
                                    // Reset
                                    currentItemToDelete = null;
                                    deleteCallback = null;
                                }

                                function closeDeleteModal() {
                                    const modal = document.getElementById('deleteConfirmModal');
                                    modal.style.display = 'none';
                                }

                async function deleteCommission(id) {
                    try {
                        const response = await fetch(`/api/commissions/${id}`, {
                            method: 'DELETE'
                        });
                        const result = await response.json();
                        if (result.success) {
                            showDeleteSuccessModal('Aturan komisi berhasil dihapus');
                            // Data akan direfresh setelah modal sukses ditutup
                            window._commissionNeedReload = true;
                        } else {
                            showError(result.message || 'Gagal menghapus aturan komisi');
                        }
                    } catch (err) {
                        console.error('Error:', err);
                        showError('Terjadi kesalahan');
                    }
                }

                // Show success message
                function showSuccess(message) {
                    const alert = document.getElementById('alertSuccess');
                    document.getElementById('successMessage').textContent = message;
                    alert.classList.remove('hidden');

                    setTimeout(() => {
                        alert.classList.add('hidden');
                    }, 4000);
                }

                // Show error message
                function showError(message) {
                    const alert = document.getElementById('alertError');
                    document.getElementById('errorMessage').textContent = message;
                    alert.classList.remove('hidden');

                    setTimeout(() => {
                        alert.classList.add('hidden');
                    }, 4000);
                }

                // Close modal on background click
                document.getElementById('commissionModal').addEventListener('click', (e) => {
                    if (e.target.id === 'commissionModal') closeModal();
                });
            </script>

            <!-- Modal Konfirmasi Hapus -->
            <div id="deleteConfirmModal" style="display:none;" class="fixed inset-0 flex items-center justify-center z-50 p-4">
              <div class="bg-white rounded-2xl shadow-2xl p-8 flex flex-col items-center text-center max-w-md w-full animate-fadeIn">
                <div class="mb-4">
                  <span class="notification-icon error" style="display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;border-radius:50%;box-shadow:0 4px 24px 0 rgba(239,68,68,0.15);background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);margin-bottom:1rem;">
                    <i class="fas fa-exclamation-triangle" style="font-size:1.5rem;color:white;"></i>
                  </span>
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-2">Konfirmasi Hapus</h2>
                <p class="text-gray-600 mb-4" id="deleteConfirmMessage">Apakah Anda yakin ingin menghapus aturan komisi ini?</p>
                <p class="text-xs text-gray-400 mb-6">Aksi ini tidak dapat dibatalkan.</p>
                <div class="flex gap-4 w-full">
                  <button id="deleteModalYes" type="button" class="w-full bg-gradient-to-r from-red-600 to-red-500 text-white py-3.5 px-6 rounded-xl font-medium hover:from-red-700 hover:to-red-600 transition-all duration-200">Ya, Hapus</button>
                  <button id="deleteModalNo" type="button" class="w-full bg-gray-200 text-gray-700 py-3.5 px-6 rounded-xl font-medium hover:bg-gray-300 transition-all duration-200">Batal</button>
                </div>
              </div>
            </div>

            <!-- Modal Sukses Hapus -->
            <div id="successDeleteModal" style="display:none;"
                class="fixed inset-0 flex items-center justify-center z-50 p-4">
                <div
                    class="bg-white rounded-2xl shadow-2xl p-8 flex flex-col items-center text-center max-w-md w-full animate-fadeIn">
                    <div class="mb-4">
                        <span class="success-checkmark-bg">
                            <svg class="success-checkmark-svg" width="48" height="48" viewBox="0 0 48 48">
                                <circle cx="24" cy="24" r="22" fill="none" stroke="#10b981" stroke-width="4"
                                    opacity="0.15" />
                                <path class="success-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff"
                                    stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </div>
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Sukses</h2>
                    <p class="text-gray-600 mb-6" id="successDeleteMsg">Aturan komisi berhasil dihapus</p>
                    <button id="closeDeleteSuccessModalBtn" type="button"
                        class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-green-700 hover:to-emerald-700 transition-all duration-200">Tutup</button>
                </div>
                <style>
                    @keyframes fadeIn {
                        from {
                            opacity: 0;
                            transform: scale(0.95);
                        }

                        to {
                            opacity: 1;
                            transform: scale(1);
                        }
                    }

                    .animate-fadeIn {
                        animation: fadeIn 0.2s ease;
                    }

                    .success-checkmark-bg {
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        width: 64px;
                        height: 64px;
                        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                        border-radius: 50%;
                        box-shadow: 0 4px 24px 0 rgba(16, 185, 129, 0.15);
                        position: relative;
                        overflow: hidden;
                    }

                    .success-checkmark-svg {
                        display: block;
                    }

                    .success-checkmark-path {
                        stroke-dasharray: 40;
                        stroke-dashoffset: 40;
                        animation: checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards;
                    }

                    @keyframes checkmark-draw {
                        to {
                            stroke-dashoffset: 0;
                        }
                    }
                </style>
            </div>
            <script>
                // Show modal sukses hapus
                function showDeleteSuccessModal(message) {
                    document.getElementById('successDeleteMsg').textContent = message || 'Aturan komisi berhasil dihapus';
                    document.getElementById('successDeleteModal').style.display = 'flex';
                }
                // Pastikan button Tutup pada modal sukses hapus hanya menutup modal dan reload data jika perlu
                document.addEventListener('DOMContentLoaded', function () {
                    var closeDeleteBtn = document.getElementById('closeDeleteSuccessModalBtn');
                    if (closeDeleteBtn) {
                        closeDeleteBtn.addEventListener('click', function (e) {
                            e.preventDefault();
                            document.getElementById('successDeleteModal').style.display = 'none';
                            if (window._commissionNeedReload) {
                                loadCommissions();
                                loadStats && loadStats();
                                window._commissionNeedReload = false;
                            }
                        });
                    }
                });
            </script>
</body>

<!-- Modal Sukses Tambah/Edit -->
<div id="successAddEditModal" class="modal-success">
    <div class="modal-box">
        <span class="success-checkmark-bg">
            <svg class="success-checkmark-svg" width="48" height="48" viewBox="0 0 48 48">
                <circle cx="24" cy="24" r="22" fill="none" stroke="#10b981" stroke-width="4" opacity="0.15" />
                <path class="success-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </span>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Sukses</h2>
        <p class="text-gray-600 mb-6" id="successAddEditMsg">Aturan komisi berhasil ditambahkan</p>
        <button id="closeAddEditModalBtn" type="button"
            class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-green-700 hover:to-emerald-700 transition-all duration-200">Tutup</button>
    </div>
</div>

<script>
    // Show modal sukses tambah/edit
    function showAddEditSuccessModal(message) {
        document.getElementById('successAddEditMsg').textContent = message || 'Aturan komisi berhasil ditambahkan';
        document.getElementById('successAddEditModal').style.display = 'flex';
    }

    // Pastikan button Tutup hanya menutup modal, tidak trigger submit
    document.addEventListener('DOMContentLoaded', function () {
        var closeBtn = document.getElementById('closeAddEditModalBtn');
        if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
                e.preventDefault();
                document.getElementById('successAddEditModal').style.display = 'none';
            });
        }
    });
</script>

</html>