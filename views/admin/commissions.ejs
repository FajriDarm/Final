                        <!-- Aturan Tipe Flat -->
                        <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium mb-1">Tipe Flat</p>
                                    <p class="text-3xl font-bold text-gray-900 mb-2" id="flatRules">-</p>
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">
                                            <i class="fas fa-coins mr-1"></i>Jumlah Tetap
