<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Commission Management - Affillink Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .gradient-primary {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }

        .gradient-secondary {
            background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
        }

        .gradient-accent {
            background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
        }

        .gradient-dark {
            background: linear-gradient(135deg, #065f46 0%, #047857 100%);
        }

        .card-hover {
            transition: all 0.3s ease;
        }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
        }

        .status-badge {
            transition: all 0.2s ease;
        }

        .status-badge:hover {
            transform: scale(1.05);
        }

        .pulse-animation {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal-content {
            background: white;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .data-cell {
            position: relative;
            overflow: hidden;
        }

        .data-cell::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
        }
    </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50">
    <!-- Navbar -->
    <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>

        <!-- Sidebar -->
        <%- include('../sidebar/admin.ejs') %>

            <!-- Main Content -->
            <main class="ml-64 pt-16 min-h-screen">
                <div class="p-6">
                    <!-- Page Header -->
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
                        <div class="mb-4 md:mb-0">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                                    <i class="fas fa-percentage text-white text-xl"></i>
                                </div>
                                <div>
                                    <h1 class="text-3xl font-bold text-gray-900">Commission Management</h1>
                                    <p class="text-gray-600 mt-1">Manage affiliate commission rules and rates</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <div
                                class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-calendar-alt text-green-600"></i>
                                    <span class="text-sm font-medium text-gray-700">
                                        <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' ,
                                            month: 'long' , day: 'numeric' }) %>
                                    </span>
                                </div>
                            </div>
                            <button onclick="openAddModal()"
                                class="gradient-primary text-white rounded-xl px-6 py-3 font-semibold shadow-lg hover:shadow-xl transition-all duration-300 flex items-center gap-2 card-hover">
                                <i class="fas fa-plus"></i> Add Commission Rule
                            </button>
                        </div>
                    </div>

                    <!-- Stats Cards - 4 KOLOM: Total Rules, Active Rules, Percentage Type, Flat Type -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                        <!-- Total Rules -->
                        <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium mb-1">Total Rules</p>
                                    <p class="text-3xl font-bold text-gray-900 mb-2" id="totalRules">-</p>
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                                            <i class="fas fa-chart-line mr-1"></i>All Rules
                                        </span>
                                        <span class="text-xs text-gray-500">commission rules</span>
                                    </div>
                                </div>
                                <div
                                    class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                                    <i class="fas fa-list-check text-white text-2xl"></i>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-green-50">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-600">Global Rules</span>
                                    <span class="font-medium text-green-700" id="globalRules">-</span>
                                </div>
                            </div>
                        </div>

                        <!-- Active Rules -->
                        <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium mb-1">Active Rules</p>
                                    <p class="text-3xl font-bold text-gray-900 mb-2" id="activeRules">-</p>
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-medium">
                                            <i class="fas fa-check-circle mr-1"></i>Running
                                        </span>
                                        <span class="text-xs text-gray-500">currently active</span>
                                    </div>
                                </div>
                                <div
                                    class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                                    <i class="fas fa-bolt text-white text-2xl"></i>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-green-50">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-600">Inactive</span>
                                    <span class="font-medium text-red-600" id="inactiveRules">-</span>
                                </div>
                            </div>
                        </div>

                        <!-- Percentage Type Rules -->
                        <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium mb-1">Percentage Type</p>
                                    <p class="text-3xl font-bold text-gray-900 mb-2" id="percentageRules">-</p>
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="px-2 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-medium">
                                            <i class="fas fa-percentage mr-1"></i>Percentage
                                        </span>
                                        <span class="text-xs text-gray-500">of transaction</span>
                                    </div>
                                </div>
                                <div
                                    class="w-14 h-14 gradient-accent rounded-xl flex items-center justify-center shadow-lg">
                                    <i class="fas fa-chart-pie text-white text-2xl"></i>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-green-50">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-600">Avg. Rate</span>
                                    <span class="font-medium text-purple-600" id="avgPercentage">-</span>
                                </div>
                            </div>
                        </div>

                        <!-- Flat Type Rules -->
                        <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-gray-600 text-sm font-medium mb-1">Flat Type</p>
                                    <p class="text-3xl font-bold text-gray-900 mb-2" id="flatRules">-</p>
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">
                                            <i class="fas fa-coins mr-1"></i>Fixed Amount
                                        </span>
                                        <span class="text-xs text-gray-500">per transaction</span>
                                    </div>
                                </div>
                                <div
                                    class="w-14 h-14 gradient-dark rounded-xl flex items-center justify-center shadow-lg">
                                    <i class="fas fa-money-bill-wave text-white text-2xl"></i>
                                </div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-green-50">
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-gray-600">Avg. Amount</span>
                                    <span class="font-medium text-blue-600" id="avgFlat">-</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alert Messages -->
                    <div id="alertSuccess" class="hidden mb-6">
                        <div class="bg-green-50 border border-green-200 rounded-xl p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-check-circle text-green-600"></i>
                                </div>
                                <div>
                                    <p class="text-green-700 font-medium" id="successMessage"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="alertError" class="hidden mb-6">
                        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-exclamation-triangle text-red-600"></i>
                                </div>
                                <div>
                                    <p class="text-red-700 font-medium" id="errorMessage"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Commission Rules Table -->
                    <div class="glass-card rounded-2xl shadow-lg border border-green-100 overflow-hidden mb-8">
                        <div class="px-6 py-4 gradient-primary">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h2 class="text-lg font-semibold text-white">Commission Rules</h2>
                                    <p class="text-green-100 text-sm mt-1">Manage all commission configurations</p>
                                </div>
                                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-percentage text-white"></i>
                                </div>
                            </div>
                        </div>
                        <div class="p-6">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead>
                                        <tr class="bg-green-50">
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">ID</th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Event
                                            </th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Type
                                            </th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Value
                                            </th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Min
                                                Stage</th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Status
                                            </th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Created
                                                By</th>
                                            <th class="py-4 px-6 text-left text-sm font-semibold text-green-900">Actions
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="commissionTableBody" class="divide-y divide-green-100">
                                        <tr>
                                            <td colspan="8" class="py-12 px-6 text-center">
                                                <div class="flex flex-col items-center justify-center">
                                                    <div
                                                        class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                                                        <i class="fas fa-spinner fa-spin text-green-600 text-xl"></i>
                                                    </div>
                                                    <p class="text-gray-600 font-medium">Memuat commission rules...</p>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Info Box -->
                    <div class="glass-card rounded-2xl p-6 border border-green-100 mb-6">
                        <div class="flex items-start gap-4">
                            <div
                                class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-info-circle text-green-600 text-xl"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 mb-2">Commission Guidelines</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-600">
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-globe text-green-500 mt-1"></i>
                                        <div>
                                            <strong>Global Commission:</strong> Applied to all events when no specific
                                            event is selected
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-calendar-alt text-green-500 mt-1"></i>
                                        <div>
                                            <strong>Event-Specific:</strong> Applied only to transactions from the
                                            selected event
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-sitemap text-green-500 mt-1"></i>
                                        <div>
                                            <strong>Stage Requirement:</strong> Minimum transaction stage needed for
                                            commission eligibility
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-2">
                                        <i class="fas fa-exclamation-triangle text-green-500 mt-1"></i>
                                        <div>
                                            <strong>Priority:</strong> Event-specific rules override global rules for
                                            the same event
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>

            <!-- Add/Edit Modal -->
            <div id="commissionModal" class="modal-overlay">
                <div class="modal-content">
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 gradient-primary rounded-lg flex items-center justify-center">
                                    <i class="fas fa-percentage text-white"></i>
                                </div>
                                <div>
                                    <h2 class="text-xl font-bold text-gray-900" id="modalTitle">Add Commission Rule</h2>
                                    <p class="text-gray-500 text-sm">Configure commission settings</p>
                                </div>
                            </div>
                            <button onclick="closeModal()"
                                class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
                        </div>

                        <form id="commissionForm" onsubmit="submitForm(event)">
                            <div class="space-y-4">
                                <div class="form-group">
                                    <label for="eventSelect" class="block text-sm font-medium text-gray-700 mb-2">
                                        <i class="fas fa-calendar-alt mr-2 text-green-600"></i>
                                        Event Selection
                                        <span class="text-gray-500 text-xs">(Leave empty for Global Commission)</span>
                                    </label>
                                    <select id="eventSelect" name="event_id"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                        <option value="">🌍 Global Commission (All Events)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="commissionType" class="block text-sm font-medium text-gray-700 mb-2">
                                        <i class="fas fa-tag mr-2 text-green-600"></i>
                                        Commission Type *
                                    </label>
                                    <select id="commissionType" name="commission_type" required onchange="handleCommissionTypeChange()"
                                        class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                        <option value="">Select Type</option>
                                        <option value="flat">Flat (IDR) - Fixed amount per transaction</option>
                                        <option value="percentage">Percentage (%) - Percentage of transaction amount
                                        </option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="commissionValue" class="block text-sm font-medium text-gray-700 mb-2">
                                        <i class="fas fa-dollar-sign mr-2 text-green-600"></i>
                                        <span id="valueLabel">Commission Value</span> *
                                    </label>
                                    <div class="relative">
                                        <span id="currencyPrefix" class="absolute left-4 top-3 text-gray-500 text-sm font-medium hidden">Rp</span>
                                        <input type="text" id="commissionValue" name="commission_value"
                                            placeholder="Enter value" required
                                            oninput="handleCommissionValueInput(event)"
                                            class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                    </div>
                                    <p id="valueHelp" class="text-xs text-gray-500 mt-1">Enter numeric value</p>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="form-group">
                                        <label for="minStage" class="block text-sm font-medium text-gray-700 mb-2">
                                            <i class="fas fa-sitemap mr-2 text-green-600"></i>
                                            Minimum Stage
                                        </label>
                                        <select id="minStage" name="min_stage"
                                            class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                            <option value="1">Stage 1 (Sales Chat)</option>
                                            <option value="2">Stage 2 (Payment Verification)</option>
                                            <option value="3" selected>Stage 3 (Delivery Confirmation)</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label for="isActive" class="block text-sm font-medium text-gray-700 mb-2">
                                            <i class="fas fa-toggle-on mr-2 text-green-600"></i>
                                            Status
                                        </label>
                                        <select id="isActive" name="is_active"
                                            class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:border-green-500 focus:ring-2 focus:ring-green-200 focus:outline-none transition-all">
                                            <option value="1">Active</option>
                                            <option value="0">Inactive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="flex gap-3 mt-8 pt-6 border-t border-gray-100">
                                <button type="submit"
                                    class="gradient-primary text-white rounded-xl px-6 py-3 font-semibold shadow-lg hover:shadow-xl transition-all duration-300 flex-1 flex items-center justify-center gap-2">
                                    <i class="fas fa-save"></i> Save Commission
                                </button>
                                <button type="button" onclick="closeModal()"
                                    class="bg-gray-100 text-gray-700 rounded-xl px-6 py-3 font-semibold hover:bg-gray-200 transition-all duration-300 flex-1 flex items-center justify-center gap-2">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                            </div>
                    </div>
                </div>
            </div>

            <script>
                let currentEditId = null;
                let commissionData = [];

                // ============================================================
                // FUNGSI FORMATTING & INPUT HANDLING
                // ============================================================

                /**
                 * Format number dengan separasi ribuan (Rupiah)
                 * @param {string|number} value - nilai yang akan diformat
                 * @returns {string} - nilai dengan format Rupiah tanpa "Rp"
                 */
                function formatNumberRupiah(value) {
                    if (!value) return '';
                    // Hapus semua karakter non-angka
                    const cleanValue = value.toString().replace(/\D/g, '');
                    if (cleanValue === '') return '';
                    // Format dengan separasi ribuan
                    return parseInt(cleanValue).toLocaleString('id-ID');
                }

                /**
                 * Hapus format Rupiah dan kembalikan ke angka bersih
                 * @param {string} value - nilai dengan format Rupiah
                 * @returns {string} - angka bersih tanpa pemisah
                 */
                function cleanRupiahValue(value) {
                    if (!value) return '0';
                    return value.toString().replace(/\D/g, '') || '0';
                }

                /**
                 * Handle perubahan tipe komisi
                 * Tampilkan/sembunyikan format Rupiah berdasarkan tipe yang dipilih
                 */
                function handleCommissionTypeChange() {
                    const type = document.getElementById('commissionType').value;
                    const valueInput = document.getElementById('commissionValue');
                    const valueLabel = document.getElementById('valueLabel');
                    const currencyPrefix = document.getElementById('currencyPrefix');
                    const valueHelp = document.getElementById('valueHelp');

                    if (type === 'flat') {
                        // Tipe FLAT: Aktifkan format Rupiah
                        valueLabel.textContent = 'Commission Value (IDR)';
                        currencyPrefix.classList.remove('hidden');
                        valueInput.classList.add('pl-10');
                        valueHelp.textContent = 'Contoh: 1.000.000';
                        valueInput.placeholder = '0';

                        // Jika ada nilai sebelumnya, format sebagai Rupiah
                        if (valueInput.value) {
                            valueInput.value = formatNumberRupiah(valueInput.value);
                        }
                    } else if (type === 'percentage') {
                        // Tipe PERCENTAGE: Non-format
                        valueLabel.textContent = 'Commission Value (%)';
                        currencyPrefix.classList.add('hidden');
                        valueInput.classList.remove('pl-10');
                        valueHelp.textContent = 'Contoh: 5 untuk 5%';
                        valueInput.placeholder = '0';

                        // Hapus format Rupiah jika ada
                        if (valueInput.value) {
                            valueInput.value = cleanRupiahValue(valueInput.value);
                        }
                    } else {
                        // Default: tidak ada format
                        valueLabel.textContent = 'Commission Value';
                        currencyPrefix.classList.add('hidden');
                        valueInput.classList.remove('pl-10');
                        valueHelp.textContent = 'Enter numeric value';
                        valueInput.placeholder = 'Enter value';
                    }

                    // Clear input jika tipe belum dipilih
                    if (type === '') {
                        valueInput.value = '';
                    }
                }

                /**
                 * Handle input value dengan auto-format berdasarkan tipe komisi
                 */
                function handleCommissionValueInput(event) {
                    const type = document.getElementById('commissionType').value;
                    const input = event.target;
                    let value = input.value;

                    if (type === 'flat') {
                        // Format sebagai Rupiah dengan separator ribuan
                        const formatted = formatNumberRupiah(value);
                        input.value = formatted;
                    } else if (type === 'percentage') {
                        // Hanya izinkan angka dan satu titik desimal
                        const cleanValue = value.replace(/[^\d.]/g, '');
                        const parts = cleanValue.split('.');
                        if (parts.length > 2) {
                            // Jika lebih dari satu titik, ambil hanya bagian pertama
                            input.value = parts[0] + '.' + parts[1];
                        } else {
                            input.value = cleanValue;
                        }
                    }
                }

                /**
                 * Bersihkan nilai komisi sebelum submit
                 */
                function cleanCommissionValueBeforeSubmit() {
                    const type = document.getElementById('commissionType').value;
                    const valueInput = document.getElementById('commissionValue');
                    let cleanValue = valueInput.value;

                    if (type === 'flat') {
                        // Hapus separator untuk tipe FLAT, kembalikan sebagai integer
                        cleanValue = cleanRupiahValue(cleanValue);
                    } else if (type === 'percentage') {
                        // Ubah ke float untuk percentage
                        cleanValue = parseFloat(cleanValue) || 0;
                    }

                    return cleanValue;
                }

                // ============================================================
                // LOAD DATA ON PAGE LOAD
                // ============================================================

                // Load data on page load
                document.addEventListener('DOMContentLoaded', () => {
                    loadCommissions();
                    loadEvents();
                    loadStats();
                });

                // Load all commission rules
                async function loadCommissions() {
                    try {
                        const response = await fetch('/api/commissions');
                        const data = await response.json();

                        if (data.success) {
                            commissionData = data.commissions || [];
                            renderTable();
                        } else {
                            showError(data.message || 'Failed to load commission rules');
                        }
                    } catch (err) {
                        console.error('Error loading commissions:', err);
                        showError('Failed to load commission rules: ' + err.message);
                    }
                }

                // Load events for dropdown
                async function loadEvents() {
                    try {
                        const response = await fetch('/api/commissions/events/list');
                        const data = await response.json();

                        if (data.success) {
                            const select = document.getElementById('eventSelect');
                            data.data.forEach(event => {
                                const option = document.createElement('option');
                                option.value = event.id;
                                option.textContent = event.title;
                                select.appendChild(option);
                            });
                        }
                    } catch (err) {
                        console.error('Error loading events:', err);
                    }
                }

                // Fungsi untuk menghitung average values
                function calculateAverages() {
                    const percentageRules = commissionData.filter(c =>
                        c.commission_type === 'percentage' && c.is_active
                    );

                    const flatRules = commissionData.filter(c =>
                        c.commission_type === 'flat' && c.is_active
                    );

                    // Calculate average percentage
                    let avgPercentage = '-';
                    if (percentageRules.length > 0) {
                        const totalPercent = percentageRules.reduce((sum, c) =>
                            sum + parseFloat(c.commission_value), 0
                        );
                        avgPercentage = (totalPercent / percentageRules.length).toFixed(1) + '%';
                    }

                    // Calculate average flat amount
                    let avgFlat = '-';
                    if (flatRules.length > 0) {
                        const totalFlat = flatRules.reduce((sum, c) =>
                            sum + parseFloat(c.commission_value), 0
                        );
                        avgFlat = 'Rp ' + Math.round(totalFlat / flatRules.length).toLocaleString('id-ID');
                    }

                    return { avgPercentage, avgFlat };
                }

                // Load statistics
                async function loadStats() {
                    try {
                        const response = await fetch('/api/commissions/stats');
                        const data = await response.json();

                        if (data.success) {
                            const stats = data.data;

                            // Animate values
                            animateValue('totalRules', 0, stats.total_rules || 0, 1000);
                            animateValue('activeRules', 0, stats.active_rules || 0, 1000);
                            animateValue('flatRules', 0, stats.flat_rules || 0, 1000);
                            animateValue('percentageRules', 0, stats.percentage_rules || 0, 1000);

                            // Calculate and show additional stats
                            const inactiveRules = (stats.total_rules || 0) - (stats.active_rules || 0);
                            const globalRules = commissionData.filter(c => !c.event_id).length;
                            const averages = calculateAverages();

                            document.getElementById('inactiveRules').textContent = inactiveRules;
                            document.getElementById('globalRules').textContent = globalRules;
                            document.getElementById('avgPercentage').textContent = averages.avgPercentage;
                            document.getElementById('avgFlat').textContent = averages.avgFlat;
                        }
                    } catch (err) {
                        console.error('Error loading stats:', err);
                    }
                }

                function animateValue(id, start, end, duration) {
                    const obj = document.getElementById(id);
                    let startTimestamp = null;

                    const step = (timestamp) => {
                        if (!startTimestamp) startTimestamp = timestamp;
                        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                        const value = Math.floor(progress * (end - start) + start);

                        obj.textContent = value;

                        if (progress < 1) {
                            window.requestAnimationFrame(step);
                        }
                    };

                    window.requestAnimationFrame(step);
                }

                // Render commission table
                function renderTable() {
                    const tbody = document.getElementById('commissionTableBody');

                    if (commissionData.length === 0) {
                        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="py-12 px-6 text-center">
              <div class="flex flex-col items-center justify-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                  <i class="fas fa-inbox text-green-600 text-xl"></i>
                </div>
                <p class="text-gray-600 font-medium">Belum ada commission rules</p>
                <p class="text-sm text-gray-500 mt-2">Commission rules akan muncul di sini</p>
              </div>
            </td>
          </tr>
        `;
                        return;
                    }

                    tbody.innerHTML = commissionData.map((commission, index) => {
                        const isGlobal = !commission.event_id;
                        const typeClass = commission.commission_type === 'flat'
                            ? 'bg-blue-100 text-blue-800 border-blue-200'
                            : 'bg-purple-100 text-purple-800 border-purple-200';

                        const statusClass = commission.is_active
                            ? 'bg-green-100 text-green-800 border-green-200'
                            : 'bg-red-100 text-red-800 border-red-200';

                        const valueDisplay = commission.commission_type === 'flat'
                            ? 'Rp ' + parseInt(commission.commission_value).toLocaleString('id-ID')
                            : commission.commission_value + '%';

                        return `
          <tr class="hover:bg-green-50 transition-colors data-cell" style="animation-delay: ${index * 50}ms">
            <td class="py-4 px-6">
              <div class="font-mono text-sm font-bold text-gray-900">#${commission.id}</div>
            </td>
            <td class="py-4 px-6">
              ${isGlobal ?
                                `<div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-globe text-green-600"></i>
                  </div>
                  <span class="font-medium text-gray-900">Global Commission</span>
                </div>` :
                                `<div class="flex items-center gap-2">
                  <div class="w-8 h-8 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-calendar-alt text-blue-600"></i>
                  </div>
                  <div>
                    <div class="font-medium text-gray-900">${commission.event_title || 'Unknown'}</div>
                    <div class="text-xs text-gray-500">Event-specific</div>
                  </div>
                </div>`}
            </td>
            <td class="py-4 px-6">
              <span class="px-3 py-1.5 rounded-full text-xs font-medium border ${typeClass} status-badge">
                <i class="fas ${commission.commission_type === 'flat' ? 'fa-coins' : 'fa-percentage'} text-xs mr-1.5"></i>
                ${commission.commission_type.toUpperCase()}
              </span>
            </td>
            <td class="py-4 px-6">
              <div class="font-bold ${commission.commission_type === 'flat' ? 'text-blue-700' : 'text-purple-700'}">
                ${valueDisplay}
              </div>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                  <span class="font-bold text-gray-700">${commission.min_stage}</span>
                </div>
                <span class="text-sm text-gray-600">Stage ${commission.min_stage}</span>
              </div>
            </td>
            <td class="py-4 px-6">
              <span class="px-3 py-1.5 rounded-full text-xs font-medium border ${statusClass} status-badge">
                <i class="fas fa-circle text-xs mr-1.5"></i>
                ${commission.is_active ? 'ACTIVE' : 'INACTIVE'}
              </span>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-gradient-to-br from-amber-100 to-orange-100 rounded-lg flex items-center justify-center">
                  <i class="fas fa-user text-amber-600"></i>
                </div>
                <span class="text-sm font-medium text-gray-900">${commission.created_by_name || 'System'}</span>
              </div>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center gap-2">
                <button onclick="editCommission(${commission.id})" 
                  class="px-4 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-all duration-200 flex items-center gap-2">
                  <i class="fas fa-edit"></i>
                  Edit
                </button>
                <button onclick="deleteCommission(${commission.id})" 
                  class="px-4 py-2 bg-red-50 text-red-700 rounded-lg hover:bg-red-100 transition-all duration-200 flex items-center gap-2">
                  <i class="fas fa-trash"></i>
                  Delete
                </button>
              </div>
            </td>
          </tr>
        `;
                    }).join('');
                }

                // Open add modal
                function openAddModal() {
                    currentEditId = null;
                    document.getElementById('modalTitle').textContent = 'Add Commission Rule';
                    document.getElementById('commissionForm').reset();
                    // Reset UI ke state default
                    document.getElementById('commissionType').value = '';
                    document.getElementById('commissionValue').value = '';
                    document.getElementById('valueLabel').textContent = 'Commission Value';
                    document.getElementById('currencyPrefix').classList.add('hidden');
                    document.getElementById('commissionValue').classList.remove('pl-10');
                    document.getElementById('valueHelp').textContent = 'Enter numeric value';
                    document.getElementById('commissionModal').classList.add('show');
                }

                // Open edit modal
                function editCommission(id) {
                    const commission = commissionData.find(c => c.id === id);
                    if (!commission) return;

                    currentEditId = id;
                    document.getElementById('modalTitle').textContent = 'Edit Commission Rule';
                    document.getElementById('eventSelect').value = commission.event_id || '';
                    document.getElementById('commissionType').value = commission.commission_type;
                    
                    // Format nilai berdasarkan tipe komisi
                    if (commission.commission_type === 'flat') {
                        document.getElementById('commissionValue').value = formatNumberRupiah(commission.commission_value);
                    } else {
                        document.getElementById('commissionValue').value = commission.commission_value;
                    }
                    
                    // Trigger change event untuk update UI label dan placeholder
                    document.getElementById('commissionType').dispatchEvent(new Event('change'));
                    
                    document.getElementById('minStage').value = commission.min_stage;
                    document.getElementById('isActive').value = commission.is_active ? '1' : '0';

                    document.getElementById('commissionModal').classList.add('show');
                }

                // Close modal
                function closeModal() {
                    document.getElementById('commissionModal').classList.remove('show');
                    currentEditId = null;
                }

                // Submit form
                async function submitForm(event) {
                    event.preventDefault();

                    const formData = new FormData(document.getElementById('commissionForm'));
                    const rawCommissionValue = cleanCommissionValueBeforeSubmit();

                    const data = {
                        event_id: formData.get('event_id') || null,
                        commission_type: formData.get('commission_type'),
                        commission_value: formData.get('commission_type') === 'flat' 
                            ? parseInt(rawCommissionValue) 
                            : parseFloat(rawCommissionValue),
                        min_stage: parseInt(formData.get('min_stage')),
                        is_active: parseInt(formData.get('is_active'))
                    };

                    const url = currentEditId ? `/api/commissions/${currentEditId}` : '/api/commissions';
                    const method = currentEditId ? 'PUT' : 'POST';

                    try {
                        const response = await fetch(url, {
                            method: method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();

                        if (result.success) {
                            showSuccess(result.message);
                            closeModal();
                            await loadCommissions();
                            await loadStats();
                        } else {
                            showError(result.message || 'Operation failed');
                        }
                    } catch (err) {
                        console.error('Error:', err);
                        showError('An error occurred');
                    }
                }

                // Delete commission
                async function deleteCommission(id) {
                    if (!confirm('Are you sure you want to delete this commission rule?')) return;

                    try {
                        const response = await fetch(`/api/commissions/${id}`, {
                            method: 'DELETE'
                        });

                        const result = await response.json();

                        if (result.success) {
                            showSuccess('Commission rule deleted successfully');
                            await loadCommissions();
                            await loadStats();
                        } else {
                            showError(result.message || 'Failed to delete commission rule');
                        }
                    } catch (err) {
                        console.error('Error:', err);
                        showError('An error occurred');
                    }
                }

                // Show success message
                function showSuccess(message) {
                    const alert = document.getElementById('alertSuccess');
                    document.getElementById('successMessage').textContent = message;
                    alert.classList.remove('hidden');

                    setTimeout(() => {
                        alert.classList.add('hidden');
                    }, 4000);
                }

                // Show error message
                function showError(message) {
                    const alert = document.getElementById('alertError');
                    document.getElementById('errorMessage').textContent = message;
                    alert.classList.remove('hidden');

                    setTimeout(() => {
                        alert.classList.add('hidden');
                    }, 4000);
                }

                // Close modal on background click
                document.getElementById('commissionModal').addEventListener('click', (e) => {
                    if (e.target.id === 'commissionModal') closeModal();
                });
            </script>
</body>

</html>