                                </div>
                                <div>
                                    <h1 class="text-3xl font-bold text-gray-900">Manajemen Komisi</h1>
                                    <p class="text-gray-600 mt-1">Kelola aturan dan tarif komisi afiliasi</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
