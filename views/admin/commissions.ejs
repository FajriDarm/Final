                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900 mb-2">Panduan Komisi</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-600">
                                    <div class="flex items-start gap-2">
