                    <h5 class="text-sm font-extrabold text-green-900">Informasi Harga</h5>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-[10px] font-extrabold text-emerald-800 mb-1">Harga Asli (Rp)</label>
                      <div class="relative">
                        <span
                          class="absolute left-2 top-1/2 transform -translate-y-1/2 font-extrabold text-gray-500 text-[9px]">Rp</span>
                        <input type="number" id="price_original"
                          class="w-full pl-7 pr-2 py-2 bg-white/60 backdrop-blur border border-white/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-xs font-medium"
                          placeholder="0">
                      </div>
                    </div>
                    <div>
                      <label class="block text-[10px] font-extrabold text-emerald-800 mb-1">Harga Promo (Rp)</label>
                      <div class="relative">
                        <span
                          class="absolute left-2 top-1/2 transform -translate-y-1/2 font-extrabold text-emerald-600 text-[9px]">Rp</span>
                        <input type="number" id="price_promo"
                          class="w-full pl-7 pr-2 py-2 bg-white/60 backdrop-blur border border-white/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-xs font-medium"
                          placeholder="0">
                      </div>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Active Period (independent from variant/package period) -->
              <div class="bg-gradient-to-r from-blue-50/80 to-cyan-50/80 backdrop-blur p-4 rounded-xl border border-blue-200/50">
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-7 h-7 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-calendar-check text-blue-600 text-xs"></i>
                  </div>
                  <div>
                    <h5 class="text-sm font-extrabold text-blue-900">Masa Aktif Event</h5>
                    <p class="text-[9px] font-medium text-blue-700">Periode ini menentukan kapan event ditampilkan sebagai aktif</p>
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-[10px] font-extrabold text-blue-800 mb-1">Aktif Mulai</label>
                    <input type="date" id="active_start_date"
                      class="w-full px-3 py-2 bg-white/70 backdrop-blur border border-white/60 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent text-gray-900 text-xs font-medium">
                  </div>
                  <div>
                    <label class="block text-[10px] font-extrabold text-blue-800 mb-1">Aktif Berakhir</label>
                    <input type="date" id="active_end_date"
                      class="w-full px-3 py-2 bg-white/70 backdrop-blur border border-white/60 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent text-gray-900 text-xs font-medium">
                  </div>
                </div>
              </div>

              <!-- Admin WhatsApp -->
              <div class="bg-gradient-to-r from-cyan-50/80 to-sky-50/80 backdrop-blur p-4 rounded-xl border border-cyan-200/50">
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-7 h-7 bg-cyan-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-calendar-day text-cyan-600 text-xs"></i>
                  </div>
                  <div>
                    <h5 class="text-sm font-extrabold text-cyan-900">Periode Event Utama</h5>
                    <p class="text-[9px] font-medium text-cyan-700">Bisa lebih dari satu, menyesuaikan jumlah paket/varian</p>
                  </div>
                </div>
                <div id="periodsList" class="space-y-2"></div>
                <p class="text-[10px] font-semibold text-cyan-700">Periode mengikuti jumlah varian secara otomatis</p>
              </div>

              <div
                class="bg-gradient-to-r from-green-50/80 to-emerald-50/80 backdrop-blur p-4 rounded-xl border border-green-200/50">
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-7 h-7 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="fab fa-whatsapp text-green-600 text-xs"></i>
                  </div>
                  <div>
                    <h5 class="text-sm font-extrabold text-green-900">Admin WhatsApp</h5>
                    <p class="text-[9px] font-medium text-green-700">Untuk konfirmasi pembayaran</p>
                  </div>
                </div>
                <div class="relative">
                  <span
                    class="absolute left-2 top-1/2 transform -translate-y-1/2 font-extrabold text-emerald-600 text-[9px]">+62</span>
                  <input type="text" id="admin_whatsapp" placeholder="812xxxxxxxx"
                    class="w-full pl-8 pr-3 py-2 bg-white/60 backdrop-blur border border-white/50 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-xs font-medium">
                </div>
              </div>

              <!-- Status -->
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <div class="w-7 h-7 bg-gray-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-toggle-on text-gray-600 text-xs"></i>
                  </div>
                  <h5 class="text-sm font-extrabold text-gray-900">Status</h5>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="draft" class="peer sr-only">
                    <div
                      class="p-2.5 border-2 border-white/50 rounded-lg hover:border-amber-400 peer-checked:border-amber-500 peer-checked:bg-amber-50/50 transition-all duration-300 text-center bg-white/40 backdrop-blur">
                      <div class="w-6 h-6 bg-amber-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                        <i class="fas fa-file-alt text-amber-600 text-[10px]"></i>
                      </div>
                      <p class="font-extrabold text-gray-900 text-[10px]">Draft</p>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="active" class="peer sr-only" checked>
                    <div
                      class="p-2.5 border-2 border-white/50 rounded-lg hover:border-emerald-400 peer-checked:border-emerald-500 peer-checked:bg-emerald-50/50 transition-all duration-300 text-center bg-white/40 backdrop-blur">
                      <div class="w-6 h-6 bg-emerald-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                        <i class="fas fa-check-circle text-emerald-600 text-[10px]"></i>
                      </div>
                      <p class="font-extrabold text-gray-900 text-[10px]">Aktif</p>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="inactive" class="peer sr-only">
                    <div
                      class="p-2.5 border-2 border-white/50 rounded-lg hover:border-red-400 peer-checked:border-red-500 peer-checked:bg-red-50/50 transition-all duration-300 text-center bg-white/40 backdrop-blur">
                      <div class="w-6 h-6 bg-red-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                        <i class="fas fa-times-circle text-red-600 text-[10px]"></i>
                      </div>
                      <p class="font-extrabold text-gray-900 text-[10px]">Tidak Aktif</p>
                    </div>
                  </label>
                </div>
              </div>
            </form>
          </div>

          <!-- Modal Footer -->
          <div class="border-t border-white/30 px-5 py-3 bg-white/40 backdrop-blur flex gap-3">
            <button type="button" onclick="closeModal()"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-2.5 rounded-lg transition-all duration-300 text-xs font-extrabold flex items-center justify-center gap-1 border border-white/60">
              <i class="fas fa-times"></i>
              Batal
            </button>
            <button type="submit" form="eventForm"
              class="flex-1 gradient-secondary text-white py-2.5 rounded-lg hover:opacity-90 transition-all duration-300 text-xs font-extrabold shadow-lg flex items-center justify-center gap-1">
              <i class="fas fa-save"></i>
              <span id="submitButtonText">Tambah Event</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Modal Notifikasi Premium -->
      <div id="notificationModal" class="modal-notification">
        <div class="modal-box">
          <span class="notification-icon success" id="notificationIcon">
            <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
              <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
              <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff"
                stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2" id="notificationTitle">Sukses</h2>
          <p class="text-gray-600 mb-4 text-sm font-medium" id="notificationMessage">Operasi berhasil dilakukan</p>
          <button id="closeNotificationModalBtn" type="button"
            class="w-full gradient-primary text-white py-3 px-5 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
            Tutup
          </button>
        </div>
      </div>

      <!-- Modal Konfirmasi Hapus Premium -->
      <div id="deleteConfirmModal" style="display:none;" class="modal-notification">
        <div class="modal-box">
          <span class="notification-icon error">
            <i class="fas fa-exclamation-triangle"></i>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Konfirmasi Hapus</h2>
          <p class="text-gray-600 mb-3 text-sm font-medium" id="deleteConfirmMessage">Apakah Anda yakin ingin menghapus
            event ini?</p>
          <p class="text-[9px] font-medium text-gray-400 mb-4">Aksi ini tidak dapat dibatalkan.</p>
          <div class="flex gap-3">
            <button id="deleteModalNo"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 px-4 rounded-xl text-xs font-extrabold transition-all duration-300 border border-white/60">
              Batal
            </button>
            <button id="deleteModalYes"
              class="flex-1 bg-gradient-to-r from-red-600 to-rose-600 text-white py-3 px-4 rounded-xl text-xs font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
              Ya, Hapus
            </button>
          </div>
        </div>
      </div>

      <script>
        let allEvents = [];
        let currentItemToDelete = null;
        let deleteCallback = null;
        // temporary arrays to hold dynamic inputs when editing/creating
        let currentBenefits = [];
        let currentPains = [];
        let currentProblemSection = { title: '', subtitle: '' };
        let currentFaqs = []; // for dynamic FAQs

        // ============================================================
        // FUNGSI NOTIFIKASI MODAL
        // ============================================================

        function showNotification(type, title, message, autoClose = true) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const titleEl = document.getElementById('notificationTitle');
          const messageEl = document.getElementById('notificationMessage');
          const closeBtn = document.getElementById('closeNotificationModalBtn');

          icon.className = 'notification-icon';

          const configs = {
            success: {
              iconClass: 'success',
              iconHTML: `
                <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
                  <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
                  <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                    stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              `,
              buttonClass: 'gradient-primary'
            },
            error: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-times-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            },
            warning: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-exclamation-triangle"></i>',
              buttonClass: 'bg-gradient-to-r from-amber-500 to-orange-500'
            },
            info: {
              iconClass: 'info',
              iconHTML: '<i class="fas fa-info-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-blue-600 to-indigo-600'
            }
          };

          const config = configs[type] || configs.info;

          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;
          titleEl.textContent = title;
          messageEl.textContent = message;

          closeBtn.className = `w-full ${config.buttonClass} text-white py-3 px-5 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg`;

          if (type === 'success') {
            const checkmarkPath = icon.querySelector('.notification-checkmark-path');
            if (checkmarkPath) {
              checkmarkPath.style.strokeDasharray = '40';
              checkmarkPath.style.strokeDashoffset = '40';
              setTimeout(() => {
                checkmarkPath.style.animation = 'none';
                setTimeout(() => {
                  checkmarkPath.style.animation = 'checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards';
                }, 10);
              }, 10);
            }
          }

          modal.style.display = 'flex';

          if (autoClose) {
            setTimeout(() => {
              closeNotification();
            }, 4000);
          }
        }

        function closeNotification() {
          document.getElementById('notificationModal').style.display = 'none';
        }

        function showSuccess(message) {
          showNotification('success', 'Sukses', message);
        }

        function showError(message) {
          showNotification('error', 'Error', message);
        }

        function showDeleteConfirm(message, callback, itemData = null) {
          currentItemToDelete = itemData;
          deleteCallback = callback;

          const messageElement = document.getElementById('deleteConfirmMessage');
          if (messageElement) {
            messageElement.textContent = message;
          }

          const modal = document.getElementById('deleteConfirmModal');
          modal.style.display = 'flex';

          setupDeleteModalButtons();
        }

        function setupDeleteModalButtons() {
          const yesBtn = document.getElementById('deleteModalYes');
          const noBtn = document.getElementById('deleteModalNo');

          const newYesBtn = yesBtn.cloneNode(true);
          const newNoBtn = noBtn.cloneNode(true);

          yesBtn.parentNode.replaceChild(newYesBtn, yesBtn);
          noBtn.parentNode.replaceChild(newNoBtn, noBtn);

          newYesBtn.addEventListener('click', handleDeleteConfirm);
          newNoBtn.addEventListener('click', handleDeleteCancel);
        }

        function handleDeleteConfirm(e) {
          e.preventDefault();
          closeDeleteModal();

          if (deleteCallback) {
            if (currentItemToDelete) {
              deleteCallback(currentItemToDelete);
            } else {
              deleteCallback();
            }
          }

          currentItemToDelete = null;
          deleteCallback = null;
        }

        function handleDeleteCancel(e) {
          e.preventDefault();
          closeDeleteModal();

          currentItemToDelete = null;
          deleteCallback = null;
        }

        function closeDeleteModal() {
          const modal = document.getElementById('deleteConfirmModal');
          modal.style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', function () {
          const closeBtn = document.getElementById('closeNotificationModalBtn');
          if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeNotification();
            });
          }

          const modal = document.getElementById('notificationModal');
          if (modal) {
            modal.addEventListener('click', function (e) {
              if (e.target === modal) {
                closeNotification();
              }
            });
          }

          const deleteModal = document.getElementById('deleteConfirmModal');
          if (deleteModal) {
            deleteModal.addEventListener('click', function (e) {
              if (e.target === deleteModal) {
                closeDeleteModal();
                currentItemToDelete = null;
                deleteCallback = null;
              }
            });
          }

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeNotification();
              closeViewModal();
              closeModal();

              const deleteModal = document.getElementById('deleteConfirmModal');
              if (deleteModal.style.display === 'flex') {
                closeDeleteModal();
                currentItemToDelete = null;
                deleteCallback = null;
              }
            }
          });

          loadEvents();
        });

        // ============================================================
        // FUNGSI UTAMA EVENT
        // ============================================================

        async function loadEvents() {
          const container = document.getElementById('eventsContainer');
          let timeoutId;
          try {
            const controller = new AbortController();
            timeoutId = setTimeout(() => controller.abort(), 12000);
            const response = await fetch('/api/admin/events', { signal: controller.signal });

            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();

            if (data.success) {
              const events = Array.isArray(data.data) ? data.data : [];
              allEvents = events;
              updateStats(events);
              displayEvents(events);
              document.getElementById('totalEntries').textContent = events.length;
              document.getElementById('endEntry').textContent = Math.min(6, events.length);
            } else {
              const msg = data.message || 'Gagal memuat event';
              showError(msg);
              if (container) {
                container.innerHTML = `
                  <div class="col-span-full text-center py-10">
                    <p class="text-sm font-extrabold text-red-600">Gagal memuat data event</p>
                    <p class="text-xs text-gray-600 mt-1">${msg}</p>
                    <button onclick="loadEvents()" class="mt-4 px-4 py-2 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700">Coba Lagi</button>
                  </div>
                `;
              }
            }
          } catch (error) {
            console.error('Error loading events:', error);
            const msg = error?.name === 'AbortError'
              ? 'Request timeout saat memuat event'
              : 'Gagal memuat event';
            showError(msg);
            if (container) {
              container.innerHTML = `
                <div class="col-span-full text-center py-10">
                  <p class="text-sm font-extrabold text-red-600">Tidak bisa memuat event</p>
                  <p class="text-xs text-gray-600 mt-1">${msg}</p>
                  <button onclick="loadEvents()" class="mt-4 px-4 py-2 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700">Coba Lagi</button>
                </div>
              `;
            }
          } finally {
            if (timeoutId) clearTimeout(timeoutId);
          }
        }

        function updateStats(events) {
          const total = events.length;
          const active = events.filter(e => e.status === 'active').length;
          const draft = events.filter(e => e.status === 'draft').length;
          const free = events.filter(e => e.event_type === 'gratis').length;

          document.getElementById('totalEvents').textContent = total;
          document.getElementById('activeEvents').textContent = active;
          document.getElementById('draftEvents').textContent = draft;
          document.getElementById('freeEvents').textContent = free;
          document.getElementById('activeNow').textContent = active;
          document.getElementById('draftCount').textContent = draft;
          document.getElementById('freeCount').textContent = free;
        }

        function displayEvents(events) {
          const container = document.getElementById('eventsContainer');

          if (!events || events.length === 0) {
            container.innerHTML = `
              <div class="col-span-full text-center py-12">
                <div class="flex flex-col items-center">
                  <div class="relative">
                    <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-3 border-white/50 float-slow">
                      <i class="fas fa-calendar-times text-2xl text-emerald-300"></i>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                      <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                    </div>
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak Ada Event</h3>
                  <p class="text-sm text-emerald-700 font-medium max-w-md">Buat event pertama Anda untuk memulai.</p>
                  <button onclick="showCreateModal()" class="mt-5 px-5 py-2.5 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-sm font-extrabold shadow-lg flex items-center gap-2">
                    <i class="fas fa-plus text-xs"></i>
                    Buat Event
                  </button>
                </div>
              </div>
            `;
            return;
          }

          container.innerHTML = events.slice(0, 6).map(event => {
            const statusConfig = {
              'draft': { bg: 'gradient-draft', text: 'text-white', icon: 'fas fa-file-alt', badge: 'Draft' },
              'active': { bg: 'gradient-active', text: 'text-white', icon: 'fas fa-check-circle', badge: 'Aktif' },
              'inactive': { bg: 'gradient-inactive', text: 'text-white', icon: 'fas fa-times-circle', badge: 'Tidak Aktif' }
            }[event.status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-file', badge: 'Tidak Diketahui' };

            const isLocked = Number(event.is_locked) === 1;
            const variants = Array.isArray(event.variants) ? event.variants.filter(v => v && v.title) : [];
            const primaryVariant = variants[0] || null;
            const effectiveType = primaryVariant?.event_type || event.event_type || 'berbayar';
            const effectivePriceOriginal = primaryVariant ? (primaryVariant.price_original || 0) : (event.price_original || 0);
            const effectivePricePromo = primaryVariant ? (primaryVariant.price_promo || 0) : (event.price_promo || 0);
            const activeStartDateRaw = event.active_start_date || null;
            const activeEndDateRaw = event.active_end_date || null;
            const displayTitle = primaryVariant?.title || event.title || '-';
            const displayDescription = primaryVariant?.description || event.description || 'Tidak ada deskripsi';
            const typeConfig = {
              'gratis': { bg: 'gradient-gratis', text: 'text-white', icon: 'fas fa-gift', badge: 'Gratis' },
              'berbayar': { bg: 'gradient-berbayar', text: 'text-white', icon: 'fas fa-gem', badge: 'Berbayar' }
            }[effectiveType] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-calendar', badge: 'Tidak Diketahui' };
            const activeStartDate = activeStartDateRaw ? new Date(activeStartDateRaw).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            const activeEndDate = activeEndDateRaw ? new Date(activeEndDateRaw).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            const variantCount = variants.length;
            const variantPreview = variants.slice(0, 3).map((v, idx) => `${idx + 1}. ${v.title || '-'}`);
            const extraVariantCount = Math.max(variantCount - variantPreview.length, 0);
            const waText = event.admin_whatsapp ? `+62 ${event.admin_whatsapp}` : '-';
            const activeRangeText = `${activeStartDate} - ${activeEndDate}`;
            const lockBadge = isLocked
              ? `<span class="px-2.5 py-1.5 rounded-lg text-[9px] font-extrabold bg-gray-900 text-white flex items-center gap-1 border border-white/30">
                  <i class="fas fa-lock text-[8px]"></i>
                  Terkunci
                </span>`
              : '';
            const editButton = isLocked
              ? `<button disabled class="flex-1 text-[9px] font-extrabold text-gray-400 py-2 rounded-lg bg-white/40 cursor-not-allowed flex items-center justify-center gap-1 border border-white/30">
                  <i class="fas fa-edit text-[8px]"></i>
                  Edit
                </button>`
              : `<button onclick="editEvent(${event.id})" class="flex-1 text-[9px] font-extrabold text-emerald-700 hover:text-emerald-800 py-2 rounded-lg hover:bg-white/60 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                  <i class="fas fa-edit text-[8px]"></i>
                  Edit
                </button>`;
            const deleteButton = isLocked
              ? `<button disabled class="flex-1 text-[9px] font-extrabold text-gray-400 py-2 rounded-lg bg-white/40 cursor-not-allowed flex items-center justify-center gap-1 border border-white/30">
                  <i class="fas fa-trash text-[8px]"></i>
                  Hapus
                </button>`
              : `<button onclick="confirmDeleteEvent(${event.id})" class="flex-1 text-[9px] font-extrabold text-red-600 hover:text-red-700 py-2 rounded-lg hover:bg-white/60 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                  <i class="fas fa-trash text-[8px]"></i>
                  Hapus
                </button>`;
            const lockButton = `<button onclick="toggleEventLock(${event.id}, ${isLocked ? 0 : 1})" class="flex-1 text-[9px] font-extrabold ${isLocked ? 'text-amber-700' : 'text-gray-700'} py-2 rounded-lg bg-white/60 hover:bg-white/80 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                <i class="fas ${isLocked ? 'fa-lock-open' : 'fa-lock'} text-[8px]"></i>
                ${isLocked ? 'Buka Kunci' : 'Kunci'}
              </button>`;

            return `
              <div class="glass-futuristic rounded-xl overflow-hidden group card-futuristic border border-white/50">
                <!-- Header with status -->
                <div class="px-4 py-3 border-b border-white/30 bg-white/20 backdrop-blur flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="px-2.5 py-1.5 rounded-lg text-[9px] font-extrabold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-1 border border-white/30">
                      <i class="${statusConfig.icon} text-[8px]"></i>
                      ${statusConfig.badge}
                    </span>
                    <span class="px-2.5 py-1.5 rounded-lg text-[9px] font-extrabold ${typeConfig.bg} ${typeConfig.text} flex items-center gap-1 border border-white/30">
                      <i class="${typeConfig.icon} text-[8px]"></i>
                      ${typeConfig.badge}
                    </span>
                    ${lockBadge}
                  </div>
                  <button onclick="viewEvent(${event.id})" class="w-7 h-7 rounded-lg bg-white/60 hover:bg-white/80 text-emerald-700 transition-all duration-300 flex items-center justify-center border border-white/30">
                    <i class="fas fa-eye text-[10px]"></i>
                  </button>
                </div>

                <!-- Content -->
                <div class="p-4 space-y-3">
                  <div>
                    <h3 class="font-extrabold text-sm text-gray-900 line-clamp-2">${displayTitle}</h3>
                    ${event.headline ? `<p class="text-[10px] font-semibold text-gray-700 mt-1 line-clamp-2">${event.headline}</p>` : ''}
                  </div>

                  <div class="grid grid-cols-1 gap-2 text-[10px]">
                    <div class="flex items-center justify-between bg-indigo-50/80 backdrop-blur px-3 py-2 rounded-lg border border-indigo-200/50">
                      <span class="font-bold text-indigo-700 flex items-center gap-1">
                        <i class="fas fa-calendar-alt text-[9px]"></i>
                        Masa Aktif
                      </span>
                      <span class="font-extrabold text-gray-900">${activeRangeText}</span>
                    </div>
                    <div class="flex items-center justify-between bg-white/50 backdrop-blur px-3 py-2 rounded-lg border border-white/40">
                      <span class="font-bold text-emerald-700 flex items-center gap-1">
                        <i class="fab fa-whatsapp text-[9px]"></i>
                        Admin WA
                      </span>
                      <span class="font-extrabold text-gray-900">${waText}</span>
                    </div>
                  </div>

                  <div class="text-[10px] bg-fuchsia-50/80 backdrop-blur px-3 py-2 rounded-lg border border-fuchsia-200/50">
                    <div class="flex items-center justify-between mb-1.5">
                      <p class="font-extrabold text-fuchsia-700">Varian Event</p>
                      <span class="text-[9px] font-extrabold text-fuchsia-700">${variantCount} varian</span>
                    </div>
                    ${variantCount > 0 ? `
                      <ul class="space-y-1 text-gray-700 font-semibold">
                        ${variantPreview.map((line) => `<li>• ${line}</li>`).join('')}
                        ${extraVariantCount > 0 ? `<li class="text-[9px] text-fuchsia-700 font-bold">+${extraVariantCount} varian lainnya</li>` : ''}
                      </ul>
                    ` : '<p class="font-semibold text-gray-700">Belum ada varian</p>'}
                  </div>

                  <div class="space-y-2">
                    ${effectiveType === 'berbayar' ? `
                      <div class="flex items-center justify-between text-[10px] bg-white/50 backdrop-blur px-3 py-2 rounded-lg border border-white/40">
                        <span class="font-bold text-emerald-700">Harga Asli</span>
                        <span class="font-extrabold text-gray-900">Rp ${parseInt(effectivePriceOriginal || 0).toLocaleString('id-ID')}</span>
                      </div>
                      <div class="flex items-center justify-between text-[10px] bg-white/50 backdrop-blur px-3 py-2 rounded-lg border border-white/40">
                        <span class="font-bold text-emerald-700">Harga Promo</span>
                        <span class="font-extrabold text-emerald-700">Rp ${parseInt(effectivePricePromo || 0).toLocaleString('id-ID')}</span>
                      </div>
                    ` : `
                      <div class="flex items-center justify-between text-[10px] bg-blue-50/80 backdrop-blur px-3 py-2 rounded-lg border border-blue-200/50">
                        <span class="font-extrabold text-blue-700 flex items-center gap-1">
                          <i class="fas fa-gift"></i>
                          Event Gratis
                        </span>
                        <span class="font-extrabold text-blue-600">Tidak Perlu Bayar</span>
                      </div>
                    `}
                  </div>
                </div>

                <!-- Footer -->
                <div class="px-4 py-3 bg-white/30 backdrop-blur border-t border-white/30 flex gap-2">
                  ${lockButton}
                  ${editButton}
                  ${deleteButton}
                </div>
              </div>
            `;
          }).join('');
        }

        function confirmDeleteEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? event.title : 'event ini';
          if (event && Number(event.is_locked) === 1) {
            showError('Event terkunci dan tidak bisa dihapus');
            return;
          }

          showDeleteConfirm(
            `Apakah Anda yakin ingin menghapus "${eventName}"?`,
            async () => {
              await deleteEvent(eventId);
            },
            { id: eventId, name: eventName }
          );
        }

        function confirmUnlockTwice(eventName, onConfirm) {
          showDeleteConfirm(
            `Anda yakin ingin membuka kunci event "${eventName}"?`,
            () => {
              setTimeout(() => {
                showDeleteConfirm(
                  `Konfirmasi terakhir: buka kunci event "${eventName}" sekarang?`,
                  onConfirm,
                  { id: eventName, name: eventName }
                );
              }, 0);
            },
            { id: eventName, name: eventName }
          );
        }

        async function performToggleEventLock(eventId, nextLocked) {
          try {
            const response = await fetch(`/api/admin/events/${eventId}/lock`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ is_locked: nextLocked })
            });
            const data = await response.json();
            if (data.success) {
              showSuccess(data.message || 'Status lock diperbarui');
              loadEvents();
            } else {
              showError('Gagal memperbarui lock: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error updating lock:', error);
            showError('Gagal memperbarui lock: ' + error.message);
          }
        }

        function toggleEventLock(eventId, nextLocked) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? (event.title || 'event ini') : 'event ini';
          if (nextLocked === 0) {
            confirmUnlockTwice(eventName, () => {
              performToggleEventLock(eventId, nextLocked);
            });
            return;
          }
          performToggleEventLock(eventId, nextLocked);
        }

        async function deleteEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? event.title : 'event ini';

          try {
            const response = await fetch(`/api/admin/events/${eventId}`, {
              method: 'DELETE'
            });
            const data = await response.json();

            if (data.success) {
              showSuccess('Event berhasil dihapus');
              loadEvents();
            } else {
              showError('Gagal menghapus event: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error deleting event:', error);
            showError('Gagal menghapus event: ' + error.message);
          }
        }

        function viewEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          if (!event) {
            showError('Event tidak ditemukan');
            return;
          }

          const variants = Array.isArray(event.variants) ? event.variants.filter(v => v && (v.title || v.slug)) : [];
          const primaryVariant = variants[0] || null;
          const effectiveType = primaryVariant?.event_type || event.event_type || 'berbayar';
          const effectivePriceOriginal = primaryVariant ? (primaryVariant.price_original || 0) : (event.price_original || 0);
          const effectivePricePromo = primaryVariant ? (primaryVariant.price_promo || 0) : (event.price_promo || 0);
          const isLocked = Number(event.is_locked) === 1;
          const useMainPeriodForDetail = variants.length > 2;
          const effectiveStartDateRaw = useMainPeriodForDetail
            ? (event.start_date || primaryVariant?.start_date || null)
            : (primaryVariant ? (primaryVariant.start_date || event.start_date || null) : (event.start_date || null));
          const effectiveEndDateRaw = useMainPeriodForDetail
            ? (event.end_date || primaryVariant?.end_date || null)
            : (primaryVariant ? (primaryVariant.end_date || event.end_date || null) : (event.end_date || null));
          const displayTitle = primaryVariant?.title || event.title || '-';
          const displayDescription = primaryVariant?.description || event.description || 'Tidak ada deskripsi';
          const displaySlug = primaryVariant?.slug || event.slug || '-';

          document.getElementById('viewEventId').textContent = event.id;
          document.getElementById('viewEventTitle').textContent = displayTitle;
          document.getElementById('viewEventDescription').textContent = displayDescription;
          document.getElementById('viewEventSlug').textContent = displaySlug;
          document.getElementById('viewEventType').textContent = effectiveType === 'gratis' ? 'Gratis' : 'Berbayar';
          document.getElementById('viewEventStatus').textContent = event.status === 'active' ? 'Aktif' : event.status === 'draft' ? 'Draft' : 'Tidak Aktif';

          const statusConfig = {
            'draft': { bg: 'gradient-draft', text: 'text-white', icon: 'fas fa-file-alt', badge: 'Draft' },
            'active': { bg: 'gradient-active', text: 'text-white', icon: 'fas fa-check-circle', badge: 'Aktif' },
            'inactive': { bg: 'gradient-inactive', text: 'text-white', icon: 'fas fa-times-circle', badge: 'Tidak Aktif' }
          }[event.status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-file', badge: 'Tidak Diketahui' };

          const statusBadge = document.getElementById('viewEventStatusBadge');
          statusBadge.className = `px-3 py-1.5 rounded-lg text-[9px] font-extrabold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-1 border border-white/30`;
          statusBadge.innerHTML = `<i class="${statusConfig.icon}"></i>${statusConfig.badge}`;

          const typeConfig = {
            'gratis': { bg: 'gradient-gratis', text: 'text-white', icon: 'fas fa-gift', badge: 'Gratis' },
            'berbayar': { bg: 'gradient-berbayar', text: 'text-white', icon: 'fas fa-gem', badge: 'Berbayar' }
          }[effectiveType] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-calendar', badge: 'Tidak Diketahui' };

          const typeBadge = document.getElementById('viewEventTypeBadge');
          typeBadge.className = `px-3 py-1.5 rounded-lg text-[9px] font-extrabold ${typeConfig.bg} ${typeConfig.text} flex items-center gap-1 border border-white/30`;
          typeBadge.innerHTML = `<i class="${typeConfig.icon}"></i>${typeConfig.badge}`;

          const priceBadge = document.getElementById('viewEventPriceBadge');
          if (effectiveType === 'gratis') {
            priceBadge.className = 'px-3 py-1.5 rounded-lg text-[9px] font-extrabold gradient-gratis text-white flex items-center gap-1 border border-white/30';
            priceBadge.innerHTML = '<i class="fas fa-gift"></i>GRATIS';
          } else {
            const promoPrice = parseInt(effectivePricePromo || 0);
            priceBadge.className = 'px-3 py-1.5 rounded-lg text-[9px] font-extrabold gradient-berbayar text-white flex items-center gap-1 border border-white/30';
            priceBadge.innerHTML = `<i class="fas fa-tags"></i>Rp ${promoPrice.toLocaleString('id-ID')}`;
          }

          const lockBadge = document.getElementById('viewEventLockBadge');
          if (lockBadge) {
            if (isLocked) {
              lockBadge.style.display = 'inline-flex';
              lockBadge.className = 'px-3 py-1.5 rounded-lg text-[9px] font-extrabold bg-gray-900 text-white flex items-center gap-1 border border-white/30';
              lockBadge.innerHTML = '<i class="fas fa-lock"></i>TERKUNCI';
            } else {
              lockBadge.style.display = 'none';
              lockBadge.className = 'px-3 py-1.5 rounded-lg text-[9px] font-extrabold flex items-center gap-1 border border-white/30';
              lockBadge.innerHTML = '';
            }
          }

          const mainStartDateRaw = effectiveStartDateRaw || null;
          const mainEndDateRaw = effectiveEndDateRaw || null;
          const startDate = mainStartDateRaw ? new Date(mainStartDateRaw).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) : '-';
          const endDate = mainEndDateRaw ? new Date(mainEndDateRaw).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) : '-';

          document.getElementById('viewActiveStartDate').textContent = startDate;
          document.getElementById('viewActiveEndDate').textContent = endDate;
          const variantDateListWrap = document.getElementById('viewVariantDateListWrap');
          const variantDateList = document.getElementById('viewVariantDateList');
          variantDateList.innerHTML = '';
          if (variants.length > 1) {
            variants.forEach((v, idx) => {
              const s = v.start_date ? new Date(v.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
              const e = v.end_date ? new Date(v.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
              const li = document.createElement('li');
              li.textContent = `Varian ${idx + 1}: ${s} - ${e}`;
              variantDateList.appendChild(li);
            });
            variantDateListWrap.classList.remove('hidden');
          } else {
            variantDateListWrap.classList.add('hidden');
          }

          if (effectiveType === 'berbayar') {
            document.getElementById('viewPricingSection').classList.remove('hidden');
            document.getElementById('viewFreeEventSection').classList.add('hidden');

            document.getElementById('viewPriceOriginal').textContent = `Rp ${parseInt(effectivePriceOriginal || 0).toLocaleString('id-ID')}`;
            document.getElementById('viewPricePromo').textContent = `Rp ${parseInt(effectivePricePromo || 0).toLocaleString('id-ID')}`;
          } else {
            document.getElementById('viewPricingSection').classList.add('hidden');
            document.getElementById('viewFreeEventSection').classList.remove('hidden');
          }

          const variantInfoSection = document.getElementById('viewVariantInfoSection');
          const variantInfoList = document.getElementById('viewVariantInfoList');
          variantInfoList.innerHTML = '';
          if (variants.length) {
            variants.forEach((v, idx) => {
              const vType = v.event_type === 'gratis' ? 'Gratis' : 'Berbayar';
              const vPriceOriginal = parseInt(v.price_original || 0).toLocaleString('id-ID');
              const vPricePromo = parseInt(v.price_promo || 0).toLocaleString('id-ID');
              const vStart = v.start_date ? new Date(v.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
              const vEnd = v.end_date ? new Date(v.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
              const row = document.createElement('div');
              row.className = 'bg-white/70 border border-fuchsia-200/60 rounded-lg p-3 space-y-1.5';
              row.innerHTML = `
                <p class="text-xs font-extrabold text-fuchsia-800">Varian ${idx + 1}: ${v.title || '-'}</p>
                <p class="text-[11px] text-gray-700"><span class="font-bold text-fuchsia-700">Slug:</span> ${v.slug || '-'}</p>
                <p class="text-[11px] text-gray-700"><span class="font-bold text-fuchsia-700">Tipe:</span> ${vType}</p>
                <p class="text-[11px] text-gray-700"><span class="font-bold text-fuchsia-700">Harga:</span> ${v.event_type === 'gratis' ? 'Gratis' : `Rp ${vPriceOriginal} -> Rp ${vPricePromo}`}</p>
                <p class="text-[11px] text-gray-700"><span class="font-bold text-fuchsia-700">Periode:</span> ${vStart} - ${vEnd}</p>
              `;
              variantInfoList.appendChild(row);
            });
            variantInfoSection.classList.remove('hidden');
          } else {
            variantInfoSection.classList.add('hidden');
          }

          document.getElementById('viewAdminWhatsApp').textContent = event.admin_whatsapp ? `+62 ${event.admin_whatsapp}` : '-';

          // hero media details
          const heroSection = document.getElementById('viewHeroSection');
          const headlineText = event.headline || '';
          const subheadlineText = event.subheadline || '';
          document.getElementById('viewHeadline').textContent = headlineText;
          document.getElementById('viewSubheadline').textContent = subheadlineText;

          const mediaEl = document.getElementById('viewHeroMedia');
          const mediaImg = document.getElementById('viewHeroMediaImage');
          let mediaText = '';
          if (event.hero_media_type && event.hero_media_url) {
            mediaText = `${event.hero_media_type.toUpperCase()}: ${event.hero_media_url}` + (event.hero_as_background ? ' (background)' : '');
            if (event.hero_media_type.toLowerCase() === 'image') {
              mediaImg.src = event.hero_media_url;
              mediaImg.classList.remove('hidden');
            } else {
              mediaImg.src = '';
              mediaImg.classList.add('hidden');
            }
          } else {
            mediaImg.src = '';
            mediaImg.classList.add('hidden');
          }
          mediaEl.textContent = mediaText;

          const headlineRow = document.getElementById('viewHeadlineRow');
          const subheadlineRow = document.getElementById('viewSubheadlineRow');
          const heroMediaRow = document.getElementById('viewHeroMediaRow');
          headlineRow.style.display = headlineText ? '' : 'none';
          subheadlineRow.style.display = subheadlineText ? '' : 'none';
          heroMediaRow.style.display = mediaText ? '' : 'none';

          if (!(headlineText || subheadlineText || mediaText)) {
            heroSection.style.display = 'none';
          } else {
            heroSection.style.display = '';
          }

          // benefits
          const benefitsSection = document.getElementById('viewBenefitsSection');
          const benefitsContainer = document.getElementById('viewBenefitsList');
          benefitsContainer.innerHTML = '';
          if (event.benefits && Array.isArray(event.benefits) && event.benefits.length) {
            event.benefits.forEach(b => {
              const li = document.createElement('li');
              li.textContent = b.benefit_text || b;
              benefitsContainer.appendChild(li);
            });
            benefitsSection.style.display = '';
          } else {
            benefitsSection.style.display = 'none';
          }

          // problem & pains
          const problemSection = document.getElementById('viewProblemSection');
          document.getElementById('viewProblemTitle').textContent = event.problem_title || '';
          document.getElementById('viewProblemSubtitle').textContent = event.problem_subtitle || '';
          const painsContainer = document.getElementById('viewPainsList');
          painsContainer.innerHTML = '';
          if (event.pains && Array.isArray(event.pains) && event.pains.length) {
            event.pains.forEach(p => {
              const li = document.createElement('li');
              const title = p.pain_title || p.title || '';
              const desc = p.pain_description || p.description || '';
              li.innerHTML = title ? `<strong>${title}</strong>: ${desc}` : desc;
              painsContainer.appendChild(li);
            });
            problemSection.style.display = '';
          } else {
            problemSection.style.display = 'none';
          }

          // solutions
          const solutionSection = document.getElementById('viewSolutionSection');
          document.getElementById('viewSolutionTitle').textContent = event.solution_title || '';
          document.getElementById('viewSolutionSubtitle').textContent = event.solution_subtitle || '';
          const solutionsContainer = document.getElementById('viewSolutionsList');
          solutionsContainer.innerHTML = '';
          if (event.solutions && Array.isArray(event.solutions) && event.solutions.length) {
            event.solutions.forEach(s => {
              const li = document.createElement('li');
              const title = s.solution_title || s.title || '';
              const desc = s.solution_description || s.description || '';
              li.innerHTML = title ? `<strong>${title}</strong>: ${desc}` : desc;
              solutionsContainer.appendChild(li);
            });
            solutionSection.style.display = '';
          } else {
            solutionSection.style.display = 'none';
          }


          // faqs
          const faqSection = document.getElementById('viewFaqSection');
          const faqsContainer = document.getElementById('viewFaqsList');
          faqsContainer.innerHTML = '';
          if (event.faqs && Array.isArray(event.faqs) && event.faqs.length) {
            event.faqs.forEach(f => {
              const li = document.createElement('li');
              li.innerHTML = `<strong>${f.question}</strong><br>${f.answer}`;
              faqsContainer.appendChild(li);
            });
            faqSection.style.display = '';
          } else {
            faqSection.style.display = 'none';
          }

          // testimonials
          const testimonialsSection = document.getElementById('viewTestimonialsSection');
          const testimonialsContainer = document.getElementById('viewTestimonialsList');
          testimonialsContainer.innerHTML = '';
          if (event.testimonials && Array.isArray(event.testimonials) && event.testimonials.length) {
            event.testimonials.forEach((t, idx) => {
              const li = document.createElement('li');
              const type = (t.media_type || 'image').toUpperCase();
              li.innerHTML = `<strong>${idx + 1}. ${type}</strong>: ${t.media_url || '-'}`;
              testimonialsContainer.appendChild(li);
            });
            testimonialsSection.style.display = '';
          } else {
            testimonialsSection.style.display = 'none';
          }

          // activity docs
          const activityDocsSection = document.getElementById('viewActivityDocsSection');
          const activityDocsContainer = document.getElementById('viewActivityDocsList');
          activityDocsContainer.innerHTML = '';
          if (event.activity_docs && Array.isArray(event.activity_docs) && event.activity_docs.length) {
            event.activity_docs.forEach((d, idx) => {
              const li = document.createElement('li');
              const type = (d.media_type || 'image').toUpperCase();
              const info = (d.info_text || '').trim();
              li.innerHTML = `<strong>${idx + 1}. ${type}</strong>: ${d.media_url || '-'}${info ? ` <span class="text-gray-500">(${info})</span>` : ''}`;
              activityDocsContainer.appendChild(li);
            });
            activityDocsSection.style.display = '';
          } else {
            activityDocsSection.style.display = 'none';
          }

          // susun urutan detail mengikuti alur form Buat Event:
          // Header/Hero -> Konten LP (benefits/problem/faq/testimoni/varian) -> Meta/Pricing/Periode -> Admin WA
          const viewModalContent = document.getElementById('viewModalContent');
          const viewHeaderBlock = document.getElementById('viewHeaderBlock');
          const viewMetaBlock = document.getElementById('viewMetaBlock');
          const viewContactBlock = document.getElementById('viewContactBlock');
          const viewAdditionalSections = document.getElementById('viewAdditionalSections');
          if (viewModalContent && viewHeaderBlock && viewAdditionalSections && viewMetaBlock && viewContactBlock) {
            viewModalContent.appendChild(viewHeaderBlock);
            viewModalContent.appendChild(viewAdditionalSections);
            viewModalContent.appendChild(viewMetaBlock);
            viewModalContent.appendChild(viewContactBlock);
          }

          const editBtn = document.getElementById('editFromViewBtn');
          if (editBtn) {
            if (isLocked) {
              editBtn.setAttribute('disabled', 'disabled');
              editBtn.classList.add('opacity-50', 'cursor-not-allowed');
              editBtn.removeAttribute('onclick');
              editBtn.onclick = (e) => {
                e.preventDefault();
                showError('Event terkunci dan tidak bisa diedit');
              };
            } else {
              editBtn.removeAttribute('disabled');
              editBtn.classList.remove('opacity-50', 'cursor-not-allowed');
              editBtn.setAttribute('onclick', `closeViewModal(); editEvent(${event.id})`);
            }
          }

          document.getElementById('viewModal').classList.remove('hidden');
          document.getElementById('viewModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeViewModal() {
          document.getElementById('viewModal').classList.add('hidden');
          document.getElementById('viewModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function editFromView() {
          closeViewModal();
          setTimeout(() => {
            const eventId = document.getElementById('viewEventId').textContent;
            editEvent(parseInt(eventId));
          }, 300);
        }

        function showCreateModal() {
          document.getElementById('modalTitleText').textContent = 'Buat Event';
          document.getElementById('submitButtonText').textContent = 'Tambah Event';
          document.getElementById('eventForm').reset();
          document.getElementById('eventId').value = '';
          // clear hero fields
          document.getElementById('headline').value = '';
          document.getElementById('subheadline').value = '';
          document.getElementById('hero_media_source').value = 'url';
          document.getElementById('hero_media_type').value = '';
          document.getElementById('hero_media_url').value = '';
          document.getElementById('hero_media_file').value = '';
