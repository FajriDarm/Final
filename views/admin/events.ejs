                stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h2 class="text-xl font-bold text-gray-900 mb-2" id="notificationTitle">Sukses</h2>
          <p class="text-gray-600 mb-6" id="notificationMessage">Operasi berhasil dilakukan</p>
          <button id="closeNotificationModalBtn" type="button"
            class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-green-700 hover:to-emerald-700 transition-all duration-200">
