        function syncPeriodsWithVariants() {
          const variants = Array.from(document.querySelectorAll('#variantsList .variant-item'));
          const periodsList = document.getElementById('periodsList');
          if (!periodsList) return;
          const required = Math.max(variants.length, 1);
          while (periodsList.children.length < required) {
            addPeriod({}, false);
          }
          while (periodsList.children.length > required) {
            periodsList.removeChild(periodsList.lastElementChild);
          }
          const rows = Array.from(periodsList.querySelectorAll('.period-item'));
          rows.forEach((row, idx) => {
            const title = variants[idx]?.querySelector('.variant-title')?.value?.trim() || `Paket ${idx + 1}`;
            const labelEl = row.querySelector('.period-package-label');
            const nameEl = row.querySelector('.period-package-name');
            const periodInfoEl = variants[idx]?.querySelector('.variant-period-info');
            const startVal = row.querySelector('.period-start')?.value || '';
            const endVal = row.querySelector('.period-end')?.value || '';
            const sText = startVal ? new Date(startVal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            const eText = endVal ? new Date(endVal).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            if (labelEl) labelEl.textContent = `Periode Paket ${idx + 1}`;
            if (nameEl) nameEl.textContent = title;
            if (periodInfoEl) periodInfoEl.textContent = `Periode varian: ${sText} - ${eText}`;
          });
        }

        function addFAQ(question = '', answer = '') {
          const list = document.getElementById('faqsList');
          const div = document.createElement('div');
          div.className = 'space-y-2 faq-item';
          div.innerHTML = `
            <input type="text" class="faq-question w-full px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" placeholder="Pertanyaan" value="${question.replace(/"/g,'&quot;')}">
            <textarea class="faq-answer w-full px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" rows="2" placeholder="Jawaban">${answer}</textarea>
            <button type="button" class="text-red-500 text-xs" onclick="this.parentElement.remove()">&times;</button>
          `;
          list.appendChild(div);
        }





        const eventFormEl = document.getElementById('eventForm');

        // Prevent implicit form submit from native date picker Enter behavior on some browsers.
        eventFormEl.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target && e.target.matches('input[type="date"]')) {
            e.preventDefault();
          }
        });

        eventFormEl.addEventListener('submit', async (e) => {
          e.preventDefault();
          syncPeriodsWithVariants();

          const eventId = document.getElementById('eventId').value;
          const status = document.querySelector('input[name="status"]:checked').value;

          let formData = {
            event_type: '',
            admin_whatsapp: document.getElementById('admin_whatsapp').value,
            status: status,
            active_start_date: document.getElementById('active_start_date').value || null,
            active_end_date: document.getElementById('active_end_date').value || null,
            headline: document.getElementById('headline').value,
            subheadline: document.getElementById('subheadline').value,
            hero_media_type: document.getElementById('hero_media_type').value,
            hero_media_url: document.getElementById('hero_media_url').value.trim(),
            hero_as_background: document.getElementById('hero_as_background').checked ? 1 : 0,
            benefits: [],
            problemTitle: document.getElementById('problemTitle').value,
            problemSubtitle: document.getElementById('problemSubtitle').value,
            pains: [],
            solutionTitle: document.getElementById('solutionTitle').value,
            solutionSubtitle: document.getElementById('solutionSubtitle').value,
            solutions: [],
            periods: [],
            faqs: [],
            testimonials: [],
            activity_docs: [],
            variants: []
          };

          if (formData.hero_media_url && !formData.hero_media_type) {
            formData.hero_media_type = detectHeroMediaTypeFromUrl(formData.hero_media_url);
          }

          // collect benefits
          document.querySelectorAll('.benefit-input').forEach(input => {
            if (input.value.trim()) formData.benefits.push(input.value.trim());
          });
          // collect pains
          document.querySelectorAll('.pain-item').forEach(item => {
            const titleEl = item.querySelector('.pain-title');
            const descEl = item.querySelector('.pain-desc');
            if (titleEl || descEl) {
              formData.pains.push({
                pain_title: titleEl ? titleEl.value.trim() : '',
                pain_description: descEl ? descEl.value.trim() : '',
              });
            }
          });

          // collect solutions
          document.querySelectorAll('.solution-item').forEach(item => {
            const titleEl = item.querySelector('.solution-title');
            const descEl = item.querySelector('.solution-desc');
            if (titleEl || descEl) {
              formData.solutions.push({
                solution_title: titleEl ? titleEl.value.trim() : '',
                solution_description: descEl ? descEl.value.trim() : '',
              });
            }
          });

          const variantItems = Array.from(document.querySelectorAll('#variantsList .variant-item'));
          const periodItems = Array.from(document.querySelectorAll('#periodsList .period-item'));

          // collect periods (per paket)
          periodItems.forEach(item => {
            formData.periods.push({
              start_date: item.querySelector('.period-start')?.value || null,
              end_date: item.querySelector('.period-end')?.value || null,
            });
          });

          // collect faqs
          document.querySelectorAll('.faq-item').forEach(item => {
            const qEl = item.querySelector('.faq-question');
            const aEl = item.querySelector('.faq-answer');
            if (qEl && aEl && qEl.value.trim() && aEl.value.trim()) {
              formData.faqs.push({ question: qEl.value.trim(), answer: aEl.value.trim() });
            }
          });

          // collect testimonials
          document.querySelectorAll('.testimonial-item').forEach((item) => {
            const typeEl = item.querySelector('.testimonial-media-type');
            const urlEl = item.querySelector('.testimonial-media-url');
            if (!typeEl || !urlEl) return;
            const mediaUrl = urlEl.value.trim();
            if (!mediaUrl) return;
            formData.testimonials.push({
              media_type: typeEl.value || detectHeroMediaTypeFromUrl(mediaUrl),
              media_url: mediaUrl
            });
          });

          // collect activity docs
          document.querySelectorAll('.activity-doc-item').forEach((item) => {
            const typeEl = item.querySelector('.activity-doc-media-type');
            const urlEl = item.querySelector('.activity-doc-media-url');
            const infoEl = item.querySelector('.activity-doc-info');
            if (!typeEl || !urlEl) return;
            const mediaUrl = urlEl.value.trim();
            if (!mediaUrl) return;
            formData.activity_docs.push({
              media_type: typeEl.value || detectHeroMediaTypeFromUrl(mediaUrl),
              media_url: mediaUrl,
              info_text: infoEl ? infoEl.value.trim() : ''
            });
          });

          // collect variants
          const usedVariantSlugs = new Set();
          for (let idx = 0; idx < variantItems.length; idx++) {
            const item = variantItems[idx];
            const title = item.querySelector('.variant-title')?.value?.trim() || '';
            if (!title) {
              showError(`Judul varian ke-${idx + 1} wajib diisi`);
              return;
            }
            const slugRaw = item.querySelector('.variant-slug')?.value?.trim() || '';
            const eventTypeVariant = item.querySelector('.variant-type')?.value || 'berbayar';
            const logoType = item.querySelector('.variant-logo-type')?.value || '';
            const logoUrl = item.querySelector('.variant-logo-url')?.value?.trim() || '';
            const period = formData.periods[idx] || formData.periods[0] || { start_date: null, end_date: null };
            const baseSlug = slugRaw || generateSlug(title) || `varian-${idx + 1}`;
            let finalSlug = baseSlug;
            let suffix = 2;
            while (usedVariantSlugs.has(finalSlug)) {
              finalSlug = `${baseSlug}-${suffix++}`;
            }
            usedVariantSlugs.add(finalSlug);
            formData.variants.push({
              event_type: eventTypeVariant,
              title: title,
              slug: finalSlug,
              description: item.querySelector('.variant-description')?.value || '',
              price_original: eventTypeVariant === 'gratis' ? 0 : (item.querySelector('.variant-price-original')?.value || 0),
              price_promo: eventTypeVariant === 'gratis' ? 0 : (item.querySelector('.variant-price-promo')?.value || 0),
              start_date: period.start_date || null,
              end_date: period.end_date || null,
              logo_media_type: logoType || (logoUrl ? detectHeroMediaTypeFromUrl(logoUrl) : ''),
              logo_media_url: logoUrl
            });
          }

          if (formData.variants.length === 0) {
            showError('Minimal harus ada 1 varian event');
            return;
          }

          const primaryVariant = formData.variants[0];
          formData.event_type = primaryVariant.event_type;
          formData.title = primaryVariant.title;
          formData.slug = primaryVariant.slug || generateSlug(primaryVariant.title);
          formData.description = primaryVariant.description || '';
          formData.price_original = primaryVariant.event_type === 'gratis' ? 0 : (primaryVariant.price_original || 0);
          formData.price_promo = primaryVariant.event_type === 'gratis' ? 0 : (primaryVariant.price_promo || 0);
          formData.start_date = formData.periods[0]?.start_date || null;
          formData.end_date = formData.periods[0]?.end_date || null;

          if (formData.periods.length < formData.variants.length) {
            showError('Jumlah periode harus sama dengan jumlah varian');
            return;
          }

          for (let i = 0; i < formData.variants.length; i++) {
            const p = formData.periods[i] || {};
            if (!p.start_date || !p.end_date) {
              showError(`Periode varian ke-${i + 1} wajib diisi lengkap (mulai dan berakhir)`);
              return;
            }
          }

          if ((formData.active_start_date && !formData.active_end_date) || (!formData.active_start_date && formData.active_end_date)) {
            showError('Masa aktif event harus diisi lengkap (mulai dan berakhir)');
            return;
          }

          try {
            const url = eventId ? `/api/admin/events/${eventId}` : '/api/admin/events';
            const method = eventId ? 'PUT' : 'POST';

            const response = await fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (data.success) {
              const landingUrl = data?.data?.landing_url;
              const successMessage = eventId
                ? (landingUrl ? `Event berhasil diperbarui. Landing: ${landingUrl}` : 'Event berhasil diperbarui')
                : (landingUrl ? `Event berhasil dibuat. Landing: ${landingUrl}` : 'Event berhasil dibuat');
              showSuccess(successMessage);
              closeModal();
              loadEvents();
            } else {
              showError('Gagal menyimpan event: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error saving event:', error);
            showError('Gagal menyimpan event: ' + error.message);
          }
        });

        document.getElementById('hero_media_source').addEventListener('change', toggleHeroInputMode);
        document.getElementById('hero_media_url').addEventListener('input', function(e) {
          const mediaUrl = e.target.value.trim();
          if (!mediaUrl) {
            document.getElementById('hero_preview').innerHTML = '';
            return;
          }
          const detectedType = detectHeroMediaTypeFromUrl(mediaUrl);
          if (!document.getElementById('hero_media_type').value) {
            document.getElementById('hero_media_type').value = detectedType;
          }
          renderHeroPreview(mediaUrl, document.getElementById('hero_media_type').value || detectedType);
        });
        document.getElementById('hero_media_type').addEventListener('change', function() {
          renderHeroPreview(
            document.getElementById('hero_media_url').value.trim(),
            document.getElementById('hero_media_type').value
          );
        });

        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            filterEvents();
          }, 300);
        });

        document.getElementById('statusFilter').addEventListener('change', filterEvents);
        document.getElementById('typeFilter').addEventListener('change', filterEvents);

        // upload when file selected
        document.getElementById('hero_media_file').addEventListener('change', async function(e) {
          const file = e.target.files[0];
          if (!file) return;
          try {
            const data = await uploadMediaFile(file);
            const detectedType = file.type.startsWith('video/') ? 'video' : 'image';
            document.getElementById('hero_media_url').value = data.url;
            document.getElementById('hero_media_type').value = detectedType;
            document.getElementById('hero_media_source').value = 'upload';
            toggleHeroInputMode();
            renderHeroPreview(data.url, detectedType);
            showSuccess('File berhasil diunggah');
          } catch (err) {
            console.error('hero upload', err);
            showError('Upload gagal: ' + err.message);
          }
        });

        function filterEvents() {
          const searchTerm = document.getElementById('searchInput').value.toLowerCase();
          const statusFilter = document.getElementById('statusFilter').value;
          const typeFilter = document.getElementById('typeFilter').value;

          const filtered = allEvents.filter(event => {
            const matchesSearch = !searchTerm ||
              event.title.toLowerCase().includes(searchTerm) ||
              (event.headline && event.headline.toLowerCase().includes(searchTerm)) ||
              (event.description && event.description.toLowerCase().includes(searchTerm));

            const matchesStatus = !statusFilter || event.status === statusFilter;
            const matchesType = !typeFilter || event.event_type === typeFilter;

            return matchesSearch && matchesStatus && matchesType;
          });

          displayEvents(filtered);
          document.getElementById('totalEntries').textContent = filtered.length;
          document.getElementById('endEntry').textContent = Math.min(6, filtered.length);
        }

        function clearFilters() {
          document.getElementById('searchInput').value = '';
          document.getElementById('statusFilter').value = '';
          document.getElementById('typeFilter').value = '';
          filterEvents();
        }

        document.getElementById('viewModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('viewModal')) {
            closeViewModal();
          }
        });

        document.getElementById('eventModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('eventModal')) {
            closeModal();
          }
        });

        setInterval(loadEvents, 60000);
      </script>
</body>

</html>
