                    <i class="fas fa-toggle-on text-gray-600"></i>
                  </div>
                  <h5 class="font-semibold text-gray-900 text-lg">Status</h5>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="draft" class="peer sr-only">
                    <div
                      class="p-4 border-2 border-gray-200 rounded-xl hover:border-yellow-400 peer-checked:border-yellow-500 peer-checked:bg-yellow-50 transition-all text-center">
                      <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-file-alt text-yellow-600"></i>
                      </div>
                      <p class="font-medium text-gray-900">Draft</p>
                      <p class="text-xs text-gray-500 mt-1">Save as draft</p>
                    </div>
