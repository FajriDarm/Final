                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="draft" class="peer sr-only">
                    <div
                      class="p-2.5 border-2 border-white/50 rounded-lg hover:border-amber-400 peer-checked:border-amber-500 peer-checked:bg-amber-50/50 transition-all duration-300 text-center bg-white/40 backdrop-blur">
                      <div class="w-6 h-6 bg-amber-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                        <i class="fas fa-file-alt text-amber-600 text-[10px]"></i>
                      </div>
                      <p class="font-extrabold text-gray-900 text-[10px]">Draft</p>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="active" class="peer sr-only" checked>
                    <div
                      class="p-2.5 border-2 border-white/50 rounded-lg hover:border-emerald-400 peer-checked:border-emerald-500 peer-checked:bg-emerald-50/50 transition-all duration-300 text-center bg-white/40 backdrop-blur">
                      <div class="w-6 h-6 bg-emerald-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                        <i class="fas fa-check-circle text-emerald-600 text-[10px]"></i>
                      </div>
                      <p class="font-extrabold text-gray-900 text-[10px]">Aktif</p>
                    </div>
                  </label>
                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="inactive" class="peer sr-only">
                    <div
                      class="p-2.5 border-2 border-white/50 rounded-lg hover:border-red-400 peer-checked:border-red-500 peer-checked:bg-red-50/50 transition-all duration-300 text-center bg-white/40 backdrop-blur">
                      <div class="w-6 h-6 bg-red-100 rounded-lg flex items-center justify-center mx-auto mb-1">
                        <i class="fas fa-times-circle text-red-600 text-[10px]"></i>
                      </div>
                      <p class="font-extrabold text-gray-900 text-[10px]">Tidak Aktif</p>
                    </div>
                  </label>
                </div>
              </div>
            </form>
          </div>

          <!-- Modal Footer -->
          <div class="border-t border-white/30 px-5 py-3 bg-white/40 backdrop-blur flex gap-3">
            <button type="button" onclick="closeModal()"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-2.5 rounded-lg transition-all duration-300 text-xs font-extrabold flex items-center justify-center gap-1 border border-white/60">
              <i class="fas fa-times"></i>
              Batal
            </button>
            <button type="submit" form="eventForm"
              class="flex-1 gradient-secondary text-white py-2.5 rounded-lg hover:opacity-90 transition-all duration-300 text-xs font-extrabold shadow-lg flex items-center justify-center gap-1">
              <i class="fas fa-save"></i>
              <span id="submitButtonText">Simpan</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Modal Notifikasi Premium -->
      <div id="notificationModal" class="modal-notification">
        <div class="modal-box">
          <span class="notification-icon success" id="notificationIcon">
            <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
              <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
              <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff"
                stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2" id="notificationTitle">Sukses</h2>
          <p class="text-gray-600 mb-4 text-sm font-medium" id="notificationMessage">Operasi berhasil dilakukan</p>
          <button id="closeNotificationModalBtn" type="button"
            class="w-full gradient-primary text-white py-3 px-5 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
            Tutup
          </button>
        </div>
      </div>

      <!-- Modal Konfirmasi Hapus Premium -->
      <div id="deleteConfirmModal" style="display:none;" class="modal-notification">
        <div class="modal-box">
          <span class="notification-icon error">
            <i class="fas fa-exclamation-triangle"></i>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Konfirmasi Hapus</h2>
          <p class="text-gray-600 mb-3 text-sm font-medium" id="deleteConfirmMessage">Apakah Anda yakin ingin menghapus
            event ini?</p>
          <p class="text-[9px] font-medium text-gray-400 mb-4">Aksi ini tidak dapat dibatalkan.</p>
          <div class="flex gap-3">
            <button id="deleteModalNo"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 px-4 rounded-xl text-xs font-extrabold transition-all duration-300 border border-white/60">
              Batal
            </button>
            <button id="deleteModalYes"
              class="flex-1 bg-gradient-to-r from-red-600 to-rose-600 text-white py-3 px-4 rounded-xl text-xs font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
              Ya, Hapus
            </button>
          </div>
        </div>
      </div>

      <script>
        let allEvents = [];
        let currentItemToDelete = null;
        let deleteCallback = null;
        // temporary arrays to hold dynamic inputs when editing/creating
        let currentBenefits = [];
        let currentPains = [];
        let currentProblemSection = { title: '', subtitle: '' };
        let currentFaqs = []; // for dynamic FAQs

        // ============================================================
        // FUNGSI NOTIFIKASI MODAL
        // ============================================================

        function showNotification(type, title, message, autoClose = true) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const titleEl = document.getElementById('notificationTitle');
          const messageEl = document.getElementById('notificationMessage');
          const closeBtn = document.getElementById('closeNotificationModalBtn');

          icon.className = 'notification-icon';

          const configs = {
            success: {
              iconClass: 'success',
              iconHTML: `
                <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
                  <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
                  <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                    stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              `,
              buttonClass: 'gradient-primary'
            },
            error: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-times-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            },
            warning: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-exclamation-triangle"></i>',
              buttonClass: 'bg-gradient-to-r from-amber-500 to-orange-500'
            },
            info: {
              iconClass: 'info',
              iconHTML: '<i class="fas fa-info-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-blue-600 to-indigo-600'
            }
          };

          const config = configs[type] || configs.info;

          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;
          titleEl.textContent = title;
          messageEl.textContent = message;

          closeBtn.className = `w-full ${config.buttonClass} text-white py-3 px-5 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg`;

          if (type === 'success') {
            const checkmarkPath = icon.querySelector('.notification-checkmark-path');
            if (checkmarkPath) {
              checkmarkPath.style.strokeDasharray = '40';
              checkmarkPath.style.strokeDashoffset = '40';
              setTimeout(() => {
                checkmarkPath.style.animation = 'none';
                setTimeout(() => {
                  checkmarkPath.style.animation = 'checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards';
                }, 10);
              }, 10);
            }
          }

          modal.style.display = 'flex';

          if (autoClose) {
            setTimeout(() => {
              closeNotification();
            }, 4000);
          }
        }

        function closeNotification() {
          document.getElementById('notificationModal').style.display = 'none';
        }

        function showSuccess(message) {
          showNotification('success', 'Sukses', message);
        }

        function showError(message) {
          showNotification('error', 'Error', message);
        }

        function showDeleteConfirm(message, callback, itemData = null) {
          currentItemToDelete = itemData;
          deleteCallback = callback;

          const messageElement = document.getElementById('deleteConfirmMessage');
          if (messageElement) {
            messageElement.textContent = message;
          }

          const modal = document.getElementById('deleteConfirmModal');
          modal.style.display = 'flex';

          setupDeleteModalButtons();
        }

        function setupDeleteModalButtons() {
          const yesBtn = document.getElementById('deleteModalYes');
          const noBtn = document.getElementById('deleteModalNo');

          const newYesBtn = yesBtn.cloneNode(true);
          const newNoBtn = noBtn.cloneNode(true);

          yesBtn.parentNode.replaceChild(newYesBtn, yesBtn);
          noBtn.parentNode.replaceChild(newNoBtn, noBtn);

          newYesBtn.addEventListener('click', handleDeleteConfirm);
          newNoBtn.addEventListener('click', handleDeleteCancel);
        }

        function handleDeleteConfirm(e) {
          e.preventDefault();
          closeDeleteModal();

          if (deleteCallback) {
            if (currentItemToDelete) {
              deleteCallback(currentItemToDelete);
            } else {
              deleteCallback();
            }
          }

          currentItemToDelete = null;
          deleteCallback = null;
        }

        function handleDeleteCancel(e) {
          e.preventDefault();
          closeDeleteModal();

          currentItemToDelete = null;
          deleteCallback = null;
        }

        function closeDeleteModal() {
          const modal = document.getElementById('deleteConfirmModal');
          modal.style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', function () {
          const closeBtn = document.getElementById('closeNotificationModalBtn');
          if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeNotification();
            });
          }

          const modal = document.getElementById('notificationModal');
          if (modal) {
            modal.addEventListener('click', function (e) {
              if (e.target === modal) {
                closeNotification();
              }
            });
          }

          const deleteModal = document.getElementById('deleteConfirmModal');
          if (deleteModal) {
            deleteModal.addEventListener('click', function (e) {
              if (e.target === deleteModal) {
                closeDeleteModal();
                currentItemToDelete = null;
                deleteCallback = null;
              }
            });
          }

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeNotification();
              closeViewModal();
              closeModal();

              const deleteModal = document.getElementById('deleteConfirmModal');
              if (deleteModal.style.display === 'flex') {
                closeDeleteModal();
                currentItemToDelete = null;
                deleteCallback = null;
              }
            }
          });

          loadEvents();
        });

        // ============================================================
        // FUNGSI UTAMA EVENT
        // ============================================================

        async function loadEvents() {
          try {
            const response = await fetch('/api/admin/events');
            const data = await response.json();

            if (data.success) {
              allEvents = data.data;
              updateStats(data.data);
              displayEvents(data.data);
              document.getElementById('totalEntries').textContent = data.data.length;
              document.getElementById('endEntry').textContent = Math.min(6, data.data.length);
            } else {
              showError(data.message || 'Gagal memuat event');
            }
          } catch (error) {
            console.error('Error loading events:', error);
            showError('Gagal memuat event');
          }
        }

        function updateStats(events) {
          const total = events.length;
          const active = events.filter(e => e.status === 'active').length;
          const draft = events.filter(e => e.status === 'draft').length;
          const free = events.filter(e => e.event_type === 'gratis').length;

          document.getElementById('totalEvents').textContent = total;
          document.getElementById('activeEvents').textContent = active;
          document.getElementById('draftEvents').textContent = draft;
          document.getElementById('freeEvents').textContent = free;
          document.getElementById('activeNow').textContent = active;
          document.getElementById('draftCount').textContent = draft;
          document.getElementById('freeCount').textContent = free;
        }

        function displayEvents(events) {
          const container = document.getElementById('eventsContainer');

          if (!events || events.length === 0) {
            container.innerHTML = `
              <div class="col-span-full text-center py-12">
                <div class="flex flex-col items-center">
                  <div class="relative">
                    <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-3 border-white/50 float-slow">
                      <i class="fas fa-calendar-times text-2xl text-emerald-300"></i>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                      <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                    </div>
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak Ada Event</h3>
                  <p class="text-sm text-emerald-700 font-medium max-w-md">Buat event pertama Anda untuk memulai.</p>
                  <button onclick="showCreateModal()" class="mt-5 px-5 py-2.5 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-sm font-extrabold shadow-lg flex items-center gap-2">
                    <i class="fas fa-plus text-xs"></i>
                    Buat Event
                  </button>
                </div>
              </div>
            `;
            return;
          }

          container.innerHTML = events.slice(0, 6).map(event => {
            const statusConfig = {
              'draft': { bg: 'gradient-draft', text: 'text-white', icon: 'fas fa-file-alt', badge: 'Draft' },
              'active': { bg: 'gradient-active', text: 'text-white', icon: 'fas fa-check-circle', badge: 'Aktif' },
              'inactive': { bg: 'gradient-inactive', text: 'text-white', icon: 'fas fa-times-circle', badge: 'Tidak Aktif' }
            }[event.status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-file', badge: 'Tidak Diketahui' };

            const typeConfig = {
              'gratis': { bg: 'gradient-gratis', text: 'text-white', icon: 'fas fa-gift', badge: 'Gratis' },
              'berbayar': { bg: 'gradient-berbayar', text: 'text-white', icon: 'fas fa-gem', badge: 'Berbayar' }
            }[event.event_type] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-calendar', badge: 'Tidak Diketahui' };

            const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

            return `
              <div class="glass-futuristic rounded-xl overflow-hidden group card-futuristic border border-white/50">
                <!-- Header with status -->
                <div class="px-4 py-3 border-b border-white/30 bg-white/20 backdrop-blur flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="px-2.5 py-1.5 rounded-lg text-[9px] font-extrabold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-1 border border-white/30">
                      <i class="${statusConfig.icon} text-[8px]"></i>
                      ${statusConfig.badge}
                    </span>
                    <span class="px-2.5 py-1.5 rounded-lg text-[9px] font-extrabold ${typeConfig.bg} ${typeConfig.text} flex items-center gap-1 border border-white/30">
                      <i class="${typeConfig.icon} text-[8px]"></i>
                      ${typeConfig.badge}
                    </span>
                  </div>
                  <button onclick="viewEvent(${event.id})" class="w-7 h-7 rounded-lg bg-white/60 hover:bg-white/80 text-emerald-700 transition-all duration-300 flex items-center justify-center border border-white/30">
                    <i class="fas fa-eye text-[10px]"></i>
                  </button>
                </div>

                <!-- Content -->
                <div class="p-4">
                  <h3 class="font-extrabold text-sm mb-1 text-gray-900 line-clamp-2">${event.title}</h3>
                  ${event.headline ? `<p class="text-[10px] font-semibold text-gray-700 mb-1 line-clamp-2">${event.headline}</p>` : ''}
                  <p class="text-[10px] font-medium text-gray-600 mb-3 line-clamp-2">${event.description || 'Tidak ada deskripsi'}</p>

                  <div class="space-y-2">
                    ${event.event_type === 'berbayar' ? `
                      <div class="flex items-center justify-between text-[10px] bg-white/40 backdrop-blur p-2 rounded-lg border border-white/30">
                        <span class="font-bold text-emerald-700">Harga Asli</span>
                        <span class="font-extrabold text-gray-900">Rp ${parseInt(event.price_original || 0).toLocaleString('id-ID')}</span>
                      </div>
                      <div class="flex items-center justify-between text-[10px] bg-white/40 backdrop-blur p-2 rounded-lg border border-white/30">
                        <span class="font-bold text-emerald-700">Harga Promo</span>
                        <span class="font-extrabold text-emerald-700">Rp ${parseInt(event.price_promo || 0).toLocaleString('id-ID')}</span>
                      </div>
                    ` : `
                      <div class="flex items-center justify-between text-[10px] bg-blue-50/80 backdrop-blur px-3 py-2 rounded-lg border border-blue-200/50">
                        <span class="font-extrabold text-blue-700 flex items-center gap-1">
                          <i class="fas fa-gift"></i>
                          Event Gratis
                        </span>
                        <span class="font-extrabold text-blue-600">Tidak Perlu Bayar</span>
                      </div>
                    `}
                    <div class="flex items-center justify-between text-[10px] pt-1 border-t border-white/30">
                      <span class="font-bold text-emerald-700 flex items-center gap-1">
                        <i class="fas fa-calendar-alt"></i>
                        Periode
                      </span>
                      <span class="font-extrabold text-gray-900">${startDate} - ${endDate}</span>
                    </div>
                  </div>
                </div>

                <!-- Footer -->
                <div class="px-4 py-3 bg-white/30 backdrop-blur border-t border-white/30 flex gap-2">
                  <button onclick="editEvent(${event.id})" class="flex-1 text-[9px] font-extrabold text-emerald-700 hover:text-emerald-800 py-2 rounded-lg hover:bg-white/60 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                    <i class="fas fa-edit text-[8px]"></i>
                    Edit
                  </button>
                  <button onclick="confirmDeleteEvent(${event.id})" class="flex-1 text-[9px] font-extrabold text-red-600 hover:text-red-700 py-2 rounded-lg hover:bg-white/60 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                    <i class="fas fa-trash text-[8px]"></i>
                    Hapus
                  </button>
                </div>
              </div>
            `;
          }).join('');
        }

        function confirmDeleteEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? event.title : 'event ini';

          showDeleteConfirm(
            `Apakah Anda yakin ingin menghapus "${eventName}"?`,
            async () => {
              await deleteEvent(eventId);
            },
            { id: eventId, name: eventName }
          );
        }

        async function deleteEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? event.title : 'event ini';

          try {
            const response = await fetch(`/api/admin/events/${eventId}`, {
              method: 'DELETE'
            });
            const data = await response.json();

            if (data.success) {
              showSuccess('Event berhasil dihapus');
              loadEvents();
            } else {
              showError('Gagal menghapus event: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error deleting event:', error);
            showError('Gagal menghapus event: ' + error.message);
          }
        }

        function viewEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          if (!event) {
            showError('Event tidak ditemukan');
            return;
          }

          document.getElementById('viewEventId').textContent = event.id;
          document.getElementById('viewEventTitle').textContent = event.title;
          document.getElementById('viewEventDescription').textContent = event.description || 'Tidak ada deskripsi';
          document.getElementById('viewEventSlug').textContent = event.slug || '-';
          document.getElementById('viewEventType').textContent = event.event_type === 'gratis' ? 'Gratis' : 'Berbayar';
          document.getElementById('viewEventStatus').textContent = event.status === 'active' ? 'Aktif' : event.status === 'draft' ? 'Draft' : 'Tidak Aktif';

          const statusConfig = {
            'draft': { bg: 'gradient-draft', text: 'text-white', icon: 'fas fa-file-alt', badge: 'Draft' },
            'active': { bg: 'gradient-active', text: 'text-white', icon: 'fas fa-check-circle', badge: 'Aktif' },
            'inactive': { bg: 'gradient-inactive', text: 'text-white', icon: 'fas fa-times-circle', badge: 'Tidak Aktif' }
          }[event.status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-file', badge: 'Tidak Diketahui' };

          const statusBadge = document.getElementById('viewEventStatusBadge');
          statusBadge.className = `px-3 py-1.5 rounded-lg text-[9px] font-extrabold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-1 border border-white/30`;
          statusBadge.innerHTML = `<i class="${statusConfig.icon}"></i>${statusConfig.badge}`;

          const typeConfig = {
            'gratis': { bg: 'gradient-gratis', text: 'text-white', icon: 'fas fa-gift', badge: 'Gratis' },
            'berbayar': { bg: 'gradient-berbayar', text: 'text-white', icon: 'fas fa-gem', badge: 'Berbayar' }
          }[event.event_type] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-calendar', badge: 'Tidak Diketahui' };

          const typeBadge = document.getElementById('viewEventTypeBadge');
          typeBadge.className = `px-3 py-1.5 rounded-lg text-[9px] font-extrabold ${typeConfig.bg} ${typeConfig.text} flex items-center gap-1 border border-white/30`;
          typeBadge.innerHTML = `<i class="${typeConfig.icon}"></i>${typeConfig.badge}`;

          const priceBadge = document.getElementById('viewEventPriceBadge');
          if (event.event_type === 'gratis') {
            priceBadge.className = 'px-3 py-1.5 rounded-lg text-[9px] font-extrabold gradient-gratis text-white flex items-center gap-1 border border-white/30';
            priceBadge.innerHTML = '<i class="fas fa-gift"></i>GRATIS';
          } else {
            const promoPrice = parseInt(event.price_promo || 0);
            priceBadge.className = 'px-3 py-1.5 rounded-lg text-[9px] font-extrabold gradient-berbayar text-white flex items-center gap-1 border border-white/30';
            priceBadge.innerHTML = `<i class="fas fa-tags"></i>Rp ${promoPrice.toLocaleString('id-ID')}`;
          }

          const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) : '-';
          const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) : '-';

          document.getElementById('viewStartDate').textContent = startDate;
          document.getElementById('viewEndDate').textContent = endDate;

          if (event.event_type === 'berbayar') {
            document.getElementById('viewPricingSection').classList.remove('hidden');
            document.getElementById('viewFreeEventSection').classList.add('hidden');

            document.getElementById('viewPriceOriginal').textContent = `Rp ${parseInt(event.price_original || 0).toLocaleString('id-ID')}`;
            document.getElementById('viewPricePromo').textContent = `Rp ${parseInt(event.price_promo || 0).toLocaleString('id-ID')}`;

            const paymentMethodsContainer = document.getElementById('viewPaymentMethods');
            paymentMethodsContainer.innerHTML = '';

            if (event.payment_methods) {
              const methods = event.payment_methods.split(',');
              methods.forEach(method => {
                const methodConfig = {
                  'cash': { icon: 'fas fa-money-bill-wave', text: 'Tunai', color: 'green' },
                  'transfer': { icon: 'fas fa-university', text: 'Transfer Bank', color: 'blue' }
                }[method] || { icon: 'fas fa-money-bill', text: method, color: 'gray' };

                const methodElement = document.createElement('div');
                methodElement.className = `flex items-center gap-1.5 text-[10px] font-medium text-${methodConfig.color}-600`;
                methodElement.innerHTML = `
                  <i class="${methodConfig.icon}"></i>
                  <span>${methodConfig.text}</span>
                `;
                paymentMethodsContainer.appendChild(methodElement);
              });
            }

            document.getElementById('viewBankName').textContent = event.bank_name || '-';
            document.getElementById('viewAccountName').textContent = event.bank_account_name || '-';
            document.getElementById('viewAccountNumber').textContent = event.bank_account_number || '-';
            document.getElementById('viewAccountHolder').textContent = event.account_holder_name || '-';
            document.getElementById('viewBankSection').classList.remove('hidden');
          } else {
            document.getElementById('viewPricingSection').classList.add('hidden');
            document.getElementById('viewFreeEventSection').classList.remove('hidden');
            document.getElementById('viewBankSection').classList.add('hidden');
          }

          document.getElementById('viewAdminWhatsApp').textContent = event.admin_whatsapp ? `+62 ${event.admin_whatsapp}` : '-';

          // hero media details
          const heroSection = document.getElementById('viewHeroSection');
          document.getElementById('viewHeadline').textContent = event.headline || '';
          document.getElementById('viewSubheadline').textContent = event.subheadline || '';
          const mediaEl = document.getElementById('viewHeroMedia');
          if (event.hero_media_type && event.hero_media_url) {
            mediaEl.textContent = `${event.hero_media_type.toUpperCase()}: ${event.hero_media_url}` + (event.hero_as_background ? ' (background)' : '');
          } else {
            mediaEl.textContent = '';
          }
          if (!(event.headline || event.subheadline || (event.hero_media_type && event.hero_media_url))) {
            heroSection.style.display = 'none';
          } else {
            heroSection.style.display = '';
          }

          // benefits
          const benefitsContainer = document.getElementById('viewBenefitsList');
          benefitsContainer.innerHTML = '';
          if (event.benefits && Array.isArray(event.benefits) && event.benefits.length) {
            event.benefits.forEach(b => {
              const li = document.createElement('li');
              li.textContent = b.benefit_text || b;
              benefitsContainer.appendChild(li);
            });
            benefitsContainer.parentElement.style.display = '';
          } else {
            benefitsContainer.parentElement.style.display = 'none';
          }

          // problem & pains
          document.getElementById('viewProblemTitle').textContent = event.problem_title || '';
          document.getElementById('viewProblemSubtitle').textContent = event.problem_subtitle || '';
          const painsContainer = document.getElementById('viewPainsList');
          painsContainer.innerHTML = '';
          if (event.pains && Array.isArray(event.pains) && event.pains.length) {
            event.pains.forEach(p => {
              const li = document.createElement('li');
              const title = p.pain_title || p.title || '';
              const desc = p.pain_description || p.description || '';
              li.innerHTML = title ? `<strong>${title}</strong>: ${desc}` : desc;
              painsContainer.appendChild(li);
            });
            painsContainer.parentElement.style.display = '';
          } else {
            painsContainer.parentElement.style.display = 'none';
          }


          // faqs
          const faqsContainer = document.getElementById('viewFaqsList');
          faqsContainer.innerHTML = '';
          if (event.faqs && Array.isArray(event.faqs) && event.faqs.length) {
            event.faqs.forEach(f => {
              const li = document.createElement('li');
              li.innerHTML = `<strong>${f.question}</strong><br>${f.answer}`;
              faqsContainer.appendChild(li);
            });
            faqsContainer.parentElement.style.display = '';
          } else {
            faqsContainer.parentElement.style.display = 'none';
          }

          document.getElementById('editFromViewBtn').setAttribute('onclick', `closeViewModal(); editEvent(${event.id})`);

          document.getElementById('viewModal').classList.remove('hidden');
          document.getElementById('viewModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeViewModal() {
          document.getElementById('viewModal').classList.add('hidden');
          document.getElementById('viewModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function editFromView() {
          closeViewModal();
          setTimeout(() => {
            const eventId = document.getElementById('viewEventId').textContent;
            editEvent(parseInt(eventId));
          }, 300);
        }

        function showCreateModal() {
          document.getElementById('modalTitleText').textContent = 'Buat Event';
          document.getElementById('submitButtonText').textContent = 'Buat';
          document.getElementById('eventForm').reset();
          document.getElementById('eventId').value = '';
          // clear hero fields
          document.getElementById('headline').value = '';
          document.getElementById('subheadline').value = '';
          document.getElementById('hero_media_type').value = '';
          document.getElementById('hero_media_url').value = '';
          document.getElementById('hero_as_background').checked = false;
          document.getElementById('account_holder_name').value = '';
          // clear dynamic lists
          document.getElementById('benefitsList').innerHTML = '';
          document.getElementById('painsList').innerHTML = '';
          document.getElementById('faqsList').innerHTML = '';
          document.getElementById('problemTitle').value = '';
          document.getElementById('problemSubtitle').value = '';
          // package logic removed
          toggleEventFields();
          document.getElementById('eventModal').classList.remove('hidden');
          document.getElementById('eventModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        async function editEvent(eventId) {
          // package list no longer required
          const event = allEvents.find(e => e.id === eventId);
          if (!event) {
            showError('Event tidak ditemukan');
            return;
          }

          document.getElementById('modalTitleText').textContent = 'Edit Event';
          document.getElementById('submitButtonText').textContent = 'Perbarui';
          document.getElementById('eventId').value = event.id;

          const eventTypeRadio = document.querySelector(`input[name="event_type"][value="${event.event_type}"]`);
          if (eventTypeRadio) {
            eventTypeRadio.checked = true;
            toggleEventFields();
          }

          // populate hero fields if present
          document.getElementById('headline').value = event.headline || '';
          document.getElementById('subheadline').value = event.subheadline || '';
          document.getElementById('hero_media_type').value = event.hero_media_type || '';
          document.getElementById('hero_media_url').value = event.hero_media_url || '';
          document.getElementById('hero_as_background').checked = !!event.hero_as_background;

          // populate benefits list
          document.getElementById('benefitsList').innerHTML = '';
          if (event.benefits && Array.isArray(event.benefits)) {
            event.benefits.forEach(b => addBenefit(b.benefit_text || b));
          }

          // problem section
          document.getElementById('problemTitle').value = event.problem_title || '';
          document.getElementById('problemSubtitle').value = event.problem_subtitle || '';
          document.getElementById('painsList').innerHTML = '';
          if (event.pains && Array.isArray(event.pains)) {
            event.pains.forEach(p => addPain(p.pain_title || p.title, p.pain_description || p.description));
          }

          // faqs
          document.getElementById('faqsList').innerHTML = '';
          if (event.faqs && Array.isArray(event.faqs)) {
            event.faqs.forEach(f => addFAQ(f.question || '', f.answer || ''));
          }

          // packages no longer applicable; event pricing handled separately

          if (event.event_type === 'gratis') {
            document.getElementById('title_gratis').value = event.title || '';
            document.getElementById('slug_gratis').value = event.slug || '';
            document.getElementById('description_gratis').value = event.description || '';
          } else {
            document.getElementById('title').value = event.title || '';
            document.getElementById('slug').value = event.slug || '';
            document.getElementById('description').value = event.description || '';
            document.getElementById('price_original').value = event.price_original || '';
            document.getElementById('price_promo').value = event.price_promo || '';
            document.getElementById('start_date').value = event.start_date || '';
            document.getElementById('end_date').value = event.end_date || '';
            document.getElementById('bank_name').value = event.bank_name || '';
            document.getElementById('bank_account_name').value = event.bank_account_name || '';
            document.getElementById('bank_account_number').value = event.bank_account_number || '';
            document.getElementById('account_holder_name').value = event.account_holder_name || '';

            document.querySelectorAll('.payment-method-checkbox').forEach(cb => {
              cb.checked = event.payment_methods && event.payment_methods.includes(cb.value);
            });
          }

          const statusRadio = document.querySelector(`input[name="status"][value="${event.status || 'draft'}"]`);
          if (statusRadio) {
            statusRadio.checked = true;
          }

          document.getElementById('admin_whatsapp').value = event.admin_whatsapp || '';

          document.getElementById('eventModal').classList.remove('hidden');
          document.getElementById('eventModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          document.getElementById('eventModal').classList.add('hidden');
          document.getElementById('eventModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function toggleEventFields() {
          const eventType = document.querySelector('input[name="event_type"]:checked').value;
          const gratisFields = document.getElementById('gratisFields');
          const berbayarFields = document.getElementById('berbayarFields');

          if (eventType === 'gratis') {
            gratisFields.classList.remove('hidden');
            berbayarFields.classList.add('hidden');

            document.getElementById('title_gratis').required = true;
            document.getElementById('slug_gratis').required = false;
            document.getElementById('description_gratis').required = false;

            document.getElementById('title').required = false;
            document.getElementById('slug').required = false;
            document.getElementById('description').required = false;
            document.getElementById('price_original').required = false;
            document.getElementById('price_promo').required = false;
            document.getElementById('start_date').required = false;
            document.getElementById('end_date').required = false;
          } else {
            gratisFields.classList.add('hidden');
            berbayarFields.classList.remove('hidden');

            document.getElementById('title_gratis').required = false;
            document.getElementById('slug_gratis').required = false;
            document.getElementById('description_gratis').required = false;

            document.getElementById('title').required = true;
            document.getElementById('slug').required = false;
            document.getElementById('description').required = false;
            document.getElementById('price_original').required = false;
            document.getElementById('price_promo').required = false;
            document.getElementById('start_date').required = true;
            document.getElementById('end_date').required = true;
          }
        }

        function generateSlug(title) {
          return title
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        // helper to dynamically add benefits/pains
        function addBenefit(text = '') {
          const list = document.getElementById('benefitsList');
          const idx = list.children.length;
          const div = document.createElement('div');
          div.className = 'flex items-center gap-2';
          div.innerHTML = `
            <input type="text" class="benefit-input flex-1 px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" placeholder="Teks manfaat" value="${text.replace(/"/g,'&quot;')}">
            <button type="button" class="text-red-500 text-xs" onclick="this.parentElement.remove()">&times;</button>
          `;
          list.appendChild(div);
        }

        function addPain(title = '', desc = '') {
          const list = document.getElementById('painsList');
          const div = document.createElement('div');
          div.className = 'space-y-1 pain-item';
          div.innerHTML = `
            <div class="flex items-center gap-2">
              <input type="text" class="pain-title flex-1 px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" placeholder="Judul pain" value="${title.replace(/"/g,'&quot;')}">
              <button type="button" class="text-red-500 text-xs" onclick="this.parentElement.parentElement.remove()">&times;</button>
            </div>
            <textarea class="pain-desc w-full px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" rows="2" placeholder="Deskripsi pain">${desc}</textarea>
          `;
          list.appendChild(div);
        }

        function addFAQ(question = '', answer = '') {
          const list = document.getElementById('faqsList');
          const div = document.createElement('div');
          div.className = 'space-y-2 faq-item';
          div.innerHTML = `
            <input type="text" class="faq-question w-full px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" placeholder="Pertanyaan" value="${question.replace(/"/g,'&quot;')}">
            <textarea class="faq-answer w-full px-2 py-1 bg-white/60 backdrop-blur border border-white/50 rounded-lg text-xs" rows="2" placeholder="Jawaban">${answer}</textarea>
            <button type="button" class="text-red-500 text-xs" onclick="this.parentElement.remove()">&times;</button>
          `;
          list.appendChild(div);
        }





        document.getElementById('eventForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const eventId = document.getElementById('eventId').value;
          const eventType = document.querySelector('input[name="event_type"]:checked').value;
          const status = document.querySelector('input[name="status"]:checked').value;

          let formData = {
            event_type: eventType,
            admin_whatsapp: document.getElementById('admin_whatsapp').value,
            status: status,
            headline: document.getElementById('headline').value,
            subheadline: document.getElementById('subheadline').value,
            hero_media_type: document.getElementById('hero_media_type').value,
            hero_media_url: document.getElementById('hero_media_url').value,
            hero_as_background: document.getElementById('hero_as_background').checked ? 1 : 0,
            account_holder_name: document.getElementById('account_holder_name') ? document.getElementById('account_holder_name').value : '',
            benefits: [],
            problemTitle: document.getElementById('problemTitle').value,
            problemSubtitle: document.getElementById('problemSubtitle').value,
            pains: [],
            faqs: []
          };

          // collect benefits
          document.querySelectorAll('.benefit-input').forEach(input => {
            if (input.value.trim()) formData.benefits.push(input.value.trim());
          });
          // collect pains
          document.querySelectorAll('.pain-item').forEach(item => {
            const titleEl = item.querySelector('.pain-title');
            const descEl = item.querySelector('.pain-desc');
            if (titleEl || descEl) {
              formData.pains.push({
                pain_title: titleEl ? titleEl.value.trim() : '',
                pain_description: descEl ? descEl.value.trim() : '',
              });
            }
          });

          // collect faqs
          document.querySelectorAll('.faq-item').forEach(item => {
            const qEl = item.querySelector('.faq-question');
            const aEl = item.querySelector('.faq-answer');
            if (qEl && aEl && qEl.value.trim() && aEl.value.trim()) {
              formData.faqs.push({ question: qEl.value.trim(), answer: aEl.value.trim() });
            }
          });

          if (eventType === 'gratis') {
            formData.title = document.getElementById('title_gratis').value;
            formData.slug = document.getElementById('slug_gratis').value || generateSlug(document.getElementById('title_gratis').value);
            formData.description = document.getElementById('description_gratis').value;
            formData.price_original = 0;
            formData.price_promo = 0;
            formData.payment_methods = '';
          } else {
            const paymentMethods = [];
            document.querySelectorAll('.payment-method-checkbox:checked').forEach(checkbox => {
              paymentMethods.push(checkbox.value);
            });

            formData.title = document.getElementById('title').value;
            formData.slug = document.getElementById('slug').value || generateSlug(document.getElementById('title').value);
            formData.description = document.getElementById('description').value;
            formData.price_original = document.getElementById('price_original').value || 0;
            formData.price_promo = document.getElementById('price_promo').value || 0;
            formData.payment_methods = paymentMethods.join(',');
            formData.bank_name = document.getElementById('bank_name').value;
            formData.bank_account_name = document.getElementById('bank_account_name').value;
            formData.bank_account_number = document.getElementById('bank_account_number').value;
            formData.account_holder_name = document.getElementById('account_holder_name').value;
            formData.start_date = document.getElementById('start_date').value;
            formData.end_date = document.getElementById('end_date').value;
          }

          try {
            const url = eventId ? `/api/admin/events/${eventId}` : '/api/admin/events';
            const method = eventId ? 'PUT' : 'POST';

            const response = await fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (data.success) {
              showSuccess(eventId ? 'Event berhasil diperbarui' : 'Event berhasil dibuat');
              closeModal();
              loadEvents();
            } else {
              showError('Gagal menyimpan event: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error saving event:', error);
            showError('Gagal menyimpan event: ' + error.message);
          }
        });

        document.querySelectorAll('input[name="event_type"]').forEach(radio => {
          radio.addEventListener('change', toggleEventFields);
        });

        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            filterEvents();
          }, 300);
        });

        document.getElementById('statusFilter').addEventListener('change', filterEvents);
        document.getElementById('typeFilter').addEventListener('change', filterEvents);

        function filterEvents() {
          const searchTerm = document.getElementById('searchInput').value.toLowerCase();
          const statusFilter = document.getElementById('statusFilter').value;
          const typeFilter = document.getElementById('typeFilter').value;

          const filtered = allEvents.filter(event => {
            const matchesSearch = !searchTerm ||
              event.title.toLowerCase().includes(searchTerm) ||
              (event.headline && event.headline.toLowerCase().includes(searchTerm)) ||
              (event.description && event.description.toLowerCase().includes(searchTerm));

            const matchesStatus = !statusFilter || event.status === statusFilter;
            const matchesType = !typeFilter || event.event_type === typeFilter;

            return matchesSearch && matchesStatus && matchesType;
          });

          displayEvents(filtered);
          document.getElementById('totalEntries').textContent = filtered.length;
          document.getElementById('endEntry').textContent = Math.min(6, filtered.length);
        }

        function clearFilters() {
          document.getElementById('searchInput').value = '';
          document.getElementById('statusFilter').value = '';
          document.getElementById('typeFilter').value = '';
          filterEvents();
        }

        document.getElementById('viewModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('viewModal')) {
            closeViewModal();
          }
        });

        document.getElementById('eventModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('eventModal')) {
            closeModal();
          }
        });

        setInterval(loadEvents, 60000);
      </script>
</body>

</html>