        async function editEvent(eventId) {
          // package list no longer required
          const event = allEvents.find(e => e.id === eventId);
          if (!event) {
            showError('Event tidak ditemukan');
            return;
          }
          if (Number(event.is_locked) === 1) {
            showError('Event terkunci dan tidak bisa diedit');
            return;
          }

          document.getElementById('modalTitleText').textContent = 'Edit Event';
          document.getElementById('submitButtonText').textContent = 'Perbarui Event';
          document.getElementById('eventId').value = event.id;

          // populate hero fields if present
          document.getElementById('headline').value = event.headline || '';
          document.getElementById('subheadline').value = event.subheadline || '';
          document.getElementById('hero_media_type').value = event.hero_media_type || '';
          document.getElementById('hero_media_url').value = event.hero_media_url || '';
          document.getElementById('hero_media_file').value = ''; // reset file input
          document.getElementById('hero_media_source').value = (event.hero_media_url && event.hero_media_url.startsWith('/uploads/')) ? 'upload' : 'url';
          toggleHeroInputMode();
          const previewEl = document.getElementById('hero_preview');
          if (event.hero_media_url) {
            previewEl.innerHTML = `<img src="${event.hero_media_url}" class="mt-2 max-h-24 rounded-lg">`;
          } else {
            previewEl.innerHTML = '';
          }
          document.getElementById('hero_as_background').checked = !!event.hero_as_background;

          // populate benefits list
          document.getElementById('benefitsList').innerHTML = '';
          if (event.benefits && Array.isArray(event.benefits)) {
            event.benefits.forEach(b => addBenefit(b.benefit_text || b));
          }

          // problem section
          document.getElementById('problemTitle').value = event.problem_title || '';
          document.getElementById('problemSubtitle').value = event.problem_subtitle || '';
          document.getElementById('painsList').innerHTML = '';
          if (event.pains && Array.isArray(event.pains)) {
            event.pains.forEach(p => addPain(p.pain_title || p.title, p.pain_description || p.description));
          }

          // solution section
          document.getElementById('solutionTitle').value = event.solution_title || '';
          document.getElementById('solutionSubtitle').value = event.solution_subtitle || '';
          document.getElementById('solutionsList').innerHTML = '';
          if (event.solutions && Array.isArray(event.solutions)) {
            event.solutions.forEach((s) => addSolution(s.solution_title || s.title || '', s.solution_description || s.description || ''));
          }

          // faqs
          document.getElementById('faqsList').innerHTML = '';
          if (event.faqs && Array.isArray(event.faqs)) {
            event.faqs.forEach(f => addFAQ(f.question || '', f.answer || ''));
          }

          // testimonials
          document.getElementById('testimonialsList').innerHTML = '';
          if (event.testimonials && Array.isArray(event.testimonials) && event.testimonials.length) {
            event.testimonials.forEach((t) => addTestimonial(t));
          } else {
            addTestimonial();
          }

          // activity docs
          document.getElementById('activityDocsList').innerHTML = '';
          if (event.activity_docs && Array.isArray(event.activity_docs) && event.activity_docs.length) {
            event.activity_docs.forEach((d) => addActivityDoc(d));
          } else {
            addActivityDoc();
          }

          // variants
          document.getElementById('variantsList').innerHTML = '';
          if (event.variants && Array.isArray(event.variants) && event.variants.length) {
            event.variants.forEach((v) => addVariant(v));
          } else {
            addVariant();
          }

          // periods per paket
          document.getElementById('periodsList').innerHTML = '';
          if (event.variants && Array.isArray(event.variants) && event.variants.length) {
            event.variants.forEach((v, idx) => addPeriod({
              start_date: v.start_date || (idx === 0 ? (event.start_date || '') : ''),
              end_date: v.end_date || (idx === 0 ? (event.end_date || '') : ''),
            }, false));
          } else {
            addPeriod({ start_date: event.start_date || '', end_date: event.end_date || '' }, false);
          }
          syncPeriodsWithVariants();
          document.getElementById('active_start_date').value = toDateInputValue(event.active_start_date || '');
          document.getElementById('active_end_date').value = toDateInputValue(event.active_end_date || '');

          const statusRadio = document.querySelector(`input[name="status"][value="${event.status || 'draft'}"]`);
          if (statusRadio) {
            statusRadio.checked = true;
          }

          document.getElementById('admin_whatsapp').value = event.admin_whatsapp || '';

          document.getElementById('eventModal').classList.remove('hidden');
          document.getElementById('eventModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

