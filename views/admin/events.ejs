                  <label class="cursor-pointer">
                    <input type="radio" name="status" value="inactive" class="peer sr-only">
                    <div
                      class="p-4 border-2 border-gray-200 rounded-xl hover:border-red-400 peer-checked:border-red-500 peer-checked:bg-red-50 transition-all text-center">
                      <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                        <i class="fas fa-times-circle text-red-600"></i>
                      </div>
                      <p class="font-medium text-gray-900">Inactive</p>
