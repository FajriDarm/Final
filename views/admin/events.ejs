                          </div>
                        </div>
                      </div>
                    </label>
                    <label class="cursor-pointer">
                      <input type="checkbox" value="transfer" class="peer sr-only payment-method-checkbox">
                      <div
                        class="px-6 py-4 border-2 border-gray-200 rounded-xl hover:border-green-300 peer-checked:border-green-500 peer-checked:bg-green-50 transition-all">
                        <div class="flex items-center gap-3">
