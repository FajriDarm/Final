      <!-- Modal Konfirmasi Hapus -->
      <div id="deleteConfirmModal" style="display:none;"
        class="fixed inset-0 flex items-center justify-center z-50 p-4">
        <div
          class="bg-white rounded-2xl shadow-2xl p-8 flex flex-col items-center text-center max-w-md w-full animate-fadeIn">
          <div class="mb-4">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center">
              <i class="fas fa-exclamation-triangle text-red-500 text-2xl"></i>
            </div>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">Konfirmasi Hapus</h2>
          <p class="text-gray-600 mb-4" id="deleteConfirmMessage">Apakah Anda yakin ingin menghapus item ini?</p>
          <p class="text-xs text-gray-400 mb-6">Aksi ini tidak dapat dibatalkan.</p>
          <div class="flex gap-4 w-full">
            <button id="deleteModalNo"
              class="flex-1 bg-gray-200 text-gray-700 py-3.5 px-6 rounded-xl font-medium hover:bg-gray-300 transition-all duration-200">
              Batal
            </button>
            <button id="deleteModalYes"
              class="flex-1 bg-gradient-to-r from-red-600 to-rose-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-red-700 hover:to-rose-700 transition-all duration-200">
              Ya, Hapus
            </button>
          </div>
        </div>
