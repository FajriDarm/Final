<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Events Management - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .type-radio:checked+label {
      border-color: #10b981;
      background-color: #f0fdf4;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }

    .modal-overlay {
      backdrop-filter: blur(4px);
      background: rgba(0, 0, 0, 0.6);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .data-cell {
      position: relative;
      overflow: hidden;
    }

    .data-cell::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.2), transparent);
    }

    .success-badge {
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        transform: translateY(-20px);
        opacity: 0;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50 min-h-screen">
  <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>
    <%- include('../sidebar/admin.ejs') %>

      <main class="ml-64 pt-16 min-h-screen pb-8">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar-alt text-white text-xl"></i>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900">Events Management</h1>
                  <p class="text-gray-600 mt-1">Kelola event promo dan penawaran khusus</p>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                <div class="flex items-center gap-2">
                  <i class="fas fa-calendar-alt text-green-600"></i>
                  <span class="text-sm font-medium text-gray-700">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                      day: 'numeric' }) %>
                  </span>
                </div>
              </div>
              <div class="px-4 py-2 gradient-primary rounded-lg shadow-lg text-white pulse-animation">
                <div class="flex items-center gap-2">
                  <i class="fas fa-bell"></i>
                  <span class="text-sm font-medium">Update Real-time</span>
                </div>
              </div>
              <button onclick="showCreateModal()"
                class="px-6 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all shadow-lg hover:shadow-xl flex items-center gap-2">
                <i class="fas fa-plus"></i>
                <span>Create Event</span>
              </button>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Events</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalEvents">-</p>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center gap-2 text-sm">
                  <span class="text-green-600 font-medium flex items-center">
                    <i class="fas fa-chart-line mr-1"></i>
                    <span id="monthGrowth">+12%</span>
                  </span>
                  <span class="text-gray-500">this month</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Active Events</p>
                  <p class="text-3xl font-bold text-green-600 mb-2" id="activeEvents">-</p>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-check-circle text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Running now</span>
                  <span class="font-medium text-green-700" id="activeNow">-</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Draft Events</p>
                  <p class="text-3xl font-bold text-amber-600 mb-2" id="draftEvents">-</p>
                </div>
                <div
                  class="w-14 h-14 bg-gradient-to-br from-amber-500 to-amber-600 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-file-edit text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">To publish</span>
                  <span class="font-medium text-amber-700" id="draftCount">-</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Free Events</p>
                  <p class="text-3xl font-bold text-blue-600 mb-2" id="freeEvents">-</p>
                </div>
                <div
                  class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-gift text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Free access</span>
                  <span class="font-medium text-blue-700" id="freeCount">-</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Search and Filter -->
          <div class="glass-card rounded-2xl p-6 border border-green-100 mb-8">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
              <div class="flex-1">
                <div class="relative">
                  <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <input type="text" id="searchInput" placeholder="Search events by title, description..."
                    class="w-full pl-12 pr-4 py-3 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm transition-all">
                </div>
              </div>

              <div class="flex flex-wrap gap-4">
                <div class="relative">
                  <i class="fas fa-filter absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <select id="statusFilter"
                    class="pl-12 pr-4 py-3 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm appearance-none min-w-[180px]">
                    <option value="">All Status</option>
                    <option value="draft">📝 Draft</option>
                    <option value="active">✅ Active</option>
                    <option value="inactive">❌ Inactive</option>
                  </select>
                </div>

                <div class="relative">
                  <i class="fas fa-tag absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <select id="typeFilter"
                    class="pl-12 pr-4 py-3 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm appearance-none min-w-[180px]">
                    <option value="">All Types</option>
                    <option value="gratis">🎁 Free</option>
                    <option value="berbayar">💎 Paid</option>
                  </select>
                </div>

                <button onclick="clearFilters()"
                  class="px-4 py-3 border border-green-200 text-green-700 hover:bg-green-50 rounded-xl transition-colors flex items-center gap-2">
                  <i class="fas fa-redo"></i>
                  <span class="font-medium">Clear</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Events Grid -->
          <div id="eventsContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <div class="col-span-full text-center py-12 text-gray-400">
              <div class="flex flex-col items-center">
                <div
                  class="w-16 h-16 gradient-primary rounded-full flex items-center justify-center mb-4 animate-pulse">
                  <i class="fas fa-spinner fa-spin text-2xl text-white"></i>
                </div>
                <p class="text-lg font-medium">Loading events...</p>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- View Event Modal -->
      <div id="viewModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col">
          <!-- Modal Header (rapi) -->
          <div class="gradient-primary px-6 py-3 flex items-center justify-between rounded-t-2xl">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-alt text-white text-lg"></i>
              </div>
              <h3 class="text-xl font-bold text-white">Event Details</h3>
            </div>
            <button onclick="closeViewModal()"
              class="w-9 h-9 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-colors">
              <i class="fas fa-times text-white text-lg"></i>
            </button>
          </div>

          <!-- Modal Body (kembali ke semula) -->
          <div class="p-6 overflow-y-auto flex-1 scrollbar-hide">
            <!-- Event Header -->
            <div class="flex flex-col md:flex-row md:items-start gap-6 mb-6">
              <div class="flex-1">
                <h2 id="viewEventTitle" class="text-2xl font-bold text-gray-900 mb-2"></h2>
                <div class="flex flex-wrap gap-2 mb-3">
                  <span id="viewEventStatusBadge" class="px-3 py-1.5 rounded-full text-xs font-semibold"></span>
                  <span id="viewEventTypeBadge" class="px-3 py-1.5 rounded-full text-xs font-semibold"></span>
                  <span id="viewEventPriceBadge" class="px-3 py-1.5 rounded-full text-xs font-semibold"></span>
                </div>
                <p id="viewEventDescription" class="text-gray-600 mb-4"></p>
              </div>
            </div>

            <!-- Event Information -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
              <!-- Left Column -->
              <div class="space-y-4">
                <div class="bg-gray-50 p-5 rounded-xl">
                  <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-info-circle text-green-600"></i>
                    Event Information
                  </h4>
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-500">Event ID</span>
                      <span id="viewEventId" class="font-semibold text-gray-900"></span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-500">Slug</span>
                      <span id="viewEventSlug" class="font-medium text-green-700"></span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-500">Event Type</span>
                      <span id="viewEventType" class="font-semibold text-gray-900"></span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-gray-500">Status</span>
                      <span id="viewEventStatus" class="font-semibold text-gray-900"></span>
                    </div>
                  </div>
                </div>

                <!-- Date Information -->
                <div class="bg-blue-50 p-5 rounded-xl">
                  <h4 class="text-sm font-semibold text-blue-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-calendar-alt text-blue-600"></i>
                    Date Information
                  </h4>
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-blue-600">Start Date</span>
                      <span id="viewStartDate" class="font-semibold text-blue-900"></span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-blue-600">End Date</span>
                      <span id="viewEndDate" class="font-semibold text-blue-900"></span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Column -->
              <div class="space-y-4">
                <!-- Pricing Information -->
                <div id="viewPricingSection" class="bg-green-50 p-5 rounded-xl">
                  <h4 class="text-sm font-semibold text-green-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-tags text-green-600"></i>
                    Pricing Information
                  </h4>
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-green-600">Original Price</span>
                      <span id="viewPriceOriginal" class="font-semibold text-green-900"></span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-green-600">Promo Price</span>
                      <span id="viewPricePromo" class="font-bold text-green-700 text-lg"></span>
                    </div>
                    <div class="pt-3 border-t border-green-200">
                      <span class="text-sm text-green-600">Payment Methods</span>
                      <div id="viewPaymentMethods" class="mt-2 space-y-2"></div>
                    </div>
                  </div>
                </div>

                <!-- Free Event Banner -->
                <div id="viewFreeEventSection" class="bg-blue-50 p-5 rounded-xl hidden">
                  <div class="flex items-center gap-3 mb-4">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                      <i class="fas fa-gift text-blue-600 text-xl"></i>
                    </div>
                    <div>
                      <h4 class="text-lg font-bold text-blue-900">Free Event</h4>
                      <p class="text-sm text-blue-700">No payment required</p>
                    </div>
                  </div>
                  <p class="text-sm text-blue-600">Participants can register for free without any payment process.</p>
                </div>

                <!-- Bank Information -->
                <div id="viewBankSection" class="bg-indigo-50 p-5 rounded-xl">
                  <h4 class="text-sm font-semibold text-indigo-700 mb-4 flex items-center gap-2">
                    <i class="fas fa-university text-indigo-600"></i>
                    Bank Information
                  </h4>
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-indigo-600">Bank Name</span>
                      <span id="viewBankName" class="font-medium text-indigo-900">-</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-indigo-600">Account Name</span>
                      <span id="viewAccountName" class="font-medium text-indigo-900">-</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-sm text-indigo-600">Account Number</span>
                      <span id="viewAccountNumber" class="font-medium text-indigo-900">-</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Contact Information -->
            <div class="bg-gradient-to-r from-green-50 to-emerald-50 p-6 rounded-2xl border border-green-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                  <i class="fab fa-whatsapp text-green-600"></i>
                </div>
                <div>
                  <h5 class="font-semibold text-green-900 text-lg">Admin Contact</h5>
                  <p class="text-sm text-green-700">For payment confirmation and participant communication</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm">
                  <i class="fas fa-phone text-green-600"></i>
                </div>
                <div>
                  <p class="text-sm text-gray-500">WhatsApp Number</p>
                  <p id="viewAdminWhatsApp" class="font-semibold text-gray-900">-</p>
                </div>
              </div>
            </div>

          </div>

          <!-- Modal Footer -->
          <div class="border-t border-gray-200 px-6 py-4 bg-gray-50 flex gap-4">
            <button onclick="closeViewModal()"
              class="flex-1 bg-gray-200 text-gray-700 py-3.5 rounded-xl hover:bg-gray-300 transition-all font-semibold flex items-center justify-center gap-2">
              <i class="fas fa-times"></i>
              Close
            </button>
            <button onclick="editFromView()" id="editFromViewBtn"
              class="flex-1 gradient-primary text-white py-3.5 rounded-xl hover:opacity-90 transition-all font-semibold shadow-lg flex items-center justify-center gap-2">
              <i class="fas fa-edit"></i>
              Edit Event
            </button>
          </div>
        </div>
      </div>

      <!-- Create/Edit Modal -->
      <div id="eventModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col">
          <!-- Modal Header -->
          <div class="gradient-primary px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-calendar-plus text-white text-lg"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white" id="modalTitle">
                  <span id="modalTitleText">Create Event</span>
                </h3>
                <p class="text-green-100 text-sm mt-1">Fill in the event details below</p>
              </div>
            </div>
            <button onclick="closeModal()"
              class="w-10 h-10 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-colors">
              <i class="fas fa-times text-white text-lg"></i>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="p-6 overflow-y-auto flex-1 scrollbar-hide">
            <form id="eventForm" class="space-y-6">
              <input type="hidden" id="eventId">

              <!-- Event Type Selection -->
              <div>
                <div class="flex items-center gap-2 mb-4">
                  <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-tags text-green-600"></i>
                  </div>
                  <h4 class="text-lg font-semibold text-gray-900">Tipe Event</h4>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <label class="relative cursor-pointer">
                    <input type="radio" name="event_type" value="gratis" class="peer sr-only type-radio">
                    <div
                      class="border-2 border-gray-200 rounded-2xl p-6 transition-all peer-checked:border-green-500 peer-checked:bg-gradient-to-br peer-checked:from-green-50 peer-checked:to-emerald-50 hover:border-green-300">
                      <div class="flex flex-col items-center text-center">
                        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                          <i class="fas fa-gift text-blue-600 text-2xl"></i>
                        </div>
                        <h5 class="font-bold text-gray-900 text-lg">Gratis</h5>
                        <p class="text-sm text-gray-600 mt-2">Event tanpa biaya pendaftaran</p>
                        <div class="mt-4 text-xs text-green-700 bg-green-50 px-3 py-1.5 rounded-full">
                          <i class="fas fa-check-circle mr-1"></i>
                          No payment required
                        </div>
                      </div>
                    </div>
                  </label>
                  <label class="relative cursor-pointer">
                    <input type="radio" name="event_type" value="berbayar" checked class="peer sr-only type-radio">
                    <div
                      class="border-2 border-gray-200 rounded-2xl p-6 transition-all peer-checked:border-green-500 peer-checked:bg-gradient-to-br peer-checked:from-green-50 peer-checked:to-emerald-50 hover:border-green-300">
                      <div class="flex flex-col items-center text-center">
                        <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mb-4">
                          <i class="fas fa-gem text-purple-600 text-2xl"></i>
                        </div>
                        <h5 class="font-bold text-gray-900 text-lg">Berbayar</h5>
                        <p class="text-sm text-gray-600 mt-2">Event dengan sistem pembayaran</p>
                        <div class="mt-4 text-xs text-purple-700 bg-purple-50 px-3 py-1.5 rounded-full">
                          <i class="fas fa-credit-card mr-1"></i>
                          Payment & bank info required
                        </div>
                      </div>
                    </div>
                  </label>
                </div>
              </div>

              <!-- Gratis Fields -->
              <div id="gratisFields"
                class="hidden space-y-4 bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-2xl border border-blue-200">
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                    <i class="fas fa-gift text-blue-600"></i>
                  </div>
                  <h5 class="font-semibold text-blue-900 text-lg">Info Event Gratis</h5>
                </div>
