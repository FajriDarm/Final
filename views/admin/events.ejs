        function generateSlug(title) {
          return title
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        function detectHeroMediaTypeFromUrl(url) {
          if (!url) return '';
          const lower = url.toLowerCase();
          if (/\.(mp4|webm|mov|m4v|avi)(\?|$)/.test(lower) || lower.includes('youtube.com') || lower.includes('youtu.be') || lower.includes('vimeo.com')) {
            return 'video';
          }
          return 'image';
        }

        function renderHeroPreview(url, type) {
          const preview = document.getElementById('hero_preview');
          if (!url) {
            preview.innerHTML = '';
            return;
          }

          if (type === 'video') {
            preview.innerHTML = `<a href="${url}" target="_blank" rel="noopener" class="text-xs text-emerald-700 underline">Preview video: ${url}</a>`;
            return;
          }

          preview.innerHTML = `<img src="${url}" class="mt-2 max-h-24 rounded-lg" alt="Hero preview" />`;
        }

        function toggleHeroInputMode() {
          const source = document.getElementById('hero_media_source').value;
          const urlWrapper = document.getElementById('hero_url_wrapper');
          const uploadWrapper = document.getElementById('hero_upload_wrapper');

          if (source === 'upload') {
            uploadWrapper.classList.remove('hidden');
            urlWrapper.classList.add('hidden');
          } else {
            uploadWrapper.classList.add('hidden');
            urlWrapper.classList.remove('hidden');
          }
        }

        async function uploadMediaFile(file) {
          const form = new FormData();
          form.append('hero', file);
          const resp = await fetch('/api/admin/events/upload-hero', {
            method: 'POST',
            body: form
          });
          let data = null;
          try {
            data = await resp.json();
          } catch (err) {
            data = null;
          }
          if (!resp.ok || !data?.success) {
            const message = data?.message || `HTTP ${resp.status} ${resp.statusText}`;
            throw new Error(message);
          }
          return data;
        }

        function createMediaSourceControl(prefix, initial = {}) {
          const wrapper = document.createElement('div');
          wrapper.className = 'grid grid-cols-1 md:grid-cols-4 gap-2 items-end';
          wrapper.innerHTML = `
            <div>
              <label class="block text-[10px] font-extrabold text-gray-700 mb-1">Sumber</label>
              <select class="${prefix}-source w-full px-2 py-1.5 bg-white/70 border border-white/60 rounded-lg text-xs">
                <option value="url">URL</option>
                <option value="upload">Upload File</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-extrabold text-gray-700 mb-1">Tipe</label>
              <select class="${prefix}-type w-full px-2 py-1.5 bg-white/70 border border-white/60 rounded-lg text-xs">
                <option value="image">Image</option>
                <option value="video">Video</option>
              </select>
            </div>
            <div class="${prefix}-url-wrap md:col-span-2">
              <label class="block text-[10px] font-extrabold text-gray-700 mb-1">URL</label>
              <input type="text" class="${prefix}-url w-full px-2 py-1.5 bg-white/70 border border-white/60 rounded-lg text-xs" placeholder="https://...">
            </div>
            <div class="${prefix}-upload-wrap hidden md:col-span-2">
              <label class="block text-[10px] font-extrabold text-gray-700 mb-1">Upload File</label>
              <input type="file" accept="image/*,video/*" class="${prefix}-file w-full text-xs" />
            </div>
            <div class="${prefix}-preview-wrap md:col-span-4 hidden bg-white/70 border border-white/60 rounded-lg p-2">
              <div class="${prefix}-preview text-xs"></div>
            </div>
          `;

          const sourceEl = wrapper.querySelector(`.${prefix}-source`);
          const typeEl = wrapper.querySelector(`.${prefix}-type`);
          const urlEl = wrapper.querySelector(`.${prefix}-url`);
          const fileEl = wrapper.querySelector(`.${prefix}-file`);
          const urlWrap = wrapper.querySelector(`.${prefix}-url-wrap`);
          const uploadWrap = wrapper.querySelector(`.${prefix}-upload-wrap`);
          const previewWrap = wrapper.querySelector(`.${prefix}-preview-wrap`);
          const previewEl = wrapper.querySelector(`.${prefix}-preview`);

          const toggleMode = () => {
            if (sourceEl.value === 'upload') {
              uploadWrap.classList.remove('hidden');
              urlWrap.classList.add('hidden');
            } else {
              uploadWrap.classList.add('hidden');
              urlWrap.classList.remove('hidden');
            }
            renderPreview();
          };

          const renderPreview = () => {
            const url = urlEl.value.trim();
            const type = typeEl.value || detectHeroMediaTypeFromUrl(url);
            if (!url) {
              previewEl.innerHTML = '';
              previewWrap.classList.add('hidden');
              return;
            }
            if (type === 'video') {
              previewEl.innerHTML = `
                <video src="${url}" controls class="w-full max-h-28 rounded"></video>
                <a href="${url}" target="_blank" rel="noopener" class="text-[10px] text-emerald-700 underline break-all">${url}</a>
              `;
            } else {
              previewEl.innerHTML = `
                <img src="${url}" class="max-h-24 rounded mb-1" alt="media preview" />
                <a href="${url}" target="_blank" rel="noopener" class="text-[10px] text-emerald-700 underline break-all">${url}</a>
              `;
            }
            previewWrap.classList.remove('hidden');
          };

          sourceEl.addEventListener('change', toggleMode);
          urlEl.addEventListener('input', () => {
            if (!typeEl.value && urlEl.value.trim()) {
              typeEl.value = detectHeroMediaTypeFromUrl(urlEl.value.trim());
            }
            renderPreview();
          });
          typeEl.addEventListener('change', renderPreview);
          fileEl.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            try {
              const data = await uploadMediaFile(file);
              if (data.success) {
                urlEl.value = data.url;
                typeEl.value = file.type.startsWith('video/') ? 'video' : 'image';
                sourceEl.value = 'upload';
                toggleMode();
                renderPreview();
              } else {
                showError('Upload gagal: ' + (data.message || ''));
              }
            } catch (err) {
              showError('Upload gagal: ' + err.message);
            }
          });

          sourceEl.value = initial.source || (initial.media_url && initial.media_url.startsWith('/uploads/') ? 'upload' : 'url');
          typeEl.value = initial.media_type || detectHeroMediaTypeFromUrl(initial.media_url || '') || 'image';
          urlEl.value = initial.media_url || '';
          toggleMode();
          renderPreview();

          return {
            wrapper,
            sourceEl,
            typeEl,
            urlEl,
            fileEl,
          };
        }

