      <script>
        let allEvents = [];
        let currentItemToDelete = null;
        let deleteCallback = null;

        // ============================================================
        // FUNGSI NOTIFIKASI MODAL
        // ============================================================

        /**
         * Tampilkan modal notifikasi
         */
        function showNotification(type, title, message, autoClose = true) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const titleEl = document.getElementById('notificationTitle');
          const messageEl = document.getElementById('notificationMessage');

          icon.className = 'notification-icon';

          switch (type) {
            case 'success':
              icon.classList.add('success');
              icon.innerHTML = `
            <svg class="notification-checkmark-svg" width="48" height="48" viewBox="0 0 48 48">
              <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
              <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          `;
              break;
            case 'error':
              icon.classList.add('error');
              icon.innerHTML = '<i class="fas fa-exclamation-triangle"></i>';
              break;
            case 'warning':
              icon.classList.add('warning');
              icon.innerHTML = '<i class="fas fa-exclamation-circle"></i>';
              break;
            case 'info':
              icon.classList.add('info');
              icon.innerHTML = '<i class="fas fa-info-circle"></i>';
              break;
            default:
              icon.classList.add('info');
              icon.innerHTML = '<i class="fas fa-info-circle"></i>';
          }

          titleEl.textContent = title;
          messageEl.textContent = message;
          modal.style.display = 'flex';

          if (autoClose) {
            setTimeout(() => {
              closeNotification();
            }, 4000);
          }
        }

        /**
         * Tutup modal notifikasi
         */
        function closeNotification() {
          document.getElementById('notificationModal').style.display = 'none';
        }

        /**
         * Tampilkan notifikasi sukses
         */
        function showSuccess(message) {
          showNotification('success', 'Sukses', message);
        }

        /**
         * Tampilkan notifikasi error
         */
        function showError(message) {
          showNotification('error', 'Error', message);
        }

        /**
         * Tampilkan modal konfirmasi hapus
         */
        function showDeleteConfirm(message, callback, itemData = null) {
          currentItemToDelete = itemData;
          deleteCallback = callback;

          // Set pesan konfirmasi
          const messageElement = document.getElementById('deleteConfirmMessage');
          if (messageElement) {
            messageElement.textContent = message;
          }

          // Tampilkan modal
          const modal = document.getElementById('deleteConfirmModal');
          modal.style.display = 'flex';

          // Setup event listener untuk tombol
          setupDeleteModalButtons();
        }

        /**
         * Setup tombol-tombol modal hapus
         */
        function setupDeleteModalButtons() {
          const yesBtn = document.getElementById('deleteModalYes');
          const noBtn = document.getElementById('deleteModalNo');

          // Clone tombol untuk menghapus event listener lama
          const newYesBtn = yesBtn.cloneNode(true);
          const newNoBtn = noBtn.cloneNode(true);

          // Ganti dengan yang baru
          yesBtn.parentNode.replaceChild(newYesBtn, yesBtn);
          noBtn.parentNode.replaceChild(newNoBtn, noBtn);

          // Tambahkan event listener baru
          newYesBtn.addEventListener('click', handleDeleteConfirm);
          newNoBtn.addEventListener('click', handleDeleteCancel);
        }

        /**
         * Handle konfirmasi hapus
         */
        function handleDeleteConfirm(e) {
          e.preventDefault();
          closeDeleteModal();

          if (deleteCallback) {
            // Panggil callback dengan data item jika ada
            if (currentItemToDelete) {
              deleteCallback(currentItemToDelete);
            } else {
              deleteCallback();
            }
          }

          // Reset
          currentItemToDelete = null;
          deleteCallback = null;
        }

        /**
         * Handle pembatalan hapus
         */
        function handleDeleteCancel(e) {
          e.preventDefault();
          closeDeleteModal();

          // Reset
          currentItemToDelete = null;
          deleteCallback = null;
        }

        /**
         * Tutup modal konfirmasi hapus
         */
        function closeDeleteModal() {
          const modal = document.getElementById('deleteConfirmModal');
          modal.style.display = 'none';
        }

        // Event listener untuk modal notifikasi
        document.addEventListener('DOMContentLoaded', function () {
          const closeBtn = document.getElementById('closeNotificationModalBtn');
          if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeNotification();
            });
          }

          // Tutup modal ketika klik di luar
          const modal = document.getElementById('notificationModal');
          if (modal) {
            modal.addEventListener('click', function (e) {
              if (e.target === modal) {
                closeNotification();
              }
            });
          }

          // Tutup modal konfirmasi hapus saat klik di luar
          const deleteModal = document.getElementById('deleteConfirmModal');
          if (deleteModal) {
            deleteModal.addEventListener('click', function (e) {
              if (e.target === deleteModal) {
                closeDeleteModal();
                currentItemToDelete = null;
                deleteCallback = null;
              }
            });
          }

          // Tutup modal dengan ESC key
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeNotification();
              closeViewModal();
              closeModal();

              // Tutup modal konfirmasi hapus jika terbuka
              const deleteModal = document.getElementById('deleteConfirmModal');
              if (deleteModal.style.display === 'flex') {
                closeDeleteModal();
                currentItemToDelete = null;
                deleteCallback = null;
              }
            }
          });
        });

        // ============================================================
        // FUNGSI UTAMA EVENT
        // ============================================================

        async function loadEvents() {
          try {
            const response = await fetch('/api/admin/events');
            const data = await response.json();

            if (data.success) {
              allEvents = data.data;
              updateStats(data.data);
              displayEvents(data.data);
            } else {
              showError(data.message || 'Gagal memuat event');
            }
          } catch (error) {
            console.error('Error loading events:', error);
            showError('Gagal memuat event');
          }
        }

        function updateStats(events) {
          const total = events.length;
          const active = events.filter(e => e.status === 'active').length;
          const draft = events.filter(e => e.status === 'draft').length;
          const free = events.filter(e => e.event_type === 'gratis').length;

          document.getElementById('totalEvents').textContent = total;
          document.getElementById('activeEvents').textContent = active;
          document.getElementById('draftEvents').textContent = draft;
          document.getElementById('freeEvents').textContent = free;
          document.getElementById('activeNow').textContent = active;
          document.getElementById('draftCount').textContent = draft;
          document.getElementById('freeCount').textContent = free;
        }

        function displayEvents(events) {
          const container = document.getElementById('eventsContainer');

          if (!events || events.length === 0) {
            container.innerHTML = `
          <div class="col-span-full text-center py-16">
            <div class="flex flex-col items-center">
              <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-calendar-times text-4xl text-gray-300"></i>
              </div>
              <h3 class="text-xl font-semibold text-gray-700 mb-2">Tidak Ada Event Ditemukan</h3>
              <p class="text-gray-500 max-w-md mx-auto">Buat event pertama Anda untuk memulai.</p>
              <button onclick="showCreateModal()" class="mt-6 px-6 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all font-semibold flex items-center gap-2">
                <i class="fas fa-plus"></i>
                Buat Event Pertama Anda
              </button>
            </div>
          </div>
        `;
            return;
          }

          container.innerHTML = events.map(event => {
            const statusConfig = {
              'draft': { bg: 'bg-yellow-100', text: 'text-yellow-800', icon: 'fas fa-file-alt', badge: 'Draft' },
              'active': { bg: 'bg-green-100', text: 'text-green-800', icon: 'fas fa-check-circle', badge: 'Aktif' },
              'inactive': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle', badge: 'Tidak Aktif' }
            }[event.status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-file', badge: 'Tidak Diketahui' };

            const typeConfig = {
              'gratis': { bg: 'bg-blue-500', text: 'text-blue-100', icon: 'fas fa-gift', badge: 'Gratis' },
              'berbayar': { bg: 'bg-purple-500', text: 'text-purple-100', icon: 'fas fa-gem', badge: 'Berbayar' }
            }[event.event_type] || { bg: 'bg-gray-500', text: 'text-gray-100', icon: 'fas fa-calendar', badge: 'Tidak Diketahui' };

            const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
            const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

            return `
          <div class="card-hover bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden group">
            <!-- Header with status and view button -->
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="px-3 py-1.5 rounded-full text-xs font-semibold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-2">
                  <i class="${statusConfig.icon}"></i>
                  ${statusConfig.badge}
                </span>
                <span class="px-3 py-1.5 rounded-full text-xs font-semibold ${typeConfig.bg} ${typeConfig.text} flex items-center gap-2">
                  <i class="${typeConfig.icon}"></i>
                  ${typeConfig.badge}
                </span>
              </div>
              <div class="flex gap-2">
                <button onclick="viewEvent(${event.id})" class="w-9 h-9 rounded-lg bg-blue-100 text-blue-600 hover:bg-blue-200 transition-colors flex items-center justify-center">
                  <i class="fas fa-arrow-up-right-from-square"></i>
                </button>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="font-bold text-lg mb-2 text-gray-900 line-clamp-2">${event.title}</h3>
              <p class="text-sm text-gray-600 mb-4 line-clamp-2">${event.description || 'Tidak ada deskripsi'}</p>

              <div class="space-y-3">
                ${event.event_type === 'berbayar' ? `
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 flex items-center gap-1">
                      <i class="fas fa-tag text-gray-400"></i>
                      Asli
                    </span>
                    <span class="font-semibold text-gray-900">Rp ${parseInt(event.price_original || 0).toLocaleString('id-ID')}</span>
                  </div>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 flex items-center gap-1">
                      <i class="fas fa-tags text-green-500"></i>
                      Promo
                    </span>
                    <span class="font-bold text-green-600">Rp ${parseInt(event.price_promo || 0).toLocaleString('id-ID')}</span>
                  </div>
                ` : `
                  <div class="flex items-center justify-between text-sm bg-blue-50 px-4 py-3 rounded-xl">
                    <span class="text-blue-700 font-semibold flex items-center gap-2">
                      <i class="fas fa-gift"></i>
                      Event Gratis
                    </span>
                    <span class="text-blue-600 font-bold">Tidak Perlu Pembayaran</span>
                  </div>
                `}
                <div class="flex items-center justify-between text-sm pt-2 border-t border-gray-100">
                  <span class="text-gray-500 flex items-center gap-1">
                    <i class="fas fa-calendar-alt text-purple-500"></i>
                    Periode
                  </span>
                  <span class="text-gray-900">${startDate} - ${endDate}</span>
                </div>
              </div>
            </div>

            <!-- Footer with edit and delete buttons -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex gap-2">
              <button onclick="editEvent(${event.id})" class="flex-1 text-sm font-semibold bg-blue-50 text-blue-600 hover:bg-blue-100 py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
                <i class="fas fa-edit"></i>
                Edit
              </button>
              <button onclick="confirmDeleteEvent(${event.id})" class="flex-1 text-sm font-semibold bg-red-50 text-red-600 hover:bg-red-100 py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
                <i class="fas fa-trash"></i>
                Hapus
              </button>
            </div>
          </div>
        `;
          }).join('');
        }

        function confirmDeleteEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? event.title : 'event ini';

          showDeleteConfirm(
            `Apakah Anda yakin ingin menghapus "${eventName}"?`,
            async () => {
              await deleteEvent(eventId);
            },
            { id: eventId, name: eventName }
          );
        }

        async function deleteEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          const eventName = event ? event.title : 'event ini';

          try {
            const response = await fetch(`/api/admin/events/${eventId}`, {
              method: 'DELETE'
            });
            const data = await response.json();

            if (data.success) {
              showSuccess('Event berhasil dihapus');
              loadEvents();
            } else {
              showError('Gagal menghapus event: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error deleting event:', error);
            showError('Gagal menghapus event: ' + error.message);
          }
        }

        function viewEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          if (!event) {
            showError('Event tidak ditemukan');
            return;
          }

          // Set informasi event
          document.getElementById('viewEventId').textContent = event.id;
          document.getElementById('viewEventTitle').textContent = event.title;
          document.getElementById('viewEventDescription').textContent = event.description || 'Tidak ada deskripsi';
          document.getElementById('viewEventSlug').textContent = event.slug || '-';
          document.getElementById('viewEventType').textContent = event.event_type === 'gratis' ? 'Gratis' : 'Berbayar';
          document.getElementById('viewEventStatus').textContent = event.status.charAt(0).toUpperCase() + event.status.slice(1);

          // Set badges
          const statusConfig = {
            'draft': { bg: 'bg-yellow-100', text: 'text-yellow-800', icon: 'fas fa-file-alt', badge: 'Draft' },
            'active': { bg: 'bg-green-100', text: 'text-green-800', icon: 'fas fa-check-circle', badge: 'Aktif' },
            'inactive': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle', badge: 'Tidak Aktif' }
          }[event.status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-file', badge: 'Tidak Diketahui' };

          const statusBadge = document.getElementById('viewEventStatusBadge');
          statusBadge.className = `px-3 py-1.5 rounded-full text-xs font-semibold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-2`;
          statusBadge.innerHTML = `<i class="${statusConfig.icon}"></i>${statusConfig.badge}`;

          const typeConfig = {
            'gratis': { bg: 'bg-blue-100', text: 'text-blue-800', icon: 'fas fa-gift', badge: 'Event Gratis' },
            'berbayar': { bg: 'bg-purple-100', text: 'text-purple-800', icon: 'fas fa-gem', badge: 'Event Berbayar' }
          }[event.event_type] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-calendar', badge: 'Tidak Diketahui' };

          const typeBadge = document.getElementById('viewEventTypeBadge');
          typeBadge.className = `px-3 py-1.5 rounded-full text-xs font-semibold ${typeConfig.bg} ${typeConfig.text} flex items-center gap-2`;
          typeBadge.innerHTML = `<i class="${typeConfig.icon}"></i>${typeConfig.badge}`;

          // Set price badge
          const priceBadge = document.getElementById('viewEventPriceBadge');
          if (event.event_type === 'gratis') {
            priceBadge.className = 'px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 flex items-center gap-2';
            priceBadge.innerHTML = '<i class="fas fa-gift"></i>GRATIS';
          } else {
            const promoPrice = parseInt(event.price_promo || 0);
            priceBadge.className = 'px-3 py-1.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 flex items-center gap-2';
            priceBadge.innerHTML = `<i class="fas fa-tags"></i>Rp ${promoPrice.toLocaleString('id-ID')}`;
          }

          // Set tanggal
          const startDate = event.start_date ? new Date(event.start_date).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) : '-';
          const endDate = event.end_date ? new Date(event.end_date).toLocaleDateString('id-ID', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) : '-';

          document.getElementById('viewStartDate').textContent = startDate;
          document.getElementById('viewEndDate').textContent = endDate;

          // Set informasi harga
          if (event.event_type === 'berbayar') {
            document.getElementById('viewPricingSection').classList.remove('hidden');
            document.getElementById('viewFreeEventSection').classList.add('hidden');

            document.getElementById('viewPriceOriginal').textContent = `Rp ${parseInt(event.price_original || 0).toLocaleString('id-ID')}`;
            document.getElementById('viewPricePromo').textContent = `Rp ${parseInt(event.price_promo || 0).toLocaleString('id-ID')}`;

            // Set metode pembayaran
            const paymentMethodsContainer = document.getElementById('viewPaymentMethods');
            paymentMethodsContainer.innerHTML = '';

            if (event.payment_methods) {
              const methods = event.payment_methods.split(',');
              methods.forEach(method => {
                const methodConfig = {
                  'cash': { icon: 'fas fa-money-bill-wave', text: 'Tunai', color: 'green' },
                  'transfer': { icon: 'fas fa-university', text: 'Transfer Bank', color: 'blue' }
                }[method] || { icon: 'fas fa-money-bill', text: method, color: 'gray' };

                const methodElement = document.createElement('div');
                methodElement.className = `flex items-center gap-2 text-sm text-${methodConfig.color}-600`;
                methodElement.innerHTML = `
              <i class="${methodConfig.icon}"></i>
              <span>${methodConfig.text}</span>
            `;
                paymentMethodsContainer.appendChild(methodElement);
              });
            }

            // Set informasi bank
            document.getElementById('viewBankName').textContent = event.bank_name || '-';
            document.getElementById('viewAccountName').textContent = event.bank_account_name || '-';
            document.getElementById('viewAccountNumber').textContent = event.bank_account_number || '-';
            document.getElementById('viewBankSection').classList.remove('hidden');
          } else {
            document.getElementById('viewPricingSection').classList.add('hidden');
            document.getElementById('viewFreeEventSection').classList.remove('hidden');
            document.getElementById('viewBankSection').classList.add('hidden');
          }

          // Set admin WhatsApp
          document.getElementById('viewAdminWhatsApp').textContent = event.admin_whatsapp ? `+62 ${event.admin_whatsapp}` : '-';

          // Set tombol edit ke event saat ini
          document.getElementById('editFromViewBtn').setAttribute('onclick', `closeViewModal(); editEvent(${event.id})`);

          // Tampilkan modal
          document.getElementById('viewModal').classList.remove('hidden');
          document.getElementById('viewModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeViewModal() {
          document.getElementById('viewModal').classList.add('hidden');
          document.getElementById('viewModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function editFromView() {
          closeViewModal();
          // Tunggu sebentar sebelum membuka modal edit untuk animasi yang halus
          setTimeout(() => {
            const eventId = document.getElementById('viewEventId').textContent;
            editEvent(parseInt(eventId));
          }, 300);
        }

        function showCreateModal() {
          document.getElementById('modalTitleText').textContent = 'Buat Event';
          document.getElementById('submitButtonText').textContent = 'Buat Event';
          document.getElementById('eventForm').reset();
          document.getElementById('eventId').value = '';
          // Pastikan field sesuai dengan tipe yang dipilih setelah reset
          toggleEventFields();
          document.getElementById('eventModal').classList.remove('hidden');
          document.getElementById('eventModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        async function editEvent(eventId) {
          const event = allEvents.find(e => e.id === eventId);
          if (!event) {
            showError('Event tidak ditemukan');
            return;
          }

          document.getElementById('modalTitleText').textContent = 'Edit Event';
          document.getElementById('submitButtonText').textContent = 'Perbarui Event';
          document.getElementById('eventId').value = event.id;

          // Set tipe event
          const eventTypeRadio = document.querySelector(`input[name="event_type"][value="${event.event_type}"]`);
          if (eventTypeRadio) {
            eventTypeRadio.checked = true;
            toggleEventFields();
          }

          // Isi form berdasarkan tipe event
          if (event.event_type === 'gratis') {
            document.getElementById('title_gratis').value = event.title || '';
            document.getElementById('slug_gratis').value = event.slug || '';
            document.getElementById('description_gratis').value = event.description || '';
          } else {
            document.getElementById('title').value = event.title || '';
            document.getElementById('slug').value = event.slug || '';
            document.getElementById('description').value = event.description || '';
            document.getElementById('price_original').value = event.price_original || '';
            document.getElementById('price_promo').value = event.price_promo || '';
            document.getElementById('start_date').value = event.start_date || '';
            document.getElementById('end_date').value = event.end_date || '';
            document.getElementById('bank_name').value = event.bank_name || '';
            document.getElementById('bank_account_name').value = event.bank_account_name || '';
            document.getElementById('bank_account_number').value = event.bank_account_number || '';

            // Set metode pembayaran
            document.querySelectorAll('.payment-method-checkbox').forEach(cb => {
              cb.checked = event.payment_methods && event.payment_methods.includes(cb.value);
            });
          }

          // Set status
          const statusRadio = document.querySelector(`input[name="status"][value="${event.status || 'draft'}"]`);
          if (statusRadio) {
            statusRadio.checked = true;
          }

          document.getElementById('admin_whatsapp').value = event.admin_whatsapp || '';

          document.getElementById('eventModal').classList.remove('hidden');
          document.getElementById('eventModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          document.getElementById('eventModal').classList.add('hidden');
          document.getElementById('eventModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function toggleEventFields() {
          const eventType = document.querySelector('input[name="event_type"]:checked').value;
          const gratisFields = document.getElementById('gratisFields');
          const berbayarFields = document.getElementById('berbayarFields');

          if (eventType === 'gratis') {
            // Tampilkan field gratis dan set atribut required
            gratisFields.classList.remove('hidden');
            berbayarFields.classList.add('hidden');

            document.getElementById('title_gratis').required = true;
            document.getElementById('slug_gratis').required = false;
            document.getElementById('description_gratis').required = false;

            document.getElementById('title').required = false;
            document.getElementById('slug').required = false;
            document.getElementById('description').required = false;
            document.getElementById('price_original').required = false;
            document.getElementById('price_promo').required = false;
            document.getElementById('start_date').required = false;
            document.getElementById('end_date').required = false;
          } else {
            // Tampilkan field berbayar dan set atribut required
            gratisFields.classList.add('hidden');
            berbayarFields.classList.remove('hidden');

            document.getElementById('title_gratis').required = false;
            document.getElementById('slug_gratis').required = false;
            document.getElementById('description_gratis').required = false;

            document.getElementById('title').required = true;
            document.getElementById('slug').required = false;
            document.getElementById('description').required = false;
            document.getElementById('price_original').required = false;
            document.getElementById('price_promo').required = false;
            document.getElementById('start_date').required = true;
            document.getElementById('end_date').required = true;
          }
        }

        function generateSlug(title) {
          return title
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        // Form submission
        document.getElementById('eventForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const eventId = document.getElementById('eventId').value;
          const eventType = document.querySelector('input[name="event_type"]:checked').value;
          const status = document.querySelector('input[name="status"]:checked').value;

          let formData = {
            event_type: eventType,
            admin_whatsapp: document.getElementById('admin_whatsapp').value,
            status: status
          };

          if (eventType === 'gratis') {
            formData.title = document.getElementById('title_gratis').value;
            formData.slug = document.getElementById('slug_gratis').value || generateSlug(document.getElementById('title_gratis').value);
            formData.description = document.getElementById('description_gratis').value;
            formData.price_original = 0;
            formData.price_promo = 0;
            formData.payment_methods = '';
          } else {
            // Ambil metode pembayaran yang dipilih
            const paymentMethods = [];
            document.querySelectorAll('.payment-method-checkbox:checked').forEach(checkbox => {
              paymentMethods.push(checkbox.value);
            });

            formData.title = document.getElementById('title').value;
            formData.slug = document.getElementById('slug').value || generateSlug(document.getElementById('title').value);
            formData.description = document.getElementById('description').value;
            formData.price_original = document.getElementById('price_original').value || 0;
            formData.price_promo = document.getElementById('price_promo').value || 0;
            formData.payment_methods = paymentMethods.join(',');
            formData.bank_name = document.getElementById('bank_name').value;
            formData.bank_account_name = document.getElementById('bank_account_name').value;
            formData.bank_account_number = document.getElementById('bank_account_number').value;
            formData.start_date = document.getElementById('start_date').value;
            formData.end_date = document.getElementById('end_date').value;
          }

          try {
            const url = eventId ? `/api/admin/events/${eventId}` : '/api/admin/events';
            const method = eventId ? 'PUT' : 'POST';

            const response = await fetch(url, {
              method: method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (data.success) {
              showSuccess(eventId ? 'Event berhasil diperbarui' : 'Event berhasil dibuat');
              closeModal();
              loadEvents();
            } else {
              showError('Gagal menyimpan event: ' + (data.message || 'Error tidak diketahui'));
            }
          } catch (error) {
            console.error('Error saving event:', error);
            showError('Gagal menyimpan event: ' + error.message);
          }
        });

        // Event type change handler
        document.querySelectorAll('input[name="event_type"]').forEach(radio => {
          radio.addEventListener('change', toggleEventFields);
        });

        // Search and filter handlers
        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            filterEvents();
          }, 300);
        });

        document.getElementById('statusFilter').addEventListener('change', filterEvents);
        document.getElementById('typeFilter').addEventListener('change', filterEvents);

        function filterEvents() {
          const searchTerm = document.getElementById('searchInput').value.toLowerCase();
          const statusFilter = document.getElementById('statusFilter').value;
          const typeFilter = document.getElementById('typeFilter').value;

          const filtered = allEvents.filter(event => {
            const matchesSearch = !searchTerm ||
              event.title.toLowerCase().includes(searchTerm) ||
              (event.description && event.description.toLowerCase().includes(searchTerm));

            const matchesStatus = !statusFilter || event.status === statusFilter;
            const matchesType = !typeFilter || event.event_type === typeFilter;

            return matchesSearch && matchesStatus && matchesType;
          });

          displayEvents(filtered);
        }

        function clearFilters() {
          document.getElementById('searchInput').value = '';
          document.getElementById('statusFilter').value = '';
          document.getElementById('typeFilter').value = '';
          filterEvents();
        }

        // Tutup modal pada backdrop click
        document.getElementById('viewModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('viewModal')) {
            closeViewModal();
          }
        });

        document.getElementById('eventModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('eventModal')) {
            closeModal();
          }
        });

        // Load events on page load
        document.addEventListener('DOMContentLoaded', loadEvents);

        // Auto-refresh setiap 60 detik
        setInterval(loadEvents, 60000);
      </script>
</body>

</html>