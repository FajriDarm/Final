<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log Aktivitas - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 0% 0%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 0%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 0% 100%, rgba(5, 150, 105, 0.03) 0%, transparent 50%),
        linear-gradient(145deg, #f0fdf4 0%, #ecfdf5 50%, #e6f7ec 100%);
    }

    /* Premium Glassmorphism */
    .glass-premium {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 20px 35px -10px rgba(0, 100, 0, 0.05),
        inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 15px 35px -10px rgba(16, 185, 129, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset,
        0 0 15px rgba(16, 185, 129, 0.05);
    }

    /* Premium Gradients */
    .gradient-primary {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      box-shadow: 0 10px 20px -8px rgba(16, 185, 129, 0.4);
    }

    .gradient-secondary {
      background: linear-gradient(165deg, #047857 0%, #059669 50%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(165deg, #065f46 0%, #047857 50%, #059669 100%);
    }

    /* Action Specific Gradients */
    .gradient-approve {
      background: linear-gradient(165deg, #10b981 0%, #059669 50%, #047857 100%);
    }

    .gradient-reject {
      background: linear-gradient(165deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
    }

    .gradient-create {
      background: linear-gradient(165deg, #8b5cf6 0%, #7c3aed 50%, #6d28d9 100%);
    }

    .gradient-update {
      background: linear-gradient(165deg, #f59e0b 0%, #d97706 50%, #b45309 100%);
    }

    .gradient-login {
      background: linear-gradient(165deg, #3b82f6 0%, #2563eb 50%, #1d4ed8 100%);
    }

    .gradient-transaction {
      background: linear-gradient(165deg, #10b981 0%, #059669 50%, #047857 100%);
    }

    .gradient-error {
      background: linear-gradient(165deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
    }

    .gradient-system {
      background: linear-gradient(165deg, #8b5cf6 0%, #7c3aed 50%, #6d28d9 100%);
    }

    .gradient-user {
      background: linear-gradient(165deg, #3b82f6 0%, #2563eb 50%, #1d4ed8 100%);
    }

    .gradient-affiliate {
      background: linear-gradient(165deg, #10b981 0%, #059669 50%, #047857 100%);
    }

    .gradient-event {
      background: linear-gradient(165deg, #f59e0b 0%, #d97706 50%, #b45309 100%);
    }

    .gradient-other {
      background: linear-gradient(165deg, #6b7280 0%, #4b5563 50%, #374151 100%);
    }

    /* Card Effects */
    .card-luxury {
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .card-luxury:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 30px 45px -15px rgba(16, 185, 129, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    /* Pulse Animation */
    .pulse-premium {
      animation: pulsePremium 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsePremium {

      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.2),
          0 0 0 0 rgba(16, 185, 129, 0.2);
      }

      50% {
        box-shadow: 0 0 0 15px rgba(16, 185, 129, 0),
          0 0 0 30px rgba(16, 185, 129, 0);
      }
    }

    /* Custom Scrollbar */
    .modern-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .modern-scrollbar::-webkit-scrollbar-track {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb {
      background: linear-gradient(145deg, #10b981, #059669);
      border-radius: 10px;
    }

    .modern-scrollbar::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(145deg, #059669, #047857);
    }

    /* Floating Animation */
    .float-slow {
      animation: float 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-10px);
      }
    }

    /* Shimmer Effect */
    .shimmer {
      position: relative;
      overflow: hidden;
    }

    .shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg,
          transparent,
          rgba(255, 255, 255, 0.3),
          transparent);
      animation: shimmer 5s infinite;
    }

    @keyframes shimmer {
      100% {
        left: 200%;
      }
    }

    /* Grid Background */
    .bg-grid-premium {
      background-image: linear-gradient(to right, rgba(16, 185, 129, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.05) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Neomorphism */
    .neomorph {
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 20px 20px 40px rgba(16, 185, 129, 0.05),
        -20px -20px 40px rgba(255, 255, 255, 0.8),
        inset 1px 1px 2px rgba(255, 255, 255, 0.8),
        inset -1px -1px 2px rgba(16, 185, 129, 0.05);
    }

    /* Slide In Animation */
    .animate-slide-in {
      animation: slideIn 0.6s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .animate-scale-in {
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* Animation Delays */
    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }

    /* Ultra Modern Glassmorphism */
    .glass-futuristic {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.5) inset;
    }

    /* Gradient Orbs */
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      z-index: 0;
      opacity: 0.4;
      animation: float-orb 10s ease-in-out infinite;
    }

    @keyframes float-orb {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      25% {
        transform: translate(10px, -15px) scale(1.1);
      }

      50% {
        transform: translate(-5px, -20px) scale(0.9);
      }

      75% {
        transform: translate(-15px, 5px) scale(1.05);
      }
    }

    /* Card Futuristic */
    .card-futuristic {
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
    }

    .card-futuristic::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.7s ease;
      z-index: 1;
      pointer-events: none;
    }

    .card-futuristic:hover::before {
      left: 100%;
    }

    .card-futuristic:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 30px 60px -15px rgba(16, 185, 129, 0.4);
    }

    /* Border Gradient */
    .border-gradient {
      border: double 1px transparent;
      background-image: linear-gradient(white, white),
        linear-gradient(135deg, #059669, #10b981, #34d399);
      background-origin: border-box;
      background-clip: padding-box, border-box;
    }

    /* Pulse Glow */
    @keyframes pulse-glow {

      0%,
      100% {
        opacity: 0.6;
        filter: blur(60px);
      }

      50% {
        opacity: 0.8;
        filter: blur(70px);
      }
    }

    .animate-pulse-glow {
      animation: pulse-glow 4s ease-in-out infinite;
    }

    /* Rotate Slow */
    @keyframes rotate-slow {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    .animate-rotate-slow {
      animation: rotate-slow 20s linear infinite;
    }

    /* Timeline Styles */
    .activity-timeline {
      position: relative;
    }

    .activity-timeline::before {
      content: '';
      position: absolute;
      left: 32px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, transparent, rgba(16, 185, 129, 0.3), rgba(16, 185, 129, 0.3), transparent);
    }

    .activity-dot {
      position: relative;
      z-index: 2;
      transition: all 0.3s ease;
    }

    .activity-dot:hover {
      transform: scale(1.2);
    }

    /* Type Badge */
    .type-badge {
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.5);
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(10px);
      color: #4b5563;
    }

    .type-badge:hover {
      background: rgba(255, 255, 255, 0.8);
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    }

    .type-badge.active {
      background: linear-gradient(165deg, #059669 0%, #10b981 50%, #34d399 100%);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Modal Overlay */
    .modal-overlay {
      backdrop-filter: blur(8px);
      background: rgba(0, 0, 0, 0.2);
    }

    /* Notification Toast */
    .notification-toast {
      position: fixed;
      top: 5rem;
      right: 1.5rem;
      z-index: 9999;
      animation: slideInRight 0.3s ease-out;
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(20px);
      }

      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    /* Fade In Animation */
    .fade-in {
      animation: fadeIn 0.4s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Line Clamp */
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</head>

<body class="bg-grid-premium relative overflow-x-hidden">
  <!-- Ultra Modern Decorative Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="orb w-[500px] h-[500px] bg-emerald-400 top-[-100px] left-[-100px] animate-pulse-glow"></div>
    <div
      class="orb w-[600px] h-[600px] bg-green-400 bottom-[-200px] right-[-200px] animate-pulse-glow animation-delay-2000">
    </div>
    <div
      class="orb w-[400px] h-[400px] bg-teal-400 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 animate-pulse-glow animation-delay-4000">
    </div>

    <!-- Animated Grid Lines -->
    <svg class="absolute top-0 left-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#10b981" stroke-width="0.5" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>

    <!-- Floating Particles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-emerald-400 rounded-full animate-ping opacity-30"></div>
    <div
      class="absolute top-3/4 right-1/3 w-3 h-3 bg-green-400 rounded-full animate-ping opacity-30 animation-delay-2000">
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-1.5 h-1.5 bg-teal-400 rounded-full animate-ping opacity-30 animation-delay-4000">
    </div>
  </div>

  <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>
    <%- include('../sidebar/admin.ejs') %>

      <main class="ml-64 pt-16 min-h-screen relative z-10 pb-8">
        <div class="p-6">
          <!-- Premium Page Header - Sesuai dengan dashboard -->
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between mb-8 animate-slide-in">
            <div class="mb-4 lg:mb-0">
              <div class="flex items-center gap-4">
                <div class="relative">
                  <div
                    class="w-16 h-16 gradient-primary rounded-xl flex items-center justify-center shadow-2xl float-slow">
                    <i class="fas fa-history text-white text-2xl"></i>
                  </div>
                  <div
                    class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                    <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h1
                      class="text-3xl font-extrabold bg-gradient-to-r from-emerald-900 via-green-800 to-emerald-900 bg-clip-text text-transparent">
                      Log Aktivitas
                    </h1>
                    <span
                      class="px-3 py-1 bg-gradient-to-r from-amber-400 to-yellow-500 rounded-lg text-white text-xs font-bold tracking-wider shadow-lg">
                      SUPER ADMIN
                    </span>
                  </div>
                  <p class="text-sm text-emerald-700 font-medium">Riwayat aktivitas sistem Affillink</p>
                </div>
              </div>
            </div>

            <!-- Premium Date & Live Status -->
            <div class="flex items-center gap-3">
              <div class="neomorph rounded-xl px-4 py-2.5 flex items-center gap-3">
                <div class="w-8 h-8 gradient-secondary rounded-lg flex items-center justify-center shadow-lg">
                  <i class="fas fa-calendar-alt text-white text-sm"></i>
                </div>
                <div>
                  <p class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider">Tanggal</p>
                  <p class="text-xs font-bold text-gray-800 whitespace-nowrap">
                    <%= new Date().toLocaleDateString('id-ID', { day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                  </p>
                </div>
              </div>

              <div class="gradient-primary rounded-xl px-4 py-2.5 flex items-center gap-3 shadow-xl relative shimmer">
                <div class="relative">
                  <i class="fas fa-bell text-white text-sm"></i>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full"></span>
                  <span class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></span>
                </div>
                <div>
                  <p class="text-[10px] text-white/90 font-bold uppercase tracking-wider">Live Status</p>
                  <p class="text-xs font-bold text-white">Updates Real-time</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Premium Filters and Controls - Ultra Modern -->
          <div class="glass-futuristic rounded-2xl p-5 border border-white/50 mb-7 relative overflow-hidden group">
            <div
              class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-emerald-200/20 to-green-300/20 rounded-full blur-3xl -mr-20 -mt-20">
            </div>
            <div
              class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-tr from-teal-200/20 to-emerald-200/20 rounded-full blur-3xl -ml-20 -mb-20">
            </div>

            <div class="relative z-10">
              <div class="space-y-4">
                <!-- First Row: Type Filters Premium -->
                <div>
                  <div class="flex flex-wrap gap-2">
                    <button onclick="filterByType('all')" id="filterAll"
                      class="type-badge active px-4 py-2.5 rounded-xl text-xs font-extrabold flex items-center gap-2 border border-white/30 shadow-lg">
                      <i class="fas fa-layer-group"></i>
                      <span>Semua Aktivitas</span>
                    </button>
                    <button onclick="filterByType('user')" id="filterUser"
                      class="type-badge px-4 py-2.5 rounded-xl text-xs font-extrabold flex items-center gap-2 border border-white/30">
                      <i class="fas fa-user text-blue-600"></i>
                      <span>Aksi Pengguna</span>
                    </button>
                    <button onclick="filterByType('system')" id="filterSystem"
                      class="type-badge px-4 py-2.5 rounded-xl text-xs font-extrabold flex items-center gap-2 border border-white/30">
                      <i class="fas fa-server text-purple-600"></i>
                      <span>Event Sistem</span>
                    </button>
                    <button onclick="filterByType('affiliate')" id="filterAffiliate"
                      class="type-badge px-4 py-2.5 rounded-xl text-xs font-extrabold flex items-center gap-2 border border-white/30">
                      <i class="fas fa-user-tie text-emerald-600"></i>
                      <span>Afiliasi</span>
                    </button>
                    <button onclick="filterByType('event')" id="filterEvent"
                      class="type-badge px-4 py-2.5 rounded-xl text-xs font-extrabold flex items-center gap-2 border border-white/30">
                      <i class="fas fa-calendar-alt text-amber-600"></i>
                      <span>Event</span>
                    </button>
                  </div>
                </div>

                <!-- Second Row: Search, Date Filter, and Clear Button -->
                <div class="flex flex-col sm:flex-row gap-3">
                  <!-- Search Input Premium -->
                  <div class="relative flex-1">
                    <i
                      class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-emerald-400 text-sm"></i>
                    <input type="text" id="searchInput"
                      placeholder="Cari aktivitas berdasarkan deskripsi atau pengguna..."
                      class="w-full pl-10 pr-4 py-2.5 bg-white/60 backdrop-blur border border-white/50 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 placeholder-gray-400 text-xs font-medium" />
                  </div>

                  <!-- Date Filter Premium -->
                  <div class="relative">
                    <i
                      class="fas fa-calendar-alt absolute left-4 top-1/2 transform -translate-y-1/2 text-emerald-400 text-sm"></i>
                    <input type="date" id="dateFilter"
                      class="pl-10 pr-4 py-2.5 bg-white/60 backdrop-blur border border-white/50 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-transparent text-gray-900 text-xs font-medium w-full sm:w-auto min-w-[160px]" />
                  </div>

                  <!-- Clear Button Premium -->
                  <button onclick="clearFilters()"
                    class="px-4 py-2.5 bg-white/60 backdrop-blur border border-white/50 text-emerald-700 hover:bg-white/80 rounded-xl transition-all duration-300 flex items-center gap-2 text-xs font-bold group h-[42px]">
                    <i class="fas fa-redo group-hover:rotate-180 transition-transform duration-500"></i>
                    <span>Hapus Filter</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Premium Activity Timeline -->
          <div class="glass-futuristic rounded-2xl border border-white/50 overflow-hidden">
            <!-- Timeline Header -->
            <div class="gradient-primary px-5 py-4 flex items-center justify-between border-b border-white/30">
              <div class="flex items-center gap-3">
                <div
                  class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                  <i class="fas fa-stream text-white"></i>
                </div>
                <div>
                  <h2 class="text-base font-extrabold text-white">Timeline Aktivitas</h2>
                  <p class="text-emerald-100 text-[10px] font-medium mt-0.5">Riwayat aktivitas real-time</p>
                </div>
              </div>
              <span
                class="px-3 py-1.5 bg-white/20 backdrop-blur rounded-lg text-white text-[9px] font-extrabold border border-white/30">
                <i class="fas fa-bolt mr-1"></i>
                Live
              </span>
            </div>

            <!-- Timeline Content -->
            <div class="p-5 bg-white/30 backdrop-blur">
              <div class="relative activity-timeline">
                <div id="activitiesContainer">
                  <div class="py-12 text-center">
                    <div class="flex flex-col items-center">
                      <div class="relative">
                        <div
                          class="w-20 h-20 gradient-primary rounded-full flex items-center justify-center mb-4 shadow-xl float-slow">
                          <i class="fas fa-spinner fa-spin text-2xl text-white"></i>
                        </div>
                        <div
                          class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                          <span class="w-2 h-2 bg-green-500 rounded-full pulse-premium"></span>
                        </div>
                      </div>
                      <p class="text-base font-extrabold text-gray-900 mb-1">Memuat aktivitas...</p>
                      <p class="text-xs text-emerald-700 font-medium">Mohon tunggu sebentar</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Timeline Footer Premium -->
            <div class="px-5 py-4 bg-white/30 backdrop-blur border-t border-white/30">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                  <span
                    class="text-[10px] font-medium text-emerald-700 bg-white/60 px-3 py-2 rounded-lg border border-white/60"
                    id="currentInfo">
                    Tidak ada aktivitas ditemukan
                  </span>
                </div>
                <button onclick="loadMore()" id="loadMoreBtn"
                  class="px-4 py-2 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-xs font-extrabold shadow-lg flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                  <i class="fas fa-arrow-down"></i>
                  Muat Lainnya
                </button>
              </div>
            </div>
          </div>

          <!-- Pagination Premium -->
          <div class="mt-8 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span
                class="text-[10px] font-medium text-emerald-700 bg-white/60 px-3 py-2 rounded-lg border border-white/60">
                Menampilkan <span id="startEntry">1</span> - <span id="endEntry">10</span> dari <span
                  id="totalEntries">0</span> aktivitas
              </span>
            </div>
            <div class="flex items-center gap-2">
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all disabled:opacity-50"
                disabled>
                <i class="fas fa-chevron-left text-xs"></i>
              </button>
              <button
                class="w-8 h-8 rounded-lg gradient-primary text-white flex items-center justify-center text-xs font-bold shadow-lg">1</button>
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all text-xs font-bold">2</button>
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all text-xs font-bold">3</button>
              <button
                class="w-8 h-8 rounded-lg bg-white/60 border border-white/50 flex items-center justify-center text-emerald-700 hover:bg-white/80 transition-all">
                <i class="fas fa-chevron-right text-xs"></i>
              </button>
            </div>
          </div>
        </div>
      </main>

      <!-- Premium Activity Detail Modal - Ultra Modern -->
      <div id="detailModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div
          class="bg-white/90 backdrop-blur-2xl rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col border border-white/50">
          <!-- Modal Header -->
          <div class="gradient-primary px-5 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur border border-white/30">
                <i class="fas fa-info-circle text-white text-sm"></i>
              </div>
              <div>
                <h3 class="text-base font-extrabold text-white">Detail Aktivitas</h3>
                <p class="text-emerald-100 text-xs mt-0.5">Informasi lengkap aktivitas</p>
              </div>
            </div>
            <button onclick="closeDetailModal()"
              class="w-9 h-9 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-all duration-300 border border-white/30">
              <i class="fas fa-times text-white text-sm"></i>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="p-5 overflow-y-auto flex-1 modern-scrollbar">
            <div id="detailContent" class="space-y-4">
              <!-- Content will be loaded dynamically -->
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="border-t border-white/30 px-5 py-3 bg-white/40 backdrop-blur flex gap-3">
            <button onclick="closeDetailModal()"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 rounded-lg transition-all duration-300 text-xs font-extrabold flex items-center justify-center gap-1 border border-white/60">
              <i class="fas fa-times"></i>
              Tutup
            </button>
          </div>
        </div>
      </div>

      <script>
        let allActivities = [];
        let currentFilter = 'all';
        let currentPage = 1;
        const pageSize = 10;
        let hasMore = true;

        // ============================================================
        // FUNGSI UTAMA
        // ============================================================

        async function loadActivityLogs(page = 1) {
          try {
            const response = await fetch(`/api/admin/activity-logs?page=${page}&limit=${pageSize}`);
            const data = await response.json();

            if (data.success) {
              if (page === 1) {
                allActivities = data.data;
              } else {
                allActivities = [...allActivities, ...data.data];
              }

              hasMore = data.data.length === pageSize;
              filterActivities();
              document.getElementById('totalEntries').textContent = allActivities.length;
              document.getElementById('endEntry').textContent = Math.min(page * pageSize, allActivities.length);
            }
          } catch (error) {
            console.error('Error loading activity logs:', error);
            showError('Gagal memuat log aktivitas');
          }
        }

        function filterActivities() {
          let filtered = [...allActivities];

          // Apply type filter
          if (currentFilter !== 'all') {
            filtered = filtered.filter(activity => {
              switch (currentFilter) {
                case 'user':
                  return activity.action.includes('login') ||
                    activity.action.includes('logout') ||
                    activity.action.includes('profile') ||
                    activity.action.includes('user_');
                case 'system':
                  return activity.action.includes('system') ||
                    activity.action.includes('cron') ||
                    activity.action.includes('backup') ||
                    activity.action.includes('error') ||
                    activity.action.includes('transaction');
                case 'affiliate':
                  return activity.action.includes('affiliate');
                case 'event':
                  return activity.action.includes('event');
                default:
                  return true;
              }
            });
          }

          // Apply date filter
          const dateFilter = document.getElementById('dateFilter').value;
          if (dateFilter) {
            filtered = filtered.filter(activity => {
              const activityDate = new Date(activity.created_at).toISOString().split('T')[0];
              return activityDate === dateFilter;
            });
          }

          // Apply search filter
          const search = document.getElementById('searchInput').value.toLowerCase();
          if (search) {
            filtered = filtered.filter(activity =>
              activity.description.toLowerCase().includes(search) ||
              (activity.user_name && activity.user_name.toLowerCase().includes(search)) ||
              activity.action.toLowerCase().includes(search)
            );
          }

          // Show only current page
          const displayActivities = filtered.slice(0, currentPage * pageSize);
          displayActivitiesList(displayActivities);

          // Update pagination
          const loadMoreBtn = document.getElementById('loadMoreBtn');
          loadMoreBtn.disabled = !hasMore || displayActivities.length >= filtered.length;

          // Update info text
          updateInfoText(filtered, displayActivities);
        }

        function updateInfoText(filtered, displayActivities) {
          const showing = displayActivities.length;
          const total = filtered.length;

          if (total === 0) {
            document.getElementById('currentInfo').textContent = 'Tidak ada aktivitas ditemukan';
          } else {
            document.getElementById('currentInfo').textContent = `Menampilkan ${showing} dari ${total} aktivitas`;
          }
        }

        function displayActivitiesList(activities) {
          const container = document.getElementById('activitiesContainer');

          if (!activities || activities.length === 0) {
            container.innerHTML = `
              <div class="py-12 text-center">
                <div class="flex flex-col items-center">
                  <div class="relative">
                    <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-6 border-4 border-white/50 float-slow">
                      <i class="fas fa-history text-3xl text-emerald-300"></i>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                      <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                    </div>
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak Ada Aktivitas</h3>
                  <p class="text-sm text-emerald-700 font-medium max-w-md">Tidak ada aktivitas yang sesuai dengan filter Anda.</p>
                  <button onclick="clearFilters()" class="mt-5 px-5 py-2.5 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-sm font-extrabold shadow-lg flex items-center gap-2">
                    <i class="fas fa-redo text-xs"></i>
                    Hapus Filter
                  </button>
                </div>
              </div>
            `;
            return;
          }

          const actionConfig = {
            'affiliate_approved': { icon: 'fa-user-check', gradient: 'gradient-approve', type: 'affiliate', label: 'Afiliasi Disetujui' },
            'affiliate_rejected': { icon: 'fa-user-times', gradient: 'gradient-reject', type: 'affiliate', label: 'Afiliasi Ditolak' },
            'affiliate_registration': { icon: 'fa-user-plus', gradient: 'gradient-affiliate', type: 'affiliate', label: 'Pendaftaran Afiliasi' },
            'event_created': { icon: 'fa-calendar-plus', gradient: 'gradient-create', type: 'event', label: 'Event Dibuat' },
            'event_updated': { icon: 'fa-calendar-check', gradient: 'gradient-update', type: 'event', label: 'Event Diperbarui' },
            'login': { icon: 'fa-sign-in-alt', gradient: 'gradient-login', type: 'user', label: 'Login Pengguna' },
            'logout': { icon: 'fa-sign-out-alt', gradient: 'gradient-user', type: 'user', label: 'Logout Pengguna' },
            'transaction': { icon: 'fa-dollar-sign', gradient: 'gradient-transaction', type: 'system', label: 'Transaksi' },
            'update': { icon: 'fa-sync-alt', gradient: 'gradient-update', type: 'system', label: 'Update Sistem' },
            'system_backup': { icon: 'fa-database', gradient: 'gradient-system', type: 'system', label: 'Backup Sistem' },
            'error': { icon: 'fa-exclamation-triangle', gradient: 'gradient-error', type: 'system', label: 'Error Sistem' }
          };

          container.innerHTML = activities.map((activity, index) => {
            const config = actionConfig[activity.action] || {
              icon: 'fa-bell',
              gradient: 'gradient-other',
              type: 'other',
              label: 'Aktivitas'
            };

            const timeAgo = getTimeAgo(activity.created_at);
            const date = new Date(activity.created_at);
            const time = date.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            const fullDate = date.toLocaleDateString('id-ID', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            });

            return `
              <div class="relative mb-5 pl-16 fade-in" style="animation-delay: ${index * 0.05}s">
                <!-- Timeline dot with gradient -->
                <div class="absolute left-8 activity-dot w-10 h-10 ${config.gradient} rounded-xl flex items-center justify-center shadow-lg border-2 border-white/30">
                  <i class="fas ${config.icon} text-white text-sm"></i>
                </div>

                <!-- Activity card premium -->
                <div class="glass-futuristic rounded-xl overflow-hidden hover:scale-[1.02] transition-all duration-300 border border-white/50">
                  <!-- Card header -->
                  <div class="px-4 py-3 border-b border-white/30 bg-white/20 backdrop-blur flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="px-3 py-1.5 rounded-lg text-[8px] font-extrabold ${config.gradient} text-white flex items-center gap-1 border border-white/30">
                        <i class="fas ${config.icon} text-[7px]"></i>
                        ${config.label}
                      </span>
                      <span class="text-[9px] font-medium text-emerald-700 bg-white/60 px-2 py-1 rounded-lg border border-white/60">${timeAgo}</span>
                    </div>
                    <button onclick="viewActivityDetail(${activity.id})" 
                      class="w-7 h-7 bg-white/60 hover:bg-white/80 rounded-lg flex items-center justify-center transition-all duration-300 border border-white/30"
                      title="Lihat detail">
                      <i class="fas fa-ellipsis-h text-emerald-700 text-xs"></i>
                    </button>
                  </div>

                  <!-- Card body -->
                  <div class="p-4 bg-white/30 backdrop-blur">
                    <p class="text-sm font-extrabold text-gray-900 mb-3 line-clamp-2">${activity.description}</p>
                    
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                      <div class="flex flex-wrap items-center gap-3">
                        <span class="text-emerald-700 font-bold flex items-center gap-1">
                          <i class="fas fa-user ${activity.user_name ? 'text-emerald-600' : 'text-gray-400'}"></i>
                          ${activity.user_name || 'Sistem'}
                        </span>
                        <span class="text-emerald-700 font-bold flex items-center gap-1">
                          <i class="fas fa-clock text-emerald-400"></i>
                          ${time}
                        </span>
                      </div>
                      <span class="text-[9px] font-medium text-gray-500 bg-white/60 px-2.5 py-1.5 rounded-lg border border-white/60">${fullDate}</span>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }

        function getTimeAgo(dateString) {
          const now = new Date();
          const date = new Date(dateString);
          const diffMs = now - date;
          const diffMins = Math.floor(diffMs / 60000);
          const diffHours = Math.floor(diffMins / 60);
          const diffDays = Math.floor(diffHours / 24);

          if (diffMins < 1) return 'Baru saja';
          if (diffMins < 60) return `${diffMins}m yang lalu`;
          if (diffHours < 24) return `${diffHours}j yang lalu`;
          if (diffDays < 7) return `${diffDays}h yang lalu`;

          return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
        }

        function filterByType(type) {
          currentFilter = type;
          currentPage = 1;

          // Update active filter buttons
          const filters = ['all', 'user', 'system', 'affiliate', 'event'];
          filters.forEach(filter => {
            const btn = document.getElementById(`filter${filter.charAt(0).toUpperCase() + filter.slice(1)}`);
            if (filter === type) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });

          filterActivities();
        }

        async function viewActivityDetail(activityId) {
          const activity = allActivities.find(a => a.id === activityId);
          if (activity) {
            const config = {
              'affiliate_approved': { icon: 'fa-user-check', gradient: 'gradient-approve', label: 'Afiliasi Disetujui' },
              'affiliate_rejected': { icon: 'fa-user-times', gradient: 'gradient-reject', label: 'Afiliasi Ditolak' },
              'affiliate_registration': { icon: 'fa-user-plus', gradient: 'gradient-affiliate', label: 'Pendaftaran Afiliasi' },
              'event_created': { icon: 'fa-calendar-plus', gradient: 'gradient-create', label: 'Event Dibuat' },
              'event_updated': { icon: 'fa-calendar-check', gradient: 'gradient-update', label: 'Event Diperbarui' },
              'login': { icon: 'fa-sign-in-alt', gradient: 'gradient-login', label: 'Login Pengguna' },
              'logout': { icon: 'fa-sign-out-alt', gradient: 'gradient-user', label: 'Logout Pengguna' },
              'transaction': { icon: 'fa-dollar-sign', gradient: 'gradient-transaction', label: 'Transaksi' },
              'system_backup': { icon: 'fa-database', gradient: 'gradient-system', label: 'Backup Sistem' },
              'error': { icon: 'fa-exclamation-triangle', gradient: 'gradient-error', label: 'Error Sistem' }
            }[activity.action] || { icon: 'fa-bell', gradient: 'gradient-other', label: 'Aktivitas' };

            const date = new Date(activity.created_at);
            const formattedDate = date.toLocaleDateString('id-ID', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            });

            const content = `
              <div class="space-y-4">
                <!-- Activity Header -->
                <div class="flex items-center gap-3 p-4 ${config.gradient} rounded-xl border border-white/30">
                  <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur border border-white/30">
                    <i class="fas ${config.icon} text-white text-xl"></i>
                  </div>
                  <div>
                    <h4 class="font-extrabold text-lg text-white">${config.label}</h4>
                    <p class="text-white/80 text-xs mt-0.5">ID Aktivitas: #${activity.id}</p>
                    <p class="text-white/70 text-[10px] mt-1">${formattedDate}</p>
                  </div>
                </div>

                <!-- Activity Details -->
                <div class="space-y-3 bg-white/60 backdrop-blur rounded-xl p-4 border border-white/60">
                  <div>
                    <label class="block text-[10px] font-extrabold text-emerald-800 mb-1.5 flex items-center gap-1">
                      <i class="fas fa-align-left text-emerald-600"></i>
                      Deskripsi
                    </label>
                    <div class="bg-white/60 backdrop-blur p-3 rounded-lg border border-white/60">
                      <p class="text-xs text-gray-900">${activity.description}</p>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-[10px] font-extrabold text-emerald-800 mb-1.5 flex items-center gap-1">
                        <i class="fas fa-user text-emerald-600"></i>
                        Pengguna
                      </label>
                      <div class="bg-white/60 backdrop-blur p-2.5 rounded-lg border border-white/60">
                        <p class="text-xs font-extrabold text-gray-900">${activity.user_name || 'Sistem'}</p>
                      </div>
                    </div>

                    <div>
                      <label class="block text-[10px] font-extrabold text-emerald-800 mb-1.5 flex items-center gap-1">
                        <i class="fas fa-cog text-emerald-600"></i>
                        Tipe Aksi
                      </label>
                      <div class="bg-white/60 backdrop-blur p-2.5 rounded-lg border border-white/60">
                        <span class="px-3 py-1.5 rounded-lg text-[8px] font-extrabold ${config.gradient} text-white border border-white/30 inline-block">
                          ${config.label}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div>
                    <label class="block text-[10px] font-extrabold text-emerald-800 mb-1.5 flex items-center gap-1">
                      <i class="fas fa-database text-emerald-600"></i>
                      Data Tambahan
                    </label>
                    <div class="bg-white/60 backdrop-blur p-3 rounded-lg border border-white/60">
                      <pre class="text-[9px] text-gray-700 whitespace-pre-wrap max-h-40 overflow-y-auto modern-scrollbar">${JSON.stringify(activity, null, 2)}</pre>
                    </div>
                  </div>
                </div>
              </div>
            `;

            document.getElementById('detailContent').innerHTML = content;
            document.getElementById('detailModal').classList.remove('hidden');
            document.getElementById('detailModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeDetailModal() {
          document.getElementById('detailModal').classList.add('hidden');
          document.getElementById('detailModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        // ============================================================
        // SEARCH AND FILTER HANDLERS
        // ============================================================

        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            currentPage = 1;
            filterActivities();
          }, 300);
        });

        document.getElementById('dateFilter').addEventListener('change', () => {
          currentPage = 1;
          filterActivities();
        });

        function clearFilters() {
          currentFilter = 'all';
          document.getElementById('dateFilter').value = '';
          document.getElementById('searchInput').value = '';

          // Reset filter buttons
          const filters = ['all', 'user', 'system', 'affiliate', 'event'];
          filters.forEach(filter => {
            const btn = document.getElementById(`filter${filter.charAt(0).toUpperCase() + filter.slice(1)}`);
            if (filter === 'all') {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });

          currentPage = 1;
          filterActivities();
        }

        function loadMore() {
          currentPage++;
          filterActivities();
        }

        // ============================================================
        // NOTIFICATION FUNCTIONS
        // ============================================================

        function showSuccess(message) {
          const toast = document.createElement('div');
          toast.className = 'notification-toast';
          toast.innerHTML = `
            <div class="glass-futuristic rounded-2xl p-4 shadow-2xl border-l-4 border-green-500 max-w-sm">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 gradient-approved rounded-xl flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-check-circle text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-gray-900 text-sm">Sukses!</p>
                  <p class="text-xs text-gray-600 mt-1">${message}</p>
                </div>
                <button onclick="this.parentElement.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
                  <i class="fas fa-times text-xs"></i>
                </button>
              </div>
            </div>
          `;
          document.body.appendChild(toast);

          setTimeout(() => {
            toast.remove();
          }, 5000);
        }

        function showError(message) {
          const toast = document.createElement('div');
          toast.className = 'notification-toast';
          toast.innerHTML = `
            <div class="glass-futuristic rounded-2xl p-4 shadow-2xl border-l-4 border-red-500 max-w-sm">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-gradient-to-r from-red-600 to-rose-600 rounded-xl flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-exclamation-triangle text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-gray-900 text-sm">Error!</p>
                  <p class="text-xs text-gray-600 mt-1">${message}</p>
                </div>
                <button onclick="this.parentElement.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
                  <i class="fas fa-times text-xs"></i>
                </button>
              </div>
            </div>
          `;
          document.body.appendChild(toast);

          setTimeout(() => {
            toast.remove();
          }, 5000);
        }

        // ============================================================
        // EVENT LISTENERS
        // ============================================================

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (!document.getElementById('detailModal').classList.contains('hidden')) {
              closeDetailModal();
            }
          }
        });

        document.getElementById('detailModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('detailModal')) {
            closeDetailModal();
          }
        });

        // Load logs on page load
        document.addEventListener('DOMContentLoaded', () => {
          loadActivityLogs(1);
        });
      </script>
</body>

</html>