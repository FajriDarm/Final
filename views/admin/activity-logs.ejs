<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activity Logs - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.1), 0 4px 6px -2px rgba(5, 150, 105, 0.05);
    }

    .modal-overlay {
      backdrop-filter: blur(4px);
      background: rgba(0, 0, 0, 0.6);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .success-badge {
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        transform: translateY(-20px);
        opacity: 0;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .activity-timeline::before {
      content: '';
      position: absolute;
      left: 24px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, transparent, #10b981, transparent);
    }

    .activity-dot {
      position: relative;
      z-index: 2;
    }

    .type-badge {
      transition: all 0.2s ease;
    }

    .type-badge:hover {
      transform: scale(1.05);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50 min-h-screen">
  <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>
    <%- include('../sidebar/admin.ejs') %>

      <main class="ml-64 pt-16 min-h-screen pb-8">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-history text-white text-xl"></i>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900">Activity Logs</h1>
                  <p class="text-gray-600 mt-1">Riwayat aktivitas sistem Affillink</p>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                <div class="flex items-center gap-2">
                  <i class="fas fa-calendar-alt text-green-600"></i>
                  <span class="text-sm font-medium text-gray-700">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                      day: 'numeric' }) %>
                  </span>
                </div>
              </div>
              <div class="px-4 py-2 gradient-primary rounded-lg shadow-lg text-white pulse-animation">
                <div class="flex items-center gap-2">
                  <i class="fas fa-bell"></i>
                  <span class="text-sm font-medium">Real-time Activity</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Activities</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalActivities">-</p>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-history text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center gap-2 text-sm">
                  <span class="text-green-600 font-medium flex items-center">
                    <i class="fas fa-chart-line mr-1"></i>
                    <span id="todayActivities">+24</span>
                  </span>
                  <span class="text-gray-500">today</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">System Events</p>
                  <p class="text-3xl font-bold text-green-600 mb-2" id="systemActivities">-</p>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-server text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Critical events</span>
                  <span class="font-medium text-green-700" id="criticalEvents">-</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">User Actions</p>
                  <p class="text-3xl font-bold text-blue-600 mb-2" id="userActivities">-</p>
                </div>
                <div
                  class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-users text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Active users</span>
                  <span class="font-medium text-blue-700" id="activeUsers">-</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Error Logs</p>
                  <p class="text-3xl font-bold text-red-600 mb-2" id="errorLogs">-</p>
                </div>
                <div
                  class="w-14 h-14 bg-gradient-to-br from-red-500 to-red-600 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-exclamation-triangle text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Last 24h</span>
                  <span class="font-medium text-red-700" id="recentErrors">-</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Filters and Controls -->
          <div class="glass-card rounded-2xl p-6 border border-green-100 mb-8">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 flex-wrap">
              <!-- Type Filters -->
              <div class="flex flex-wrap gap-3 items-center">
                <button onclick="filterByType('all')" id="filterAll"
                  class="px-4 py-2 rounded-xl font-medium gradient-primary text-white flex items-center gap-2 type-badge">
                  <i class="fas fa-layer-group"></i>
                  <span>All Activities</span>
                </button>
                <button onclick="filterByType('user')" id="filterUser"
                  class="px-4 py-2 rounded-xl font-medium bg-blue-50 text-blue-600 hover:bg-blue-100 flex items-center gap-2 type-badge">
                  <i class="fas fa-user"></i>
                  <span>User Actions</span>
                </button>
                <button onclick="filterByType('system')" id="filterSystem"
                  class="px-4 py-2 rounded-xl font-medium bg-purple-50 text-purple-600 hover:bg-purple-100 flex items-center gap-2 type-badge">
                  <i class="fas fa-server"></i>
                  <span>System Events</span>
                </button>
                <button onclick="filterByType('affiliate')" id="filterAffiliate"
                  class="px-4 py-2 rounded-xl font-medium bg-green-50 text-green-600 hover:bg-green-100 flex items-center gap-2 type-badge">
                  <i class="fas fa-user-tie"></i>
                  <span>Affiliate</span>
                </button>
                <button onclick="filterByType('event')" id="filterEvent"
                  class="px-4 py-2 rounded-xl font-medium bg-amber-50 text-amber-600 hover:bg-amber-100 flex items-center gap-2 type-badge">
                  <i class="fas fa-calendar-alt"></i>
                  <span>Events</span>
                </button>
              </div>

              <!-- Date Filter, Search, and Clear in a row -->
              <div class="flex flex-wrap items-center gap-3 min-w-[320px]">
                <div class="relative">
                  <i class="fas fa-calendar-alt absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <input type="date" id="dateFilter"
                    class="pl-10 pr-3 py-2 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm min-w-[140px]" />
                </div>
                <div class="relative flex-1 min-w-[180px]">
                  <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <input type="text" id="searchInput" placeholder="Search activities..."
                    class="pl-10 pr-3 py-2 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm w-full" />
                </div>
                <button onclick="clearFilters()"
                  class="px-4 py-2 border border-green-200 text-green-700 hover:bg-green-50 rounded-xl transition-colors flex items-center gap-2 h-[40px]">
                  <i class="fas fa-redo"></i>
                  <span class="font-medium">Clear</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Activity Timeline -->
          <div class="glass-card rounded-2xl border border-green-100 overflow-hidden">
            <!-- Timeline Header -->
            <div class="px-6 py-4 gradient-primary">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-lg font-semibold text-white">Activity Timeline</h2>
                  <p class="text-green-100 text-sm mt-1" id="timelineCount">Loading activities...</p>
                </div>
              </div>
            </div>

            <!-- Timeline Content -->
            <div class="p-6">
              <div class="relative activity-timeline">
                <div id="activitiesContainer">
                  <div class="py-12 text-center text-gray-400">
                    <div class="flex flex-col items-center">
                      <div
                        class="w-16 h-16 gradient-primary rounded-full flex items-center justify-center mb-4 animate-pulse">
                        <i class="fas fa-spinner fa-spin text-2xl text-white"></i>
                      </div>
                      <p class="text-lg font-medium">Loading activities...</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Timeline Footer -->
            <div class="px-6 py-4 bg-green-50 border-t border-green-100">
              <div class="flex items-center justify-between text-sm">
                <div class="text-gray-600">
                  Showing <span id="showingCount">0</span> of <span id="totalCount">0</span> activities
                </div>
                <div class="flex items-center gap-4">
                  <button onclick="loadMore()" id="loadMoreBtn"
                    class="text-green-700 hover:text-green-800 font-medium flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="fas fa-arrow-down"></i>
                    Load More
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- Activity Detail Modal -->
      <div id="detailModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col">
          <!-- Modal Header -->
          <div class="gradient-primary px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-info-circle text-white"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Activity Details</h3>
                <p class="text-green-100 text-sm mt-1">Complete activity information</p>
              </div>
            </div>
            <button onclick="closeDetailModal()"
              class="w-10 h-10 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-colors">
              <i class="fas fa-times text-white"></i>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="p-6 overflow-y-auto flex-1 scrollbar-hide">
            <div id="detailContent">
              <!-- Content will be loaded dynamically -->
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="border-t border-gray-200 px-6 py-4 bg-gray-50 flex gap-4">
            <button onclick="closeDetailModal()"
              class="flex-1 bg-gray-200 text-gray-700 py-3.5 rounded-xl hover:bg-gray-300 transition-all font-semibold flex items-center justify-center gap-2">
              <i class="fas fa-times"></i>
              Close
            </button>
          </div>
        </div>
      </div>

      <script>
        let allActivities = [];
        let currentFilter = 'all';
        let currentPage = 1;
        const pageSize = 10;
        let hasMore = true;

        async function loadActivityLogs(page = 1) {
          try {
            const response = await fetch(`/api/admin/activity-logs?page=${page}&limit=${pageSize}`);
            const data = await response.json();

            if (data.success) {
              if (page === 1) {
                allActivities = data.data;
              } else {
                allActivities = [...allActivities, ...data.data];
              }

              hasMore = data.data.length === pageSize;
              updateStats(allActivities);
              filterActivities();
              updateActivityCounts();
            }
          } catch (error) {
            console.error('Error loading activity logs:', error);
            showError('Failed to load activity logs');
          }
        }

        function updateStats(activities) {
          const total = activities.length;
          const today = activities.filter(a => {
            const today = new Date().toDateString();
            const activityDate = new Date(a.created_at).toDateString();
            return today === activityDate;
          }).length;

          const systemActivities = activities.filter(a =>
            a.action.includes('system') || a.action.includes('cron') || a.action.includes('backup')
          ).length;

          const userActivities = activities.filter(a =>
            a.action.includes('login') || a.action.includes('logout') || a.action.includes('profile')
          ).length;

          const errorLogs = activities.filter(a =>
            a.action.includes('error') || a.action.includes('failed') || a.action.includes('rejected')
          ).length;

          document.getElementById('totalActivities').textContent = total;
          document.getElementById('todayActivities').textContent = `+${today}`;
          document.getElementById('systemActivities').textContent = systemActivities;
          document.getElementById('userActivities').textContent = userActivities;
          document.getElementById('errorLogs').textContent = errorLogs;

          document.getElementById('criticalEvents').textContent = Math.floor(systemActivities * 0.1);
          document.getElementById('activeUsers').textContent = Math.floor(userActivities * 0.5);
          document.getElementById('recentErrors').textContent = errorLogs;
        }

        function filterActivities() {
          let filtered = [...allActivities];

          // Apply type filter
          if (currentFilter !== 'all') {
            filtered = filtered.filter(activity => {
              switch (currentFilter) {
                case 'user':
                  return activity.action.includes('login') ||
                    activity.action.includes('logout') ||
                    activity.action.includes('profile') ||
                    activity.action.includes('user_');
                case 'system':
                  return activity.action.includes('system') ||
                    activity.action.includes('cron') ||
                    activity.action.includes('backup');
                case 'affiliate':
                  return activity.action.includes('affiliate');
                case 'event':
                  return activity.action.includes('event');
                default:
                  return true;
              }
            });
          }

          // Apply date filter
          const dateFilter = document.getElementById('dateFilter').value;
          if (dateFilter) {
            filtered = filtered.filter(activity => {
              const activityDate = new Date(activity.created_at).toISOString().split('T')[0];
              return activityDate === dateFilter;
            });
          }

          // Apply search filter
          const search = document.getElementById('searchInput').value.toLowerCase();
          if (search) {
            filtered = filtered.filter(activity =>
              activity.description.toLowerCase().includes(search) ||
              (activity.user_name && activity.user_name.toLowerCase().includes(search)) ||
              activity.action.toLowerCase().includes(search)
            );
          }

          // Show only first page
          const displayActivities = filtered.slice(0, currentPage * pageSize);
          displayActivitiesList(displayActivities);

          // Update pagination
          document.getElementById('loadMoreBtn').disabled = !hasMore || displayActivities.length >= filtered.length;
        }

        function displayActivitiesList(activities) {
          const container = document.getElementById('activitiesContainer');

          if (!activities || activities.length === 0) {
            container.innerHTML = `
          <div class="py-16 text-center">
            <div class="flex flex-col items-center">
              <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-history text-4xl text-gray-300"></i>
              </div>
              <h3 class="text-xl font-semibold text-gray-700 mb-2">No Activities Found</h3>
              <p class="text-gray-500 max-w-md mx-auto">No activities match your current filter.</p>
              <button onclick="clearFilters()" class="mt-6 px-6 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all font-semibold flex items-center gap-2">
                <i class="fas fa-redo"></i>
                Clear Filters
              </button>
            </div>
          </div>
        `;
            return;
          }

          const actionConfig = {
            'affiliate_approved': { icon: 'fa-user-check', color: 'text-green-500', bg: 'bg-green-100', type: 'affiliate', label: 'Affiliate Approved' },
            'affiliate_rejected': { icon: 'fa-user-times', color: 'text-red-500', bg: 'bg-red-100', type: 'affiliate', label: 'Affiliate Rejected' },
            'affiliate_registration': { icon: 'fa-user-plus', color: 'text-blue-500', bg: 'bg-blue-100', type: 'affiliate', label: 'Affiliate Registration' },
            'event_created': { icon: 'fa-calendar-plus', color: 'text-purple-500', bg: 'bg-purple-100', type: 'event', label: 'Event Created' },
            'event_updated': { icon: 'fa-calendar-check', color: 'text-indigo-500', bg: 'bg-indigo-100', type: 'event', label: 'Event Updated' },
            'login': { icon: 'fa-sign-in-alt', color: 'text-green-500', bg: 'bg-green-100', type: 'user', label: 'User Login' },
            'logout': { icon: 'fa-sign-out-alt', color: 'text-gray-500', bg: 'bg-gray-100', type: 'user', label: 'User Logout' },
            'transaction': { icon: 'fa-dollar-sign', color: 'text-amber-500', bg: 'bg-amber-100', type: 'system', label: 'Transaction' },
            'update': { icon: 'fa-sync-alt', color: 'text-indigo-500', bg: 'bg-indigo-100', type: 'system', label: 'System Update' },
            'system_backup': { icon: 'fa-database', color: 'text-blue-500', bg: 'bg-blue-100', type: 'system', label: 'System Backup' },
            'error': { icon: 'fa-exclamation-triangle', color: 'text-red-500', bg: 'bg-red-100', type: 'system', label: 'System Error' }
          };

          container.innerHTML = activities.map((activity, index) => {
            const config = actionConfig[activity.action] || {
              icon: 'fa-bell',
              color: 'text-gray-500',
              bg: 'bg-gray-100',
              type: 'system',
              label: 'Activity'
            };

            const timeAgo = getTimeAgo(activity.created_at);
            const date = new Date(activity.created_at);
            const time = date.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            const fullDate = date.toLocaleDateString('id-ID', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            });

            return `
          <div class="relative mb-6 pl-14 card-hover">
            <!-- Timeline dot -->
            <div class="absolute left-6 activity-dot w-8 h-8 ${config.bg} rounded-full flex items-center justify-center">
              <i class="fas ${config.icon} ${config.color} text-sm"></i>
            </div>

            <!-- Activity card -->
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-green-300 transition-colors">
              <!-- Card header -->
              <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-1 rounded-full text-xs font-medium ${config.bg} ${config.color} flex items-center gap-1 type-badge">
                    <i class="fas ${config.icon} text-xs"></i>
                    ${config.label}
                  </span>
                  <span class="text-xs text-gray-500">${timeAgo}</span>
                </div>
                <button onclick="viewActivityDetail(${activity.id})" 
                  class="text-gray-400 hover:text-gray-600 transition-colors" title="View details">
                  <i class="fas fa-ellipsis-h"></i>
                </button>
              </div>

              <!-- Card body -->
              <div class="p-4">
                <p class="text-gray-900 font-medium mb-2">${activity.description}</p>
                
                <div class="flex items-center justify-between text-sm">
                  <div class="flex items-center gap-4">
                    <span class="text-gray-600 flex items-center gap-1">
                      <i class="fas fa-user ${activity.user_name ? 'text-green-500' : 'text-gray-400'}"></i>
                      ${activity.user_name || 'System'}
                    </span>
                    <span class="text-gray-600 flex items-center gap-1">
                      <i class="fas fa-clock text-gray-400"></i>
                      ${time}
                    </span>
                  </div>
                  <span class="text-xs text-gray-500">${fullDate}</span>
                </div>
              </div>
            </div>
          </div>
        `;
          }).join('');
        }

        function getTimeAgo(dateString) {
          const now = new Date();
          const date = new Date(dateString);
          const diffMs = now - date;
          const diffMins = Math.floor(diffMs / 60000);
          const diffHours = Math.floor(diffMins / 60);
          const diffDays = Math.floor(diffHours / 24);

          if (diffMins < 1) return 'Just now';
          if (diffMins < 60) return `${diffMins}m ago`;
          if (diffHours < 24) return `${diffHours}h ago`;
          if (diffDays < 7) return `${diffDays}d ago`;

          return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
        }

        function filterByType(type) {
          currentFilter = type;

          // Update active filter button
          const filters = ['all', 'user', 'system', 'affiliate', 'event'];
          filters.forEach(filter => {
            const btn = document.getElementById(`filter${filter.charAt(0).toUpperCase() + filter.slice(1)}`);
            if (filter === type) {
              btn.className = 'px-4 py-2 rounded-xl font-medium gradient-primary text-white flex items-center gap-2 type-badge';
            } else {
              btn.className = `px-4 py-2 rounded-xl font-medium ${getFilterColor(filter)} flex items-center gap-2 type-badge`;
            }
          });

          currentPage = 1;
          filterActivities();
        }

        function getFilterColor(type) {
          switch (type) {
            case 'user': return 'bg-blue-50 text-blue-600 hover:bg-blue-100';
            case 'system': return 'bg-purple-50 text-purple-600 hover:bg-purple-100';
            case 'affiliate': return 'bg-green-50 text-green-600 hover:bg-green-100';
            case 'event': return 'bg-amber-50 text-amber-600 hover:bg-amber-100';
            default: return 'bg-gray-50 text-gray-600 hover:bg-gray-100';
          }
        }

        function updateActivityCounts() {
          const filtered = getFilteredActivities();
          const showing = Math.min(filtered.length, currentPage * pageSize);
          const total = filtered.length;

          document.getElementById('timelineCount').textContent = `Showing ${showing} activities`;
          document.getElementById('showingCount').textContent = showing;
          document.getElementById('totalCount').textContent = total;
        }

        function getFilteredActivities() {
          let filtered = [...allActivities];

          if (currentFilter !== 'all') {
            filtered = filtered.filter(activity => {
              switch (currentFilter) {
                case 'user':
                  return activity.action.includes('login') ||
                    activity.action.includes('logout') ||
                    activity.action.includes('profile');
                case 'system':
                  return activity.action.includes('system') ||
                    activity.action.includes('cron') ||
                    activity.action.includes('backup');
                case 'affiliate':
                  return activity.action.includes('affiliate');
                case 'event':
                  return activity.action.includes('event');
                default:
                  return true;
              }
            });
          }

          const dateFilter = document.getElementById('dateFilter').value;
          if (dateFilter) {
            filtered = filtered.filter(activity => {
              const activityDate = new Date(activity.created_at).toISOString().split('T')[0];
              return activityDate === dateFilter;
            });
          }

          const search = document.getElementById('searchInput').value.toLowerCase();
          if (search) {
            filtered = filtered.filter(activity =>
              activity.description.toLowerCase().includes(search) ||
              (activity.user_name && activity.user_name.toLowerCase().includes(search))
            );
          }

          return filtered;
        }

        async function viewActivityDetail(activityId) {
          const activity = allActivities.find(a => a.id === activityId);
          if (activity) {
            const config = {
              'affiliate_approved': { icon: 'fa-user-check', color: 'text-green-500', bg: 'bg-green-100', label: 'Affiliate Approved' },
              'affiliate_rejected': { icon: 'fa-user-times', color: 'text-red-500', bg: 'bg-red-100', label: 'Affiliate Rejected' },
              'affiliate_registration': { icon: 'fa-user-plus', color: 'text-blue-500', bg: 'bg-blue-100', label: 'Affiliate Registration' },
              'event_created': { icon: 'fa-calendar-plus', color: 'text-purple-500', bg: 'bg-purple-100', label: 'Event Created' },
              'login': { icon: 'fa-sign-in-alt', color: 'text-green-500', bg: 'bg-green-100', label: 'User Login' },
              'logout': { icon: 'fa-sign-out-alt', color: 'text-gray-500', bg: 'bg-gray-100', label: 'User Logout' }
            }[activity.action] || { icon: 'fa-bell', color: 'text-gray-500', bg: 'bg-gray-100', label: 'Activity' };

            const date = new Date(activity.created_at);
            const formattedDate = date.toLocaleDateString('id-ID', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            });

            const content = `
          <div class="space-y-6">
            <!-- Activity Header -->
            <div class="flex items-center gap-4 p-4 bg-gradient-to-r from-gray-50 to-gray-100 rounded-2xl border border-gray-200">
              <div class="w-16 h-16 ${config.bg} rounded-xl flex items-center justify-center">
                <i class="fas ${config.icon} ${config.color} text-2xl"></i>
              </div>
              <div>
                <h4 class="font-bold text-lg text-gray-900">${config.label}</h4>
                <p class="text-gray-600">Activity ID: #${activity.id}</p>
                <p class="text-sm text-gray-500 mt-1">${formattedDate}</p>
              </div>
            </div>

            <!-- Activity Details -->
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  <i class="fas fa-align-left mr-2 text-green-600"></i>
                  Description
                </label>
                <div class="bg-gray-50 p-4 rounded-xl">
                  <p class="text-gray-900">${activity.description}</p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-user mr-2 text-green-600"></i>
                    User
                  </label>
                  <div class="bg-gray-50 p-3 rounded-xl">
                    <p class="text-gray-900">${activity.user_name || 'System'}</p>
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-cog mr-2 text-green-600"></i>
                    Action Type
                  </label>
                  <div class="bg-gray-50 p-3 rounded-xl">
                    <span class="px-3 py-1 rounded-full text-xs font-medium ${config.bg} ${config.color}">
                      ${config.label}
                    </span>
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  <i class="fas fa-database mr-2 text-green-600"></i>
                  Additional Data
                </label>
                <div class="bg-gray-50 p-4 rounded-xl">
                  <pre class="text-sm text-gray-600 whitespace-pre-wrap">${JSON.stringify(activity, null, 2)}</pre>
                </div>
              </div>
            </div>
          </div>
        `;

            document.getElementById('detailContent').innerHTML = content;
            document.getElementById('detailModal').classList.remove('hidden');
            document.getElementById('detailModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeDetailModal() {
          document.getElementById('detailModal').classList.add('hidden');
          document.getElementById('detailModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        // Search and filter handlers
        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            currentPage = 1;
            filterActivities();
          }, 300);
        });

        document.getElementById('dateFilter').addEventListener('change', () => {
          currentPage = 1;
          filterActivities();
        });

        function clearFilters() {
          currentFilter = 'all';
          document.getElementById('dateFilter').value = '';
          document.getElementById('searchInput').value = '';

          // Reset filter buttons
          const filters = ['all', 'user', 'system', 'affiliate', 'event'];
          filters.forEach(filter => {
            const btn = document.getElementById(`filter${filter.charAt(0).toUpperCase() + filter.slice(1)}`);
            if (filter === 'all') {
              btn.className = 'px-4 py-2 rounded-xl font-medium gradient-primary text-white flex items-center gap-2 type-badge';
            } else {
              btn.className = `px-4 py-2 rounded-xl font-medium ${getFilterColor(filter)} flex items-center gap-2 type-badge`;
            }
          });

          currentPage = 1;
          filterActivities();
        }

        function loadMore() {
          currentPage++;
          filterActivities();
        }

        function showSuccess(message) {
          // Create a temporary success notification
          const notification = document.createElement('div');
          notification.className = 'fixed top-6 right-6 bg-green-500 text-white px-6 py-4 rounded-xl shadow-lg z-50 success-badge';
          notification.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
            <i class="fas fa-check"></i>
          </div>
          <div>
            <p class="font-semibold">${message}</p>
            <p class="text-green-100 text-sm mt-1">Action completed successfully</p>
          </div>
        </div>
      `;

          document.body.appendChild(notification);

          setTimeout(() => {
            notification.remove();
          }, 3000);
        }

        function showError(message) {
          const notification = document.createElement('div');
          notification.className = 'fixed top-6 right-6 bg-red-500 text-white px-6 py-4 rounded-xl shadow-lg z-50 success-badge';
          notification.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
          <div>
            <p class="font-semibold">${message}</p>
            <p class="text-red-100 text-sm mt-1">Please try again</p>
          </div>
        </div>
      `;

          document.body.appendChild(notification);

          setTimeout(() => {
            notification.remove();
          }, 3000);
        }

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeDetailModal();
        });

        // Close modal on backdrop click
        document.getElementById('detailModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('detailModal')) {
            closeDetailModal();
          }
        });

        // Load logs on page load
        document.addEventListener('DOMContentLoaded', () => {
          loadActivityLogs(1);
        });
      </script>
</body>

</html>