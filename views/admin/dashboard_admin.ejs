<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
  <!-- Navbar -->
  <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>

  <!-- Sidebar -->
  <%- include('../sidebar/admin.ejs') %>

  <!-- Main Content -->
  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Dashboard Super Admin</h1>
      <p class="text-gray-600 mt-1">Selamat datang di panel kontrol admin</p>
    </div>
    <div class="text-sm text-gray-500">
      <i class="fas fa-calendar-alt mr-2"></i>
      <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="statsContainer">
    <!-- Total Users -->
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Total Users</p>
          <p class="text-3xl font-bold text-gray-900 mt-2" id="totalUsers">-</p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
          <i class="fas fa-users text-white text-xl"></i>
        </div>
      </div>
      <div class="mt-4 flex items-center text-sm">
        <span class="text-green-500 font-medium"><i class="fas fa-arrow-up mr-1"></i>12%</span>
        <span class="text-gray-400 ml-2">dari bulan lalu</span>
      </div>
    </div>

    <!-- Total Affiliates -->
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Total Affiliates</p>
          <p class="text-3xl font-bold text-gray-900 mt-2" id="totalAffiliates">-</p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
          <i class="fas fa-user-tie text-white text-xl"></i>
        </div>
      </div>
      <div class="mt-4 flex items-center text-sm">
        <span class="text-yellow-500 font-medium" id="pendingAffiliatesBadge">-</span>
        <span class="text-gray-400 ml-2">menunggu approval</span>
      </div>
    </div>

    <!-- Active Events -->
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Active Events</p>
          <p class="text-3xl font-bold text-gray-900 mt-2" id="activeEvents">-</p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg flex items-center justify-center">
          <i class="fas fa-calendar-alt text-white text-xl"></i>
        </div>
      </div>
      <div class="mt-4 flex items-center text-sm">
        <span class="text-green-500 font-medium"><i class="fas fa-check-circle mr-1"></i>Running</span>
        <span class="text-gray-400 ml-2">event aktif</span>
      </div>
    </div>

    <!-- Total Revenue -->
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm font-medium">Total Revenue</p>
          <p class="text-3xl font-bold text-gray-900 mt-2" id="totalRevenue">-</p>
        </div>
        <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-amber-600 rounded-lg flex items-center justify-center">
          <i class="fas fa-dollar-sign text-white text-xl"></i>
        </div>
      </div>
      <div class="mt-4 flex items-center text-sm">
        <span class="text-green-500 font-medium"><i class="fas fa-arrow-up mr-1"></i>8%</span>
        <span class="text-gray-400 ml-2">dari bulan lalu</span>
      </div>
    </div>
  </div>

  <!-- Tables Row -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Recent Transactions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100">
      <div class="p-6 border-b border-gray-100">
        <h2 class="text-lg font-semibold text-gray-900">Transaksi Terbaru</h2>
        <p class="text-sm text-gray-500 mt-1">10 transaksi terakhir</p>
      </div>
      <div class="p-6">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="text-left text-gray-500 text-sm">
                <th class="pb-3 font-medium">Customer</th>
                <th class="pb-3 font-medium">Amount</th>
                <th class="pb-3 font-medium">Status</th>
              </tr>
            </thead>
            <tbody id="transactionsTableBody">
              <tr>
                <td colspan="3" class="py-8 text-center text-gray-400">
                  <i class="fas fa-spinner fa-spin mr-2"></i>Loading...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Recent Activity Logs -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100">
      <div class="p-6 border-b border-gray-100">
        <h2 class="text-lg font-semibold text-gray-900">Aktivitas Terbaru</h2>
        <p class="text-sm text-gray-500 mt-1">10 aktivitas terakhir</p>
      </div>
      <div class="p-6">
        <div class="space-y-4" id="activityLogsBody">
          <div class="py-8 text-center text-gray-400">
            <i class="fas fa-spinner fa-spin mr-2"></i>Loading...
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  async function loadDashboardStats() {
    try {
      const response = await fetch('/api/admin/dashboard/stats');
      const data = await response.json();

      if (data.success) {
        // Update stats
        document.getElementById('totalUsers').textContent = data.stats.totalUsers;
        document.getElementById('totalAffiliates').textContent = data.stats.totalAffiliates;
        document.getElementById('activeEvents').textContent = data.stats.activeEvents;
        document.getElementById('totalRevenue').textContent = 'Rp ' + parseInt(data.stats.totalRevenue).toLocaleString('id-ID');

        // Update pending affiliates badge
        const pendingBadge = document.getElementById('pendingAffiliatesBadge');
        pendingBadge.innerHTML = `<i class="fas fa-clock mr-1"></i>${data.stats.pendingAffiliates} pending`;

        // Load transactions
        loadTransactions(data.recentTransactions);

        // Load activity logs
        loadActivityLogs(data.recentActivities);
      }
    } catch (error) {
      console.error('Error loading dashboard stats:', error);
    }
  }

  function loadTransactions(transactions) {
    const tbody = document.getElementById('transactionsTableBody');

    if (!transactions || transactions.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="3" class="py-8 text-center text-gray-400">
            <i class="fas fa-inbox text-4xl mb-2"></i>
            <p>Belum ada transaksi</p>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = transactions.map(t => {
      const statusClass = {
        'pending': 'bg-yellow-100 text-yellow-800',
        'completed': 'bg-green-100 text-green-800',
        'rejected': 'bg-red-100 text-red-800'
      }[t.status] || 'bg-gray-100 text-gray-800';

      return `
        <tr class="border-b border-gray-50 hover:bg-gray-50">
          <td class="py-3">
            <div class="font-medium text-gray-900">${t.customer_name || 'Unknown'}</div>
            <div class="text-sm text-gray-500">${t.affiliate_name || 'No Affiliate'}</div>
          </td>
          <td class="py-3">
            <div class="font-medium text-gray-900">Rp ${parseInt(t.total_amount).toLocaleString('id-ID')}</div>
          </td>
          <td class="py-3">
            <span class="px-2 py-1 rounded-full text-xs font-medium ${statusClass}">
              ${t.status}
            </span>
          </td>
        </tr>
      `;
    }).join('');
  }

  function loadActivityLogs(activities) {
    const container = document.getElementById('activityLogsBody');

    if (!activities || activities.length === 0) {
      container.innerHTML = `
        <div class="py-8 text-center text-gray-400">
          <i class="fas fa-inbox text-4xl mb-2"></i>
          <p>Belum ada aktivitas</p>
        </div>
      `;
      return;
    }

    const actionIcons = {
      'affiliate_approved': 'fa-user-check text-green-500',
      'affiliate_rejected': 'fa-user-times text-red-500',
      'affiliate_registration': 'fa-user-plus text-blue-500',
      'event_created': 'fa-calendar-plus text-purple-500',
      'login': 'fa-sign-in-alt text-gray-500'
    };

    container.innerHTML = activities.map(a => `
      <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-gray-50">
        <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
          <i class="fas ${actionIcons[a.action] || 'fa-bell text-gray-500'} text-sm"></i>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900">${a.description}</p>
          <p class="text-xs text-gray-500 mt-1">
            ${a.user_name || 'System'} • ${new Date(a.created_at).toLocaleString('id-ID')}
          </p>
        </div>
      </div>
    `).join('');
  }

  // Load stats on page load
  document.addEventListener('DOMContentLoaded', loadDashboardStats);
</script>
    </div>
  </main>
</body>
</html>
