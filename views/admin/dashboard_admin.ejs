          lineBtn.addEventListener('click', function () {
            // Update button styles
            lineBtn.className = 'px-3 py-1.5 bg-gradient-to-r from-emerald-500 to-green-600 text-white rounded-xl text-sm font-bold shadow-lg shadow-emerald-500/20 flex items-center gap-1.5';
