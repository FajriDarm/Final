        function updateTrafficStats() {
          const values = [3794, 2108, 1518, 1012];
          const total = values.reduce((a, b) => a + b, 0);
          const pct = values.map(v => Math.round((v / total) * 100));

          document.getElementById('trafficDirectPct').textContent = pct[0] + '%';
          document.getElementById('trafficSocialPct').textContent = pct[1] + '%';
          document.getElementById('trafficEmailPct').textContent = pct[2] + '%';
          document.getElementById('trafficReferralPct').textContent = pct[3] + '%';
          document.getElementById('trafficDirectValue').textContent = values[0].toLocaleString('id-ID');
          document.getElementById('trafficSocialValue').textContent = values[1].toLocaleString('id-ID');
          document.getElementById('trafficEmailValue').textContent = values[2].toLocaleString('id-ID');
          document.getElementById('trafficReferralValue').textContent = values[3].toLocaleString('id-ID');
          document.getElementById('trafficDirectBar').style.width = pct[0] + '%';
          document.getElementById('trafficSocialBar').style.width = pct[1] + '%';
          document.getElementById('trafficEmailBar').style.width = pct[2] + '%';
          document.getElementById('trafficReferralBar').style.width = pct[3] + '%';
          document.getElementById('trafficTotal').textContent = total.toLocaleString('id-ID');
          document.getElementById('trafficTotalChange').textContent = '+18.3%';
        }

        async function loadDashboardStats() {
          try {
            const response = await fetch('/api/admin/dashboard/stats');
            const data = await response.json();

            if (data.success) {
              animateValue('totalUsers', 0, data.stats.totalUsers, 1500);
              animateValue('totalAffiliates', 0, data.stats.totalAffiliates, 1500);
              animateValue('activeEvents', 0, data.stats.activeEvents, 1500);

              const revenueValue = parseInt(data.stats.totalRevenue);
              animateValue('totalRevenue', 0, revenueValue, 1500, true);

              const pendingBadge = document.getElementById('pendingAffiliatesBadge');
              if (data.stats.pendingAffiliates > 0) {
                pendingBadge.innerHTML = `
                  <span class="px-3 py-1.5 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg text-xs font-extrabold flex items-center gap-1 shadow-lg border border-white/30">
                    <i class="fas fa-clock"></i>
                    ${data.stats.pendingAffiliates} Menunggu Persetujuan
                  </span>
                `;
              } else {
                pendingBadge.innerHTML = '';
              }

              // Update revenue charts and stats
              if (data.revenueThisWeek && Array.isArray(data.revenueThisWeek)) {
                const thisWeek = data.revenueThisWeek.map(v => Number(v));
                const lastWeek = data.revenueLastWeek ? data.revenueLastWeek.map(v => Number(v)) : [];

                // Update line chart
                if (revenueLineChart) {
                  revenueLineChart.data.datasets[0].data = thisWeek;
                  if (lastWeek.length) {
                    revenueLineChart.data.datasets[1].data = lastWeek;
                  }
                  revenueLineChart.update();
                }

                // Update bar chart
                if (revenueBarChart) {
                  revenueBarChart.data.datasets[0].data = thisWeek;
                  if (lastWeek.length) {
                    revenueBarChart.data.datasets[1].data = lastWeek;
                  }
                  revenueBarChart.update();
                }

                // Update nilai per hari
                const days = ['valueMon', 'valueTue', 'valueWed', 'valueThu', 'valueFri', 'valueSat', 'valueSun'];
                thisWeek.forEach((value, index) => {
                  const el = document.getElementById(days[index]);
                  if (el) el.textContent = 'Rp ' + (value / 1000000).toFixed(1) + 'M';
                });

                // Update statistik
                const total = thisWeek.reduce((a, b) => a + b, 0);
                const avg = total / 7;
                const max = Math.max(...thisWeek);
                const maxIndex = thisWeek.indexOf(max);
                const dayNames = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];

                document.getElementById('revenueThisWeek').textContent = 'Rp ' + (total / 1000000).toFixed(1) + 'M';
                document.getElementById('revenueAvg').textContent = 'Rp ' + (avg / 1000000).toFixed(1) + 'M';
                document.getElementById('revenueMax').textContent = 'Rp ' + (max / 1000000).toFixed(1) + 'M';
                document.getElementById('revenueMaxDay').innerHTML = '<i class="fas fa-calendar-check text-xs"></i> ' + dayNames[maxIndex];

                // Week change
                if (lastWeek.length) {
                  const lastTotal = lastWeek.reduce((a, b) => a + b, 0);
                  const change = ((total - lastTotal) / lastTotal) * 100;
                  const changeEl = document.getElementById('revenueWeekChange');
                  changeEl.innerHTML = `<i class="fas fa-arrow-${change >= 0 ? 'up' : 'down'} text-${change >= 0 ? 'emerald' : 'red'}-500"></i> ${change >= 0 ? '+' : ''}${change.toFixed(1)}%`;
                }
              }

              if (data.trafficSources && trafficChart) {
                const ts = data.trafficSources;
                const values = [ts.direct || 0, ts.social || 0, ts.email || 0, ts.referral || 0];
                const total = values.reduce((s, n) => s + n, 0) || 1;
                trafficChart.data.datasets[0].data = values;
                trafficChart.update();

                // Update UI
                const pct = values.map(v => Math.round((v / total) * 100));
                document.getElementById('trafficDirectPct').textContent = pct[0] + '%';
                document.getElementById('trafficSocialPct').textContent = pct[1] + '%';
                document.getElementById('trafficEmailPct').textContent = pct[2] + '%';
                document.getElementById('trafficReferralPct').textContent = pct[3] + '%';
                document.getElementById('trafficDirectValue').textContent = values[0].toLocaleString('id-ID');
                document.getElementById('trafficSocialValue').textContent = values[1].toLocaleString('id-ID');
                document.getElementById('trafficEmailValue').textContent = values[2].toLocaleString('id-ID');
                document.getElementById('trafficReferralValue').textContent = values[3].toLocaleString('id-ID');
                document.getElementById('trafficDirectBar').style.width = pct[0] + '%';
                document.getElementById('trafficSocialBar').style.width = pct[1] + '%';
                document.getElementById('trafficEmailBar').style.width = pct[2] + '%';
                document.getElementById('trafficReferralBar').style.width = pct[3] + '%';
                document.getElementById('trafficTotal').textContent = total.toLocaleString('id-ID');

              }

              if (data.recentTransactions) {
                loadTransactions(data.recentTransactions);
              }

              if (data.recentActivities) {
                loadActivityLogs(data.recentActivities);
              }

              if (data.topAffiliates) {
                const container = document.getElementById('topAffiliatesList');
                if (data.topAffiliates.length === 0) {
                  container.innerHTML = '<div class="text-sm font-medium text-gray-500 bg-white/60 p-3 rounded-xl text-center border border-white/60">Belum ada data affiliasi</div>';
                } else {
                  container.innerHTML = data.topAffiliates.map((a, i) => `
                    <div class="flex items-center justify-between bg-white/60 p-2.5 rounded-xl border border-white/60 hover:bg-white/80 transition-all duration-300">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 ${i === 0 ? 'bg-gradient-to-br from-amber-400 to-yellow-500' : i === 1 ? 'bg-gradient-to-br from-gray-300 to-gray-400' : 'bg-gradient-to-br from-amber-700 to-amber-800'} rounded-lg flex items-center justify-center text-white font-extrabold text-sm shadow-lg">
                          ${i + 1}
                        </div>
                        <div>
                          <span class="font-extrabold text-gray-900 text-sm">${a.name}</span>
                          <p class="text-xs text-emerald-700 font-medium mt-0.5">Top Performer</p>
                        </div>
                      </div>
                      <span class="font-extrabold text-emerald-700 bg-white/80 px-2 py-1 rounded-lg text-xs shadow-sm border border-white/60">Rp ${Number(a.total).toLocaleString('id-ID')}</span>
                    </div>
                  `).join('');
                }
              }

              if (data.popularEvents) {
                const pe = document.getElementById('popularEventsList');
                if (data.popularEvents.length === 0) {
                  pe.innerHTML = '<div class="text-sm font-medium text-gray-500 bg-white/60 p-3 rounded-xl text-center border border-white/60">Belum ada event populer</div>';
                } else {
                  pe.innerHTML = data.popularEvents.map(ev => `
                    <div class="flex items-center justify-between bg-white/60 p-2.5 rounded-xl border border-white/60 hover:bg-white/80 transition-all duration-300">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 bg-gradient-to-br from-orange-400 to-red-500 rounded-lg flex items-center justify-center shadow-lg">
                          <i class="fas fa-calendar text-white text-xs"></i>
                        </div>
                        <span class="font-extrabold text-gray-900 text-sm line-clamp-1">${ev.title}</span>
                      </div>
                      <span class="px-2 py-1 bg-gradient-to-r from-green-500 to-emerald-600 text-white rounded-lg text-xs font-extrabold shadow-lg">${ev.count} transaksi</span>
                    </div>
                  `).join('');
                }
              }

              if (data.lastChangesByRole) {
                const setLastChange = (roleKey, nameId, metaId) => {
                  const item = data.lastChangesByRole[roleKey];
                  const nameEl = document.getElementById(nameId);
                  const metaEl = document.getElementById(metaId);
                  if (!nameEl || !metaEl) return;

                  if (!item) {
                    nameEl.textContent = '—';
                    metaEl.textContent = 'Belum ada aktivitas';
                    return;
                  }

                  const approverName = item.approver_name || item.approver_email || '—';
                  let whenText = '—';
                  if (item.created_at) {
                    const d = new Date(item.created_at);
                    if (!isNaN(d.getTime())) {
                      whenText = d.toLocaleString('id-ID', {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      });
                    }
                  }
                  const actionText = item.action || 'update';

                  nameEl.textContent = approverName;
                  metaEl.textContent = `${actionText} • ${whenText}`;
                };

                setLastChange('sales', 'lastChangeSalesName', 'lastChangeSalesMeta');
                setLastChange('finance', 'lastChangeFinanceName', 'lastChangeFinanceMeta');
                setLastChange('admin', 'lastChangeAdminName', 'lastChangeAdminMeta');
              }
            }
          } catch (error) {
            console.error('Error loading dashboard stats:', error);
            showError('Gagal memuat data dashboard');
          }
        }

        function animateValue(id, start, end, duration, isCurrency = false) {
          const obj = document.getElementById(id);
          if (!obj) return;

          let startTimestamp = null;
          const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const value = Math.floor(progress * (end - start) + start);

            if (isCurrency) {
              obj.textContent = 'Rp ' + value.toLocaleString('id-ID');
            } else {
              obj.textContent = value;
            }

            if (progress < 1) {
              window.requestAnimationFrame(step);
            }
          };
          window.requestAnimationFrame(step);
        }

        // Function for transactions table
        function loadTransactions(transactions) {
          const tbody = document.getElementById('transactionsTableBody');

          if (!transactions || transactions.length === 0) {
            tbody.innerHTML = `
              <tr style="height:300px;">
                <td colspan="3" class="px-4 text-center align-middle bg-white/30">
                  <div class="flex flex-col items-center justify-center h-full">
                    <div class="w-14 h-14 bg-gradient-to-br from-green-100 to-emerald-100 rounded-2xl flex items-center justify-center mb-2 shadow-xl border border-white/60">
                      <i class="fas fa-inbox text-green-600 text-xl"></i>
                    </div>
                    <p class="text-gray-900 font-bold text-base">Belum ada transaksi</p>
                    <p class="text-xs text-emerald-700 font-medium mt-0.5">Transaksi akan muncul di sini</p>
                  </div>
                </td>
              </tr>
            `;
            return;
          }

          tbody.innerHTML = transactions.map((t, index) => {
            const displayStatus = String(t.lead_status || t.status || '').toLowerCase();
            const statusClass = {
              'pending': 'bg-gradient-to-r from-yellow-500 to-amber-500',
              'completed': 'bg-gradient-to-r from-green-500 to-emerald-600',
              'rejected': 'bg-gradient-to-r from-red-500 to-rose-600',
              'processing': 'bg-gradient-to-r from-blue-500 to-indigo-600'
            }[displayStatus] || 'bg-gradient-to-r from-gray-500 to-gray-600';

            const amount = parseInt(t.total_amount || 0);
            const isHighValue = amount > 1000000;

            const date = new Date(t.created_at);
            const formattedDate = date.toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'short',
              year: 'numeric'
            }) + ', ' + date.toLocaleTimeString('id-ID', {
              hour: '2-digit',
              minute: '2-digit'
            });

            return `
              <tr class="hover:bg-white/60 transition-all duration-200 bg-white/30">
                <td class="py-2.5 px-4">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center border border-white/60 shadow-sm flex-shrink-0">
                      <i class="fas fa-user text-green-600 text-xs"></i>
                    </div>
                    <div class="min-w-0">
                      <div class="font-bold text-gray-900 text-sm truncate max-w-[100px]">
                        ${t.customer_name || 'Tidak Diketahui'}
                      </div>
                      <div class="flex items-center gap-0.5 mt-0.5">
                        <span class="w-0.5 h-0.5 bg-green-500 rounded-full"></span>
                        <span class="text-xs font-medium text-emerald-700 truncate max-w-[80px]">
                          ${t.affiliate_name || 'Tanpa Afiliasi'}
                        </span>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="py-2.5 px-4 align-middle">
                  <div class="flex flex-col">
                    <span class="font-extrabold ${isHighValue ? 'text-emerald-700' : 'text-gray-900'} text-sm">
                      Rp ${amount.toLocaleString('id-ID')}
                    </span>
                    <span class="text-xs font-medium text-gray-500 flex items-center gap-0.5 mt-0.5">
                      <i class="far fa-calendar-alt text-emerald-600 text-xs"></i>
                      ${formattedDate}
                    </span>
                  </div>
                </td>
                <td class="py-2.5 px-4 align-middle">
                  <span class="px-2 py-1 rounded-lg text-xs font-bold ${statusClass} text-white shadow-md border border-white/30 inline-flex items-center gap-1">
                    <i class="fas fa-circle text-xs"></i>
                    ${displayStatus ? displayStatus.toUpperCase() : '-'}
                  </span>
                  ${t.payment_method ? `
                    <div class="text-xs font-medium text-gray-500 mt-1">
                      Pembayaran: ${t.payment_method}
                    </div>
                  ` : ''}
                </td>
              </tr>
            `;
          }).join('');
        }

        function loadActivityLogs(activities) {
          const container = document.getElementById('activityLogsBody');

          if (!activities || activities.length === 0) {
            container.innerHTML = `
              <div class="h-full flex items-center justify-center">
                <div class="text-center p-6">
                  <div class="w-14 h-14 bg-gradient-to-br from-green-100 to-emerald-100 rounded-2xl flex items-center justify-center mb-2 shadow-xl border border-white/60 mx-auto">
                    <i class="fas fa-inbox text-green-600 text-xl"></i>
                  </div>
                  <p class="text-gray-900 font-bold text-base">Belum ada aktivitas</p>
                  <p class="text-xs text-emerald-700 font-medium mt-0.5">Aktivitas akan muncul di sini</p>
                </div>
              </div>
            `;
            return;
          }

          const actionConfig = {
            'affiliate_approved': { icon: 'fa-user-check', bg: 'bg-gradient-to-r from-green-500 to-emerald-600' },
            'affiliate_rejected': { icon: 'fa-user-times', bg: 'bg-gradient-to-r from-red-500 to-rose-600' },
            'affiliate_registration': { icon: 'fa-user-plus', bg: 'bg-gradient-to-r from-blue-500 to-indigo-600' },
            'event_created': { icon: 'fa-calendar-plus', bg: 'bg-gradient-to-r from-purple-500 to-pink-600' },
            'login': { icon: 'fa-sign-in-alt', bg: 'bg-gradient-to-r from-gray-500 to-gray-600' },
            'transaction': { icon: 'fa-dollar-sign', bg: 'bg-gradient-to-r from-amber-500 to-orange-600' },
            'update': { icon: 'fa-sync-alt', bg: 'bg-gradient-to-r from-teal-500 to-cyan-600' }
          };

          container.innerHTML = activities.map((a, index) => {
            const config = actionConfig[a.action] || {
              icon: 'fa-bell',
              bg: 'bg-gradient-to-r from-emerald-500 to-green-600'
            };

            let displayText = a.description;
            if (a.approver_name && a.target_user_name) {
              if (a.action === 'affiliate_approved') {
                displayText = `${a.approver_name} menyetujui ${a.target_user_name}`;
              } else if (a.action === 'affiliate_rejected') {
                displayText = `${a.approver_name} menolak ${a.target_user_name}`;
              }
            }

            const date = new Date(a.created_at);
            const formattedDate = date.toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'short',
              year: 'numeric'
            });

            return `
              <div class="p-3 border-b border-white/30 hover:bg-white/60 transition-all duration-300 bg-white/20">
                <div class="flex items-start gap-2">
                  <div class="w-7 h-7 ${config.bg} rounded-lg flex items-center justify-center flex-shrink-0 shadow-lg border border-white/30">
                    <i class="fas ${config.icon} text-white text-xs"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-extrabold text-gray-900 mb-1 line-clamp-1">${displayText}</p>
                    <div class="flex flex-wrap items-center gap-1">
                      <span class="text-xs font-bold text-emerald-700 bg-white/80 px-1.5 py-0.5 rounded-lg border border-white/60 flex items-center gap-0.5">
                        <i class="fas fa-shield-alt text-emerald-600 text-xs"></i>
                        ${a.approver_name || 'Sistem'}
                      </span>
                      <span class="text-xs font-bold text-gray-500 bg-white/80 px-1.5 py-0.5 rounded-lg border border-white/60 flex items-center gap-0.5 ml-auto">
                        <i class="far fa-clock text-emerald-600 text-xs"></i>
                        ${formattedDate}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }

        function showError(message) {
          const statsContainer = document.getElementById('statsContainer');
          const errorDiv = document.createElement('div');
          errorDiv.className = 'col-span-4';
          errorDiv.innerHTML = `
            <div class="bg-gradient-to-r from-red-50 to-rose-50 border border-red-200 rounded-2xl p-4 animate-slide-in shadow-xl backdrop-blur">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gradient-to-r from-red-500 to-rose-600 rounded-xl flex items-center justify-center shadow-2xl">
                  <i class="fas fa-exclamation-triangle text-white text-lg"></i>
                </div>
                <div>
                  <p class="text-red-700 font-extrabold text-base">${message}</p>
                  <p class="text-red-600 text-xs mt-1 flex items-center gap-1">
                    <i class="fas fa-sync-alt"></i>
                    Coba refresh halaman atau hubungi support
                  </p>
                </div>
              </div>
            </div>
          `;
          statsContainer.insertBefore(errorDiv, statsContainer.firstChild);
        }
      </script>
</body>

</html>
