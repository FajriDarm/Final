          // Traffic Chart Premium
          const trafficCtx = document.getElementById('trafficChart').getContext('2d');
          trafficChart = new Chart(trafficCtx, {
            type: 'doughnut',
            data: {
              labels: ['Direct', 'Social', 'Email', 'Referral'],
              datasets: [
                {
                  data: [3794, 2108, 1518, 1012],
                  backgroundColor: [
                    'rgba(16, 185, 129, 0.9)',
                    'rgba(52, 211, 153, 0.9)',
                    'rgba(45, 212, 191, 0.9)',
                    'rgba(163, 230, 53, 0.9)'
                  ],
                  borderColor: '#ffffff',
                  borderWidth: 3,
                  hoverOffset: 8,
                  hoverBorderColor: '#ffffff',
                  hoverBorderWidth: 2,
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '70%',
              plugins: {
