              class="flex-1 bg-gray-200 text-gray-700 py-3.5 rounded-xl hover:bg-gray-300 transition-all font-semibold flex items-center justify-center gap-2">
              <i class="fas fa-arrow-left"></i>
              Kembali
            </button>
            <button onclick="submitRejection()" id="submitRejectionBtn"
              class="flex-1 bg-gradient-to-r from-red-600 to-pink-600 text-white py-3.5 rounded-xl hover:opacity-90 transition-all font-semibold flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
              <i class="fas fa-paper-plane"></i>
              Kirim Penolakan
            </button>
          </div>
        </div>
      </div>

      <!-- Affiliate Detail Modal -->
      <div id="affiliateDetailModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div
          class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto flex flex-col relative">
          <button onclick="closeAffiliateDetailModal()"
            class="absolute top-4 right-4 w-10 h-10 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors z-10">
            <i class="fas fa-times text-gray-600"></i>
          </button>
          <div class="p-8" id="affiliateDetailContent">
            <!-- Content akan diisi oleh JS -->
          </div>
        </div>
      </div>

      <script>
        let allAffiliates = [];
        let currentFilter = 'pending';
        let selectedUserId = null;
        let currentRejectionAffiliate = null;
        let confirmationCallback = null;

        // ============================================================
        // FUNGSI NOTIFIKASI MODAL - DIUPDATE LENGKAP
        // ============================================================

        /**
         * Tampilkan modal notifikasi dengan berbagai tipe
         */
        function showNotification(type, title, message, autoClose = true) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const titleEl = document.getElementById('notificationTitle');
          const messageEl = document.getElementById('notificationMessage');
          const closeBtn = document.getElementById('closeNotificationModalBtn');

          // Reset kelas icon
          icon.className = 'notification-icon';

          // Konfigurasi untuk setiap tipe notifikasi
          const configs = {
            success: {
              iconClass: 'success',
              iconHTML: `
                <svg class="notification-checkmark-svg" width="48" height="48" viewBox="0 0 48 48">
                  <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
                  <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                    stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              `,
              buttonClass: 'from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700'
            },
            error: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-times-circle"></i>',
              buttonClass: 'from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700'
            },
            warning: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-exclamation-triangle"></i>',
              buttonClass: 'from-yellow-600 to-amber-600 hover:from-yellow-700 hover:to-amber-700'
            },
            info: {
              iconClass: 'info',
              iconHTML: '<i class="fas fa-info-circle"></i>',
              buttonClass: 'from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700'
            },
            approve: {
              iconClass: 'success',
              iconHTML: '<i class="fas fa-user-check"></i>',
              buttonClass: 'from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700'
            },
            reject: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-user-times"></i>',
              buttonClass: 'from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700'
            }
          };

          const config = configs[type] || configs.info;

          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;
          titleEl.textContent = title;
          messageEl.textContent = message;

          // Update warna tombol berdasarkan tipe
          closeBtn.className = `w-full bg-gradient-to-r ${config.buttonClass} text-white py-3.5 px-6 rounded-xl font-medium transition-all duration-200`;

          // Reset animasi checkmark untuk notifikasi sukses
          if (type === 'success' || type === 'approve') {
            const checkmarkPath = icon.querySelector('.notification-checkmark-path');
            if (checkmarkPath) {
              checkmarkPath.style.strokeDasharray = '40';
              checkmarkPath.style.strokeDashoffset = '40';
              setTimeout(() => {
                checkmarkPath.style.animation = 'none';
                setTimeout(() => {
                  checkmarkPath.style.animation = 'checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards';
                }, 10);
              }, 10);
            }
          }

          modal.style.display = 'flex';

          if (autoClose) {
            setTimeout(() => {
              closeNotification();
            }, 4000);
          }
        }

        /**
         * Tampilkan modal konfirmasi dengan callback
         */
        function showConfirmationModal(type, title, message, confirmText, cancelText, onConfirm, onCancel = null) {
          const modal = document.getElementById('confirmationModal');
          const icon = document.getElementById('confirmationIcon');
          const titleEl = document.getElementById('confirmationTitle');
          const messageEl = document.getElementById('confirmationMessage');
          const confirmBtn = document.getElementById('confirmBtn');
          const cancelBtn = document.getElementById('cancelConfirmationBtn');

          // Konfigurasi icon berdasarkan tipe
          const iconConfigs = {
            approve: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-check"></i>',
              buttonClass: 'from-green-600 to-emerald-600'
            },
            reject: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-times"></i>',
              buttonClass: 'from-red-600 to-rose-600'
            }
          };

          const config = iconConfigs[type] || { iconClass: 'warning', iconHTML: '<i class="fas fa-exclamation-triangle"></i>', buttonClass: 'from-yellow-600 to-amber-600' };

          icon.className = 'notification-icon';
          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;

          titleEl.textContent = title;
          messageEl.textContent = message;
          confirmBtn.textContent = confirmText;
          cancelBtn.textContent = cancelText;

          // Update warna tombol konfirmasi
          confirmBtn.className = `flex-1 bg-gradient-to-r ${config.buttonClass} text-white py-3 px-6 rounded-xl font-medium hover:opacity-90 transition-all duration-200`;

          // Simpan callback
          confirmationCallback = onConfirm;

          // Setup event listeners
          confirmBtn.onclick = function (e) {
            e.preventDefault();
            closeConfirmationModal();
            if (onConfirm) onConfirm();
          };

          cancelBtn.onclick = function (e) {
            e.preventDefault();
            closeConfirmationModal();
            if (onCancel) onCancel();
          };

          modal.style.display = 'flex';

          // Tutup dengan klik di luar
          modal.addEventListener('click', function (e) {
            if (e.target === modal) {
              closeConfirmationModal();
              if (onCancel) onCancel();
            }
          });

          // Tutup dengan ESC key
          const escHandler = function (e) {
            if (e.key === 'Escape') {
              closeConfirmationModal();
              if (onCancel) onCancel();
              document.removeEventListener('keydown', escHandler);
            }
          };
          document.addEventListener('keydown', escHandler);
        }

        /**
         * Tutup modal konfirmasi
         */
        function closeConfirmationModal() {
          const modal = document.getElementById('confirmationModal');
          modal.style.display = 'none';
        }

        /**
         * Tutup modal notifikasi
         */
        function closeNotification() {
          const modal = document.getElementById('notificationModal');
          modal.style.display = 'none';
        }

        /**
         * Tampilkan notifikasi sukses
         */
        function showSuccess(message, title = 'Sukses') {
          showNotification('success', title, message);
        }

        /**
         * Tampilkan notifikasi error
         */
        function showError(message, title = 'Error') {
          showNotification('error', title, message);
        }

        /**
         * Tampilkan notifikasi info
         */
        function showInfo(message, title = 'Info') {
          showNotification('info', title, message);
        }

        /**
         * Tampilkan notifikasi peringatan
         */
        function showWarning(message, title = 'Peringatan') {
          showNotification('warning', title, message);
        }

        // ============================================================
        // FUNGSI UTAMA AFFILIATES
        // ============================================================

        async function loadAffiliates(filter = 'pending') {
          currentFilter = filter;
          try {
            let url = '/api/admin/users';
            const response = await fetch(url);
            const data = await response.json();

            if (data.success) {
              allAffiliates = data.data.filter(u => u.affiliate_status && u.affiliate_status !== 'inactive');

              updateStats(allAffiliates);

              const filtered = allAffiliates.filter(affiliate => {
                if (filter === 'all') return true;
                if (filter === 'pending') return affiliate.affiliate_status === 'pending';
                if (filter === 'approved') return affiliate.affiliate_status === 'approved';
                if (filter === 'rejected') return affiliate.affiliate_status === 'rejected';
                return true;
              });

              displayAffiliates(filtered);
              updateTabStyles(filter);
            }
          } catch (error) {
            console.error('Error loading affiliates:', error);
            showError('Gagal memuat affiliates');
          }
        }

        function updateStats(affiliates) {
          const total = affiliates.length;
          const pending = affiliates.filter(a => a.affiliate_status === 'pending').length;
          const approved = affiliates.filter(a => a.affiliate_status === 'approved').length;
          const rejected = affiliates.filter(a => a.affiliate_status === 'rejected').length;

          document.getElementById('totalAffiliates').textContent = total;
          document.getElementById('pendingAffiliates').textContent = pending;
          document.getElementById('approvedAffiliates').textContent = approved;

          document.getElementById('pendingCount').textContent = pending;
          document.getElementById('approvedCount').textContent = approved;
          document.getElementById('rejectedCount').textContent = rejected;

          document.getElementById('pendingNow').textContent = pending;
          document.getElementById('activeNow').textContent = approved;
        }

