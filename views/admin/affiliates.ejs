          }).join('');
        }

        function updateTabStyles(activeFilter) {
          const tabs = ['pending', 'approved', 'rejected', 'all'];
          tabs.forEach(tab => {
            const tabElement = document.getElementById(`tab${tab.charAt(0).toUpperCase() + tab.slice(1)}`);
            if (tabElement) {
              if (tab === activeFilter) {
                tabElement.classList.remove('tab-inactive');
                tabElement.classList.add('tab-active');
              } else {
                tabElement.classList.remove('tab-active');
                tabElement.classList.add('tab-inactive');
              }
            }
          });
        }

        async function showApprovalModal(userId) {
          selectedUserId = userId;
          const affiliate = allAffiliates.find(a => a.id === userId);

          if (affiliate) {
            document.getElementById('modalTitle').textContent =
              affiliate.affiliate_status === 'pending' ? 'Tinjau Aplikasi Affiliate' : 'Edit Status Affiliate';

