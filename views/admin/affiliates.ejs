<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Affiliates Management - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
  <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>
  <%- include('../sidebar/admin.ejs') %>

  <main class="ml-64 pt-16 min-h-screen">
    <div class="p-6">
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Affiliates Management</h1>
        <p class="text-gray-600 mt-1">Approve atau reject pendaftaran affiliate</p>
      </div>

      <!-- Tabs -->
      <div class="mb-6">
        <div class="flex gap-2 border-b">
          <button onclick="loadAffiliates('pending')" id="tabPending" class="px-4 py-2 border-b-2 border-yellow-500 text-yellow-600 font-medium">
            Pending (<span id="pendingCount">-</span>)
          </button>
          <button onclick="loadAffiliates('all')" id="tabAll" class="px-4 py-2 border-b-2 border-transparent text-gray-600 font-medium hover:text-gray-800">
            All Affiliates
          </button>
        </div>
      </div>

      <!-- Affiliates Table -->
      <div class="bg-white rounded-lg shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Affiliate</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Applied Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody id="affiliatesTableBody" class="divide-y divide-gray-200">
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-gray-400">
                  <i class="fas fa-spinner fa-spin text-2xl mb-2"></i>
                  <p>Loading...</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <script>
    async function loadAffiliates(filter = 'pending') {
      try {
        const url = filter === 'pending' ? '/api/admin/affiliates/pending' : '/api/admin/users';
        const response = await fetch(url);
        const data = await response.json();

        if (data.success) {
          const affiliates = filter === 'pending' ? data.data : data.data.filter(u => u.affiliate_status && u.affiliate_status !== 'inactive');
          displayAffiliates(affiliates, filter);
          updateTabStyles(filter);
        }
      } catch (error) {
        console.error('Error loading affiliates:', error);
      }
    }

    function updateTabStyles(activeFilter) {
      const tabPending = document.getElementById('tabPending');
      const tabAll = document.getElementById('tabAll');

      if (activeFilter === 'pending') {
        tabPending.classList.add('border-yellow-500', 'text-yellow-600');
        tabPending.classList.remove('border-transparent', 'text-gray-600');
        tabAll.classList.remove('border-yellow-500', 'text-yellow-600');
        tabAll.classList.add('border-transparent', 'text-gray-600');
      } else {
        tabAll.classList.add('border-yellow-500', 'text-yellow-600');
        tabAll.classList.remove('border-transparent', 'text-gray-600');
        tabPending.classList.remove('border-yellow-500', 'text-yellow-600');
        tabPending.classList.add('border-transparent', 'text-gray-600');
      }
    }

    function displayAffiliates(affiliates, filter) {
      const tbody = document.getElementById('affiliatesTableBody');

      if (!affiliates || affiliates.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-gray-400">
              <i class="fas fa-users text-4xl mb-2"></i>
              <p>No ${filter} affiliates</p>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = affiliates.map(affiliate => {
        const statusBadge = {
          'inactive': 'bg-gray-100 text-gray-800',
          'pending': 'bg-yellow-100 text-yellow-800',
          'approved': 'bg-green-100 text-green-800',
          'rejected': 'bg-red-100 text-red-800'
        }[affiliate.affiliate_status] || 'bg-gray-100 text-gray-800';

        return `
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center text-white font-semibold mr-3">
                  ${affiliate.name.charAt(0).toUpperCase()}
                </div>
                <div class="font-medium text-gray-900">${affiliate.name}</div>
              </div>
            </td>
            <td class="px-6 py-4 text-gray-600">${affiliate.email}</td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 rounded-full text-xs font-medium ${statusBadge}">${affiliate.affiliate_status}</span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              ${new Date(affiliate.created_at).toLocaleDateString('id-ID')}
            </td>
            <td class="px-6 py-4">
              ${affiliate.affiliate_status === 'pending' ? `
                <div class="flex gap-2">
                  <button onclick="approveAffiliate(${affiliate.id})" class="px-3 py-1 bg-green-600 text-white rounded text-sm hover:bg-green-700">
                    <i class="fas fa-check mr-1"></i>Approve
                  </button>
                  <button onclick="rejectAffiliate(${affiliate.id})" class="px-3 py-1 bg-red-600 text-white rounded text-sm hover:bg-red-700">
                    <i class="fas fa-times mr-1"></i>Reject
                  </button>
                </div>
              ` : '-'}
            </td>
          </tr>
        `;
      }).join('');

      // Update pending count
      const pendingCount = affiliates.filter(a => a.affiliate_status === 'pending').length;
      document.getElementById('pendingCount').textContent = pendingCount;
    }

    async function approveAffiliate(userId) {
      if (!confirm('Approve this affiliate application?')) return;

      try {
        const response = await fetch(`/api/admin/affiliates/${userId}/approve`, {
          method: 'PUT'
        });
        const data = await response.json();

        if (data.success) {
          alert('Affiliate approved successfully');
          loadAffiliates('pending');
        } else {
          alert('Failed to approve affiliate');
        }
      } catch (error) {
        console.error('Error approving affiliate:', error);
        alert('Failed to approve affiliate');
      }
    }

    async function rejectAffiliate(userId) {
      const reason = prompt('Reason for rejection:');
      if (!reason) return;

      try {
        const response = await fetch(`/api/admin/affiliates/${userId}/reject`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await response.json();

        if (data.success) {
          alert('Affiliate rejected successfully');
          loadAffiliates('pending');
        } else {
          alert('Failed to reject affiliate');
        }
      } catch (error) {
        console.error('Error rejecting affiliate:', error);
        alert('Failed to reject affiliate');
      }
    }

    document.addEventListener('DOMContentLoaded', () => loadAffiliates('pending'));
  </script>
</body>
</html>
