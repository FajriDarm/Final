      <script>
        let allAffiliates = [];
        let currentFilter = 'pending';
        let selectedUserId = null;
        let currentRejectionAffiliate = null;
        let confirmationCallback = null;

        // ============================================================
        // FUNGSI NOTIFIKASI MODAL PREMIUM
        // ============================================================

        function showNotification(type, title, message, autoClose = true) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const titleEl = document.getElementById('notificationTitle');
          const messageEl = document.getElementById('notificationMessage');
          const closeBtn = document.getElementById('closeNotificationModalBtn');

          icon.className = 'notification-icon';

          const configs = {
            success: {
              iconClass: 'success',
              iconHTML: `
                <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
                  <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
                  <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                    stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              `,
              buttonClass: 'gradient-primary'
            },
            error: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-times-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            },
            warning: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-exclamation-triangle"></i>',
              buttonClass: 'bg-gradient-to-r from-amber-500 to-orange-500'
            },
            info: {
              iconClass: 'info',
              iconHTML: '<i class="fas fa-info-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-blue-600 to-indigo-600'
            },
            approve: {
              iconClass: 'success',
              iconHTML: '<i class="fas fa-user-check"></i>',
              buttonClass: 'gradient-primary'
            },
            reject: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-user-times"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            }
          };

          const config = configs[type] || configs.info;

          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;
          titleEl.textContent = title;
          messageEl.textContent = message;

          closeBtn.className = `w-full ${config.buttonClass} text-white py-3 px-5 rounded-xl text-base font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg`;

          if (type === 'success' || type === 'approve') {
            const checkmarkPath = icon.querySelector('.notification-checkmark-path');
            if (checkmarkPath) {
              checkmarkPath.style.strokeDasharray = '40';
              checkmarkPath.style.strokeDashoffset = '40';
              setTimeout(() => {
                checkmarkPath.style.animation = 'none';
                setTimeout(() => {
                  checkmarkPath.style.animation = 'checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards';
                }, 10);
              }, 10);
            }
          }

          modal.style.display = 'flex';

          if (autoClose) {
            setTimeout(() => {
              closeNotification();
            }, 4000);
          }
        }

        function showConfirmationModal(type, title, message, confirmText, cancelText, onConfirm, onCancel = null) {
          const modal = document.getElementById('confirmationModal');
          const icon = document.getElementById('confirmationIcon');
          const titleEl = document.getElementById('confirmationTitle');
          const messageEl = document.getElementById('confirmationMessage');
          const confirmBtn = document.getElementById('confirmBtn');
          const cancelBtn = document.getElementById('cancelConfirmationBtn');

          const iconConfigs = {
            approve: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-check"></i>',
              buttonClass: 'gradient-primary'
            },
            reject: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-times"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            }
          };

          const config = iconConfigs[type] || { iconClass: 'warning', iconHTML: '<i class="fas fa-exclamation-triangle"></i>', buttonClass: 'bg-gradient-to-r from-amber-500 to-orange-500' };

          icon.className = 'notification-icon';
          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;

          titleEl.textContent = title;
          messageEl.textContent = message;
          confirmBtn.textContent = confirmText;
          cancelBtn.textContent = cancelText;

          confirmBtn.className = `flex-1 ${config.buttonClass} text-white py-3 px-4 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg`;

          confirmationCallback = onConfirm;

          confirmBtn.onclick = function (e) {
            e.preventDefault();
            closeConfirmationModal();
            if (onConfirm) onConfirm();
          };

          cancelBtn.onclick = function (e) {
            e.preventDefault();
            closeConfirmationModal();
            if (onCancel) onCancel();
          };

          modal.style.display = 'flex';

          modal.addEventListener('click', function (e) {
            if (e.target === modal) {
              closeConfirmationModal();
              if (onCancel) onCancel();
            }
          });

          const escHandler = function (e) {
            if (e.key === 'Escape') {
              closeConfirmationModal();
              if (onCancel) onCancel();
              document.removeEventListener('keydown', escHandler);
            }
          };
          document.addEventListener('keydown', escHandler);
        }

        function closeConfirmationModal() {
          const modal = document.getElementById('confirmationModal');
          modal.style.display = 'none';
        }

        function closeNotification() {
          const modal = document.getElementById('notificationModal');
          modal.style.display = 'none';
        }

        function showSuccess(message, title = 'Sukses') {
          showNotification('success', title, message);
        }

        function showError(message, title = 'Error') {
          showNotification('error', title, message);
        }

        function showInfo(message, title = 'Info') {
          showNotification('info', title, message);
        }

        function showWarning(message, title = 'Peringatan') {
          showNotification('warning', title, message);
        }

        // ============================================================
        // FUNGSI UTAMA AFFILIATES
        // ============================================================

        async function loadAffiliates(filter = 'pending') {
          currentFilter = filter;
          try {
            let url = '/api/admin/users';
            const response = await fetch(url);
            const data = await response.json();

            if (data.success) {
              allAffiliates = data.data.filter(u => u.affiliate_status && u.affiliate_status !== 'inactive');

              updateStats(allAffiliates);

              const filtered = allAffiliates.filter(affiliate => {
                if (filter === 'all') return true;
                if (filter === 'pending') return affiliate.affiliate_status === 'pending';
                if (filter === 'approved') return affiliate.affiliate_status === 'approved';
                if (filter === 'rejected') return affiliate.affiliate_status === 'rejected';
                return true;
              });

              displayAffiliates(filtered);
              updateTabStyles(filter);
            }
          } catch (error) {
            console.error('Error loading affiliates:', error);
            showError('Gagal memuat affiliates');
          }
        }

        function updateStats(affiliates) {
          const total = affiliates.length;
          const pending = affiliates.filter(a => a.affiliate_status === 'pending').length;
          const approved = affiliates.filter(a => a.affiliate_status === 'approved').length;
          const rejected = affiliates.filter(a => a.affiliate_status === 'rejected').length;

          document.getElementById('totalAffiliates').textContent = total;
          document.getElementById('pendingAffiliates').textContent = pending;
          document.getElementById('approvedAffiliates').textContent = approved;

          document.getElementById('pendingCount').textContent = pending;
          document.getElementById('approvedCount').textContent = approved;
          document.getElementById('rejectedCount').textContent = rejected;

        }

        function displayAffiliates(affiliates) {
          const container = document.getElementById('affiliatesContainer');

          if (!affiliates || affiliates.length === 0) {
            container.innerHTML = `
              <div class="col-span-full text-center py-12">
                <div class="flex flex-col items-center">
                  <div class="relative">
                    <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-3 border-white/50 float-slow">
                      <i class="fas fa-user-tie text-2xl text-emerald-300"></i>
                    </div>
                    <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                      <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                    </div>
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak Ada Affiliates</h3>
                  <p class="text-base text-emerald-700 font-medium max-w-md">Tidak ada affiliates yang cocok dengan filter Anda.</p>
                  ${currentFilter !== 'all' ? `
                    <button onclick="loadAffiliates('all')" class="mt-5 px-5 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-sm font-extrabold shadow-lg flex items-center gap-2">
                      <i class="fas fa-eye text-xs"></i>
                      Lihat Semua
                    </button>
                  ` : ''}
                </div>
              </div>
            `;
            return;
          }

          container.innerHTML = affiliates.slice(0, 6).map(affiliate => {
            const statusConfig = {
              'pending': { bg: 'gradient-pending', text: 'text-white', icon: 'fas fa-clock', badge: 'Menunggu', highlight: true },
              'approved': { bg: 'gradient-approved', text: 'text-white', icon: 'fas fa-check-circle', badge: 'Disetujui' },
              'rejected': { bg: 'gradient-rejected', text: 'text-white', icon: 'fas fa-times-circle', badge: 'Ditolak' }
            }[affiliate.affiliate_status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-user', badge: 'Tidak Diketahui' };

            const userStatusConfig = {
              'active': { bg: 'gradient-active', text: 'text-white', icon: 'fas fa-check-circle' },
              'inactive': { bg: 'gradient-inactive', text: 'text-white', icon: 'fas fa-times-circle' }
            }[affiliate.status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-user' };

            const joinDate = affiliate.created_at ? new Date(affiliate.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

            return `
              <div class="glass-futuristic rounded-xl overflow-hidden group card-futuristic border border-white/50 ${statusConfig.highlight ? 'border-l-4 border-l-amber-500' : ''}">
                <!-- Header with avatar -->
                <div class="px-4 py-3 border-b border-white/30 bg-white/20 backdrop-blur flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-10 h-10 gradient-primary rounded-full flex items-center justify-center text-white font-extrabold text-base shadow-lg border-2 border-white/30">
                      ${affiliate.name.charAt(0).toUpperCase()}
                    </div>
                    <div>
                      <h3 class="font-extrabold text-sm text-gray-900">${affiliate.name}</h3>
                      <div class="flex items-center gap-1 text-sm text-emerald-700 mt-0.5">
                        <i class="fas fa-envelope text-emerald-400"></i>
                        <span class="truncate max-w-[120px] font-medium">${affiliate.email}</span>
                      </div>
                    </div>
                  </div>
                  <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    ${affiliate.affiliate_status === 'pending' ? `
                      <button onclick="showApprovalModal(${affiliate.id})" class="w-7 h-7 rounded-lg bg-white/60 hover:bg-white/80 text-emerald-700 transition-colors flex items-center justify-center border border-white/30" title="Tinjau">
                        <i class="fas fa-eye text-xs"></i>
                      </button>
                    ` : ''}
                    <button onclick="viewAffiliate(${affiliate.id})" class="w-7 h-7 rounded-lg bg-white/60 hover:bg-white/80 text-emerald-700 transition-colors flex items-center justify-center border border-white/30" title="Lihat">
                      <i class="fas fa-external-link-alt text-xs"></i>
                    </button>
                  </div>
                </div>

                <!-- Content -->
                <div class="p-4">
                  <div class="space-y-3">
                    <!-- Status Badges -->
                    <div class="flex flex-wrap gap-1.5">
                      <span class="px-2.5 py-1.5 rounded-lg text-sm font-extrabold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-1 border border-white/30">
                        <i class="${statusConfig.icon} text-xs"></i>
                        ${statusConfig.badge}
                      </span>
                    </div>

                    <!-- Details -->
                    <div class="space-y-2 text-sm">
                      <div class="flex items-center justify-between">
                        <span class="text-emerald-700 font-bold flex items-center gap-1">
                          <i class="fas fa-id-card text-emerald-400"></i>
                          ID Pengguna
                        </span>
                        <span class="font-extrabold text-gray-900 bg-white/60 px-2 py-1 rounded-lg border border-white/60">#${affiliate.id}</span>
                      </div>
                      
                      <div class="flex items-center justify-between">
                        <span class="text-emerald-700 font-bold flex items-center gap-1">
                          <i class="fas fa-calendar-plus text-emerald-400"></i>
                          Tanggal Daftar
                        </span>
                        <span class="font-extrabold text-gray-900">${joinDate}</span>
                      </div>

                      ${affiliate.referral_code ? `
                        <div class="flex items-center justify-between">
                          <span class="text-emerald-700 font-bold flex items-center gap-1">
                            <i class="fas fa-link text-emerald-400"></i>
                            Kode Referral
                          </span>
                          <span class="font-extrabold text-gray-900 bg-white/60 px-2 py-1 rounded-lg border border-white/60">${affiliate.referral_code}</span>
                        </div>
                      ` : ''}
                    </div>
                  </div>
                </div>

                <!-- Footer with actions -->
                <div class="px-4 py-3 bg-white/30 backdrop-blur border-t border-white/30">
                  ${affiliate.affiliate_status === 'pending' ? `
                    <div class="flex gap-2">
                      <button onclick="approveAffiliate(${affiliate.id})" class="flex-1 text-sm font-extrabold text-white bg-gradient-to-r from-green-600 to-emerald-600 hover:opacity-90 py-2 rounded-lg transition-all duration-300 flex items-center justify-center gap-1 shadow-lg">
                        <i class="fas fa-check text-xs"></i>
                        Setujui
                      </button>
                      <button onclick="rejectAffiliate(${affiliate.id})" class="flex-1 text-sm font-extrabold text-white bg-gradient-to-r from-red-600 to-rose-600 hover:opacity-90 py-2 rounded-lg transition-all duration-300 flex items-center justify-center gap-1 shadow-lg">
                        <i class="fas fa-times text-xs"></i>
                        Tolak
                      </button>
                    </div>
                  ` : `
                    <div class="flex justify-between text-sm text-emerald-700">
                      <span class="flex items-center gap-1 font-bold">
                        <i class="fas fa-info-circle text-emerald-400"></i>
                        Status: ${affiliate.affiliate_status === 'approved' ? 'Disetujui' : affiliate.affiliate_status === 'rejected' ? 'Ditolak' : affiliate.affiliate_status}
                      </span>
                      <button onclick="showApprovalModal(${affiliate.id})" class="text-emerald-700 hover:text-emerald-800 font-extrabold flex items-center gap-1">
                        <i class="fas fa-edit text-sm"></i>
                        Edit
                      </button>
                    </div>
                  `}
                </div>
              </div>
            `;
          }).join('');
        }

        function updateTabStyles(activeFilter) {
          const tabs = ['pending', 'approved', 'rejected', 'all'];
          tabs.forEach(tab => {
            const tabElement = document.getElementById(`tab${tab.charAt(0).toUpperCase() + tab.slice(1)}`);
            if (tabElement) {
              if (tab === activeFilter) {
                tabElement.classList.remove('tab-inactive');
                tabElement.classList.add('tab-active');
              } else {
                tabElement.classList.remove('tab-active');
                tabElement.classList.add('tab-inactive');
              }
            }
          });
        }

        async function showApprovalModal(userId) {
          selectedUserId = userId;
          const affiliate = allAffiliates.find(a => a.id === userId);

          if (affiliate) {
            document.getElementById('modalTitle').textContent =
              affiliate.affiliate_status === 'pending' ? 'Tinjau Aplikasi Affiliate' : 'Edit Status Affiliate';

            const content = `
              <div class="space-y-4">
                <!-- Affiliate Info -->
                <div class="flex items-center gap-3 p-4 bg-gradient-to-r from-green-50/80 to-emerald-50/80 backdrop-blur rounded-xl border border-green-200/50">
                  <div class="w-14 h-14 gradient-primary rounded-full flex items-center justify-center text-white font-extrabold text-xl shadow-lg border-3 border-white/50">
                    ${affiliate.name.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <h4 class="font-extrabold text-base text-gray-900">${affiliate.name}</h4>
                    <p class="text-sm text-gray-600">${affiliate.email}</p>
                    <p class="text-sm text-gray-500 mt-1">ID Pengguna: #${affiliate.id}</p>
                  </div>
                </div>

                <!-- Current Status -->
                <div class="bg-white/60 backdrop-blur p-4 rounded-xl border border-white/60">
                  <p class="text-sm font-extrabold text-emerald-700 mb-2">Status Saat Ini</p>
                  <div class="flex items-center gap-2">
                    <span class="px-3 py-1.5 rounded-lg text-sm font-extrabold 
                      ${affiliate.affiliate_status === 'pending' ? 'gradient-pending text-white' :
                affiliate.affiliate_status === 'approved' ? 'gradient-approved text-white' :
                  'gradient-rejected text-white'} 
                      flex items-center gap-1 border border-white/30">
                      <i class="${affiliate.affiliate_status === 'pending' ? 'fas fa-clock' :
                affiliate.affiliate_status === 'approved' ? 'fas fa-check-circle' :
                  'fas fa-times-circle'}"></i>
                      ${affiliate.affiliate_status === 'pending' ? 'Menunggu' :
                affiliate.affiliate_status === 'approved' ? 'Disetujui' : 'Ditolak'}
                    </span>
                    <span class="text-sm font-medium text-gray-500">
                      Terdaftar: ${new Date(affiliate.created_at).toLocaleDateString('id-ID')}
                    </span>
                  </div>
                </div>
              </div>
            `;

            document.getElementById('modalContent').innerHTML = content;
            document.getElementById('approvalModal').classList.remove('hidden');
            document.getElementById('approvalModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeApprovalModal() {
          selectedUserId = null;
          document.getElementById('approvalModal').classList.add('hidden');
          document.getElementById('approvalModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        // ============================================================
        // FUNGSI MODAL ALASAN PENOLAKAN
        // ============================================================

        function showRejectionModal(userId = null) {
          const id = userId || selectedUserId;
          if (!id) return;

          const affiliate = allAffiliates.find(a => a.id === id);
          if (!affiliate) return;

          currentRejectionAffiliate = affiliate;

          document.getElementById('rejectionAffiliateName').textContent = affiliate.name;
          document.getElementById('rejectionAffiliateEmail').textContent = affiliate.email;
          document.getElementById('rejectionAffiliateId').textContent = affiliate.id;

          const avatarEl = document.querySelector('#rejectionAffiliateInfo .w-14.h-14');
          if (avatarEl) {
            avatarEl.innerHTML = affiliate.name.charAt(0).toUpperCase();
          }

          document.getElementById('rejectionReasonInput').value = '';
          resetQuickReasonButtons();
          updateSubmitButton();

          closeApprovalModal();
          document.getElementById('rejectionModal').classList.remove('hidden');
          document.getElementById('rejectionModal').classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeRejectionModal() {
          currentRejectionAffiliate = null;
          document.getElementById('rejectionModal').classList.add('hidden');
          document.getElementById('rejectionModal').classList.remove('flex');
          document.body.style.overflow = '';

          if (selectedUserId) {
            showApprovalModal(selectedUserId);
          }
        }

        function selectReason(reason) {
          resetQuickReasonButtons();

          const buttons = document.querySelectorAll('.quick-reason-btn');
          buttons.forEach(btn => {
            if (btn.textContent.includes(reason)) {
              btn.classList.add('selected');
            }
          });

          document.getElementById('rejectionReasonInput').value = reason;
          updateSubmitButton();
        }

        function resetQuickReasonButtons() {
          const buttons = document.querySelectorAll('.quick-reason-btn');
          buttons.forEach(btn => {
            btn.classList.remove('selected');
          });
        }

        function updateSubmitButton() {
          const reason = document.getElementById('rejectionReasonInput').value.trim();
          const submitBtn = document.getElementById('submitRejectionBtn');

          if (reason.length >= 10) {
            submitBtn.disabled = false;
          } else {
            submitBtn.disabled = true;
          }
        }

        async function submitRejection() {
          if (!currentRejectionAffiliate) return;

          const reason = document.getElementById('rejectionReasonInput').value.trim();
          if (reason.length < 10) {
            showWarning('Alasan penolakan harus minimal 10 karakter');
            return;
          }

          showConfirmationModal(
            'reject',
            'Konfirmasi Penolakan',
            `Apakah Anda yakin ingin menolak aplikasi affiliate dari "${currentRejectionAffiliate.name}"?`,
            'Ya, Tolak',
            'Batal',
            async function () {
              try {
                const response = await fetch(`/api/admin/affiliates/${currentRejectionAffiliate.id}/reject`, {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ reason })
                });
                const data = await response.json();

                if (data.success) {
                  showNotification('reject', 'Berhasil Ditolak',
                    `Affiliate "${currentRejectionAffiliate.name}" telah berhasil ditolak.`);

                  closeRejectionModal();
                  loadAffiliates(currentFilter);
                } else {
                  showNotification('error', 'Gagal Menolak',
                    `Gagal menolak affiliate: ${data.message || 'Error tidak diketahui'}`);
                }
              } catch (error) {
                console.error('Error rejecting affiliate:', error);
                showNotification('error', 'Gagal Menolak',
                  `Terjadi kesalahan: ${error.message}`);
              }
            }
          );
        }

        // ============================================================
        // FUNGSI APPROVE
        // ============================================================

        async function approveAffiliate(userId = null) {
          const id = userId || selectedUserId;
          if (!id) return;

          const affiliate = allAffiliates.find(a => a.id === id);
          const affiliateName = affiliate ? affiliate.name : 'affiliate ini';

          showConfirmationModal(
            'approve',
            'Setujui Affiliate',
            `Apakah Anda yakin ingin menyetujui aplikasi affiliate dari "${affiliateName}"?`,
            'Ya, Setujui',
            'Batal',
            async function () {
              try {
                const response = await fetch(`/api/admin/affiliates/${id}/approve`, {
                  method: 'PUT'
                });
                const data = await response.json();

                if (data.success) {
                  showNotification('approve', 'Berhasil Disetujui',
                    `Affiliate "${affiliateName}" telah berhasil disetujui.`);

                  closeApprovalModal();
                  loadAffiliates(currentFilter);
                } else {
                  showNotification('error', 'Gagal Menyetujui',
                    `Gagal menyetujui affiliate: ${data.message || 'Error tidak diketahui'}`);
                }
              } catch (error) {
                console.error('Error approving affiliate:', error);
                showNotification('error', 'Gagal Menyetujui',
                  `Terjadi kesalahan: ${error.message}`);
              }
            }
          );
        }

        async function rejectAffiliate(userId = null) {
          const id = userId || selectedUserId;
          if (!id) return;

          const affiliate = allAffiliates.find(a => a.id === id);
          if (!affiliate) return;

          showRejectionModal(id);
        }

        function viewAffiliate(userId) {
          const affiliate = allAffiliates.find(a => a.id === userId);
          if (!affiliate) return;

          const modal = document.getElementById('affiliateDetailModal');
          const content = `
            <div class="space-y-4">
              <div class="flex flex-col items-center text-center">
                <div class="w-20 h-20 gradient-primary rounded-full flex items-center justify-center text-white font-extrabold text-3xl mb-3 shadow-2xl border-4 border-white/50">
                  ${affiliate.name.charAt(0).toUpperCase()}
                </div>
                <h2 class="font-extrabold text-xl text-gray-900 mb-1">${affiliate.name}</h2>
                <p class="text-base text-emerald-700 font-medium mb-2">${affiliate.email}</p>
                <p class="text-sm text-gray-500 bg-white/60 px-4 py-1.5 rounded-xl border border-white/60">ID: #${affiliate.id}</p>
              </div>

              <div class="space-y-3 bg-white/60 backdrop-blur rounded-xl p-4 border border-white/60">
                <div class="flex items-center justify-between">
                  <span class="text-sm font-bold text-emerald-700 flex items-center gap-1">
                    <i class="fas fa-calendar-plus text-emerald-400"></i>
                    Tanggal Daftar
                  </span>
                  <span class="text-sm font-extrabold text-gray-900">${affiliate.created_at ? new Date(affiliate.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-'}</span>
                </div>
                
                ${affiliate.referral_code ? `
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-bold text-emerald-700 flex items-center gap-1">
                      <i class="fas fa-link text-emerald-400"></i>
                      Kode Referral
                    </span>
                    <span class="text-sm font-extrabold text-gray-900 bg-white/80 px-3 py-1 rounded-lg border border-white/60">${affiliate.referral_code}</span>
                  </div>
                ` : ''}

                <div class="flex items-center justify-between">
                  <span class="text-sm font-bold text-emerald-700 flex items-center gap-1">
                    <i class="fas fa-user-tie text-emerald-400"></i>
                    Status Affiliate
                  </span>
                  <span class="px-3 py-1.5 rounded-lg text-sm font-extrabold 
                    ${affiliate.affiliate_status === 'pending' ? 'gradient-pending text-white' :
              affiliate.affiliate_status === 'approved' ? 'gradient-approved text-white' :
                'gradient-rejected text-white'}">
                    ${affiliate.affiliate_status === 'pending' ? 'Menunggu' :
              affiliate.affiliate_status === 'approved' ? 'Disetujui' : 'Ditolak'}
                  </span>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-sm font-bold text-emerald-700 flex items-center gap-1">
                    <i class="fas fa-user text-emerald-400"></i>
                    Status Pengguna
                  </span>
                </div>
              </div>

              <button onclick="closeAffiliateDetailModal()" 
                class="w-full gradient-primary text-white py-3 rounded-xl hover:opacity-90 transition-all duration-300 text-base font-extrabold shadow-lg">
                Tutup
              </button>
            </div>
          `;

          document.getElementById('affiliateDetailContent').innerHTML = content;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeAffiliateDetailModal() {
          const modal = document.getElementById('affiliateDetailModal');
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }

        // Search and filter
        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            filterAffiliates();
          }, 300);
        });

        function filterAffiliates() {
          const search = document.getElementById('searchInput').value.toLowerCase();

          const filtered = allAffiliates.filter(affiliate => {
            if (currentFilter !== 'all') {
              if (currentFilter === 'pending' && affiliate.affiliate_status !== 'pending') return false;
              if (currentFilter === 'approved' && affiliate.affiliate_status !== 'approved') return false;
              if (currentFilter === 'rejected' && affiliate.affiliate_status !== 'rejected') return false;
            }

            const matchSearch = search === '' ||
              affiliate.name.toLowerCase().includes(search) ||
              affiliate.email.toLowerCase().includes(search) ||
              (affiliate.referral_code && affiliate.referral_code.toLowerCase().includes(search));

            return matchSearch;
          });

          displayAffiliates(filtered);
        }

        function clearFilters() {
          document.getElementById('searchInput').value = '';
          filterAffiliates();
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', function () {
          const closeBtn = document.getElementById('closeNotificationModalBtn');
          if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeNotification();
            });
          }

          const cancelConfirmationBtn = document.getElementById('cancelConfirmationBtn');
          if (cancelConfirmationBtn) {
            cancelConfirmationBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeConfirmationModal();
            });
          }

          const rejectionTextarea = document.getElementById('rejectionReasonInput');
          if (rejectionTextarea) {
            rejectionTextarea.addEventListener('input', updateSubmitButton);
          }

          const notificationModal = document.getElementById('notificationModal');
          if (notificationModal) {
            notificationModal.addEventListener('click', function (e) {
              if (e.target === notificationModal) {
                closeNotification();
              }
            });
          }

          const confirmationModal = document.getElementById('confirmationModal');
          if (confirmationModal) {
            confirmationModal.addEventListener('click', function (e) {
              if (e.target === confirmationModal) {
                closeConfirmationModal();
              }
            });
          }

          const detailModal = document.getElementById('affiliateDetailModal');
          if (detailModal) {
            detailModal.addEventListener('click', (e) => {
              if (e.target === detailModal) {
                closeAffiliateDetailModal();
              }
            });
          }

          const approvalModal = document.getElementById('approvalModal');
          if (approvalModal) {
            approvalModal.addEventListener('click', (e) => {
              if (e.target === approvalModal) {
                closeApprovalModal();
              }
            });
          }

          const rejectionModal = document.getElementById('rejectionModal');
          if (rejectionModal) {
            rejectionModal.addEventListener('click', (e) => {
              if (e.target === rejectionModal) {
                closeRejectionModal();
              }
            });
          }

          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
              closeNotification();
              closeConfirmationModal();
              closeApprovalModal();
              closeAffiliateDetailModal();
              closeRejectionModal();
            }
          });

          loadAffiliates('pending');
        });

        setInterval(() => loadAffiliates(currentFilter), 60000);
      </script>
</body>

</html>
