              ${affiliate.affiliate_status === 'pending' ? `
                <div class="flex gap-3">
                  <button onclick="approveAffiliate(${affiliate.id})" class="flex-1 text-sm font-semibold text-white bg-green-600 hover:bg-green-700 py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
                    <i class="fas fa-check"></i>
                    Setujui
                  </button>
                  <button onclick="rejectAffiliate(${affiliate.id})" class="flex-1 text-sm font-semibold text-white bg-red-600 hover:bg-red-700 py-2.5 rounded-lg transition-colors flex items-center justify-center gap-2">
                    <i class="fas fa-times"></i>
                    Tolak
                  </button>
                </div>
              ` : `
                <div class="flex justify-between text-sm text-gray-600">
                  <span class="flex items-center gap-2">
                    <i class="fas fa-info-circle text-gray-400"></i>
