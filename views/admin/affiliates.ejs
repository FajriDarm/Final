              <div class="w-16 h-16 user-avatar rounded-full flex items-center justify-center text-white font-bold text-xl">
                ${affiliate.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <h4 class="font-bold text-lg text-gray-900">${affiliate.name}</h4>
