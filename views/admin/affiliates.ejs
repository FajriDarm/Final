            class="w-full bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3.5 px-6 rounded-xl font-medium hover:from-green-700 hover:to-emerald-700 transition-all duration-200">
            Tutup
          </button>
        </div>
      </div>

      <!-- Modal Konfirmasi (untuk approve/reject) -->
      <div id="confirmationModal" class="modal-notification" style="display: none;">
        <div class="modal-box">
          <span class="notification-icon warning" id="confirmationIcon">
            <i class="fas fa-exclamation-triangle"></i>
          </span>
