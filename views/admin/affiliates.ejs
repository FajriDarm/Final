      <!-- Affiliate Detail Modal Premium - Diperbesar ukuran fontnya -->
      <div id="affiliateDetailModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div
          class="bg-white/90 backdrop-blur-2xl rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-hidden flex flex-col border border-white/50">
          <div class="p-6 overflow-y-auto modern-scrollbar" id="affiliateDetailContent">
            <!-- Content akan diisi oleh JS -->
