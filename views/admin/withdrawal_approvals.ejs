      <script>
        let currentPayoutId = null;
        let currentTab = 'pending';
        const token = localStorage.getItem("token");

        // ============================================================
        // FUNGSI TAB
        // ============================================================

        function switchTab(tab) {
          currentTab = tab;

          // Sembunyikan semua tab content
          document.querySelectorAll(".tab-content").forEach((el) => {
            el.classList.add("hidden");
          });

          // Update tab buttons
          document.querySelectorAll(".tab-btn").forEach((btn) => {
            btn.classList.remove("tab-active");
            btn.classList.add("tab-inactive");
          });

          // Aktifkan tab yang dipilih
          document.getElementById(`tab-${tab}`).classList.remove("tab-inactive");
          document.getElementById(`tab-${tab}`).classList.add("tab-active");

          // Tampilkan tab content yang dipilih
          document.getElementById(`${tab}-tab`).classList.remove("hidden");
          document.getElementById(`${tab}-tab`).classList.add("fade-in");

          loadWithdrawals(tab);
        }

        // ============================================================
        // FUNGSI NOTIFIKASI
        // ============================================================

        function showSuccess(message) {
          const toast = document.createElement('div');
          toast.className = 'notification-toast';
          toast.innerHTML = `
            <div class="glass-futuristic rounded-2xl p-4 shadow-2xl border-l-4 border-green-500 max-w-sm">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 gradient-approved rounded-xl flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-check-circle text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-gray-900 text-sm">Sukses!</p>
                  <p class="text-xs text-gray-600 mt-1">${message}</p>
                </div>
                <button onclick="this.parentElement.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
                  <i class="fas fa-times text-xs"></i>
                </button>
              </div>
            </div>
          `;
          document.body.appendChild(toast);

          setTimeout(() => {
            toast.remove();
          }, 5000);
        }

        function showError(message) {
          const toast = document.createElement('div');
          toast.className = 'notification-toast';
          toast.innerHTML = `
            <div class="glass-futuristic rounded-2xl p-4 shadow-2xl border-l-4 border-red-500 max-w-sm">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-gradient-to-r from-red-600 to-rose-600 rounded-xl flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-exclamation-triangle text-white text-lg"></i>
                </div>
                <div class="flex-1">
                  <p class="font-extrabold text-gray-900 text-sm">Error!</p>
                  <p class="text-xs text-gray-600 mt-1">${message}</p>
                </div>
                <button onclick="this.parentElement.parentElement.parentElement.remove()" class="text-gray-400 hover:text-gray-600">
                  <i class="fas fa-times text-xs"></i>
                </button>
              </div>
            </div>
          `;
          document.body.appendChild(toast);

          setTimeout(() => {
            toast.remove();
          }, 5000);
        }

        // ============================================================
        // FUNGSI UTAMA
        // ============================================================

        async function loadWithdrawals(status) {
          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval?status=${status}`,
              {
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const listId = status + "-list";
            const countId = status + "-count";
            const badgeId = status + "-count-badge";

            // Perbarui statistik
            document.getElementById(countId).textContent = result.data.length;
            document.getElementById(badgeId).textContent = result.data.length;

            // Hitung total jumlah
            const totalAmount = result.data.reduce((sum, payout) => {
              return sum + parseFloat(payout.total_amount || 0);
            }, 0);

            document.getElementById(status + "-amount").textContent =
              "Rp " + totalAmount.toLocaleString("id-ID");

            // Update total entries untuk pagination
            document.getElementById('totalEntries').textContent = result.data.length;
            document.getElementById('endEntry').textContent = Math.min(10, result.data.length);

            if (result.data.length === 0) {
              document.getElementById(listId).innerHTML = `
                <div class="p-12 text-center">
                  <div class="flex flex-col items-center justify-center">
                    <div class="relative">
                      <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-6 border-4 border-white/50 float-slow">
                        <i class="fas fa-inbox text-3xl text-emerald-300"></i>
                      </div>
                      <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                        <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                      </div>
                    </div>
                    <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak ada data</h3>
                    <p class="text-sm text-emerald-700 font-medium">Tidak ada penarikan dengan status ini</p>
                  </div>
                </div>
              `;
              return;
            }

            document.getElementById(listId).innerHTML = result.data
              .map(
                (payout, index) => `
                <div class="p-5 hover:bg-white/40 transition-all duration-300 cursor-pointer border-b border-white/30 last:border-b-0 bg-white/20 backdrop-blur" 
                     onclick="viewDetail(${payout.id})"
                     style="animation: fadeIn 0.3s ease-out ${index * 0.05}s both">
                  <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
                    <div class="flex items-start gap-4 flex-1">
                      <div class="w-12 h-12 bg-white/60 backdrop-blur rounded-xl flex items-center justify-center shadow-lg border border-white/60 flex-shrink-0">
                        <i class="fas fa-user-tie text-emerald-600 text-lg"></i>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-center gap-2 mb-1">
                          <h4 class="font-extrabold text-gray-900 text-base truncate">${payout.affiliate_name}</h4>
                          <span class="px-3 py-1.5 rounded-lg text-[9px] font-extrabold ${getStatusBadge(payout.status)} border border-white/30 flex items-center gap-1">
                            <i class="fas fa-circle text-[6px] mr-1"></i>
                            ${getStatusLabel(payout.status)}
                          </span>
                        </div>
                        <p class="text-xs text-gray-600 mb-2 font-medium">ID: #${payout.id} • ${payout.commission_count} komisi</p>
                        <p class="text-[10px] text-gray-500 flex items-center gap-2">
                          <i class="fas fa-calendar-alt"></i>
                          Diajukan: ${new Date(payout.created_at).toLocaleDateString("id-ID", {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                })}
                        </p>
                        ${payout.finance_note ? `
                          <p class="text-[9px] mt-2 text-blue-700 bg-blue-50/80 backdrop-blur px-3 py-2 rounded-lg border border-blue-200/50">
                            <i class="fas fa-sticky-note mr-1"></i>
                            Catatan Finance: ${payout.finance_note.length > 120 ? payout.finance_note.substring(0, 120) + '...' : payout.finance_note}
                            ${payout.submitted_by_name ? `<span class="text-gray-500 block mt-1">— oleh ${payout.submitted_by_name}</span>` : (payout.submitted_by ? `<span class="text-gray-500 block mt-1">— oleh ID: ${payout.submitted_by}</span>` : '')}
                          </p>
                        ` : ''}
                      </div>
                    </div>
                    <div class="text-right lg:ml-4 flex flex-col items-end">
                      <p class="font-extrabold text-xl text-gray-900 mb-2">Rp ${parseFloat(payout.total_amount).toLocaleString("id-ID")}</p>
                      ${status === "pending" ? `
                        <div class="flex gap-2">
                          <button class="px-4 py-2 bg-gradient-to-r from-red-600 to-rose-600 text-white rounded-lg hover:opacity-90 transition-all duration-300 text-[10px] font-extrabold shadow-lg flex items-center gap-1 border border-white/30"
                                  onclick="event.stopPropagation(); openRejectModal(${payout.id}, '${payout.affiliate_name}', '${payout.total_amount}')">
                            <i class="fas fa-times text-[8px]"></i>
                            Tolak
                          </button>
                          <button class="px-4 py-2 gradient-approved text-white rounded-lg hover:opacity-90 transition-all duration-300 text-[10px] font-extrabold shadow-lg flex items-center gap-1 border border-white/30"
                                  onclick="event.stopPropagation(); openApproveModal(${payout.id}, '${payout.affiliate_name}', '${payout.total_amount}')">
                            <i class="fas fa-check text-[8px]"></i>
                            Setujui
                          </button>
                        </div>
                      ` : ''}
                    </div>
                  </div>
                </div>
              `,
              )
              .join("");
          } catch (error) {
            console.error("Error:", error);
            showError("Gagal memuat data penarikan: " + error.message);
          }
        }

        // ============================================================
        // FUNGSI DETAIL
        // ============================================================

        async function viewDetail(payoutId) {
          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval/${payoutId}`,
              {
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const payout = result.data;

            // Prepare proof HTML (image or PDF) if available
            let proofHtml = '';
            if (payout.proof_file) {
              const pf = payout.proof_file;
              if (pf.toLowerCase().endsWith('.pdf')) {
                proofHtml = `
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50 md:col-span-2">
                    <h4 class="text-xs font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                      <i class="fas fa-file-pdf text-red-600"></i>
                      Bukti Pembayaran
                    </h4>
                    <div class="bg-red-50/80 backdrop-blur border border-red-200/50 rounded-xl p-4 text-center">
                      <i class="fas fa-file-pdf text-red-600 text-3xl mb-2"></i>
                      <p class="text-xs font-extrabold text-gray-900 mb-2">File PDF</p>
                      <a href="${pf}" target="_blank" class="w-full px-4 py-2 gradient-info text-white rounded-lg text-[10px] font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg inline-block">Buka File PDF</a>
                    </div>
                  </div>
                `;
              } else {
                proofHtml = `
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50 md:col-span-2">
                    <h4 class="text-xs font-extrabold text-emerald-800 mb-3 flex items-center gap-1.5">
                      <i class="fas fa-image text-emerald-600"></i>
                      Bukti Pembayaran
                    </h4>
                    <div class="text-center">
                      <img src="${pf}" alt="Bukti Transfer" class="w-full rounded-xl border border-white/50 mb-2">
                      <a href="${pf}" target="_blank" class="w-full px-4 py-2 gradient-info text-white rounded-lg text-[10px] font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg inline-block">Lihat Bukti (Buka di tab baru)</a>
                    </div>
                  </div>
                `;
              }
            }

            let detailHTML = `
              <div class="space-y-4">
                <!-- Kartu Status -->
                <div class="glass-futuristic rounded-xl p-4 border ${getStatusBorder(payout.status)}">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Status Penarikan</p>
                      <p class="text-sm font-extrabold text-gray-900">${getStatusLabel(payout.status)}</p>
                    </div>
                    <span class="px-4 py-2 rounded-lg text-[10px] font-extrabold ${getStatusFullBadge(payout.status)} border border-white/30 flex items-center gap-1">
                      <i class="fas ${getStatusIcon(payout.status)} text-[8px]"></i>
                      ${getStatusLabel(payout.status)}
                    </span>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <!-- Kartu Info Affiliate -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                    <div class="flex items-center gap-2 mb-3">
                      <div class="w-8 h-8 gradient-primary rounded-lg flex items-center justify-center">
                        <i class="fas fa-user-tie text-white text-xs"></i>
                      </div>
                      <h4 class="text-xs font-extrabold text-gray-900">Informasi Affiliate</h4>
                    </div>
                    <div class="space-y-2 text-[10px]">
                      <div>
                        <p class="font-bold text-emerald-700">Nama Affiliate</p>
                        <p class="font-extrabold text-gray-900">${payout.affiliate_name}</p>
                      </div>
                      <div>
                        <p class="font-bold text-emerald-700">Email</p>
                        <p class="font-extrabold text-gray-900">${payout.affiliate_email}</p>
                      </div>
                      <div>
                        <p class="font-bold text-emerald-700">Tanggal Permohonan</p>
                        <p class="font-extrabold text-gray-900">${new Date(payout.created_at).toLocaleString("id-ID", {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            })}</p>
                      </div>
                    </div>
                  </div>

                  <!-- Kartu Info Penarikan -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50">
                    <div class="flex items-center gap-2 mb-3">
                      <div class="w-8 h-8 gradient-secondary rounded-lg flex items-center justify-center">
                        <i class="fas fa-money-bill-wave text-white text-xs"></i>
                      </div>
                      <h4 class="text-xs font-extrabold text-gray-900">Detail Penarikan</h4>
                    </div>
                    <div class="space-y-2">
                      <div>
                        <p class="text-[10px] font-bold text-emerald-700">Total Jumlah</p>
                        <p class="font-extrabold text-xl text-emerald-700">Rp ${parseFloat(payout.total_amount).toLocaleString("id-ID")}</p>
                      </div>
                      <div>
                        <p class="text-[10px] font-bold text-emerald-700">Jumlah Komisi</p>
                        <p class="font-extrabold text-base text-gray-900">${payout.commission_count} komisi</p>
                      </div>
                    </div>
                  </div>

                  <!-- Kartu Info Bank -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50 md:col-span-2">
                    <div class="flex items-center gap-2 mb-3">
                      <div class="w-8 h-8 gradient-info rounded-lg flex items-center justify-center">
                        <i class="fas fa-university text-white text-xs"></i>
                      </div>
                      <h4 class="text-xs font-extrabold text-gray-900">Informasi Bank</h4>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                      <div>
                        <p class="text-[9px] font-bold text-emerald-700">Nama Bank</p>
                        <p class="font-extrabold text-gray-900 text-sm">${payout.bank_name || "-"}</p>
                      </div>
                      <div>
                        <p class="text-[9px] font-bold text-emerald-700">Nomor Rekening</p>
                        <p class="font-extrabold text-gray-900 text-sm">${payout.bank_account_number || "-"}</p>
                      </div>
                      <div>
                        <p class="text-[9px] font-bold text-emerald-700">Atas Nama</p>
                        <p class="font-extrabold text-gray-900 text-sm">${payout.bank_account_name || "-"}</p>
                      </div>
                    </div>
                  </div>

                  <!-- Finance Note (if any) -->
                  ${payout.finance_note ? `
                    <div class="glass-futuristic rounded-xl p-4 border border-blue-200/50 md:col-span-2">
                      <div class="flex items-center gap-2 mb-2">
                        <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                          <i class="fas fa-sticky-note text-blue-600 text-xs"></i>
                        </div>
                        <h4 class="text-xs font-extrabold text-gray-900">Catatan Finance</h4>
                      </div>
                      <div class="bg-blue-50/80 backdrop-blur rounded-lg p-3 border border-blue-200/50">
                        <p class="text-xs text-blue-800">${payout.finance_note}</p>
                        ${payout.submitted_by_name ? `<p class="text-[9px] text-gray-600 mt-2">Dikirim oleh: ${payout.submitted_by_name} • ${payout.submitted_at ? new Date(payout.submitted_at).toLocaleString('id-ID') : ''}</p>` : (payout.submitted_by ? `<p class="text-[9px] text-gray-600 mt-2">Dikirim oleh ID: ${payout.submitted_by} • ${payout.submitted_at ? new Date(payout.submitted_at).toLocaleString('id-ID') : ''}</p>` : '')}
                      </div>
                    </div>
                  ` : ''}

                  <!-- Proof (if paid) -->
                  ${payout.status === 'paid' ? proofHtml : ''}

                  <!-- Kartu Komisi -->
                  <div class="glass-futuristic rounded-xl p-4 border border-white/50 md:col-span-2">
                    <div class="flex items-center justify-between mb-3">
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 gradient-accent rounded-lg flex items-center justify-center">
                          <i class="fas fa-percentage text-white text-xs"></i>
                        </div>
                        <h4 class="text-xs font-extrabold text-gray-900">Komisi yang Ditarik</h4>
                      </div>
                      <span class="px-3 py-1.5 bg-white/60 backdrop-blur rounded-lg text-[9px] font-extrabold text-emerald-700 border border-white/60">
                        ${payout.commissions.length} item
                      </span>
                    </div>
                    <div class="bg-white/40 backdrop-blur rounded-lg p-3 max-h-60 overflow-y-auto modern-scrollbar border border-white/30">
                      ${payout.commissions
                .map(
                  (comm, idx) => `
                          <div class="flex items-center justify-between py-2.5 ${idx > 0 ? "border-t border-white/30" : ""}">
                            <div class="flex items-center gap-2">
                              <div class="w-7 h-7 bg-white/60 rounded-lg flex items-center justify-center border border-white/60">
                                <i class="fas fa-receipt text-emerald-600 text-[10px]"></i>
                              </div>
                              <div>
                                <p class="font-extrabold text-gray-900 text-xs">${comm.description}</p>
                                <p class="text-[8px] font-medium text-gray-500">${new Date(comm.created_at).toLocaleDateString("id-ID")}</p>
                              </div>
                            </div>
                            <div class="text-right">
                              <p class="font-extrabold text-gray-900 text-xs">Rp ${parseFloat(comm.amount).toLocaleString("id-ID")}</p>
                              <p class="text-[8px] font-medium text-gray-500">Komisi</p>
                            </div>
                          </div>
                        `,
                )
                .join("")}
                    </div>
                  </div>
                </div>
              </div>
            `;

            document.getElementById("detail-title").textContent =
              `Detail Penarikan - ${payout.affiliate_name}`;
            document.getElementById("detail-id").textContent = payout.id;
            document.getElementById("detail-content").innerHTML = detailHTML;
            document.getElementById("detail-modal").classList.remove("hidden");
          } catch (error) {
            console.error("Error:", error);
            showError("Gagal memuat detail: " + error.message);
          }
        }

        // ============================================================
        // FUNGSI UTILITAS STYLING
        // ============================================================

        function getStatusBadge(status) {
          const badges = {
            pending: "gradient-pending text-white",
            approved: "gradient-approved text-white",
            rejected: "gradient-rejected text-white",
            paid: "gradient-paid text-white",
          };
          return badges[status] || "bg-gray-500 text-white";
        }

        function getStatusFullBadge(status) {
          const badges = {
            pending: "gradient-pending text-white",
            approved: "gradient-approved text-white",
            rejected: "gradient-rejected text-white",
            paid: "gradient-paid text-white",
          };
          return badges[status] || "bg-gray-500 text-white";
        }

        function getStatusBorder(status) {
          const borders = {
            pending: "border-amber-200",
            approved: "border-emerald-200",
            rejected: "border-red-200",
            paid: "border-blue-200",
          };
          return borders[status] || "border-gray-200";
        }

        function getStatusIcon(status) {
          const icons = {
            pending: "fa-clock",
            approved: "fa-check-circle",
            rejected: "fa-times-circle",
            paid: "fa-dollar-sign",
          };
          return icons[status] || "fa-info-circle";
        }

        function getStatusLabel(status) {
          const labels = {
            pending: "Menunggu",
            approved: "Disetujui",
            rejected: "Ditolak",
            paid: "Dibayar",
          };
          return labels[status] || status;
        }

        // ============================================================
        // FUNGSI MODAL
        // ============================================================

        function openApproveModal(payoutId, affiliateName, amount) {
          currentPayoutId = payoutId;
          document.getElementById("approve-affiliate").textContent = affiliateName;
          document.getElementById("approve-amount").textContent =
            "Rp " + parseFloat(amount).toLocaleString("id-ID");
          document.getElementById("approve-note").value = "";
          document.getElementById("approve-modal").classList.remove("hidden");
        }

        async function submitApproval() {
          if (!currentPayoutId) return;

          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval/${currentPayoutId}/approve`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({
                  note: document.getElementById("approve-note").value,
                }),
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            showSuccess("✅ Penarikan berhasil disetujui!");
            closeApproveModal();
            closeDetailModal();
            loadWithdrawals(currentTab);
          } catch (error) {
            console.error("Error:", error);
            showError("Error: " + error.message);
          }
        }

        function openRejectModal(payoutId, affiliateName, amount) {
          currentPayoutId = payoutId;
          document.getElementById("reject-affiliate").textContent = affiliateName;
          document.getElementById("reject-amount").textContent =
            "Rp " + parseFloat(amount).toLocaleString("id-ID");
          document.getElementById("reject-reason").value = "";
          document.getElementById("reject-modal").classList.remove("hidden");
        }

        async function submitReject() {
          if (!currentPayoutId) return;
          const reason = document.getElementById("reject-reason").value.trim();

          if (!reason) {
            showError("Alasan penolakan harus diisi!");
            return;
          }

          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval/${currentPayoutId}/reject`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({
                  reason: reason,
                }),
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            showSuccess("✅ Penarikan berhasil ditolak!");
            closeRejectModal();
            closeDetailModal();
            loadWithdrawals(currentTab);
          } catch (error) {
            console.error("Error:", error);
            showError("Error: " + error.message);
          }
        }

        function closeDetailModal() {
          document.getElementById("detail-modal").classList.add("hidden");
        }

        function closeApproveModal() {
          document.getElementById("approve-modal").classList.add("hidden");
        }

        function closeRejectModal() {
          document.getElementById("reject-modal").classList.add("hidden");
        }

        // ============================================================
        // INITIALIZATION
        // ============================================================

        document.addEventListener("DOMContentLoaded", () => {
          // load utama untuk tab yang aktif (pending)
          loadWithdrawals("pending");
          // juga prefetch approved dan rejected untuk mengisi kartu statistik
          loadWithdrawals("approved");
          loadWithdrawals("rejected");

          // Auto-refresh setiap 30 detik
          setInterval(() => {
            loadWithdrawals('pending');
            loadWithdrawals('approved');
            loadWithdrawals('rejected');
          }, 30000);
        });

        // Tutup modal dengan ESC key
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            if (!document.getElementById('detail-modal').classList.contains('hidden')) {
              closeDetailModal();
            }
            if (!document.getElementById('approve-modal').classList.contains('hidden')) {
              closeApproveModal();
            }
            if (!document.getElementById('reject-modal').classList.contains('hidden')) {
              closeRejectModal();
            }
          }
        });
      </script>
</body>

</html>