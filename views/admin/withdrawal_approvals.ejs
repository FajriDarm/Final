      <script>
        let currentPayoutId = null;
        const token = localStorage.getItem("token");

        // Ganti tab dengan animasi
        function switchTab(tab) {
          document.querySelectorAll(".tab-content").forEach((el) => {
            el.classList.add("hidden");
            el.classList.remove("fade-in");
          });

          document.querySelectorAll(".tab-btn").forEach((el) => {
            el.classList.remove("tab-active", "text-green-600", "bg-white");
            el.classList.add("text-gray-600", "bg-green-50");
          });

          // Aktifkan tab yang dipilih
          event.target.closest(".tab-btn").classList.add("tab-active", "text-green-600", "bg-white");
          event.target.closest(".tab-btn").classList.remove("text-gray-600", "bg-green-50");

          const targetTab = document.getElementById(tab + "-tab");
          targetTab.classList.remove("hidden");
          targetTab.classList.add("fade-in");

          loadWithdrawals(tab);
        }

        // Muat penarikan dengan desain baru
        async function loadWithdrawals(status) {
          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval?status=${status}`,
              {
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const listId = status + "-list";
            const countId = status + "-count";
            const badgeId = status + "-count-badge";

            // Perbarui statistik
            document.getElementById(countId).textContent = result.data.length;
            document.getElementById(badgeId).textContent = result.data.length;

            // Hitung total jumlah
            const totalAmount = result.data.reduce((sum, payout) => {
              return sum + parseFloat(payout.total_amount || 0);
            }, 0);

            document.getElementById(status + "-amount").textContent =
              "Rp " + totalAmount.toLocaleString("id-ID");

            if (result.data.length === 0) {
              document.getElementById(listId).innerHTML = `
              <div class="p-12 text-center">
                <div class="flex flex-col items-center justify-center">
                  <div class="w-20 h-20 bg-gradient-to-br from-gray-100 to-gray-50 rounded-full flex items-center justify-center mb-6 shadow-lg">
                    <i class="fas fa-inbox text-gray-400 text-2xl"></i>
                  </div>
                  <h3 class="text-lg font-semibold text-gray-700 mb-2">Tidak ada data</h3>
                  <p class="text-gray-500">Tidak ada penarikan dengan status ini</p>
                </div>
              </div>
            `;
              return;
            }

            document.getElementById(listId).innerHTML = result.data
              .map(
                (payout, index) => `
                <div class="p-5 hover:bg-green-50 transition-all duration-200 cursor-pointer border-b border-green-100 last:border-b-0" 
                     onclick="viewDetail(${payout.id})"
                     style="animation-delay: ${index * 50}ms">
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex items-start gap-4 flex-1">
                      <div class="w-12 h-12 bg-gradient-to-br from-green-100 to-emerald-100 rounded-xl flex items-center justify-center shadow-sm">
                        <i class="fas fa-user-tie text-green-600"></i>
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-3 mb-1">
                          <h4 class="font-bold text-gray-900 text-lg truncate">${payout.affiliate_name}</h4>
                          <span class="px-3 py-1 rounded-full text-xs font-medium ${getStatusBadge(payout.status)}">
                            <i class="fas fa-circle text-xs mr-1.5"></i>
                            ${getStatusLabel(payout.status)}
                          </span>
                        </div>
                        <p class="text-sm text-gray-600 mb-2">ID: #${payout.id} • ${payout.commission_count} komisi</p>
                        <p class="text-xs text-gray-500 flex items-center gap-2">
                          <i class="fas fa-calendar-alt"></i>
                          Diajukan: ${new Date(payout.created_at).toLocaleDateString("id-ID", {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                })}
                        </p>
                      </div>
                    </div>
                    <div class="text-right ml-4">
                      <p class="font-bold text-2xl text-gray-900 mb-1">Rp ${parseFloat(payout.total_amount).toLocaleString("id-ID")}</p>
                      ${status === "pending" ? `
                        <div class="flex gap-2 mt-3">
                          <button class="px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition duration-200 flex items-center gap-2 text-sm font-medium"
                                  onclick="event.stopPropagation(); openRejectModal(${payout.id}, '${payout.affiliate_name}', '${payout.total_amount}')">
                            <i class="fas fa-times"></i>
                            Tolak
                          </button>
                          <button class="px-4 py-2 gradient-primary text-white rounded-lg hover:shadow-lg transition duration-200 flex items-center gap-2 text-sm font-medium"
                                  onclick="event.stopPropagation(); openApproveModal(${payout.id}, '${payout.affiliate_name}', '${payout.total_amount}')">
                            <i class="fas fa-check"></i>
                            Setujui
                          </button>
                        </div>
                      ` : ''}
                    </div>
                  </div>
                </div>
              `,
              )
              .join("");
          } catch (error) {
            console.error("Error:", error);
            showError("Gagal memuat data penarikan: " + error.message);
          }
        }

        // Lihat detail dengan desain baru
        async function viewDetail(payoutId) {
          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval/${payoutId}`,
              {
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            const payout = result.data;
            let detailHTML = `
            <div class="space-y-6">
              <!-- Kartu Status -->
              <div class="glass-card rounded-xl p-4 border ${getStatusBorder(payout.status)}">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-gray-600">Status Penarikan</p>
                    <p class="text-lg font-bold text-gray-900">${getStatusLabel(payout.status)}</p>
                  </div>
                  <span class="px-4 py-2 rounded-lg ${getStatusFullBadge(payout.status)}">
                    <i class="fas ${getStatusIcon(payout.status)} mr-2"></i>
                    ${getStatusLabel(payout.status)}
                  </span>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Kartu Info Affiliate -->
                <div class="glass-card rounded-xl p-5 border border-green-100">
                  <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 gradient-primary rounded-lg flex items-center justify-center">
                      <i class="fas fa-user-tie text-white"></i>
                    </div>
                    <h4 class="font-semibold text-gray-900">Informasi Affiliate</h4>
                  </div>
                  <div class="space-y-3">
                    <div>
                      <p class="text-sm text-gray-600">Nama Affiliate</p>
                      <p class="font-medium text-gray-900">${payout.affiliate_name}</p>
                    </div>
                    <div>
                      <p class="text-sm text-gray-600">Email</p>
                      <p class="font-medium text-gray-900">${payout.affiliate_email}</p>
                    </div>
                    <div>
                      <p class="text-sm text-gray-600">Tanggal Permohonan</p>
                      <p class="font-medium text-gray-900">${new Date(payout.created_at).toLocaleString("id-ID", {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            })}</p>
                    </div>
                  </div>
                </div>

                <!-- Kartu Info Penarikan -->
                <div class="glass-card rounded-xl p-5 border border-green-100">
                  <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 gradient-secondary rounded-lg flex items-center justify-center">
                      <i class="fas fa-money-bill-wave text-white"></i>
                    </div>
                    <h4 class="font-semibold text-gray-900">Detail Penarikan</h4>
                  </div>
                  <div class="space-y-3">
                    <div>
                      <p class="text-sm text-gray-600">Total Jumlah</p>
                      <p class="font-bold text-2xl text-green-700">Rp ${parseFloat(payout.total_amount).toLocaleString("id-ID")}</p>
                    </div>
                    <div>
                      <p class="text-sm text-gray-600">Jumlah Komisi</p>
                      <p class="font-bold text-xl text-gray-900">${payout.commission_count} komisi</p>
                    </div>
                  </div>
                </div>

                <!-- Kartu Info Bank -->
                <div class="glass-card rounded-xl p-5 border border-green-100 md:col-span-2">
                  <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 gradient-info rounded-lg flex items-center justify-center">
                      <i class="fas fa-university text-white"></i>
                    </div>
                    <h4 class="font-semibold text-gray-900">Informasi Bank</h4>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                      <p class="text-sm text-gray-600">Nama Bank</p>
                      <p class="font-medium text-gray-900 text-lg">${payout.bank_name || "-"}</p>
                    </div>
                    <div>
                      <p class="text-sm text-gray-600">Nomor Rekening</p>
                      <p class="font-medium text-gray-900 text-lg">${payout.bank_account_number || "-"}</p>
                    </div>
                    <div>
                      <p class="text-sm text-gray-600">Atas Nama</p>
                      <p class="font-medium text-gray-900 text-lg">${payout.bank_account_name || "-"}</p>
                    </div>
                  </div>
                </div>

                <!-- Kartu Komisi -->
                <div class="glass-card rounded-xl p-5 border border-green-100 md:col-span-2">
                  <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 gradient-dark rounded-lg flex items-center justify-center">
                        <i class="fas fa-percentage text-white"></i>
                      </div>
                      <h4 class="font-semibold text-gray-900">Komisi yang Ditarik</h4>
                    </div>
                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">
                      ${payout.commissions.length} item
                    </span>
                  </div>
                  <div class="bg-gray-50 rounded-lg p-4 max-h-64 overflow-y-auto scrollbar-hide">
                    ${payout.commissions
                .map(
                  (comm, idx) => `
                        <div class="flex items-center justify-between py-3 ${idx > 0 ? "border-t border-gray-200" : ""}">
                          <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-gradient-to-br from-green-100 to-emerald-100 rounded-lg flex items-center justify-center">
                              <i class="fas fa-receipt text-green-600 text-sm"></i>
                            </div>
                            <div>
                              <p class="font-medium text-gray-900">${comm.description}</p>
                              <p class="text-xs text-gray-500">${new Date(comm.created_at).toLocaleDateString("id-ID")}</p>
                            </div>
                          </div>
                          <div class="text-right">
                            <p class="font-bold text-gray-900">Rp ${parseFloat(comm.amount).toLocaleString("id-ID")}</p>
                            <p class="text-xs text-gray-500">Komisi</p>
                          </div>
                        </div>
                      `,
                )
                .join("")}
                  </div>
                </div>
              </div>
            </div>
          `;

            document.getElementById("detail-title").textContent =
              `Detail Penarikan - ${payout.affiliate_name}`;
            document.getElementById("detail-id").textContent = payout.id;
            document.getElementById("detail-content").innerHTML = detailHTML;
            document.getElementById("detail-modal").classList.remove("hidden");
          } catch (error) {
            console.error("Error:", error);
            showError("Gagal memuat detail: " + error.message);
          }
        }

        // Fungsi utilitas untuk styling
        function getStatusBadge(status) {
          const badges = {
            pending: "bg-yellow-100 text-yellow-800 border border-yellow-200",
            approved: "bg-green-100 text-green-800 border border-green-200",
            rejected: "bg-red-100 text-red-800 border border-red-200",
            paid: "bg-blue-100 text-blue-800 border border-blue-200",
          };
          return badges[status] || "bg-gray-100 text-gray-800 border border-gray-200";
        }

        function getStatusFullBadge(status) {
          const badges = {
            pending: "bg-yellow-500 text-white",
            approved: "bg-green-500 text-white",
            rejected: "bg-red-500 text-white",
            paid: "bg-blue-500 text-white",
          };
          return badges[status] || "bg-gray-500 text-white";
        }

        function getStatusBorder(status) {
          const borders = {
            pending: "border-yellow-200",
            approved: "border-green-200",
            rejected: "border-red-200",
            paid: "border-blue-200",
          };
          return borders[status] || "border-gray-200";
        }

        function getStatusIcon(status) {
          const icons = {
            pending: "fa-clock",
            approved: "fa-check-circle",
            rejected: "fa-times-circle",
            paid: "fa-dollar-sign",
          };
          return icons[status] || "fa-info-circle";
        }

        function getStatusLabel(status) {
          const labels = {
            pending: "Menunggu Persetujuan",
            approved: "Sudah Disetujui",
            rejected: "Ditolak",
            paid: "Sudah Dibayarkan",
          };
          return labels[status] || status;
        }

        // Tampilkan error dengan desain baru
        function showError(message) {
          // Buat notifikasi error
          const errorDiv = document.createElement('div');
          errorDiv.className = 'fixed top-24 right-6 z-50 animate-fade-in';
          errorDiv.innerHTML = `
          <div class="bg-red-50 border border-red-200 rounded-xl p-4 shadow-lg max-w-sm">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-exclamation-triangle text-red-600"></i>
              </div>
              <div>
                <p class="text-red-700 font-medium">Error!</p>
                <p class="text-red-600 text-sm mt-1">${message}</p>
              </div>
            </div>
          </div>
        `;
          document.body.appendChild(errorDiv);

          // Hapus setelah 5 detik
          setTimeout(() => {
            errorDiv.remove();
          }, 5000);
        }

        function openApproveModal(payoutId, affiliateName, amount) {
          currentPayoutId = payoutId;
          document.getElementById("approve-affiliate").textContent = affiliateName;
          document.getElementById("approve-amount").textContent =
            "Rp " + parseFloat(amount).toLocaleString("id-ID");
          document.getElementById("approve-note").value = "";
          document.getElementById("approve-modal").classList.remove("hidden");
        }

        async function submitApproval() {
          if (!currentPayoutId) return;

          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval/${currentPayoutId}/approve`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({
                  note: document.getElementById("approve-note").value,
                }),
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            showSuccess("✅ Penarikan berhasil disetujui!");
            closeApproveModal();
            closeDetailModal();
            loadWithdrawals("pending");
          } catch (error) {
            console.error("Error:", error);
            showError("Error: " + error.message);
          }
        }

        function openRejectModal(payoutId, affiliateName, amount) {
          currentPayoutId = payoutId;
          document.getElementById("reject-affiliate").textContent = affiliateName;
          document.getElementById("reject-amount").textContent =
            "Rp " + parseFloat(amount).toLocaleString("id-ID");
          document.getElementById("reject-reason").value = "";
          document.getElementById("reject-modal").classList.remove("hidden");
        }

        async function submitReject() {
          if (!currentPayoutId) return;
          const reason = document.getElementById("reject-reason").value.trim();

          if (!reason) {
            showError("Alasan penolakan harus diisi!");
            return;
          }

          try {
            const response = await fetch(
              `/api/admin/withdrawals/approval/${currentPayoutId}/reject`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({
                  reason: reason,
                }),
              },
            );
            const result = await response.json();

            if (!result.success) throw new Error(result.message);

            showSuccess("✅ Penarikan berhasil ditolak!");
            closeRejectModal();
            closeDetailModal();
            loadWithdrawals("pending");
          } catch (error) {
            console.error("Error:", error);
            showError("Error: " + error.message);
          }
        }

        function closeDetailModal() {
          document.getElementById("detail-modal").classList.add("hidden");
        }

        function closeApproveModal() {
          document.getElementById("approve-modal").classList.add("hidden");
        }

        function closeRejectModal() {
          document.getElementById("reject-modal").classList.add("hidden");
        }

        // Notifikasi sukses
        function showSuccess(message) {
          const successDiv = document.createElement('div');
          successDiv.className = 'fixed top-24 right-6 z-50 animate-fade-in';
          successDiv.innerHTML = `
          <div class="bg-green-50 border border-green-200 rounded-xl p-4 shadow-lg max-w-sm">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                <i class="fas fa-check-circle text-green-600"></i>
              </div>
              <div>
                <p class="text-green-700 font-medium">Sukses!</p>
                <p class="text-green-600 text-sm mt-1">${message}</p>
              </div>
            </div>
          </div>
        `;
          document.body.appendChild(successDiv);

          // Hapus setelah 5 detik
          setTimeout(() => {
            successDiv.remove();
          }, 5000);
        }

        // Muat penarikan tertunda saat halaman dimuat
        document.addEventListener("DOMContentLoaded", () => {
          loadWithdrawals("pending");

          // Auto-refresh setiap 30 detik
          setInterval(() => {
            const activeTab = document.querySelector('.tab-active').textContent.toLowerCase();
            if (activeTab.includes('menunggu')) loadWithdrawals('pending');
            else if (activeTab.includes('sudah')) loadWithdrawals('approved');
            else if (activeTab.includes('ditolak')) loadWithdrawals('rejected');
          }, 30000);
        });
      </script>
</body>

</html>