<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users Management - Affillink Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
      font-family: 'Inter', sans-serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .gradient-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .gradient-secondary {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    }

    .gradient-accent {
      background: linear-gradient(135deg, #6ee7b7 0%, #34d399 100%);
    }

    .gradient-dark {
      background: linear-gradient(135deg, #065f46 0%, #047857 100%);
    }

    .card-hover {
      transition: all 0.3s ease;
    }

    .card-hover:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.1), 0 10px 10px -5px rgba(5, 150, 105, 0.04);
    }

    .modal-overlay {
      backdrop-filter: blur(4px);
      background: rgba(0, 0, 0, 0.6);
    }

    .pulse-animation {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
      }

      70% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .success-badge {
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        transform: translateY(-20px);
        opacity: 0;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .user-avatar {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .status-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 6px;
    }

    .type-radio:checked+label {
      border-color: #10b981;
      background-color: #f0fdf4;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }
  </style>
</head>

<body class="bg-gradient-to-br from-emerald-50 to-green-50 min-h-screen">
  <%- include('../navbar/navbar.ejs', { name: 'Admin' }) %>
    <%- include('../sidebar/admin.ejs') %>

      <main class="ml-64 pt-16 min-h-screen pb-8">
        <div class="p-6">
          <!-- Page Header -->
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-8">
            <div class="mb-4 md:mb-0">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-users text-white text-xl"></i>
                </div>
                <div>
                  <h1 class="text-3xl font-bold text-gray-900">Users Management</h1>
                  <p class="text-gray-600 mt-1">Kelola semua pengguna sistem Affillink</p>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="hidden md:block px-4 py-2 bg-white rounded-lg shadow-sm border border-green-100">
                <div class="flex items-center gap-2">
                  <i class="fas fa-calendar-alt text-green-600"></i>
                  <span class="text-sm font-medium text-gray-700">
                    <%= new Date().toLocaleDateString('id-ID', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                      day: 'numeric' }) %>
                  </span>
                </div>
              </div>
              <div class="px-4 py-2 gradient-primary rounded-lg shadow-lg text-white pulse-animation">
                <div class="flex items-center gap-2">
                  <i class="fas fa-bell"></i>
                  <span class="text-sm font-medium">Update Real-time</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Total Users</p>
                  <p class="text-3xl font-bold text-gray-900 mb-2" id="totalUsers">-</p>
                </div>
                <div class="w-14 h-14 gradient-primary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-users text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center gap-2 text-sm">
                  <span class="text-green-600 font-medium flex items-center">
                    <i class="fas fa-chart-line mr-1"></i>
                    <span id="monthGrowth">+15%</span>
                  </span>
                  <span class="text-gray-500">from last month</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Active Users</p>
                  <p class="text-3xl font-bold text-green-600 mb-2" id="activeUsers">-</p>
                </div>
                <div class="w-14 h-14 gradient-secondary rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-user-check text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Online now</span>
                  <span class="font-medium text-green-700" id="onlineUsers">12</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Affiliates</p>
                  <p class="text-3xl font-bold text-blue-600 mb-2" id="affiliateUsers">-</p>
                </div>
                <div
                  class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-user-tie text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Active affiliates</span>
                  <span class="font-medium text-blue-700" id="activeAffiliates">-</span>
                </div>
              </div>
            </div>

            <div class="glass-card rounded-2xl shadow-lg p-6 border border-green-100 card-hover">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-600 text-sm font-medium mb-1">Pending Affiliates</p>
                  <p class="text-3xl font-bold text-amber-600 mb-2" id="pendingAffiliates">-</p>
                </div>
                <div
                  class="w-14 h-14 bg-gradient-to-br from-amber-500 to-amber-600 rounded-xl flex items-center justify-center shadow-lg">
                  <i class="fas fa-clock text-white text-2xl"></i>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-green-50">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Needs approval</span>
                  <span class="font-medium text-amber-700" id="pendingCount">-</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Search and Filter -->
          <div class="glass-card rounded-2xl p-6 border border-green-100 mb-8">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
              <div class="flex-1">
                <div class="relative">
                  <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <input type="text" id="searchInput" placeholder="Cari user berdasarkan nama, email..."
                    class="w-full pl-12 pr-4 py-3 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm transition-all">
                </div>
              </div>

              <div class="flex flex-wrap gap-4">
                <div class="relative">
                  <i class="fas fa-user-tag absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <select id="roleFilter"
                    class="pl-12 pr-4 py-3 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm appearance-none min-w-[180px]">
                    <option value="">All Roles</option>
                    <option value="super_admin">Super Admin</option>
                    <option value="sales">Sales</option>
                    <option value="finance">Finance</option>
                    <option value="affiliate">Affiliate</option>
                    <option value="user">User</option>
                  </select>
                </div>

                <div class="relative">
                  <i class="fas fa-filter absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                  <select id="statusFilter"
                    class="pl-12 pr-4 py-3 border border-green-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm appearance-none min-w-[180px]">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </select>
                </div>

                <button onclick="clearFilters()"
                  class="px-4 py-3 border border-green-200 text-green-700 hover:bg-green-50 rounded-xl transition-colors flex items-center gap-2">
                  <i class="fas fa-redo"></i>
                  <span class="font-medium">Clear</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Users Grid -->
          <div id="usersContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <div class="col-span-full text-center py-12 text-gray-400">
              <div class="flex flex-col items-center">
                <div
                  class="w-16 h-16 gradient-primary rounded-full flex items-center justify-center mb-4 animate-pulse">
                  <i class="fas fa-spinner fa-spin text-2xl text-white"></i>
                </div>
                <p class="text-lg font-medium">Loading users...</p>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- View User Modal -->
      <div id="viewModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-hidden flex flex-col">
          <!-- Modal Header -->
          <div class="gradient-primary px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-user text-white"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">User Details</h3>
                <p class="text-green-100 text-sm mt-1">Complete user information</p>
              </div>
            </div>
            <button onclick="closeViewModal()"
              class="w-10 h-10 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-colors">
              <i class="fas fa-times text-white"></i>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="p-6 overflow-y-auto flex-1 scrollbar-hide">
            <!-- User Info Header -->
            <div class="flex flex-col items-center text-center mb-6">
              <div id="viewUserAvatar"
                class="w-24 h-24 user-avatar rounded-full flex items-center justify-center text-white text-3xl font-bold mb-4 shadow-lg">
                <!-- Avatar will be set dynamically -->
              </div>
              <h2 id="viewUserName" class="text-2xl font-bold text-gray-900 mb-1"></h2>
              <p id="viewUserEmail" class="text-gray-600 mb-3"></p>
              <p class="text-sm text-gray-500">User ID: <span id="viewUserID" class="font-medium">-</span></p>
            </div>

            <!-- User Details -->
            <div class="space-y-4 bg-gray-50 rounded-xl p-5">
              <!-- Role -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm">
                    <i class="fas fa-user-tag text-green-600"></i>
                  </div>
                  <div>
                    <p class="text-sm text-gray-500">Role</p>
                    <p id="viewUserRole" class="font-semibold text-gray-900"></p>
                  </div>
                </div>
                <span id="viewRoleBadge" class="px-3 py-1.5 rounded-full text-xs font-semibold"></span>
              </div>

              <!-- Status -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm">
                    <i class="fas fa-toggle-on text-green-600"></i>
                  </div>
                  <div>
                    <p class="text-sm text-gray-500">Account Status</p>
                    <p id="viewUserStatus" class="font-semibold text-gray-900"></p>
                  </div>
                </div>
                <span id="viewStatusBadge"
                  class="px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2">
                  <!-- Badge content will be set dynamically -->
                </span>
              </div>

              <!-- Affiliate Status -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm">
                    <i class="fas fa-user-tie text-green-600"></i>
                  </div>
                  <div>
                    <p class="text-sm text-gray-500">Affiliate Status</p>
                    <p id="viewAffiliateStatus" class="font-semibold text-gray-900"></p>
                  </div>
                </div>
                <span id="viewAffiliateBadge"
                  class="px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2">
                  <!-- Badge content will be set dynamically -->
                </span>
              </div>

              <!-- Join Date -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm">
                    <i class="fas fa-calendar-plus text-green-600"></i>
                  </div>
                  <div>
                    <p class="text-sm text-gray-500">Joined Date</p>
                    <p id="viewJoinDate" class="font-semibold text-gray-900"></p>
                  </div>
                </div>
                <i class="fas fa-history text-gray-400"></i>
              </div>

              <!-- Last Login -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm">
                    <i class="fas fa-sign-in-alt text-green-600"></i>
                  </div>
                  <div>
                    <p class="text-sm text-gray-500">Last Login</p>
                    <p id="viewLastLogin" class="font-semibold text-gray-900">-</p>
                  </div>
                </div>
                <i class="fas fa-clock text-gray-400"></i>
              </div>
            </div>

            <!-- Additional Info -->
            <div class="mt-6 pt-6 border-t border-gray-200">
              <h4 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
                <i class="fas fa-info-circle text-green-600"></i>
                Additional Information
              </h4>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-green-50 rounded-lg p-4 text-center">
                  <p class="text-2xl font-bold text-green-700" id="viewTotalReferrals">0</p>
                  <p class="text-sm text-green-600 mt-1">Referrals</p>
                </div>
                <div class="bg-blue-50 rounded-lg p-4 text-center">
                  <p class="text-2xl font-bold text-blue-700" id="viewTotalCommissions">0</p>
                  <p class="text-sm text-blue-600 mt-1">Commissions</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="border-t border-gray-200 px-6 py-4 bg-gray-50 flex gap-4">
            <button onclick="closeViewModal()"
              class="flex-1 bg-gray-200 text-gray-700 py-3.5 rounded-xl hover:bg-gray-300 transition-all font-semibold flex items-center justify-center gap-2">
              <i class="fas fa-times"></i>
              Close
            </button>
            <button onclick="editFromView()" id="editFromViewBtn"
              class="flex-1 gradient-primary text-white py-3.5 rounded-xl hover:opacity-90 transition-all font-semibold shadow-lg flex items-center justify-center gap-2">
              <i class="fas fa-edit"></i>
              Edit User
            </button>
          </div>
        </div>
      </div>

      <!-- Edit User Modal -->
      <div id="editModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-hidden flex flex-col">
          <!-- Modal Header -->
          <div class="gradient-primary px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-edit text-white"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Edit User</h3>
                <p class="text-green-100 text-sm mt-1">Update user information</p>
              </div>
            </div>
            <button onclick="closeEditModal()"
              class="w-10 h-10 bg-white/20 hover:bg-white/30 rounded-lg flex items-center justify-center transition-colors">
              <i class="fas fa-times text-white"></i>
            </button>
          </div>

          <!-- Modal Body -->
          <div class="p-6 overflow-y-auto flex-1 scrollbar-hide">
            <form id="editForm" class="space-y-6">
              <input type="hidden" id="editUserId">

              <!-- User Info -->
              <div class="flex flex-col items-center text-center mb-6">
                <div id="editUserAvatar"
                  class="w-20 h-20 user-avatar rounded-full flex items-center justify-center text-white text-2xl font-bold mb-4">
                  <!-- Avatar will be set dynamically -->
                </div>
                <p class="text-sm text-gray-500">User ID: <span id="editUserID" class="font-medium">-</span></p>
              </div>

              <!-- Form Fields -->
              <div class="space-y-4">
                <!-- Name -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-user mr-2 text-green-600"></i>
                    Name
                  </label>
                  <input type="text" id="editName" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all bg-white">
                </div>

                <!-- Email -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-envelope mr-2 text-green-600"></i>
                    Email
                  </label>
                  <input type="email" id="editEmail" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all bg-white">
                </div>

                <!-- Role -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-user-tag mr-2 text-green-600"></i>
                    Role
                  </label>
                  <select id="editRole"
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all bg-white">
                    <option value="user">User</option>
                    <option value="super_admin">Super Admin</option>
                    <option value="sales">Sales</option>
                    <option value="finance">Finance</option>
                    <option value="affiliate">Affiliate</option>
                  </select>
                </div>

                <!-- Status -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-toggle-on mr-2 text-green-600"></i>
                    Status
                  </label>
                  <div class="grid grid-cols-2 gap-4">
                    <label class="cursor-pointer">
                      <input type="radio" name="editStatus" value="active" class="peer sr-only">
                      <div
                        class="p-4 border-2 border-gray-200 rounded-xl hover:border-green-300 peer-checked:border-green-500 peer-checked:bg-green-50 transition-all text-center">
                        <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                          <i class="fas fa-check-circle text-green-600"></i>
                        </div>
                        <p class="font-medium text-gray-900">Active</p>
                      </div>
                    </label>
                    <label class="cursor-pointer">
                      <input type="radio" name="editStatus" value="inactive" class="peer sr-only">
                      <div
                        class="p-4 border-2 border-gray-200 rounded-xl hover:border-red-300 peer-checked:border-red-500 peer-checked:bg-red-50 transition-all text-center">
                        <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center mx-auto mb-2">
                          <i class="fas fa-times-circle text-red-600"></i>
                        </div>
                        <p class="font-medium text-gray-900">Inactive</p>
                      </div>
                    </label>
                  </div>
                </div>

                <!-- Affiliate Status -->
                <div id="affiliateStatusSection" class="hidden">
                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-user-tie mr-2 text-green-600"></i>
                    Affiliate Status
                  </label>
                  <select id="editAffiliateStatus"
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all bg-white">
                    <option value="inactive">Inactive</option>
                    <option value="pending">Pending</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                  </select>
                </div>
              </div>
            </form>
          </div>

          <!-- Modal Footer -->
          <div class="border-t border-gray-200 px-6 py-4 bg-gray-50 flex gap-4">
            <button type="button" onclick="closeEditModal()"
              class="flex-1 bg-gray-200 text-gray-700 py-3.5 rounded-xl hover:bg-gray-300 transition-all font-semibold flex items-center justify-center gap-2">
              <i class="fas fa-times"></i>
              Cancel
            </button>
            <button type="submit" form="editForm"
              class="flex-1 gradient-primary text-white py-3.5 rounded-xl hover:opacity-90 transition-all font-semibold shadow-lg flex items-center justify-center gap-2">
              <i class="fas fa-save"></i>
              Save Changes
            </button>
          </div>
        </div>
      </div>

      <!-- Success Notification -->
      <div id="successNotification"
        class="fixed top-6 right-6 bg-green-500 text-white px-6 py-4 rounded-xl shadow-lg z-50 hidden success-badge">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
            <i class="fas fa-check"></i>
          </div>
          <div>
            <p class="font-semibold" id="successMessage"></p>
            <p class="text-green-100 text-sm mt-1">Action completed successfully</p>
          </div>
        </div>
      </div>

      <!-- Error Notification -->
      <div id="errorNotification"
        class="fixed top-6 right-6 bg-red-500 text-white px-6 py-4 rounded-xl shadow-lg z-50 hidden success-badge">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center">
            <i class="fas fa-exclamation-triangle"></i>
          </div>
          <div>
            <p class="font-semibold" id="errorMessage"></p>
            <p class="text-red-100 text-sm mt-1">Please try again</p>
          </div>
        </div>
      </div>

      <script>
        let allUsers = [];

        async function loadUsers() {
          try {
            const response = await fetch('/api/admin/users');
            const data = await response.json();

            if (data.success) {
              allUsers = data.data;
              updateStats(data.data);
              displayUsers(data.data);
            }
          } catch (error) {
            console.error('Error loading users:', error);
            showError('Failed to load users');
          }
        }

        function updateStats(users) {
          const total = users.length;
          const active = users.filter(u => u.status === 'active').length;
          const affiliates = users.filter(u => u.affiliate_status === 'approved').length;
          const pending = users.filter(u => u.affiliate_status === 'pending').length;
          const activeAffiliates = users.filter(u => u.affiliate_status === 'approved' && u.status === 'active').length;

          document.getElementById('totalUsers').textContent = total;
          document.getElementById('activeUsers').textContent = active;
          document.getElementById('affiliateUsers').textContent = affiliates;
          document.getElementById('pendingAffiliates').textContent = pending;
          document.getElementById('activeAffiliates').textContent = activeAffiliates;
          document.getElementById('pendingCount').textContent = pending;
        }

        function displayUsers(users) {
          const container = document.getElementById('usersContainer');

          if (!users || users.length === 0) {
            container.innerHTML = `
          <div class="col-span-full text-center py-16">
            <div class="flex flex-col items-center">
              <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                <i class="fas fa-users text-4xl text-gray-300"></i>
              </div>
              <h3 class="text-xl font-semibold text-gray-700 mb-2">No Users Found</h3>
              <p class="text-gray-500 max-w-md mx-auto">No users match your search criteria.</p>
              <button onclick="clearFilters()" class="mt-6 px-6 py-3 gradient-primary text-white rounded-xl hover:opacity-90 transition-all font-semibold flex items-center gap-2">
                <i class="fas fa-redo"></i>
                Clear Filters
              </button>
            </div>
          </div>
        `;
            return;
          }

          container.innerHTML = users.map(user => {
            const roleConfig = {
              'super_admin': { bg: 'bg-gradient-to-br from-purple-500 to-purple-600', text: 'text-purple-100', icon: 'fas fa-crown', badge: 'Super Admin' },
              'sales': { bg: 'bg-gradient-to-br from-blue-500 to-blue-600', text: 'text-blue-100', icon: 'fas fa-chart-line', badge: 'Sales' },
              'finance': { bg: 'bg-gradient-to-br from-green-500 to-green-600', text: 'text-green-100', icon: 'fas fa-coins', badge: 'Finance' },
              'affiliate': { bg: 'bg-gradient-to-br from-orange-500 to-orange-600', text: 'text-orange-100', icon: 'fas fa-user-tie', badge: 'Affiliate' },
              'user': { bg: 'bg-gradient-to-br from-gray-500 to-gray-600', text: 'text-gray-100', icon: 'fas fa-user', badge: 'User' }
            }[user.role_name] || { bg: 'bg-gradient-to-br from-gray-500 to-gray-600', text: 'text-gray-100', icon: 'fas fa-user', badge: 'User' };

            const affiliateStatusConfig = {
              'inactive': { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle' },
              'pending': { bg: 'bg-yellow-100', text: 'text-yellow-800', icon: 'fas fa-clock' },
              'approved': { bg: 'bg-green-100', text: 'text-green-800', icon: 'fas fa-check-circle' },
              'rejected': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle' }
            }[user.affiliate_status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle' };

            const statusConfig = {
              'active': { bg: 'bg-green-100', text: 'text-green-800', icon: 'fas fa-check-circle' },
              'inactive': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle' }
            }[user.status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-question-circle' };

            const joinDate = user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

            return `
          <div class="card-hover bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden group">
            <!-- Header with avatar -->
            <div class="relative h-32 ${roleConfig.bg} flex items-center justify-center">
              <div class="w-20 h-20 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center border-4 border-white/30">
                <span class="text-2xl font-bold text-white">${user.name.charAt(0).toUpperCase()}</span>
              </div>
              <div class="absolute top-4 right-4 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                <button onclick="editUser(${user.id})" class="w-9 h-9 rounded-lg bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 transition-colors flex items-center justify-center">
                  <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteUser(${user.id})" class="w-9 h-9 rounded-lg bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 transition-colors flex items-center justify-center">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <h3 class="font-bold text-lg text-gray-900">${user.name}</h3>
                  <div class="flex items-center gap-1 text-sm text-gray-500 mt-1">
                    <i class="fas fa-envelope text-gray-400"></i>
                    <span class="truncate">${user.email}</span>
                  </div>
                </div>
                <span class="px-3 py-1.5 rounded-full text-xs font-semibold ${roleConfig.text} ${roleConfig.bg} flex items-center gap-2">
                  <i class="${roleConfig.icon} text-xs"></i>
                  ${roleConfig.badge}
                </span>
              </div>

              <div class="space-y-3">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500 flex items-center gap-1">
                    <i class="fas fa-id-card text-gray-400"></i>
                    User ID
                  </span>
                  <span class="font-semibold text-gray-900">#${user.id}</span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500 flex items-center gap-1">
                    <i class="fas fa-user-tie text-gray-400"></i>
                    Affiliate Status
                  </span>
                  <span class="font-semibold ${affiliateStatusConfig.text} bg-white px-3 py-1.5 rounded-full text-xs border ${affiliateStatusConfig.text.replace('text-', 'border-')}/20 flex items-center gap-2">
                    <i class="${affiliateStatusConfig.icon}"></i>
                    ${user.affiliate_status ? user.affiliate_status.charAt(0).toUpperCase() + user.affiliate_status.slice(1) : 'Inactive'}
                  </span>
                </div>

                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-500 flex items-center gap-1">
                    <i class="fas fa-toggle-on text-gray-400"></i>
                    Status
                  </span>
                  <span class="font-semibold ${statusConfig.text} bg-white px-3 py-1.5 rounded-full text-xs border ${statusConfig.text.replace('text-', 'border-')}/20 flex items-center gap-2">
                    <i class="${statusConfig.icon}"></i>
                    ${user.status.charAt(0).toUpperCase() + user.status.slice(1)}
                  </span>
                </div>

                <div class="flex items-center justify-between text-sm pt-2 border-t border-gray-100">
                  <span class="text-gray-500 flex items-center gap-1">
                    <i class="fas fa-calendar-plus text-gray-400"></i>
                    Joined
                  </span>
                  <span class="text-gray-900 font-medium">${joinDate}</span>
                </div>
              </div>
            </div>

            <!-- Footer with quick actions -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex gap-3">
              <button onclick="viewUser(${user.id})" class="flex-1 text-sm font-semibold text-gray-600 hover:text-gray-800 py-2.5 rounded-lg hover:bg-gray-100 transition-colors flex items-center justify-center gap-2">
                <i class="fas fa-eye"></i>
                View
              </button>
              <div class="w-px bg-gray-300"></div>
              <button onclick="editUser(${user.id})" class="flex-1 text-sm font-semibold text-blue-600 hover:text-blue-800 py-2.5 rounded-lg hover:bg-blue-50 transition-colors flex items-center justify-center gap-2">
                <i class="fas fa-edit"></i>
                Edit
              </button>
            </div>
          </div>
        `;
          }).join('');
        }

        function viewUser(userId) {
          const user = allUsers.find(u => u.id === userId);
          if (user) {
            // Set basic information
            document.getElementById('viewUserID').textContent = user.id;
            document.getElementById('viewUserName').textContent = user.name;
            document.getElementById('viewUserEmail').textContent = user.email;

            // Set avatar
            const avatar = document.getElementById('viewUserAvatar');
            avatar.textContent = user.name.charAt(0).toUpperCase();
            avatar.className = 'w-24 h-24 user-avatar rounded-full flex items-center justify-center text-white text-3xl font-bold mb-4 shadow-lg';

            // Set role
            document.getElementById('viewUserRole').textContent = user.role_name || 'User';

            const roleConfig = {
              'super_admin': { bg: 'bg-gradient-to-br from-purple-500 to-purple-600', text: 'text-white', badge: 'Super Admin' },
              'sales': { bg: 'bg-gradient-to-br from-blue-500 to-blue-600', text: 'text-white', badge: 'Sales' },
              'finance': { bg: 'bg-gradient-to-br from-green-500 to-green-600', text: 'text-white', badge: 'Finance' },
              'affiliate': { bg: 'bg-gradient-to-br from-orange-500 to-orange-600', text: 'text-white', badge: 'Affiliate' },
              'user': { bg: 'bg-gradient-to-br from-gray-500 to-gray-600', text: 'text-white', badge: 'User' }
            }[user.role_name] || { bg: 'bg-gradient-to-br from-gray-500 to-gray-600', text: 'text-white', badge: 'User' };

            const roleBadge = document.getElementById('viewRoleBadge');
            roleBadge.className = `px-3 py-1.5 rounded-full text-xs font-semibold ${roleConfig.bg} ${roleConfig.text}`;
            roleBadge.textContent = roleConfig.badge;

            // Set status
            document.getElementById('viewUserStatus').textContent = user.status.charAt(0).toUpperCase() + user.status.slice(1);

            const statusConfig = {
              'active': { bg: 'bg-green-100', text: 'text-green-800', icon: 'fas fa-check-circle' },
              'inactive': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle' }
            }[user.status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-question-circle' };

            const statusBadge = document.getElementById('viewStatusBadge');
            statusBadge.className = `px-3 py-1.5 rounded-full text-xs font-semibold ${statusConfig.text} ${statusConfig.bg} flex items-center gap-2`;
            statusBadge.innerHTML = `<i class="${statusConfig.icon}"></i>${user.status.charAt(0).toUpperCase() + user.status.slice(1)}`;

            // Set affiliate status
            const affiliateStatus = user.affiliate_status || 'inactive';
            document.getElementById('viewAffiliateStatus').textContent = affiliateStatus.charAt(0).toUpperCase() + affiliateStatus.slice(1);

            const affiliateConfig = {
              'inactive': { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle' },
              'pending': { bg: 'bg-yellow-100', text: 'text-yellow-800', icon: 'fas fa-clock' },
              'approved': { bg: 'bg-green-100', text: 'text-green-800', icon: 'fas fa-check-circle' },
              'rejected': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle' }
            }[affiliateStatus] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle' };

            const affiliateBadge = document.getElementById('viewAffiliateBadge');
            affiliateBadge.className = `px-3 py-1.5 rounded-full text-xs font-semibold ${affiliateConfig.text} ${affiliateConfig.bg} flex items-center gap-2`;
            affiliateBadge.innerHTML = `<i class="${affiliateConfig.icon}"></i>${affiliateStatus.charAt(0).toUpperCase() + affiliateStatus.slice(1)}`;

            // Set dates
            const joinDate = user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            }) : '-';
            document.getElementById('viewJoinDate').textContent = joinDate;

            // Set edit button to current user
            document.getElementById('editFromViewBtn').setAttribute('onclick', `closeViewModal(); editUser(${user.id})`);

            // Show modal
            document.getElementById('viewModal').classList.remove('hidden');
            document.getElementById('viewModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeViewModal() {
          document.getElementById('viewModal').classList.add('hidden');
          document.getElementById('viewModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function editFromView() {
          closeViewModal();
          // Tunggu sedikit sebelum membuka edit modal agar animasi smooth
          setTimeout(() => {
            const userId = document.getElementById('viewUserID').textContent;
            editUser(parseInt(userId));
          }, 300);
        }

        function editUser(userId) {
          const user = allUsers.find(u => u.id === userId);
          if (user) {
            document.getElementById('editUserId').value = user.id;
            document.getElementById('editUserID').textContent = user.id;
            document.getElementById('editName').value = user.name;
            document.getElementById('editEmail').value = user.email;
            document.getElementById('editRole').value = user.role_name || 'user';

            // Set avatar
            const avatar = document.getElementById('editUserAvatar');
            avatar.textContent = user.name.charAt(0).toUpperCase();
            avatar.className = 'w-20 h-20 user-avatar rounded-full flex items-center justify-center text-white text-2xl font-bold mb-4';

            // Set status radio
            document.querySelector(`input[name="editStatus"][value="${user.status}"]`).checked = true;

            // Set affiliate status if exists
            if (user.affiliate_status) {
              document.getElementById('editAffiliateStatus').value = user.affiliate_status;
              document.getElementById('affiliateStatusSection').classList.remove('hidden');
            } else {
              document.getElementById('affiliateStatusSection').classList.add('hidden');
            }

            document.getElementById('editModal').classList.remove('hidden');
            document.getElementById('editModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeEditModal() {
          document.getElementById('editModal').classList.add('hidden');
          document.getElementById('editModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        document.getElementById('editForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const userId = document.getElementById('editUserId').value;
          const formData = {
            name: document.getElementById('editName').value,
            email: document.getElementById('editEmail').value,
            role: document.getElementById('editRole').value,
            status: document.querySelector('input[name="editStatus"]:checked').value,
            affiliate_status: document.getElementById('editAffiliateStatus').value
          };

          try {
            const response = await fetch(`/api/admin/users/${userId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (data.success) {
              showSuccess('User updated successfully');
              closeEditModal();
              loadUsers();
            } else {
              showError('Failed to update user: ' + (data.message || 'Unknown error'));
            }
          } catch (error) {
            console.error('Error updating user:', error);
            showError('Failed to update user: ' + error.message);
          }
        });

        async function deleteUser(userId) {
          const user = allUsers.find(u => u.id === userId);
          if (!user) return;

          if (!confirm(`Delete user "${user.name}"? This action cannot be undone.`)) return;

          try {
            const response = await fetch(`/api/admin/users/${userId}`, {
              method: 'DELETE'
            });

            const data = await response.json();

            if (data.success) {
              showSuccess('User deleted successfully');
              loadUsers();
            } else {
              showError('Failed to delete user: ' + (data.message || 'Unknown error'));
            }
          } catch (error) {
            console.error('Error deleting user:', error);
            showError('Failed to delete user: ' + error.message);
          }
        }

        // Search and filter
        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            filterUsers();
          }, 300);
        });

        document.getElementById('roleFilter').addEventListener('change', filterUsers);
        document.getElementById('statusFilter').addEventListener('change', filterUsers);

        function filterUsers() {
          const search = document.getElementById('searchInput').value.toLowerCase();
          const role = document.getElementById('roleFilter').value;
          const status = document.getElementById('statusFilter').value;

          const filtered = allUsers.filter(user => {
            const matchSearch = user.name.toLowerCase().includes(search) ||
              user.email.toLowerCase().includes(search);
            const matchRole = !role || user.role_name === role;
            const matchStatus = !status || user.status === status;
            return matchSearch && matchRole && matchStatus;
          });

          displayUsers(filtered);
        }

        function clearFilters() {
          document.getElementById('searchInput').value = '';
          document.getElementById('roleFilter').value = '';
          document.getElementById('statusFilter').value = '';
          filterUsers();
        }

        function showSuccess(message) {
          const notification = document.getElementById('successNotification');
          document.getElementById('successMessage').textContent = message;
          notification.classList.remove('hidden');

          setTimeout(() => {
            notification.classList.add('hidden');
          }, 3000);
        }

        function showError(message) {
          const notification = document.getElementById('errorNotification');
          document.getElementById('errorMessage').textContent = message;
          notification.classList.remove('hidden');

          setTimeout(() => {
            notification.classList.add('hidden');
          }, 3000);
        }

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (!document.getElementById('viewModal').classList.contains('hidden')) {
              closeViewModal();
            } else if (!document.getElementById('editModal').classList.contains('hidden')) {
              closeEditModal();
            }
          }
        });

        // Close modal on backdrop click
        document.getElementById('viewModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('viewModal')) {
            closeViewModal();
          }
        });

        document.getElementById('editModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('editModal')) {
            closeEditModal();
          }
        });

        // Load users on page load
        document.addEventListener('DOMContentLoaded', loadUsers);

        // Auto-refresh every 60 seconds
        setInterval(loadUsers, 60000);
      </script>
</body>

</html>