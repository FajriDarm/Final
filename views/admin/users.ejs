            <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
              <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
              <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff"
                stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2" id="notificationTitle">Sukses</h2>
          <p class="text-gray-600 mb-4 text-sm font-medium" id="notificationMessage">Operasi berhasil dilakukan</p>
          <button id="closeNotificationModalBtn" type="button"
            class="w-full gradient-primary text-white py-3 px-5 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
            Tutup
          </button>
        </div>
      </div>

      <!-- Modal Konfirmasi Premium -->
      <div id="confirmationModal" class="modal-notification" style="display: none;">
        <div class="modal-box">
          <span class="notification-icon warning" id="confirmationIcon">
            <i class="fas fa-exclamation-triangle"></i>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2" id="confirmationTitle">Konfirmasi</h2>
          <p class="text-gray-600 mb-4 text-sm font-medium" id="confirmationMessage">Apakah Anda yakin?</p>
          <div class="flex gap-3">
            <button id="cancelConfirmationBtn" type="button"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 px-4 rounded-xl text-sm font-extrabold transition-all duration-300 border border-white/60">
              Batal
            </button>
            <button id="confirmActionBtn" type="button"
              class="flex-1 bg-gradient-to-r from-amber-500 to-orange-500 text-white py-3 px-4 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
              Ya
            </button>
          </div>
        </div>
      </div>

      <!-- Modal Hapus Pengguna Premium -->
      <div id="deleteModal" class="modal-notification" style="display: none;">
        <div class="modal-box">
          <span class="notification-icon error" id="deleteIcon">
            <i class="fas fa-trash-alt"></i>
          </span>
          <h2 class="text-xl font-extrabold text-gray-900 mb-2">Hapus Pengguna</h2>
          <p class="text-gray-600 mb-4 text-sm font-medium" id="deleteMessage">Apakah Anda yakin ingin menghapus
            pengguna ini?</p>
          <div class="flex gap-3">
            <button id="cancelDeleteBtn" type="button"
              class="flex-1 bg-white/60 hover:bg-white/80 text-gray-700 py-3 px-4 rounded-xl text-sm font-extrabold transition-all duration-300 border border-white/60">
              Batal
            </button>
            <button id="confirmDeleteBtn" type="button"
              class="flex-1 bg-gradient-to-r from-red-600 to-rose-600 text-white py-3 px-4 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg">
              Hapus
            </button>
          </div>
        </div>
      </div>

      <script>
        let allUsers = [];
        let currentUserId = null;
        let confirmationCallback = null;
        let deleteCallback = null;

        // ============================================================
        // FUNGSI NOTIFIKASI MODAL
        // ============================================================

        function showNotification(type, title, message, autoClose = true) {
          const modal = document.getElementById('notificationModal');
          const icon = document.getElementById('notificationIcon');
          const titleEl = document.getElementById('notificationTitle');
          const messageEl = document.getElementById('notificationMessage');
          const closeBtn = document.getElementById('closeNotificationModalBtn');

          icon.className = 'notification-icon';

          const configs = {
            success: {
              iconClass: 'success',
              iconHTML: `
            <svg class="notification-checkmark-svg" width="40" height="40" viewBox="0 0 48 48">
              <circle cx="24" cy="24" r="22" fill="none" stroke="#fff" stroke-width="4" opacity="0.15" />
              <path class="notification-checkmark-path" d="M14 25.5L22 33L34 17" fill="none" stroke="#fff" stroke-width="4"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          `,
              buttonClass: 'gradient-primary'
            },
            error: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-times-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            },
            warning: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-exclamation-triangle"></i>',
              buttonClass: 'bg-gradient-to-r from-amber-500 to-orange-500'
            },
            info: {
              iconClass: 'info',
              iconHTML: '<i class="fas fa-info-circle"></i>',
              buttonClass: 'bg-gradient-to-r from-blue-600 to-indigo-600'
            },
            edit: {
              iconClass: 'success',
              iconHTML: '<i class="fas fa-user-edit"></i>',
              buttonClass: 'gradient-primary'
            },
            delete: {
              iconClass: 'error',
              iconHTML: '<i class="fas fa-user-times"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            }
          };

          const config = configs[type] || configs.info;

          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;
          titleEl.textContent = title;
          messageEl.textContent = message;

          closeBtn.className = `w-full ${config.buttonClass} text-white py-3 px-5 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg`;

          if (type === 'success' || type === 'edit') {
            const checkmarkPath = icon.querySelector('.notification-checkmark-path');
            if (checkmarkPath) {
              checkmarkPath.style.strokeDasharray = '40';
              checkmarkPath.style.strokeDashoffset = '40';
              setTimeout(() => {
                checkmarkPath.style.animation = 'none';
                setTimeout(() => {
                  checkmarkPath.style.animation = 'checkmark-draw 1.1s cubic-bezier(.28, .84, .42, 1) 0.15s forwards';
                }, 10);
              }, 10);
            }
          }

          modal.style.display = 'flex';

          if (autoClose) {
            setTimeout(() => {
              closeNotification();
            }, 4000);
          }
        }

        function showConfirmationModal(type, title, message, confirmText, cancelText, onConfirm, onCancel = null) {
          const modal = document.getElementById('confirmationModal');
          const icon = document.getElementById('confirmationIcon');
          const titleEl = document.getElementById('confirmationTitle');
          const messageEl = document.getElementById('confirmationMessage');
          const confirmBtn = document.getElementById('confirmActionBtn');
          const cancelBtn = document.getElementById('cancelConfirmationBtn');

          const iconConfigs = {
            approve: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-check"></i>',
              buttonClass: 'bg-gradient-to-r from-green-600 to-emerald-600'
            },
            reject: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-times"></i>',
              buttonClass: 'bg-gradient-to-r from-red-600 to-rose-600'
            },
            edit: {
              iconClass: 'warning',
              iconHTML: '<i class="fas fa-user-edit"></i>',
              buttonClass: 'gradient-primary'
            }
          };

          const config = iconConfigs[type] || { iconClass: 'warning', iconHTML: '<i class="fas fa-exclamation-triangle"></i>', buttonClass: 'bg-gradient-to-r from-amber-500 to-orange-500' };

          icon.className = 'notification-icon';
          icon.classList.add(config.iconClass);
          icon.innerHTML = config.iconHTML;

          titleEl.textContent = title;
          messageEl.textContent = message;
          confirmBtn.textContent = confirmText;
          cancelBtn.textContent = cancelText;

          confirmBtn.className = `flex-1 ${config.buttonClass} text-white py-3 px-4 rounded-xl text-sm font-extrabold hover:opacity-90 transition-all duration-300 shadow-lg`;

          confirmationCallback = onConfirm;

          confirmBtn.onclick = function (e) {
            e.preventDefault();
            closeConfirmationModal();
            if (onConfirm) onConfirm();
          };

          cancelBtn.onclick = function (e) {
            e.preventDefault();
            closeConfirmationModal();
            if (onCancel) onCancel();
          };

          modal.style.display = 'flex';

          modal.addEventListener('click', function (e) {
            if (e.target === modal) {
              closeConfirmationModal();
              if (onCancel) onCancel();
            }
          });

          const escHandler = function (e) {
            if (e.key === 'Escape') {
              closeConfirmationModal();
              if (onCancel) onCancel();
              document.removeEventListener('keydown', escHandler);
            }
          };
          document.addEventListener('keydown', escHandler);
        }

        function showDeleteModal(userName, onConfirm, onCancel = null) {
          const modal = document.getElementById('deleteModal');
          const messageEl = document.getElementById('deleteMessage');
          const confirmBtn = document.getElementById('confirmDeleteBtn');
          const cancelBtn = document.getElementById('cancelDeleteBtn');

          messageEl.textContent = `Apakah Anda yakin ingin menghapus pengguna "${userName}"?`;

          deleteCallback = onConfirm;

          confirmBtn.onclick = function (e) {
            e.preventDefault();
            closeDeleteModal();
            if (onConfirm) onConfirm();
          };

          cancelBtn.onclick = function (e) {
            e.preventDefault();
            closeDeleteModal();
            if (onCancel) onCancel();
          };

          modal.style.display = 'flex';

          modal.addEventListener('click', function (e) {
            if (e.target === modal) {
              closeDeleteModal();
              if (onCancel) onCancel();
            }
          });

          const escHandler = function (e) {
            if (e.key === 'Escape') {
              closeDeleteModal();
              if (onCancel) onCancel();
              document.removeEventListener('keydown', escHandler);
            }
          };
          document.addEventListener('keydown', escHandler);
        }

        function closeConfirmationModal() {
          const modal = document.getElementById('confirmationModal');
          modal.style.display = 'none';
        }

        function closeDeleteModal() {
          const modal = document.getElementById('deleteModal');
          modal.style.display = 'none';
        }

        function closeNotification() {
          const modal = document.getElementById('notificationModal');
          modal.style.display = 'none';
        }

        function showSuccess(message, title = 'Sukses') {
          showNotification('success', title, message);
        }

        function showError(message, title = 'Error') {
          showNotification('error', title, message);
        }

        // ============================================================
        // FUNGSI UTAMA MANAJEMEN PENGGUNA
        // ============================================================

        async function loadUsers() {
          try {
            const response = await fetch('/api/admin/users');
            const data = await response.json();

            if (data.success) {
              allUsers = data.data;
              updateStats(data.data);
              displayUsers(data.data);
            }
          } catch (error) {
            console.error('Error loading users:', error);
            showError('Gagal memuat pengguna');
          }
        }

        function updateStats(users) {
          const total = users.length;
          const active = users.filter(u => u.status === 'active').length;
          const affiliates = users.filter(u => u.affiliate_status === 'approved').length;
          const pending = users.filter(u => u.affiliate_status === 'pending').length;
          const activeAffiliates = users.filter(u => u.affiliate_status === 'approved' && u.status === 'active').length;
          document.getElementById('totalUsers').textContent = total;
          document.getElementById('activeUsers').textContent = active;
          document.getElementById('affiliateUsers').textContent = affiliates;
          document.getElementById('activeAffiliates').textContent = activeAffiliates;
          document.getElementById('pendingCount').textContent = pending;
        }

        function displayUsers(users) {
          const container = document.getElementById('usersContainer');

          if (!users || users.length === 0) {
            container.innerHTML = `
          <div class="col-span-full text-center py-12">
            <div class="flex flex-col items-center">
              <div class="relative">
                <div class="w-20 h-20 bg-white/60 backdrop-blur rounded-full flex items-center justify-center mb-4 border-3 border-white/50 float-slow">
                  <i class="fas fa-users text-2xl text-emerald-300"></i>
                </div>
                <div class="absolute -top-1 -right-1 w-4 h-4 bg-white rounded-full flex items-center justify-center shadow-lg">
                  <span class="w-2 h-2 bg-amber-500 rounded-full pulse-premium"></span>
                </div>
              </div>
              <h3 class="text-lg font-extrabold text-gray-900 mb-2">Tidak Ada Pengguna</h3>
              <p class="text-sm text-emerald-700 font-medium max-w-md">Tidak ada pengguna yang cocok dengan kriteria pencarian Anda.</p>
              <button onclick="clearFilters()" class="mt-5 px-5 py-2.5 gradient-primary text-white rounded-xl hover:opacity-90 transition-all duration-300 text-sm font-extrabold shadow-lg flex items-center gap-2">
                <i class="fas fa-redo text-xs"></i>
                Hapus Filter
              </button>
            </div>
          </div>
        `;
            return;
          }

          container.innerHTML = users.slice(0, 12).map(user => {
            const roleConfig = {
              'super_admin': { bg: 'gradient-super-admin', text: 'text-white', icon: 'fas fa-crown', badge: 'Super Admin' },
              'sales': { bg: 'gradient-sales', text: 'text-white', icon: 'fas fa-chart-line', badge: 'Sales' },
              'finance': { bg: 'gradient-finance', text: 'text-white', icon: 'fas fa-coins', badge: 'Finance' },
              'affiliate': { bg: 'gradient-affiliate', text: 'text-white', icon: 'fas fa-user-tie', badge: 'Affiliate' },
              'user': { bg: 'gradient-user', text: 'text-white', icon: 'fas fa-user', badge: 'Pengguna' }
            }[user.role_name] || { bg: 'gradient-user', text: 'text-white', icon: 'fas fa-user', badge: 'Pengguna' };

            const affiliateStatusConfig = {
              'inactive': { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle', label: 'Tidak Aktif' },
              'pending': { bg: 'bg-amber-100', text: 'text-amber-800', icon: 'fas fa-clock', label: 'Tertunda' },
              'approved': { bg: 'bg-emerald-100', text: 'text-emerald-800', icon: 'fas fa-check-circle', label: 'Disetujui' },
              'rejected': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle', label: 'Ditolak' }
            }[user.affiliate_status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle', label: 'Tidak Aktif' };

            const statusConfig = {
              'active': { bg: 'bg-emerald-100', text: 'text-emerald-800', icon: 'fas fa-check-circle', label: 'Aktif' },
              'inactive': { bg: 'bg-red-100', text: 'text-red-800', icon: 'fas fa-times-circle', label: 'Tidak Aktif' }
            }[user.status] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-question-circle', label: 'Unknown' };

            const joinDate = user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';

            return `
          <div class="glass-futuristic rounded-xl overflow-hidden group card-futuristic border border-white/50">
            <!-- Header dengan avatar -->
            <div class="relative h-24 ${roleConfig.bg} flex items-center justify-center">
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
              <div class="w-14 h-14 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center border-3 border-white/30 shadow-lg transform group-hover:scale-110 transition-all duration-500">
                <span class="text-xl font-extrabold text-white">${user.name.charAt(0).toUpperCase()}</span>
              </div>
              <div class="absolute top-3 right-3 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <button onclick="viewUser(${user.id})" class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 transition-colors flex items-center justify-center border border-white/30">
                  <i class="fas fa-eye text-xs"></i>
                </button>
                <button onclick="editUser(${user.id})" class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 transition-colors flex items-center justify-center border border-white/30">
                  <i class="fas fa-edit text-xs"></i>
                </button>
                <button onclick="deleteUser(${user.id})" class="w-7 h-7 rounded-lg bg-white/20 backdrop-blur-sm text-white hover:bg-white/30 transition-colors flex items-center justify-center border border-white/30">
                  <i class="fas fa-trash text-xs"></i>
                </button>
              </div>
            </div>

            <!-- Konten -->
            <div class="p-4">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <h3 class="font-extrabold text-base text-gray-900 mb-0.5 line-clamp-1">${user.name}</h3>
                  <div class="flex items-center gap-1.5 text-xs text-emerald-700">
                    <i class="fas fa-envelope text-emerald-400 text-[10px]"></i>
                    <span class="truncate max-w-[120px] font-medium">${user.email}</span>
                  </div>
                </div>
                <span class="px-2.5 py-1.5 rounded-lg text-[9px] font-extrabold ${roleConfig.text} ${roleConfig.bg} flex items-center gap-1 shadow-md border border-white/20">
                  <i class="${roleConfig.icon} text-[8px]"></i>
                  ${roleConfig.badge}
                </span>
              </div>

              <div class="space-y-2.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-emerald-700 font-semibold flex items-center gap-1.5">
                    <i class="fas fa-id-card text-emerald-400 text-[10px]"></i>
                    ID
                  </span>
                  <span class="font-extrabold text-gray-900 bg-white/60 px-2.5 py-1 rounded-lg text-[10px] border border-white/60">#${user.id}</span>
                </div>

                <div class="flex items-center justify-between text-xs">
                  <span class="text-emerald-700 font-semibold flex items-center gap-1.5">
                    <i class="fas fa-user-tie text-emerald-400 text-[10px]"></i>
                    Affiliate
                  </span>
                  <span class="font-extrabold ${affiliateStatusConfig.text} bg-white/60 px-2.5 py-1 rounded-lg text-[9px] border border-white/60 flex items-center gap-1">
                    <i class="${affiliateStatusConfig.icon} text-[8px]"></i>
                    ${affiliateStatusConfig.label}
                  </span>
                </div>

                <div class="flex items-center justify-between text-xs">
                  <span class="text-emerald-700 font-semibold flex items-center gap-1.5">
                    <i class="fas fa-toggle-on text-emerald-400 text-[10px]"></i>
                    Status
                  </span>
                  <span class="font-extrabold ${statusConfig.text} bg-white/60 px-2.5 py-1 rounded-lg text-[9px] border border-white/60 flex items-center gap-1">
                    <i class="${statusConfig.icon} text-[8px]"></i>
                    ${statusConfig.label}
                  </span>
                </div>

                <div class="flex items-center justify-between text-xs pt-2 border-t border-white/30">
                  <span class="text-emerald-700 font-semibold flex items-center gap-1.5">
                    <i class="fas fa-calendar-plus text-emerald-400 text-[10px]"></i>
                    Bergabung
                  </span>
                  <span class="text-gray-900 font-extrabold text-[10px]">${joinDate}</span>
                </div>
              </div>
            </div>

            <!-- Footer dengan aksi cepat -->
            <div class="px-4 py-3 bg-white/30 backdrop-blur border-t border-white/30 flex gap-2">
              <button onclick="viewUser(${user.id})" class="flex-1 text-[10px] font-extrabold text-emerald-700 hover:text-emerald-800 py-2 rounded-lg hover:bg-white/60 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                <i class="fas fa-eye text-[8px]"></i>
                Lihat
              </button>
              <div class="w-px bg-white/30"></div>
              <button onclick="editUser(${user.id})" class="flex-1 text-[10px] font-extrabold text-emerald-700 hover:text-emerald-800 py-2 rounded-lg hover:bg-white/60 transition-all duration-300 flex items-center justify-center gap-1 border border-white/30">
                <i class="fas fa-edit text-[8px]"></i>
                Edit
              </button>
            </div>
          </div>
        `;
          }).join('');
        }

        function viewUser(userId) {
          const user = allUsers.find(u => u.id === userId);
          if (user) {
            document.getElementById('viewUserID').textContent = user.id;
            document.getElementById('viewUserName').textContent = user.name;
            document.getElementById('viewUserEmail').textContent = user.email;

            const avatar = document.getElementById('viewUserAvatar');
            avatar.textContent = user.name.charAt(0).toUpperCase();
            avatar.className = 'w-20 h-20 gradient-primary rounded-full flex items-center justify-center text-white text-2xl font-bold mb-3 shadow-xl border-3 border-white/50';

            document.getElementById('viewUserRole').textContent = user.role_name || 'Pengguna';

            const roleConfig = {
              'super_admin': { bg: 'gradient-super-admin', text: 'text-white', badge: 'Super Admin' },
              'sales': { bg: 'gradient-sales', text: 'text-white', badge: 'Sales' },
              'finance': { bg: 'gradient-finance', text: 'text-white', badge: 'Finance' },
              'affiliate': { bg: 'gradient-affiliate', text: 'text-white', badge: 'Affiliate' },
              'user': { bg: 'gradient-user', text: 'text-white', badge: 'Pengguna' }
            }[user.role_name] || { bg: 'gradient-user', text: 'text-white', badge: 'Pengguna' };

            const roleBadge = document.getElementById('viewRoleBadge');
            roleBadge.className = `px-3 py-1.5 rounded-lg text-[10px] font-extrabold ${roleConfig.bg} ${roleConfig.text}`;
            roleBadge.textContent = roleConfig.badge;

            document.getElementById('viewUserStatus').textContent = user.status === 'active' ? 'Aktif' : 'Tidak Aktif';

            const statusConfig = {
              'active': { bg: 'gradient-active', text: 'text-white', icon: 'fas fa-check-circle' },
              'inactive': { bg: 'gradient-inactive', text: 'text-white', icon: 'fas fa-times-circle' }
            }[user.status] || { bg: 'bg-gray-500', text: 'text-white', icon: 'fas fa-question-circle' };

            const statusBadge = document.getElementById('viewStatusBadge');
            statusBadge.className = `px-3 py-1.5 rounded-lg text-[10px] font-extrabold ${statusConfig.bg} ${statusConfig.text} flex items-center gap-1 border border-white/30`;
            statusBadge.innerHTML = `<i class="${statusConfig.icon} text-[8px]"></i>${user.status === 'active' ? 'Aktif' : 'Tidak Aktif'}`;

            const affiliateStatus = user.affiliate_status || 'inactive';
            const affiliateLabel = {
              'inactive': 'Tidak Aktif',
              'pending': 'Tertunda',
              'approved': 'Disetujui',
              'rejected': 'Ditolak'
            }[affiliateStatus] || 'Tidak Aktif';

            document.getElementById('viewAffiliateStatus').textContent = affiliateLabel;

            const affiliateConfig = {
              'inactive': { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle' },
              'pending': { bg: 'gradient-pending', text: 'text-white', icon: 'fas fa-clock' },
              'approved': { bg: 'gradient-approved', text: 'text-white', icon: 'fas fa-check-circle' },
              'rejected': { bg: 'gradient-rejected', text: 'text-white', icon: 'fas fa-times-circle' }
            }[affiliateStatus] || { bg: 'bg-gray-100', text: 'text-gray-800', icon: 'fas fa-minus-circle' };

            const affiliateBadge = document.getElementById('viewAffiliateBadge');
            affiliateBadge.className = `px-3 py-1.5 rounded-lg text-[10px] font-extrabold ${affiliateConfig.bg} ${affiliateConfig.text} flex items-center gap-1 border border-white/30`;
            affiliateBadge.innerHTML = `<i class="${affiliateConfig.icon} text-[8px]"></i>${affiliateLabel}`;

            const joinDate = user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            }) : '-';
            document.getElementById('viewJoinDate').textContent = joinDate;

            document.getElementById('editFromViewBtn').setAttribute('onclick', `closeViewModal(); editUser(${user.id})`);

            document.getElementById('viewModal').classList.remove('hidden');
            document.getElementById('viewModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeViewModal() {
          document.getElementById('viewModal').classList.add('hidden');
          document.getElementById('viewModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        function editFromView() {
          closeViewModal();
          setTimeout(() => {
            const userId = document.getElementById('viewUserID').textContent;
            editUser(parseInt(userId));
          }, 300);
        }

        function editUser(userId) {
          currentUserId = userId;
          const user = allUsers.find(u => u.id === userId);
          if (user) {
            document.getElementById('editUserId').value = user.id;
            document.getElementById('editUserID').textContent = user.id;
            document.getElementById('editName').value = user.name;
            document.getElementById('editEmail').value = user.email;
            document.getElementById('editRole').value = user.role_name || 'user';

            const avatar = document.getElementById('editUserAvatar');
            avatar.textContent = user.name.charAt(0).toUpperCase();
            avatar.className = 'w-16 h-16 gradient-primary rounded-full flex items-center justify-center text-white text-xl font-bold mb-3 shadow-xl border-3 border-white/50';

            document.querySelector(`input[name="editStatus"][value="${user.status}"]`).checked = true;

            if (user.affiliate_status) {
              document.getElementById('editAffiliateStatus').value = user.affiliate_status;
              document.getElementById('affiliateStatusSection').classList.remove('hidden');
            } else {
              document.getElementById('affiliateStatusSection').classList.add('hidden');
            }

            document.getElementById('editModal').classList.remove('hidden');
            document.getElementById('editModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeEditModal() {
          currentUserId = null;
          document.getElementById('editModal').classList.add('hidden');
          document.getElementById('editModal').classList.remove('flex');
          document.body.style.overflow = '';
        }

        document.getElementById('editForm').addEventListener('submit', async (e) => {
          e.preventDefault();

          const userId = currentUserId;
          if (!userId) return;

          const user = allUsers.find(u => u.id === userId);
          if (!user) return;

          showConfirmationModal(
            'edit',
            'Konfirmasi Edit',
            `Ubah data pengguna "${user.name}"?`,
            'Ya, Edit',
            'Batal',
            async function () {
              const formData = {
                name: document.getElementById('editName').value,
                email: document.getElementById('editEmail').value,
                role: document.getElementById('editRole').value,
                status: document.querySelector('input[name="editStatus"]:checked').value,
                affiliate_status: document.getElementById('editAffiliateStatus').value
              };

              try {
                const response = await fetch(`/api/admin/users/${userId}`, {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (data.success) {
                  showNotification('edit', 'Berhasil', `Pengguna "${formData.name}" diperbarui.`);
                  closeEditModal();
                  loadUsers();
                } else {
                  showNotification('error', 'Gagal', data.message || 'Gagal mengupdate pengguna');
                }
              } catch (error) {
                console.error('Error updating user:', error);
                showNotification('error', 'Error', error.message);
              }
            }
          );
        });

        async function deleteUser(userId) {
          currentUserId = userId;
          const user = allUsers.find(u => u.id === userId);
          if (!user) return;

          showDeleteModal(
            user.name,
            async function () {
              try {
                const response = await fetch(`/api/admin/users/${userId}`, {
                  method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                  showNotification('delete', 'Berhasil', `Pengguna "${user.name}" dihapus.`);
                  loadUsers();
                } else {
                  showNotification('error', 'Gagal', data.message || 'Gagal menghapus pengguna');
                }
              } catch (error) {
                console.error('Error deleting user:', error);
                showNotification('error', 'Error', error.message);
              }
            }
          );
        }

        let searchTimeout;
        document.getElementById('searchInput').addEventListener('input', (e) => {
          clearTimeout(searchTimeout);
          searchTimeout = setTimeout(() => {
            filterUsers();
          }, 300);
        });

        document.getElementById('roleFilter').addEventListener('change', filterUsers);
        document.getElementById('statusFilter').addEventListener('change', filterUsers);

        function filterUsers() {
          const search = document.getElementById('searchInput').value.toLowerCase();
          const role = document.getElementById('roleFilter').value;
          const status = document.getElementById('statusFilter').value;

          const filtered = allUsers.filter(user => {
            const matchSearch = user.name.toLowerCase().includes(search) ||
              user.email.toLowerCase().includes(search);
            const matchRole = !role || user.role_name === role;
            const matchStatus = !status || user.status === status;
            return matchSearch && matchRole && matchStatus;
          });

          displayUsers(filtered);
        }

        function clearFilters() {
          document.getElementById('searchInput').value = '';
          document.getElementById('roleFilter').value = '';
          document.getElementById('statusFilter').value = '';
          filterUsers();
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (!document.getElementById('viewModal').classList.contains('hidden')) {
              closeViewModal();
            } else if (!document.getElementById('editModal').classList.contains('hidden')) {
              closeEditModal();
            } else if (document.getElementById('confirmationModal').style.display === 'flex') {
              closeConfirmationModal();
            } else if (document.getElementById('deleteModal').style.display === 'flex') {
              closeDeleteModal();
            } else if (document.getElementById('notificationModal').style.display === 'flex') {
              closeNotification();
            }
          }
        });

        document.getElementById('viewModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('viewModal')) {
            closeViewModal();
          }
        });

        document.getElementById('editModal').addEventListener('click', (e) => {
          if (e.target === document.getElementById('editModal')) {
            closeEditModal();
          }
        });

        document.addEventListener('DOMContentLoaded', function () {
          const closeBtn = document.getElementById('closeNotificationModalBtn');
          if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeNotification();
            });
          }

          const cancelConfirmationBtn = document.getElementById('cancelConfirmationBtn');
          if (cancelConfirmationBtn) {
            cancelConfirmationBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeConfirmationModal();
            });
          }

          const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
          if (cancelDeleteBtn) {
            cancelDeleteBtn.addEventListener('click', function (e) {
              e.preventDefault();
              closeDeleteModal();
            });
          }

          const notificationModal = document.getElementById('notificationModal');
          if (notificationModal) {
            notificationModal.addEventListener('click', function (e) {
              if (e.target === notificationModal) {
                closeNotification();
              }
            });
          }

          const confirmationModal = document.getElementById('confirmationModal');
          if (confirmationModal) {
            confirmationModal.addEventListener('click', function (e) {
              if (e.target === confirmationModal) {
                closeConfirmationModal();
              }
            });
          }

          const deleteModal = document.getElementById('deleteModal');
          if (deleteModal) {
            deleteModal.addEventListener('click', function (e) {
              if (e.target === deleteModal) {
                closeDeleteModal();
              }
            });
          }

          loadUsers();
        });

        setInterval(loadUsers, 60000);
      </script>
</body>

</html>
