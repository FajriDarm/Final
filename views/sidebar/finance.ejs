<style>
  .sidebar {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-right: 1px solid #e2e8f0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .nav-item {
    position: relative;
    transition: all 0.3s ease;
    border-radius: 8px;
  }
  .nav-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 4px;
    background: linear-gradient(to bottom, #10b981, #059669);
    transform: scaleY(0);
    transition: transform 0.3s ease;
    border-radius: 0 4px 4px 0;
  }
  .nav-item:hover::before {
    transform: scaleY(1);
  }
  .nav-item:hover {
    background-color: #f0fdf4;
    transform: translateX(4px);
  }
  .nav-item.active {
    background: linear-gradient(90deg, #f0fdf4 0%, #dcfce7 100%);
  }
  .nav-item.active::before {
    transform: scaleY(1);
  }
  .nav-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #f0fdf4;
    color: #10b981;
    font-size: 16px;
    transition: all 0.3s ease;
  }
  .nav-item:hover .nav-icon {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    transform: scale(1.05);
  }
  .nav-item.active .nav-icon {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
  }
  .nav-text {
    color: #334155;
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.01em;
  }
  .nav-item:hover .nav-text {
    color: #065f46;
  }
  .nav-item.active .nav-text {
    color: #065f46;
    font-weight: 600;
  }
  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
    margin: 12px 0;
  }

  @media (max-width: 767px) {
    .sidebar {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }
  }
</style>

<aside
  data-sidebar
  class="sidebar fixed left-0 top-16 z-40 w-64 transform -translate-x-full md:translate-x-0 transition-transform duration-300 bg-white"
  style="height: calc(100vh - 4rem); overflow: auto"
>
  <div class="flex items-center justify-between px-4 py-3 border-b md:hidden">
    <div class="text-sm font-semibold text-gray-700">Menu</div>
    <button
      type="button"
      data-sidebar-close
      class="p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors"
      aria-label="Tutup menu"
    >
      <i class="fas fa-times text-lg"></i>
    </button>
  </div>
  <nav class="flex-1 p-6 overflow-y-auto">
    <div class="space-y-1">
      <!-- Main Menu Atas -->
      <a
        href="/dashboard_finance"
        class="nav-item flex items-center gap-3 p-3"
        data-page="dashboard"
      >
        <div class="nav-icon">
          <i class="fas fa-tachometer-alt"></i>
        </div>
        <span class="nav-text">Dashboard</span>
      </a>
      <div class="divider"></div>
      <!-- Menu Lainnya -->
      <a
        href="/finance/payment-verification"
        class="nav-item flex items-center gap-3 p-3"
        data-page="payment-verification"
      >
        <div class="nav-icon">
          <i class="fas fa-money-check-alt"></i>
        </div>
        <span class="nav-text">Payment Verification</span>
      </a>
      <a
        href="/finance/payout-processing"
        class="nav-item flex items-center gap-3 p-3"
        data-page="payout-processing"
      >
        <div class="nav-icon">
          <i class="fas fa-hand-holding-usd"></i>
        </div>
        <span class="nav-text">Payout Processing</span>
      </a>
      <a
        href="/finance/withdrawals"
        class="nav-item flex items-center gap-3 p-3"
        data-page="withdrawals"
      >
        <div class="nav-icon">
          <i class="fas fa-money-bill-wave"></i>
        </div>
        <span class="nav-text">Manajemen Penarikan</span>
      </a>
    </div>
  </nav>
</aside>
<div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-30 z-30 hidden md:hidden"></div>
<script>
  // Highlight active menu based on current path
  (function () {
    const currentPath = window.location.pathname.replace(/\/$/, "");
    document.querySelectorAll(".nav-item").forEach((item) => {
      const href = item.getAttribute("href");
      if (href && href.replace(/\/$/, "") === currentPath) {
        item.classList.add("active");
      }
      item.addEventListener("click", function () {
        document
          .querySelectorAll(".nav-item")
          .forEach((i) => i.classList.remove("active"));
        this.classList.add("active");
      });
    });
  })();
</script>
