<style>
  .affiliate-sidebar {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-right: 1px solid #e2e8f0;
  }
  .affiliate-nav-item {
    position: relative;
    transition: all 0.3s ease;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
  }
  .affiliate-nav-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 4px;
    background: linear-gradient(to bottom, #10b981, #059669);
    transform: scaleY(0);
    transition: transform 0.3s ease;
    border-radius: 0 4px 4px 0;
  }
  .affiliate-nav-item:hover::before {
    transform: scaleY(1);
  }
  .affiliate-nav-item:hover {
    background-color: #f0fdf4;
    transform: translateX(4px);
  }
  .affiliate-nav-item.active {
    background: linear-gradient(90deg, #f0fdf4 0%, #dcfce7 100%);
  }
  .affiliate-nav-item.active::before {
    transform: scaleY(1);
  }
  .affiliate-nav-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #f0fdf4;
    color: #10b981;
    font-size: 16px;
    transition: all 0.3s ease;
  }
  .affiliate-nav-item:hover .affiliate-nav-icon {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    transform: scale(1.05);
  }
  .affiliate-nav-item.active .affiliate-nav-icon {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
  }
  .affiliate-nav-text {
    color: #334155;
    font-weight: 500;
    font-size: 14px;
  }
  .affiliate-nav-item:hover .affiliate-nav-text {
    color: #065f46;
  }
  .affiliate-nav-item.active .affiliate-nav-text {
    color: #065f46;
    font-weight: 600;
  }
  .affiliate-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
    margin: 12px 0;
  }
</style>

<aside
  class="affiliate-sidebar w-64 h-screen flex flex-col fixed top-0 left-0 z-40"
  style="padding-top: 6rem"
>
  <nav class="flex-1 p-6 overflow-y-auto">
    <div class="space-y-1">
      <div class="flex items-center gap-3 mb-4">
        <div
          class="affiliate-nav-icon"
          style="width: 44px; height: 44px; border-radius: 9999px"
        >
          <i class="fas fa-user"></i>
        </div>
        <div>
          <div class="text-sm font-semibold text-gray-800">
            <%= typeof name !== 'undefined' ? name : 'Affiliate' %>
          </div>
          <div class="text-xs text-green-600">
            <%= typeof userStatus !== 'undefined' ? userStatus : 'inactive' %>
          </div>
        </div>
      </div>

      <a
        href="/affiliate/dashboard"
        class="affiliate-nav-item"
        data-page="dashboard"
      >
        <div class="affiliate-nav-icon"><i class="fas fa-chart-line"></i></div>
        <span class="affiliate-nav-text">Dashboard</span>
      </a>
    </div>
  </nav>

  <div class="p-5 border-t border-gray-200 mt-auto">
    <div class="text-center text-xs text-gray-400">Affiliate Panel v1.0</div>
  </div>

  <script>
    (function () {
      const currentPath = window.location.pathname.replace(/\/$/, "");
      document.querySelectorAll(".affiliate-nav-item").forEach((item) => {
        const href = item.getAttribute("href");
        if (href && href.replace(/\/$/, "") === currentPath) {
          item.classList.add("active");
        }
        item.addEventListener("click", function () {
          document
            .querySelectorAll(".affiliate-nav-item")
            .forEach((i) => i.classList.remove("active"));
          this.classList.add("active");
        });
      });
    })();
  </script>
</aside>
