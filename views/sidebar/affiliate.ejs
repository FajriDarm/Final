<style>
  .sidebar {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-right: 1px solid #e2e8f0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .nav-item {
    position: relative;
    transition: all 0.3s ease;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
  }
  .nav-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 4px;
    background: linear-gradient(to bottom, #10b981, #059669);
    transform: scaleY(0);
    transition: transform 0.3s ease;
    border-radius: 0 4px 4px 0;
  }
  .nav-item:hover::before {
    transform: scaleY(1);
  }
  .nav-item:hover {
    background-color: #f0fdf4;
    transform: translateX(4px);
  }
  .nav-item.active {
    background: linear-gradient(90deg, #f0fdf4 0%, #dcfce7 100%);
  }
  .nav-item.active::before {
    transform: scaleY(1);
  }
  .nav-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #f0fdf4;
    color: #10b981;
    font-size: 16px;
    transition: all 0.3s ease;
  }
  .nav-item:hover .nav-icon {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    transform: scale(1.05);
  }
  .nav-item.active .nav-icon {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
  }
  .nav-text {
    color: #334155;
    font-weight: 500;
    font-size: 14px;
  }
  .nav-item:hover .nav-text {
    color: #065f46;
  }
  .nav-item.active .nav-text {
    color: #065f46;
    font-weight: 600;
  }
  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
    margin: 12px 0;
  }

  @media (max-width: 767px) {
    .sidebar {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }
  }
</style>

<aside
  data-sidebar
  class="sidebar fixed left-0 top-16 z-40 w-64 transform -translate-x-full md:translate-x-0 transition-transform duration-300 bg-white"
  style="height: calc(100vh - 4rem); overflow: auto"
>
  <div class="flex items-center justify-between px-4 py-3 border-b md:hidden">
    <div class="text-sm font-semibold text-gray-700">Menu</div>
    <button
      type="button"
      data-sidebar-close
      class="p-2 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors"
      aria-label="Tutup menu"
    >
      <i class="fas fa-times text-lg"></i>
    </button>
  </div>
  <nav class="flex-1 p-6 overflow-y-auto">
    <div class="space-y-1">
      <!-- User Info (kept as requested) -->
      <div class="flex items-center gap-3 mb-4">
        <div
          class="nav-icon"
          style="width: 44px; height: 44px; border-radius: 9999px"
        >
          <i class="fas fa-user"></i>
        </div>
        <div>
          <div class="text-sm font-semibold text-gray-800">
            <%= typeof name !== 'undefined' ? name : 'Affiliate' %>
          </div>
          <div class="text-xs text-green-600">
            <%= typeof userStatus !== 'undefined' ? userStatus : 'inactive' %>
          </div>
        </div>
      </div>

      <div class="divider"></div>

      <a
        href="/affiliate/dashboard"
        class="nav-item flex items-center gap-3 p-3"
        data-page="dashboard"
      >
        <div class="nav-icon"><i class="fas fa-chart-line"></i></div>
        <span class="nav-text">Dashboard</span>
      </a>

      <a
        href="/affiliate/commissions"
        class="nav-item flex items-center gap-3 p-3"
        data-page="commissions"
      >
        <div class="nav-icon"><i class="fas fa-coins"></i></div>
        <span class="nav-text">Komisi & Penarikan</span>
      </a>
    </div>
  </nav>

  <div class="p-5 border-t border-gray-200 mt-auto">
    <div class="text-center text-xs text-gray-400">Affiliate Panel v1.0</div>
  </div>

</aside>
<div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-30 z-30 hidden md:hidden"></div>
<script>
  (function () {
    const currentPath = window.location.pathname.replace(/\/$/, "");

    document.querySelectorAll('.nav-item').forEach((item) => {
      // Remove any pre-existing active class
      item.classList.remove('active');

      const href = item.getAttribute('href');
      if (href && href.replace(/\/$/, '') === currentPath) {
        item.classList.add('active');
      }
      // Also support nested routes
      if (currentPath === href || currentPath.startsWith(href + '/')) {
        item.classList.add('active');
      }
    });

    document.querySelectorAll('.nav-item').forEach((item) => {
      item.addEventListener('click', function () {
        document.querySelectorAll('.nav-item').forEach((i) => i.classList.remove('active'));
        this.classList.add('active');
        sessionStorage.setItem('activeNav', this.getAttribute('href'));
      });
    });

    // restore from session
    const savedNav = sessionStorage.getItem('activeNav');
    if (savedNav) {
      const savedItem = document.querySelector(`.nav-item[href="${savedNav}"]`);
      if (savedItem) savedItem.classList.add('active');
    }
  })();
</script>
